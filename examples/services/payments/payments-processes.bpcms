// service: example.com/services/payments
process PaymentSaga {
  version: 1
  goal: "Cobrar o pedido e reverter se a captura falhar"
  roles: [Manager]
  start on Order.Placed

  task ChargePayment {
    type: service
    integration: PaymentGateway
    action: Payment.capture
    reads: [Payment]
    writes: [Payment]
  }

  on error Failed -> RefundPayment

  task RefundPayment {
    type: compensation
    for: ChargePayment
    action: Payment.refund
    reads: [Payment]
    writes: [Refund]
  }

  end on Payment.Succeeded
}
