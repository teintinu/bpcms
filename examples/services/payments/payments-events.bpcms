// service: example.com/services/payments
event PaymentSucceeded {
  title: { pt-BR: "Pagamento aprovado", en: "Payment succeeded" }
  version: 1
  payload {
    paymentId: PaymentId { title: { pt-BR: "Pagamento", en: "Payment" } }
    orderId: OrderId { title: { pt-BR: "Pedido", en: "Order" } }
    amount: std.Money { title: { pt-BR: "Valor", en: "Amount" }, currency: BRL }
    capturedAt: DateTime { title: { pt-BR: "Capturado em", en: "Captured at" } }
  }
  producer: Payment
  consumers: [Orders, Billing, Notifications]
  key: paymentId
}

event Failed {
  title: { pt-BR: "Pagamento falhou", en: "Payment failed" }
  version: 1
  payload {
    paymentId: PaymentId { title: { pt-BR: "Pagamento", en: "Payment" } }
    orderId: OrderId { title: { pt-BR: "Pedido", en: "Order" } }
    reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
  }
  producer: Payment
  consumers: [Orders, Support, Notifications]
  key: paymentId
}

event RefundIssued {
  title: { pt-BR: "Reembolso emitido", en: "Refund issued" }
  version: 1
  payload {
    refundId: RefundId { title: { pt-BR: "Reembolso", en: "Refund" } }
    paymentId: PaymentId { title: { pt-BR: "Pagamento", en: "Payment" } }
    amount: std.Money { title: { pt-BR: "Valor", en: "Amount" }, currency: BRL }
    at: DateTime { title: { pt-BR: "Data/hora", en: "At" } }
  }
  producer: Refund
  consumers: [Billing, Support, Notifications]
  key: refundId
}
