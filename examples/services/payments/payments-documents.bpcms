// service: example.com/services/payments
document Payment {
  title: { pt-BR: "Pagamento", en: "Payment" }
  version: 2
  owner: "Payments"
  sync: live

  fields {
    order: Order {
      title: { pt-BR: "Pedido", en: "Order" }
      lookup
    }
    amount: std.Money { title: { pt-BR: "Valor", en: "Amount" }, lookup, currency: BRL }
    method: PaymentMethod { title: { pt-BR: "Método", en: "Method" } }
    status: PaymentStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    authorizationCode: string {
      title: { pt-BR: "Código de autorização", en: "Authorization code" }
      maxLength: 60
    }
    authorizedAt: DateTime { title: { pt-BR: "Autorizado em", en: "Authorized at" } }
    capturedAt: DateTime { title: { pt-BR: "Capturado em", en: "Captured at" } }
    acquirerReceipt: string {
      title: { pt-BR: "Comprovante do adquirente", en: "Acquirer receipt" }
      maxLength: 60
    }
    failureDetail: string {
      title: { pt-BR: "Detalhe da falha", en: "Failure detail" }
      maxLength: 300
    }
    notes: string {
      title: { pt-BR: "Observações", en: "Notes" }
      maxLength: 1000
    }
    createdAt: DateTime { title: { pt-BR: "Criado em", en: "Created at" } }
  }

  indexes {
    byOrder: [order.id] hash
    byStatus: [status, capturedAt] range
  }

  events {
    Created {
      title: { pt-BR: "Cobrança registrada", en: "Charge registered" }
      payload {
        order: Order { title: { pt-BR: "Pedido", en: "Order" } }
        amount: std.Money { title: { pt-BR: "Valor", en: "Amount" } }
      }
    }
  }

  actions {
    create(order: Order, amount: std.Money, method: PaymentMethod) {
      title: { pt-BR: "Registrar cobrança", en: "Register charge" }
      roles: [Analyst]
      {
        createdAt = now()
        emit Created
      }
    }

    authorize(authorization: string) {
      title: { pt-BR: "Autorizar", en: "Authorize" }
      roles: [PaymentEngine]

      to: status.Authorized
      emits { authorizationCode: authorization }
      {
        authorizationCode = authorization
        authorizedAt = now()
      }
    }

    capture(receipt: string) {
      title: { pt-BR: "Capturar", en: "Capture" }
      roles: [PaymentEngine]

      to: status.Captured
      {
        acquirerReceipt = receipt
        capturedAt = now()
      }
    }

    fail(failureReason: string) {
      title: { pt-BR: "Registrar falha", en: "Record failure" }
      roles: [PaymentEngine]

      to: status.Failed
      {
        failureDetail = failureReason
      }
    }

    refund(refundAmount: std.Money) {
      title: { pt-BR: "Estornar", en: "Refund" }
      roles: [Manager, PaymentEngine]

      to: status.Refunded
      emits { amount: refundAmount }

      rule refundAmount > 0 BRL {
        pt-BR: "O valor do estorno deve ser maior que zero"
        en: "Refund amount must be greater than zero"
      }
    }

    annotate(note: string) {
      title: { pt-BR: "Anotar", en: "Annotate" }
      roles: [Analyst]
      {
        notes = note
      }
    }
  }

  rule amount > 0 {
    pt-BR: "O valor deve ser maior que zero"
    en: "Amount must be greater than zero"
  }
  rule status == Captured implies capturedAt != null {
    pt-BR: "Informe a data de captura"
    en: "Enter the capture date"
  }
}

document Refund {
  title: { pt-BR: "Reembolso", en: "Refund" }
  version: 2
  owner: "Payments"
  sync: live

  fields {
    payment: Payment {
      title: { pt-BR: "Pagamento", en: "Payment" }
      lookup
    }
    amount: std.Money { title: { pt-BR: "Valor", en: "Amount" }, lookup, currency: BRL }
    requestReason: string { title: { pt-BR: "Motivo", en: "Reason" }, maxLength: 500 }
    status: RefundStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    requestedAt: DateTime { title: { pt-BR: "Solicitado em", en: "Requested at" } }
    approvedAt: DateTime { title: { pt-BR: "Aprovado em", en: "Approved at" } }
    completedAt: DateTime { title: { pt-BR: "Concluído em", en: "Completed at" } }
  }

  indexes {
    byPayment: [payment.id] hash
    byStatus: [status, requestedAt] range
  }

  events {
    Requested {
      title: { pt-BR: "Reembolso solicitado", en: "Refund requested" }
      payload {
        amount: std.Money { title: { pt-BR: "Valor", en: "Amount" } }
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }

  actions {
    request(reason: string) {
      title: { pt-BR: "Solicitar reembolso", en: "Request refund" }
      roles: [Analyst]

      rule reason.length >= 10 {
        pt-BR: "Informe um motivo com pelo menos 10 caracteres"
        en: "Enter a reason with at least 10 characters"
      }
      {
        requestReason = reason
        requestedAt = now()
        emit Requested
      }
    }

    approve() {
      title: { pt-BR: "Aprovar", en: "Approve" }
      roles: [Manager]

      to: status.Approved
      {
        approvedAt = now()
      }
    }

    complete() {
      title: { pt-BR: "Concluir", en: "Complete" }
      roles: [PaymentEngine]

      to: status.Completed
      {
        completedAt = now()
      }
    }

    reject(reason: string) {
      title: { pt-BR: "Rejeitar", en: "Reject" }
      roles: [Manager]

      to: status.Rejected
    }
  }

  rule amount > 0 {
    pt-BR: "O valor deve ser maior que zero"
    en: "Amount must be greater than zero"
  }
  rule amount <= 100000 BRL {
    pt-BR: "O valor excede o limite de 100.000 BRL"
    en: "Amount exceeds the 100,000 BRL limit"
  }
}

document Chargeback {
  title: { pt-BR: "Contestação", en: "Chargeback" }
  version: 1
  owner: "Payments"
  sync: live

  fields {
    payment: Payment {
      title: { pt-BR: "Pagamento", en: "Payment" }
      lookup
    }
    amount: std.Money { title: { pt-BR: "Valor", en: "Amount" }, lookup, currency: BRL }
    disputeReason: string {
      title: { pt-BR: "Motivo da contestação", en: "Dispute reason" }
      maxLength: 500
    }
    status: ChargebackStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    dueAt: DateTime { title: { pt-BR: "Prazo de resposta", en: "Response due" }, lookup }
    openedAt: DateTime { title: { pt-BR: "Aberta em", en: "Opened at" } }
    decidedOn: DateTime { title: { pt-BR: "Decidida em", en: "Decided on" } }
    networkFavorable: boolean {
      title: { pt-BR: "Decisão favorável", en: "Favorable decision" }
    }
    evidenceNotes: string {
      title: { pt-BR: "Evidências", en: "Evidence" }
      maxLength: 2000
    }
    evidence: EvidenceDocument {
      title: { pt-BR: "Documento de evidência", en: "Evidence document" }
    }
  }

  indexes {
    byPayment: [payment.id] hash
    byDue: [status, dueAt] range
  }

  events {
    Opened {
      title: { pt-BR: "Contestação aberta", en: "Chargeback opened" }
      payload {
        amount: std.Money { title: { pt-BR: "Valor", en: "Amount" } }
        dueAt: DateTime { title: { pt-BR: "Prazo", en: "Due" } }
      }
    }
  }

  actions {
    open(chargebackReason: string, dueAt: DateTime) {
      title: { pt-BR: "Abrir contestação", en: "Open chargeback" }
      roles: [PaymentEngine]
      {
        disputeReason = chargebackReason
        openedAt = now()
        emit Opened
      }
    }

    submitEvidence(evidenceNote: string, evidenceFile: EvidenceDocument) {
      title: { pt-BR: "Enviar evidências", en: "Submit evidence" }
      roles: [Analyst]

      to: status.UnderReview

      rule evidenceNote.length >= 20 {
        pt-BR: "Descreva as evidências com pelo menos 20 caracteres"
        en: "Describe the evidence with at least 20 characters"
      }
      {
        evidenceNotes = evidenceNote
        evidence = evidenceFile
      }
    }

    annotateEvidence(note: string) {
      title: { pt-BR: "Anotar evidências", en: "Annotate evidence" }
      roles: [Analyst]
      {
        evidenceNotes = note
      }
    }

    registerDecision(favorable: boolean, decidedAt: DateTime) {
      title: { pt-BR: "Registrar decisão da bandeira", en: "Record network decision" }
      roles: [PaymentEngine]
      {
        networkFavorable = favorable
        decidedOn = decidedAt
      }
    }

    win() {
      title: { pt-BR: "Marcar vitória", en: "Mark as won" }
      roles: [Manager, PaymentEngine]

      to: status.Won
      emits { decidedAt: decidedOn }
    }

    lose() {
      title: { pt-BR: "Marcar perda", en: "Mark as lost" }
      roles: [Manager, PaymentEngine]

      to: status.Lost
      emits { decidedAt: decidedOn }
    }

    concede() {
      title: { pt-BR: "Aceitar a contestação", en: "Accept the chargeback" }
      roles: [Manager]

      to: status.Lost
      emits { decidedAt: decidedOn }
      {
        decidedOn = now()
      }
    }
  }

  rule status == Lost implies decidedOn != null {
    pt-BR: "Informe a decisão da bandeira"
    en: "Enter the network decision"
  }
}
