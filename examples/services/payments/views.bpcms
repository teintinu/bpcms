// service: example.com/services/payments
view PaymentForm {
  type: form
  document: Payment
  roles: [Manager]

  fields {
    orderId: OrderId { required: true }
    amount: MoneyBRL { required: true }
    method: PaymentMethod { required: true }
  }

  actions {
    authorize -> Payment.authorize
    capture -> Payment.capture
    cancel -> none
  }
}

view PaymentDetail {
  type: detail
  document: Payment
  roles: [Manager]

  sections { summary; refunds; timeline }
  actions { refund; print }
}
