// service: example.com/services/payments
view PaymentForm {
  title: { pt-BR: "Formulário de pagamento", en: "Payment form" }
  type: form
  document: Payment
  roles: [Manager]

  fields {
    orderId: OrderId { title: { pt-BR: "Pedido", en: "Order" }, required }
    amount: MoneyBRL { title: { pt-BR: "Valor", en: "Amount" }, required }
    method: PaymentMethod { title: { pt-BR: "Método", en: "Method" }, required }
  }

  actions {
    authorize -> Payment.authorize
    capture -> Payment.capture
    cancel -> none
  }
}

view PaymentDetail {
  title: { pt-BR: "Detalhe do pagamento", en: "Payment detail" }
  type: detail
  document: Payment
  roles: [Manager]

  sections { summary; refunds; timeline }
  actions { refund; print }
}
