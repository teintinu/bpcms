// service: example.com/services/payments

view Reconciliation {
  title: { pt-BR: "Conciliação de pagamentos", en: "Payment reconciliation" }
  type: report
  sources: [Payment, Refund, Chargeback]
  roles: [Manager]

  filters { period; status; method }
  metrics {
    captured: sum(Payment.amount) where Payment.status == Captured
    refunded: sum(Refund.amount) where Refund.status == Completed
    failed: count(Payment) where Payment.status == Failed
    disputes: count(Chargeback) where Chargeback.status != Lost
  }
  units { captured: BRL; refunded: BRL }
  freshness: 5m
  export: [csv, pdf]
}

view RiskPulse {
  title: { pt-BR: "Pulso de risco", en: "Risk pulse" }
  type: dashboard
  sources: [Chargeback, Payment]
  roles: [Manager]
  mode: live

  filters { status }
  metrics {
    openDisputes: count(Chargeback) where Chargeback.status == Open
    overdue: count(Chargeback) where Chargeback.status == Open and Chargeback.dueAt < now()
    lost: count(Chargeback) where Chargeback.status == Lost
  }
  freshness: 5m
}

view FinanceInbox {
  title: { pt-BR: "Fila do financeiro", en: "Finance queue" }
  type: inbox
  roles: [Analyst, Manager]
  scope: lanes
  filter { lane in currentUser.lanes }
  groupBy: lane
  columns { title; subject; lane; dueAt; priority }
}
