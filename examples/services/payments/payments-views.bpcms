// service: example.com/services/payments
view Charges {
  title: { pt-BR: "Cobranças", en: "Charges" }
  type: table
  source: Payment
  roles: [Analyst, Manager]

  columns { order; amount; method; status; capturedAt }
  filters { status; period; method }
  pagination: 50

  actions {
    open -> PaymentDetail
    charge -> Payment.create(order, amount, method)
    refund -> Payment.refund(refundAmount)
  }
}

view PaymentDetail {
  title: { pt-BR: "Detalhe do pagamento", en: "Payment detail" }
  type: detail
  document: Payment
  roles: [Analyst, Manager]

  sections { summary; refunds; timeline }
  actions {
    progress -> PaymentProgress
  }
}

view Chargebacks {
  title: { pt-BR: "Contestações", en: "Chargebacks" }
  type: table
  source: Chargeback
  roles: [Analyst, Manager]

  columns { payment; amount; status; dueAt }
  filters { status; period }
  actions {
    open -> ChargebackDetail
  }
}

view ChargebackDetail {
  title: { pt-BR: "Detalhe da contestação", en: "Chargeback detail" }
  type: detail
  document: Chargeback
  roles: [Analyst, Manager]

  sections { summary; evidence; timeline }
  actions {
    progress -> ChargebackProgress
  }
}

view PaymentProgress {
  title: { pt-BR: "Andamento da captura", en: "Capture progress" }
  type: process
  process: PaymentCapture
  roles: [Analyst, Manager]

  sections { current; participants; history; deadlines; documents; next }
}

view ChargebackProgress {
  title: { pt-BR: "Andamento da contestação", en: "Chargeback progress" }
  type: process
  process: ChargebackDispute
  roles: [Analyst, Manager]

  sections { current; participants; history; deadlines; documents; next }
}

view FinanceInbox {
  title: { pt-BR: "Fila do financeiro", en: "Finance queue" }
  type: inbox
  roles: [Analyst, Manager]
  scope: lanes
  filter { lane in currentUser.lanes }
  groupBy: lane
  columns { title; subject; lane; dueAt; priority }
}
