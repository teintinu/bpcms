// service: example.com/services/payments


shape PaymentStatus {
  title: { pt-BR: "Situação do pagamento", en: "Payment status" }
  base: workflow
  initial: Authorized
  value Authorized {
    title: { pt-BR: "Autorizado", en: "Authorized" }
    icon: Authorized
    ordinal: 10
    transition Captured {
      title: { pt-BR: "Capturado", en: "Captured" }
      event: Succeeded
      payload {
        amount: std.Money
      }
    }
    transition Failed {
      title: { pt-BR: "Falhou", en: "Failed" }
      payload {
        reason: string
      }
    }
  }
  value Captured {
    title: { pt-BR: "Capturado", en: "Captured" }
    icon: Captured
    ordinal: 20
    transition Refunded {
      title: { pt-BR: "Reembolsado", en: "Refunded" }
      event: RefundIssued
      payload {
        amount: std.Money
      }
    }
  }
  value Failed {
    title: { pt-BR: "Falhou", en: "Failed" }
    icon: Failed
    ordinal: 30
  }
  value Refunded {
    title: { pt-BR: "Reembolsado", en: "Refunded" }
    icon: status.refunded
    ordinal: 40
  }
  format: plain

}

shape RefundStatus {
  title: { pt-BR: "Situação do reembolso", en: "Refund status" }
  base: workflow
  initial: Requested
  value Requested {
    title: { pt-BR: "Solicitado", en: "Requested" }
    icon: Requested
    ordinal: 10
    transition Approved {
      title: { pt-BR: "Aprovado", en: "Approved" }
    }
    transition Rejected {
      title: { pt-BR: "Rejeitado", en: "Rejected" }
    }
  }
  value Approved {
    title: { pt-BR: "Aprovado", en: "Approved" }
    icon: Approved
    ordinal: 20
    transition Completed {
      title: { pt-BR: "Concluído", en: "Completed" }
    }
  }
  value Completed {
    title: { pt-BR: "Concluído", en: "Completed" }
    icon: Completed
    ordinal: 30
  }
  value Rejected {
    title: { pt-BR: "Rejeitado", en: "Rejected" }
    icon: Rejected
    ordinal: 40
  }
  format: plain

}

shape PaymentMethod {
  title: { pt-BR: "Método de pagamento", en: "Payment method" }
  base: classification
    credit-card {
      title: { pt-BR: "Cartão de crédito", en: "Credit card" }
      icon: CreditCard
      ordinal: 10
    }
  value Pix {
    title: { pt-BR: "Pix", en: "Pix" }
    icon: Pix
    ordinal: 20
  }
  value Boleto {
    title: { pt-BR: "Boleto", en: "Boleto" }
    icon: Boleto
    ordinal: 30
  }
  format: plain

}
