// service: example.com/services/payments
integration PaymentGateway {
  protocol: rest
  baseUrl: env.PAYMENT_URL
  auth: api-key
  timeout: 15s
  idempotency: header "Idempotency-Key"

  operations {
    authorize(order: Order, amount: std.Money): Payment
    capture(paymentId: PaymentId): Payment
    refund(paymentId: PaymentId, amount: std.Money): Refund
  }

  webhooks {
    payment.succeeded -> PaymentSucceeded
    payment.failed -> Failed
  }
}
