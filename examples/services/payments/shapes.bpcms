// service: example.com/services/payments
shape PaymentId {
  base: text
  validate: uuid
  format: plain
  index: exact
}

shape RefundId {
  base: text
  validate: uuid
  format: plain
  index: exact
}

shape PaymentStatus {
  base: text
  values: [authorized, captured, failed, refunded]
  format: plain
}

shape RefundStatus {
  base: text
  values: [requested, approved, completed, rejected]
  format: plain
}

shape PaymentMethod {
  base: text
  values: [credit-card, pix, boleto]
  format: plain
}
