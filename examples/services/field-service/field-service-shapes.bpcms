// service: example.com/services/field-service

shape VisitStatus {
  title: { pt-BR: "Situação da visita", en: "Visit status" }
  base: state
  initial: Scheduled

  value Scheduled {
    title: { pt-BR: "Agendada", en: "Scheduled" }
    icon: status.scheduled
    ordinal: 10

    transition Dispatched {
      title: { pt-BR: "Visita despachada", en: "Visit dispatched" }
      payload {
        at: DateTime { title: { pt-BR: "Em", en: "At" } }
      }
    }

    transition Failed {
      title: { pt-BR: "Visita falhou", en: "Visit failed" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }

    transition Failed {
      event: Withdrawn
      title: { pt-BR: "Visita cancelada", en: "Visit withdrawn" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Dispatched {
    title: { pt-BR: "Despachada", en: "Dispatched" }
    icon: status.dispatched
    ordinal: 20

    transition OnSite {
      event: CheckedIn
      title: { pt-BR: "Check-in no site", en: "Checked in" }
      payload {
        at: DateTime { title: { pt-BR: "Em", en: "At" } }
        point: GeoPoint { title: { pt-BR: "Local", en: "Location" } }
      }
    }

    transition Failed {
      title: { pt-BR: "Visita falhou", en: "Visit failed" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }

    transition Failed {
      event: Withdrawn
      title: { pt-BR: "Visita cancelada", en: "Visit withdrawn" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value OnSite {
    title: { pt-BR: "No local", en: "On site" }
    icon: status.onSite
    ordinal: 30

    transition Completed {
      title: { pt-BR: "Visita concluída", en: "Visit completed" }
      payload {
        outcome: VisitOutcome { title: { pt-BR: "Desfecho", en: "Outcome" } }
        signedBy: string { title: { pt-BR: "Assinado por", en: "Signed by" } }
      }
    }

    transition Failed {
      title: { pt-BR: "Visita falhou", en: "Visit failed" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Completed {
    title: { pt-BR: "Concluída", en: "Completed" }
    icon: status.completed
    ordinal: 40
  }
  value Failed {
    title: { pt-BR: "Falhou", en: "Failed" }
    icon: status.failed
    ordinal: 50

    transition Scheduled {
      event: Rescheduled
      title: { pt-BR: "Visita reagendada", en: "Visit rescheduled" }
      payload {
        windowStart: DateTime { title: { pt-BR: "Nova janela de", en: "New window from" } }
        windowEnd: DateTime { title: { pt-BR: "Nova janela até", en: "New window to" } }
      }
    }

    transition Failed {
      event: Withdrawn
      title: { pt-BR: "Visita cancelada", en: "Visit withdrawn" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
}

shape WorkOrderStatus {
  title: { pt-BR: "Situação da ordem de serviço", en: "Work order status" }
  base: state
  initial: Open

  value Open {
    title: { pt-BR: "Aberta", en: "Open" }
    icon: status.open
    ordinal: 10

    transition Assigned {
      title: { pt-BR: "Ordem atribuída", en: "Work order assigned" }
      payload {
        technician: Technician { title: { pt-BR: "Técnico", en: "Technician" } }
      }
    }

    transition Cancelled {
      title: { pt-BR: "Ordem cancelada", en: "Work order cancelled" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Assigned {
    title: { pt-BR: "Atribuída", en: "Assigned" }
    icon: status.assigned
    ordinal: 20

    transition InProgress {
      event: Started
      title: { pt-BR: "Ordem iniciada", en: "Work order started" }
      payload {
        at: DateTime { title: { pt-BR: "Em", en: "At" } }
      }
    }

    transition Cancelled {
      title: { pt-BR: "Ordem cancelada", en: "Work order cancelled" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value InProgress {
    title: { pt-BR: "Em execução", en: "In progress" }
    icon: status.inProgress
    ordinal: 30

    transition Done {
      event: Finished
      title: { pt-BR: "Ordem concluída", en: "Work order finished" }
      payload {
        at: DateTime { title: { pt-BR: "Em", en: "At" } }
      }
    }

    transition Cancelled {
      title: { pt-BR: "Ordem cancelada", en: "Work order cancelled" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Done {
    title: { pt-BR: "Concluída", en: "Done" }
    icon: status.done
    ordinal: 40
  }
  value Cancelled {
    title: { pt-BR: "Cancelada", en: "Cancelled" }
    icon: status.cancelled
    ordinal: 50
  }
}

shape TechnicianAvailability {
  title: { pt-BR: "Disponibilidade do técnico", en: "Technician availability" }
  base: state
  initial: Available

  value Available {
    title: { pt-BR: "Disponível", en: "Available" }
    icon: status.available
    ordinal: 10

    transition Assigned {
      event: TechnicianAssigned
      title: { pt-BR: "Técnico em atendimento", en: "Technician assigned" }
      payload {
        at: DateTime { title: { pt-BR: "Em", en: "At" } }
      }
    }

    transition OffDuty {
      event: WentOffDuty
      title: { pt-BR: "Técnico fora de turno", en: "Technician off duty" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Assigned {
    title: { pt-BR: "Em atendimento", en: "Assigned" }
    icon: status.assigned
    ordinal: 20

    transition Available {
      event: TechnicianReleased
      title: { pt-BR: "Técnico liberado", en: "Technician released" }
      payload {
        at: DateTime { title: { pt-BR: "Em", en: "At" } }
      }
    }
  }
  value OffDuty {
    title: { pt-BR: "Fora de turno", en: "Off duty" }
    icon: status.offDuty
    ordinal: 30

    transition Available {
      event: ReturnedToDuty
      title: { pt-BR: "Técnico de volta ao turno", en: "Technician back on duty" }
      payload {
        at: DateTime { title: { pt-BR: "Em", en: "At" } }
      }
    }
  }
}

shape WorkOrderPriority {
  title: { pt-BR: "Prioridade da ordem", en: "Work order priority" }
  base: classification

  value Low {
    title: { pt-BR: "Baixa", en: "Low" }
    icon: priority.low
    ordinal: 10
  }
  value Normal {
    title: { pt-BR: "Normal", en: "Normal" }
    icon: priority.normal
    ordinal: 20
  }
  value High {
    title: { pt-BR: "Alta", en: "High" }
    icon: priority.high
    ordinal: 30
  }
  value Urgent {
    title: { pt-BR: "Urgente", en: "Urgent" }
    icon: priority.urgent
    ordinal: 40
  }
}

shape VisitOutcome {
  title: { pt-BR: "Desfecho da visita", en: "Visit outcome" }
  base: classification

  value Fixed {
    title: { pt-BR: "Resolvido", en: "Fixed" }
    icon: outcome.fixed
    ordinal: 10
  }
  value NeedsParts {
    title: { pt-BR: "Aguardando peças", en: "Needs parts" }
    icon: outcome.needsParts
    ordinal: 20
  }
  value NotRepairable {
    title: { pt-BR: "Sem reparo", en: "Not repairable" }
    icon: outcome.notRepairable
    ordinal: 30
  }
  value CustomerAbsent {
    title: { pt-BR: "Cliente ausente", en: "Customer absent" }
    icon: outcome.customerAbsent
    ordinal: 40
  }
}

shape ServiceSkill {
  title: { pt-BR: "Especialidade técnica", en: "Service skill" }
  base: classification

  value Installation {
    title: { pt-BR: "Instalação", en: "Installation" }
    icon: skill.installation
    ordinal: 10
  }
  value Maintenance {
    title: { pt-BR: "Manutenção", en: "Maintenance" }
    icon: skill.maintenance
    ordinal: 20
  }
  value Repair {
    title: { pt-BR: "Reparo", en: "Repair" }
    icon: skill.repair
    ordinal: 30
  }
  value Inspection {
    title: { pt-BR: "Inspeção", en: "Inspection" }
    icon: skill.inspection
    ordinal: 40
  }
}

shape GeoPoint {
  title: { pt-BR: "Ponto geográfico", en: "Geo point" }

  fields {
    lat: number { title: { pt-BR: "Latitude", en: "Latitude" } }
    lng: number { title: { pt-BR: "Longitude", en: "Longitude" } }
    accuracy: number { title: { pt-BR: "Precisão (m)", en: "Accuracy (m)" } }
  }
}
