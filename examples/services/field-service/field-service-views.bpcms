// service: example.com/services/field-service

view DispatchWork {
  title: { pt-BR: "Fila de despacho", en: "Dispatch queue" }
  type: inbox
  roles: [Dispatcher, FieldTechnician]
  scope: lanes
  groupBy: lane
  filter { lane in currentUser.lanes }

  columns { title; subject; lane; dueAt; priority }
}

view FieldDashboard {
  title: { pt-BR: "Painel de campo", en: "Field dashboard" }
  type: dashboard
  sources: [Visit, WorkOrder]
  roles: [Supervisor, Dispatcher]
  mode: live

  filters { site; status; period }
  metrics {
    openVisits: count(Visit) where Visit.status != Completed and Visit.status != Failed
    onSite: count(Visit) where Visit.status == OnSite
    failedVisits: count(Visit) where Visit.status == Failed
    openOrders: count(WorkOrder) where WorkOrder.status != Done and WorkOrder.status != Cancelled
  }
  freshness: 5m
}
