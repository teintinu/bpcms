// service: example.com/services/notifications
shape TemplateId {
  base: text
  validate: uuid
  format: plain
  index: exact
}

shape NotificationId {
  base: text
  validate: uuid
  format: plain
  index: exact
}

shape Channel {
  base: text
  values: [email, whatsapp, in-app]
  format: plain
}

shape NotificationStatus {
  base: text
  values: [queued, sent, failed, read]
  format: plain
}
