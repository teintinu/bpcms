// service: example.com/services/notifications

shape Channel {
  title: { pt-BR: "Canal", en: "Channel" }
  base: classification
  value Email {
    title: { pt-BR: "Correio eletrônico", en: "Email" }
    icon: channels.email
    ordinal: 10
  }
  value Whatsapp {
    title: { pt-BR: "WhatsApp", en: "WhatsApp" }
    icon: WhatsApp
    ordinal: 20
  }
  value InApp {
    title: { pt-BR: "No aplicativo", en: "In-app" }
    icon: InApp
    ordinal: 30
  }
  format: plain
}

shape NotificationStatus {
  title: { pt-BR: "Situação da notificação", en: "Notification status" }
  base: state
  initial: Queued
  value Queued {
    title: { pt-BR: "Na fila", en: "Queued" }
    icon: Queued
    ordinal: 10

    transition Sent {
      title: { pt-BR: "Notificação enviada", en: "Notification sent" }
      payload {
        sentAt: DateTime { title: { pt-BR: "Enviada em", en: "Sent at" } }
      }
    }

    transition Failed {
      title: { pt-BR: "Falha no envio", en: "Delivery failed" }
      payload {
        error: string { title: { pt-BR: "Erro", en: "Error" } }
      }
    }

    transition Sent {
      event: Digested
      title: { pt-BR: "Resumo enviado", en: "Digest sent" }
      payload {
        sentAt: DateTime { title: { pt-BR: "Enviado em", en: "Sent at" } }
      }
    }

    transition Suppressed {
      title: { pt-BR: "Notificação suprimida", en: "Notification suppressed" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Sent {
    title: { pt-BR: "Enviada", en: "Sent" }
    icon: Sent
    ordinal: 20

    transition Read {
      title: { pt-BR: "Notificação lida", en: "Notification read" }
      payload {
        readAt: DateTime { title: { pt-BR: "Lida em", en: "Read at" } }
      }
    }
  }
  value Failed {
    title: { pt-BR: "Falhou", en: "Failed" }
    icon: Failed
    ordinal: 30

    transition Queued {
      event: Retried
      title: { pt-BR: "Envio repetido", en: "Delivery retried" }
      payload {
        at: DateTime { title: { pt-BR: "Em", en: "At" } }
      }
    }
  }
  value Read {
    title: { pt-BR: "Lida", en: "Read" }
    icon: Read
    ordinal: 40
  }
  value Suppressed {
    title: { pt-BR: "Suprimida", en: "Suppressed" }
    icon: Suppressed
    ordinal: 50
  }
  format: plain
}

shape LocaleTag {
  title: { pt-BR: "Idioma", en: "Locale" }
  base: classification
  value PtBr {
    title: { pt-BR: "Português (Brasil)", en: "Portuguese (Brazil)" }
    icon: LocalePtBr
    ordinal: 10
  }
  value EnUs {
    title: { pt-BR: "Inglês (EUA)", en: "English (US)" }
    icon: LocaleEnUs
    ordinal: 20
  }
  format: plain
}
