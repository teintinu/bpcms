// service: example.com/services/notifications


shape Channel {
  title: { pt-BR: "Canal", en: "Channel" }
  base: text
  values {
    email {
      title: { pt-BR: "E-mail", en: "Email" }
      icon: Email
    }
    whatsapp {
      title: { pt-BR: "WhatsApp", en: "WhatsApp" }
      icon: WhatsApp
    }
    in-app {
      title: { pt-BR: "No aplicativo", en: "In-app" }
      icon: InApp
    }
  }
  format: plain
}

shape NotificationStatus {
  title: { pt-BR: "Status da notificação", en: "Notification status" }
  base: text
  values {
    queued {
      title: { pt-BR: "Na fila", en: "Queued" }
      icon: Queued
    }
    sent {
      title: { pt-BR: "Enviada", en: "Sent" }
      icon: Sent
    }
    failed {
      title: { pt-BR: "Falhou", en: "Failed" }
      icon: Failed
    }
    read {
      title: { pt-BR: "Lida", en: "Read" }
      icon: Read
    }
  }
  format: plain
}

shape LocaleTag {
  title: { pt-BR: "Idioma", en: "Locale" }
  base: text
  values {
    pt-BR {
      title: { pt-BR: "Português (Brasil)", en: "Portuguese (Brazil)" }
      icon: LocalePtBr
    }
    en-US {
      title: { pt-BR: "Inglês (EUA)", en: "English (US)" }
      icon: LocaleEnUs
    }
  }
  format: plain
}
