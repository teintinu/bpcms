// service: example.com/services/notifications


shape Channel {
  title: { pt-BR: "Canal", en: "Channel" }
  base: classification
  value email {
    title: { pt-BR: "Correio eletrônico", en: "Email" }
    icon: channels.email
    ordinal: 10
  }
  value whatsapp {
    title: { pt-BR: "WhatsApp", en: "WhatsApp" }
    icon: WhatsApp
    ordinal: 20
  }
    in-app {
      title: { pt-BR: "No aplicativo", en: "In-app" }
      icon: InApp
      ordinal: 30
    }
  format: plain

}

shape NotificationStatus {
  title: { pt-BR: "Situação da notificação", en: "Notification status" }
  base: workflow
  initial: queued
  value queued {
    title: { pt-BR: "Na fila", en: "Queued" }
    icon: Queued
    ordinal: 10
    transition Sent {
      title: { pt-BR: "Enviada", en: "Sent" }
      to: sent
    }
    transition Failed {
      title: { pt-BR: "Falhou", en: "Failed" }
      to: failed
    }
  }
  value sent {
    title: { pt-BR: "Enviada", en: "Sent" }
    icon: Sent
    ordinal: 20
    transition Read {
      title: { pt-BR: "Lida", en: "Read" }
      to: read
    }
    transition Failed {
      title: { pt-BR: "Falhou", en: "Failed" }
      to: failed
    }
  }
  value failed {
    title: { pt-BR: "Falhou", en: "Failed" }
    icon: Failed
    ordinal: 30
    transition Queued {
      title: { pt-BR: "Na fila", en: "Queued" }
      to: queued
    }
  }
  value read {
    title: { pt-BR: "Lida", en: "Read" }
    icon: Read
    ordinal: 40
  }
  format: plain

}

shape LocaleTag {
  title: { pt-BR: "Idioma", en: "Locale" }
  base: classification
    pt-BR {
      title: { pt-BR: "Português (Brasil)", en: "Portuguese (Brazil)" }
      icon: LocalePtBr
      ordinal: 10
    }
    en-US {
      title: { pt-BR: "Inglês (EUA)", en: "English (US)" }
      icon: LocaleEnUs
      ordinal: 20
    }
  format: plain

}
