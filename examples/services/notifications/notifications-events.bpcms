// service: example.com/services/notifications
event NotificationSent {
  title: { pt-BR: "Notificação enviada", en: "Notification sent" }
  version: 1
  payload {
    notificationId: NotificationId { title: { pt-BR: "Notificação", en: "Notification" } }
    channel: Channel { title: { pt-BR: "Canal", en: "Channel" } }
    sentAt: DateTime { title: { pt-BR: "Enviado em", en: "Sent at" } }
  }
  producer: Notification
  consumers: [Support]
  key: notificationId
}
