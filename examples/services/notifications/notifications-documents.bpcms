// service: example.com/services/notifications
document NotificationTemplate {
  title: { pt-BR: "Modelo de notificação", en: "Notification template" }
  version: 1
  owner: "Notifications"
  sync: read
  fields {
    key: string {
      title: { pt-BR: "Chave", en: "Key" }
      maxLength: 80
      lookup
      required
    }
    channel: Channel { title: { pt-BR: "Canal", en: "Channel" }, lookup }
    subject: string { title: { pt-BR: "Assunto", en: "Subject" }, maxLength: 160, lookup }
    body: string { title: { pt-BR: "Conteúdo", en: "Body" } }
    locale: LocaleTag { title: { pt-BR: "Idioma", en: "Locale" }, lookup }
  }

  indexes {
    uniqueKey: [key, channel, locale] unique
  }

  actions {
    create(key: string, channel: Channel, locale: LocaleTag){
      title: { pt-BR: "Criar modelo", en: "Create template" }
      roles: [Manager]
    }
    update(subject: string, body: string){
      title: { pt-BR: "Atualizar", en: "Update" }
      roles: [Manager]
    }
  }
}

document Notification {
  title: { pt-BR: "Notificação", en: "Notification" }
  version: 1
  owner: "Notifications"
  sync: live

  fields {
    template: NotificationTemplate {
      title: { pt-BR: "Modelo", en: "Template" }
    }
    recipient: string { title: { pt-BR: "Destinatário", en: "Recipient" }, lookup }
    channel: Channel { title: { pt-BR: "Canal", en: "Channel" }, lookup }
    status: NotificationStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    consent: boolean { title: { pt-BR: "Consentimento", en: "Consent" } }
    sentAt: DateTime { title: { pt-BR: "Enviado em", en: "Sent at" } }
    error: string { title: { pt-BR: "Erro", en: "Error" } }
  }

  indexes {
    byStatus: [status, sentAt] range
    byRecipient: [recipient, sentAt] range
  }

  actions {
    send(){
      title: { pt-BR: "Enviar", en: "Send" }
      roles: [Manager]
    }
    retry(){
      title: { pt-BR: "Repetir", en: "Retry" }
      roles: [Manager]
    }
    sendDigest(){
      title: { pt-BR: "Enviar resumo", en: "Send digest" }
      roles: [Manager]
    }
    retryFailed(){
      title: { pt-BR: "Repetir falhas", en: "Retry failed" }
      roles: [Manager]
    }
  }

  rules {
    status == Sent implies sentAt != null: {
      pt-BR: "Regra do documento não atendida"
      en: "Document rule not met"
    }
  }
}
