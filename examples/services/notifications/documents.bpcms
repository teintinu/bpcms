// service: example.com/services/notifications
document NotificationTemplate {
  version: 1
  owner: "Notifications"
  sync: read
  audit: true

  fields {
    id: TemplateId
    key: Text { maxLength: 80, required: true }
    channel: Channel
    subject: Text { maxLength: 160 }
    body: Text
    locale: LocaleTag
  }

  indexes {
    uniqueKey: [key, channel, locale] unique
  }

  actions {
    create(key: Text, channel: Channel, locale: LocaleTag): NotificationTemplate
    update(subject: Text, body: Text): NotificationTemplate
  }
}

document Notification {
  version: 1
  owner: "Notifications"
  sync: live

  fields {
    id: NotificationId
    templateId: TemplateId
    recipient: Text
    channel: Channel
    status: NotificationStatus
    consent: Boolean
    sentAt: DateTime?
    error: Text?
  }

  indexes {
    byStatus: [status, sentAt] range
    byRecipient: [recipient, sentAt] range
  }

  actions {
    send(): Notification
    retry(): Notification
    sendDigest(): void
    retryFailed(): void
  }

  rules {
    status == sent implies sentAt != null
  }
}
