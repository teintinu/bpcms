// service: example.com/services/notifications

parameter FromEmail {
  title: { pt-BR: "Remetente", en: "From email" }
  type: Citizen.Email
  default: "no-reply@lojadojoao.com"
}

secret WhatsAppToken {
  title: { pt-BR: "Credencial do WhatsApp", en: "WhatsApp token" }
  type: string
  required
}
