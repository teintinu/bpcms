// service: example.com/services/notifications
view NotificationTable {
  title: { pt-BR: "Notificações", en: "Notifications" }
  type: table
  source: Notification
  roles: [SuccessAgent, SuccessManager]

  columns { recipient; channel; status; sentAt; error }
  filters { status; channel; period }
  pagination: 50

  actions {
    open -> NotificationDetail
  }
}

view NotificationDetail {
  title: { pt-BR: "Detalhe da notificação", en: "Notification detail" }
  type: detail
  document: Notification
  roles: [SuccessAgent, SuccessManager]

  sections { summary; delivery; timeline }

  actions {
    send -> Notification.send
    retry -> Notification.retry
    suppress -> Notification.suppress(reason)
  }
}

view NotificationKanban {
  title: { pt-BR: "Notificações por situação", en: "Notifications by status" }
  type: kanban
  source: Notification
  roles: [SuccessAgent, SuccessManager]

  groupBy: status
  columns { recipient; channel; sentAt }
  card { recipient; channel; status; sentAt }

  actions {
    open -> NotificationDetail
  }
}

view DigestProgress {
  title: { pt-BR: "Andamento do resumo", en: "Digest progress" }
  type: process
  process: DailyDigest
  roles: [SuccessAgent, SuccessManager]

  sections { current; participants; history; deadlines; documents; milestones; next }
}

view NotificationInbox {
  title: { pt-BR: "Fila de notificações", en: "Notification queue" }
  type: inbox
  roles: [SuccessAgent, SuccessManager]

  scope: lanes
  filter { lane in currentUser.lanes }
  groupBy: process
  columns { title; subject; lane; dueAt; priority }
}
