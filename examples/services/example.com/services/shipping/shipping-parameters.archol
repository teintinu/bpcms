// REVIEW [2026-12-15] service: example.com/services/shipping

// REVIEW [2026-12-15] Parâmetro configurável da transportadora usada por padrão.
parameter DefaultCarrier {
  // REVIEW [2026-12-15] Título exibido na configuração do parâmetro.
  title: { pt-BR: "Transportadora padrão", en: "Default carrier" }
  // REVIEW [2026-12-15] Tipo de dado aceito pelo parâmetro.
  type: string
  // REVIEW [2026-12-15] Valor inicial usado quando a aplicação não define outro.
  default: "CarrierX"
}

// REVIEW [2026-12-15] Parâmetro de limite máximo de peso aceito por remessa.
parameter MaxWeight {
  // REVIEW [2026-12-15] Título exibido na configuração do parâmetro.
  title: { pt-BR: "Peso máximo", en: "Max weight" }
  // REVIEW [2026-12-15] Tipo de medida de massa, importado do serviço std.
  type: std.Mass
  // REVIEW [2026-12-15] Peso padrão de trinta quilos.
  default: "30 kg"
  // REVIEW [2026-12-15] Menor valor permitido na configuração.
  min: "1 kg"
  // REVIEW [2026-12-15] Maior valor permitido na configuração.
  max: "500 kg"
}
