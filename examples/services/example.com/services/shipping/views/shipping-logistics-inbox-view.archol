// REVIEW [2026-12-15] service: example.com/services/shipping

// REVIEW [2026-12-15] View de caixa de entrada com as tarefas de expedição do usuário.
view LogisticsInbox {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Minha fila de expedição", en: "My dispatch queue" }
  // REVIEW [2026-12-15] Tipo da view: caixa de entrada de trabalho.
  type: inbox
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [Packer, Dispatcher]
  // REVIEW [2026-12-15] Restringe a lista às tarefas atribuídas ao usuário.
  scope: mine
  // REVIEW [2026-12-15] Agrupa as tarefas pelo processo de origem.
  groupBy: process
  // REVIEW [2026-12-15] Colunas exibidas em cada linha da fila.
  columns { title; subject; dueAt; priority }
}
