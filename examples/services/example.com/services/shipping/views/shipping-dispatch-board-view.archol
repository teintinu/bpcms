// REVIEW [2026-12-15] service: example.com/services/shipping

// REVIEW [2026-12-15] Quadro kanban da expedição por situação.
view DispatchBoard {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Quadro de expedição", en: "Dispatch board" }
  // REVIEW [2026-12-15] Tipo da view: quadro kanban.
  type: kanban
  // REVIEW [2026-12-15] Documento exibido nas colunas do quadro.
  source: Shipment
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [Packer, Dispatcher, Manager]

  // REVIEW [2026-12-15] Agrupa os cartões pela situação da remessa.
  groupBy: status
  // REVIEW [2026-12-15] Campos exibidos em cada cartão.
  card { order; tracking; frete }
  // REVIEW [2026-12-15] Oculta remessas canceladas do quadro.
  filter { status != Cancelled }
  // REVIEW [2026-12-15] Ações disponíveis nos cartões.
  actions {
    // REVIEW [2026-12-15] Abre o detalhe da remessa selecionada.
    open -> ShipmentDetail
  }
}
