// REVIEW [2026-12-15] service: example.com/services/shipping

// REVIEW [2026-12-15] Relatório de custos de frete por período, transportadora e situação.
view FreightCost {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Custo de frete", en: "Freight cost" }
  // REVIEW [2026-12-15] Tipo da view: relatório agregado.
  type: report
  // REVIEW [2026-12-15] Documentos usados como fonte dos dados.
  sources: [Shipment]
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [Manager]

  // REVIEW [2026-12-15] Filtros disponíveis no relatório.
  filters { period; carrierName; status }
  // REVIEW [2026-12-15] Métricas calculadas sobre as remessas.
  metrics {
    // REVIEW [2026-12-15] Total de remessas no período.
    shipments: count(Shipment)
    // REVIEW [2026-12-15] Soma dos valores de frete.
    freight: sum(Shipment.frete)
    // REVIEW [2026-12-15] Peso bruto médio das remessas.
    avgWeight: avg(Shipment.pesoBruto)
    // REVIEW [2026-12-15] Remessas com tentativa de entrega falha.
    failedAttempts: count(Shipment) where status == AttemptFailed
  }
  // REVIEW [2026-12-15] Unidades usadas na exibição das métricas.
  units { freight: BRL; avgWeight: kg }
  // REVIEW [2026-12-15] Considera os dados atualizados por quinze minutos.
  freshness: 15m
  // REVIEW [2026-12-15] Formatos de exportação disponíveis.
  export: [pdf, csv]
}
