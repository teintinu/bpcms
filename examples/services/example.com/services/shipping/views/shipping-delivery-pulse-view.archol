// REVIEW [2026-12-15] service: example.com/services/shipping

// REVIEW [2026-12-15] Painel ao vivo com o pulso das entregas.
view DeliveryPulse {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Pulso das entregas", en: "Delivery pulse" }
  // REVIEW [2026-12-15] Tipo da view: painel de indicadores.
  type: dashboard
  // REVIEW [2026-12-15] Documentos usados como fonte dos dados.
  sources: [Shipment]
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [Manager]
  // REVIEW [2026-12-15] Atualização em tempo real dos indicadores.
  mode: live

  // REVIEW [2026-12-15] Filtros disponíveis no painel.
  filters { status; carrierName }
  // REVIEW [2026-12-15] Métricas calculadas sobre as remessas.
  metrics {
    // REVIEW [2026-12-15] Remessas em rota de entrega.
    outForDelivery: count(Shipment) where status == OutForDelivery
    // REVIEW [2026-12-15] Remessas com tentativa de entrega falha.
    failedAttempts: count(Shipment) where status == AttemptFailed
    // REVIEW [2026-12-15] Remessas devolvidas ao remetente.
    returned: count(Shipment) where status == Returned
  }
  // REVIEW [2026-12-15] Considera os dados atualizados por cinco minutos.
  freshness: 5m
}
