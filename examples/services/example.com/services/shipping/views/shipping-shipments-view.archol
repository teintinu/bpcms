// REVIEW [2026-12-15] service: example.com/services/shipping

// REVIEW [2026-12-15] Tabela de remessas com filtros e ações rápidas.
view Shipments {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Remessas", en: "Shipments" }
  // REVIEW [2026-12-15] Tipo da view: tabela de documentos.
  type: table
  // REVIEW [2026-12-15] Documento listado na tabela.
  source: Shipment
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [Packer, Dispatcher, Manager]

  // REVIEW [2026-12-15] Colunas exibidas na tabela.
  columns { order; carrierName; status; tracking; frete }
  // REVIEW [2026-12-15] Filtros disponíveis na tabela.
  filters { status; period; carrierName }
  // REVIEW [2026-12-15] Quantidade de linhas por página.
  pagination: 50

  // REVIEW [2026-12-15] Ações disponíveis nas linhas da tabela.
  actions {
    // REVIEW [2026-12-15] Abre o detalhe da remessa selecionada.
    open -> ShipmentDetail
    // REVIEW [2026-12-15] Cria uma remessa a partir do pedido.
    receive -> Shipment.create(order)
    // REVIEW [2026-12-15] Solicita a cotação de frete da remessa.
    requestQuote -> Shipment.requestQuote
  }
}
