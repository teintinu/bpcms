// REVIEW [2026-12-15] service: example.com/services/shipping

// REVIEW [2026-12-15] Tela de detalhe de uma remessa.
view ShipmentDetail {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Detalhe da remessa", en: "Shipment detail" }
  // REVIEW [2026-12-15] Tipo da view: detalhe de documento.
  type: detail
  // REVIEW [2026-12-15] Documento exibido no detalhe.
  document: Shipment
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [Packer, Dispatcher, Manager]

  // REVIEW [2026-12-15] Seções exibidas na tela de detalhe.
  sections { summary; items; timeline }
  // REVIEW [2026-12-15] Ações disponíveis na tela de detalhe.
  actions {
    // REVIEW [2026-12-15] Abre o andamento do processo de despacho.
    progress -> DispatchProgress
    // REVIEW [2026-12-15] Abre o andamento do processo de entrega.
    delivery -> DeliveryProgress
  }
}
