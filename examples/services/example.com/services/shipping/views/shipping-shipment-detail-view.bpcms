// service: example.com/services/shipping

// Tela de detalhe de uma remessa.
view ShipmentDetail {
  // Título exibido na navegação.
  title: { pt-BR: "Detalhe da remessa", en: "Shipment detail" }
  // Tipo da view: detalhe de documento.
  type: detail
  // Documento exibido no detalhe.
  document: Shipment
  // Papéis que podem abrir a view.
  roles: [Packer, Dispatcher, Manager]

  // Seções exibidas na tela de detalhe.
  sections { summary; items; timeline }
  // Ações disponíveis na tela de detalhe.
  actions {
    // Abre o andamento do processo de despacho.
    progress -> DispatchProgress
    // Abre o andamento do processo de entrega.
    delivery -> DeliveryProgress
  }
}
