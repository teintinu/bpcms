// REVIEW [2026-12-15] service: example.com/services/shipping

// REVIEW [2026-12-15] Mensagem que solicita a coleta da remessa à transportadora.
message PickupRequest {
  // REVIEW [2026-12-15] Título exibido no histórico e nas integrações.
  title: { pt-BR: "Solicitação de coleta", en: "Pickup request" }
  // REVIEW [2026-12-15] Documento ao qual a mensagem se refere.
  about: Shipment

  // REVIEW [2026-12-15] Dados transportados pela mensagem.
  payload {
    // REVIEW [2026-12-15] Data/hora em que a coleta foi solicitada.
    requestedAt: DateTime { title: { pt-BR: "Solicitado em", en: "Requested at" } }
    // REVIEW [2026-12-15] Janela de horário para a coleta.
    window: Duration { title: { pt-BR: "Janela de coleta", en: "Pickup window" } }
  }
}
