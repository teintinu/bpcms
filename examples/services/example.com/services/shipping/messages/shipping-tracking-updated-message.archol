// REVIEW [2026-12-15] service: example.com/services/shipping

// REVIEW [2026-12-15] Mensagem que notifica uma atualização de rastreio.
message TrackingUpdated {
  // REVIEW [2026-12-15] Título exibido no histórico e nas integrações.
  title: { pt-BR: "Rastreio atualizado", en: "Tracking updated" }
  // REVIEW [2026-12-15] Documento ao qual a mensagem se refere.
  about: Shipment

  // REVIEW [2026-12-15] Dados transportados pela mensagem.
  payload {
    // REVIEW [2026-12-15] Tipo do evento de rastreio recebido.
    kind: TrackingKind { title: { pt-BR: "Tipo de evento", en: "Event kind" } }
    // REVIEW [2026-12-15] Data/hora em que o evento aconteceu.
    at: DateTime { title: { pt-BR: "Data/hora", en: "At" } }
    // REVIEW [2026-12-15] Nome de quem recebeu a remessa no evento.
    receivedBy: string { title: { pt-BR: "Recebido por", en: "Received by" } }
  }
}
