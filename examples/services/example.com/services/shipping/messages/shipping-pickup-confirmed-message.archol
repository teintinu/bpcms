// REVIEW [2026-12-15] service: example.com/services/shipping

// REVIEW [2026-12-15] Mensagem que confirma a coleta da remessa.
message PickupConfirmed {
  // REVIEW [2026-12-15] Título exibido no histórico e nas integrações.
  title: { pt-BR: "Coleta confirmada", en: "Pickup confirmed" }
  // REVIEW [2026-12-15] Documento ao qual a mensagem se refere.
  about: Shipment

  // REVIEW [2026-12-15] Dados transportados pela mensagem.
  payload {
    // REVIEW [2026-12-15] Data/hora em que a remessa foi coletada.
    pickedUpOn: DateTime { title: { pt-BR: "Coletada em", en: "Picked up at" } }
    // REVIEW [2026-12-15] Código de rastreio da remessa coletada.
    tracking: TrackingCode { title: { pt-BR: "Rastreio", en: "Tracking" } }
  }
}
