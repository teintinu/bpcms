// REVIEW [2026-12-15] service: example.com/services/shipping

// REVIEW [2026-12-15] Forma reutilizável que descreve um evento de rastreio da remessa.
shape TrackingEvent {
  // REVIEW [2026-12-15] Título exibido no builder e nas telas que usam a forma.
  title: { pt-BR: "Evento de rastreio", en: "Tracking event" }

  // REVIEW [2026-12-15] Campos que compõem o evento.
  fields {
    // REVIEW [2026-12-15] Momento em que o evento aconteceu.
    at: DateTime { title: { pt-BR: "Data/hora", en: "At" } }
    // REVIEW [2026-12-15] Tipo/classificação do evento de rastreio.
    kind: TrackingKind { title: { pt-BR: "Tipo", en: "Kind" } }
    // REVIEW [2026-12-15] Texto descritivo do evento, como "saiu para entrega".
    description: string { title: { pt-BR: "Descrição", en: "Description" } }
  }
}
