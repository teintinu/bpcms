// REVIEW [2026-12-15] service: example.com/services/shipping

// REVIEW [2026-12-15] Integração REST com a transportadora para cotação, etiqueta e rastreio.
integration Carrier {
  // REVIEW [2026-12-15] Protocolo usado na comunicação.
  protocol: rest
  // REVIEW [2026-12-15] URL base lida da variável de ambiente da aplicação.
  baseUrl: env.CARRIER_URL
  // REVIEW [2026-12-15] Autenticação OAuth2 junto à transportadora.
  auth: oauth2
  // REVIEW [2026-12-15] Tempo máximo de espera de cada chamada.
  timeout: 20s

  // REVIEW [2026-12-15] Operações expostas pela integração.
  operations {
    // REVIEW [2026-12-15] Cota o frete de uma remessa com a transportadora informada.
    quote(shipment: Shipment, carrier: string): std.Money
    // REVIEW [2026-12-15] Emite a etiqueta de envio e devolve o código de rastreio.
    createLabel(shipment: Shipment, carrier: string): TrackingCode
    // REVIEW [2026-12-15] Consulta os eventos de rastreio de um código.
    track(tracking: TrackingCode): TrackingEvent[]
  }
}

// REVIEW [2026-12-15] Integração MQTT com a balança do posto de expedição.
integration ScaleDevice {
  // REVIEW [2026-12-15] Declara a integração como equipamento conectado.
  capabilities { equipment }
  // REVIEW [2026-12-15] Protocolo de mensagens usado pela balança.
  protocol: mqtt
  // REVIEW [2026-12-15] Host lido da variável de ambiente da aplicação.
  host: env.SCALE_HOST
  // REVIEW [2026-12-15] Tópico assinado para receber as leituras de peso.
  topic: "scales/+/reading"
  // REVIEW [2026-12-15] Autenticação por certificado digital.
  auth: certificate

  // REVIEW [2026-12-15] Operações expostas pela integração.
  operations {
    // REVIEW [2026-12-15] Lê o peso atual de um dispositivo pelo identificador.
    read(deviceId: string): std.Mass
  }

  // REVIEW [2026-12-15] Eventos recebidos do equipamento e seu destino no documento.
  events {
    // REVIEW [2026-12-15] Cada leitura atualiza o peso bruto da remessa.
    reading -> Shipment.pesoBruto
  }

  // REVIEW [2026-12-15] Regras de qualidade dos dados do equipamento.
  quality {
    // REVIEW [2026-12-15] Considera a leitura desatualizada após cinco minutos.
    staleAfter: 5m
    // REVIEW [2026-12-15] Exige calibração mensal do equipamento.
    calibrate: monthly
  }
}
