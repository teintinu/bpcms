// REVIEW [2026-12-15] service: example.com/services/shipping

// REVIEW [2026-12-15] Organograma da área de logística, que define cargos e subordinação.
organogram Logistics {
  // REVIEW [2026-12-15] Título exibido no builder e na tela de organização.
  title: { pt-BR: "Organograma de logística", en: "Logistics organogram" }

  // REVIEW [2026-12-15] Estrutura de subordinação entre os cargos.
  hierarchy {
    // REVIEW [2026-12-15] Cadeia de comando: gerente, despachante e embalador.
    Manager > Dispatcher > Packer
  }

  // REVIEW [2026-12-15] O gerente responde pelo despachante.
  // REVIEW [2026-12-15] O despachante responde pelo embalador.
}

// REVIEW [2026-12-15] Papel operacional de embalar e consultar remessas.
role Packer {
  // REVIEW [2026-12-15] Título do papel exibido na interface.
  title: { pt-BR: "Embalador", en: "Packer" }
  // REVIEW [2026-12-15] Permissões de embalar e visualizar remessas.
  permissions: [shipment.pack, shipment.view]
}

// REVIEW [2026-12-15] Papel de despachar, rastrear e reagendar remessas.
role Dispatcher {
  // REVIEW [2026-12-15] Título do papel exibido na interface.
  title: { pt-BR: "Despachante", en: "Dispatcher" }
  // REVIEW [2026-12-15] Herda as permissões do papel de embalador.
  inherits: Packer
  // REVIEW [2026-12-15] Permissões de despacho, rastreio e reentrega.
  permissions: [shipment.dispatch, shipment.track, shipment.retry]
}

// REVIEW [2026-12-15] Papel de gestão da logística.
role Manager {
  // REVIEW [2026-12-15] Título do papel exibido na interface.
  title: { pt-BR: "Gerente de logística", en: "Logistics manager" }
  // REVIEW [2026-12-15] Herda as permissões do despachante.
  inherits: Dispatcher
  // REVIEW [2026-12-15] Permissões de cancelar, dividir e ver relatórios.
  permissions: [shipment.cancel, shipment.split, report.view]
}

// REVIEW [2026-12-15] Papel de sistema usado pelas automações de expedição.
role ShipmentEngine {
  // REVIEW [2026-12-15] Título do papel exibido na interface.
  title: { pt-BR: "Motor de expedição", en: "Shipment engine" }
  // REVIEW [2026-12-15] Permissões de captura e confirmação de entrega.
  permissions: [shipment.capture, shipment.deliver]
}
