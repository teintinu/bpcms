// REVIEW [2026-12-15] service: example.com/services/shipping

// REVIEW [2026-12-15] Declara o serviço de expedição e a URI que o identifica no workspace.
service "example.com/services/shipping" {
  // REVIEW [2026-12-15] Título exibido no builder e na navegação.
  title: { pt-BR: "Expedição", en: "Shipping" }
  locales: [ "pt-BR", "en" ] // REVIEW [2026-12-18] Idiomas suportados pelo serviço; o primeiro é o default do I18N em forma de string.
  // REVIEW [2026-12-15] Versão do serviço; releases e locks comparam este valor.
  // REVIEW [2026-12-15] Área responsável pelo serviço.
  // REVIEW [2026-12-15] Serviços externos usados por este serviço, com alias local.
  imports {
    // REVIEW [2026-12-15] Medidas e constantes padrão do construtor (massa, dinheiro, contagem).
    service "bpcms.org/std" as std
    // REVIEW [2026-12-15] Catálogo de produtos, usado nos itens da remessa.
    service "example.com/services/catalog" as Catalog
    // REVIEW [2026-12-15] Pedidos de venda, origem do documento Order.
    service "example.com/services/orders" as Orders
  }
}
