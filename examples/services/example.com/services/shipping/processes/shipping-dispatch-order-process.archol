// REVIEW [2026-12-15] service: example.com/services/shipping
// REVIEW [2026-12-15] Process: sintaxe atual (DSL_REFERENCE.md §4)

// REVIEW [2026-12-15] Processo que separa, embala, pesa, cota e despacha a remessa.
process DispatchOrder(shipment: Shipment) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Despacho do pedido", en: "Order dispatch" }
  // REVIEW [2026-12-15] Versão do artefato Process; diff e release comparam.
  version: 1
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Separar, embalar, pesar, cotar o frete e despachar com etiqueta"
  }
  // REVIEW [2026-12-15] SLA brando do caso: alvo de lead time, não é timer.
  sla: 1d

  // REVIEW [2026-12-15] Gatilho: inicia um caso quando a remessa é criada.
  on [Shipment.Created]
  // REVIEW [2026-12-15] Chave de identidade, correlação e dedup da instância.
  key: shipment

  // REVIEW [2026-12-15] Frete cotado; começa nulo até a cotação ou o informe manual.
  let freight: std.Money | null = null
  // REVIEW [2026-12-15] Código de rastreio emitido; começa nulo até a etiqueta.
  let tracking: TrackingCode | null = null

  // REVIEW [2026-12-15] Bloco que tenta executar a separação no prazo.
  try {
    // REVIEW [2026-12-15] Abre a tarefa manual de separação dos itens.
    Pick.show({ shipment })
  } catch (Timeout) {
    // REVIEW [2026-12-15] Separação atrasada: escala a tarefa para o gerente.
    Escalate.show({ shipment })
  }

  // REVIEW [2026-12-15] Abre o formulário de embalagem da remessa.
  Packing.show({ shipment })

  // REVIEW [2026-12-15] Abre a tarefa manual de pesagem na balança.
  Weigh.show({ shipment })

  // REVIEW [2026-12-15] Só cota o frete quando o peso está dentro do limite permitido.
  if (shipment.pesoBruto <= MaxWeight) {
    // REVIEW [2026-12-15] Bloco que tenta cotar o frete com a transportadora.
    try {
      // REVIEW [2026-12-15] Cota o frete da remessa com a CarrierX e guarda o valor.
      freight = Carrier.quote({ shipment, carrier: "CarrierX" })
    } catch (CarrierUnavailable) {
      // REVIEW [2026-12-15] O próprio form aplica o frete manual no documento.
      FreightOverride.show({ shipment })
    }
  } else {
    // REVIEW [2026-12-15] Acima do limite de peso: abre o formulário para dividir a remessa.
    SplitShipment.show({ shipment })

    // REVIEW [2026-12-15] Se a remessa foi cancelada na divisão, encerra no desfecho Cancelled.
    if (shipment.status == Cancelled) {
      // REVIEW [2026-12-15] Encerra o caso no desfecho Cancelled.
      return Cancelled
    }

    // REVIEW [2026-12-15] Encerra o caso no desfecho de remessa dividida.
    return SplitDone
  }

  // REVIEW [2026-12-15] Aplica o frete cotado quando a cotação produziu valor.
  if (freight != null) {
    // REVIEW [2026-12-15] Persiste transportadora e frete no documento.
    Shipment.applyFreight({ carrier: "CarrierX", amount: freight })
  }

  // REVIEW [2026-12-15] Laço de emissão de etiqueta, limitado a três tentativas.
  loop LabelAttempt max 3 {
    // REVIEW [2026-12-15] Bloco que tenta emitir a etiqueta com a transportadora.
    try {
      // REVIEW [2026-12-15] Emite a etiqueta e guarda o código de rastreio.
      tracking = Carrier.createLabel({ shipment, carrier: "CarrierX" })
      // REVIEW [2026-12-15] Etiqueta emitida: sai do laço de tentativas.
      break
    } catch (LabelRejected) {
      // REVIEW [2026-12-15] Etiqueta recusada: reabre o formulário de frete manual.
      FreightOverride.show({ shipment })
    }
  }

  // REVIEW [2026-12-15] Sem etiqueta após as tentativas, cancela a remessa.
  if (tracking == null) {
    // REVIEW [2026-12-15] Cancela a remessa com o motivo da falha de etiqueta.
    Shipment.cancel({ reason: "Etiqueta rejeitada após as tentativas de emissão" })
    // REVIEW [2026-12-15] Encerra o caso no desfecho Cancelled.
    return Cancelled
  }

  // REVIEW [2026-12-15] Despacha a remessa com o código de rastreio emitido.
  Shipment.dispatch({ trackingCode: tracking })

  // REVIEW [2026-12-15] Envia a solicitação de coleta à transportadora.
  send PickupRequest {
    // REVIEW [2026-12-15] Correlaciona a mensagem com a remessa do caso.
    key: shipment
    // REVIEW [2026-12-15] Dados enviados: data/hora da solicitação.
    with { requestedAt: now() }
  }

  // REVIEW [2026-12-15] Bloco que aguarda a confirmação da coleta.
  try {
    // REVIEW [2026-12-15] Aguarda PickupConfirmed para a remessa, com prazo de dois dias.
    receive PickupConfirmed {
      // REVIEW [2026-12-15] Correlaciona o evento com a remessa do caso.
      key: shipment
      // REVIEW [2026-12-15] Tempo máximo de espera pela confirmação.
      timeout: 2d
      // REVIEW [2026-12-15] Aplica a confirmação na action do documento.
      apply: Shipment.confirmPickup
    }
  } catch (Timeout) {
    // REVIEW [2026-12-15] Sem confirmação no prazo: abre o formulário de confirmação manual.
    PickupConfirmation.show({ shipment })
  }

  // REVIEW [2026-12-15] Dispara o processo de acompanhamento da entrega para a remessa.
  DeliveryTracking.run({ shipment })

  // REVIEW [2026-12-15] Encerra o caso no desfecho de sucesso do despacho.
  return Dispatched

  // REVIEW [2026-12-15] Declara o desfecho de sucesso do despacho.
  end Dispatched {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Despachada", en: "Dispatched" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }
  // REVIEW [2026-12-15] Declara o desfecho de remessa dividida.
  end SplitDone {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Dividida", en: "Split" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }
  // REVIEW [2026-12-15] Declara o desfecho de cancelamento do caso.
  end Cancelled {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Cancelada", en: "Cancelled" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: cancelled
  }
}

// REVIEW [2026-12-15] Erro de negócio: transportadora indisponível.
error CarrierUnavailable {
  // REVIEW [2026-12-15] Título do erro exibido ao usuário.
  title: { pt-BR: "Transportadora indisponível", en: "Carrier unavailable" }
}

// REVIEW [2026-12-15] Erro de negócio: etiqueta recusada pela transportadora.
error LabelRejected {
  // REVIEW [2026-12-15] Título do erro exibido ao usuário.
  title: { pt-BR: "Etiqueta rejeitada pela transportadora", en: "Label rejected by carrier" }
}

// REVIEW [2026-12-15] Tarefa manual de separação dos itens no armazém.
manual Pick {
  // REVIEW [2026-12-15] Título exibido na caixa de entrada.
  title: { pt-BR: "Separar itens", en: "Pick items" }
  // REVIEW [2026-12-15] Documento-sujeito da tarefa.
  document: Shipment
  // REVIEW [2026-12-15] Papéis que podem executar a tarefa.
  roles: [Packer]
  // REVIEW [2026-12-15] Orientação exibida ao executor.
  instructions: "Separar os itens do pedido no armazém"
  // REVIEW [2026-12-15] Prazo para conclusão antes do timeout.
  timeout: 4h
  // REVIEW [2026-12-15] Prioridade na fila de trabalho.
  priority: 60
  // REVIEW [2026-12-15] Distribuição por retirada manual da fila.
  assign: pull
}

// REVIEW [2026-12-15] Tarefa manual de escalação da separação atrasada.
manual Escalate {
  // REVIEW [2026-12-15] Título exibido na caixa de entrada.
  title: { pt-BR: "Escalar separação", en: "Escalate picking" }
  // REVIEW [2026-12-15] Documento-sujeito da tarefa.
  document: Shipment
  // REVIEW [2026-12-15] Papéis que podem executar a tarefa.
  roles: [Manager]
  // REVIEW [2026-12-15] Orientação exibida ao executor.
  instructions: "Priorizar a separação com o supervisor"
  // REVIEW [2026-12-15] Prazo para conclusão antes do timeout.
  timeout: 1h
  // REVIEW [2026-12-15] Prioridade na fila de trabalho.
  priority: 70
  // REVIEW [2026-12-15] Distribuição por retirada manual da fila.
  assign: pull
}

// REVIEW [2026-12-15] Tarefa manual de pesagem da remessa na balança do posto.
manual Weigh {
  // REVIEW [2026-12-15] Título exibido na caixa de entrada.
  title: { pt-BR: "Pesar remessa", en: "Weigh shipment" }
  // REVIEW [2026-12-15] Documento-sujeito da tarefa.
  document: Shipment
  // REVIEW [2026-12-15] Papéis que podem executar a tarefa.
  roles: [Packer]
  // REVIEW [2026-12-15] Orientação exibida ao executor.
  instructions: "Conferir o peso da remessa na balança do posto"
  // REVIEW [2026-12-15] Prazo para conclusão antes do timeout.
  timeout: 15m
  // REVIEW [2026-12-15] Prioridade na fila de trabalho.
  priority: 50
  // REVIEW [2026-12-15] Distribuição por retirada manual da fila.
  assign: pull
}

// REVIEW [2026-12-15] Formulário de embalagem da remessa.
form Packing {
  // REVIEW [2026-12-15] Título exibido na caixa de entrada e no formulário.
  title: { pt-BR: "Embalar remessa", en: "Pack shipment" }
  // REVIEW [2026-12-15] Documento-sujeito alterado pelo formulário.
  document: Shipment
  // REVIEW [2026-12-15] Papéis que podem executar o formulário.
  roles: [Packer]
  // REVIEW [2026-12-15] Prazo para conclusão antes do timeout do caso.
  timeout: 1h
  // REVIEW [2026-12-15] Prioridade na fila de trabalho.
  priority: 50
  // REVIEW [2026-12-15] Distribuição por retirada manual da fila.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Pedido relacionado à remessa, exibido como referência.
    order
    // REVIEW [2026-12-15] Itens que serão embalados na remessa.
    items
    // REVIEW [2026-12-15] Peso bruto conferido na pesagem.
    pesoBruto
  }

  // REVIEW [2026-12-15] Ações disponíveis no formulário.
  actions {
    // REVIEW [2026-12-15] Ação que confirma a embalagem da remessa.
    confirm {
      // REVIEW [2026-12-15] Título do botão de ação.
      title: { pt-BR: "Confirmar embalagem", en: "Confirm packing" }
      // REVIEW [2026-12-15] Chama a action de embalagem do documento.
      calls: Shipment.pack
    }
  }
}

// REVIEW [2026-12-15] Formulário para dividir a remessa acima do limite de peso.
form SplitShipment {
  // REVIEW [2026-12-15] Título exibido na caixa de entrada e no formulário.
  title: { pt-BR: "Dividir remessa", en: "Split shipment" }
  // REVIEW [2026-12-15] Documento-sujeito alterado pelo formulário.
  document: Shipment
  // REVIEW [2026-12-15] Papéis que podem executar o formulário.
  roles: [Manager]
  // REVIEW [2026-12-15] Prazo para conclusão antes do timeout do caso.
  timeout: 4h
  // REVIEW [2026-12-15] Prioridade na fila de trabalho.
  priority: 60
  // REVIEW [2026-12-15] Distribuição por retirada manual da fila.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Pedido relacionado à remessa, exibido como referência.
    order
    // REVIEW [2026-12-15] Itens que serão redistribuídos na divisão.
    items
    // REVIEW [2026-12-15] Peso bruto que motivou a divisão.
    pesoBruto
    // REVIEW [2026-12-15] Motivo da divisão, com limite de quinhentos caracteres.
    reason: string {
      // REVIEW [2026-12-15] Título do campo no formulário.
      title: { pt-BR: "Motivo", en: "Reason" }
      // REVIEW [2026-12-15] Limita o motivo a quinhentos caracteres.
      maxLength: 500
    }
  }

  // REVIEW [2026-12-15] Ações disponíveis no formulário.
  actions {
    // REVIEW [2026-12-15] Ação que divide a remessa em duas.
    split {
      // REVIEW [2026-12-15] Título do botão de ação.
      title: { pt-BR: "Dividir", en: "Split" }
      // REVIEW [2026-12-15] Chama a action de divisão do documento.
      calls: Shipment.split
    }
    // REVIEW [2026-12-15] Ação que cancela a remessa em vez de dividi-la.
    cancel {
      // REVIEW [2026-12-15] Título do botão de ação.
      title: { pt-BR: "Cancelar remessa", en: "Cancel shipment" }
      // REVIEW [2026-12-15] Chama a action de cancelamento com o motivo informado.
      calls: Shipment.cancel(reason)
    }
  }
}

// REVIEW [2026-12-15] Formulário para confirmar manualmente a coleta da remessa.
form PickupConfirmation {
  // REVIEW [2026-12-15] Título exibido na caixa de entrada e no formulário.
  title: { pt-BR: "Confirmar coleta", en: "Confirm pickup" }
  // REVIEW [2026-12-15] Documento-sujeito alterado pelo formulário.
  document: Shipment
  // REVIEW [2026-12-15] Papéis que podem executar o formulário.
  roles: [Dispatcher]
  // REVIEW [2026-12-15] Prazo para conclusão antes do timeout do caso.
  timeout: 1d
  // REVIEW [2026-12-15] Prioridade na fila de trabalho.
  priority: 60
  // REVIEW [2026-12-15] Distribuição por retirada manual da fila.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Pedido relacionado à remessa, exibido como referência.
    order
    // REVIEW [2026-12-15] Código de rastreio da remessa, exibido como referência.
    tracking
    // REVIEW [2026-12-15] Data/hora em que a remessa foi coletada.
    pickedUpOn: DateTime {
      // REVIEW [2026-12-15] Título do campo no formulário.
      title: { pt-BR: "Coletada em", en: "Picked up at" }
      // REVIEW [2026-12-15] Torna o campo obrigatório.
      required
    }
  }

  // REVIEW [2026-12-15] Ações disponíveis no formulário.
  actions {
    // REVIEW [2026-12-15] Ação que confirma a coleta na data informada.
    confirm {
      // REVIEW [2026-12-15] Título do botão de ação.
      title: { pt-BR: "Confirmar coleta", en: "Confirm pickup" }
      // REVIEW [2026-12-15] Chama a action de confirmação de coleta do documento.
      calls: Shipment.confirmPickup(pickedUpOn)
    }
  }
}
