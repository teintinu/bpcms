// REVIEW [2026-12-15] service: example.com/services/shipping
// REVIEW [2026-12-15] Process: sintaxe atual (DSL_REFERENCE.md §4)

// REVIEW [2026-12-15] Processo que acompanha a entrega e trata tentativas falhas.
process DeliveryTracking(shipment: Shipment) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Acompanhamento da entrega", en: "Delivery tracking" }
  // REVIEW [2026-12-15] Versão do artefato Process; diff e release comparam.
  version: 1
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Acompanhar a entrega, tratar tentativa falha e reentregar"
  }
  // REVIEW [2026-12-15] SLA brando do caso: alvo de lead time, não é timer.
  sla: 30d

  // REVIEW [2026-12-15] Indica que o processo é chamado por outro processo, sem gatilho próprio.
  called

  // REVIEW [2026-12-15] Flag durável que registra se a espera por rastreio expirou.
  let timedOut = false

  // REVIEW [2026-12-15] Laço de ciclos de rastreio, limitado a dez iterações.
  loop TrackingCycle max 10 {
    // REVIEW [2026-12-15] Bloco que tenta aguardar um evento de rastreio.
    try {
      // REVIEW [2026-12-15] Aguarda TrackingUpdated para a remessa, com prazo de três dias.
      receive TrackingUpdated {
        // REVIEW [2026-12-15] Correlaciona o evento com a remessa do caso.
        key: shipment
        // REVIEW [2026-12-15] Tempo máximo de espera pelo evento.
        timeout: 3d
        // REVIEW [2026-12-15] Aplica o evento na action de rastreio do documento.
        apply: Shipment.applyTracking
      }
      // REVIEW [2026-12-15] Evento recebido: a espera não expirou.
      timedOut = false
    } catch (Timeout) {
      // REVIEW [2026-12-15] Sem evento no prazo: abre a tarefa de cobrança do rastreio.
      Chase.show({ shipment })
      // REVIEW [2026-12-15] Marca que a espera expirou.
      timedOut = true
    }

    // REVIEW [2026-12-15] Só interpreta o rastreio quando um evento foi recebido.
    if (!timedOut) {
      // REVIEW [2026-12-15] Último evento indica que a entrega foi concluída.
      if (shipment.lastTrackingKind == Completed) {
        // REVIEW [2026-12-15] Confirma a entrega no documento.
        Shipment.markDelivered()
        // REVIEW [2026-12-15] Encerra o caso no desfecho Delivered.
        return Delivered
      // REVIEW [2026-12-15] Último evento indica que a tentativa de entrega falhou.
      } else if (shipment.lastTrackingKind == AttemptFailed) {
        // REVIEW [2026-12-15] Registra a tentativa falha e incrementa o contador.
        Shipment.markAttemptFailed({ reason: "Tentativa de entrega frustrada pelo parceiro" })

        // REVIEW [2026-12-15] Abre o formulário para reagendar ou devolver a remessa.
        DeliveryRetry.show({ shipment })

        // REVIEW [2026-12-15] Se a remessa foi devolvida, encerra no desfecho Returned.
        if (shipment.status == Returned) {
          // REVIEW [2026-12-15] Encerra o caso no desfecho Returned.
          return Returned
        }

        // REVIEW [2026-12-15] Aguarda até a data/hora agendada para a próxima tentativa.
        wait until shipment.nextAttemptAt
      }
    }
  }

  // REVIEW [2026-12-15] Cancelamento da remessa interrompe o acompanhamento.
  cancel on Shipment.Cancelled {
    // REVIEW [2026-12-15] Encerra o caso no desfecho Stopped.
    return Stopped
  }

  // REVIEW [2026-12-15] Encerra o caso no desfecho Stopped quando o laço termina sem entrega.
  return Stopped

  // REVIEW [2026-12-15] Declara o desfecho de sucesso do caso.
  end Delivered {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Entregue", en: "Delivered" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }
  // REVIEW [2026-12-15] Declara o desfecho de cancelamento do caso.
  end Returned {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Devolvida", en: "Returned" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: cancelled
  }
  // REVIEW [2026-12-15] Declara o desfecho de encerramento sem entrega.
  end Stopped {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Encerrada", en: "Stopped" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: cancelled
  }
}

// REVIEW [2026-12-15] Tarefa manual para cobrar a posição do rastreio da transportadora.
manual Chase {
  // REVIEW [2026-12-15] Título exibido na caixa de entrada.
  title: { pt-BR: "Cobrar posição do rastreio", en: "Chase tracking status" }
  // REVIEW [2026-12-15] Documento-sujeito da tarefa.
  document: Shipment
  // REVIEW [2026-12-15] Papéis que podem executar a tarefa.
  roles: [Dispatcher]
  // REVIEW [2026-12-15] Orientação exibida ao executor.
  instructions: "Ligar para a transportadora e pedir posição do rastreio"
  // REVIEW [2026-12-15] Prazo para conclusão antes do timeout.
  timeout: 1d
  // REVIEW [2026-12-15] Prioridade na fila de trabalho.
  priority: 60
  // REVIEW [2026-12-15] Distribuição por retirada manual da fila.
  assign: pull
}

// REVIEW [2026-12-15] Formulário para reagendar a entrega ou devolver a remessa.
form DeliveryRetry {
  // REVIEW [2026-12-15] Título exibido na caixa de entrada e no formulário.
  title: { pt-BR: "Reagendar entrega", en: "Reschedule delivery" }
  // REVIEW [2026-12-15] Documento-sujeito alterado pelo formulário.
  document: Shipment
  // REVIEW [2026-12-15] Papéis que podem executar o formulário.
  roles: [Dispatcher]
  // REVIEW [2026-12-15] Prazo para conclusão antes do timeout do caso.
  timeout: 4h
  // REVIEW [2026-12-15] Prioridade na fila de trabalho.
  priority: 70
  // REVIEW [2026-12-15] Distribuição por retirada manual da fila.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Pedido relacionado à remessa, exibido como referência.
    order
    // REVIEW [2026-12-15] Código de rastreio da remessa, exibido como referência.
    tracking
    // REVIEW [2026-12-15] Data/hora proposta para a nova tentativa de entrega.
    attemptOn: DateTime {
      // REVIEW [2026-12-15] Título do campo no formulário.
      title: { pt-BR: "Nova tentativa", en: "New attempt" }
      // REVIEW [2026-12-15] Torna o campo obrigatório.
      required
    }
  }

  // REVIEW [2026-12-15] Ações disponíveis no formulário.
  actions {
    // REVIEW [2026-12-15] Ação que agenda a reentrega na data escolhida.
    confirm {
      // REVIEW [2026-12-15] Título do botão de ação.
      title: { pt-BR: "Agendar reentrega", en: "Schedule retry" }
      // REVIEW [2026-12-15] Chama a action do documento com a data informada.
      calls: Shipment.scheduleRetry(attemptOn)
    }
    // REVIEW [2026-12-15] Ação que devolve a remessa ao remetente.
    sendBack {
      // REVIEW [2026-12-15] Título do botão de ação.
      title: { pt-BR: "Devolver ao remetente", en: "Return to sender" }
      // REVIEW [2026-12-15] Chama a action de devolução do documento.
      calls: Shipment.returnToSender
    }
  }
}
