// service: example.com/services/shipping
// Process: sintaxe atual (DSL_REFERENCE.md §4)

// Processo que cota o frete em paralelo e aplica a melhor oferta.
process FreightQuote(shipment: Shipment) {
  // Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Cotação de frete", en: "Freight quote" }
  // Versão do artefato Process; diff e release comparam.
  version: 1
  // Objetivo de negócio usado na revisão e no painel.
  goal: {
    // Texto do objetivo em português.
    pt-BR: "Cotar frete em várias transportadoras e aplicar a melhor oferta"
  }
  // SLA brando do caso: alvo de lead time, não é timer.
  sla: 1d

  // Gatilho: inicia um caso quando a remessa emite QuoteRequested.
  on [Shipment.QuoteRequested]
  // Chave de identidade, correlação e dedup da instância.
  key: shipment

  // Oferta da transportadora A; começa nula.
  let quoteA: std.Money | null = null
  // Oferta da transportadora B; começa nula.
  let quoteB: std.Money | null = null
  // Oferta da transportadora C; começa nula.
  let quoteC: std.Money | null = null

  // Executa as três cotações em paralelo e junta os resultados.
  parallel {
    // Ramo que cota com a transportadora A.
    branch AskA {
      // Tenta obter a oferta da transportadora A.
      try {
        // Guarda o valor cotado pela transportadora A.
        quoteA = Carrier.quote({ shipment, carrier: "CarrierA" })
      } catch (Timeout) {
        // Oferta ausente: após o join, o frete é informado manualmente.
      }
    }
    // Ramo que cota com a transportadora B.
    branch AskB {
      // Tenta obter a oferta da transportadora B.
      try {
        // Guarda o valor cotado pela transportadora B.
        quoteB = Carrier.quote({ shipment, carrier: "CarrierB" })
      } catch (Timeout) {
        // Oferta ausente: após o join, o frete é informado manualmente.
      }
    }
    // Ramo que cota com a transportadora C.
    branch AskC {
      // Tenta obter a oferta da transportadora C.
      try {
        // Guarda o valor cotado pela transportadora C.
        quoteC = Carrier.quote({ shipment, carrier: "CarrierC" })
      } catch (Timeout) {
        // Oferta ausente: após o join, o frete é informado manualmente.
      }
    }
  }

  // Só compara as ofertas quando as três transportadoras responderam.
  if (quoteA != null and quoteB != null and quoteC != null) {
    // A oferta da transportadora A é a mais barata.
    if (quoteA <= quoteB and quoteA <= quoteC) {
      // Aplica o frete da transportadora A na remessa.
      Shipment.applyFreight({ carrier: "CarrierA", amount: quoteA })
    // A oferta da transportadora B é a mais barata entre as restantes.
    } else if (quoteB <= quoteC) {
      // Aplica o frete da transportadora B na remessa.
      Shipment.applyFreight({ carrier: "CarrierB", amount: quoteB })
    } else {
      // Aplica o frete da transportadora C na remessa.
      Shipment.applyFreight({ carrier: "CarrierC", amount: quoteC })
    }

    // Encerra o caso no desfecho de sucesso.
    return Quoted
  }

  // Sem as três ofertas, pede ao gerente que informe o frete manualmente.
  try {
    // Abre o formulário de frete manual.
    FreightOverride.show({ shipment })
  } catch (Timeout) {
    // Se o formulário expirar, abre a tarefa de encerramento da cotação.
    AbandonQuote.show({ shipment })
    // Encerra o caso no desfecho de falha.
    return Expired
  }

  // Encerra o caso no desfecho de sucesso.
  return Quoted

  // Declara o desfecho de sucesso do caso.
  end Quoted {
    // Título exibido no histórico e nos filtros.
    title: { pt-BR: "Cotada", en: "Quoted" }
    // Classificação do desfecho para KPI.
    outcome: success
  }
  // Declara o desfecho de falha do caso.
  end Expired {
    // Título exibido no histórico.
    title: { pt-BR: "Cotação expirada", en: "Quote expired" }
    // Classificação do desfecho para KPI.
    outcome: failure
  }
}

// Tarefa manual para encerrar a cotação como expirada.
manual AbandonQuote {
  // Título exibido na caixa de entrada.
  title: { pt-BR: "Encerrar cotação", en: "Abandon quote" }
  // Documento-sujeito da tarefa.
  document: Shipment
  // Papéis que podem executar a tarefa.
  roles: [Manager]
  // Orientação exibida ao executor.
  instructions: "Encerrar a cotação como expirada e avisar o despachante"
  // Prazo para conclusão antes do timeout.
  timeout: 1h
  // Prioridade na fila de trabalho.
  priority: 70
  // Distribuição por retirada manual da fila.
  assign: pull
}
