// REVIEW [2026-12-15] service: example.com/services/shipping
// REVIEW [2026-12-15] Process: sintaxe atual (DSL_REFERENCE.md §4)

// REVIEW [2026-12-15] Processo que cota o frete em paralelo e aplica a melhor oferta.
process FreightQuote(shipment: Shipment) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Cotação de frete", en: "Freight quote" }
  // REVIEW [2026-12-15] Versão do artefato Process; diff e release comparam.
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Cotar frete em várias transportadoras e aplicar a melhor oferta"
  }
  // REVIEW [2026-12-15] SLA brando do caso: alvo de lead time, não é timer.
  sla: "1d"

  // REVIEW [2026-12-15] Gatilho: inicia um caso quando a remessa emite QuoteRequested.
  on [Shipment.QuoteRequested]
  // REVIEW [2026-12-15] Chave de identidade, correlação e dedup da instância.
  key: shipment

  // REVIEW [2026-12-25] Variáveis duráveis do processo; substituem as antigas declarações `let`.
  vars {
    // REVIEW [2026-12-15] Oferta da transportadora A; começa nula.
    quoteA: std.Money | null = null
    // REVIEW [2026-12-15] Oferta da transportadora B; começa nula.
    quoteB: std.Money | null = null
    // REVIEW [2026-12-15] Oferta da transportadora C; começa nula.
    quoteC: std.Money | null = null
  }

  // REVIEW [2026-12-15] Executa as três cotações em paralelo e junta os resultados.
  parallel {
    // REVIEW [2026-12-15] Ramo que cota com a transportadora A.
    branch AskA {
      // REVIEW [2026-12-15] Tenta obter a oferta da transportadora A.
      try {
        // REVIEW [2026-12-15] Guarda o valor cotado pela transportadora A.
        quoteA = Carrier.quote({ shipment, carrier: "CarrierA" })
      } catch (Timeout) {
        // REVIEW [2026-12-15] Oferta ausente: após o join, o frete é informado manualmente.
      }
    }
    // REVIEW [2026-12-15] Ramo que cota com a transportadora B.
    branch AskB {
      // REVIEW [2026-12-15] Tenta obter a oferta da transportadora B.
      try {
        // REVIEW [2026-12-15] Guarda o valor cotado pela transportadora B.
        quoteB = Carrier.quote({ shipment, carrier: "CarrierB" })
      } catch (Timeout) {
        // REVIEW [2026-12-15] Oferta ausente: após o join, o frete é informado manualmente.
      }
    }
    // REVIEW [2026-12-15] Ramo que cota com a transportadora C.
    branch AskC {
      // REVIEW [2026-12-15] Tenta obter a oferta da transportadora C.
      try {
        // REVIEW [2026-12-15] Guarda o valor cotado pela transportadora C.
        quoteC = Carrier.quote({ shipment, carrier: "CarrierC" })
      } catch (Timeout) {
        // REVIEW [2026-12-15] Oferta ausente: após o join, o frete é informado manualmente.
      }
    }
  }

  // REVIEW [2026-12-15] Só compara as ofertas quando as três transportadoras responderam.
  if (quoteA != null and quoteB != null and quoteC != null) {
    // REVIEW [2026-12-15] A oferta da transportadora A é a mais barata.
    if (quoteA <= quoteB and quoteA <= quoteC) {
      // REVIEW [2026-12-15] Aplica o frete da transportadora A na remessa.
      Shipment.applyFreight({ carrier: "CarrierA", amount: quoteA })
    // REVIEW [2026-12-15] A oferta da transportadora B é a mais barata entre as restantes.
    } else if (quoteB <= quoteC) {
      // REVIEW [2026-12-15] Aplica o frete da transportadora B na remessa.
      Shipment.applyFreight({ carrier: "CarrierB", amount: quoteB })
    } else {
      // REVIEW [2026-12-15] Aplica o frete da transportadora C na remessa.
      Shipment.applyFreight({ carrier: "CarrierC", amount: quoteC })
    }

    // REVIEW [2026-12-15] Encerra o caso no desfecho de sucesso.
    return Quoted
  }

  // REVIEW [2026-12-15] Sem as três ofertas, pede ao gerente que informe o frete manualmente.
  try {
    // REVIEW [2026-12-15] Abre o formulário de frete manual.
    FreightOverride.show({ shipment })
  } catch (Timeout) {
    // REVIEW [2026-12-15] Se o formulário expirar, abre a tarefa de encerramento da cotação.
    AbandonQuote.show({ shipment })
    // REVIEW [2026-12-15] Encerra o caso no desfecho de falha.
    return Expired
  }

  // REVIEW [2026-12-15] Encerra o caso no desfecho de sucesso.
  return Quoted

  // REVIEW [2026-12-15] Declara o desfecho de sucesso do caso.
  end Quoted {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Cotada", en: "Quoted" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }
  // REVIEW [2026-12-15] Declara o desfecho de falha do caso.
  end Expired {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Cotação expirada", en: "Quote expired" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: failure
  }
}

// REVIEW [2026-12-15] Tarefa manual para encerrar a cotação como expirada.
manual AbandonQuote {
  // REVIEW [2026-12-15] Título exibido na caixa de entrada.
  title: { pt-BR: "Encerrar cotação", en: "Abandon quote" }
  // REVIEW [2026-12-15] Documento-sujeito da tarefa.
  document: Shipment
  // REVIEW [2026-12-15] Papéis que podem executar a tarefa.
  roles: [Manager]
  // REVIEW [2026-12-15] Orientação exibida ao executor.
  instructions: "Encerrar a cotação como expirada e avisar o despachante"
  // REVIEW [2026-12-15] Prazo para conclusão antes do timeout.
  timeout: 1h
  // REVIEW [2026-12-15] Prioridade na fila de trabalho.
  priority: 70
  // REVIEW [2026-12-15] Distribuição por retirada manual da fila.
  assign: pull
}
