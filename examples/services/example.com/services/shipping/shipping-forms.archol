// REVIEW [2026-12-15] service: example.com/services/shipping

// REVIEW [2026-12-15] Formulário para o gerente informar o frete manualmente.
form FreightOverride {
  // REVIEW [2026-12-15] Título exibido na caixa de entrada e no formulário.
  title: { pt-BR: "Informar frete", en: "Enter freight" }
  // REVIEW [2026-12-15] Documento-sujeito alterado pelo formulário.
  document: Shipment
  // REVIEW [2026-12-15] Papéis que podem executar o formulário.
  roles: [Manager]
  // REVIEW [2026-12-15] Prazo para conclusão antes do timeout do caso.
  timeout: 1d
  // REVIEW [2026-12-15] Prioridade na fila de trabalho.
  priority: 60
  // REVIEW [2026-12-15] Distribuição por retirada manual da fila.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Pedido relacionado à remessa, exibido como referência.
    order
    // REVIEW [2026-12-15] Peso bruto da remessa, exibido para conferência.
    pesoBruto
    // REVIEW [2026-12-15] Nome da transportadora informada manualmente.
    carrier: string {
      // REVIEW [2026-12-15] Título do campo no formulário.
      title: { pt-BR: "Transportadora", en: "Carrier" }
      // REVIEW [2026-12-15] Limita o nome a sessenta caracteres.
      maxLength: 60
      // REVIEW [2026-12-15] Torna o campo obrigatório.
      required
    }
    // REVIEW [2026-12-15] Valor do frete informado manualmente.
    amount: std.Money {
      // REVIEW [2026-12-15] Título do campo no formulário.
      title: { pt-BR: "Frete", en: "Freight" }
      // REVIEW [2026-12-15] Moeda do valor em reais.
      currency: BRL
      // REVIEW [2026-12-15] Torna o valor obrigatório.
      required
    }
  }

  // REVIEW [2026-12-15] Ações disponíveis no formulário.
  actions {
    // REVIEW [2026-12-15] Ação que aplica o frete manual à remessa.
    apply {
      // REVIEW [2026-12-15] Título do botão de ação.
      title: { pt-BR: "Aplicar frete", en: "Apply freight" }
      // REVIEW [2026-12-15] Chama a action do documento com os campos preenchidos.
      calls: Shipment.applyFreight(carrier, amount)
    }
  }
}
