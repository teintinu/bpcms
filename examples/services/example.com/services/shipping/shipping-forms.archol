// service: example.com/services/shipping

// Formulário para o gerente informar o frete manualmente.
form FreightOverride {
  // Título exibido na caixa de entrada e no formulário.
  title: { pt-BR: "Informar frete", en: "Enter freight" }
  // Documento-sujeito alterado pelo formulário.
  document: Shipment
  // Papéis que podem executar o formulário.
  roles: [Manager]
  // Prazo para conclusão antes do timeout do caso.
  timeout: 1d
  // Prioridade na fila de trabalho.
  priority: 60
  // Distribuição por retirada manual da fila.
  assign: pull

  // Campos exibidos no formulário.
  fields {
    // Pedido relacionado à remessa, exibido como referência.
    order
    // Peso bruto da remessa, exibido para conferência.
    pesoBruto
    // Nome da transportadora informada manualmente.
    carrier: string {
      // Título do campo no formulário.
      title: { pt-BR: "Transportadora", en: "Carrier" }
      // Limita o nome a sessenta caracteres.
      maxLength: 60
      // Torna o campo obrigatório.
      required
    }
    // Valor do frete informado manualmente.
    amount: std.Money {
      // Título do campo no formulário.
      title: { pt-BR: "Frete", en: "Freight" }
      // Moeda do valor em reais.
      currency: BRL
      // Torna o valor obrigatório.
      required
    }
  }

  // Ações disponíveis no formulário.
  actions {
    // Ação que aplica o frete manual à remessa.
    apply {
      // Título do botão de ação.
      title: { pt-BR: "Aplicar frete", en: "Apply freight" }
      // Chama a action do documento com os campos preenchidos.
      calls: Shipment.applyFreight(carrier, amount)
    }
  }
}
