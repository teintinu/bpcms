// REVIEW [2026-12-15] service: example.com/services/shipping

// REVIEW [2026-12-15] Documento que representa uma remessa física, do rascunho à entrega.
document Shipment {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Remessa", en: "Shipment" }
  // REVIEW [2026-12-15] Versão do artefato; releases e locks comparam este valor.
  version: 2
  // REVIEW [2026-12-15] Área responsável pelo documento.
  owner: "Shipping"
  // REVIEW [2026-12-15] Sincronização em tempo real entre as telas que exibem a remessa.
  sync: live

  // REVIEW [2026-12-15] Campos que compõem a remessa.
  fields {
    // REVIEW [2026-12-15] Pedido de venda que originou a remessa.
    order: Order {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Pedido", en: "Order" }
      // REVIEW [2026-12-15] Permite localizar a remessa pelo pedido.
      lookup
    }
    // REVIEW [2026-12-15] Itens que compõem a remessa.
    items: ShipmentItem[] { title: { pt-BR: "Itens", en: "Items" } }
    // REVIEW [2026-12-15] Peso bruto medido na balança, em massa.
    pesoBruto: std.Mass { title: { pt-BR: "Peso bruto", en: "Gross weight" } }
    // REVIEW [2026-12-15] Volume cúbico ocupado pela remessa.
    volume: std.Volume { title: { pt-BR: "Volume", en: "Volume" } }
    // REVIEW [2026-12-15] Nome da transportadora responsável pelo transporte.
    carrierName: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Transportadora", en: "Carrier" }
      // REVIEW [2026-12-15] Limita o nome a sessenta caracteres.
      maxLength: 60
      // REVIEW [2026-12-15] Permite localizar a remessa pela transportadora.
      lookup
    }
    // REVIEW [2026-12-15] Valor do frete cobrado pela transportadora, em reais.
    frete: std.Money { title: { pt-BR: "Frete", en: "Freight" }, lookup, currency: BRL }
    // REVIEW [2026-12-15] Código de rastreio emitido pela transportadora.
    tracking: TrackingCode { title: { pt-BR: "Rastreio", en: "Tracking" }, lookup }
    // REVIEW [2026-12-15] Situação atual da remessa no ciclo de vida.
    status: ShipmentStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    // REVIEW [2026-12-15] Número de tentativas de entrega já realizadas.
    attempts: std.Count { title: { pt-BR: "Tentativas de entrega", en: "Delivery attempts" } }
    // REVIEW [2026-12-15] Tipo do último evento de rastreio recebido.
    lastTrackingKind: TrackingKind { title: { pt-BR: "Último evento", en: "Last event" } }
    // REVIEW [2026-12-15] Data/hora do último evento de rastreio.
    lastTrackingAt: DateTime { title: { pt-BR: "Último evento em", en: "Last event at" } }
    // REVIEW [2026-12-15] Nome de quem recebeu a remessa na entrega.
    receiverName: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Recebido por", en: "Received by" }
      // REVIEW [2026-12-15] Limita o nome a cento e vinte caracteres.
      maxLength: 120
    }
    // REVIEW [2026-12-15] Data/hora prevista para a próxima tentativa de entrega.
    nextAttemptAt: DateTime { title: { pt-BR: "Próxima tentativa", en: "Next attempt" } }
    // REVIEW [2026-12-15] Data/hora em que a remessa foi coletada.
    pickedUpAt: DateTime { title: { pt-BR: "Coletada em", en: "Picked up at" } }
    // REVIEW [2026-12-15] Data/hora em que a remessa foi embalada.
    packedAt: DateTime { title: { pt-BR: "Embalada em", en: "Packed at" } }
    // REVIEW [2026-12-15] Data/hora em que a remessa foi entregue.
    deliveredAt: DateTime { title: { pt-BR: "Entregue em", en: "Delivered at" } }
    // REVIEW [2026-12-15] Data/hora em que a remessa foi devolvida ao remetente.
    returnedAt: DateTime { title: { pt-BR: "Devolvida em", en: "Returned at" } }
    // REVIEW [2026-12-15] Data/hora da última pesagem registrada pelo dispositivo.
    readAt: DateTime { title: { pt-BR: "Pesada em", en: "Weighed at" } }
    // REVIEW [2026-12-15] Data/hora de criação do registro da remessa.
    createdAt: DateTime { title: { pt-BR: "Criada em", en: "Created at" }, lookup }
  }

  // REVIEW [2026-12-15] Recursos habilitados: captura de documentos e unidades de medida.
  capabilities { capture, units }
  // REVIEW [2026-12-15] Origem automática do peso bruto: balança scale-01.
  source: device "scale-01" for pesoBruto

  // REVIEW [2026-12-15] Índices de consulta usados nas telas e relatórios.
  indexes {
    // REVIEW [2026-12-15] Busca rápida das remessas de um pedido.
    byOrder: [order.id] hash
    // REVIEW [2026-12-15] Lista por situação, ordenada pela criação.
    byStatus: [status, createdAt] range
    // REVIEW [2026-12-15] Lista por transportadora e situação.
    byCarrier: [carrierName, status] range
    // REVIEW [2026-12-15] Lista por peso normalizado.
    byWeight: [pesoBruto.normalized] range
  }

  // REVIEW [2026-12-15] Eventos emitidos pelo documento.
  events {
    // REVIEW [2026-12-15] Evento que solicita a cotação de frete da remessa.
    QuoteRequested {
      // REVIEW [2026-12-15] Título exibido no histórico e nas integrações.
      title: { pt-BR: "Cotação solicitada", en: "Quote requested" }
      // REVIEW [2026-12-15] Dados transportados pelo evento.
      payload {
        // REVIEW [2026-12-15] Pedido que terá o frete cotado.
        order: Order { title: { pt-BR: "Pedido", en: "Order" } }
      }
    }
    // REVIEW [2026-12-15] Evento que registra o frete cotado para a remessa.
    FreightQuoted {
      // REVIEW [2026-12-15] Título exibido no histórico e nas integrações.
      title: { pt-BR: "Frete cotado", en: "Freight quoted" }
      // REVIEW [2026-12-15] Dados transportados pelo evento.
      payload {
        // REVIEW [2026-12-15] Transportadora que cotou o frete.
        carrier: string { title: { pt-BR: "Transportadora", en: "Carrier" } }
        // REVIEW [2026-12-15] Valor do frete cotado.
        amount: std.Money { title: { pt-BR: "Frete", en: "Freight" } }
      }
    }
  }

  // REVIEW [2026-12-15] Ações que alteram a remessa.
  actions {
    // REVIEW [2026-12-15] Cria a remessa a partir de um pedido.
    create(order: Order) {
      // REVIEW [2026-12-15] Título exibido no botão e no histórico.
      title: { pt-BR: "Criar remessa", en: "Create shipment" }
      // REVIEW [2026-12-15] Papéis que podem executar a action.
      roles: [Dispatcher]
      {
        // REVIEW [2026-12-15] Registra a data/hora de criação.
        createdAt = now()
        // REVIEW [2026-12-15] Emite o evento de remessa criada.
        emit Created
      }
    }

    // REVIEW [2026-12-15] Adiciona um produto à remessa.
    addItem(product: Product, quantity: std.Count) {
      // REVIEW [2026-12-15] Título exibido no botão e no histórico.
      title: { pt-BR: "Adicionar item", en: "Add item" }
      // REVIEW [2026-12-15] Papéis que podem executar a action.
      roles: [Packer]
      // REVIEW [2026-12-15] Valida que a quantidade adicionada é positiva.
      rule quantity > 0 {
        // REVIEW [2026-12-15] Mensagem de validação em português.
        pt-BR: "A quantidade deve ser maior que zero"
        // REVIEW [2026-12-15] Mensagem de validação em inglês.
        en: "Quantity must be greater than zero"
      }
    }

    // REVIEW [2026-12-15] Embala a remessa e a move para o estado Packed.
    pack() {
      // REVIEW [2026-12-15] Título exibido no botão e no histórico.
      title: { pt-BR: "Embalar", en: "Pack" }
      // REVIEW [2026-12-15] Papéis que podem executar a action.
      roles: [Packer]

      // REVIEW [2026-12-15] Transição automática para o estado embalada.
      to: status.Packed
      {
        // REVIEW [2026-12-15] Registra a data/hora da embalagem.
        packedAt = now()
      }
    }

    // REVIEW [2026-12-15] Solicita a cotação de frete da remessa.
    requestQuote() {
      // REVIEW [2026-12-15] Título exibido no botão e no histórico.
      title: { pt-BR: "Solicitar cotação", en: "Request quote" }
      // REVIEW [2026-12-15] Papéis que podem executar a action.
      roles: [Dispatcher]
      {
        // REVIEW [2026-12-15] Emite o evento que inicia a cotação.
        emit QuoteRequested
      }
    }

    // REVIEW [2026-12-15] Aplica o frete cotado à remessa.
    applyFreight(carrier: string, amount: std.Money) {
      // REVIEW [2026-12-15] Título exibido no botão e no histórico.
      title: { pt-BR: "Aplicar frete", en: "Apply freight" }
      // REVIEW [2026-12-15] Papéis que podem executar a action.
      roles: [ShipmentEngine]

      // REVIEW [2026-12-15] Valida que o frete não é negativo.
      rule amount >= 0 BRL {
        // REVIEW [2026-12-15] Mensagem de validação em português.
        pt-BR: "O frete não pode ser negativo"
        // REVIEW [2026-12-15] Mensagem de validação em inglês.
        en: "Freight cannot be negative"
      }
      {
        // REVIEW [2026-12-15] Guarda a transportadora que cotou o frete.
        carrierName = carrier
        // REVIEW [2026-12-15] Guarda o valor do frete cotado.
        frete = amount
        // REVIEW [2026-12-15] Emite o evento de frete cotado.
        emit FreightQuoted
      }
    }

    // REVIEW [2026-12-15] Divide a remessa em duas.
    split() {
      // REVIEW [2026-12-15] Título exibido no botão e no histórico.
      title: { pt-BR: "Dividir remessa", en: "Split shipment" }
      // REVIEW [2026-12-15] Papéis que podem executar a action.
      roles: [Manager]

      // REVIEW [2026-12-15] Transição automática para o estado dividida.
      to: status.Split
    }

    // REVIEW [2026-12-15] Despacha a remessa com o código de rastreio emitido.
    dispatch(trackingCode: TrackingCode) {
      // REVIEW [2026-12-15] Título exibido no botão e no histórico.
      title: { pt-BR: "Despachar", en: "Dispatch" }
      // REVIEW [2026-12-15] Papéis que podem executar a action.
      roles: [ShipmentEngine]

      // REVIEW [2026-12-15] Transição automática para o estado despachada.
      to: status.Dispatched
      // REVIEW [2026-12-15] Dados do evento de transição: código de rastreio.
      emits { tracking: trackingCode }
      {
        // REVIEW [2026-12-15] Grava o código de rastreio na remessa.
        tracking = trackingCode
      }
    }

    // REVIEW [2026-12-15] Confirma a coleta da remessa pela transportadora.
    confirmPickup(pickedUpOn: DateTime) {
      // REVIEW [2026-12-15] Título exibido no botão e no histórico.
      title: { pt-BR: "Confirmar coleta", en: "Confirm pickup" }
      // REVIEW [2026-12-15] Papéis que podem executar a action.
      roles: [ShipmentEngine]

      // REVIEW [2026-12-15] Transição automática para o estado em rota de entrega.
      to: status.OutForDelivery
      // REVIEW [2026-12-15] Dados do evento de transição: data/hora da coleta.
      emits { pickedUpAt: pickedUpOn }
      {
        // REVIEW [2026-12-15] Grava a data/hora da coleta na remessa.
        pickedUpAt = pickedUpOn
      }
    }

    // REVIEW [2026-12-15] Aplica um evento de rastreio recebido da transportadora.
    applyTracking(kind: TrackingKind, at: DateTime, receivedBy: string) {
      // REVIEW [2026-12-15] Título exibido no botão e no histórico.
      title: { pt-BR: "Aplicar evento de rastreio", en: "Apply tracking event" }
      // REVIEW [2026-12-15] Papéis que podem executar a action.
      roles: [ShipmentEngine]
      {
        // REVIEW [2026-12-15] Grava o tipo do último evento de rastreio.
        lastTrackingKind = kind
        // REVIEW [2026-12-15] Grava a data/hora do último evento de rastreio.
        lastTrackingAt = at
        // REVIEW [2026-12-15] Grava quem recebeu a remessa no evento.
        receiverName = receivedBy
      }
    }

    // REVIEW [2026-12-15] Registra uma tentativa de entrega que falhou.
    markAttemptFailed(reason: string) {
      // REVIEW [2026-12-15] Título exibido no botão e no histórico.
      title: { pt-BR: "Registrar tentativa falha", en: "Record failed attempt" }
      // REVIEW [2026-12-15] Papéis que podem executar a action.
      roles: [ShipmentEngine]

      // REVIEW [2026-12-15] Transição automática para o estado de tentativa falha.
      to: status.AttemptFailed
      {
        // REVIEW [2026-12-15] Incrementa o contador de tentativas de entrega.
        attempts = attempts + 1
      }
    }

    // REVIEW [2026-12-15] Agenda uma nova tentativa de entrega.
    scheduleRetry(attemptOn: DateTime) {
      // REVIEW [2026-12-15] Título exibido no botão e no histórico.
      title: { pt-BR: "Agendar reentrega", en: "Schedule retry" }
      // REVIEW [2026-12-15] Papéis que podem executar a action.
      roles: [Dispatcher]

      // REVIEW [2026-12-15] Transição automática para o estado em rota de entrega.
      to: status.OutForDelivery
      // REVIEW [2026-12-15] Dados do evento de transição: data/hora da nova tentativa.
      emits { nextAttemptAt: attemptOn }
      {
        // REVIEW [2026-12-15] Grava a data/hora da próxima tentativa na remessa.
        nextAttemptAt = attemptOn
      }
    }

    // REVIEW [2026-12-15] Confirma a entrega da remessa.
    markDelivered() {
      // REVIEW [2026-12-15] Título exibido no botão e no histórico.
      title: { pt-BR: "Confirmar entrega", en: "Confirm delivery" }
      // REVIEW [2026-12-15] Papéis que podem executar a action.
      roles: [ShipmentEngine]

      // REVIEW [2026-12-15] Transição automática para o estado entregue.
      to: status.Delivered
      {
        // REVIEW [2026-12-15] Registra a data/hora da entrega.
        deliveredAt = now()
      }
    }

    // REVIEW [2026-12-15] Devolve a remessa ao remetente.
    returnToSender() {
      // REVIEW [2026-12-15] Título exibido no botão e no histórico.
      title: { pt-BR: "Devolver ao remetente", en: "Return to sender" }
      // REVIEW [2026-12-15] Papéis que podem executar a action.
      roles: [Dispatcher]

      // REVIEW [2026-12-15] Transição automática para o estado devolvida.
      to: status.Returned
      {
        // REVIEW [2026-12-15] Registra a data/hora da devolução.
        returnedAt = now()
      }
    }

    // REVIEW [2026-12-15] Cancela a remessa com um motivo obrigatório.
    cancel(reason: string) {
      // REVIEW [2026-12-15] Título exibido no botão e no histórico.
      title: { pt-BR: "Cancelar remessa", en: "Cancel shipment" }
      // REVIEW [2026-12-15] Papéis que podem executar a action.
      roles: [Manager]

      // REVIEW [2026-12-15] Transição automática para o estado cancelada.
      to: status.Cancelled

      // REVIEW [2026-12-15] Exige um motivo com pelo menos dez caracteres.
      rule reason.length >= 10 {
        // REVIEW [2026-12-15] Mensagem de validação em português.
        pt-BR: "Informe um motivo com pelo menos 10 caracteres"
        // REVIEW [2026-12-15] Mensagem de validação em inglês.
        en: "Enter a reason with at least 10 characters"
      }
    }
  }

  // REVIEW [2026-12-15] Invariante: remessa despachada precisa ter rastreio.
  rule status == Dispatched implies tracking != null {
    // REVIEW [2026-12-15] Mensagem da regra em português.
    pt-BR: "Informe o rastreio após o despacho"
    // REVIEW [2026-12-15] Mensagem da regra em inglês.
    en: "Enter tracking after dispatch"
  }
  // REVIEW [2026-12-15] Invariante: o peso bruto não pode superar o limite configurado.
  rule pesoBruto <= MaxWeight {
    // REVIEW [2026-12-15] Mensagem da regra em português.
    pt-BR: "Remessa acima do limite de peso"
    // REVIEW [2026-12-15] Mensagem da regra em inglês.
    en: "Shipment above the weight limit"
  }
}

// REVIEW [2026-12-15] Forma que descreve um item de uma remessa.
shape ShipmentItem {
  // REVIEW [2026-12-15] Título exibido no builder e nas telas que usam a forma.
  title: { pt-BR: "Item de remessa", en: "Shipment item" }

  // REVIEW [2026-12-15] Campos que compõem o item.
  fields {
    // REVIEW [2026-12-15] Produto do catálogo incluído na remessa.
    product: Product {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Produto", en: "Product" }
      // REVIEW [2026-12-15] Permite localizar o item pelo produto.
      lookup
    }
    // REVIEW [2026-12-15] Quantidade de unidades do produto.
    quantity: std.Count {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Quantidade", en: "Quantity" }
      // REVIEW [2026-12-15] Permite localizar o item pela quantidade.
      lookup
      // REVIEW [2026-12-15] Torna a quantidade obrigatória.
      required
    }
    // REVIEW [2026-12-15] Peso unitário do produto.
    pesoUnitario: std.Mass {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Peso unitário", en: "Unit weight" }
    }
  }
}

// REVIEW [2026-12-15] Forma que modela o ciclo de vida da remessa.
shape ShipmentStatus {
  // REVIEW [2026-12-15] Título exibido no builder e nas telas que usam a forma.
  title: { pt-BR: "Situação da remessa", en: "Shipment status" }
  // REVIEW [2026-12-15] Base de máquina de estados.
  base: state
  // REVIEW [2026-12-15] Estado inicial e transição disparada na criação da remessa.
  initial: Draft with transition Created {
    // REVIEW [2026-12-15] Título da transição inicial.
    title: { pt-BR: "Remessa criada", en: "Shipment created" }
    // REVIEW [2026-12-15] Dados transportados pela transição inicial.
    payload {
      // REVIEW [2026-12-15] Pedido que originou a remessa.
      order: Order { title: { pt-BR: "Pedido", en: "Order" } }
    }
  }

  // REVIEW [2026-12-15] Estado de rascunho, antes da embalagem.
  value Draft {
    // REVIEW [2026-12-15] Título exibido para o estado.
    title: { pt-BR: "Rascunho", en: "Draft" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Draft
    // REVIEW [2026-12-15] Ordem de exibição no quadro e nos filtros.
    ordinal: 10

    // REVIEW [2026-12-15] Transição de rascunho para embalada.
    transition Packed {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Remessa embalada", en: "Shipment packed" }
      // REVIEW [2026-12-15] Dados transportados pela transição.
      payload {
        // REVIEW [2026-12-15] Data/hora em que a remessa foi embalada.
        packedAt: DateTime { title: { pt-BR: "Embalada em", en: "Packed at" } }
      }
    }

    // REVIEW [2026-12-15] Transição de rascunho para dividida.
    transition Split {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Remessa dividida", en: "Shipment split" }
      // REVIEW [2026-12-15] Dados transportados pela transição.
      payload {
        // REVIEW [2026-12-15] Pedido que originou a divisão.
        order: Order { title: { pt-BR: "Pedido", en: "Order" } }
      }
    }

    // REVIEW [2026-12-15] Transição de rascunho para cancelada.
    transition Cancelled {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Remessa cancelada", en: "Shipment cancelled" }
      // REVIEW [2026-12-15] Dados transportados pela transição.
      payload {
        // REVIEW [2026-12-15] Motivo do cancelamento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado de remessa embalada.
  value Packed {
    // REVIEW [2026-12-15] Título exibido para o estado.
    title: { pt-BR: "Embalada", en: "Packed" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Packed
    // REVIEW [2026-12-15] Ordem de exibição no quadro e nos filtros.
    ordinal: 20

    // REVIEW [2026-12-15] Transição de embalada para dividida.
    transition Split {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Remessa dividida", en: "Shipment split" }
      // REVIEW [2026-12-15] Dados transportados pela transição.
      payload {
        // REVIEW [2026-12-15] Pedido que originou a divisão.
        order: Order { title: { pt-BR: "Pedido", en: "Order" } }
      }
    }

    // REVIEW [2026-12-15] Transição de embalada para despachada.
    transition Dispatched {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Remessa despachada", en: "Shipment dispatched" }
      // REVIEW [2026-12-15] Dados transportados pela transição.
      payload {
        // REVIEW [2026-12-15] Pedido que originou o despacho.
        order: Order { title: { pt-BR: "Pedido", en: "Order" } }
        // REVIEW [2026-12-15] Código de rastreio emitido no despacho.
        tracking: TrackingCode { title: { pt-BR: "Rastreio", en: "Tracking" } }
      }
    }

    // REVIEW [2026-12-15] Transição de embalada para cancelada.
    transition Cancelled {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Remessa cancelada", en: "Shipment cancelled" }
      // REVIEW [2026-12-15] Dados transportados pela transição.
      payload {
        // REVIEW [2026-12-15] Motivo do cancelamento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado de remessa despachada.
  value Dispatched {
    // REVIEW [2026-12-15] Título exibido para o estado.
    title: { pt-BR: "Despachada", en: "Dispatched" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Dispatched
    // REVIEW [2026-12-15] Ordem de exibição no quadro e nos filtros.
    ordinal: 30

    // REVIEW [2026-12-15] Transição de despachada para em rota de entrega.
    transition OutForDelivery {
      // REVIEW [2026-12-15] Evento que dispara a transição de coleta.
      event: PickedUp
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Remessa coletada", en: "Shipment picked up" }
      // REVIEW [2026-12-15] Dados transportados pela transição.
      payload {
        // REVIEW [2026-12-15] Data/hora em que a remessa foi coletada.
        pickedUpAt: DateTime { title: { pt-BR: "Coletada em", en: "Picked up at" } }
      }
    }

    // REVIEW [2026-12-15] Transição de despachada para cancelada.
    transition Cancelled {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Remessa cancelada", en: "Shipment cancelled" }
      // REVIEW [2026-12-15] Dados transportados pela transição.
      payload {
        // REVIEW [2026-12-15] Motivo do cancelamento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado de remessa em rota de entrega.
  value OutForDelivery {
    // REVIEW [2026-12-15] Título exibido para o estado.
    title: { pt-BR: "Em rota de entrega", en: "Out for delivery" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: OutForDelivery
    // REVIEW [2026-12-15] Ordem de exibição no quadro e nos filtros.
    ordinal: 40

    // REVIEW [2026-12-15] Transição de em rota para tentativa falha.
    transition AttemptFailed {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Tentativa de entrega falhou", en: "Delivery attempt failed" }
      // REVIEW [2026-12-15] Dados transportados pela transição.
      payload {
        // REVIEW [2026-12-15] Motivo da falha na tentativa.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }

    // REVIEW [2026-12-15] Transição de em rota para entregue.
    transition Delivered {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Remessa entregue", en: "Shipment delivered" }
      // REVIEW [2026-12-15] Dados transportados pela transição.
      payload {
        // REVIEW [2026-12-15] Data/hora em que a remessa foi entregue.
        deliveredAt: DateTime { title: { pt-BR: "Entregue em", en: "Delivered at" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado de tentativa de entrega falha.
  value AttemptFailed {
    // REVIEW [2026-12-15] Título exibido para o estado.
    title: { pt-BR: "Tentativa falhou", en: "Attempt failed" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: AttemptFailed
    // REVIEW [2026-12-15] Ordem de exibição no quadro e nos filtros.
    ordinal: 50

    // REVIEW [2026-12-15] Transição de tentativa falha para nova tentativa em rota.
    transition OutForDelivery {
      // REVIEW [2026-12-15] Evento que dispara a reentrega agendada.
      event: RetryScheduled
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Reentrega agendada", en: "Retry scheduled" }
      // REVIEW [2026-12-15] Dados transportados pela transição.
      payload {
        // REVIEW [2026-12-15] Data/hora prevista para a nova tentativa.
        nextAttemptAt: DateTime { title: { pt-BR: "Próxima tentativa", en: "Next attempt" } }
      }
    }

    // REVIEW [2026-12-15] Transição de tentativa falha para entregue.
    transition Delivered {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Remessa entregue", en: "Shipment delivered" }
      // REVIEW [2026-12-15] Dados transportados pela transição.
      payload {
        // REVIEW [2026-12-15] Data/hora em que a remessa foi entregue.
        deliveredAt: DateTime { title: { pt-BR: "Entregue em", en: "Delivered at" } }
      }
    }

    // REVIEW [2026-12-15] Transição de tentativa falha para devolvida.
    transition Returned {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Remessa devolvida", en: "Shipment returned" }
      // REVIEW [2026-12-15] Dados transportados pela transição.
      payload {
        // REVIEW [2026-12-15] Data/hora em que a remessa foi devolvida.
        returnedAt: DateTime { title: { pt-BR: "Devolvida em", en: "Returned at" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado final de remessa entregue.
  value Delivered {
    // REVIEW [2026-12-15] Título exibido para o estado.
    title: { pt-BR: "Entregue", en: "Delivered" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Delivered
    // REVIEW [2026-12-15] Ordem de exibição no quadro e nos filtros.
    ordinal: 60
  }
  // REVIEW [2026-12-15] Estado final de remessa devolvida.
  value Returned {
    // REVIEW [2026-12-15] Título exibido para o estado.
    title: { pt-BR: "Devolvida", en: "Returned" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Returned
    // REVIEW [2026-12-15] Ordem de exibição no quadro e nos filtros.
    ordinal: 70
  }
  // REVIEW [2026-12-15] Estado final de remessa dividida.
  value Split {
    // REVIEW [2026-12-15] Título exibido para o estado.
    title: { pt-BR: "Dividida", en: "Split" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Split
    // REVIEW [2026-12-15] Ordem de exibição no quadro e nos filtros.
    ordinal: 80
  }
  // REVIEW [2026-12-15] Estado final de remessa cancelada.
  value Cancelled {
    // REVIEW [2026-12-15] Título exibido para o estado.
    title: { pt-BR: "Cancelada", en: "Cancelled" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Cancelled
    // REVIEW [2026-12-15] Ordem de exibição no quadro e nos filtros.
    ordinal: 90
  }

  // REVIEW [2026-12-15] Formato de exibição do estado, sem agrupamento.
  format: plain
}

// REVIEW [2026-12-15] Forma de classificação dos tipos de evento de rastreio.
shape TrackingKind {
  // REVIEW [2026-12-15] Título exibido no builder e nas telas que usam a forma.
  title: { pt-BR: "Tipo de evento de rastreio", en: "Tracking event kind" }
  // REVIEW [2026-12-15] Base de classificação, com valores fixos.
  base: classification

  // REVIEW [2026-12-15] Evento de remessa em trânsito.
  value InTransit {
    // REVIEW [2026-12-15] Título exibido para o valor.
    title: { pt-BR: "Em trânsito", en: "In transit" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: InTransit
    // REVIEW [2026-12-15] Ordem de exibição na classificação.
    ordinal: 10
  }
  // REVIEW [2026-12-15] Evento de remessa em rota de entrega.
  value OutForDelivery {
    // REVIEW [2026-12-15] Título exibido para o valor.
    title: { pt-BR: "Em rota de entrega", en: "Out for delivery" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: OutForDelivery
    // REVIEW [2026-12-15] Ordem de exibição na classificação.
    ordinal: 20
  }
  // REVIEW [2026-12-15] Evento de tentativa de entrega falha.
  value AttemptFailed {
    // REVIEW [2026-12-15] Título exibido para o valor.
    title: { pt-BR: "Tentativa falhou", en: "Attempt failed" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: AttemptFailed
    // REVIEW [2026-12-15] Ordem de exibição na classificação.
    ordinal: 30
  }
  // REVIEW [2026-12-15] Evento de entrega concluída.
  value Completed {
    // REVIEW [2026-12-15] Título exibido para o valor.
    title: { pt-BR: "Entrega concluída", en: "Delivery completed" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: Completed
    // REVIEW [2026-12-15] Ordem de exibição na classificação.
    ordinal: 40
  }

  // REVIEW [2026-12-15] Formato de exibição da classificação, sem agrupamento.
  format: plain
}

// REVIEW [2026-12-15] Forma que representa o código de rastreio da transportadora.
shape TrackingCode {
  // REVIEW [2026-12-15] Título exibido no builder e nas telas que usam a forma.
  title: { pt-BR: "Código de rastreio", en: "Tracking code" }
  // REVIEW [2026-12-15] Base textual do código.
  base: string
  // REVIEW [2026-12-15] Normaliza o código em maiúsculas e sem espaços nas pontas.
  normalize: upper-trim
  // REVIEW [2026-12-15] Limita o código a quarenta caracteres.
  maxLength: 40
  // REVIEW [2026-12-15] Formato de exibição do código, sem agrupamento.
  format: plain
}

// REVIEW [2026-12-15] Política que bloqueia o despacho de remessa acima do limite de peso.
policy WeightLimit {
  // REVIEW [2026-12-15] Action à qual a política se aplica.
  appliesTo: Shipment.dispatch
  // REVIEW [2026-12-15] Condição que precisa ser verdadeira para permitir o despacho.
  rule: pesoBruto <= MaxWeight
  // REVIEW [2026-12-15] Severidade da política: bloqueia a operação.
  severity: block
  // REVIEW [2026-12-15] Mensagem exibida quando a política bloqueia.
  message: "Remessa acima do limite de peso"
  // REVIEW [2026-12-15] Registra a avaliação da política na auditoria.
  audit: true
}
