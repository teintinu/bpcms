// service: example.com/services/claims
// Process: sintaxe atual (DSL_REFERENCE.md §4)

// Processo de liquidação de sinistro: triagem, risco, decisão, pagamento e desfecho.
process ClaimSettlement(claim: Claim) {
  // Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Liquidação do sinistro", en: "Claim settlement" }
  // Versão do artefato Process; diff e release comparam.
  version: 1
  // Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // Texto do objetivo em português.
    pt-BR: "Indenizar o sinistro com cobertura verificada, risco rastreável e compensação"
  }
  // SLA brando do caso: alvo de lead time, não é timer.
  sla: 10d

  // Gatilho: inicia uma instância quando o documento emite Opened.
  on [Claim.Opened]
  // Chave de identidade, correlação e dedup da instância.
  key: claim

  // Variável durável com a faixa de risco de fraude avaliada.
  let fraudBand: FraudBand
  // Variável durável que guarda a liquidação aberta para o sinistro.
  let settlement: Settlement
  // Flag durável que registra se a triagem foi escalonada.
  let escalated = false

  // Triagem obrigatória: abre o formulário para o atendente.
  try {
    // Abre o formulário de triagem para o sinistro.
    ClaimTriage.show({ claim })
  } catch (Timeout) { // prazo da triagem esgotado
    // Sem triagem no prazo, marca o escalonamento...
    escalated = true
    // ...e abre a tarefa manual de escalonamento.
    EscalateSettlement.show({ claim })
  }

  // Se a triagem já recusou o sinistro, encerra como recusado.
  if (claim.status == Rejected) {
    // Retorna o desfecho Rejected.
    return Rejected
  }

  // Sem escalonamento, segue o caminho automático de análise.
  if (!escalated) {
    // Coleta a declaração do segurado, tolerando o estouro de prazo.
    try {
      // Abre o formulário de declaração para o segurado.
      ClaimStatement.show({ claim })
    } catch (Timeout) { // prazo da declaração esgotado
      // Sem declaração no prazo: segue para a avaliação de risco.
    }

    // Avalia o risco de fraude a partir do valor e do tipo do sinistro.
    fraudBand = FraudRisk.evaluate({
      // Valor reclamado usado no cálculo.
      amount: claim.amount,
      // Tipo do sinistro usado no cálculo.
      type: claim.type
    })

    // Persiste a faixa de risco no documento.
    Claim.recordRisk({ band: fraudBand })
    // Inicia a análise do sinistro.
    Claim.startReview()

    // Risco alto exige a análise especializada de fraude.
    if (fraudBand == High) {
      // Executa o subprocesso de análise de fraude para o sinistro.
      ClaimFraudReview.run({ claim })

      // Fraude confirmada leva à recusa do sinistro.
      if (claim.fraudConfirmed) {
        // Abre o formulário de recusa.
        ClaimRejection.show({ claim })
        // Retorna o desfecho Rejected.
        return Rejected
      }
    }

    // Cobertura não confirmada também leva à recusa.
    if (!claim.covered) {
      // Abre o formulário de recusa.
      ClaimRejection.show({ claim })
      // Retorna o desfecho Rejected.
      return Rejected
    }
  }

  // Decisão do ajustador, tolerando o estouro de prazo com escalonamento.
  try {
    // Abre o formulário de decisão para o ajustador.
    ClaimDecision.show({ claim })
  } catch (Timeout) { // prazo da decisão esgotado
    // Sem decisão no prazo, escala a tarefa ao gerente.
    EscalateSettlement.show({ claim })
    // Reapresenta o formulário de decisão após o escalonamento.
    ClaimDecision.show({ claim })
  }

  // Se a decisão recusou o sinistro, encerra como recusado.
  if (claim.status == Rejected) {
    // Retorna o desfecho Rejected.
    return Rejected
  }

  // Abre a liquidação do sinistro aprovado.
  settlement = Claim.openSettlement()

  // Envia a instrução de pagamento para o setor financeiro.
  send PaymentInstruction {
    // Correlaciona a mensagem ao sinistro.
    key: claim
    // Dados preenchidos na mensagem.
    with {
      // Número da liquidação criada.
      settlementNumber: settlement.number
      // Valor aprovado para pagamento.
      amount: claim.approvedAmount
    }
  }

  // Aguarda a confirmação de pagamento com prazo de dois dias.
  try {
    // Recebe a confirmação e aplica o comando que marca o sinistro como pago.
    receive PaymentConfirmation {
      // Correlaciona a resposta ao sinistro.
      key: claim
      // Prazo máximo de espera pela confirmação.
      timeout: 2d
      // Ação executada quando a confirmação chega.
      apply: Claim.confirmPayment
    }
  } catch (Timeout, PaymentRejected) { // sem confirmação de pagamento
    // Sem pagamento confirmado, reabre a análise do sinistro.
    Claim.reopen()
    // Retorna o desfecho Cancelled.
    return Cancelled
  }

  // Pagamento confirmado: retorna o desfecho de sucesso.
  return Settled

  // Desfecho que indica sinistro indenizado.
  end Settled {
    // Título exibido no histórico.
    title: { pt-BR: "Indenizado", en: "Settled" }
    // Classificação do desfecho para KPI.
    outcome: success
  }

  // Desfecho que indica sinistro recusado.
  end Rejected {
    // Título exibido no histórico.
    title: { pt-BR: "Recusado", en: "Rejected" }
    // Classificação do desfecho para KPI.
    outcome: failure
  }

  // Desfecho que indica processo cancelado sem indenização.
  end Cancelled {
    // Título exibido no histórico.
    title: { pt-BR: "Cancelado", en: "Cancelled" }
    // Classificação do desfecho para KPI.
    outcome: cancelled
  }
}

// Formulário de triagem que confirma cobertura e atribui o ajustador.
form ClaimTriage {
  // Título exibido na inbox.
  title: { pt-BR: "Triagem do sinistro", en: "Claim triage" }
  // Documento manipulado pelo formulário.
  document: Claim
  // Papéis que recebem a tarefa.
  roles: [Clerk]
  // Prazo máximo para conclusão da tarefa.
  timeout: 4h
  // Tarefa puxada pelo próprio usuário a partir da inbox.
  assign: pull

  // Campos exibidos no formulário.
  fields {
    // Segurado reaproveitado do documento.
    claimant
    // Cobertura reaproveitada do documento.
    coverage
    // Tipo de sinistro reaproveitado do documento.
    type
    // Valor reclamado reaproveitado do documento.
    amount
    // Descrição reaproveitada do documento.
    description
    // Confirmação de cobertura reaproveitada do documento.
    covered
    // Ajustador responsável reaproveitado do documento.
    adjuster
    // Motivo da recusa, quando a triagem recusar o sinistro.
    reason: string {
      // Título exibido no formulário.
      title: { pt-BR: "Motivo da recusa", en: "Rejection reason" }
      // Limita o motivo a quinhentos caracteres.
      maxLength: 500
    }
  }

  // Ações disponíveis no formulário.
  actions {
    // Tria o sinistro com cobertura, tipo e ajustador informados.
    triage { calls: Claim.triage(covered, type, adjuster) }
    // Recusa o sinistro com o motivo informado.
    reject { calls: Claim.reject(reason) }
  }
}

// Formulário em que o segurado declara o ocorrido.
form ClaimStatement {
  // Título exibido na inbox.
  title: { pt-BR: "Declaração do segurado", en: "Policyholder statement" }
  // Documento manipulado pelo formulário.
  document: Claim
  // Papéis que recebem a tarefa.
  roles: [Policyholder]
  // Prazo máximo para conclusão da tarefa.
  timeout: 3d

  // Campos exibidos no formulário.
  fields {
    // Texto da declaração do segurado, obrigatório.
    text: string {
      // Título exibido no formulário.
      title: { pt-BR: "Declaração", en: "Statement" }
      // Limita a declaração a dois mil caracteres.
      maxLength: 2000
      // Torna a declaração obrigatória no preenchimento.
      required
    }
  }

  // Ações disponíveis no formulário.
  actions {
    // Registra a declaração no documento.
    describe { calls: Claim.describe(text) }
  }
}

// Formulário de recusa do sinistro com o motivo informado.
form ClaimRejection {
  // Título exibido na inbox.
  title: { pt-BR: "Recusa do sinistro", en: "Claim rejection" }
  // Documento manipulado pelo formulário.
  document: Claim
  // Papéis que recebem a tarefa.
  roles: [Adjuster]
  // Prazo máximo para conclusão da tarefa.
  timeout: 1d

  // Campos exibidos no formulário.
  fields {
    // Motivo da recusa, obrigatório.
    reason: string {
      // Título exibido no formulário.
      title: { pt-BR: "Motivo da recusa", en: "Rejection reason" }
      // Limita o motivo a quinhentos caracteres.
      maxLength: 500
      // Torna o motivo obrigatório no preenchimento.
      required
    }
  }

  // Ações disponíveis no formulário.
  actions {
    // Recusa o sinistro com o motivo informado.
    reject { calls: Claim.reject(reason) }
  }
}

// Formulário de decisão do ajustador: aprova ou recusa o sinistro.
form ClaimDecision {
  // Título exibido na inbox.
  title: { pt-BR: "Decisão do ajustador", en: "Adjuster decision" }
  // Documento manipulado pelo formulário.
  document: Claim
  // Papéis que recebem a tarefa.
  roles: [Adjuster]
  // Prazo máximo para conclusão da tarefa.
  timeout: 2d
  // Tarefa puxada pelo próprio usuário a partir da inbox.
  assign: pull

  // Campos exibidos no formulário.
  fields {
    // Valor aprovado reaproveitado do documento.
    approvedAmount
    // Motivo da recusa, usado quando a decisão for desfavorável.
    reason: string {
      // Título exibido no formulário.
      title: { pt-BR: "Motivo da recusa", en: "Rejection reason" }
      // Limita o motivo a quinhentos caracteres.
      maxLength: 500
    }
  }

  // Ações disponíveis no formulário.
  actions {
    // Aprova o sinistro com o valor informado.
    approve { calls: Claim.approve(approvedAmount) }
    // Recusa o sinistro com o motivo informado.
    reject { calls: Claim.reject(reason) }
  }
}

// Tarefa manual de escalonamento quando os prazos do caso estouram.
manual EscalateSettlement {
  // Título exibido na inbox.
  title: { pt-BR: "Escalonar o sinistro", en: "Escalate claim" }
  // Documento manipulado pela tarefa.
  document: Claim
  // Papéis que recebem a tarefa.
  roles: [Manager]
  // Orientações exibidas ao responsável pela tarefa.
  instructions: "Revisar o caso com o ajustador e registrar a decisão de prazo"
  // Prazo máximo para conclusão da tarefa.
  timeout: 1d
  // Tarefa puxada pelo próprio usuário a partir da inbox.
  assign: pull
}

// Erro de negócio: pagamento recusado pelo meio de pagamento.
error PaymentRejected {
  // Título do erro exibido ao usuário.
  title: { pt-BR: "Pagamento recusado", en: "Payment rejected" }
}

// View de andamento derivada da instância do processo de liquidação.
view ClaimProgress {
  // Título exibido na navegação.
  title: { pt-BR: "Andamento do sinistro", en: "Claim progress" }
  // Tipo da view: uma tela de andamento de processo.
  type: process
  // Processo cujo andamento esta view exibe.
  process: ClaimSettlement
  // Papéis que podem abrir a view.
  roles: [Clerk, Adjuster, FinanceAnalyst, Manager, Policyholder]

  // Seções fixas exibidas na tela de andamento.
  sections { current; participants; history; deadlines; subprocesses; documents; milestones; next }
}

// Decisão que calcula a faixa de risco de fraude de um sinistro.
decision FraudRisk {
  // Título exibido no builder e na revisão.
  title: { pt-BR: "Risco de fraude do sinistro", en: "Claim fraud risk" }
  // Tipo devolvido pela decisão.
  returns: FraudBand

  // Entradas necessárias para o cálculo.
  inputs {
    // Valor reclamado considerado no cálculo.
    amount: std.Money
    // Tipo do sinistro considerado no cálculo.
    type: ClaimType
  }

  // Regras avaliadas em ordem até a primeira que casar.
  cases {
    // Valores acima de cinquenta mil reais indicam risco alto.
    amount > 50000 BRL -> High
    // Furto acima de vinte mil reais também indica risco alto.
    type == Theft and amount > 20000 BRL -> High
    // Valores acima de quinze mil reais indicam risco médio.
    amount > 15000 BRL -> Medium
    // Demais casos ficam na faixa de risco baixo.
    else -> Low
  }

  // Norma que fundamenta as regras da decisão.
  source: "Política Antifraude v4"
  // Área responsável pela manutenção da decisão.
  owner: "Fraud"
}
