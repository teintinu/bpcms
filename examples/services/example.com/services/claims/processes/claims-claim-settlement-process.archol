// REVIEW [2026-12-15] service: example.com/services/claims
// REVIEW [2026-12-15] Process: sintaxe atual (DSL_REFERENCE.md §4)

// REVIEW [2026-12-15] Processo de liquidação de sinistro: triagem, risco, decisão, pagamento e desfecho.
process ClaimSettlement(claim: Claim) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Liquidação do sinistro", en: "Claim settlement" }
  // REVIEW [2026-12-15] Versão do artefato Process; diff e release comparam.
  version: 1
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Indenizar o sinistro com cobertura verificada, risco rastreável e compensação"
  }
  // REVIEW [2026-12-15] SLA brando do caso: alvo de lead time, não é timer.
  sla: 10d

  // REVIEW [2026-12-15] Gatilho: inicia uma instância quando o documento emite Opened.
  on [Claim.Opened]
  // REVIEW [2026-12-15] Chave de identidade, correlação e dedup da instância.
  key: claim

  // REVIEW [2026-12-15] Variável durável com a faixa de risco de fraude avaliada.
  let fraudBand: FraudBand
  // REVIEW [2026-12-15] Variável durável que guarda a liquidação aberta para o sinistro.
  let settlement: Settlement
  // REVIEW [2026-12-15] Flag durável que registra se a triagem foi escalonada.
  let escalated = false

  // REVIEW [2026-12-15] Triagem obrigatória: abre o formulário para o atendente.
  try {
    // REVIEW [2026-12-15] Abre o formulário de triagem para o sinistro.
    ClaimTriage.show({ claim })
  } catch (Timeout) { // REVIEW [2026-12-15] prazo da triagem esgotado
    // REVIEW [2026-12-15] Sem triagem no prazo, marca o escalonamento...
    escalated = true
    // REVIEW [2026-12-15] ...e abre a tarefa manual de escalonamento.
    EscalateSettlement.show({ claim })
  }

  // REVIEW [2026-12-15] Se a triagem já recusou o sinistro, encerra como recusado.
  if (claim.status == Rejected) {
    // REVIEW [2026-12-15] Retorna o desfecho Rejected.
    return Rejected
  }

  // REVIEW [2026-12-15] Sem escalonamento, segue o caminho automático de análise.
  if (!escalated) {
    // REVIEW [2026-12-15] Coleta a declaração do segurado, tolerando o estouro de prazo.
    try {
      // REVIEW [2026-12-15] Abre o formulário de declaração para o segurado.
      ClaimStatement.show({ claim })
    } catch (Timeout) { // REVIEW [2026-12-15] prazo da declaração esgotado
      // REVIEW [2026-12-15] Sem declaração no prazo: segue para a avaliação de risco.
    }

    // REVIEW [2026-12-15] Avalia o risco de fraude a partir do valor e do tipo do sinistro.
    fraudBand = FraudRisk.evaluate({
      // REVIEW [2026-12-15] Valor reclamado usado no cálculo.
      amount: claim.amount,
      // REVIEW [2026-12-15] Tipo do sinistro usado no cálculo.
      type: claim.type
    })

    // REVIEW [2026-12-15] Persiste a faixa de risco no documento.
    Claim.recordRisk({ band: fraudBand })
    // REVIEW [2026-12-15] Inicia a análise do sinistro.
    Claim.startReview()

    // REVIEW [2026-12-15] Risco alto exige a análise especializada de fraude.
    if (fraudBand == High) {
      // REVIEW [2026-12-15] Executa o subprocesso de análise de fraude para o sinistro.
      ClaimFraudReview.run({ claim })

      // REVIEW [2026-12-15] Fraude confirmada leva à recusa do sinistro.
      if (claim.fraudConfirmed) {
        // REVIEW [2026-12-15] Abre o formulário de recusa.
        ClaimRejection.show({ claim })
        // REVIEW [2026-12-15] Retorna o desfecho Rejected.
        return Rejected
      }
    }

    // REVIEW [2026-12-15] Cobertura não confirmada também leva à recusa.
    if (!claim.covered) {
      // REVIEW [2026-12-15] Abre o formulário de recusa.
      ClaimRejection.show({ claim })
      // REVIEW [2026-12-15] Retorna o desfecho Rejected.
      return Rejected
    }
  }

  // REVIEW [2026-12-15] Decisão do ajustador, tolerando o estouro de prazo com escalonamento.
  try {
    // REVIEW [2026-12-15] Abre o formulário de decisão para o ajustador.
    ClaimDecision.show({ claim })
  } catch (Timeout) { // REVIEW [2026-12-15] prazo da decisão esgotado
    // REVIEW [2026-12-15] Sem decisão no prazo, escala a tarefa ao gerente.
    EscalateSettlement.show({ claim })
    // REVIEW [2026-12-15] Reapresenta o formulário de decisão após o escalonamento.
    ClaimDecision.show({ claim })
  }

  // REVIEW [2026-12-15] Se a decisão recusou o sinistro, encerra como recusado.
  if (claim.status == Rejected) {
    // REVIEW [2026-12-15] Retorna o desfecho Rejected.
    return Rejected
  }

  // REVIEW [2026-12-15] Abre a liquidação do sinistro aprovado.
  settlement = Claim.openSettlement()

  // REVIEW [2026-12-15] Envia a instrução de pagamento para o setor financeiro.
  send PaymentInstruction {
    // REVIEW [2026-12-15] Correlaciona a mensagem ao sinistro.
    key: claim
    // REVIEW [2026-12-15] Dados preenchidos na mensagem.
    with {
      // REVIEW [2026-12-15] Número da liquidação criada.
      settlementNumber: settlement.number
      // REVIEW [2026-12-15] Valor aprovado para pagamento.
      amount: claim.approvedAmount
    }
  }

  // REVIEW [2026-12-15] Aguarda a confirmação de pagamento com prazo de dois dias.
  try {
    // REVIEW [2026-12-15] Recebe a confirmação e aplica o comando que marca o sinistro como pago.
    receive PaymentConfirmation {
      // REVIEW [2026-12-15] Correlaciona a resposta ao sinistro.
      key: claim
      // REVIEW [2026-12-15] Prazo máximo de espera pela confirmação.
      timeout: 2d
      // REVIEW [2026-12-15] Ação executada quando a confirmação chega.
      apply: Claim.confirmPayment
    }
  } catch (Timeout, PaymentRejected) { // REVIEW [2026-12-15] sem confirmação de pagamento
    // REVIEW [2026-12-15] Sem pagamento confirmado, reabre a análise do sinistro.
    Claim.reopen()
    // REVIEW [2026-12-15] Retorna o desfecho Cancelled.
    return Cancelled
  }

  // REVIEW [2026-12-15] Pagamento confirmado: retorna o desfecho de sucesso.
  return Settled

  // REVIEW [2026-12-15] Desfecho que indica sinistro indenizado.
  end Settled {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Indenizado", en: "Settled" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }

  // REVIEW [2026-12-15] Desfecho que indica sinistro recusado.
  end Rejected {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Recusado", en: "Rejected" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: failure
  }

  // REVIEW [2026-12-15] Desfecho que indica processo cancelado sem indenização.
  end Cancelled {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Cancelado", en: "Cancelled" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: cancelled
  }
}

// REVIEW [2026-12-15] Formulário de triagem que confirma cobertura e atribui o ajustador.
form ClaimTriage {
  // REVIEW [2026-12-15] Título exibido na inbox.
  title: { pt-BR: "Triagem do sinistro", en: "Claim triage" }
  // REVIEW [2026-12-15] Documento manipulado pelo formulário.
  document: Claim
  // REVIEW [2026-12-15] Papéis que recebem a tarefa.
  roles: [Clerk]
  // REVIEW [2026-12-15] Prazo máximo para conclusão da tarefa.
  timeout: 4h
  // REVIEW [2026-12-15] Tarefa puxada pelo próprio usuário a partir da inbox.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Segurado reaproveitado do documento.
    claimant
    // REVIEW [2026-12-15] Cobertura reaproveitada do documento.
    coverage
    // REVIEW [2026-12-15] Tipo de sinistro reaproveitado do documento.
    type
    // REVIEW [2026-12-15] Valor reclamado reaproveitado do documento.
    amount
    // REVIEW [2026-12-15] Descrição reaproveitada do documento.
    description
    // REVIEW [2026-12-15] Confirmação de cobertura reaproveitada do documento.
    covered
    // REVIEW [2026-12-15] Ajustador responsável reaproveitado do documento.
    adjuster
    // REVIEW [2026-12-15] Motivo da recusa, quando a triagem recusar o sinistro.
    reason: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Motivo da recusa", en: "Rejection reason" }
      // REVIEW [2026-12-15] Limita o motivo a quinhentos caracteres.
      maxLength: 500
    }
  }

  // REVIEW [2026-12-15] Ações disponíveis no formulário.
  actions {
    // REVIEW [2026-12-15] Tria o sinistro com cobertura, tipo e ajustador informados.
    triage { calls: Claim.triage(covered, type, adjuster) }
    // REVIEW [2026-12-15] Recusa o sinistro com o motivo informado.
    reject { calls: Claim.reject(reason) }
  }
}

// REVIEW [2026-12-15] Formulário em que o segurado declara o ocorrido.
form ClaimStatement {
  // REVIEW [2026-12-15] Título exibido na inbox.
  title: { pt-BR: "Declaração do segurado", en: "Policyholder statement" }
  // REVIEW [2026-12-15] Documento manipulado pelo formulário.
  document: Claim
  // REVIEW [2026-12-15] Papéis que recebem a tarefa.
  roles: [Policyholder]
  // REVIEW [2026-12-15] Prazo máximo para conclusão da tarefa.
  timeout: 3d

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Texto da declaração do segurado, obrigatório.
    text: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Declaração", en: "Statement" }
      // REVIEW [2026-12-15] Limita a declaração a dois mil caracteres.
      maxLength: 2000
      // REVIEW [2026-12-15] Torna a declaração obrigatória no preenchimento.
      required
    }
  }

  // REVIEW [2026-12-15] Ações disponíveis no formulário.
  actions {
    // REVIEW [2026-12-15] Registra a declaração no documento.
    describe { calls: Claim.describe(text) }
  }
}

// REVIEW [2026-12-15] Formulário de recusa do sinistro com o motivo informado.
form ClaimRejection {
  // REVIEW [2026-12-15] Título exibido na inbox.
  title: { pt-BR: "Recusa do sinistro", en: "Claim rejection" }
  // REVIEW [2026-12-15] Documento manipulado pelo formulário.
  document: Claim
  // REVIEW [2026-12-15] Papéis que recebem a tarefa.
  roles: [Adjuster]
  // REVIEW [2026-12-15] Prazo máximo para conclusão da tarefa.
  timeout: 1d

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Motivo da recusa, obrigatório.
    reason: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Motivo da recusa", en: "Rejection reason" }
      // REVIEW [2026-12-15] Limita o motivo a quinhentos caracteres.
      maxLength: 500
      // REVIEW [2026-12-15] Torna o motivo obrigatório no preenchimento.
      required
    }
  }

  // REVIEW [2026-12-15] Ações disponíveis no formulário.
  actions {
    // REVIEW [2026-12-15] Recusa o sinistro com o motivo informado.
    reject { calls: Claim.reject(reason) }
  }
}

// REVIEW [2026-12-15] Formulário de decisão do ajustador: aprova ou recusa o sinistro.
form ClaimDecision {
  // REVIEW [2026-12-15] Título exibido na inbox.
  title: { pt-BR: "Decisão do ajustador", en: "Adjuster decision" }
  // REVIEW [2026-12-15] Documento manipulado pelo formulário.
  document: Claim
  // REVIEW [2026-12-15] Papéis que recebem a tarefa.
  roles: [Adjuster]
  // REVIEW [2026-12-15] Prazo máximo para conclusão da tarefa.
  timeout: 2d
  // REVIEW [2026-12-15] Tarefa puxada pelo próprio usuário a partir da inbox.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Valor aprovado reaproveitado do documento.
    approvedAmount
    // REVIEW [2026-12-15] Motivo da recusa, usado quando a decisão for desfavorável.
    reason: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Motivo da recusa", en: "Rejection reason" }
      // REVIEW [2026-12-15] Limita o motivo a quinhentos caracteres.
      maxLength: 500
    }
  }

  // REVIEW [2026-12-15] Ações disponíveis no formulário.
  actions {
    // REVIEW [2026-12-15] Aprova o sinistro com o valor informado.
    approve { calls: Claim.approve(approvedAmount) }
    // REVIEW [2026-12-15] Recusa o sinistro com o motivo informado.
    reject { calls: Claim.reject(reason) }
  }
}

// REVIEW [2026-12-15] Tarefa manual de escalonamento quando os prazos do caso estouram.
manual EscalateSettlement {
  // REVIEW [2026-12-15] Título exibido na inbox.
  title: { pt-BR: "Escalonar o sinistro", en: "Escalate claim" }
  // REVIEW [2026-12-15] Documento manipulado pela tarefa.
  document: Claim
  // REVIEW [2026-12-15] Papéis que recebem a tarefa.
  roles: [Manager]
  // REVIEW [2026-12-15] Orientações exibidas ao responsável pela tarefa.
  instructions: "Revisar o caso com o ajustador e registrar a decisão de prazo"
  // REVIEW [2026-12-15] Prazo máximo para conclusão da tarefa.
  timeout: 1d
  // REVIEW [2026-12-15] Tarefa puxada pelo próprio usuário a partir da inbox.
  assign: pull
}

// REVIEW [2026-12-15] Erro de negócio: pagamento recusado pelo meio de pagamento.
error PaymentRejected {
  // REVIEW [2026-12-15] Título do erro exibido ao usuário.
  title: { pt-BR: "Pagamento recusado", en: "Payment rejected" }
}

// REVIEW [2026-12-15] Decisão que calcula a faixa de risco de fraude de um sinistro.
decision FraudRisk {
  // REVIEW [2026-12-15] Título exibido no builder e na revisão.
  title: { pt-BR: "Risco de fraude do sinistro", en: "Claim fraud risk" }
  // REVIEW [2026-12-15] Tipo devolvido pela decisão.
  returns: FraudBand

  // REVIEW [2026-12-15] Entradas necessárias para o cálculo.
  inputs {
    // REVIEW [2026-12-15] Valor reclamado considerado no cálculo.
    amount: std.Money
    // REVIEW [2026-12-15] Tipo do sinistro considerado no cálculo.
    type: ClaimType
  }

  // REVIEW [2026-12-15] Regras avaliadas em ordem até a primeira que casar.
  cases {
    // REVIEW [2026-12-15] Valores acima de cinquenta mil reais indicam risco alto.
    amount > 50000 BRL -> High
    // REVIEW [2026-12-15] Furto acima de vinte mil reais também indica risco alto.
    type == Theft and amount > 20000 BRL -> High
    // REVIEW [2026-12-15] Valores acima de quinze mil reais indicam risco médio.
    amount > 15000 BRL -> Medium
    // REVIEW [2026-12-15] Demais casos ficam na faixa de risco baixo.
    else -> Low
  }

  // REVIEW [2026-12-15] Norma que fundamenta as regras da decisão.
  source: "Política Antifraude v4"
  // REVIEW [2026-12-15] Área responsável pela manutenção da decisão.
  owner: "Fraud"
}
