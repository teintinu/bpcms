// REVIEW [2026-12-15] service: example.com/services/claims
// REVIEW [2026-12-15] Process: sintaxe atual (DSL_REFERENCE.md §4)

// REVIEW [2026-12-15] Processo chamado que reavalia e decide a suspeita de fraude de um sinistro.
process ClaimFraudReview(claim: Claim) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Análise de fraude do sinistro", en: "Claim fraud review" }
  // REVIEW [2026-12-15] Versão do artefato Process; diff e release comparam.
  version: 1
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Confirmar ou descartar a fraude com evidências registradas e prazo"
  }
  // REVIEW [2026-12-15] SLA brando do caso: alvo de lead time, não é timer.
  sla: 7d

  // REVIEW [2026-12-15] Processo chamado por outro processo, sem gatilho próprio.
  called

  // REVIEW [2026-12-15] Primeira rodada: solicita a reavaliação das evidências pelo analista.
  try {
    // REVIEW [2026-12-15] Abre o formulário de reavaliação para o sinistro.
    FraudReassessment.show({ claim })
  } catch (Timeout) { // REVIEW [2026-12-15] prazo da reavaliação esgotado
    // REVIEW [2026-12-15] Sem reavaliação no prazo, escala a análise ao gerente.
    EscalateFraudReview.show({ claim })
  }

  // REVIEW [2026-12-15] Segunda rodada: coleta o parecer final de fraude.
  try {
    // REVIEW [2026-12-15] Abre o formulário de decisão para o analista.
    FraudDecision.show({ claim })
  } catch (Timeout) { // REVIEW [2026-12-15] prazo do parecer esgotado
    // REVIEW [2026-12-15] Sem parecer no prazo, escala e reabre a decisão.
    EscalateFraudReview.show({ claim })
    // REVIEW [2026-12-15] Reapresenta o formulário de decisão após o escalonamento.
    FraudDecision.show({ claim })
  }

  // REVIEW [2026-12-15] Se a análise registrou fraude, encerra no desfecho de falha.
  if (claim.fraudConfirmed) {
    // REVIEW [2026-12-15] Retorna o desfecho FraudConfirmed.
    return FraudConfirmed
  }

  // REVIEW [2026-12-15] Sem confirmação de fraude, retorna o desfecho de sucesso.
  return Cleared

  // REVIEW [2026-12-15] Desfecho que indica fraude confirmada.
  end FraudConfirmed {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Fraude confirmada", en: "Fraud confirmed" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: failure
  }

  // REVIEW [2026-12-15] Desfecho que indica fraude descartada.
  end Cleared {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Fraude descartada", en: "Cleared" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }
}

// REVIEW [2026-12-15] Formulário que reavalia as evidências de fraude do sinistro.
form FraudReassessment {
  // REVIEW [2026-12-15] Título exibido na inbox.
  title: { pt-BR: "Reavaliação de fraude", en: "Fraud reassessment" }
  // REVIEW [2026-12-15] Documento manipulado pelo formulário.
  document: Claim
  // REVIEW [2026-12-15] Papéis que recebem a tarefa.
  roles: [FraudAnalyst]
  // REVIEW [2026-12-15] Prazo máximo para conclusão da tarefa.
  timeout: 2d
  // REVIEW [2026-12-15] Tarefa puxada pelo próprio usuário a partir da inbox.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Tipo da evidência a registrar, obrigatório.
    evidenceKind: EvidenceKind {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Tipo de evidência", en: "Evidence kind" }
      // REVIEW [2026-12-15] Torna o campo obrigatório no preenchimento.
      required
    }
    // REVIEW [2026-12-15] Resumo das evidências, reaproveitando o campo do documento.
    evidenceSummary
  }

  // REVIEW [2026-12-15] Ações disponíveis no formulário.
  actions {
    // REVIEW [2026-12-15] Registra a evidência e conclui a reavaliação.
    record { calls: Claim.recordEvidence(evidenceKind, evidenceSummary) }
  }
}

// REVIEW [2026-12-15] Formulário que registra o parecer final sobre a fraude.
form FraudDecision {
  // REVIEW [2026-12-15] Título exibido na inbox.
  title: { pt-BR: "Parecer de fraude", en: "Fraud decision" }
  // REVIEW [2026-12-15] Documento manipulado pelo formulário.
  document: Claim
  // REVIEW [2026-12-15] Papéis que recebem a tarefa.
  roles: [FraudAnalyst]
  // REVIEW [2026-12-15] Prazo máximo para conclusão da tarefa.
  timeout: 1d
  // REVIEW [2026-12-15] Tarefa puxada pelo próprio usuário a partir da inbox.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Nota textual da análise, reaproveitando o campo do documento.
    fraudNote
  }

  // REVIEW [2026-12-15] Ações disponíveis no formulário.
  actions {
    // REVIEW [2026-12-15] Confirma a fraude com a nota informada.
    confirm { calls: Claim.confirmFraud(fraudNote) }
    // REVIEW [2026-12-15] Descarta a fraude com a nota informada.
    clear { calls: Claim.clearFraud(fraudNote) }
  }
}

// REVIEW [2026-12-15] Tarefa manual de escalonamento quando os prazos de análise estouram.
manual EscalateFraudReview {
  // REVIEW [2026-12-15] Título exibido na inbox.
  title: { pt-BR: "Escalonar a análise de fraude", en: "Escalate fraud review" }
  // REVIEW [2026-12-15] Documento manipulado pela tarefa.
  document: Claim
  // REVIEW [2026-12-15] Papéis que recebem a tarefa.
  roles: [Manager]
  // REVIEW [2026-12-15] Orientações exibidas ao responsável pela tarefa.
  instructions: "Revisar a evidência com o analista e definir o parecer"
  // REVIEW [2026-12-15] Prazo máximo para conclusão da tarefa.
  timeout: 1d
  // REVIEW [2026-12-15] Tarefa puxada pelo próprio usuário a partir da inbox.
  assign: pull
}
