// REVIEW [2026-12-15] service: example.com/services/claims

// REVIEW [2026-12-15] Documento central de sinistros: registra o aviso, a triagem, a análise e o pagamento.
document Claim {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Sinistro", en: "Claim" }
  // REVIEW [2026-12-15] Versão do artefato Document; releases e diffs comparam.
  version: 1
  // REVIEW [2026-12-15] Área de negócio responsável pelo documento.
  owner: "Claims"
  // REVIEW [2026-12-15] Sincronização em tempo real entre os clientes conectados.
  sync: live
  // REVIEW [2026-12-15] Retenção legal dos registros por dez anos.
  retention: 10y

  // REVIEW [2026-12-15] Campos que compõem o sinistro.
  fields {
    // REVIEW [2026-12-15] Número único do sinistro, usado como identificador legível.
    number: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Número", en: "Number" }
      // REVIEW [2026-12-15] Permite localizar o sinistro pelo número.
      lookup
      // REVIEW [2026-12-15] Impede números duplicados.
      unique
      // REVIEW [2026-12-15] Limita o número a vinte e quatro caracteres.
      maxLength: 24
    }
    // REVIEW [2026-12-15] Segurado que abriu o sinistro, referenciando um usuário de identidade.
    claimant: Identity.User { title: { pt-BR: "Segurado", en: "Claimant" }, lookup }
    // REVIEW [2026-12-15] Cobertura de apólice associada ao sinistro.
    coverage: Coverage { title: { pt-BR: "Cobertura", en: "Coverage" }, lookup }
    // REVIEW [2026-12-15] Classificação do tipo de sinistro, com colisão como valor padrão.
    type: ClaimType {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Tipo de sinistro", en: "Claim type" }
      // REVIEW [2026-12-15] Permite localizar por tipo.
      lookup
      // REVIEW [2026-12-15] Valor assumido quando o campo não é informado.
      default: Collision
    }
    // REVIEW [2026-12-15] Data e hora em que o incidente ocorreu; obrigatória.
    occurredAt: DateTime { title: { pt-BR: "Ocorrido em", en: "Occurred at" }, required }
    // REVIEW [2026-12-15] Descrição livre do ocorrido, tratada como dado sensível.
    description: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Descrição", en: "Description" }
      // REVIEW [2026-12-15] Restringe a leitura a papéis autorizados.
      sensitive
      // REVIEW [2026-12-15] Limita o texto a dois mil caracteres.
      maxLength: 2000
    }
    // REVIEW [2026-12-15] Valor reclamado pelo segurado, em reais.
    amount: std.Money {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Valor reclamado", en: "Claimed amount" }
      // REVIEW [2026-12-15] Moeda do valor reclamado.
      currency: BRL
      // REVIEW [2026-12-15] Permite localizar pelo valor.
      lookup
      // REVIEW [2026-12-15] Torna o valor obrigatório no preenchimento.
      required
    }
    // REVIEW [2026-12-15] Valor aprovado pelo ajustador, em reais.
    approvedAmount: std.Money { title: { pt-BR: "Valor aprovado", en: "Approved amount" }, currency: BRL }
    // REVIEW [2026-12-15] Situação atual do sinistro no fluxo de estados.
    status: ClaimStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    // REVIEW [2026-12-15] Indica se a cobertura foi confirmada na triagem.
    covered: boolean { title: { pt-BR: "Cobertura confirmada", en: "Coverage confirmed" }, default: false }
    // REVIEW [2026-12-15] Faixa de risco de fraude atribuída na avaliação.
    fraudBand: FraudBand { title: { pt-BR: "Faixa de risco", en: "Fraud band" }, lookup }
    // REVIEW [2026-12-15] Marca a confirmação de fraude; visível apenas internamente.
    fraudConfirmed: boolean {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Fraude confirmada", en: "Fraud confirmed" }
      // REVIEW [2026-12-15] Valor assumido quando não há confirmação.
      default: false
      // REVIEW [2026-12-15] Oculta o campo de quem não tem permissão.
      private
    }
    // REVIEW [2026-12-15] Nota textual da análise antifraude.
    fraudNote: string { title: { pt-BR: "Nota da análise", en: "Fraud note" }, maxLength: 1000 }
    // REVIEW [2026-12-15] Tipo da última evidência registrada.
    lastEvidenceKind: EvidenceKind { title: { pt-BR: "Última evidência", en: "Last evidence" } }
    // REVIEW [2026-12-15] Resumo textual das evidências coletadas.
    evidenceSummary: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Resumo das evidências", en: "Evidence summary" }
      // REVIEW [2026-12-15] Limita o resumo a mil caracteres.
      maxLength: 1000
    }
    // REVIEW [2026-12-15] Motivo que levou à recusa do sinistro.
    rejectReason: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Motivo da recusa", en: "Rejection reason" }
      // REVIEW [2026-12-15] Restringe a leitura a papéis autorizados.
      sensitive
      // REVIEW [2026-12-15] Limita o motivo a quinhentos caracteres.
      maxLength: 500
    }
    // REVIEW [2026-12-15] Data em que o segurado prestou a declaração do ocorrido.
    statementAt: DateTime { title: { pt-BR: "Declaração em", en: "Statement at" }, readonly }
    // REVIEW [2026-12-15] Ajustador responsável pela análise do sinistro.
    adjuster: Identity.User { title: { pt-BR: "Ajustador", en: "Adjuster" } }
    // REVIEW [2026-12-15] Data de abertura do sinistro, definida pelo sistema.
    openedAt: DateTime { title: { pt-BR: "Aberto em", en: "Opened at" }, readonly }
    // REVIEW [2026-12-15] Data da decisão final do sinistro, definida pelo sistema.
    decidedAt: DateTime { title: { pt-BR: "Decidido em", en: "Decided at" }, readonly }
    // REVIEW [2026-12-15] Data em que o pagamento foi confirmado.
    paidAt: DateTime { title: { pt-BR: "Pago em", en: "Paid at" }, readonly }
    // REVIEW [2026-12-15] Referência bancária do pagamento realizado.
    paymentReference: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Referência do pagamento", en: "Payment reference" }
      // REVIEW [2026-12-15] Limita a referência a quarenta caracteres.
      maxLength: 40
    }
  }

  // REVIEW [2026-12-15] Índices que aceleram consultas frequentes sobre sinistros.
  indexes {
    // REVIEW [2026-12-15] Busca exata pelo número do sinistro.
    byNumber: [number] unique
    // REVIEW [2026-12-15] Consultas por situação ordenadas pela abertura.
    byStatus: [status, openedAt] range
    // REVIEW [2026-12-15] Busca por cobertura associada.
    byCoverage: [coverage.id] hash
    // REVIEW [2026-12-15] Busca por segurado associado.
    byClaimant: [claimant.id] hash
  }


  // REVIEW [2026-12-15] Comandos de negócio que alteram o sinistro e emitem eventos.
  actions {
    // REVIEW [2026-12-15] Registra o aviso de sinistro e marca o momento da abertura.
    register(occurredOn: DateTime, claimedAmount: std.Money) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Registrar aviso", en: "Register notice" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Clerk, Policyholder]
      // REVIEW [2026-12-15] Emite Opened e grava os dados iniciais do sinistro.
      {
        // REVIEW [2026-12-15] Notifica a abertura para gatilhos de processo.
        emit Opened { occurredAt: occurredOn; amount: claimedAmount }
        // REVIEW [2026-12-15] Grava a data/hora da abertura.
        openedAt = now()
        // REVIEW [2026-12-15] Grava a data do incidente.
        occurredAt = occurredOn
        // REVIEW [2026-12-15] Grava o valor reclamado.
        amount = claimedAmount
      }
    }

    // REVIEW [2026-12-15] Triagem inicial: confirma cobertura, define tipo e atribui ajustador.
    triage(coveredNow: boolean, claimType: ClaimType, assignedAdjuster: Identity.User) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Triar sinistro", en: "Triage claim" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Clerk]
      // REVIEW [2026-12-15] Move o sinistro para a situação Triaged.
      to: status.Triaged
      // REVIEW [2026-12-15] Publica cobertura e tipo no evento de transição.
      emits { covered: coveredNow; type: claimType }
      // REVIEW [2026-12-15] Persiste os dados da triagem no documento.
      {
        // REVIEW [2026-12-15] Registra a confirmação de cobertura.
        covered = coveredNow
        // REVIEW [2026-12-15] Registra o tipo informado.
        type = claimType
        // REVIEW [2026-12-15] Atribui o ajustador responsável.
        adjuster = assignedAdjuster
      }
    }

    // REVIEW [2026-12-15] Permite ao segurado declarar o ocorrido por escrito.
    describe(text: string) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Declarar o ocorrido", en: "Describe the incident" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Policyholder]
      // REVIEW [2026-12-15] Grava a declaração e o momento em que foi prestada.
      { description = text; statementAt = now() }
    }

    // REVIEW [2026-12-15] Inicia a análise do sinistro pelo ajustador.
    startReview() {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Iniciar análise", en: "Start review" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Clerk, Adjuster]
      // REVIEW [2026-12-15] Move o sinistro para a situação UnderReview.
      to: status.UnderReview
      // REVIEW [2026-12-15] Publica o instante de início no evento de transição.
      emits { at: now() }
    }

    // REVIEW [2026-12-15] Grava a faixa de risco de fraude calculada ou revista.
    recordRisk(band: FraudBand) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Registrar faixa de risco", en: "Record fraud band" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [FraudAnalyst]
      // REVIEW [2026-12-15] Persiste a faixa de risco no documento.
      { fraudBand = band }
    }

    // REVIEW [2026-12-15] Registra uma evidência coletada durante a investigação.
    recordEvidence(kind: EvidenceKind, summary: string) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Registrar evidência", en: "Record evidence" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [FraudAnalyst, Adjuster]
      // REVIEW [2026-12-15] Guarda o tipo e o resumo da evidência.
      { lastEvidenceKind = kind; evidenceSummary = summary }
    }

    // REVIEW [2026-12-15] Confirma a existência de fraude com base na análise.
    confirmFraud(note: string) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Confirmar fraude", en: "Confirm fraud" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [FraudAnalyst, Manager]
      // REVIEW [2026-12-15] Marca a fraude e registra a justificativa.
      { fraudConfirmed = true; fraudNote = note }
    }

    // REVIEW [2026-12-15] Descarta a suspeita de fraude com base na análise.
    clearFraud(note: string) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Descartar fraude", en: "Clear fraud" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [FraudAnalyst, Manager]
      // REVIEW [2026-12-15] Desmarca a fraude e registra a justificativa.
      { fraudConfirmed = false; fraudNote = note }
    }

    // REVIEW [2026-12-15] Aprova o sinistro com o valor total a indenizar.
    approve(approvedTotal: std.Money) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Aprovar sinistro", en: "Approve claim" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Adjuster]
      // REVIEW [2026-12-15] Move o sinistro para a situação Approved.
      to: status.Approved
      // REVIEW [2026-12-15] Publica valor aprovado e instante no evento de transição.
      emits { approvedAmount: approvedTotal; at: now() }
      // REVIEW [2026-12-15] Persiste o valor aprovado e a data da decisão.
      { approvedAmount = approvedTotal; decidedAt = now() }
    }

    // REVIEW [2026-12-15] Recusa o sinistro com o motivo informado.
    reject(reason: string) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Recusar sinistro", en: "Reject claim" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Clerk, Adjuster]
      // REVIEW [2026-12-15] Move o sinistro para a situação Rejected.
      to: status.Rejected
      // REVIEW [2026-12-15] Publica o instante da recusa no evento de transição.
      emits { at: now() }
      // REVIEW [2026-12-15] Persiste o motivo e a data da decisão.
      { rejectReason = reason; decidedAt = now() }
    }

    // REVIEW [2026-12-15] Abre uma liquidação para o sinistro aprovado.
    openSettlement() {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Abrir liquidação", en: "Open settlement" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [FinanceAnalyst]
      // REVIEW [2026-12-15] Devolve o documento Settlement criado.
      returns: Settlement
    }

    // REVIEW [2026-12-15] Confirma o pagamento efetuado e encerra o sinistro.
    confirmPayment(reference: string) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Confirmar pagamento", en: "Confirm payment" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [FinanceAnalyst]
      // REVIEW [2026-12-15] Move o sinistro para a situação Paid.
      to: status.Paid
      // REVIEW [2026-12-15] Publica o valor aprovado no evento de transição.
      emits { amount: approvedAmount }
      // REVIEW [2026-12-15] Persiste a data do pagamento e a referência bancária.
      { paidAt = now(); paymentReference = reference }
    }

    // REVIEW [2026-12-15] Reabre a análise de um sinistro aprovado para revisão.
    reopen() {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Reabrir análise", en: "Reopen review" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Manager]
      // REVIEW [2026-12-15] Move o sinistro de volta para a situação UnderReview.
      to: status.UnderReview
      // REVIEW [2026-12-15] Publica o instante da reabertura no evento de transição.
      emits { at: now() }
    }
  }
}

// REVIEW [2026-12-15] Shape de estado que modela o ciclo de vida do sinistro.
shape ClaimStatus {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Situação do sinistro", en: "Claim status" }
  // REVIEW [2026-12-15] Base do shape: máquina de estados.
  base: state
  // REVIEW [2026-12-15] Estado inicial é Opened, com a transição que cria o sinistro.
  initial: Opened with transition Opened {
    // REVIEW [2026-12-15] Título exibido no evento de abertura.
    title: { pt-BR: "Aviso de sinistro aberto", en: "Claim notice opened" }
    // REVIEW [2026-12-15] Dados transportados pelo evento de abertura.
    payload {
      // REVIEW [2026-12-15] Data do incidente informada no aviso.
      occurredAt: DateTime { title: { pt-BR: "Ocorrido em", en: "Occurred at" } }
      // REVIEW [2026-12-15] Valor reclamado no aviso.
      amount: std.Money { title: { pt-BR: "Valor reclamado", en: "Claimed amount" } }
    }
  }

  // REVIEW [2026-12-15] Estado em que o aviso foi registrado e aguarda triagem.
  value Opened {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Aviso aberto", en: "Opened" }
    // REVIEW [2026-12-15] Ícone do estado no quadro e na linha do tempo.
    icon: status.opened
    // REVIEW [2026-12-15] Ordem de exibição no fluxo de estados.
    ordinal: 10

    // REVIEW [2026-12-15] Transição para Triaged após a triagem do atendente.
    transition Triaged {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Sinistro triado", en: "Claim triaged" }
      // REVIEW [2026-12-15] Dados transportados pelo evento de triagem.
      payload {
        // REVIEW [2026-12-15] Cobertura confirmada na triagem.
        covered: boolean { title: { pt-BR: "Cobertura confirmada", en: "Coverage confirmed" } }
        // REVIEW [2026-12-15] Tipo atribuído ao sinistro.
        type: ClaimType { title: { pt-BR: "Tipo de sinistro", en: "Claim type" } }
      }
    }

    // REVIEW [2026-12-15] Transição para Rejected na recusa direta do aviso.
    transition Rejected {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Sinistro recusado", en: "Claim rejected" }
      // REVIEW [2026-12-15] Dados transportados pelo evento de recusa.
      payload {
        // REVIEW [2026-12-15] Motivo textual da recusa.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
        // REVIEW [2026-12-15] Instante em que a recusa ocorreu.
        at: DateTime { title: { pt-BR: "Recusado em", en: "Rejected at" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado em que o sinistro já foi triado.
  value Triaged {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Triado", en: "Triaged" }
    // REVIEW [2026-12-15] Ícone do estado no quadro e na linha do tempo.
    icon: status.triaged
    // REVIEW [2026-12-15] Ordem de exibição no fluxo de estados.
    ordinal: 20

    // REVIEW [2026-12-15] Transição para UnderReview, nomeada ReviewStarted.
    transition UnderReview {
      // REVIEW [2026-12-15] Nome do evento publicado na transição.
      event: ReviewStarted
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Análise iniciada", en: "Review started" }
      // REVIEW [2026-12-15] Dados transportados pelo evento de início de análise.
      payload {
        // REVIEW [2026-12-15] Instante em que a análise começou.
        at: DateTime { title: { pt-BR: "Iniciada em", en: "Started at" } }
      }
    }

    // REVIEW [2026-12-15] Transição para Rejected na recusa após a triagem.
    transition Rejected {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Sinistro recusado", en: "Claim rejected" }
      // REVIEW [2026-12-15] Dados transportados pelo evento de recusa.
      payload {
        // REVIEW [2026-12-15] Motivo textual da recusa.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
        // REVIEW [2026-12-15] Instante em que a recusa ocorreu.
        at: DateTime { title: { pt-BR: "Recusado em", en: "Rejected at" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado em que o sinistro está em análise pelo ajustador.
  value UnderReview {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Em análise", en: "Under review" }
    // REVIEW [2026-12-15] Ícone do estado no quadro e na linha do tempo.
    icon: status.underReview
    // REVIEW [2026-12-15] Ordem de exibição no fluxo de estados.
    ordinal: 30

    // REVIEW [2026-12-15] Transição para Approved após a decisão favorável.
    transition Approved {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Sinistro aprovado", en: "Claim approved" }
      // REVIEW [2026-12-15] Dados transportados pelo evento de aprovação.
      payload {
        // REVIEW [2026-12-15] Valor aprovado para indenização.
        approvedAmount: std.Money { title: { pt-BR: "Valor aprovado", en: "Approved amount" } }
        // REVIEW [2026-12-15] Instante em que a aprovação ocorreu.
        at: DateTime { title: { pt-BR: "Aprovado em", en: "Approved at" } }
      }
    }

    // REVIEW [2026-12-15] Transição para Rejected após a decisão desfavorável.
    transition Rejected {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Sinistro recusado", en: "Claim rejected" }
      // REVIEW [2026-12-15] Dados transportados pelo evento de recusa.
      payload {
        // REVIEW [2026-12-15] Motivo textual da recusa.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
        // REVIEW [2026-12-15] Instante em que a recusa ocorreu.
        at: DateTime { title: { pt-BR: "Recusado em", en: "Rejected at" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado em que o sinistro foi aprovado e aguarda pagamento.
  value Approved {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Aprovado", en: "Approved" }
    // REVIEW [2026-12-15] Ícone do estado no quadro e na linha do tempo.
    icon: status.approved
    // REVIEW [2026-12-15] Ordem de exibição no fluxo de estados.
    ordinal: 40

    // REVIEW [2026-12-15] Transição para Paid após a confirmação do pagamento.
    transition Paid {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Sinistro pago", en: "Claim paid" }
      // REVIEW [2026-12-15] Dados transportados pelo evento de pagamento.
      payload {
        // REVIEW [2026-12-15] Instante em que o pagamento ocorreu.
        paidAt: DateTime { title: { pt-BR: "Pago em", en: "Paid at" } }
        // REVIEW [2026-12-15] Valor efetivamente pago.
        amount: std.Money { title: { pt-BR: "Valor pago", en: "Paid amount" } }
      }
    }

    // REVIEW [2026-12-15] Transição de volta para UnderReview, nomeada Reopened.
    transition UnderReview {
      // REVIEW [2026-12-15] Nome do evento publicado na reabertura.
      event: Reopened
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Sinistro reaberto", en: "Claim reopened" }
      // REVIEW [2026-12-15] Dados transportados pelo evento de reabertura.
      payload {
        // REVIEW [2026-12-15] Instante em que a reabertura ocorreu.
        at: DateTime { title: { pt-BR: "Reaberto em", en: "Reopened at" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado final em que o sinistro foi recusado.
  value Rejected {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Recusado", en: "Rejected" }
    // REVIEW [2026-12-15] Ícone do estado no quadro e na linha do tempo.
    icon: status.rejected
    // REVIEW [2026-12-15] Ordem de exibição no fluxo de estados.
    ordinal: 50
  }
  // REVIEW [2026-12-15] Estado final em que o sinistro foi pago.
  value Paid {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Pago", en: "Paid" }
    // REVIEW [2026-12-15] Ícone do estado no quadro e na linha do tempo.
    icon: status.paid
    // REVIEW [2026-12-15] Ordem de exibição no fluxo de estados.
    ordinal: 60
  }
}

