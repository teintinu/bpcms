// REVIEW [2026-12-15] service: example.com/services/claims

// REVIEW [2026-12-15] Documento que descreve a cobertura de apólice associada a um sinistro.
document Coverage {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Cobertura", en: "Coverage" }
  // REVIEW [2026-12-15] Versão do artefato Document; releases e diffs comparam.
  version: 1
  // REVIEW [2026-12-15] Área de negócio responsável pelo documento.
  owner: "Claims"

  // REVIEW [2026-12-15] Campos que compõem a cobertura.
  fields {
    // REVIEW [2026-12-15] Número único da apólice de origem.
    policyNumber: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Apólice", en: "Policy number" }
      // REVIEW [2026-12-15] Permite localizar a cobertura pela apólice.
      lookup
      // REVIEW [2026-12-15] Impede apólices duplicadas.
      unique
      // REVIEW [2026-12-15] Limita o número a vinte e quatro caracteres.
      maxLength: 24
    }
    // REVIEW [2026-12-15] Nome do produto de seguro contratado.
    product: string { title: { pt-BR: "Produto", en: "Product" }, lookup, maxLength: 60 }
    // REVIEW [2026-12-15] Início da vigência da cobertura.
    validFrom: DateTime { title: { pt-BR: "Vigente de", en: "Valid from" } }
    // REVIEW [2026-12-15] Fim da vigência da cobertura.
    validTo: DateTime { title: { pt-BR: "Vigente até", en: "Valid to" } }
    // REVIEW [2026-12-15] Valor máximo de indenização da apólice.
    limitAmount: std.Money {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Limite de indenização", en: "Coverage limit" }
      // REVIEW [2026-12-15] Moeda do limite de indenização.
      currency: BRL
      // REVIEW [2026-12-15] Torna o limite obrigatório no preenchimento.
      required
    }
    // REVIEW [2026-12-15] Franquia que o segurado assume em cada sinistro.
    deductible: std.Money { title: { pt-BR: "Franquia", en: "Deductible" }, currency: BRL }
    // REVIEW [2026-12-15] Situação atual da cobertura no fluxo de estados.
    status: CoverageStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    // REVIEW [2026-12-15] Data em que a cobertura expirou, definida pelo sistema.
    expiredAt: DateTime { title: { pt-BR: "Expirada em", en: "Expired at" }, readonly }
  }

  // REVIEW [2026-12-15] Índices que aceleram consultas frequentes sobre coberturas.
  indexes {
    // REVIEW [2026-12-15] Busca exata pelo número da apólice.
    byPolicy: [policyNumber] unique
    // REVIEW [2026-12-15] Consultas por situação ordenadas pela validade.
    byStatus: [status, validTo] range
  }


  // REVIEW [2026-12-15] Comandos de negócio que alteram a cobertura.
  actions {
    // REVIEW [2026-12-15] Encerra a cobertura e marca o instante da expiração.
    expire() {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Expirar cobertura", en: "Expire coverage" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Clerk]
      // REVIEW [2026-12-15] Move a cobertura para a situação Expired.
      to: status.Expired
      // REVIEW [2026-12-15] Registra a data/hora da expiração.
      { expiredAt = now() }
    }

    // REVIEW [2026-12-15] Renova a cobertura estendendo a validade.
    renew(newValidTo: DateTime) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Renovar cobertura", en: "Renew coverage" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Clerk]
      // REVIEW [2026-12-15] Move a cobertura para a situação Active.
      to: status.Active
      // REVIEW [2026-12-15] Publica a nova validade no evento de transição.
      emits { validTo: newValidTo }
      // REVIEW [2026-12-15] Persiste a nova data de validade.
      { validTo = newValidTo }
    }
  }
}

// REVIEW [2026-12-15] Shape de estado que modela o ciclo de vida da cobertura.
shape CoverageStatus {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Situação da cobertura", en: "Coverage status" }
  // REVIEW [2026-12-15] Base do shape: máquina de estados.
  base: state
  // REVIEW [2026-12-15] Estado inicial é Active.
  initial: Active

  // REVIEW [2026-12-15] Estado em que a cobertura está vigente.
  value Active {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Vigente", en: "Active" }
    // REVIEW [2026-12-15] Ícone do estado no quadro e na linha do tempo.
    icon: status.active
    // REVIEW [2026-12-15] Ordem de exibição no fluxo de estados.
    ordinal: 10

    // REVIEW [2026-12-15] Transição para Expired quando a vigência termina.
    transition Expired {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Cobertura expirada", en: "Coverage expired" }
      // REVIEW [2026-12-15] Dados transportados pelo evento de expiração.
      payload {
        // REVIEW [2026-12-15] Instante em que a cobertura expirou.
        expiredAt: DateTime { title: { pt-BR: "Expirada em", en: "Expired at" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado em que a cobertura não está mais vigente.
  value Expired {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Expirada", en: "Expired" }
    // REVIEW [2026-12-15] Ícone do estado no quadro e na linha do tempo.
    icon: status.expired
    // REVIEW [2026-12-15] Ordem de exibição no fluxo de estados.
    ordinal: 20

    // REVIEW [2026-12-15] Transição para Active, nomeada Renewed.
    transition Active {
      // REVIEW [2026-12-15] Nome do evento publicado na renovação.
      event: Renewed
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Cobertura renovada", en: "Coverage renewed" }
      // REVIEW [2026-12-15] Dados transportados pelo evento de renovação.
      payload {
        // REVIEW [2026-12-15] Nova data de vigência da cobertura.
        validTo: DateTime { title: { pt-BR: "Nova vigência", en: "New validity" } }
      }
    }
  }
}
