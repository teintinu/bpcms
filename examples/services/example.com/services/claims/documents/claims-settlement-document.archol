// REVIEW [2026-12-15] service: example.com/services/claims

// REVIEW [2026-12-15] Documento que representa a liquidação financeira de um sinistro aprovado.
document Settlement {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Liquidação", en: "Settlement" }
  // REVIEW [2026-12-15] Versão do artefato Document; releases e diffs comparam.
  version: 1
  // REVIEW [2026-12-15] Área de negócio responsável pelo documento.
  owner: "Claims"
  // REVIEW [2026-12-15] Sincronização em tempo real entre os clientes conectados.
  sync: live

  // REVIEW [2026-12-15] Campos que compõem a liquidação.
  fields {
    // REVIEW [2026-12-15] Número único da liquidação, usado como identificador legível.
    number: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Número", en: "Number" }
      // REVIEW [2026-12-15] Permite localizar a liquidação pelo número.
      lookup
      // REVIEW [2026-12-15] Impede números duplicados.
      unique
      // REVIEW [2026-12-15] Limita o número a vinte e quatro caracteres.
      maxLength: 24
    }
    // REVIEW [2026-12-15] Sinistro que originou a liquidação.
    claim: Claim { title: { pt-BR: "Sinistro", en: "Claim" }, lookup }
    // REVIEW [2026-12-15] Valor a ser liquidado, em reais.
    amount: std.Money {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Valor", en: "Amount" }
      // REVIEW [2026-12-15] Moeda do valor liquidado.
      currency: BRL
      // REVIEW [2026-12-15] Permite localizar pelo valor.
      lookup
      // REVIEW [2026-12-15] Torna o valor obrigatório no preenchimento.
      required
    }
    // REVIEW [2026-12-15] Forma de pagamento escolhida para a liquidação.
    method: PaymentMethod { title: { pt-BR: "Forma de pagamento", en: "Payment method" }, lookup }
    // REVIEW [2026-12-15] Situação atual da liquidação no fluxo de estados.
    status: SettlementStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    // REVIEW [2026-12-15] Data da aprovação da liquidação.
    approvedAt: DateTime { title: { pt-BR: "Aprovada em", en: "Approved at" }, readonly }
    // REVIEW [2026-12-15] Data do pagamento da liquidação.
    paidAt: DateTime { title: { pt-BR: "Paga em", en: "Paid at" }, readonly }
    // REVIEW [2026-12-15] Data do estorno da liquidação.
    reversedAt: DateTime { title: { pt-BR: "Estornada em", en: "Reversed at" }, readonly }
    // REVIEW [2026-12-15] Observação livre sobre a liquidação.
    note: string { title: { pt-BR: "Observação", en: "Note" }, maxLength: 500 }
  }

  // REVIEW [2026-12-15] Índices que aceleram consultas frequentes sobre liquidações.
  indexes {
    // REVIEW [2026-12-15] Busca exata pelo número da liquidação.
    byNumber: [number] unique
    // REVIEW [2026-12-15] Consultas por situação ordenadas pela aprovação.
    byStatus: [status, approvedAt] range
  }


  // REVIEW [2026-12-15] Comandos de negócio que alteram a liquidação.
  actions {
    // REVIEW [2026-12-15] Aprova a liquidação para pagamento.
    approve() {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Aprovar liquidação", en: "Approve settlement" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [FinanceAnalyst, Manager]
      // REVIEW [2026-12-15] Move a liquidação para a situação Approved.
      to: status.Approved
      // REVIEW [2026-12-15] Registra a data/hora da aprovação.
      { approvedAt = now() }
    }

    // REVIEW [2026-12-15] Registra o pagamento efetivo da liquidação.
    pay() {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Pagar liquidação", en: "Pay settlement" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [FinanceAnalyst]
      // REVIEW [2026-12-15] Move a liquidação para a situação Paid.
      to: status.Paid
      // REVIEW [2026-12-15] Registra a data/hora do pagamento.
      { paidAt = now() }
    }

    // REVIEW [2026-12-15] Estorna a liquidação com o motivo informado.
    reverse(reason: string) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Estornar liquidação", en: "Reverse settlement" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Manager]
      // REVIEW [2026-12-15] Move a liquidação de volta para a situação Pending.
      to: status.Pending
      // REVIEW [2026-12-15] Registra o instante do estorno e o motivo.
      { reversedAt = now(); note = reason }
    }
  }
}

// REVIEW [2026-12-15] Shape de estado que modela o ciclo de vida da liquidação.
shape SettlementStatus {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Situação da liquidação", en: "Settlement status" }
  // REVIEW [2026-12-15] Base do shape: máquina de estados.
  base: state
  // REVIEW [2026-12-15] Estado inicial é Pending.
  initial: Pending

  // REVIEW [2026-12-15] Estado em que a liquidação aguarda aprovação.
  value Pending {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Pendente", en: "Pending" }
    // REVIEW [2026-12-15] Ícone do estado no quadro e na linha do tempo.
    icon: status.pending
    // REVIEW [2026-12-15] Ordem de exibição no fluxo de estados.
    ordinal: 10

    // REVIEW [2026-12-15] Transição para Approved após a aprovação financeira.
    transition Approved {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Liquidação aprovada", en: "Settlement approved" }
      // REVIEW [2026-12-15] Dados transportados pelo evento de aprovação.
      payload {
        // REVIEW [2026-12-15] Instante em que a liquidação foi aprovada.
        approvedAt: DateTime { title: { pt-BR: "Aprovada em", en: "Approved at" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado em que a liquidação foi aprovada e aguarda pagamento.
  value Approved {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Aprovada", en: "Approved" }
    // REVIEW [2026-12-15] Ícone do estado no quadro e na linha do tempo.
    icon: status.approved
    // REVIEW [2026-12-15] Ordem de exibição no fluxo de estados.
    ordinal: 20

    // REVIEW [2026-12-15] Transição para Paid após a confirmação do pagamento.
    transition Paid {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Liquidação paga", en: "Settlement paid" }
      // REVIEW [2026-12-15] Dados transportados pelo evento de pagamento.
      payload {
        // REVIEW [2026-12-15] Instante em que o pagamento ocorreu.
        paidAt: DateTime { title: { pt-BR: "Paga em", en: "Paid at" } }
      }
    }

    // REVIEW [2026-12-15] Transição de volta para Pending, nomeada Reversed.
    transition Pending {
      // REVIEW [2026-12-15] Nome do evento publicado no estorno.
      event: Reversed
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Liquidação estornada", en: "Settlement reversed" }
      // REVIEW [2026-12-15] Dados transportados pelo evento de estorno.
      payload {
        // REVIEW [2026-12-15] Instante em que o estorno ocorreu.
        reversedAt: DateTime { title: { pt-BR: "Estornada em", en: "Reversed at" } }
        // REVIEW [2026-12-15] Motivo informado para o estorno.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado em que a liquidação foi paga.
  value Paid {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Paga", en: "Paid" }
    // REVIEW [2026-12-15] Ícone do estado no quadro e na linha do tempo.
    icon: status.paid
    // REVIEW [2026-12-15] Ordem de exibição no fluxo de estados.
    ordinal: 30

    // REVIEW [2026-12-15] Transição de volta para Pending, nomeada Reversed.
    transition Pending {
      // REVIEW [2026-12-15] Nome do evento publicado no estorno.
      event: Reversed
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Liquidação estornada", en: "Settlement reversed" }
      // REVIEW [2026-12-15] Dados transportados pelo evento de estorno.
      payload {
        // REVIEW [2026-12-15] Instante em que o estorno ocorreu.
        reversedAt: DateTime { title: { pt-BR: "Estornada em", en: "Reversed at" } }
        // REVIEW [2026-12-15] Motivo informado para o estorno.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
}

// REVIEW [2026-12-15] Classificação que define as formas de pagamento aceitas.
shape PaymentMethod {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Forma de pagamento", en: "Payment method" }
  // REVIEW [2026-12-15] Base do shape: classificação fechada de valores.
  base: classification

  // REVIEW [2026-12-15] Pagamento por transferência bancária.
  value BankTransfer {
    // REVIEW [2026-12-15] Título exibido no formulário e nos filtros.
    title: { pt-BR: "Transferência bancária", en: "Bank transfer" }
    // REVIEW [2026-12-15] Ícone exibido junto ao valor.
    icon: payment.transfer
    // REVIEW [2026-12-15] Ordem de exibição na lista de valores.
    ordinal: 10
  }
  // REVIEW [2026-12-15] Pagamento instantâneo por Pix.
  value Pix {
    // REVIEW [2026-12-15] Título exibido no formulário e nos filtros.
    title: { pt-BR: "Pix", en: "Pix" }
    // REVIEW [2026-12-15] Ícone exibido junto ao valor.
    icon: payment.pix
    // REVIEW [2026-12-15] Ordem de exibição na lista de valores.
    ordinal: 20
  }
  // REVIEW [2026-12-15] Pagamento por cheque.
  value Check {
    // REVIEW [2026-12-15] Título exibido no formulário e nos filtros.
    title: { pt-BR: "Cheque", en: "Check" }
    // REVIEW [2026-12-15] Ícone exibido junto ao valor.
    icon: payment.check
    // REVIEW [2026-12-15] Ordem de exibição na lista de valores.
    ordinal: 30
  }
}
