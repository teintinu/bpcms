// REVIEW [2026-12-15] service: example.com/services/claims
// REVIEW [2026-12-15] Declara o serviço Claims: identidade, versão e dependências do domínio de sinistros.
service "example.com/services/claims" {
  // REVIEW [2026-12-15] Título exibido no builder e no catálogo de serviços.
  title: { pt-BR: "Sinistros", en: "Claims" }
  locales: [ "pt-BR", "en" ] // REVIEW [2026-12-18] Idiomas suportados pelo serviço; o primeiro é o default do I18N em forma de string.
  // REVIEW [2026-12-15] Versão do artefato Service; releases e diffs comparam este valor.
  // REVIEW [2026-12-15] Área de negócio responsável pela manutenção do serviço.
  owner: "Claims"

  // REVIEW [2026-12-15] Dependências de outros serviços usadas pelos artefatos deste serviço.
  imports {
    // REVIEW [2026-12-15] Importa medidas e constantes padrão (std.Money etc.) sob o alias std.
    service "bpcms.org/std" as std
    // REVIEW [2026-12-15] Importa o serviço de identidade para referenciar Identity.User.
    service "example.com/services/identity" as Identity
  }
}
