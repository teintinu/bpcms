// REVIEW [2026-12-15] service: example.com/services/claims

// REVIEW [2026-12-15] Tabela operacional que lista as liquidações para acompanhamento financeiro.
view SettlementsTable {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Liquidações", en: "Settlements" }
  // REVIEW [2026-12-15] Tipo da view: tabela.
  type: table
  // REVIEW [2026-12-15] Documento exibido pela view.
  source: Settlement
  // REVIEW [2026-12-15] Papéis que podem abrir a tabela.
  roles: [FinanceAnalyst, Manager]

  // REVIEW [2026-12-15] Colunas exibidas em cada linha.
  columns { number; amount; method; status; approvedAt; paidAt }
  // REVIEW [2026-12-15] Filtros disponíveis para recortar a lista.
  filters { status; method; period }
  // REVIEW [2026-12-15] Quantidade de linhas carregadas por página.
  pagination: 50

  // REVIEW [2026-12-15] Ações disparadas a partir da tabela.
  actions {
    // REVIEW [2026-12-15] Aprova a liquidação selecionada.
    approve -> Settlement.approve
    // REVIEW [2026-12-15] Paga a liquidação selecionada.
    pay -> Settlement.pay
    // REVIEW [2026-12-15] Estorna a liquidação com o motivo informado.
    reverse -> Settlement.reverse(reason)
  }
}
