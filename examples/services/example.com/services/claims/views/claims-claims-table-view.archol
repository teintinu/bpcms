// REVIEW [2026-12-15] service: example.com/services/claims

// REVIEW [2026-12-15] Tabela operacional que lista os sinistros para triagem e análise.
view ClaimsTable {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Sinistros", en: "Claims" }
  // REVIEW [2026-12-15] Tipo da view: tabela.
  type: table
  // REVIEW [2026-12-15] Documento exibido pela view.
  source: Claim
  // REVIEW [2026-12-15] Papéis que podem abrir a tabela.
  roles: [Clerk, Adjuster, FraudAnalyst, FinanceAnalyst, Manager]

  // REVIEW [2026-12-15] Colunas exibidas em cada linha.
  columns { number; claimant; type; amount; status; openedAt }
  // REVIEW [2026-12-15] Filtros disponíveis para recortar a lista.
  filters { status; type; period; coverage }
  // REVIEW [2026-12-15] Quantidade de linhas carregadas por página.
  pagination: 50

  // REVIEW [2026-12-15] Ações disparadas a partir da tabela.
  actions {
    // REVIEW [2026-12-15] Abre o detalhe do sinistro selecionado.
    open -> ClaimDetail
    // REVIEW [2026-12-15] Executa a triagem com os parâmetros do formulário.
    triage -> Claim.triage(coveredNow, claimType, assignedAdjuster)
    // REVIEW [2026-12-15] Executa a recusa com o motivo informado.
    reject -> Claim.reject(reason)
  }
}
