// REVIEW [2026-12-15] service: example.com/services/claims

// REVIEW [2026-12-15] Quadro kanban que agrupa sinistros por situação para gestão visual.
view ClaimsKanban {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Quadro de sinistros", en: "Claims board" }
  // REVIEW [2026-12-15] Tipo da view: quadro kanban.
  type: kanban
  // REVIEW [2026-12-15] Documento exibido pelo quadro.
  source: Claim
  // REVIEW [2026-12-15] Papéis que podem abrir o quadro.
  roles: [Clerk, Adjuster, Manager]
  // REVIEW [2026-12-15] Agrupa os cartões pela situação do sinistro.
  groupBy: status

  // REVIEW [2026-12-15] Colunas exibidas em cada cartão resumido.
  columns { number; amount; type }
  // REVIEW [2026-12-15] Campos exibidos no cartão do quadro.
  card { number; amount; adjuster }
  // REVIEW [2026-12-15] Filtra o quadro para os sinistros do usuário atual.
  filter { adjuster = currentUser }

  // REVIEW [2026-12-15] Ações disparadas a partir do quadro.
  actions {
    // REVIEW [2026-12-15] Abre o detalhe do sinistro selecionado.
    open -> ClaimDetail
  }
}
