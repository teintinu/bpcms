// REVIEW [2026-12-15] service: example.com/services/claims

// REVIEW [2026-12-15] View de andamento derivada da instância do processo de liquidação.
view ClaimProgress {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Andamento do sinistro", en: "Claim progress" }
  // REVIEW [2026-12-15] Tipo da view: uma tela de andamento de processo.
  type: process
  // REVIEW [2026-12-15] Processo cujo andamento esta view exibe.
  process: ClaimSettlement
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [Clerk, Adjuster, FinanceAnalyst, Manager, Policyholder]

  // REVIEW [2026-12-15] Seções fixas exibidas na tela de andamento.
  sections { current; participants; history; deadlines; subprocesses; documents; milestones; next }
}
