// REVIEW [2026-12-15] service: example.com/services/claims

// REVIEW [2026-12-15] Tela de detalhe que reúne dados, seções e ações do sinistro.
view ClaimDetail {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Detalhe do sinistro", en: "Claim detail" }
  // REVIEW [2026-12-15] Tipo da view: detalhe de documento.
  type: detail
  // REVIEW [2026-12-15] Documento exibido pela view.
  document: Claim
  // REVIEW [2026-12-15] Papéis que podem abrir o detalhe.
  roles: [Clerk, Adjuster, FraudAnalyst, FinanceAnalyst, Manager, Policyholder]

  // REVIEW [2026-12-15] Seções exibidas na tela de detalhe.
  sections { summary; coverage; evidence; settlement; timeline }

  // REVIEW [2026-12-15] Ações disponíveis no detalhe do sinistro.
  actions {
    // REVIEW [2026-12-15] Inicia a análise do sinistro.
    startReview -> Claim.startReview
    // REVIEW [2026-12-15] Aprova o sinistro com o valor informado.
    approve -> Claim.approve(approvedTotal)
    // REVIEW [2026-12-15] Recusa o sinistro com o motivo informado.
    reject -> Claim.reject(reason)
    // REVIEW [2026-12-15] Abre o andamento do processo do sinistro.
    open -> ClaimProgress
  }
}
