// REVIEW [2026-12-15] service: example.com/services/claims

// REVIEW [2026-12-15] Inbox com as tarefas de sinistro atribuídas ao usuário atual.
view ClaimsWork {
  // REVIEW [2026-12-15] Título exibido na navegação da inbox.
  title: { pt-BR: "Minhas tarefas de sinistro", en: "My claim work" }
  // REVIEW [2026-12-15] Tipo da view: caixa de trabalho.
  type: inbox
  // REVIEW [2026-12-15] Papéis que operam a inbox.
  roles: [Clerk, Adjuster, FraudAnalyst]
  // REVIEW [2026-12-15] Restringe a lista às tarefas do próprio usuário.
  scope: mine
  // REVIEW [2026-12-15] Agrupa as tarefas pelo processo de origem.
  groupBy: process

  // REVIEW [2026-12-15] Colunas exibidas em cada tarefa.
  columns { title; subject; role; dueAt; priority }
}
