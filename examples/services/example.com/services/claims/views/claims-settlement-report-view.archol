// REVIEW [2026-12-15] service: example.com/services/claims

// REVIEW [2026-12-15] Relatório de liquidações com recortes e exportação.
view SettlementReport {
  // REVIEW [2026-12-15] Título exibido na navegação do relatório.
  title: { pt-BR: "Relatório de liquidações", en: "Settlement report" }
  // REVIEW [2026-12-15] Tipo da view: relatório analítico.
  type: report
  // REVIEW [2026-12-15] Documentos consultados pelas métricas.
  sources: [Claim, Settlement]
  // REVIEW [2026-12-15] Papéis que podem abrir o relatório.
  roles: [Manager, FinanceAnalyst]

  // REVIEW [2026-12-15] Filtros disponíveis para recortar o relatório.
  filters { status; type; method; period }
  // REVIEW [2026-12-15] Métricas calculadas sobre os documentos de origem.
  metrics {
    // REVIEW [2026-12-15] Total liquidado por forma de pagamento.
    settledAmount: sum(Settlement.amount) where Settlement.status == Paid by method
    // REVIEW [2026-12-15] Contagem de sinistros recusados por tipo.
    rejectedClaims: count(Claim) where Claim.status == Rejected by type
    // REVIEW [2026-12-15] Média dos valores aprovados nos sinistros pagos.
    averageApproved: avg(Claim.approvedAmount) where Claim.status == Paid
  }
  // REVIEW [2026-12-15] Moeda usada na exibição dos valores monetários.
  units { settledAmount: BRL; averageApproved: BRL }
  // REVIEW [2026-12-15] Janela de tolerância de dados antes de recarregar.
  freshness: 1h
  // REVIEW [2026-12-15] Formatos disponíveis para exportação do relatório.
  export: [pdf, csv]
}
