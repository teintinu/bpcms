// REVIEW [2026-12-15] service: example.com/services/claims

// REVIEW [2026-12-15] Mensagem que instrui o pagamento da liquidação ao setor financeiro.
message PaymentInstruction {
  // REVIEW [2026-12-15] Título exibido na inbox e no histórico.
  title: { pt-BR: "Instrução de pagamento", en: "Payment instruction" }
  // REVIEW [2026-12-15] Documento ao qual a mensagem se refere.
  about: Claim

  // REVIEW [2026-12-15] Dados transportados pela mensagem.
  payload {
    // REVIEW [2026-12-15] Número da liquidação a pagar.
    settlementNumber: string { title: { pt-BR: "Liquidação", en: "Settlement" } }
    // REVIEW [2026-12-15] Valor a ser pago.
    amount: std.Money { title: { pt-BR: "Valor", en: "Amount" } }
  }
}
