// REVIEW [2026-12-15] service: example.com/services/claims

// REVIEW [2026-12-15] Mensagem que confirma ao processo o pagamento realizado.
message PaymentConfirmation {
  // REVIEW [2026-12-15] Título exibido na inbox e no histórico.
  title: { pt-BR: "Confirmação de pagamento", en: "Payment confirmation" }
  // REVIEW [2026-12-15] Documento ao qual a mensagem se refere.
  about: Claim

  // REVIEW [2026-12-15] Dados transportados pela mensagem.
  payload {
    // REVIEW [2026-12-15] Referência bancária do pagamento.
    reference: string { title: { pt-BR: "Referência bancária", en: "Bank reference" } }
  }
}
