// service: example.com/services/claims

// Painel operacional com indicadores agregados de sinistros e liquidações.
view ClaimsDashboard {
  // Título exibido na navegação do painel.
  title: { pt-BR: "Painel de sinistros", en: "Claims dashboard" }
  // Tipo da view: painel com métricas.
  type: dashboard
  // Documentos consultados pelas métricas.
  sources: [Claim, Settlement]
  // Papéis que podem abrir o painel.
  roles: [Manager, FinanceAnalyst]
  // Atualização em tempo real conforme os documentos mudam.
  mode: live

  // Filtros disponíveis para recortar os indicadores.
  filters { status; type; period }
  // Métricas calculadas sobre os documentos de origem.
  metrics {
    // Sinistros ainda em andamento (nem pagos nem recusados).
    openClaims: count(Claim) where Claim.status != Paid and Claim.status != Rejected
    // Soma dos valores reclamados, ignorando os recusados.
    claimedAmount: sum(Claim.amount) where Claim.status != Rejected
    // Soma das liquidações efetivamente pagas.
    settledAmount: sum(Settlement.amount) where Settlement.status == Paid
    // Contagem de sinistros abertos na faixa de fraude alta.
    highRisk: count(Claim) where Claim.fraudBand == High and Claim.status != Rejected
  }
  // Moeda usada na exibição dos valores monetários.
  units { claimedAmount: BRL; settledAmount: BRL }
  // Janela de tolerância de dados antes de recarregar.
  freshness: 5m
}

// Inbox com as tarefas de sinistro atribuídas ao usuário atual.
view ClaimsWork {
  // Título exibido na navegação da inbox.
  title: { pt-BR: "Minhas tarefas de sinistro", en: "My claim work" }
  // Tipo da view: caixa de trabalho.
  type: inbox
  // Papéis que operam a inbox.
  roles: [Clerk, Adjuster, FraudAnalyst]
  // Restringe a lista às tarefas do próprio usuário.
  scope: mine
  // Agrupa as tarefas pelo processo de origem.
  groupBy: process

  // Colunas exibidas em cada tarefa.
  columns { title; subject; role; dueAt; priority }
}

// Relatório de liquidações com recortes e exportação.
view SettlementReport {
  // Título exibido na navegação do relatório.
  title: { pt-BR: "Relatório de liquidações", en: "Settlement report" }
  // Tipo da view: relatório analítico.
  type: report
  // Documentos consultados pelas métricas.
  sources: [Claim, Settlement]
  // Papéis que podem abrir o relatório.
  roles: [Manager, FinanceAnalyst]

  // Filtros disponíveis para recortar o relatório.
  filters { status; type; method; period }
  // Métricas calculadas sobre os documentos de origem.
  metrics {
    // Total liquidado por forma de pagamento.
    settledAmount: sum(Settlement.amount) where Settlement.status == Paid by method
    // Contagem de sinistros recusados por tipo.
    rejectedClaims: count(Claim) where Claim.status == Rejected by type
    // Média dos valores aprovados nos sinistros pagos.
    averageApproved: avg(Claim.approvedAmount) where Claim.status == Paid
  }
  // Moeda usada na exibição dos valores monetários.
  units { settledAmount: BRL; averageApproved: BRL }
  // Janela de tolerância de dados antes de recarregar.
  freshness: 1h
  // Formatos disponíveis para exportação do relatório.
  export: [pdf, csv]
}
