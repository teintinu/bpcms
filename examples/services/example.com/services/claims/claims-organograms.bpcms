// service: example.com/services/claims

// Organograma que define a estrutura de papéis e a separação de funções em sinistros.
organogram Indemnity {
  // Título exibido no builder e nos relatórios de estrutura.
  title: { pt-BR: "Organograma de sinistros", en: "Claims organogram" }

  // Relações de subordinação direta entre os papéis do serviço.
  hierarchy {
    // Ajustador responde ao gerente e o atendente responde ao ajustador.
    Manager > Adjuster > Clerk
    // O analista antifraude reporta diretamente ao gerente.
    Manager > FraudAnalyst
    // O analista financeiro reporta diretamente ao gerente.
    Manager > FinanceAnalyst
    // O segurado é atendido pelo atendente de sinistros.
    Clerk > Policyholder
  }

  // Papéis sob gestão direta do gerente de sinistros.
  Manager manages [Clerk, Adjuster, FraudAnalyst, FinanceAnalyst]
  // Delega as atribuições ao ajustador quando o gerente se ausenta por sete dias.
  Manager delegates to Adjuster when absent for 7d

  // Separação de funções: impede que a mesma pessoa aprove e pague a liquidação.
  segregation {
    // Aprovar e pagar a mesma liquidação exige pessoas diferentes.
    settlement.approve != settlement.pay
  }
}

// Papel de atendimento: registra, tria e recusa avisos de sinistro.
role Clerk {
  // Título exibido na administração de papéis.
  title: { pt-BR: "Atendente de sinistros", en: "Claims clerk" }
  // Permissões concedidas ao atendente.
  permissions: [
    claim.view, // consultar sinistros
    claim.register, // registrar aviso de sinistro
    claim.triage, // triar sinistro
    claim.reject, // recusar sinistro
    coverage.view, // consultar coberturas
    coverage.manage // manter coberturas
  ]
}

// Papel de análise: conduz a revisão, coleta evidências e aprova o sinistro.
role Adjuster {
  // Título exibido na administração de papéis.
  title: { pt-BR: "Ajustador", en: "Adjuster" }
  // Permissões concedidas ao ajustador.
  permissions: [
    claim.view, // consultar sinistros
    claim.review, // revisar sinistros
    claim.approve, // aprovar sinistros
    claim.reject, // recusar sinistros
    evidence.record, // registrar evidências
    settlement.view // consultar liquidações
  ]
}

// Papel especializado: investiga e decide sobre suspeitas de fraude.
role FraudAnalyst {
  // Título exibido na administração de papéis.
  title: { pt-BR: "Analista antifraude", en: "Fraud analyst" }
  // Permissões concedidas ao analista antifraude.
  permissions: [
    claim.view, // consultar sinistros
    fraud.review, // revisar suspeitas de fraude
    fraud.decide, // decidir sobre fraude
    evidence.record // registrar evidências
  ]
}

// Papel financeiro: aprova, paga e acompanha liquidações.
role FinanceAnalyst {
  // Título exibido na administração de papéis.
  title: { pt-BR: "Analista financeiro", en: "Finance analyst" }
  // Permissões concedidas ao analista financeiro.
  permissions: [
    claim.view, // consultar sinistros
    claim.pay, // pagar sinistros
    settlement.view, // consultar liquidações
    settlement.approve, // aprovar liquidações
    settlement.pay // pagar liquidações
  ]
}

// Papel de gestão: herda as permissões do ajustador e adiciona controles amplos.
role Manager {
  // Título exibido na administração de papéis.
  title: { pt-BR: "Gerente de sinistros", en: "Claims manager" }
  // Herda todas as permissões do papel Adjuster.
  inherits: Adjuster
  // Permissões adicionais exclusivas do gerente.
  permissions: [
    claim.reopen, // reabrir sinistros
    claim.escalate, // escalonar sinistros
    settlement.approve, // aprovar liquidações
    settlement.reverse, // estornar liquidações
    report.view // consultar relatórios
  ]
}

// Papel externo: permite ao segurado acompanhar e registrar seus próprios sinistros.
role Policyholder {
  // Título exibido na administração de papéis.
  title: { pt-BR: "Segurado", en: "Policyholder" }
  // Permissões restritas ao próprio sinistro.
  permissions: [claim.viewOwn, claim.register, claim.describe]
}
