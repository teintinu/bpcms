// REVIEW [2026-12-15] service: example.com/services/notifications

// REVIEW [2026-12-15] Forma de classificação com os canais de entrega disponíveis.
shape Channel {
  // REVIEW [2026-12-15] Rótulo da forma exibido no construtor.
  title: { pt-BR: "Canal", en: "Channel" }
  base: classification // REVIEW [2026-12-15] Base classificação: conjunto fechado de valores.
  // REVIEW [2026-12-15] Canal de correio eletrônico.
  value Email {
    // REVIEW [2026-12-15] Rótulo do valor.
    title: { pt-BR: "Correio eletrônico", en: "Email" }
    // REVIEW [2026-12-15] Ícone do contêiner de ícones do construtor (namespace channels).
    icon: channels.email
    ordinal: 10 // REVIEW [2026-12-15] Posição do valor na ordenação.
  }
  // REVIEW [2026-12-15] Canal de WhatsApp.
  value Whatsapp {
    // REVIEW [2026-12-15] Rótulo do valor.
    title: { pt-BR: "WhatsApp", en: "WhatsApp" }
    // REVIEW [2026-12-15] Ícone do serviço de notificações.
    icon: WhatsApp
    ordinal: 20 // REVIEW [2026-12-15] Posição do valor na ordenação.
  }
  // REVIEW [2026-12-15] Canal dentro do próprio aplicativo.
  value InApp {
    // REVIEW [2026-12-15] Rótulo do valor.
    title: { pt-BR: "No aplicativo", en: "In-app" }
    // REVIEW [2026-12-15] Ícone do serviço de notificações.
    icon: InApp
    ordinal: 30 // REVIEW [2026-12-15] Posição do valor na ordenação.
  }
  format: plain // REVIEW [2026-12-15] Renderização em texto simples.
}
