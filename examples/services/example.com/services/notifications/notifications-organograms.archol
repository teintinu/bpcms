// REVIEW [2026-12-15] service: example.com/services/notifications

// REVIEW [2026-12-15] Organograma do time de sucesso do cliente, dono das notificações.
organogram CustomerSuccess {
  // REVIEW [2026-12-15] Rótulo do organograma exibido no construtor.
  title: { pt-BR: "Organograma de sucesso do cliente", en: "Customer success organogram" }

  // REVIEW [2026-12-15] Estrutura hierárquica dos papéis.
  hierarchy {
    // REVIEW [2026-12-15] O gerente fica acima do agente na hierarquia.
    SuccessManager > SuccessAgent
  }

}

// REVIEW [2026-12-15] Papel operacional que atende, revisa e suprime notificações.
role SuccessAgent {
  // REVIEW [2026-12-15] Rótulo do papel exibido no construtor.
  title: { pt-BR: "Agente de sucesso do cliente", en: "Customer success agent" }
  // REVIEW [2026-12-15] Permissões de rotina: ver, revisar e suprimir notificações.
  permissions: [notification.view, notification.review, notification.suppress]
}

// REVIEW [2026-12-15] Papel de gestão, herda as permissões do agente.
role SuccessManager {
  // REVIEW [2026-12-15] Rótulo do papel exibido no construtor.
  title: { pt-BR: "Gerente de sucesso do cliente", en: "Customer success manager" }
  // REVIEW [2026-12-15] Herda todas as permissões do papel de agente.
  inherits: SuccessAgent
  // REVIEW [2026-12-15] Permissões adicionais: gerir notificações, modelos e relatórios.
  permissions: [notification.manage, notification.template.manage, report.view]
}
