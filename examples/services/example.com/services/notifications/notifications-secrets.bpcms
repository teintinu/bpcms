// service: example.com/services/notifications

// Credencial sigilosa usada na autenticação com o provedor de WhatsApp.
secret WhatsAppToken {
  // Rótulo exibido na tela de configuração de segredos.
  title: { pt-BR: "Credencial do WhatsApp", en: "WhatsApp token" }
  type: string // Segredo armazenado como texto simples e nunca reexibido.
  // Exige que o valor esteja preenchido para o serviço operar.
  required
}
