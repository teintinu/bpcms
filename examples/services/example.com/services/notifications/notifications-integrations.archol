// REVIEW [2026-12-15] service: example.com/services/notifications

// REVIEW [2026-12-15] Integração de saída de e-mail por SMTP.
integration Email {
  // REVIEW [2026-12-15] Protocolo de transporte usado pelo conector.
  protocol: smtp
  // REVIEW [2026-12-15] Host do servidor SMTP, resolvido da variável de ambiente.
  host: env.SMTP_HOST
  // REVIEW [2026-12-15] Forma de autenticação do conector.
  auth: password
  // REVIEW [2026-12-15] Remetente padrão injetado nos e-mails enviados.
  from: "no-reply@lojadojoao.com"

  // REVIEW [2026-12-15] Operações expostas pela integração.
  operations {
    // REVIEW [2026-12-15] Envia um modelo renderizado e devolve o identificador da mensagem.
    send(template: NotificationTemplate, to: Citizen.Email, data: Map): MessageId
  }
  // REVIEW [2026-12-15] Limites de uso e resiliência do conector.
  limits {
    // REVIEW [2026-12-15] Teto de 100 chamadas por minuto.
    rate: 100/min
    // REVIEW [2026-12-15] Repetição exponencial por até 5 tentativas.
    retry: exponential(5)
  }
}

// REVIEW [2026-12-15] Integração de saída de WhatsApp por webhook.
integration WhatsApp {
  // REVIEW [2026-12-15] Protocolo de chamada usado pelo conector.
  protocol: webhook
  // REVIEW [2026-12-15] URL base do provedor, resolvida da variável de ambiente.
  baseUrl: env.WHATSAPP_URL
  // REVIEW [2026-12-15] Autenticação por token (credencial WhatsAppToken).
  auth: token

  // REVIEW [2026-12-15] Operações expostas pela integração.
  operations {
    // REVIEW [2026-12-15] Envia um modelo aprovado para um telefone e devolve o identificador da mensagem.
    sendTemplate(to: Citizen.Phone, template: NotificationTemplate, data: Map): MessageId
  }
  // REVIEW [2026-12-15] Webhooks de retorno do provedor para o serviço.
  webhooks {
    // REVIEW [2026-12-15] Mapeia a situação da mensagem para a situação da notificação.
    message.status -> Notification.status
  }
}
