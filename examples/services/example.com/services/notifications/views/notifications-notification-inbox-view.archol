// REVIEW [2026-12-15] service: example.com/services/notifications

// REVIEW [2026-12-15] Caixa de entrada operacional das notificações a tratar.
view NotificationInbox {
  // REVIEW [2026-12-15] Rótulo da view exibido na navegação.
  title: { pt-BR: "Fila de notificações", en: "Notification queue" }
  // REVIEW [2026-12-15] Tipo inbox: fila de trabalho distribuída por papel.
  type: inbox
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [SuccessAgent, SuccessManager]

  scope: roles // REVIEW [2026-12-15] Escopo da fila definido pelos papéis do usuário.
  // REVIEW [2026-12-15] Filtro: mostra só itens dos papéis do usuário atual.
  filter { role in currentUser.roles }
  groupBy: process // REVIEW [2026-12-15] Agrupa a fila por processo.
  // REVIEW [2026-12-15] Colunas exibidas em cada grupo da fila.
  columns { title; subject; role; dueAt; priority }
}
