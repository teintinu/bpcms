// REVIEW [2026-12-15] service: example.com/services/notifications

// REVIEW [2026-12-15] View de detalhe de uma notificação.
view NotificationDetail {
  // REVIEW [2026-12-15] Rótulo da view exibido na navegação.
  title: { pt-BR: "Detalhe da notificação", en: "Notification detail" }
  // REVIEW [2026-12-15] Tipo detalhe: tela de um único registro.
  type: detail
  // REVIEW [2026-12-15] Documento exibido na tela.
  document: Notification
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [SuccessAgent, SuccessManager]

  // REVIEW [2026-12-15] Seções fixas exibidas na tela.
  sections { summary; delivery; timeline }

  // REVIEW [2026-12-15] Ações expostas como botões na tela.
  actions {
    // REVIEW [2026-12-15] Envia a notificação a partir do detalhe.
    send -> Notification.send
    // REVIEW [2026-12-15] Repete o envio a partir do detalhe.
    retry -> Notification.retry
    // REVIEW [2026-12-15] Suprime a notificação informando o motivo.
    suppress -> Notification.suppress(reason)
  }
}
