// REVIEW [2026-12-15] service: example.com/services/notifications

// REVIEW [2026-12-15] View kanban das notificações agrupadas por situação.
view NotificationKanban {
  // REVIEW [2026-12-15] Rótulo da view exibido na navegação.
  title: { pt-BR: "Notificações por situação", en: "Notifications by status" }
  // REVIEW [2026-12-15] Tipo kanban: quadro com colunas por agrupamento.
  type: kanban
  // REVIEW [2026-12-15] Documento que alimenta o quadro.
  source: Notification
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [SuccessAgent, SuccessManager]

  // REVIEW [2026-12-15] Agrupa os cartões pela situação da notificação.
  groupBy: status
  // REVIEW [2026-12-15] Colunas exibidas em cada coluna do quadro.
  columns { recipient; channel; sentAt }
  // REVIEW [2026-12-15] Campos exibidos no cartão.
  card { recipient; channel; status; sentAt }

  // REVIEW [2026-12-15] Ações disponíveis nos cartões.
  actions {
    // REVIEW [2026-12-15] Abre o detalhe da notificação selecionada.
    open -> NotificationDetail
  }
}
