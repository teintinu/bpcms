// REVIEW [2026-12-15] service: example.com/services/notifications

// REVIEW [2026-12-15] View tabular com todas as notificações.
view NotificationTable {
  // REVIEW [2026-12-15] Rótulo da view exibido na navegação.
  title: { pt-BR: "Notificações", en: "Notifications" }
  // REVIEW [2026-12-15] Tipo tabela: listagem paginada de registros.
  type: table
  // REVIEW [2026-12-15] Documento que alimenta a tabela.
  source: Notification
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [SuccessAgent, SuccessManager]

  // REVIEW [2026-12-15] Colunas exibidas em cada linha.
  columns { recipient; channel; status; sentAt; error }
  // REVIEW [2026-12-15] Filtros disponíveis na barra da tabela.
  filters { status; channel; period }
  pagination: 50 // REVIEW [2026-12-15] Tamanho da página da tabela.

  // REVIEW [2026-12-15] Ações disponíveis nos itens da tabela.
  actions {
    // REVIEW [2026-12-15] Abre o detalhe da notificação selecionada.
    open -> NotificationDetail
  }
}
