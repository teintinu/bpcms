// REVIEW [2026-12-15] service: example.com/services/notifications

// REVIEW [2026-12-15] Parâmetro global do serviço: remetente padrão dos e-mails enviados.
parameter FromEmail {
  // REVIEW [2026-12-15] Rótulo bilíngue exibido no construtor e na configuração.
  title: { pt-BR: "Remetente", en: "From email" }
  // REVIEW [2026-12-15] Tipo e-mail reaproveitado do serviço Citizen.
  type: Citizen.Email
  // REVIEW [2026-12-15] Endereço usado quando nenhum remetente é informado no envio.
  default: "no-reply@lojadojoao.com"
}
