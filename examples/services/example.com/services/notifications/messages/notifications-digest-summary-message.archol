// REVIEW [2026-12-15] service: example.com/services/notifications

// REVIEW [2026-12-15] Mensagem de resumo diário enviada pelo processo DailyDigest.
message DigestSummary {
  // REVIEW [2026-12-15] Rótulo da mensagem exibido no construtor.
  title: { pt-BR: "Resumo diário", en: "Daily digest" }
  // REVIEW [2026-12-15] Documento ao qual a mensagem se refere.
  about: Notification

  // REVIEW [2026-12-15] Dados carregados no envio da mensagem.
  payload {
    // REVIEW [2026-12-15] Destinatário do resumo.
    recipient: string { title: { pt-BR: "Destinatário", en: "Recipient" } }
    // REVIEW [2026-12-15] Canal de entrega do resumo.
    channel: Channel { title: { pt-BR: "Canal", en: "Channel" } }
  }
}
