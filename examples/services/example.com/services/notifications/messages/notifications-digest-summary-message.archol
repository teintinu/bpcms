// service: example.com/services/notifications

// Mensagem de resumo diário enviada pelo processo DailyDigest.
message DigestSummary {
  // Rótulo da mensagem exibido no construtor.
  title: { pt-BR: "Resumo diário", en: "Daily digest" }
  // Documento ao qual a mensagem se refere.
  about: Notification

  // Dados carregados no envio da mensagem.
  payload {
    // Destinatário do resumo.
    recipient: string { title: { pt-BR: "Destinatário", en: "Recipient" } }
    // Canal de entrega do resumo.
    channel: Channel { title: { pt-BR: "Canal", en: "Channel" } }
  }
}
