// service: example.com/services/notifications

process DailyDigest for Notification {
  title: { pt-BR: "Resumo diário", en: "Daily digest" }
  version: 1
  goal: "Enviar o resumo diário somente para quem deu opt-in"
  owner: "Customer Success"
  timezone: America/Fortaleza

  pool Company {
    internal
    lane Support { role: SuccessAgent }
  }

  pool Customer {
    external
  }

  start Daily {
    schedule: "0 7 * * *"
    select: notification.status == Queued
  }

  gateway Consent {
    if notification.consent -> Digest
    else -> Suppress
  }

  task Digest {
    lane: System
    sends: DigestSummary
    partner: Customer
    with {
      recipient: notification.recipient
      channel: notification.channel
    }
    sla: 1h
  }

  task Record {
    lane: System
    action: Notification.sendDigest
    sla: 5m
  }

  task Suppress {
    lane: Support
    form: OptOutReview
    sla: 1d
    assign: pull
  }

  end Sent {
    title: { pt-BR: "Resumo enviado", en: "Digest sent" }
    outcome: success
  }

  end Suppressed {
    title: { pt-BR: "Envio suprimido", en: "Delivery suppressed" }
    outcome: cancelled
  }

  Daily -> Consent
  Digest -> Record
  Record -> Sent
  Suppress.suppress -> Suppressed
}

form OptOutReview {
  title: { pt-BR: "Revisar opt-out", en: "Review opt-out" }
  document: Notification

  fields {
    recipient
    channel
    reason: string {
      title: { pt-BR: "Motivo da supressão", en: "Suppression reason" }
      maxLength: 500
      required
    }
  }

  actions {
    suppress { calls: Notification.suppress(reason) }
  }
}

view DigestProgress {
  title: { pt-BR: "Andamento do resumo", en: "Digest progress" }
  type: process
  process: DailyDigest
  roles: [SuccessAgent, SuccessManager]

  sections { current; participants; history; deadlines; documents; milestones; next }
}
