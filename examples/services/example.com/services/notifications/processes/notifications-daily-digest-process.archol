// service: example.com/services/notifications
// Process: sintaxe atual (DSL_REFERENCE.md §4)

// Processo agendado que envia o resumo diário das notificações na fila.
process DailyDigest(notification: Notification) {
  // Rótulo do processo no builder, na inbox e no histórico.
  title: { pt-BR: "Resumo diário", en: "Daily digest" }
  version: 1 // Versão do artefato Process; diff e release comparam.
  // Objetivo de negócio do processo, usado na revisão.
  goal: {
    // Texto do objetivo em português.
    pt-BR: "Enviar o resumo diário somente para quem deu opt-in"
  }

  schedule: "0 7 * * *" // Cria as instâncias todos os dias às 7h (cron).
  fanOut: Notification where status == Queued // Uma instância por notificação na fila.
  key: notification // Chave de identidade, correlação e dedup da instância.

  // Só envia o resumo quando o destinatário deu consentimento.
  if (notification.consent) {
    // Envia a mensagem de resumo com os dados da notificação.
    send DigestSummary {
      // Chave de correlação da mensagem com a instância.
      key: notification
      // Dados que preenchem o payload da mensagem.
      with {
        // Destinatário do resumo.
        recipient: notification.recipient
        // Canal usado no envio.
        channel: notification.channel
      }
    }

    // Registra o envio do resumo na notificação.
    Notification.sendDigest()
    // Encerra a instância no desfecho de sucesso.
    return Sent
  }

  // Sem consentimento: abre o form para o agente revisar o opt-out.
  OptOutReview.show({ notification })
  // Encerra a instância no desfecho de supressão.
  return Suppressed

  // Desfecho de sucesso do caso.
  end Sent {
    // Título exibido no histórico e nos filtros.
    title: { pt-BR: "Resumo enviado", en: "Digest sent" }
    // Classificação do desfecho para KPI.
    outcome: success
  }

  // Desfecho de cancelamento do caso.
  end Suppressed {
    // Título exibido no histórico.
    title: { pt-BR: "Envio suprimido", en: "Delivery suppressed" }
    // Classificação do desfecho para KPI.
    outcome: cancelled
  }
}

// Form de revisão aberto quando o envio é barrado por falta de consentimento.
form OptOutReview {
  // Rótulo exibido na inbox e no histórico.
  title: { pt-BR: "Revisar opt-out", en: "Review opt-out" }
  // Documento-sujeito do form.
  document: Notification
  // Papéis que podem atender o form.
  roles: [SuccessAgent]
  timeout: 1d // Prazo de atendimento do form.
  priority: 50 // Prioridade na fila (maior valor primeiro).
  assign: pull // Distribuição por pull: o agente puxa o caso da fila.

  // Campos exibidos no form.
  fields {
    // Destinatário da notificação.
    recipient
    // Canal da notificação.
    channel
    // Campo texto para justificar a supressão.
    reason: string {
      // Rótulo do campo.
      title: { pt-BR: "Motivo da supressão", en: "Suppression reason" }
      maxLength: 500 // Limite de 500 caracteres para a justificativa.
      // Torna o motivo obrigatório no atendimento.
      required
    }
  }

  // Ações disponíveis no form.
  actions {
    // Suprime a notificação repassando o motivo ao documento.
    suppress { calls: Notification.suppress(reason) }
  }
}
