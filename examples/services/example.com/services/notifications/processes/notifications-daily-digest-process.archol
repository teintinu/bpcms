// REVIEW [2026-12-15] service: example.com/services/notifications
// REVIEW [2026-12-15] Process: sintaxe atual (DSL_REFERENCE.md §4)

// REVIEW [2026-12-15] Processo agendado que envia o resumo diário das notificações na fila.
process DailyDigest(notification: Notification) {
  // REVIEW [2026-12-15] Rótulo do processo no builder, na inbox e no histórico.
  title: { pt-BR: "Resumo diário", en: "Daily digest" }
  version: 1 // REVIEW [2026-12-15] Versão do artefato Process; diff e release comparam.
  // REVIEW [2026-12-15] Objetivo de negócio do processo, usado na revisão.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Enviar o resumo diário somente para quem deu opt-in"
  }

  schedule: "0 7 * * *" // REVIEW [2026-12-15] Cria as instâncias todos os dias às 7h (cron).
  fanOut: Notification where status == Queued // REVIEW [2026-12-15] Uma instância por notificação na fila.
  key: notification // REVIEW [2026-12-15] Chave de identidade, correlação e dedup da instância.

  // REVIEW [2026-12-15] Só envia o resumo quando o destinatário deu consentimento.
  if (notification.consent) {
    // REVIEW [2026-12-15] Envia a mensagem de resumo com os dados da notificação.
    send DigestSummary {
      // REVIEW [2026-12-15] Chave de correlação da mensagem com a instância.
      key: notification
      // REVIEW [2026-12-15] Dados que preenchem o payload da mensagem.
      with {
        // REVIEW [2026-12-15] Destinatário do resumo.
        recipient: notification.recipient
        // REVIEW [2026-12-15] Canal usado no envio.
        channel: notification.channel
      }
    }

    // REVIEW [2026-12-15] Registra o envio do resumo na notificação.
    Notification.sendDigest()
    // REVIEW [2026-12-15] Encerra a instância no desfecho de sucesso.
    return Sent
  }

  // REVIEW [2026-12-15] Sem consentimento: abre o form para o agente revisar o opt-out.
  OptOutReview.show({ notification })
  // REVIEW [2026-12-15] Encerra a instância no desfecho de supressão.
  return Suppressed

  // REVIEW [2026-12-15] Desfecho de sucesso do caso.
  end Sent {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Resumo enviado", en: "Digest sent" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }

  // REVIEW [2026-12-15] Desfecho de cancelamento do caso.
  end Suppressed {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Envio suprimido", en: "Delivery suppressed" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: cancelled
  }
}

// REVIEW [2026-12-15] Form de revisão aberto quando o envio é barrado por falta de consentimento.
form OptOutReview {
  // REVIEW [2026-12-15] Rótulo exibido na inbox e no histórico.
  title: { pt-BR: "Revisar opt-out", en: "Review opt-out" }
  // REVIEW [2026-12-15] Documento-sujeito do form.
  document: Notification
  // REVIEW [2026-12-15] Papéis que podem atender o form.
  roles: [SuccessAgent]
  timeout: 1d // REVIEW [2026-12-15] Prazo de atendimento do form.
  priority: 50 // REVIEW [2026-12-15] Prioridade na fila (maior valor primeiro).
  assign: pull // REVIEW [2026-12-15] Distribuição por pull: o agente puxa o caso da fila.

  // REVIEW [2026-12-15] Campos exibidos no form.
  fields {
    // REVIEW [2026-12-15] Destinatário da notificação.
    recipient
    // REVIEW [2026-12-15] Canal da notificação.
    channel
    // REVIEW [2026-12-15] Campo texto para justificar a supressão.
    reason: string {
      // REVIEW [2026-12-15] Rótulo do campo.
      title: { pt-BR: "Motivo da supressão", en: "Suppression reason" }
      maxLength: 500 // REVIEW [2026-12-15] Limite de 500 caracteres para a justificativa.
      // REVIEW [2026-12-15] Torna o motivo obrigatório no atendimento.
      required
    }
  }

  // REVIEW [2026-12-15] Ações disponíveis no form.
  actions {
    // REVIEW [2026-12-15] Suprime a notificação repassando o motivo ao documento.
    suppress { calls: Notification.suppress(reason) }
  }
}
