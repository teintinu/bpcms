// REVIEW [2026-12-15] service: example.com/services/notifications

// REVIEW [2026-12-15] Modelo reutilizável de notificação, identificado por chave, canal e idioma.
document NotificationTemplate {
  // REVIEW [2026-12-15] Rótulo do documento exibido no construtor.
  title: { pt-BR: "Modelo de notificação", en: "Notification template" }
  owner: "Notifications" // REVIEW [2026-12-15] Área dona do documento.
  sync: read // REVIEW [2026-12-15] Modo de sincronização somente leitura do documento.
  // REVIEW [2026-12-15] Campos que compõem o modelo.
  fields {
    // REVIEW [2026-12-15] Identificador lógico do modelo, usado na busca.
    key: string {
      // REVIEW [2026-12-15] Rótulo do campo.
      title: { pt-BR: "Chave", en: "Key" }
      maxLength: 80 // REVIEW [2026-12-15] Tamanho máximo da chave.
      // REVIEW [2026-12-15] Expõe o campo para busca e consulta.
      lookup
      // REVIEW [2026-12-15] Exige preenchimento no cadastro.
      required
    }
    // REVIEW [2026-12-15] Canal de entrega a que o modelo se aplica.
    channel: Channel { title: { pt-BR: "Canal", en: "Channel" }, lookup }
    // REVIEW [2026-12-15] Assunto do modelo, limitado a 160 caracteres e pesquisável.
    subject: string { title: { pt-BR: "Assunto", en: "Subject" }, maxLength: 160, lookup }
    // REVIEW [2026-12-15] Corpo com o conteúdo a renderizar no envio.
    body: string { title: { pt-BR: "Conteúdo", en: "Body" } }
    // REVIEW [2026-12-15] Idioma do modelo, pesquisável para seleção de variante.
    locale: LocaleTag { title: { pt-BR: "Idioma", en: "Locale" }, lookup }
  }

  // REVIEW [2026-12-15] Índices de consulta e unicidade.
  indexes {
    // REVIEW [2026-12-15] Um único modelo por combinação de chave, canal e idioma.
    uniqueKey: [key, channel, locale] unique
  }

  // REVIEW [2026-12-15] Carga inicial de modelos prontos no ambiente.
  seed {
    // REVIEW [2026-12-15] Modelo de boas-vindas por e-mail em português.
    Welcome {
      // REVIEW [2026-12-15] Chave usada para localizar o modelo.
      key: "welcome"
      // REVIEW [2026-12-15] Canal de entrega do modelo.
      channel: Email
      // REVIEW [2026-12-15] Assunto exibido ao destinatário.
      subject: "Bem-vindo"
      // REVIEW [2026-12-15] Corpo da mensagem de boas-vindas.
      body: "Sua conta foi criada"
      // REVIEW [2026-12-15] Idioma do modelo semeado.
      locale: PtBr
    }
  }

  // REVIEW [2026-12-15] Ações que alteram o modelo.
  actions {
    // REVIEW [2026-12-15] Cria um novo modelo para a chave, o canal e o idioma informados.
    create(key: string, channel: Channel, locale: LocaleTag){
      // REVIEW [2026-12-15] Rótulo da action no construtor.
      title: { pt-BR: "Criar modelo", en: "Create template" }
      // REVIEW [2026-12-15] Só o gerente pode criar modelos.
      roles: [SuccessManager]
    }
    // REVIEW [2026-12-15] Atualiza assunto e corpo de um modelo existente.
    update(subject: string, body: string){
      // REVIEW [2026-12-15] Rótulo da action no construtor.
      title: { pt-BR: "Atualizar", en: "Update" }
      // REVIEW [2026-12-15] Só o gerente pode atualizar modelos.
      roles: [SuccessManager]
    }
  }
}

// REVIEW [2026-12-15] Forma de classificação com os idiomas suportados pelos modelos.
shape LocaleTag {
  // REVIEW [2026-12-15] Rótulo da forma exibido no construtor.
  title: { pt-BR: "Idioma", en: "Locale" }
  base: classification // REVIEW [2026-12-15] Base classificação: conjunto fechado de valores.
  // REVIEW [2026-12-15] Idioma português do Brasil.
  value PtBr {
    // REVIEW [2026-12-15] Rótulo do valor.
    title: { pt-BR: "Português (Brasil)", en: "Portuguese (Brazil)" }
    // REVIEW [2026-12-15] Ícone do serviço de notificações.
    icon: LocalePtBr
    ordinal: 10 // REVIEW [2026-12-15] Posição do valor na ordenação.
  }
  // REVIEW [2026-12-15] Idioma inglês dos EUA.
  value EnUs {
    // REVIEW [2026-12-15] Rótulo do valor.
    title: { pt-BR: "Inglês (EUA)", en: "English (US)" }
    // REVIEW [2026-12-15] Ícone do serviço de notificações.
    icon: LocaleEnUs
    ordinal: 20 // REVIEW [2026-12-15] Posição do valor na ordenação.
  }
  format: plain // REVIEW [2026-12-15] Renderização em texto simples.
}

// REVIEW [2026-12-15] Form de edição do conteúdo de um modelo de notificação.
form TemplateEditor {
  // REVIEW [2026-12-15] Rótulo exibido na inbox e no histórico.
  title: { pt-BR: "Editor de modelo", en: "Template editor" }
  // REVIEW [2026-12-15] Documento-sujeito do form.
  document: NotificationTemplate

  // REVIEW [2026-12-15] Campos editáveis no form.
  fields {
    // REVIEW [2026-12-15] Chave do modelo.
    key
    // REVIEW [2026-12-15] Canal do modelo.
    channel
    // REVIEW [2026-12-15] Assunto do modelo.
    subject
    // REVIEW [2026-12-15] Corpo do modelo.
    body
  }

  // REVIEW [2026-12-15] Ações disponíveis no form.
  actions {
    // REVIEW [2026-12-15] Salva assunto e corpo e mantém o usuário no form.
    save { calls: NotificationTemplate.update(subject, body); stay }
  }
}
