// REVIEW [2026-12-15] service: example.com/services/notifications

// REVIEW [2026-12-15] Documento que representa cada notificação, do enfileiramento à leitura.
document Notification {
  // REVIEW [2026-12-15] Rótulo do documento exibido no construtor.
  title: { pt-BR: "Notificação", en: "Notification" }
  sync: live // REVIEW [2026-12-15] Sincronização em tempo real entre cliente e servidor.

  // REVIEW [2026-12-15] Campos que compõem a notificação.
  fields {
    // REVIEW [2026-12-15] Modelo usado para renderizar a mensagem.
    template: NotificationTemplate {
      // REVIEW [2026-12-15] Rótulo do campo.
      title: { pt-BR: "Modelo", en: "Template" }
    }
    // REVIEW [2026-12-15] Destinatário do envio, pesquisável na tabela.
    recipient: string { title: { pt-BR: "Destinatário", en: "Recipient" }, lookup }
    // REVIEW [2026-12-15] Canal de entrega da notificação.
    channel: Channel { title: { pt-BR: "Canal", en: "Channel" }, lookup }
    // REVIEW [2026-12-15] Situação atual no ciclo de vida.
    status: NotificationStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    // REVIEW [2026-12-15] Registra se o destinatário consentiu com o envio.
    consent: boolean { title: { pt-BR: "Consentimento", en: "Consent" } }
    // REVIEW [2026-12-15] Instante em que a notificação foi enviada.
    sentAt: DateTime { title: { pt-BR: "Enviado em", en: "Sent at" } }
    // REVIEW [2026-12-15] Instante em que a notificação foi lida.
    readAt: DateTime { title: { pt-BR: "Lida em", en: "Read at" } }
    // REVIEW [2026-12-15] Mensagem de erro da última tentativa de envio.
    error: string { title: { pt-BR: "Erro", en: "Error" } }
    // REVIEW [2026-12-15] Motivo registrado quando o envio é suprimido.
    suppressionReason: string { title: { pt-BR: "Motivo da supressão", en: "Suppression reason" } }
  }

  // REVIEW [2026-12-15] Índices de consulta por situação e por destinatário.
  indexes {
    // REVIEW [2026-12-15] Consulta por situação, ordenada pela data de envio.
    byStatus: [status, sentAt] range
    // REVIEW [2026-12-15] Consulta por destinatário, ordenada pela data de envio.
    byRecipient: [recipient, sentAt] range
  }


  // REVIEW [2026-12-15] Ações que mudam a situação da notificação.
  actions {
    // REVIEW [2026-12-15] Marca a notificação como enviada.
    send(){
      // REVIEW [2026-12-15] Rótulo da action no construtor.
      title: { pt-BR: "Enviar", en: "Send" }
      // REVIEW [2026-12-15] Quem pode executar a action.
      roles: [SuccessAgent]

      // REVIEW [2026-12-15] Transição para a situação Sent.
      to: status.Sent

      // REVIEW [2026-12-15] Efeitos aplicados na transição.
      {
        // REVIEW [2026-12-15] Carimba a data/hora atual do envio.
        sentAt = now()
      }
    }

    // REVIEW [2026-12-15] Registra falha de entrega com o motivo informado.
    fail(reason: string){
      // REVIEW [2026-12-15] Rótulo da action no construtor.
      title: { pt-BR: "Registrar falha", en: "Record failure" }
      // REVIEW [2026-12-15] Quem pode executar a action.
      roles: [SuccessAgent]

      // REVIEW [2026-12-15] Transição para a situação Failed.
      to: status.Failed

      // REVIEW [2026-12-15] Efeitos aplicados na transição.
      {
        // REVIEW [2026-12-15] Guarda a mensagem de erro recebida.
        error = reason
      }
    }

    // REVIEW [2026-12-15] Reenfileira a notificação para uma nova tentativa de envio.
    retry(){
      // REVIEW [2026-12-15] Rótulo da action no construtor.
      title: { pt-BR: "Repetir", en: "Retry" }
      // REVIEW [2026-12-15] Quem pode executar a action.
      roles: [SuccessAgent]

      // REVIEW [2026-12-15] Transição de volta para a situação Queued.
      to: status.Queued
      // REVIEW [2026-12-15] Emite o evento Retried com o instante da nova tentativa.
      emits { at: now() }
    }

    // REVIEW [2026-12-15] Marca a notificação como lida.
    markRead(){
      // REVIEW [2026-12-15] Rótulo da action no construtor.
      title: { pt-BR: "Marcar como lida", en: "Mark as read" }
      // REVIEW [2026-12-15] Quem pode executar a action.
      roles: [SuccessAgent]

      // REVIEW [2026-12-15] Transição para a situação Read.
      to: status.Read

      // REVIEW [2026-12-15] Efeitos aplicados na transição.
      {
        // REVIEW [2026-12-15] Carimba a data/hora da leitura.
        readAt = now()
      }
    }

    // REVIEW [2026-12-15] Envia o resumo diário desta notificação.
    sendDigest(){
      // REVIEW [2026-12-15] Rótulo da action no construtor.
      title: { pt-BR: "Enviar resumo", en: "Send digest" }
      // REVIEW [2026-12-15] Quem pode executar a action.
      roles: [SuccessAgent]

      // REVIEW [2026-12-15] Transição para a situação Sent.
      to: status.Sent

      // REVIEW [2026-12-15] Efeitos aplicados na transição.
      {
        // REVIEW [2026-12-15] Carimba a data/hora do envio do resumo.
        sentAt = now()
      }
    }

    // REVIEW [2026-12-15] Suprime o envio e registra o motivo informado.
    suppress(reason: string){
      // REVIEW [2026-12-15] Rótulo da action no construtor.
      title: { pt-BR: "Suprimir", en: "Suppress" }
      // REVIEW [2026-12-15] Quem pode executar a action.
      roles: [SuccessAgent]

      // REVIEW [2026-12-15] Transição para a situação Suppressed.
      to: status.Suppressed

      // REVIEW [2026-12-15] Validação: exige motivo com ao menos 5 caracteres.
      rule reason.length >= 5 {
        // REVIEW [2026-12-15] Mensagem de erro exibida em português.
        pt-BR: "Informe o motivo da supressão"
        // REVIEW [2026-12-15] Mensagem de erro exibida em inglês.
        en: "Enter the suppression reason"
      }

      // REVIEW [2026-12-15] Efeitos aplicados na transição.
      {
        // REVIEW [2026-12-15] Guarda o motivo informado pelo agente.
        suppressionReason = reason
      }
    }

    // REVIEW [2026-12-15] Action de repetição em lote das falhas de envio.
    retryFailed(){
      // REVIEW [2026-12-15] Rótulo da action no construtor.
      title: { pt-BR: "Repetir falhas", en: "Retry failed" }
      // REVIEW [2026-12-15] Quem pode executar a action.
      roles: [SuccessAgent]
    }
  }

  // REVIEW [2026-12-15] Invariante: notificação enviada precisa ter data de envio.
  rule status == Sent implies sentAt != null {
    // REVIEW [2026-12-15] Mensagem de erro exibida em português.
    pt-BR: "Informe a data de envio"
    // REVIEW [2026-12-15] Mensagem de erro exibida em inglês.
    en: "Enter the sent date"
  }
}

// REVIEW [2026-12-15] Forma de estado do ciclo de vida da notificação.
shape NotificationStatus {
  // REVIEW [2026-12-15] Rótulo da forma exibido no construtor.
  title: { pt-BR: "Situação da notificação", en: "Notification status" }
  base: state // REVIEW [2026-12-15] Base estado: máquina de estados com transições.
  initial: Queued // REVIEW [2026-12-15] Situação inicial de toda notificação criada.
  // REVIEW [2026-12-15] Situação "na fila", aguardando envio.
  value Queued {
    // REVIEW [2026-12-15] Rótulo do valor.
    title: { pt-BR: "Na fila", en: "Queued" }
    // REVIEW [2026-12-15] Ícone do serviço de notificações.
    icon: Queued
    ordinal: 10 // REVIEW [2026-12-15] Posição do valor na ordenação.

    // REVIEW [2026-12-15] Transição para Sent, disparada pelo envio.
    transition Sent {
      // REVIEW [2026-12-15] Título da transição exibido no histórico.
      title: { pt-BR: "Notificação enviada", en: "Notification sent" }
      // REVIEW [2026-12-15] Dados carregados na transição.
      payload {
        // REVIEW [2026-12-15] Instante do envio carregado pela transição.
        sentAt: DateTime { title: { pt-BR: "Enviada em", en: "Sent at" } }
      }
    }

    // REVIEW [2026-12-15] Transição para Failed, disparada por falha de entrega.
    transition Failed {
      // REVIEW [2026-12-15] Título da transição exibido no histórico.
      title: { pt-BR: "Falha no envio", en: "Delivery failed" }
      // REVIEW [2026-12-15] Dados carregados na transição.
      payload {
        // REVIEW [2026-12-15] Mensagem de erro carregada pela transição.
        error: string { title: { pt-BR: "Erro", en: "Error" } }
      }
    }

    // REVIEW [2026-12-15] Transição para Sent disparada pelo evento Digested.
    transition Sent {
      // REVIEW [2026-12-15] Evento nomeado que dispara esta transição.
      event: Digested
      // REVIEW [2026-12-15] Título da transição exibido no histórico.
      title: { pt-BR: "Resumo enviado", en: "Digest sent" }
      // REVIEW [2026-12-15] Dados carregados na transição.
      payload {
        // REVIEW [2026-12-15] Instante do envio carregado pela transição.
        sentAt: DateTime { title: { pt-BR: "Enviado em", en: "Sent at" } }
      }
    }

    // REVIEW [2026-12-15] Transição para Suppressed, disparada pela supressão.
    transition Suppressed {
      // REVIEW [2026-12-15] Título da transição exibido no histórico.
      title: { pt-BR: "Notificação suprimida", en: "Notification suppressed" }
      // REVIEW [2026-12-15] Dados carregados na transição.
      payload {
        // REVIEW [2026-12-15] Motivo da supressão carregado pela transição.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Situação "enviada".
  value Sent {
    // REVIEW [2026-12-15] Rótulo do valor.
    title: { pt-BR: "Enviada", en: "Sent" }
    // REVIEW [2026-12-15] Ícone do serviço de notificações.
    icon: Sent
    ordinal: 20 // REVIEW [2026-12-15] Posição do valor na ordenação.

    // REVIEW [2026-12-15] Transição para Read, disparada pela leitura.
    transition Read {
      // REVIEW [2026-12-15] Título da transição exibido no histórico.
      title: { pt-BR: "Notificação lida", en: "Notification read" }
      // REVIEW [2026-12-15] Dados carregados na transição.
      payload {
        // REVIEW [2026-12-15] Instante da leitura carregado pela transição.
        readAt: DateTime { title: { pt-BR: "Lida em", en: "Read at" } }
      }
    }
  }
  // REVIEW [2026-12-15] Situação "falhou".
  value Failed {
    // REVIEW [2026-12-15] Rótulo do valor.
    title: { pt-BR: "Falhou", en: "Failed" }
    // REVIEW [2026-12-15] Ícone do serviço de notificações.
    icon: Failed
    ordinal: 30 // REVIEW [2026-12-15] Posição do valor na ordenação.

    // REVIEW [2026-12-15] Transição para Queued disparada pelo evento Retried.
    transition Queued {
      // REVIEW [2026-12-15] Evento nomeado que dispara esta transição.
      event: Retried
      // REVIEW [2026-12-15] Título da transição exibido no histórico.
      title: { pt-BR: "Envio repetido", en: "Delivery retried" }
      // REVIEW [2026-12-15] Dados carregados na transição.
      payload {
        // REVIEW [2026-12-15] Instante da nova tentativa carregado pela transição.
        at: DateTime { title: { pt-BR: "Em", en: "At" } }
      }
    }
  }
  // REVIEW [2026-12-15] Situação "lida".
  value Read {
    // REVIEW [2026-12-15] Rótulo do valor.
    title: { pt-BR: "Lida", en: "Read" }
    // REVIEW [2026-12-15] Ícone do serviço de notificações.
    icon: Read
    ordinal: 40 // REVIEW [2026-12-15] Posição do valor na ordenação.
  }
  // REVIEW [2026-12-15] Situação "suprimida".
  value Suppressed {
    // REVIEW [2026-12-15] Rótulo do valor.
    title: { pt-BR: "Suprimida", en: "Suppressed" }
    // REVIEW [2026-12-15] Ícone do serviço de notificações.
    icon: Suppressed
    ordinal: 50 // REVIEW [2026-12-15] Posição do valor na ordenação.
  }
  format: plain // REVIEW [2026-12-15] Renderização em texto simples.
}

// REVIEW [2026-12-15] Política que impede o envio sem consentimento do destinatário.
policy NotificationConsent {
  // REVIEW [2026-12-15] Action protegida pela política.
  appliesTo: Notification.send
  // REVIEW [2026-12-15] Condição exigida para permitir o envio.
  rule: consent == true
  // REVIEW [2026-12-15] Bloqueia a execução quando a regra não é satisfeita.
  severity: block
  // REVIEW [2026-12-15] Mensagem exibida ao usuário bloqueado.
  message: "Destinatário sem consentimento para este canal"
  // REVIEW [2026-12-15] Registra a decisão na trilha de auditoria.
  audit: true
}
