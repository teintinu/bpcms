// REVIEW [2026-12-15] service: example.com/services/procurement

// REVIEW [2026-12-15] View de listagem dos recebimentos.
view GoodsReceipts {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Recebimentos", en: "Goods receipts" }
  // REVIEW [2026-12-15] Tipo da view: tabela.
  type: table
  // REVIEW [2026-12-15] Documento que alimenta a tabela.
  source: GoodsReceipt
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [ReceivingClerk, QualityInspector, Buyer, ProcurementManager]

  // REVIEW [2026-12-15] Colunas exibidas na tabela.
  columns { number; order; expectedWeight; receivedWeight; status; receivedAt }
  // REVIEW [2026-12-15] Filtros disponíveis na tabela.
  filters { status; order }
  // REVIEW [2026-12-15] Quantidade de linhas por página.
  pagination: 50

  // REVIEW [2026-12-15] Ações disponíveis na listagem.
  actions {
    // REVIEW [2026-12-15] Abre o detalhe do recebimento selecionado.
    open -> GoodsReceiptDetail
  }
}
