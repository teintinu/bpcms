// REVIEW [2026-12-15] service: example.com/services/procurement

// REVIEW [2026-12-15] View em kanban das cotações em aberto.
view QuotationsBoard {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Cotações em aberto", en: "Open quotations" }
  // REVIEW [2026-12-15] Tipo da view: kanban.
  type: kanban
  // REVIEW [2026-12-15] Documento que alimenta o quadro.
  source: RFQ
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [Buyer, ProcurementManager]

  // REVIEW [2026-12-15] Agrupa os cartões pela situação da cotação.
  groupBy: status
  // REVIEW [2026-12-15] Colunas exibidas em cada cartão.
  columns { number; dueAt; quotedAmount }
  // REVIEW [2026-12-15] Campos mostrados no cartão compacto.
  card { number; dueAt; status }
  // REVIEW [2026-12-15] Filtra o quadro para esconder cotações já adjudicadas.
  filter { status != Awarded }
}
