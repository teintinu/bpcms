// REVIEW [2026-12-15] service: example.com/services/procurement

// REVIEW [2026-12-15] View de detalhe de um pedido de compra.
view PurchaseOrderDetail {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Detalhe do pedido de compra", en: "Purchase order detail" }
  // REVIEW [2026-12-15] Tipo da view: detalhe.
  type: detail
  // REVIEW [2026-12-15] Documento exibido no detalhe.
  document: PurchaseOrder
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [Buyer, ProcurementManager, ReceivingClerk]

  // REVIEW [2026-12-15] Seções exibidas na tela.
  sections { summary; items; timeline }
}
