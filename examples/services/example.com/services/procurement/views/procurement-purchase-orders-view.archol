// REVIEW [2026-12-15] service: example.com/services/procurement

// REVIEW [2026-12-15] View de listagem dos pedidos de compra.
view PurchaseOrders {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Pedidos de compra", en: "Purchase orders" }
  // REVIEW [2026-12-15] Tipo da view: tabela.
  type: table
  // REVIEW [2026-12-15] Documento que alimenta a tabela.
  source: PurchaseOrder
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [Buyer, ProcurementManager, ReceivingClerk]

  // REVIEW [2026-12-15] Colunas exibidas na tabela.
  columns { number; supplier; amount; status; sentAt }
  // REVIEW [2026-12-15] Filtros disponíveis na tabela.
  filters { status; supplier }
  // REVIEW [2026-12-15] Quantidade de linhas por página.
  pagination: 50

  // REVIEW [2026-12-15] Ações disponíveis na listagem.
  actions {
    // REVIEW [2026-12-15] Abre o detalhe do pedido selecionado.
    open -> PurchaseOrderDetail
    // REVIEW [2026-12-15] Envia o pedido direto da listagem.
    send -> PurchaseOrder.send
    // REVIEW [2026-12-15] Cancela o pedido direto da listagem, pedindo o motivo.
    cancel -> PurchaseOrder.cancel(cancellationReason)
  }
}
