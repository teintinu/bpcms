// service: example.com/services/procurement

// View de listagem dos pedidos de compra.
view PurchaseOrders {
  // Título exibido na navegação.
  title: { pt-BR: "Pedidos de compra", en: "Purchase orders" }
  // Tipo da view: tabela.
  type: table
  // Documento que alimenta a tabela.
  source: PurchaseOrder
  // Papéis que podem abrir a view.
  roles: [Buyer, ProcurementManager, ReceivingClerk]

  // Colunas exibidas na tabela.
  columns { number; supplier; amount; status; sentAt }
  // Filtros disponíveis na tabela.
  filters { status; supplier }
  // Quantidade de linhas por página.
  pagination: 50

  // Ações disponíveis na listagem.
  actions {
    // Abre o detalhe do pedido selecionado.
    open -> PurchaseOrderDetail
    // Envia o pedido direto da listagem.
    send -> PurchaseOrder.send
    // Cancela o pedido direto da listagem, pedindo o motivo.
    cancel -> PurchaseOrder.cancel(cancellationReason)
  }
}
