// REVIEW [2026-12-15] service: example.com/services/procurement

// REVIEW [2026-12-15] View de andamento do processo de aprovação.
view PurchaseApprovalProgress {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Andamento da aprovação de compra", en: "Purchase approval progress" }
  // REVIEW [2026-12-15] Tipo da view: andamento de processo.
  type: process
  // REVIEW [2026-12-15] Processo cujo andamento esta view exibe.
  process: PurchaseApproval
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [Requester, Buyer, Approver, ProcurementManager]

  // REVIEW [2026-12-15] Seções fixas exibidas na tela de andamento.
  sections { current; participants; history; deadlines; documents; milestones; next }
}
