// REVIEW [2026-12-15] service: example.com/services/procurement

// REVIEW [2026-12-15] Documento que representa uma solicitação de compra.
document PurchaseRequest {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Solicitação de compra", en: "Purchase request" }
  // REVIEW [2026-12-15] Versão do artefato Document; diff e release comparam.
  // REVIEW [2026-12-15] Área responsável pela manutenção do artefato.
  owner: "Procurement"
  // REVIEW [2026-12-15] Modo de sincronização do documento: leitura.
  sync: read

  // REVIEW [2026-12-15] Campos que compõem a solicitação de compra.
  fields {
    // REVIEW [2026-12-15] Número identificador da solicitação; único e consultável.
    number: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Número", en: "Number" }
      // REVIEW [2026-12-15] Limita o número a quarenta caracteres.
      maxLength: 40
      // REVIEW [2026-12-15] Impede duas solicitações com o mesmo número.
      unique
      // REVIEW [2026-12-15] Permite localizar a solicitação pelo número.
      lookup
    }
    // REVIEW [2026-12-15] Usuário que abriu a solicitação; vem do serviço de identidade.
    requester: Identity.User {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Solicitante", en: "Requester" }
      // REVIEW [2026-12-15] Permite localizar a solicitação pelo solicitante.
      lookup
    }
    // REVIEW [2026-12-15] Fornecedor escolhido para a compra.
    supplier: Supplier {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Fornecedor", en: "Supplier" }
      // REVIEW [2026-12-15] Permite localizar a solicitação pelo fornecedor.
      lookup
    }
    // REVIEW [2026-12-15] Valor total da solicitação, em moeda forte.
    amount: std.Money {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Valor", en: "Amount" }
      // REVIEW [2026-12-15] Moeda do valor solicitado.
      currency: BRL
      // REVIEW [2026-12-15] Torna o valor obrigatório no preenchimento.
      required
    }
    // REVIEW [2026-12-15] Justificativa de negócio para a compra.
    justification: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Justificativa", en: "Justification" }
      // REVIEW [2026-12-15] Limita a justificativa a quinhentos caracteres.
      maxLength: 500
      // REVIEW [2026-12-15] Torna a justificativa obrigatória no preenchimento.
      required
    }
    // REVIEW [2026-12-15] Data limite em que a compra é necessária.
    neededBy: Date {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Necessário até", en: "Needed by" }
    }
    // REVIEW [2026-12-15] Centro de custo que absorve a despesa.
    costCenter: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Centro de custo", en: "Cost center" }
      // REVIEW [2026-12-15] Limita o centro de custo a sessenta caracteres.
      maxLength: 60
    }
    // REVIEW [2026-12-15] Situação atual da solicitação no ciclo de vida.
    status: PurchaseRequestStatus {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Situação", en: "Status" }
      // REVIEW [2026-12-15] Permite localizar a solicitação pela situação.
      lookup
    }
    // REVIEW [2026-12-15] Data e hora em que a solicitação foi enviada.
    submittedAt: DateTime {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Enviada em", en: "Submitted at" }
    }
    // REVIEW [2026-12-15] Data e hora em que a solicitação foi aprovada.
    approvedAt: DateTime {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Aprovada em", en: "Approved at" }
    }
    // REVIEW [2026-12-15] Data e hora em que a solicitação foi rejeitada.
    rejectedAt: DateTime {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Rejeitada em", en: "Rejected at" }
    }
    // REVIEW [2026-12-15] Motivo que levou à rejeição da solicitação.
    rejectionReason: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Motivo da rejeição", en: "Rejection reason" }
      // REVIEW [2026-12-15] Limita o motivo a duzentos e oitenta caracteres.
      maxLength: 280
    }
    // REVIEW [2026-12-15] Data e hora em que o pedido de compra foi emitido.
    orderedAt: DateTime {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Pedido emitido em", en: "Ordered at" }
    }
    // REVIEW [2026-12-15] Pedido de compra gerado a partir desta solicitação.
    purchaseOrder: PurchaseOrder {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Pedido de compra", en: "Purchase order" }
    }
  }


  // REVIEW [2026-12-15] Ações que conduzem a solicitação pelo fluxo de aprovação e compra.
  actions {
    // REVIEW [2026-12-15] Envia a solicitação para aprovação e a move para Submitted.
    submit() {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Enviar solicitação", en: "Submit request" }
      // REVIEW [2026-12-15] Papéis autorizados a enviar a solicitação.
      roles: [Requester]
      // REVIEW [2026-12-15] Transição disparada ao enviar.
      to: status.Submitted
      {
        // REVIEW [2026-12-15] Registra o instante do envio.
        submittedAt = now()
      }
    }

    // REVIEW [2026-12-15] Aprova a solicitação e a move para Approved.
    approve() {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Aprovar solicitação", en: "Approve request" }
      // REVIEW [2026-12-15] Papéis autorizados a aprovar a solicitação.
      roles: [Approver, ProcurementManager]
      // REVIEW [2026-12-15] Transição disparada ao aprovar.
      to: status.Approved
      {
        // REVIEW [2026-12-15] Registra o instante da aprovação.
        approvedAt = now()
      }
    }

    // REVIEW [2026-12-15] Rejeita a solicitação informando o motivo.
    reject(rejectionReason: string) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Rejeitar solicitação", en: "Reject request" }
      // REVIEW [2026-12-15] Papéis autorizados a rejeitar a solicitação.
      roles: [Approver, ProcurementManager]
      // REVIEW [2026-12-15] Transição disparada ao rejeitar.
      to: status.Rejected
      // REVIEW [2026-12-15] Emite o evento com o motivo da rejeição.
      emits { reason: rejectionReason }
      {
        // REVIEW [2026-12-15] Registra o instante da rejeição.
        rejectedAt = now()
      }
    }

    // REVIEW [2026-12-15] Emite o pedido de compra e move a solicitação para Ordered.
    order(purchaseOrder: PurchaseOrder) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Emitir pedido de compra", en: "Issue purchase order" }
      // REVIEW [2026-12-15] Papéis autorizados a emitir o pedido.
      roles: [Buyer]
      // REVIEW [2026-12-15] Transição disparada ao emitir o pedido.
      to: status.Ordered
      {
        // REVIEW [2026-12-15] Registra o instante da emissão do pedido.
        orderedAt = now()
      }
    }
  }

  // REVIEW [2026-12-15] Índices de consulta mantidos para o documento.
  indexes {
    // REVIEW [2026-12-15] Índice único pelo número, evitando duplicidade.
    byNumber: [number] unique
    // REVIEW [2026-12-15] Índice de faixa por situação e envio, para listagens ordenadas.
    byStatus: [status, submittedAt] range
    // REVIEW [2026-12-15] Índice hash pelo fornecedor, para busca direta.
    bySupplier: [supplier.id] hash
  }

  // REVIEW [2026-12-15] Regra que exige valor positivo na solicitação.
  rule amount > 0 BRL {
    // REVIEW [2026-12-15] Mensagem da regra em português.
    pt-BR: "A solicitação precisa ter valor positivo"
    // REVIEW [2026-12-15] Mensagem da regra em inglês.
    en: "The request must have a positive amount"
  }

  // REVIEW [2026-12-15] Regras de segregação de funções da solicitação.
  segregation {
    // REVIEW [2026-12-15] Quem envia não pode ser quem aprova.
    submit != approve
  }
}

// REVIEW [2026-12-15] Forma do ciclo de vida da solicitação de compra.
shape PurchaseRequestStatus {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Situação da solicitação de compra", en: "Purchase request status" }
  // REVIEW [2026-12-15] Base da forma: máquina de estados.
  base: state
  // REVIEW [2026-12-15] Estado inicial de toda solicitação criada.
  initial: Draft
  // REVIEW [2026-12-15] Estado de rascunho, antes do envio.
  value Draft {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Rascunho", en: "Draft" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Draft
    // REVIEW [2026-12-15] Ordem de exibição do estado.
    ordinal: 10

    // REVIEW [2026-12-15] Transição para solicitação enviada.
    transition Submitted {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Solicitação enviada", en: "Purchase request submitted" }
      // REVIEW [2026-12-15] Dados carregados pela transição.
      payload {
        // REVIEW [2026-12-15] Data e hora do envio.
        submittedAt: DateTime { title: { pt-BR: "Enviada em", en: "Submitted at" } }
        // REVIEW [2026-12-15] Valor solicitado no envio.
        amount: std.Money { title: { pt-BR: "Valor", en: "Amount" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado de solicitação enviada, aguardando decisão.
  value Submitted {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Enviada", en: "Submitted" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Submitted
    // REVIEW [2026-12-15] Ordem de exibição do estado.
    ordinal: 20

    // REVIEW [2026-12-15] Transição para solicitação aprovada.
    transition Approved {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Solicitação aprovada", en: "Purchase request approved" }
      // REVIEW [2026-12-15] Dados carregados pela transição.
      payload {
        // REVIEW [2026-12-15] Data e hora da aprovação.
        approvedAt: DateTime { title: { pt-BR: "Aprovada em", en: "Approved at" } }
        // REVIEW [2026-12-15] Valor aprovado.
        amount: std.Money { title: { pt-BR: "Valor", en: "Amount" } }
      }
    }

    // REVIEW [2026-12-15] Transição para solicitação rejeitada.
    transition Rejected {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Solicitação rejeitada", en: "Purchase request rejected" }
      // REVIEW [2026-12-15] Dados carregados pela transição.
      payload {
        // REVIEW [2026-12-15] Data e hora da rejeição.
        rejectedAt: DateTime { title: { pt-BR: "Rejeitada em", en: "Rejected at" } }
        // REVIEW [2026-12-15] Motivo da rejeição.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado de solicitação aprovada, pronta para virar pedido.
  value Approved {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Aprovada", en: "Approved" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Approved
    // REVIEW [2026-12-15] Ordem de exibição do estado.
    ordinal: 30

    // REVIEW [2026-12-15] Transição para pedido de compra emitido.
    transition Ordered {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Pedido de compra emitido", en: "Purchase order issued" }
      // REVIEW [2026-12-15] Dados carregados pela transição.
      payload {
        // REVIEW [2026-12-15] Data e hora da emissão do pedido.
        orderedAt: DateTime { title: { pt-BR: "Emitido em", en: "Issued at" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado de solicitação rejeitada.
  value Rejected {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Rejeitada", en: "Rejected" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Rejected
    // REVIEW [2026-12-15] Ordem de exibição do estado.
    ordinal: 40
  }
  // REVIEW [2026-12-15] Estado de solicitação com pedido emitido.
  value Ordered {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Pedido emitido", en: "Ordered" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Ordered
    // REVIEW [2026-12-15] Ordem de exibição do estado.
    ordinal: 50
  }
}
