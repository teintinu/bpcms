// REVIEW [2026-12-15] service: example.com/services/procurement

// REVIEW [2026-12-15] Documento que representa um fornecedor cadastrado no serviço.
document Supplier {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Fornecedor", en: "Supplier" }
  // REVIEW [2026-12-15] Versão do artefato Document; diff e release comparam.
  // REVIEW [2026-12-15] Área responsável pela manutenção do artefato.
  // REVIEW [2026-12-15] Modo de sincronização do documento: leitura.
  sync: read

  // REVIEW [2026-12-15] Campos que compõem o fornecedor.
  fields {
    // REVIEW [2026-12-15] Razão social; única, consultável e obrigatória.
    legalName: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Razão social", en: "Legal name" }
      // REVIEW [2026-12-15] Limita a razão social a cento e sessenta caracteres.
      maxLength: 160
      // REVIEW [2026-12-15] Impede dois fornecedores com a mesma razão social.
      unique
      // REVIEW [2026-12-15] Permite localizar o fornecedor pela razão social.
      lookup
      // REVIEW [2026-12-15] Torna a razão social obrigatória no preenchimento.
      required
    }
    // REVIEW [2026-12-15] Nome fantasia do fornecedor.
    tradeName: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Nome fantasia", en: "Trade name" }
      // REVIEW [2026-12-15] Limita o nome fantasia a cento e vinte caracteres.
      maxLength: 120
    }
    // REVIEW [2026-12-15] Correio eletrônico de contato do fornecedor.
    email: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Correio eletrônico", en: "Email" }
      // REVIEW [2026-12-15] Limita o correio eletrônico a duzentos e cinquenta e quatro caracteres.
      maxLength: 254
    }
    // REVIEW [2026-12-15] Telefone de contato do fornecedor.
    phone: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Telefone", en: "Phone" }
      // REVIEW [2026-12-15] Limita o telefone a quarenta caracteres.
      maxLength: 40
    }
    // REVIEW [2026-12-15] Categoria de atuação do fornecedor.
    category: SupplierCategory {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Categoria", en: "Category" }
      // REVIEW [2026-12-15] Permite localizar o fornecedor pela categoria.
      lookup
    }
    // REVIEW [2026-12-15] Nível de risco atribuído pela conformidade.
    risk: RiskLevel {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Risco", en: "Risk" }
      // REVIEW [2026-12-15] Permite localizar o fornecedor pelo risco.
      lookup
    }
    // REVIEW [2026-12-15] Situação atual do fornecedor no ciclo de vida.
    status: SupplierStatus {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Situação", en: "Status" }
      // REVIEW [2026-12-15] Permite localizar o fornecedor pela situação.
      lookup
    }
    // REVIEW [2026-12-15] Indica se a documentação do fornecedor foi verificada.
    documentsVerified: boolean {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Documentos verificados", en: "Documents verified" }
    }
    // REVIEW [2026-12-15] Condição de pagamento acordada com o fornecedor.
    paymentTerms: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Condição de pagamento", en: "Payment terms" }
      // REVIEW [2026-12-15] Limita a condição a cento e vinte caracteres.
      maxLength: 120
    }
    // REVIEW [2026-12-15] Data e hora em que o fornecedor foi aprovado.
    approvedAt: DateTime {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Aprovado em", en: "Approved at" }
    }
    // REVIEW [2026-12-15] Data e hora em que o fornecedor foi bloqueado.
    blockedAt: DateTime {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Bloqueado em", en: "Blocked at" }
    }
    // REVIEW [2026-12-15] Motivo que levou ao bloqueio do fornecedor.
    blockedReason: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Motivo do bloqueio", en: "Block reason" }
      // REVIEW [2026-12-15] Limita o motivo a duzentos e oitenta caracteres.
      maxLength: 280
    }
  }


  // REVIEW [2026-12-15] Ações que movimentam e completam o cadastro do fornecedor.
  actions {
    // REVIEW [2026-12-15] Recebe o cadastro inicial enviado pelo fornecedor no portal.
    submitRegistration(legalName: string, tradeName: string, email: string, phone: string, category: SupplierCategory) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Enviar cadastro", en: "Submit registration" }
      // REVIEW [2026-12-15] Papéis autorizados a enviar o cadastro.
      roles: [SupplierUser, Buyer]
    }

    // REVIEW [2026-12-15] Marca a documentação do fornecedor como verificada.
    verifyDocuments() {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Verificar documentos", en: "Verify documents" }
      // REVIEW [2026-12-15] Papéis autorizados a verificar documentos.
      roles: [ComplianceAnalyst]
      {
        // REVIEW [2026-12-15] Registra que a verificação documental foi concluída.
        documentsVerified = true
      }
    }

    // REVIEW [2026-12-15] Classifica o fornecedor em um nível de risco.
    classifyRisk(risk: RiskLevel) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Classificar risco", en: "Classify risk" }
      // REVIEW [2026-12-15] Papéis autorizados a classificar o risco.
      roles: [ComplianceAnalyst]
    }

    // REVIEW [2026-12-15] Aprova o fornecedor e o move para a situação Approved.
    approve() {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Aprovar fornecedor", en: "Approve supplier" }
      // REVIEW [2026-12-15] Papéis autorizados a aprovar o fornecedor.
      roles: [Approver, ProcurementManager]
      // REVIEW [2026-12-15] Transição disparada ao aprovar.
      to: status.Approved
      {
        // REVIEW [2026-12-15] Registra o instante da aprovação.
        approvedAt = now()
      }
    }

    // REVIEW [2026-12-15] Bloqueia o fornecedor informando o motivo.
    block(blockedReason: string) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Bloquear fornecedor", en: "Block supplier" }
      // REVIEW [2026-12-15] Papéis autorizados a bloquear o fornecedor.
      roles: [ComplianceAnalyst, Approver, ProcurementManager]
      // REVIEW [2026-12-15] Transição disparada ao bloquear.
      to: status.Blocked
      // REVIEW [2026-12-15] Emite o evento com o motivo do bloqueio.
      emits { reason: blockedReason }
      {
        // REVIEW [2026-12-15] Registra o instante do bloqueio.
        blockedAt = now()
      }
    }

    // REVIEW [2026-12-15] Habilita o fornecedor em contas a pagar com a condição acordada.
    enablePayables(paymentTerms: string) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Habilitar contas a pagar", en: "Enable payables" }
      // REVIEW [2026-12-15] Papéis autorizados a habilitar o pagamento.
      roles: [PayablesClerk]
    }
  }

  // REVIEW [2026-12-15] Índices de consulta mantidos para o documento.
  indexes {
    // REVIEW [2026-12-15] Índice único pela razão social, evitando duplicidade.
    byLegalName: [legalName] unique
    // REVIEW [2026-12-15] Índice de faixa por situação e razão social, para listagens ordenadas.
    byStatus: [status, legalName] range
  }

  // REVIEW [2026-12-15] Regra que exige documentos verificados antes da aprovação.
  rule status == Approved implies documentsVerified {
    // REVIEW [2026-12-15] Mensagem da regra em português.
    pt-BR: "Verifique os documentos antes de aprovar o fornecedor"
    // REVIEW [2026-12-15] Mensagem da regra em inglês.
    en: "Verify the documents before approving the supplier"
  }
}

// REVIEW [2026-12-15] Forma do ciclo de vida do fornecedor.
shape SupplierStatus {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Situação do fornecedor", en: "Supplier status" }
  // REVIEW [2026-12-15] Base da forma: máquina de estados.
  base: state
  // REVIEW [2026-12-15] Estado inicial de todo fornecedor criado.
  initial: Prospect
  // REVIEW [2026-12-15] Estado de prospecto, antes de qualquer verificação.
  value Prospect {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Prospecto", en: "Prospect" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Prospect
    // REVIEW [2026-12-15] Ordem de exibição do estado.
    ordinal: 10

    // REVIEW [2026-12-15] Transição para fornecedor aprovado.
    transition Approved {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Fornecedor aprovado", en: "Supplier approved" }
      // REVIEW [2026-12-15] Dados carregados pela transição.
      payload {
        // REVIEW [2026-12-15] Data e hora da aprovação.
        approvedAt: DateTime { title: { pt-BR: "Aprovado em", en: "Approved at" } }
      }
    }

    // REVIEW [2026-12-15] Transição para fornecedor bloqueado.
    transition Blocked {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Fornecedor bloqueado", en: "Supplier blocked" }
      // REVIEW [2026-12-15] Dados carregados pela transição.
      payload {
        // REVIEW [2026-12-15] Data e hora do bloqueio.
        blockedAt: DateTime { title: { pt-BR: "Bloqueado em", en: "Blocked at" } }
        // REVIEW [2026-12-15] Motivo do bloqueio.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado de fornecedor aprovado.
  value Approved {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Aprovado", en: "Approved" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Approved
    // REVIEW [2026-12-15] Ordem de exibição do estado.
    ordinal: 20

    // REVIEW [2026-12-15] Transição para fornecedor bloqueado.
    transition Blocked {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Fornecedor bloqueado", en: "Supplier blocked" }
      // REVIEW [2026-12-15] Dados carregados pela transição.
      payload {
        // REVIEW [2026-12-15] Data e hora do bloqueio.
        blockedAt: DateTime { title: { pt-BR: "Bloqueado em", en: "Blocked at" } }
        // REVIEW [2026-12-15] Motivo do bloqueio.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado de fornecedor bloqueado.
  value Blocked {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Bloqueado", en: "Blocked" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Blocked
    // REVIEW [2026-12-15] Ordem de exibição do estado.
    ordinal: 30
  }
}

// REVIEW [2026-12-15] Forma de classificação da categoria do fornecedor.
shape SupplierCategory {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Categoria do fornecedor", en: "Supplier category" }
  // REVIEW [2026-12-15] Base da forma: classificação.
  base: classification
  // REVIEW [2026-12-15] Categoria de fornecimento de mercadorias.
  value Goods {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Mercadorias", en: "Goods" }
    // REVIEW [2026-12-15] Ícone associado à categoria.
    icon: Goods
    // REVIEW [2026-12-15] Ordem de exibição da categoria.
    ordinal: 10
  }
  // REVIEW [2026-12-15] Categoria de prestação de serviços.
  value Services {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Serviços", en: "Services" }
    // REVIEW [2026-12-15] Ícone associado à categoria.
    icon: Services
    // REVIEW [2026-12-15] Ordem de exibição da categoria.
    ordinal: 20
  }
  // REVIEW [2026-12-15] Categoria de logística e transporte.
  value Logistics {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Logística", en: "Logistics" }
    // REVIEW [2026-12-15] Ícone associado à categoria.
    icon: Logistics
    // REVIEW [2026-12-15] Ordem de exibição da categoria.
    ordinal: 30
  }
  // REVIEW [2026-12-15] Categoria de tecnologia e software.
  value Technology {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Tecnologia", en: "Technology" }
    // REVIEW [2026-12-15] Ícone associado à categoria.
    icon: Technology
    // REVIEW [2026-12-15] Ordem de exibição da categoria.
    ordinal: 40
  }
}

// REVIEW [2026-12-15] Forma de classificação do nível de risco do fornecedor.
shape RiskLevel {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Nível de risco do fornecedor", en: "Supplier risk level" }
  // REVIEW [2026-12-15] Base da forma: classificação.
  base: classification
  // REVIEW [2026-12-15] Risco baixo.
  value Low {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Baixo", en: "Low" }
    // REVIEW [2026-12-15] Ícone associado ao nível.
    icon: Low
    // REVIEW [2026-12-15] Ordem de exibição do nível.
    ordinal: 10
  }
  // REVIEW [2026-12-15] Risco médio.
  value Medium {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Médio", en: "Medium" }
    // REVIEW [2026-12-15] Ícone associado ao nível.
    icon: Medium
    // REVIEW [2026-12-15] Ordem de exibição do nível.
    ordinal: 20
  }
  // REVIEW [2026-12-15] Risco alto.
  value High {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Alto", en: "High" }
    // REVIEW [2026-12-15] Ícone associado ao nível.
    icon: High
    // REVIEW [2026-12-15] Ordem de exibição do nível.
    ordinal: 30
  }
}
