// REVIEW [2026-12-15] service: example.com/services/procurement

// REVIEW [2026-12-15] Documento que representa uma cotação (request for quotation) de compra.
document RFQ {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Cotação", en: "Request for quotation" }
  // REVIEW [2026-12-15] Versão do artefato Document; diff e release comparam.
  // REVIEW [2026-12-15] Área responsável pela manutenção do artefato.
  // REVIEW [2026-12-15] Modo de sincronização do documento: leitura.
  sync: read

  // REVIEW [2026-12-15] Campos que compõem a cotação.
  fields {
    // REVIEW [2026-12-15] Número identificador da cotação; único e consultável.
    number: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Número", en: "Number" }
      // REVIEW [2026-12-15] Limita o número a quarenta caracteres.
      maxLength: 40
      // REVIEW [2026-12-15] Impede duas cotações com o mesmo número.
      unique
      // REVIEW [2026-12-15] Permite localizar a cotação pelo número.
      lookup
    }
    // REVIEW [2026-12-15] Solicitação de compra que originou a cotação.
    request: PurchaseRequest {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Solicitação", en: "Purchase request" }
      // REVIEW [2026-12-15] Permite localizar a cotação pela solicitação.
      lookup
    }
    // REVIEW [2026-12-15] Prazo limite para receber a cotação do fornecedor.
    dueAt: DateTime {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Prazo da cotação", en: "Quote deadline" }
    }
    // REVIEW [2026-12-15] Situação atual da cotação no ciclo de vida.
    status: RFQStatus {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Situação", en: "Status" }
      // REVIEW [2026-12-15] Permite localizar a cotação pela situação.
      lookup
    }
    // REVIEW [2026-12-15] Valor cotado e registrado pelo comprador.
    quotedAmount: std.Money {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Valor cotado", en: "Quoted amount" }
      // REVIEW [2026-12-15] Moeda do valor cotado.
      currency: BRL
    }
    // REVIEW [2026-12-15] Data e hora em que a cotação foi registrada.
    quotedAt: DateTime {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Cotado em", en: "Quoted at" }
    }
    // REVIEW [2026-12-15] Fornecedor vencedor da cotação.
    awardedSupplier: Supplier {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Fornecedor adjudicado", en: "Awarded supplier" }
    }
    // REVIEW [2026-12-15] Data e hora em que a cotação foi adjudicada.
    awardedAt: DateTime {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Adjudicado em", en: "Awarded at" }
    }
  }


  // REVIEW [2026-12-15] Ações que registram a cotação e a adjudicação ao fornecedor.
  actions {
    // REVIEW [2026-12-15] Registra o valor cotado e move a cotação para Quoted.
    quote(quotedAmount: std.Money) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Registrar cotação", en: "Record quote" }
      // REVIEW [2026-12-15] Papéis autorizados a registrar a cotação.
      roles: [Buyer]
      // REVIEW [2026-12-15] Transição disparada ao registrar a cotação.
      to: status.Quoted
      // REVIEW [2026-12-15] Emite o evento com o valor cotado.
      emits { amount: quotedAmount }
      {
        // REVIEW [2026-12-15] Registra o instante em que a cotação foi anotada.
        quotedAt = now()
      }
    }

    // REVIEW [2026-12-15] Adjudica a cotação ao fornecedor vencedor e a move para Awarded.
    award(awardedSupplier: Supplier) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Adjudicar cotação", en: "Award quote" }
      // REVIEW [2026-12-15] Papéis autorizados a adjudicar a cotação.
      roles: [Buyer, ProcurementManager]
      // REVIEW [2026-12-15] Transição disparada ao adjudicar.
      to: status.Awarded
      // REVIEW [2026-12-15] Emite o evento com o fornecedor adjudicado.
      emits { supplier: awardedSupplier }
      {
        // REVIEW [2026-12-15] Registra o instante da adjudicação.
        awardedAt = now()
      }
    }
  }

  // REVIEW [2026-12-15] Índices de consulta mantidos para o documento.
  indexes {
    // REVIEW [2026-12-15] Índice único pelo número, evitando duplicidade.
    byNumber: [number] unique
    // REVIEW [2026-12-15] Índice de faixa por situação e prazo, para listagens ordenadas.
    byStatus: [status, dueAt] range
  }
}

// REVIEW [2026-12-15] Forma do ciclo de vida da cotação.
shape RFQStatus {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Situação da cotação", en: "RFQ status" }
  // REVIEW [2026-12-15] Base da forma: máquina de estados.
  base: state
  // REVIEW [2026-12-15] Estado inicial de toda cotação criada.
  initial: Open
  // REVIEW [2026-12-15] Estado de cotação aberta, aguardando resposta.
  value Open {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Aberta", en: "Open" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Open
    // REVIEW [2026-12-15] Ordem de exibição do estado.
    ordinal: 10

    // REVIEW [2026-12-15] Transição para cotação recebida.
    transition Quoted {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Cotação recebida", en: "Quote received" }
      // REVIEW [2026-12-15] Dados carregados pela transição.
      payload {
        // REVIEW [2026-12-15] Data e hora em que a cotação foi registrada.
        quotedAt: DateTime { title: { pt-BR: "Cotado em", en: "Quoted at" } }
        // REVIEW [2026-12-15] Valor cotado.
        amount: std.Money { title: { pt-BR: "Valor", en: "Amount" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado de cotação já respondida.
  value Quoted {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Cotada", en: "Quoted" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Quoted
    // REVIEW [2026-12-15] Ordem de exibição do estado.
    ordinal: 20

    // REVIEW [2026-12-15] Transição para cotação adjudicada.
    transition Awarded {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Cotação adjudicada", en: "Quote awarded" }
      // REVIEW [2026-12-15] Dados carregados pela transição.
      payload {
        // REVIEW [2026-12-15] Data e hora da adjudicação.
        awardedAt: DateTime { title: { pt-BR: "Adjudicado em", en: "Awarded at" } }
        // REVIEW [2026-12-15] Fornecedor vencedor da cotação.
        supplier: Supplier { title: { pt-BR: "Fornecedor", en: "Supplier" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado de cotação adjudicada.
  value Awarded {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Adjudicada", en: "Awarded" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Awarded
    // REVIEW [2026-12-15] Ordem de exibição do estado.
    ordinal: 30
  }
}
