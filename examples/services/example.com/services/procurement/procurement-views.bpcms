// service: example.com/services/procurement

// View de caixa de entrada com as tarefas de compras do usuário logado.
view MyProcurementTasks {
  // Título exibido na navegação e no cabeçalho da inbox.
  title: { pt-BR: "Minhas tarefas de compras", en: "My procurement tasks" }
  // Tipo da view: caixa de entrada de tarefas.
  type: inbox
  // Papéis que podem abrir a inbox e ver as próprias tarefas.
  roles: [Requester, Buyer, Approver, ProcurementManager, ComplianceAnalyst, PayablesClerk, ReceivingClerk, QualityInspector]

  // Restringe o conteúdo às tarefas atribuídas ao usuário logado.
  scope: mine
  // Agrupa as tarefas pelo processo de origem.
  groupBy: process
  // Colunas exibidas em cada linha da inbox.
  columns { title; subject; role; dueAt; priority }
}
