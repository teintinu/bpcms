// REVIEW [2026-12-15] service: example.com/services/procurement

// REVIEW [2026-12-15] Declara o serviço de Compras, raiz dos artefatos deste contexto de negócio.
service "example.com/services/procurement" {
  // REVIEW [2026-12-15] Título exibido no builder e na navegação do serviço.
  title: { pt-BR: "Compras", en: "Procurement" }
  locales: [ "pt-BR", "en" ] // REVIEW [2026-12-18] Idiomas suportados pelo serviço; o primeiro é o default do I18N em forma de string.
  // REVIEW [2026-12-15] Versão do serviço usada em release e diff.
  // REVIEW [2026-12-15] Área responsável pela manutenção do serviço.
  // REVIEW [2026-12-15] Dependências externas referenciadas pelos artefatos do serviço.
  imports {
    // REVIEW [2026-12-15] Importa as medidas e constantes padrão do construtor (Money, Mass, Count).
    service "bpcms.org/std" as std
    // REVIEW [2026-12-15] Importa o serviço de identidade, dono do tipo User usado nos solicitantes.
    service "example.com/services/identity" as Identity
  }
}
