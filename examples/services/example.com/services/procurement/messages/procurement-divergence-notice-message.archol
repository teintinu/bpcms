// REVIEW [2026-12-15] service: example.com/services/procurement

// REVIEW [2026-12-15] Mensagem de aviso quando o recebimento apresenta divergência.
message DivergenceNotice {
  // REVIEW [2026-12-15] Título exibido na notificação.
  title: { pt-BR: "Aviso de divergência no recebimento", en: "Goods receipt divergence notice" }
  // REVIEW [2026-12-15] Documento ao qual a mensagem se refere.
  about: GoodsReceipt
  // REVIEW [2026-12-15] Dados carregados pela mensagem.
  payload {
    // REVIEW [2026-12-15] Motivo da divergência.
    reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
    // REVIEW [2026-12-15] Peso esperado para conferência.
    expectedWeight: std.Mass { title: { pt-BR: "Peso esperado", en: "Expected weight" } }
    // REVIEW [2026-12-15] Peso efetivamente recebido.
    receivedWeight: std.Mass { title: { pt-BR: "Peso recebido", en: "Received weight" } }
  }
}
