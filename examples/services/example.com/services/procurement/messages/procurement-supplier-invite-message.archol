// REVIEW [2026-12-15] service: example.com/services/procurement

// REVIEW [2026-12-15] Mensagem de convite enviada ao fornecedor para o portal.
message SupplierInvite {
  // REVIEW [2026-12-15] Título exibido na notificação.
  title: { pt-BR: "Convite ao portal do fornecedor", en: "Supplier portal invite" }
  // REVIEW [2026-12-15] Documento ao qual a mensagem se refere.
  about: Supplier
  // REVIEW [2026-12-15] Dados carregados pela mensagem.
  payload {
    // REVIEW [2026-12-15] Data e hora do convite.
    invitedAt: DateTime { title: { pt-BR: "Convidado em", en: "Invited at" } }
    // REVIEW [2026-12-15] Data e hora de expiração do convite.
    expiresAt: DateTime { title: { pt-BR: "Expira em", en: "Expires at" } }
  }
}
