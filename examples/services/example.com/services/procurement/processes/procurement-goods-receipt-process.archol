// REVIEW [2026-12-15] service: example.com/services/procurement
// REVIEW [2026-12-15] Process: sintaxe atual (DSL_REFERENCE.md §4)

// REVIEW [2026-12-15] Declara o processo de recebimento; o argumento é o documento-sujeito.
process GoodsReceipt(goodsReceipt: GoodsReceipt) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Recebimento de mercadoria", en: "Goods receipt" }
  // REVIEW [2026-12-15] Versão do artefato Process; diff e release comparam.
  version: 1
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Receber a mercadoria conferida e tratar divergência sem sujar o estoque"
  }
  // REVIEW [2026-12-15] SLA brando do caso: alvo de lead time, não é timer.
  sla: 2d

  // REVIEW [2026-12-15] Restringe a instância às tarefas da role recebedor.
  by: [ReceivingClerk]

  // REVIEW [2026-12-15] Abre o form de recebimento para o recebedor registrar a chegada.
  ReceiveGoods.show({ goodsReceipt })
  // REVIEW [2026-12-15] Reserva o estoque assim que a mercadoria é recebida.
  GoodsReceipt.reserveStock()
  // REVIEW [2026-12-15] Abre o form de inspeção para a qualidade conferir o recebimento.
  InspectGoods.show({ goodsReceipt })

  // REVIEW [2026-12-15] Se a inspeção registrou divergência...
  if (goodsReceipt.status == Divergent) {
    // REVIEW [2026-12-15] ...envia o aviso de divergência ao destinatário correto.
    send DivergenceNotice {
      // REVIEW [2026-12-15] Chave de correlação da mensagem com o recebimento.
      key: goodsReceipt
      // REVIEW [2026-12-15] Dados preenchidos na mensagem.
      with {
        // REVIEW [2026-12-15] Motivo da divergência apontado na inspeção.
        reason: goodsReceipt.divergenceReason
        // REVIEW [2026-12-15] Peso esperado conforme o pedido.
        expectedWeight: goodsReceipt.expectedWeight
        // REVIEW [2026-12-15] Peso efetivamente recebido.
        receivedWeight: goodsReceipt.receivedWeight
      }
    }

    // REVIEW [2026-12-15] Compensação explícita da reserva feita antes da inspeção.
    GoodsReceipt.releaseStock()
    // REVIEW [2026-12-15] Encerra no desfecho de falha.
    return Divergent
  }

  // REVIEW [2026-12-15] Sem divergência, encerra no desfecho de sucesso.
  return Accepted

  // REVIEW [2026-12-15] Declara o desfecho de sucesso do caso.
  end Accepted {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Recebido", en: "Accepted" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }

  // REVIEW [2026-12-15] Declara o desfecho de falha do caso.
  end Divergent {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Divergente", en: "Divergent" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: failure
  }
}

// REVIEW [2026-12-15] Form de recebimento da mercadoria.
form ReceiveGoods {
  // REVIEW [2026-12-15] Título exibido na tarefa e no formulário.
  title: { pt-BR: "Receber mercadoria", en: "Receive goods" }
  // REVIEW [2026-12-15] Documento manipulado pelo form.
  document: GoodsReceipt
  // REVIEW [2026-12-15] Papéis que podem atender a tarefa.
  roles: [ReceivingClerk]
  // REVIEW [2026-12-15] Prazo para responder; estourar dispara Timeout.
  timeout: 2h
  // REVIEW [2026-12-15] Prioridade da tarefa na inbox.
  priority: 50
  // REVIEW [2026-12-15] Modo de atribuição: o usuário puxa a tarefa.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Pedido de compra, somente leitura.
    order { readonly }
    // REVIEW [2026-12-15] Peso esperado, somente leitura.
    expectedWeight { readonly }
    // REVIEW [2026-12-15] Peso recebido, somente leitura, pois vem da balança.
    receivedWeight { readonly }
  }

  // REVIEW [2026-12-15] Ações disponíveis no formulário.
  actions {
    // REVIEW [2026-12-15] Registra o recebimento chamando a ação do documento.
    receive { calls: GoodsReceipt.receive }
  }
}

// REVIEW [2026-12-15] Form de inspeção da mercadoria recebida.
form InspectGoods {
  // REVIEW [2026-12-15] Título exibido na tarefa e no formulário.
  title: { pt-BR: "Inspecionar recebimento", en: "Inspect goods receipt" }
  // REVIEW [2026-12-15] Documento manipulado pelo form.
  document: GoodsReceipt
  // REVIEW [2026-12-15] Papéis que podem atender a tarefa.
  roles: [QualityInspector]
  // REVIEW [2026-12-15] Prazo para responder; estourar dispara Timeout.
  timeout: 4h
  // REVIEW [2026-12-15] Prioridade da tarefa na inbox.
  priority: 60
  // REVIEW [2026-12-15] Modo de atribuição: o usuário puxa a tarefa.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Peso esperado, somente leitura.
    expectedWeight { readonly }
    // REVIEW [2026-12-15] Peso recebido, somente leitura.
    receivedWeight { readonly }
    // REVIEW [2026-12-15] Motivo da divergência, preenchido quando há recusa.
    divergenceReason
  }

  // REVIEW [2026-12-15] Ações disponíveis no formulário.
  actions {
    // REVIEW [2026-12-15] Aceita o recebimento chamando a ação do documento.
    accept { calls: GoodsReceipt.accept }
    // REVIEW [2026-12-15] Registra a divergência com o motivo informado.
    diverge { calls: GoodsReceipt.markDivergent(divergenceReason) }
  }
}
