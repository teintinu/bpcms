// REVIEW [2026-12-15] service: example.com/services/procurement
// REVIEW [2026-12-15] Process: sintaxe atual (DSL_REFERENCE.md §4)

// REVIEW [2026-12-15] Declara o processo de habilitação; o argumento é o fornecedor-sujeito.
process SupplierOnboarding(supplier: Supplier) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Habilitação de fornecedor", en: "Supplier onboarding" }
  // REVIEW [2026-12-15] Versão do artefato Process; diff e release comparam.
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Habilitar fornecedor com cadastro no portal, documentos verificados e contas a pagar prontas"
  }
  // REVIEW [2026-12-15] SLA brando do caso: alvo de lead time, não é timer.
  sla: 10d

  // REVIEW [2026-12-15] Restringe a instância às tarefas da role comprador.
  by: [Buyer]

  // REVIEW [2026-12-15] Convida o fornecedor a preencher o cadastro no portal.
  send SupplierInvite {
    // REVIEW [2026-12-15] Chave de correlação da mensagem com o fornecedor.
    key: supplier
    // REVIEW [2026-12-15] Dados preenchidos na mensagem.
    with {
      // REVIEW [2026-12-15] Instante em que o convite é enviado.
      invitedAt: now()
      // REVIEW [2026-12-15] Prazo de sete dias para o convite expirar.
      expiresAt: now() + 7d
    }
  }

  // REVIEW [2026-12-15] Bloco externo: captura o timeout do cadastro no portal.
  try {
    // REVIEW [2026-12-15] Abre o form de cadastro para o usuário do fornecedor.
    SupplierRegistration.show({ supplier })
  } catch (Timeout) {
    // REVIEW [2026-12-15] O prazo do cadastro no portal esgotou: bloqueia a habilitação.
    BlockSupplier.show({ supplier })
    // REVIEW [2026-12-15] Encerra no desfecho de bloqueio.
    return Blocked
  }

  // REVIEW [2026-12-15] Abre o form de verificação documental para a conformidade.
  DocumentVerification.show({ supplier })

  // REVIEW [2026-12-15] Se a verificação bloqueou o fornecedor...
  if (supplier.status == Blocked) {
    // REVIEW [2026-12-15] ...encerra no desfecho de bloqueio.
    return Blocked
  }

  // REVIEW [2026-12-15] Bloco interno: tenta abrir a aprovação de conformidade.
  try {
    // REVIEW [2026-12-15] Abre o form de aprovação do fornecedor.
    ComplianceApproval.show({ supplier })
  } catch (Timeout) {
    // REVIEW [2026-12-15] Escalada da aprovação para a gestão de compras.
    ComplianceApproval.show({ supplier })
  }

  // REVIEW [2026-12-15] Se a aprovação bloqueou o fornecedor...
  if (supplier.status == Blocked) {
    // REVIEW [2026-12-15] ...encerra no desfecho de bloqueio.
    return Blocked
  }

  // REVIEW [2026-12-15] Abre a configuração de contas a pagar para o fornecedor habilitado.
  PayablesSetup.show({ supplier })
  // REVIEW [2026-12-15] Encerra no desfecho de sucesso.
  return Onboarded

  // REVIEW [2026-12-15] Declara o desfecho de sucesso do caso.
  end Onboarded {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Fornecedor habilitado", en: "Supplier onboarded" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }

  // REVIEW [2026-12-15] Declara o desfecho de falha do caso.
  end Blocked {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Habilitação bloqueada", en: "Onboarding blocked" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: failure
  }
}

// REVIEW [2026-12-15] Form de cadastro do fornecedor no portal.
form SupplierRegistration {
  // REVIEW [2026-12-15] Título exibido na tarefa e no formulário.
  title: { pt-BR: "Cadastro de fornecedor", en: "Supplier registration" }
  // REVIEW [2026-12-15] Documento manipulado pelo form.
  document: Supplier
  // REVIEW [2026-12-15] Papéis que podem atender a tarefa.
  roles: [SupplierUser]
  // REVIEW [2026-12-15] Prazo para responder; estourar dispara Timeout e bloqueia a habilitação.
  timeout: 7d
  // REVIEW [2026-12-15] Prioridade da tarefa na inbox.
  priority: 70
  // REVIEW [2026-12-15] Modo de atribuição: o usuário puxa a tarefa.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Razão social, obrigatória no cadastro.
    legalName { required }
    // REVIEW [2026-12-15] Nome fantasia, opcional no cadastro.
    tradeName
    // REVIEW [2026-12-15] Correio eletrônico, obrigatório no cadastro.
    email { required }
    // REVIEW [2026-12-15] Telefone, opcional no cadastro.
    phone
    // REVIEW [2026-12-15] Categoria de atuação, obrigatória no cadastro.
    category { required }
  }

  // REVIEW [2026-12-15] Ações disponíveis no formulário.
  actions {
    // REVIEW [2026-12-15] Envia o cadastro com todos os dados informados pelo fornecedor.
    submit { calls: Supplier.submitRegistration(legalName, tradeName, email, phone, category) }
  }
}

// REVIEW [2026-12-15] Form de verificação documental e classificação de risco.
form DocumentVerification {
  // REVIEW [2026-12-15] Título exibido na tarefa e no formulário.
  title: { pt-BR: "Verificação documental", en: "Document verification" }
  // REVIEW [2026-12-15] Documento manipulado pelo form.
  document: Supplier
  // REVIEW [2026-12-15] Papéis que podem atender a tarefa.
  roles: [ComplianceAnalyst]
  // REVIEW [2026-12-15] Prazo para responder; estourar dispara Timeout.
  timeout: 2d
  // REVIEW [2026-12-15] Prioridade da tarefa na inbox.
  priority: 50
  // REVIEW [2026-12-15] Modo de atribuição: o usuário puxa a tarefa.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Nível de risco atribuído ao fornecedor.
    risk
    // REVIEW [2026-12-15] Motivo do bloqueio, quando a verificação reprova o fornecedor.
    blockedReason
  }

  // REVIEW [2026-12-15] Ações disponíveis no formulário.
  actions {
    // REVIEW [2026-12-15] Marca a documentação como verificada.
    verified { calls: Supplier.verifyDocuments }
    // REVIEW [2026-12-15] Classifica o risco e mantém a tarefa aberta para revisão.
    classify { calls: Supplier.classifyRisk(risk); stay }
    // REVIEW [2026-12-15] Bloqueia o fornecedor com o motivo informado.
    rejected { calls: Supplier.block(blockedReason) }
  }
}

// REVIEW [2026-12-15] Form de aprovação final de conformidade do fornecedor.
form ComplianceApproval {
  // REVIEW [2026-12-15] Título exibido na tarefa e no formulário.
  title: { pt-BR: "Aprovação de fornecedor", en: "Supplier approval" }
  // REVIEW [2026-12-15] Documento manipulado pelo form.
  document: Supplier
  // REVIEW [2026-12-15] Papéis que podem atender a tarefa.
  roles: [Approver, ProcurementManager]
  // REVIEW [2026-12-15] Prazo para responder; estourar dispara Timeout.
  timeout: 3d
  // REVIEW [2026-12-15] Prioridade da tarefa na inbox.
  priority: 50
  // REVIEW [2026-12-15] Modo de atribuição: o usuário puxa a tarefa.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Razão social, somente leitura.
    legalName { readonly }
    // REVIEW [2026-12-15] Nível de risco, somente leitura.
    risk { readonly }
    // REVIEW [2026-12-15] Motivo do bloqueio, quando a aprovação reprova o fornecedor.
    blockedReason
  }

  // REVIEW [2026-12-15] Ações disponíveis no formulário.
  actions {
    // REVIEW [2026-12-15] Aprova o fornecedor chamando a ação do documento.
    approved { calls: Supplier.approve }
    // REVIEW [2026-12-15] Bloqueia o fornecedor com o motivo informado.
    rejected { calls: Supplier.block(blockedReason) }
  }
}

// REVIEW [2026-12-15] Form de configuração de contas a pagar do fornecedor.
form PayablesSetup {
  // REVIEW [2026-12-15] Título exibido na tarefa e no formulário.
  title: { pt-BR: "Configuração de contas a pagar", en: "Payables setup" }
  // REVIEW [2026-12-15] Documento manipulado pelo form.
  document: Supplier
  // REVIEW [2026-12-15] Papéis que podem atender a tarefa.
  roles: [PayablesClerk]
  // REVIEW [2026-12-15] Prazo para responder; estourar dispara Timeout.
  timeout: 1d
  // REVIEW [2026-12-15] Prioridade da tarefa na inbox.
  priority: 50
  // REVIEW [2026-12-15] Modo de atribuição: o usuário puxa a tarefa.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Razão social, somente leitura.
    legalName { readonly }
    // REVIEW [2026-12-15] Condição de pagamento acordada com o fornecedor.
    paymentTerms
  }

  // REVIEW [2026-12-15] Ações disponíveis no formulário.
  actions {
    // REVIEW [2026-12-15] Habilita o fornecedor em contas a pagar com a condição informada.
    enable { calls: Supplier.enablePayables(paymentTerms) }
  }
}

// REVIEW [2026-12-15] Form usado para bloquear a habilitação do fornecedor.
form BlockSupplier {
  // REVIEW [2026-12-15] Título exibido na tarefa e no formulário.
  title: { pt-BR: "Bloquear fornecedor", en: "Block supplier" }
  // REVIEW [2026-12-15] Documento manipulado pelo form.
  document: Supplier
  // REVIEW [2026-12-15] Papéis que podem atender a tarefa.
  roles: [ComplianceAnalyst]
  // REVIEW [2026-12-15] Prazo para responder; estourar dispara Timeout.
  timeout: 1d
  // REVIEW [2026-12-15] Prioridade da tarefa na inbox.
  priority: 60
  // REVIEW [2026-12-15] Modo de atribuição: o usuário puxa a tarefa.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Motivo do bloqueio, obrigatório para registrar a decisão.
    blockedReason
  }

  // REVIEW [2026-12-15] Ações disponíveis no formulário.
  actions {
    // REVIEW [2026-12-15] Bloqueia o fornecedor com o motivo informado.
    block { calls: Supplier.block(blockedReason) }
  }
}
