// REVIEW [2026-12-15] service: example.com/services/procurement
// REVIEW [2026-12-15] Process: sintaxe atual (DSL_REFERENCE.md §4)

// REVIEW [2026-12-15] Declara o processo de aprovação de compra; o argumento é o documento-sujeito.
process PurchaseApproval(purchaseRequest: PurchaseRequest) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Aprovação de compra", en: "Purchase approval" }
  // REVIEW [2026-12-15] Versão do artefato Process; diff e release comparam.
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Aprovar a compra na alçada certa, com rastro e sem travar o pedido simples"
  }
  // REVIEW [2026-12-15] SLA brando do caso: alvo de lead time, não é timer.
  sla: "5d"
  // REVIEW [2026-12-15] Prazo rígido do caso: estourar dispara o tratamento de Timeout.
  timeout: 5d

  // REVIEW [2026-12-15] Gatilho: inicia uma instância quando a solicitação é enviada.
  on [PurchaseRequest.Submitted]
  // REVIEW [2026-12-15] Chave de identidade, correlação e dedup da instância.
  key: purchaseRequest

  // REVIEW [2026-12-15] Variável durável da instância: alçada calculada para a compra.
  let tier: ApproverTier

  // REVIEW [2026-12-15] Bloco externo: captura timeout do caso e dos forms.
  try {
    // REVIEW [2026-12-15] Consulta a decisão de alçada com valor e fornecedor da solicitação.
    tier = ApprovalLimit.evaluate({
      // REVIEW [2026-12-15] Valor da compra enviado à avaliação.
      amount: purchaseRequest.amount,
      // REVIEW [2026-12-15] Fornecedor enviado à avaliação.
      supplier: purchaseRequest.supplier
    })

    // REVIEW [2026-12-15] Compras dentro da alçada automática não passam por aprovação humana.
    if (tier == Auto) {
      // REVIEW [2026-12-15] Aprova a solicitação diretamente.
      PurchaseRequest.approve()
      // REVIEW [2026-12-15] Encerra no desfecho de sucesso.
      return Approved
    }

    // REVIEW [2026-12-15] Bloco interno: tenta abrir a decisão de aprovação.
    try {
      // REVIEW [2026-12-15] Abre o form de decisão para o aprovador.
      ApprovalDecision.show({ purchaseRequest })
    } catch (Timeout) {
      // REVIEW [2026-12-15] Escalada da alçada: a mesma decisão volta para a gestão de compras.
      ApprovalDecision.show({ purchaseRequest })
    }

    // REVIEW [2026-12-15] Se a decisão aprovou a solicitação...
    if (purchaseRequest.status == Approved) {
      // REVIEW [2026-12-15] ...encerra no desfecho de sucesso.
      return Approved
    }

    // REVIEW [2026-12-15] Sem aprovação, encerra no desfecho de rejeição.
    return Rejected
  } catch (Timeout) {
    // REVIEW [2026-12-15] Breach do caso: desvia a decisão para a alçada superior.
    ApprovalDecision.show({ purchaseRequest })

    // REVIEW [2026-12-15] Se a decisão escalada aprovou a solicitação...
    if (purchaseRequest.status == Approved) {
      // REVIEW [2026-12-15] ...encerra no desfecho de sucesso.
      return Approved
    }

    // REVIEW [2026-12-15] Sem aprovação, encerra no desfecho de rejeição.
    return Rejected
  }

  // REVIEW [2026-12-15] Declara o desfecho de sucesso do caso.
  end Approved {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Compra aprovada", en: "Purchase approved" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }

  // REVIEW [2026-12-15] Declara o desfecho de falha do caso.
  end Rejected {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Compra rejeitada", en: "Purchase rejected" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: failure
  }
}

// REVIEW [2026-12-15] Forma de classificação das alçadas de aprovação.
shape ApproverTier {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Alçada de aprovação", en: "Approval tier" }
  // REVIEW [2026-12-15] Base da forma: classificação.
  base: classification
  // REVIEW [2026-12-15] Alçada automática, sem decisão humana.
  value Auto {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Automática", en: "Automatic" }
    // REVIEW [2026-12-15] Ícone associado à alçada.
    icon: Auto
    // REVIEW [2026-12-15] Ordem de exibição da alçada.
    ordinal: 10
  }
  // REVIEW [2026-12-15] Alçada da gerência.
  value Manager {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Gerência", en: "Manager" }
    // REVIEW [2026-12-15] Ícone associado à alçada.
    icon: Manager
    // REVIEW [2026-12-15] Ordem de exibição da alçada.
    ordinal: 20
  }
  // REVIEW [2026-12-15] Alçada da diretoria.
  value Director {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Diretoria", en: "Director" }
    // REVIEW [2026-12-15] Ícone associado à alçada.
    icon: Director
    // REVIEW [2026-12-15] Ordem de exibição da alçada.
    ordinal: 30
  }
}

// REVIEW [2026-12-15] Form de decisão de aprovação apresentado ao aprovador.
form ApprovalDecision {
  // REVIEW [2026-12-15] Título exibido na tarefa e no formulário.
  title: { pt-BR: "Decisão de aprovação", en: "Approval decision" }
  // REVIEW [2026-12-15] Documento manipulado pelo form.
  document: PurchaseRequest
  // REVIEW [2026-12-15] Papéis que podem atender a tarefa.
  roles: [Approver, ProcurementManager]
  // REVIEW [2026-12-15] Prazo para responder; estourar dispara Timeout.
  timeout: 2d
  // REVIEW [2026-12-15] Prioridade da tarefa na inbox.
  priority: 50
  // REVIEW [2026-12-15] Modo de atribuição: o usuário puxa a tarefa.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Valor da compra, somente leitura.
    amount { readonly }
    // REVIEW [2026-12-15] Fornecedor da compra, somente leitura.
    supplier { readonly }
    // REVIEW [2026-12-15] Justificativa da compra, somente leitura.
    justification { readonly }
    // REVIEW [2026-12-15] Motivo da rejeição, preenchido quando o aprovador rejeita.
    rejectionReason
  }

  // REVIEW [2026-12-15] Ações disponíveis no formulário.
  actions {
    // REVIEW [2026-12-15] Aprova chamando a ação de aprovação da solicitação.
    approved { calls: PurchaseRequest.approve }
    // REVIEW [2026-12-15] Rejeita chamando a ação de rejeição com o motivo informado.
    rejected { calls: PurchaseRequest.reject(rejectionReason) }
  }
}

// REVIEW [2026-12-15] Decisão que calcula a alçada de aprovação a partir da política de compras.
decision ApprovalLimit {
  // REVIEW [2026-12-15] Título exibido no builder e na documentação da decisão.
  title: { pt-BR: "Alçada de aprovação de compra", en: "Purchase approval limit" }
  // REVIEW [2026-12-15] Tipo devolvido pela decisão.
  returns: ApproverTier
  // REVIEW [2026-12-15] Entradas necessárias para avaliar a alçada.
  inputs {
    // REVIEW [2026-12-15] Valor da compra a avaliar.
    amount: std.Money
    // REVIEW [2026-12-15] Fornecedor da compra a avaliar.
    supplier: Supplier
  }
  // REVIEW [2026-12-15] Casos avaliados em ordem até o primeiro que casar.
  cases {
    // REVIEW [2026-12-15] Até cinco mil reais, a aprovação é automática.
    amount <= 5000 BRL -> Auto
    // REVIEW [2026-12-15] Até cinquenta mil, com fornecedor de risco baixo, decide a gerência.
    amount <= 50000 BRL and supplier != null and supplier.risk == Low -> Manager
    // REVIEW [2026-12-15] Demais casos vão para a diretoria.
    else -> Director
  }
  // REVIEW [2026-12-15] Fonte normativa da política aplicada.
  source: "Política de Compras v3"
  // REVIEW [2026-12-15] Área responsável pela política.
  owner: "Procurement"
}
