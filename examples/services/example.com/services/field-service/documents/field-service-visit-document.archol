// REVIEW [2026-12-15] service: example.com/services/field-service

// REVIEW [2026-12-15] Documento que representa uma visita técnica executada em um site.
document Visit {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Visita técnica", en: "Visit" }
  // REVIEW [2026-12-15] Versão do artefato; diff e release comparam.
  // REVIEW [2026-12-15] Responsável pela manutenção do documento.
  // REVIEW [2026-12-15] Sincronização em tempo real entre os usuários da operação.
  sync: live
  // REVIEW [2026-12-15] Prazo de retenção dos registros da visita.
  retention: 5y

  // REVIEW [2026-12-15] Campos que compõem a visita.
  fields {
    // REVIEW [2026-12-15] Número da visita; consultável, único e curto.
    number: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Número", en: "Number" }
      // REVIEW [2026-12-15] Permite localizar a visita pelo número.
      lookup
      // REVIEW [2026-12-15] Impede duas visitas com o mesmo número.
      unique
      // REVIEW [2026-12-15] Limita o número a vinte e quatro caracteres.
      maxLength: 24
    }
    // REVIEW [2026-12-15] Ordem de serviço que originou a visita.
    workOrder: WorkOrder { title: { pt-BR: "Ordem de serviço", en: "Work order" }, lookup }
    // REVIEW [2026-12-15] Site em que a visita será realizada.
    site: Site { title: { pt-BR: "Site", en: "Site" }, lookup }
    // REVIEW [2026-12-15] Cliente atendido na visita.
    customer: Identity.User { title: { pt-BR: "Cliente", en: "Customer" }, lookup }
    // REVIEW [2026-12-15] Técnico designado para a visita.
    technician: Technician { title: { pt-BR: "Técnico", en: "Technician" }, lookup }
    // REVIEW [2026-12-15] Situação atual da visita no seu ciclo de vida.
    status: VisitStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    // REVIEW [2026-12-15] Início da janela combinada com o cliente.
    windowStart: DateTime { title: { pt-BR: "Janela de", en: "Window from" }, lookup }
    // REVIEW [2026-12-15] Fim da janela combinada com o cliente.
    windowEnd: DateTime { title: { pt-BR: "Janela até", en: "Window to" } }
    // REVIEW [2026-12-15] Instante em que a visita foi despachada, preenchido pelo sistema.
    dispatchedAt: DateTime { title: { pt-BR: "Despachada em", en: "Dispatched at" }, readonly }
    // REVIEW [2026-12-15] Instante do check-in do técnico, preenchido pelo sistema.
    checkedInAt: DateTime { title: { pt-BR: "Check-in em", en: "Checked in at" }, readonly }
    // REVIEW [2026-12-15] Coordenadas capturadas no check-in por localização.
    checkInPoint: GeoPoint { title: { pt-BR: "Check-in por localização", en: "Check-in location" } }
    // REVIEW [2026-12-15] Instante da conclusão da visita, preenchido pelo sistema.
    completedAt: DateTime { title: { pt-BR: "Concluída em", en: "Completed at" }, readonly }
    // REVIEW [2026-12-15] Instante em que o cliente confirmou a janela combinada.
    windowAcknowledgedAt: DateTime {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Janela confirmada em", en: "Window acknowledged at" }
      // REVIEW [2026-12-15] Preenchido apenas pelo sistema.
      readonly
    }
    // REVIEW [2026-12-15] Desfecho registrado ao concluir a visita.
    outcome: VisitOutcome { title: { pt-BR: "Desfecho", en: "Outcome" }, lookup }
    // REVIEW [2026-12-15] Nome de quem assinou a conclusão da visita.
    signedBy: string { title: { pt-BR: "Assinado por", en: "Signed by" }, maxLength: 120 }
    // REVIEW [2026-12-15] Motivo de falha ou de cancelamento da visita.
    reason: string { title: { pt-BR: "Motivo", en: "Reason" }, maxLength: 500 }
    // REVIEW [2026-12-15] Anotações livres feitas pelo técnico ou pelo cliente.
    notes: string { title: { pt-BR: "Anotações", en: "Notes" }, maxLength: 1000 }
    // REVIEW [2026-12-15] Quantidade de reagendamentos já sofridos pela visita.
    rescheduleCount: std.Count { title: { pt-BR: "Reagendamentos", en: "Reschedules" } }
  }

  // REVIEW [2026-12-15] Índices que aceleram as consultas sobre o documento.
  indexes {
    // REVIEW [2026-12-15] Busca exata pelo número, garantindo unicidade no banco.
    byNumber: [number] unique
    // REVIEW [2026-12-15] Consulta por situação e início de janela em faixa.
    byStatus: [status, windowStart] range
    // REVIEW [2026-12-15] Consulta por técnico, usando o identificador como hash.
    byTechnician: [technician.id] hash
    // REVIEW [2026-12-15] Consulta por site, usando o identificador como hash.
    bySite: [site.id] hash
  }


  // REVIEW [2026-12-15] Papéis exigidos para assinar a conclusão da visita.
  signature {
    // REVIEW [2026-12-15] A conclusão da visita exige assinatura do técnico de campo.
    complete: FieldTechnician
  }

  // REVIEW [2026-12-15] Ações que fazem a visita avançar no seu ciclo de vida.
  actions {
    // REVIEW [2026-12-15] Agenda a visita, definindo técnico e janela.
    schedule(assignedTechnician: Technician, windowFrom: DateTime, windowTo: DateTime) {
      // REVIEW [2026-12-15] Título exibido no botão e no histórico.
      title: { pt-BR: "Agendar visita", en: "Schedule visit" }
      // REVIEW [2026-12-15] Somente o despachante pode agendar.
      roles: [Dispatcher]
      // REVIEW [2026-12-15] Efeito da ação: grava técnico e janela no documento.
      {
        // REVIEW [2026-12-15] Técnico designado para a visita.
        technician = assignedTechnician
        // REVIEW [2026-12-15] Início da janela combinada.
        windowStart = windowFrom
        // REVIEW [2026-12-15] Fim da janela combinada.
        windowEnd = windowTo
      }
    }

    // REVIEW [2026-12-15] Reagenda a visita para uma nova janela.
    reschedule(newWindowStart: DateTime, newWindowEnd: DateTime) {
      // REVIEW [2026-12-15] Título exibido no botão e no histórico.
      title: { pt-BR: "Reagendar visita", en: "Reschedule visit" }
      // REVIEW [2026-12-15] Somente o despachante pode reagendar.
      roles: [Dispatcher]
      // REVIEW [2026-12-15] Volta a visita para o estado Scheduled.
      to: status.Scheduled
      // REVIEW [2026-12-15] Emite o evento com a nova janela.
      emits { windowStart: newWindowStart; windowEnd: newWindowEnd }
      // REVIEW [2026-12-15] Efeito da ação: grava a nova janela e conta o reagendamento.
      {
        // REVIEW [2026-12-15] Nova janela: início.
        windowStart = newWindowStart
        // REVIEW [2026-12-15] Nova janela: fim.
        windowEnd = newWindowEnd
        // REVIEW [2026-12-15] Incrementa o contador de reagendamentos.
        rescheduleCount = rescheduleCount + 1
      }
    }

    // REVIEW [2026-12-15] Despacha a visita para o técnico.
    dispatch() {
      // REVIEW [2026-12-15] Título exibido no botão e no histórico.
      title: { pt-BR: "Despachar visita", en: "Dispatch visit" }
      // REVIEW [2026-12-15] Somente o despachante pode despachar.
      roles: [Dispatcher]
      // REVIEW [2026-12-15] Transição para o estado Dispatched.
      to: status.Dispatched
      // REVIEW [2026-12-15] Emite o evento com o instante do despacho.
      emits { at: now() }
      // REVIEW [2026-12-15] Registra o instante do despacho no documento.
      { dispatchedAt = now() }
    }

    // REVIEW [2026-12-15] Registra a chegada do técnico ao site.
    checkIn(point: GeoPoint) {
      // REVIEW [2026-12-15] Título exibido no botão e no histórico.
      title: { pt-BR: "Check-in no site", en: "Check in on site" }
      // REVIEW [2026-12-15] Somente o técnico de campo pode fazer check-in.
      roles: [FieldTechnician]
      // REVIEW [2026-12-15] Transição para o estado OnSite.
      to: status.OnSite
      // REVIEW [2026-12-15] Emite o evento com o instante do check-in.
      emits { at: now() }
      // REVIEW [2026-12-15] Grava o instante e o local do check-in.
      { checkedInAt = now(); checkInPoint = point }
    }

    // REVIEW [2026-12-15] Conclui a visita com desfecho e assinatura.
    complete(visitOutcome: VisitOutcome, signedByName: string) {
      // REVIEW [2026-12-15] Título exibido no botão e no histórico.
      title: { pt-BR: "Concluir visita", en: "Complete visit" }
      // REVIEW [2026-12-15] Somente o técnico de campo pode concluir.
      roles: [FieldTechnician]
      // REVIEW [2026-12-15] Transição para o estado Completed.
      to: status.Completed
      // REVIEW [2026-12-15] Emite o evento com desfecho e assinatura.
      emits { outcome: visitOutcome; signedBy: signedByName }
      // REVIEW [2026-12-15] Efeito da ação: grava desfecho, assinatura e instante.
      {
        // REVIEW [2026-12-15] Desfecho registrado na conclusão.
        outcome = visitOutcome
        // REVIEW [2026-12-15] Nome de quem assinou a conclusão.
        signedBy = signedByName
        // REVIEW [2026-12-15] Instante da conclusão.
        completedAt = now()
      }
    }

    // REVIEW [2026-12-15] Registra a falha da visita.
    fail(failureReason: string) {
      // REVIEW [2026-12-15] Título exibido no botão e no histórico.
      title: { pt-BR: "Registrar falha", en: "Report failure" }
      // REVIEW [2026-12-15] Técnico ou despachante podem registrar a falha.
      roles: [FieldTechnician, Dispatcher]
      // REVIEW [2026-12-15] Transição para o estado Failed.
      to: status.Failed
      // REVIEW [2026-12-15] Emite o evento com o motivo da falha.
      emits { reason: failureReason }
      // REVIEW [2026-12-15] Guarda o motivo da falha no documento.
      { reason = failureReason }
    }

    // REVIEW [2026-12-15] Cancela a visita a pedido do cliente ou do despachante.
    withdraw(withdrawReason: string) {
      // REVIEW [2026-12-15] Título exibido no botão e no histórico.
      title: { pt-BR: "Cancelar visita", en: "Withdraw visit" }
      // REVIEW [2026-12-15] Cliente ou despachante podem cancelar.
      roles: [Customer, Dispatcher]
      // REVIEW [2026-12-15] Transição para o estado Failed.
      to: status.Failed
      // REVIEW [2026-12-15] Emite o evento com o motivo do cancelamento.
      emits { reason: withdrawReason }
      // REVIEW [2026-12-15] Guarda o motivo do cancelamento no documento.
      { reason = withdrawReason }
    }

    // REVIEW [2026-12-15] Salva uma anotação na visita.
    saveNote(note: string) {
      // REVIEW [2026-12-15] Título exibido no botão e no histórico.
      title: { pt-BR: "Salvar anotação", en: "Save note" }
      // REVIEW [2026-12-15] Somente o técnico de campo pode anotar.
      roles: [FieldTechnician]
      // REVIEW [2026-12-15] Grava a anotação no campo de notas.
      { notes = note }
    }

    // REVIEW [2026-12-15] Confirma a janela combinada, com anotação opcional do cliente.
    acknowledgeWindow(note: string) {
      // REVIEW [2026-12-15] Título exibido no botão e no histórico.
      title: { pt-BR: "Confirmar janela", en: "Acknowledge window" }
      // REVIEW [2026-12-15] Somente o cliente pode confirmar a janela.
      roles: [Customer]
      // REVIEW [2026-12-15] Grava o instante da confirmação e a observação do cliente.
      { windowAcknowledgedAt = now(); notes = note }
    }
  }
}

// REVIEW [2026-12-15] Máquina de estados do ciclo de vida da visita.
shape VisitStatus {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Situação da visita", en: "Visit status" }
  // REVIEW [2026-12-15] Base da forma: máquina de estados.
  base: state
  // REVIEW [2026-12-15] Estado em que toda visita começa.
  initial: Scheduled

  // REVIEW [2026-12-15] Estado de visita agendada, aguardando despacho.
  value Scheduled {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Agendada", en: "Scheduled" }
    // REVIEW [2026-12-15] Ícone exibido no status.
    icon: status.scheduled
    // REVIEW [2026-12-15] Ordem de exibição entre os estados.
    ordinal: 10

    // REVIEW [2026-12-15] Transição para o estado Dispatched.
    transition Dispatched {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Visita despachada", en: "Visit dispatched" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Instante do despacho.
        at: DateTime { title: { pt-BR: "Em", en: "At" } }
      }
    }

    // REVIEW [2026-12-15] Transição para o estado Failed.
    transition Failed {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Visita falhou", en: "Visit failed" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Motivo da falha.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }

    // REVIEW [2026-12-15] Transição para o estado Failed quando a visita é cancelada.
    transition Failed {
      // REVIEW [2026-12-15] Nome do evento que distingue o cancelamento.
      event: Withdrawn
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Visita cancelada", en: "Visit withdrawn" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Motivo do cancelamento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado de visita entregue ao técnico.
  value Dispatched {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Despachada", en: "Dispatched" }
    // REVIEW [2026-12-15] Ícone exibido no status.
    icon: status.dispatched
    // REVIEW [2026-12-15] Ordem de exibição entre os estados.
    ordinal: 20

    // REVIEW [2026-12-15] Transição para o estado OnSite quando o técnico faz check-in.
    transition OnSite {
      // REVIEW [2026-12-15] Nome do evento emitido na entrada do estado.
      event: CheckedIn
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Check-in no site", en: "Checked in" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Instante do check-in.
        at: DateTime { title: { pt-BR: "Em", en: "At" } }
        // REVIEW [2026-12-15] Local capturado no check-in.
        point: GeoPoint { title: { pt-BR: "Local", en: "Location" } }
      }
    }

    // REVIEW [2026-12-15] Transição para o estado Failed.
    transition Failed {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Visita falhou", en: "Visit failed" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Motivo da falha.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }

    // REVIEW [2026-12-15] Transição para o estado Failed quando a visita é cancelada.
    transition Failed {
      // REVIEW [2026-12-15] Nome do evento que distingue o cancelamento.
      event: Withdrawn
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Visita cancelada", en: "Visit withdrawn" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Motivo do cancelamento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado de técnico presente no site.
  value OnSite {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "No local", en: "On site" }
    // REVIEW [2026-12-15] Ícone exibido no status.
    icon: status.onSite
    // REVIEW [2026-12-15] Ordem de exibição entre os estados.
    ordinal: 30

    // REVIEW [2026-12-15] Transição para o estado Completed.
    transition Completed {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Visita concluída", en: "Visit completed" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Desfecho registrado na conclusão.
        outcome: VisitOutcome { title: { pt-BR: "Desfecho", en: "Outcome" } }
        // REVIEW [2026-12-15] Nome de quem assinou a conclusão.
        signedBy: string { title: { pt-BR: "Assinado por", en: "Signed by" } }
      }
    }

    // REVIEW [2026-12-15] Transição para o estado Failed.
    transition Failed {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Visita falhou", en: "Visit failed" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Motivo da falha.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado final de visita concluída.
  value Completed {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Concluída", en: "Completed" }
    // REVIEW [2026-12-15] Ícone exibido no status.
    icon: status.completed
    // REVIEW [2026-12-15] Ordem de exibição entre os estados.
    ordinal: 40
  }
  // REVIEW [2026-12-15] Estado de visita que falhou ou foi cancelada.
  value Failed {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Falhou", en: "Failed" }
    // REVIEW [2026-12-15] Ícone exibido no status.
    icon: status.failed
    // REVIEW [2026-12-15] Ordem de exibição entre os estados.
    ordinal: 50

    // REVIEW [2026-12-15] Transição de volta para Scheduled quando a visita é reagendada.
    transition Scheduled {
      // REVIEW [2026-12-15] Nome do evento emitido na entrada do estado.
      event: Rescheduled
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Visita reagendada", en: "Visit rescheduled" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Início da nova janela combinada.
        windowStart: DateTime { title: { pt-BR: "Nova janela de", en: "New window from" } }
        // REVIEW [2026-12-15] Fim da nova janela combinada.
        windowEnd: DateTime { title: { pt-BR: "Nova janela até", en: "New window to" } }
      }
    }

    // REVIEW [2026-12-15] Transição para o estado Failed quando a visita é cancelada.
    transition Failed {
      // REVIEW [2026-12-15] Nome do evento que distingue o cancelamento.
      event: Withdrawn
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Visita cancelada", en: "Visit withdrawn" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Motivo do cancelamento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
}

// REVIEW [2026-12-15] Classificação do desfecho de uma visita concluída.
shape VisitOutcome {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Desfecho da visita", en: "Visit outcome" }
  // REVIEW [2026-12-15] Base da forma: classificação fechada de valores.
  base: classification

  // REVIEW [2026-12-15] Problema resolvido no local.
  value Fixed {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Resolvido", en: "Fixed" }
    // REVIEW [2026-12-15] Ícone exibido na classificação.
    icon: outcome.fixed
    // REVIEW [2026-12-15] Ordem de exibição entre os valores.
    ordinal: 10
  }
  // REVIEW [2026-12-15] Atendimento que depende de peças.
  value NeedsParts {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Aguardando peças", en: "Needs parts" }
    // REVIEW [2026-12-15] Ícone exibido na classificação.
    icon: outcome.needsParts
    // REVIEW [2026-12-15] Ordem de exibição entre os valores.
    ordinal: 20
  }
  // REVIEW [2026-12-15] Equipamento sem possibilidade de reparo.
  value NotRepairable {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Sem reparo", en: "Not repairable" }
    // REVIEW [2026-12-15] Ícone exibido na classificação.
    icon: outcome.notRepairable
    // REVIEW [2026-12-15] Ordem de exibição entre os valores.
    ordinal: 30
  }
  // REVIEW [2026-12-15] Cliente ausente no momento da visita.
  value CustomerAbsent {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Cliente ausente", en: "Customer absent" }
    // REVIEW [2026-12-15] Ícone exibido na classificação.
    icon: outcome.customerAbsent
    // REVIEW [2026-12-15] Ordem de exibição entre os valores.
    ordinal: 40
  }
}
