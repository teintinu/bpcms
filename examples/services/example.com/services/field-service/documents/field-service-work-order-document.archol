// REVIEW [2026-12-15] service: example.com/services/field-service

// REVIEW [2026-12-15] Documento que representa uma ordem de serviço solicitada pelo cliente.
document WorkOrder {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Ordem de serviço", en: "Work order" }
  // REVIEW [2026-12-15] Versão do artefato; diff e release comparam.
  // REVIEW [2026-12-15] Responsável pela manutenção do documento.
  owner: "Field Service"
  // REVIEW [2026-12-15] Sincronização em tempo real entre os usuários da operação.
  sync: live

  // REVIEW [2026-12-15] Campos que compõem a ordem de serviço.
  fields {
    // REVIEW [2026-12-15] Número da ordem; consultável, único e curto.
    number: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Número", en: "Number" }
      // REVIEW [2026-12-15] Permite localizar a ordem pelo número.
      lookup
      // REVIEW [2026-12-15] Impede duas ordens com o mesmo número.
      unique
      // REVIEW [2026-12-15] Limita o número a vinte e quatro caracteres.
      maxLength: 24
    }
    // REVIEW [2026-12-15] Site onde o serviço será executado.
    site: Site { title: { pt-BR: "Site", en: "Site" }, lookup }
    // REVIEW [2026-12-15] Cliente que solicitou a ordem.
    customer: Identity.User { title: { pt-BR: "Cliente", en: "Customer" }, lookup }
    // REVIEW [2026-12-15] Prioridade de atendimento; padrão é Normal.
    priority: WorkOrderPriority {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Prioridade", en: "Priority" }
      // REVIEW [2026-12-15] Permite localizar a ordem pela prioridade.
      lookup
      // REVIEW [2026-12-15] Prioridade assumida quando não informada.
      default: Normal
    }
    // REVIEW [2026-12-15] Descrição do problema ou do serviço pedido.
    description: string { title: { pt-BR: "Descrição", en: "Description" }, maxLength: 1000 }
    // REVIEW [2026-12-15] Situação atual da ordem no seu ciclo de vida.
    status: WorkOrderStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    // REVIEW [2026-12-15] Técnico designado para executar a ordem.
    technician: Technician { title: { pt-BR: "Técnico", en: "Technician" } }
    // REVIEW [2026-12-15] Instante de abertura da ordem, preenchido pelo sistema.
    openedAt: DateTime { title: { pt-BR: "Aberta em", en: "Opened at" }, readonly }
    // REVIEW [2026-12-15] Prazo combinado para a conclusão da ordem.
    dueAt: DateTime { title: { pt-BR: "Prazo", en: "Due at" } }
    // REVIEW [2026-12-15] Motivo registrado quando a ordem é cancelada.
    cancelReason: string { title: { pt-BR: "Motivo do cancelamento", en: "Cancellation reason" }, maxLength: 500 }
  }

  // REVIEW [2026-12-15] Índices que aceleram as consultas sobre o documento.
  indexes {
    // REVIEW [2026-12-15] Busca exata pelo número, garantindo unicidade no banco.
    byNumber: [number] unique
    // REVIEW [2026-12-15] Consulta por situação e prazo em faixa.
    byStatus: [status, dueAt] range
    // REVIEW [2026-12-15] Consulta por site, usando o identificador como hash.
    bySite: [site.id] hash
  }


  // REVIEW [2026-12-15] Ações que fazem a ordem avançar no seu ciclo de vida.
  actions {
    // REVIEW [2026-12-15] Atribui um técnico à ordem.
    assign(assignedTechnician: Technician) {
      // REVIEW [2026-12-15] Título exibido no botão e no histórico.
      title: { pt-BR: "Atribuir técnico", en: "Assign technician" }
      // REVIEW [2026-12-15] Somente o despachante pode atribuir.
      roles: [Dispatcher]
      // REVIEW [2026-12-15] Transição para o estado Assigned.
      to: status.Assigned
      // REVIEW [2026-12-15] Emite o evento levando o técnico designado.
      emits { technician: assignedTechnician }
      // REVIEW [2026-12-15] Guarda o técnico no documento.
      { technician = assignedTechnician }
    }

    // REVIEW [2026-12-15] Inicia a execução da ordem.
    start() {
      // REVIEW [2026-12-15] Título exibido no botão e no histórico.
      title: { pt-BR: "Iniciar execução", en: "Start work" }
      // REVIEW [2026-12-15] Técnico ou despachante podem iniciar.
      roles: [FieldTechnician, Dispatcher]
      // REVIEW [2026-12-15] Transição para o estado InProgress.
      to: status.InProgress
      // REVIEW [2026-12-15] Emite o evento com o instante do início.
      emits { at: now() }
    }

    // REVIEW [2026-12-15] Conclui a ordem.
    finish() {
      // REVIEW [2026-12-15] Título exibido no botão e no histórico.
      title: { pt-BR: "Concluir ordem", en: "Finish work order" }
      // REVIEW [2026-12-15] Despachante ou supervisor podem concluir.
      roles: [Dispatcher, Supervisor]
      // REVIEW [2026-12-15] Transição para o estado Done.
      to: status.Done
      // REVIEW [2026-12-15] Emite o evento com o instante da conclusão.
      emits { at: now() }
    }

    // REVIEW [2026-12-15] Cancela a ordem com um motivo obrigatório.
    cancel(reason: string) {
      // REVIEW [2026-12-15] Título exibido no botão e no histórico.
      title: { pt-BR: "Cancelar ordem", en: "Cancel work order" }
      // REVIEW [2026-12-15] Somente o supervisor pode cancelar.
      roles: [Supervisor]
      // REVIEW [2026-12-15] Transição para o estado Cancelled.
      to: status.Cancelled
      // REVIEW [2026-12-15] Guarda o motivo no documento.
      { cancelReason = reason }
    }
  }
}

// REVIEW [2026-12-15] Máquina de estados do ciclo de vida da ordem de serviço.
shape WorkOrderStatus {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Situação da ordem de serviço", en: "Work order status" }
  // REVIEW [2026-12-15] Base da forma: máquina de estados.
  base: state
  // REVIEW [2026-12-15] Estado em que toda ordem começa.
  initial: Open

  // REVIEW [2026-12-15] Estado de ordem recém-aberta.
  value Open {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Aberta", en: "Open" }
    // REVIEW [2026-12-15] Ícone exibido no status.
    icon: status.open
    // REVIEW [2026-12-15] Ordem de exibição entre os estados.
    ordinal: 10

    // REVIEW [2026-12-15] Transição para o estado Assigned.
    transition Assigned {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Ordem atribuída", en: "Work order assigned" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Técnico designado para a ordem.
        technician: Technician { title: { pt-BR: "Técnico", en: "Technician" } }
      }
    }

    // REVIEW [2026-12-15] Transição para o estado Cancelled.
    transition Cancelled {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Ordem cancelada", en: "Work order cancelled" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Motivo do cancelamento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado de ordem com técnico designado.
  value Assigned {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Atribuída", en: "Assigned" }
    // REVIEW [2026-12-15] Ícone exibido no status.
    icon: status.assigned
    // REVIEW [2026-12-15] Ordem de exibição entre os estados.
    ordinal: 20

    // REVIEW [2026-12-15] Transição para o estado InProgress.
    transition InProgress {
      // REVIEW [2026-12-15] Nome do evento emitido na entrada do estado.
      event: Started
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Ordem iniciada", en: "Work order started" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Instante do início da execução.
        at: DateTime { title: { pt-BR: "Em", en: "At" } }
      }
    }

    // REVIEW [2026-12-15] Transição para o estado Cancelled.
    transition Cancelled {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Ordem cancelada", en: "Work order cancelled" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Motivo do cancelamento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado de ordem em execução.
  value InProgress {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Em execução", en: "In progress" }
    // REVIEW [2026-12-15] Ícone exibido no status.
    icon: status.inProgress
    // REVIEW [2026-12-15] Ordem de exibição entre os estados.
    ordinal: 30

    // REVIEW [2026-12-15] Transição para o estado Done.
    transition Done {
      // REVIEW [2026-12-15] Nome do evento emitido na entrada do estado.
      event: Finished
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Ordem concluída", en: "Work order finished" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Instante da conclusão.
        at: DateTime { title: { pt-BR: "Em", en: "At" } }
      }
    }

    // REVIEW [2026-12-15] Transição para o estado Cancelled.
    transition Cancelled {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Ordem cancelada", en: "Work order cancelled" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Motivo do cancelamento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado final de ordem concluída.
  value Done {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Concluída", en: "Done" }
    // REVIEW [2026-12-15] Ícone exibido no status.
    icon: status.done
    // REVIEW [2026-12-15] Ordem de exibição entre os estados.
    ordinal: 40
  }
  // REVIEW [2026-12-15] Estado final de ordem cancelada.
  value Cancelled {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Cancelada", en: "Cancelled" }
    // REVIEW [2026-12-15] Ícone exibido no status.
    icon: status.cancelled
    // REVIEW [2026-12-15] Ordem de exibição entre os estados.
    ordinal: 50
  }
}

// REVIEW [2026-12-15] Classificação da prioridade de atendimento da ordem.
shape WorkOrderPriority {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Prioridade da ordem", en: "Work order priority" }
  // REVIEW [2026-12-15] Base da forma: classificação fechada de valores.
  base: classification

  // REVIEW [2026-12-15] Prioridade baixa.
  value Low {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Baixa", en: "Low" }
    // REVIEW [2026-12-15] Ícone exibido na classificação.
    icon: priority.low
    // REVIEW [2026-12-15] Ordem de exibição entre os valores.
    ordinal: 10
  }
  // REVIEW [2026-12-15] Prioridade normal.
  value Normal {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Normal", en: "Normal" }
    // REVIEW [2026-12-15] Ícone exibido na classificação.
    icon: priority.normal
    // REVIEW [2026-12-15] Ordem de exibição entre os valores.
    ordinal: 20
  }
  // REVIEW [2026-12-15] Prioridade alta.
  value High {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Alta", en: "High" }
    // REVIEW [2026-12-15] Ícone exibido na classificação.
    icon: priority.high
    // REVIEW [2026-12-15] Ordem de exibição entre os valores.
    ordinal: 30
  }
  // REVIEW [2026-12-15] Prioridade urgente.
  value Urgent {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Urgente", en: "Urgent" }
    // REVIEW [2026-12-15] Ícone exibido na classificação.
    icon: priority.urgent
    // REVIEW [2026-12-15] Ordem de exibição entre os valores.
    ordinal: 40
  }
}
