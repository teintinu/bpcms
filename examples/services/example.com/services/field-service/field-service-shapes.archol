// service: example.com/services/field-service

// Forma reutilizável que representa um ponto geográfico.
shape GeoPoint {
  // Título exibido na interface.
  title: { pt-BR: "Ponto geográfico", en: "Geo point" }

  // Campos que compõem o ponto geográfico.
  fields {
    // Latitude em graus decimais.
    lat: number { title: { pt-BR: "Latitude", en: "Latitude" } }
    // Longitude em graus decimais.
    lng: number { title: { pt-BR: "Longitude", en: "Longitude" } }
    // Margem de erro da leitura de GPS, em metros.
    accuracy: number { title: { pt-BR: "Precisão (m)", en: "Accuracy (m)" } }
  }
}
