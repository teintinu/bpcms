// REVIEW [2026-12-15] service: example.com/services/field-service

// REVIEW [2026-12-15] Forma reutilizável que representa um ponto geográfico.
shape GeoPoint {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Ponto geográfico", en: "Geo point" }

  // REVIEW [2026-12-15] Campos que compõem o ponto geográfico.
  fields {
    // REVIEW [2026-12-15] Latitude em graus decimais.
    lat: number { title: { pt-BR: "Latitude", en: "Latitude" } }
    // REVIEW [2026-12-15] Longitude em graus decimais.
    lng: number { title: { pt-BR: "Longitude", en: "Longitude" } }
    // REVIEW [2026-12-15] Margem de erro da leitura de GPS, em metros.
    accuracy: number { title: { pt-BR: "Precisão (m)", en: "Accuracy (m)" } }
  }
}
