// REVIEW [2026-12-15] service: example.com/services/field-service

// REVIEW [2026-12-15] Organograma que define a hierarquia da operação de campo.
organogram FieldOperations {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Organograma de campo", en: "Field operations organogram" }

  // REVIEW [2026-12-15] Relações de subordinação entre os papéis.
  hierarchy {
    // REVIEW [2026-12-15] Supervisor acima do despachante, que acima do técnico de campo.
    Supervisor > Dispatcher > FieldTechnician
    // REVIEW [2026-12-15] O despachante também atende o cliente.
    Dispatcher > Customer
  }

  // REVIEW [2026-12-15] Na ausência do supervisor por três dias, o despachante assume.
  Supervisor delegates to Dispatcher when absent for 3d

  // REVIEW [2026-12-15] Papéis cuja assinatura vale como aprovação formal.
  signature {
    // REVIEW [2026-12-15] O técnico de campo assina a conclusão do atendimento.
    FieldTechnician
  }
}

// REVIEW [2026-12-15] Papel que coordena e distribui o trabalho de campo.
role Dispatcher {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Despachante", en: "Dispatcher" }
  // REVIEW [2026-12-15] Permissões concedidas ao papel.
  permissions: [
    // REVIEW [2026-12-15] Consultar visitas.
    visit.view,
    // REVIEW [2026-12-15] Agendar visitas.
    visit.schedule,
    // REVIEW [2026-12-15] Reagendar visitas.
    visit.reschedule,
    // REVIEW [2026-12-15] Despachar visitas.
    visit.dispatch,
    // REVIEW [2026-12-15] Consultar ordens de serviço.
    workorder.view,
    // REVIEW [2026-12-15] Atribuir ordens de serviço.
    workorder.assign,
    // REVIEW [2026-12-15] Consultar técnicos.
    technician.view
  ]
}

// REVIEW [2026-12-15] Papel que executa o atendimento no local.
role FieldTechnician {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Técnico de campo", en: "Field technician" }
  // REVIEW [2026-12-15] Permissões concedidas ao papel.
  permissions: [
    // REVIEW [2026-12-15] Consultar visitas.
    visit.view,
    // REVIEW [2026-12-15] Fazer check-in no site.
    visit.checkin,
    // REVIEW [2026-12-15] Preencher o relatório da visita.
    visit.report,
    // REVIEW [2026-12-15] Consultar ordens de serviço.
    workorder.view,
    // REVIEW [2026-12-15] Iniciar a execução da ordem.
    workorder.start
  ]
}

// REVIEW [2026-12-15] Papel que supervisiona a operação e trata escalações.
role Supervisor {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Supervisor de campo", en: "Field supervisor" }
  // REVIEW [2026-12-15] Herda todas as permissões do despachante.
  inherits: Dispatcher
  // REVIEW [2026-12-15] Permissões adicionais do supervisor.
  permissions: [
    // REVIEW [2026-12-15] Escalar o atendimento de uma visita.
    visit.escalate,
    // REVIEW [2026-12-15] Concluir ordens de serviço.
    workorder.finish,
    // REVIEW [2026-12-15] Cancelar ordens de serviço.
    workorder.cancel,
    // REVIEW [2026-12-15] Gerenciar técnicos.
    technician.manage,
    // REVIEW [2026-12-15] Consultar relatórios.
    report.view
  ]
}

// REVIEW [2026-12-15] Papel do cliente que recebe o atendimento.
role Customer {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Cliente", en: "Customer" }
  // REVIEW [2026-12-15] Permissões restritas às próprias visitas.
  permissions: [visit.viewOwn, visit.confirm, visit.withdraw]
}
