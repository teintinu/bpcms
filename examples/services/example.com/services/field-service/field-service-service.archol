// REVIEW [2026-12-15] service: example.com/services/field-service
// REVIEW [2026-12-15] Declara o serviço de campo (field service) na URI do workspace.
service "example.com/services/field-service" {
  // REVIEW [2026-12-15] Título exibido no builder e na navegação.
  title: { pt-BR: "Serviço de campo", en: "Field service" }
  locales: [ "pt-BR", "en" ] // REVIEW [2026-12-18] Idiomas suportados pelo serviço; o primeiro é o default do I18N em forma de string.
  // REVIEW [2026-12-15] Versão do artefato; diff e release comparam.
  // REVIEW [2026-12-15] Responsável pela manutenção do serviço.

  // REVIEW [2026-12-15] Dependências externas trazidas para este serviço, sempre com alias.
  imports {
    // REVIEW [2026-12-15] Pseudo-serviço do construtor com medidas e constantes padrão (std.Count).
    service "bpcms.org/std" as std
    // REVIEW [2026-12-15] Usuários e pessoas usados nos campos de cliente e técnico.
    service "example.com/services/identity" as Identity
  }
}
