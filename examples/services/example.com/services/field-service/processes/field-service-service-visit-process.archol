// REVIEW [2026-12-15] service: example.com/services/field-service
// REVIEW [2026-12-15] Process: sintaxe atual (DSL_REFERENCE.md §4)

// REVIEW [2026-12-15] Declara o processo que conduz a visita até a conclusão no local.
process ServiceVisit(visit: Visit) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Atendimento da visita", en: "Service visit" }
  // REVIEW [2026-12-15] Versão do artefato Process; diff e release comparam.
  version: 1
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Executar a visita no local, com check-in por localização, assinatura do cliente e SLA"
  }
  // REVIEW [2026-12-15] SLA brando do caso: alvo de lead time, não é timer.
  sla: 3d

  // REVIEW [2026-12-15] Papéis responsáveis por operar o processo.
  by: [Dispatcher]

  // REVIEW [2026-12-15] Variável durável que registra se o agendamento foi concluído.
  let scheduled = false

  // REVIEW [2026-12-15] Bloco externo: captura timeout do caso e de qualquer form.
  try {
    // REVIEW [2026-12-15] Laço de tentativas de agendamento, limitado a três iterações.
    loop ScheduleAttempt max 3 {
      // REVIEW [2026-12-15] Tenta agendar a visita a cada iteração.
      try {
        // REVIEW [2026-12-15] Abre o form de agendamento para o despachante.
        VisitSchedule.show({ visit })
        // REVIEW [2026-12-15] Marca que o agendamento ocorreu.
        scheduled = true
        // REVIEW [2026-12-15] Sai do laço de tentativas.
        break
      } catch (Timeout) {
        // REVIEW [2026-12-15] on breach do agendamento: escala e tenta reagendar
        // REVIEW [2026-12-15] Abre o manual de escalação quando a janela do form expira.
        EscalateVisit.show({ visit })
      }
    }

    // REVIEW [2026-12-15] Se as três tentativas terminaram sem agendamento...
    if (scheduled == false) {
      // REVIEW [2026-12-15] ...encerra no desfecho NotCompleted.
      return NotCompleted
    }

    // REVIEW [2026-12-15] Laço do ciclo de execução da visita, limitado a três iterações.
    loop VisitCycle max 3 {
      // REVIEW [2026-12-15] Despacha a visita e a entrega ao técnico.
      Visit.dispatch()
      // REVIEW [2026-12-15] Abre o manual de deslocamento até o site.
      Travel.show({ visit })
      // REVIEW [2026-12-15] Abre o form de check-in no local.
      VisitCheckIn.show({ visit })
      // REVIEW [2026-12-15] Abre o form de relatório de campo.
      VisitFieldReport.show({ visit })

      // REVIEW [2026-12-15] Se o técnico concluiu a visita no relatório...
      if (visit.status == Completed) {
        // REVIEW [2026-12-15] ...encerra no desfecho de sucesso.
        return Completed
      }

      // REVIEW [2026-12-15] Tenta reagendar a visita que não foi concluída.
      try {
        // REVIEW [2026-12-15] Executa o subprocesso de reagendamento.
        VisitReschedule.run({ visit })
      } catch (Timeout) {
        // REVIEW [2026-12-15] timer de 3d do reagendamento: encerra como não concluída
        // REVIEW [2026-12-15] Reagendamento estourou o prazo: encerra sem conclusão.
        return NotCompleted
      }

      // REVIEW [2026-12-15] Se a visita foi cancelada durante o ciclo...
      if (visit.status == Failed) {
        // REVIEW [2026-12-15] ...encerra no desfecho de cancelamento.
        return Cancelled
      }
    }

    // REVIEW [2026-12-15] Esgotou o ciclo sem conclusão: encerra no desfecho NotCompleted.
    return NotCompleted
  } catch (Timeout) {
    // REVIEW [2026-12-15] on breach do caso: escala e encerra como não concluída
    // REVIEW [2026-12-15] Abre o manual de escalação quando o SLA do caso expira.
    EscalateVisit.show({ visit })
    // REVIEW [2026-12-15] Encerra o processo no desfecho de falha.
    return NotCompleted
  }

  // REVIEW [2026-12-15] Cancela a instância quando a visita recebe o evento Withdrawn.
  cancel on Visit.Withdrawn {
    // REVIEW [2026-12-15] Encerra o processo no desfecho de cancelamento.
    return Cancelled
  }

  // REVIEW [2026-12-15] Declara o desfecho de sucesso do caso.
  end Completed {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Visitada", en: "Completed" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }

  // REVIEW [2026-12-15] Declara o desfecho de falha do caso.
  end NotCompleted {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Não concluída", en: "Not completed" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: failure
  }

  // REVIEW [2026-12-15] Declara o desfecho de cancelamento do caso.
  end Cancelled {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Cancelada", en: "Cancelled" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: cancelled
  }
}

// REVIEW [2026-12-15] Form de agendamento da visita, preenchido pelo despachante.
form VisitSchedule {
  // REVIEW [2026-12-15] Título exibido no formulário e na inbox.
  title: { pt-BR: "Agendar visita", en: "Schedule visit" }
  // REVIEW [2026-12-15] Documento manipulado pelo form.
  document: Visit
  // REVIEW [2026-12-15] Papéis que podem preencher o form.
  roles: [Dispatcher]
  // REVIEW [2026-12-15] Prazo para preencher antes de estourar o timeout.
  timeout: 4h
  // REVIEW [2026-12-15] Distribuição por pull: o despachante assume o item da fila.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Técnico a designar na visita.
    technician
    // REVIEW [2026-12-15] Início da janela combinada.
    windowStart
    // REVIEW [2026-12-15] Fim da janela combinada.
    windowEnd
  }

  // REVIEW [2026-12-15] Ações do formulário.
  actions {
    // REVIEW [2026-12-15] Agenda a visita chamando a ação do documento com os campos informados.
    schedule { calls: Visit.schedule(technician, windowStart, windowEnd) }
  }
}

// REVIEW [2026-12-15] Form de check-in no site, preenchido pelo técnico.
form VisitCheckIn {
  // REVIEW [2026-12-15] Título exibido no formulário e na inbox.
  title: { pt-BR: "Check-in no site", en: "On-site check-in" }
  // REVIEW [2026-12-15] Documento manipulado pelo form.
  document: Visit
  // REVIEW [2026-12-15] Papéis que podem preencher o form.
  roles: [FieldTechnician]
  // REVIEW [2026-12-15] Prazo para fazer o check-in antes de estourar o timeout.
  timeout: 30m

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Local do check-in, capturado por GPS.
    point: GeoPoint {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Local do check-in", en: "Check-in location" }
      // REVIEW [2026-12-15] Torna o local obrigatório no preenchimento.
      required
    }
  }

  // REVIEW [2026-12-15] Ações do formulário.
  actions {
    // REVIEW [2026-12-15] Registra o check-in chamando a ação do documento com o ponto informado.
    checkIn { calls: Visit.checkIn(point) }
  }
}

// REVIEW [2026-12-15] Form de relatório de campo, preenchido pelo técnico após o atendimento.
form VisitFieldReport {
  // REVIEW [2026-12-15] Título exibido no formulário e na inbox.
  title: { pt-BR: "Relatório de campo", en: "Field report" }
  // REVIEW [2026-12-15] Documento manipulado pelo form.
  document: Visit
  // REVIEW [2026-12-15] Papéis que podem preencher o form.
  roles: [FieldTechnician]
  // REVIEW [2026-12-15] Prazo para preencher o relatório antes de estourar o timeout.
  timeout: 2h
  // REVIEW [2026-12-15] Prioridade do item na fila de trabalho.
  priority: 60
  // REVIEW [2026-12-15] Distribuição por pull: o técnico assume o item da fila.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Desfecho registrado na conclusão.
    outcome
    // REVIEW [2026-12-15] Nome de quem assina a conclusão.
    signedBy
    // REVIEW [2026-12-15] Motivo da falha, quando a visita não for concluída.
    reason: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Motivo da falha", en: "Failure reason" }
      // REVIEW [2026-12-15] Limita o motivo a quinhentos caracteres.
      maxLength: 500
    }
    // REVIEW [2026-12-15] Anotação livre do técnico.
    note: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Anotação", en: "Note" }
      // REVIEW [2026-12-15] Limita a anotação a mil caracteres.
      maxLength: 1000
    }
  }

  // REVIEW [2026-12-15] Ações do formulário.
  actions {
    // REVIEW [2026-12-15] Conclui a visita com desfecho e assinatura.
    complete { calls: Visit.complete(outcome, signedBy) }
    // REVIEW [2026-12-15] Registra a falha com o motivo informado.
    fail { calls: Visit.fail(reason) }
    // REVIEW [2026-12-15] Salva a anotação sem encerrar o form.
    save { calls: Visit.saveNote(note); stay }
  }
}

// REVIEW [2026-12-15] Manual que orienta o deslocamento do técnico até o site.
manual Travel {
  // REVIEW [2026-12-15] Título exibido na inbox e no histórico.
  title: { pt-BR: "Deslocamento até o site", en: "Travel to site" }
  // REVIEW [2026-12-15] Documento ao qual o manual se refere.
  document: Visit
  // REVIEW [2026-12-15] Papéis que podem executar o manual.
  roles: [FieldTechnician]
  // REVIEW [2026-12-15] Instrução exibida ao responsável pela tarefa.
  instructions: "Deslocar até o site com as peças separadas para o atendimento"
  // REVIEW [2026-12-15] Prazo para concluir a tarefa antes de estourar o timeout.
  timeout: 1h
}

// REVIEW [2026-12-15] Manual de escalação usado quando o agendamento ou o SLA falha.
manual EscalateVisit {
  // REVIEW [2026-12-15] Título exibido na inbox e no histórico.
  title: { pt-BR: "Escalar atendimento da visita", en: "Escalate service visit" }
  // REVIEW [2026-12-15] Documento ao qual o manual se refere.
  document: Visit
  // REVIEW [2026-12-15] Papéis que podem executar o manual.
  roles: [Supervisor]
  // REVIEW [2026-12-15] Instrução exibida ao supervisor escalado.
  instructions: "Falar com o despachante, renegociar a janela e registrar a decisão"
  // REVIEW [2026-12-15] Prazo para concluir a escalação antes de estourar o timeout.
  timeout: 1h
}
