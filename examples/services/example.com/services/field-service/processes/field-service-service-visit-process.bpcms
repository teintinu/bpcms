// service: example.com/services/field-service
// Process: sintaxe atual (DSL_REFERENCE.md §4)

// Declara o processo que conduz a visita até a conclusão no local.
process ServiceVisit(visit: Visit) {
  // Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Atendimento da visita", en: "Service visit" }
  // Versão do artefato Process; diff e release comparam.
  version: 1
  // Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // Texto do objetivo em português.
    pt-BR: "Executar a visita no local, com check-in por localização, assinatura do cliente e SLA"
  }
  // SLA brando do caso: alvo de lead time, não é timer.
  sla: 3d

  // Papéis responsáveis por operar o processo.
  by: [Dispatcher]

  // Variável durável que registra se o agendamento foi concluído.
  let scheduled = false

  // Bloco externo: captura timeout do caso e de qualquer form.
  try {
    // Laço de tentativas de agendamento, limitado a três iterações.
    loop ScheduleAttempt max 3 {
      // Tenta agendar a visita a cada iteração.
      try {
        // Abre o form de agendamento para o despachante.
        VisitSchedule.show({ visit })
        // Marca que o agendamento ocorreu.
        scheduled = true
        // Sai do laço de tentativas.
        break
      } catch (Timeout) {
        // on breach do agendamento: escala e tenta reagendar
        // Abre o manual de escalação quando a janela do form expira.
        EscalateVisit.show({ visit })
      }
    }

    // Se as três tentativas terminaram sem agendamento...
    if (scheduled == false) {
      // ...encerra no desfecho NotCompleted.
      return NotCompleted
    }

    // Laço do ciclo de execução da visita, limitado a três iterações.
    loop VisitCycle max 3 {
      // Despacha a visita e a entrega ao técnico.
      Visit.dispatch()
      // Abre o manual de deslocamento até o site.
      Travel.show({ visit })
      // Abre o form de check-in no local.
      VisitCheckIn.show({ visit })
      // Abre o form de relatório de campo.
      VisitFieldReport.show({ visit })

      // Se o técnico concluiu a visita no relatório...
      if (visit.status == Completed) {
        // ...encerra no desfecho de sucesso.
        return Completed
      }

      // Tenta reagendar a visita que não foi concluída.
      try {
        // Executa o subprocesso de reagendamento.
        VisitReschedule.run({ visit })
      } catch (Timeout) {
        // timer de 3d do reagendamento: encerra como não concluída
        // Reagendamento estourou o prazo: encerra sem conclusão.
        return NotCompleted
      }

      // Se a visita foi cancelada durante o ciclo...
      if (visit.status == Failed) {
        // ...encerra no desfecho de cancelamento.
        return Cancelled
      }
    }

    // Esgotou o ciclo sem conclusão: encerra no desfecho NotCompleted.
    return NotCompleted
  } catch (Timeout) {
    // on breach do caso: escala e encerra como não concluída
    // Abre o manual de escalação quando o SLA do caso expira.
    EscalateVisit.show({ visit })
    // Encerra o processo no desfecho de falha.
    return NotCompleted
  }

  // Cancela a instância quando a visita recebe o evento Withdrawn.
  cancel on Visit.Withdrawn {
    // Encerra o processo no desfecho de cancelamento.
    return Cancelled
  }

  // Declara o desfecho de sucesso do caso.
  end Completed {
    // Título exibido no histórico e nos filtros.
    title: { pt-BR: "Visitada", en: "Completed" }
    // Classificação do desfecho para KPI.
    outcome: success
  }

  // Declara o desfecho de falha do caso.
  end NotCompleted {
    // Título exibido no histórico.
    title: { pt-BR: "Não concluída", en: "Not completed" }
    // Classificação do desfecho para KPI.
    outcome: failure
  }

  // Declara o desfecho de cancelamento do caso.
  end Cancelled {
    // Título exibido no histórico.
    title: { pt-BR: "Cancelada", en: "Cancelled" }
    // Classificação do desfecho para KPI.
    outcome: cancelled
  }
}

// Form de agendamento da visita, preenchido pelo despachante.
form VisitSchedule {
  // Título exibido no formulário e na inbox.
  title: { pt-BR: "Agendar visita", en: "Schedule visit" }
  // Documento manipulado pelo form.
  document: Visit
  // Papéis que podem preencher o form.
  roles: [Dispatcher]
  // Prazo para preencher antes de estourar o timeout.
  timeout: 4h
  // Distribuição por pull: o despachante assume o item da fila.
  assign: pull

  // Campos exibidos no formulário.
  fields {
    // Técnico a designar na visita.
    technician
    // Início da janela combinada.
    windowStart
    // Fim da janela combinada.
    windowEnd
  }

  // Ações do formulário.
  actions {
    // Agenda a visita chamando a ação do documento com os campos informados.
    schedule { calls: Visit.schedule(technician, windowStart, windowEnd) }
  }
}

// Form de check-in no site, preenchido pelo técnico.
form VisitCheckIn {
  // Título exibido no formulário e na inbox.
  title: { pt-BR: "Check-in no site", en: "On-site check-in" }
  // Documento manipulado pelo form.
  document: Visit
  // Papéis que podem preencher o form.
  roles: [FieldTechnician]
  // Prazo para fazer o check-in antes de estourar o timeout.
  timeout: 30m

  // Campos exibidos no formulário.
  fields {
    // Local do check-in, capturado por GPS.
    point: GeoPoint {
      // Título exibido no formulário.
      title: { pt-BR: "Local do check-in", en: "Check-in location" }
      // Torna o local obrigatório no preenchimento.
      required
    }
  }

  // Ações do formulário.
  actions {
    // Registra o check-in chamando a ação do documento com o ponto informado.
    checkIn { calls: Visit.checkIn(point) }
  }
}

// Form de relatório de campo, preenchido pelo técnico após o atendimento.
form VisitFieldReport {
  // Título exibido no formulário e na inbox.
  title: { pt-BR: "Relatório de campo", en: "Field report" }
  // Documento manipulado pelo form.
  document: Visit
  // Papéis que podem preencher o form.
  roles: [FieldTechnician]
  // Prazo para preencher o relatório antes de estourar o timeout.
  timeout: 2h
  // Prioridade do item na fila de trabalho.
  priority: 60
  // Distribuição por pull: o técnico assume o item da fila.
  assign: pull

  // Campos exibidos no formulário.
  fields {
    // Desfecho registrado na conclusão.
    outcome
    // Nome de quem assina a conclusão.
    signedBy
    // Motivo da falha, quando a visita não for concluída.
    reason: string {
      // Título exibido no formulário.
      title: { pt-BR: "Motivo da falha", en: "Failure reason" }
      // Limita o motivo a quinhentos caracteres.
      maxLength: 500
    }
    // Anotação livre do técnico.
    note: string {
      // Título exibido no formulário.
      title: { pt-BR: "Anotação", en: "Note" }
      // Limita a anotação a mil caracteres.
      maxLength: 1000
    }
  }

  // Ações do formulário.
  actions {
    // Conclui a visita com desfecho e assinatura.
    complete { calls: Visit.complete(outcome, signedBy) }
    // Registra a falha com o motivo informado.
    fail { calls: Visit.fail(reason) }
    // Salva a anotação sem encerrar o form.
    save { calls: Visit.saveNote(note); stay }
  }
}

// Manual que orienta o deslocamento do técnico até o site.
manual Travel {
  // Título exibido na inbox e no histórico.
  title: { pt-BR: "Deslocamento até o site", en: "Travel to site" }
  // Documento ao qual o manual se refere.
  document: Visit
  // Papéis que podem executar o manual.
  roles: [FieldTechnician]
  // Instrução exibida ao responsável pela tarefa.
  instructions: "Deslocar até o site com as peças separadas para o atendimento"
  // Prazo para concluir a tarefa antes de estourar o timeout.
  timeout: 1h
}

// Manual de escalação usado quando o agendamento ou o SLA falha.
manual EscalateVisit {
  // Título exibido na inbox e no histórico.
  title: { pt-BR: "Escalar atendimento da visita", en: "Escalate service visit" }
  // Documento ao qual o manual se refere.
  document: Visit
  // Papéis que podem executar o manual.
  roles: [Supervisor]
  // Instrução exibida ao supervisor escalado.
  instructions: "Falar com o despachante, renegociar a janela e registrar a decisão"
  // Prazo para concluir a escalação antes de estourar o timeout.
  timeout: 1h
}
