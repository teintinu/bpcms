// service: example.com/services/field-service

process ServiceVisit for Visit {
  title: { pt-BR: "Atendimento da visita", en: "Service visit" }
  version: 1
  goal: "Executar a visita no local, com check-in por localização, assinatura do cliente e SLA"
  owner: "Field Service"
  timezone: America/Fortaleza
  sla: 3d

  on breach -> Escalate
  cancel on Visit.Withdrawn -> Undo

  pool Company {
    internal
    lane Dispatch { role: Dispatcher }
    lane Field { role: FieldTechnician }
    lane Supervision { role: Supervisor }
  }

  start Request { by: [Dispatcher] }

  task ScheduleVisit {
    lane: Dispatch
    form: VisitSchedule
    sla: 4h
    assign: pull
    on breach -> Escalate
  }

  task DispatchVisit {
    lane: System
    action: Visit.dispatch
    sla: 2h
  }

  task Travel {
    lane: Field
    manual: "Deslocar até o site com as peças separadas para o atendimento"
    sla: 1h
  }

  task CheckIn {
    lane: Field
    form: VisitCheckIn
    sla: 30m
  }

  task FieldReport {
    lane: Field
    form: VisitFieldReport
    sla: 2h
    assign: pull
    priority: 60
  }

  task Reschedule {
    lane: System
    runs: VisitReschedule
    with { visit }
    sla: 3d
    on timer 3d -> NotCompleted
  }

  task Escalate {
    lane: Supervision
    manual: "Falar com o despachante, renegociar a janela e registrar a decisão"
    sla: 1h
  }

  rollback Undo

  milestone Arrived {
    title: { pt-BR: "Técnico no local", en: "Technician on site" }
    on: Visit.CheckedIn
  }

  end Completed {
    title: { pt-BR: "Visitada", en: "Completed" }
    outcome: success
  }

  end NotCompleted {
    title: { pt-BR: "Não concluída", en: "Not completed" }
    outcome: failure
  }

  end Cancelled {
    title: { pt-BR: "Cancelada", en: "Cancelled" }
    outcome: cancelled
  }

  Request -> ScheduleVisit
  ScheduleVisit.schedule -> DispatchVisit
  DispatchVisit -> Travel
  Travel -> CheckIn
  CheckIn.checkIn -> FieldReport
  FieldReport.complete -> Completed
  FieldReport.fail -> Reschedule
  Reschedule -> DispatchVisit
  Undo -> Cancelled
  Escalate -> ScheduleVisit
}

form VisitSchedule {
  title: { pt-BR: "Agendar visita", en: "Schedule visit" }
  document: Visit

  fields {
    technician
    windowStart
    windowEnd
  }

  actions {
    schedule { calls: Visit.schedule(technician, windowStart, windowEnd) }
  }
}

form VisitCheckIn {
  title: { pt-BR: "Check-in no site", en: "On-site check-in" }
  document: Visit

  fields {
    point: GeoPoint {
      title: { pt-BR: "Local do check-in", en: "Check-in location" }
      required
    }
  }

  actions {
    checkIn { calls: Visit.checkIn(point) }
  }
}

form VisitFieldReport {
  title: { pt-BR: "Relatório de campo", en: "Field report" }
  document: Visit

  fields {
    outcome
    signedBy
    reason: string {
      title: { pt-BR: "Motivo da falha", en: "Failure reason" }
      maxLength: 500
    }
    note: string {
      title: { pt-BR: "Anotação", en: "Note" }
      maxLength: 1000
    }
  }

  actions {
    complete { calls: Visit.complete(outcome, signedBy) }
    fail { calls: Visit.fail(reason) }
    save { calls: Visit.saveNote(note); stay }
  }
}

view VisitProgress {
  title: { pt-BR: "Andamento da visita", en: "Visit progress" }
  type: process
  process: ServiceVisit
  roles: [Dispatcher, FieldTechnician, Supervisor, Customer]

  sections { current; participants; history; deadlines; subprocesses; documents; milestones; next }
}
