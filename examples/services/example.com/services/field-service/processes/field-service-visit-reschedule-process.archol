// REVIEW [2026-12-15] service: example.com/services/field-service
// REVIEW [2026-12-15] Process: sintaxe atual (DSL_REFERENCE.md §4)

// REVIEW [2026-12-15] Declara o processo que reagenda uma visita falhada e avisa o cliente.
process VisitReschedule(visit: Visit) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Reagendamento da visita", en: "Visit reschedule" }
  // REVIEW [2026-12-15] Versão do artefato Process; diff e release comparam.
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Reagendar a visita falhada e avisar o cliente com a nova janela"
  }
  // REVIEW [2026-12-15] SLA brando do caso: alvo de lead time, não é timer.
  sla: 5d

  // REVIEW [2026-12-15] Declara que este processo é chamado por outro, sem gatilho próprio.
  called

  // REVIEW [2026-12-15] Bloco externo: captura timeout do caso e de qualquer form.
  try {
    // REVIEW [2026-12-15] Abre o form de reagendamento para o despachante.
    RescheduleReview.show({ visit })

    // REVIEW [2026-12-15] Se a visita foi cancelada no form...
    if (visit.status == Failed) {
      // REVIEW [2026-12-15] ...encerra no desfecho Abandoned, sem nova janela.
      return Abandoned
    }

    // REVIEW [2026-12-15] Avisa o cliente sobre a nova janela combinada.
    send VisitRescheduled {
      // REVIEW [2026-12-15] Chave de correlação e dedup da mensagem: a própria visita.
      key: visit
      // REVIEW [2026-12-15] Dados levados para o payload da mensagem.
      with {
        // REVIEW [2026-12-15] Início da janela reagendada.
        windowStart: visit.windowStart
        // REVIEW [2026-12-15] Fim da janela reagendada.
        windowEnd: visit.windowEnd
      }
    }

    // REVIEW [2026-12-15] Laço de tentativas de confirmação, limitado a duas iterações.
    loop ConfirmationAttempt max 2 {
      // REVIEW [2026-12-15] Tenta obter a confirmação do cliente a cada iteração.
      try {
        // REVIEW [2026-12-15] Abre o form de confirmação para o cliente.
        VisitConfirmation.show({ visit })
        // REVIEW [2026-12-15] Encerra no desfecho de sucesso assim que confirmado.
        return Rescheduled
      } catch (Timeout) {
        // REVIEW [2026-12-15] on timer da confirmação: escala e reapresenta a confirmação
        // REVIEW [2026-12-15] Abre o manual de escalação quando a confirmação expira.
        EscalateReschedule.show({ visit })
      }
    }

    // REVIEW [2026-12-15] Esgotou as tentativas sem confirmação: encerra no desfecho Abandoned.
    return Abandoned
  } catch (Timeout) {
    // REVIEW [2026-12-15] on breach do caso: escala e encerra sem nova janela confirmada
    // REVIEW [2026-12-15] Abre o manual de escalação quando o SLA do caso expira.
    EscalateReschedule.show({ visit })
    // REVIEW [2026-12-15] Encerra o processo no desfecho de cancelamento.
    return Abandoned
  }

  // REVIEW [2026-12-15] Declara o desfecho de sucesso do caso.
  end Rescheduled {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Reagendada", en: "Rescheduled" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }

  // REVIEW [2026-12-15] Declara o desfecho de cancelamento do caso.
  end Abandoned {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Abandonada", en: "Abandoned" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: cancelled
  }
}

// REVIEW [2026-12-15] Form de reagendamento, preenchido pelo despachante.
form RescheduleReview {
  // REVIEW [2026-12-15] Título exibido no formulário e na inbox.
  title: { pt-BR: "Reagendar visita", en: "Reschedule visit" }
  // REVIEW [2026-12-15] Documento manipulado pelo form.
  document: Visit
  // REVIEW [2026-12-15] Papéis que podem preencher o form.
  roles: [Dispatcher]
  // REVIEW [2026-12-15] Prazo para preencher antes de estourar o timeout.
  timeout: 4h
  // REVIEW [2026-12-15] Distribuição por pull: o despachante assume o item da fila.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Início da nova janela combinada.
    windowStart
    // REVIEW [2026-12-15] Fim da nova janela combinada.
    windowEnd
    // REVIEW [2026-12-15] Motivo do cancelamento, quando a visita for encerrada sem reagendar.
    reason: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Motivo do cancelamento", en: "Withdrawal reason" }
      // REVIEW [2026-12-15] Limita o motivo a quinhentos caracteres.
      maxLength: 500
    }
  }

  // REVIEW [2026-12-15] Ações do formulário.
  actions {
    // REVIEW [2026-12-15] Reagenda a visita chamando a ação do documento com a nova janela.
    reschedule { calls: Visit.reschedule(windowStart, windowEnd) }
    // REVIEW [2026-12-15] Cancela a visita com o motivo informado.
    abandon { calls: Visit.withdraw(reason) }
  }
}

// REVIEW [2026-12-15] Form de confirmação da nova janela, preenchido pelo cliente.
form VisitConfirmation {
  // REVIEW [2026-12-15] Título exibido no formulário e na inbox.
  title: { pt-BR: "Confirmar nova janela", en: "Confirm new window" }
  // REVIEW [2026-12-15] Documento manipulado pelo form.
  document: Visit
  // REVIEW [2026-12-15] Papéis que podem preencher o form.
  roles: [Customer]
  // REVIEW [2026-12-15] Prazo para o cliente confirmar antes de estourar o timeout.
  timeout: 2d

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Observação opcional do cliente sobre a nova janela.
    note: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Observação", en: "Note" }
      // REVIEW [2026-12-15] Limita a observação a quinhentos caracteres.
      maxLength: 500
    }
  }

  // REVIEW [2026-12-15] Ações do formulário.
  actions {
    // REVIEW [2026-12-15] Confirma a janela chamando a ação do documento com a observação.
    acknowledge { calls: Visit.acknowledgeWindow(note) }
  }
}

// REVIEW [2026-12-15] Manual de escalação usado quando a confirmação ou o SLA falha.
manual EscalateReschedule {
  // REVIEW [2026-12-15] Título exibido na inbox e no histórico.
  title: { pt-BR: "Escalar reagendamento da visita", en: "Escalate visit reschedule" }
  // REVIEW [2026-12-15] Documento ao qual o manual se refere.
  document: Visit
  // REVIEW [2026-12-15] Papéis que podem executar o manual.
  roles: [Supervisor]
  // REVIEW [2026-12-15] Instrução exibida ao supervisor escalado.
  instructions: "Ligar para o cliente e confirmar a nova janela"
  // REVIEW [2026-12-15] Prazo para concluir a escalação antes de estourar o timeout.
  timeout: 1h
}
