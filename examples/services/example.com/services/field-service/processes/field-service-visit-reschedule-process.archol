// service: example.com/services/field-service
// Process: sintaxe atual (DSL_REFERENCE.md §4)

// Declara o processo que reagenda uma visita falhada e avisa o cliente.
process VisitReschedule(visit: Visit) {
  // Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Reagendamento da visita", en: "Visit reschedule" }
  // Versão do artefato Process; diff e release comparam.
  version: 1
  // Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // Texto do objetivo em português.
    pt-BR: "Reagendar a visita falhada e avisar o cliente com a nova janela"
  }
  // SLA brando do caso: alvo de lead time, não é timer.
  sla: 5d

  // Declara que este processo é chamado por outro, sem gatilho próprio.
  called

  // Bloco externo: captura timeout do caso e de qualquer form.
  try {
    // Abre o form de reagendamento para o despachante.
    RescheduleReview.show({ visit })

    // Se a visita foi cancelada no form...
    if (visit.status == Failed) {
      // ...encerra no desfecho Abandoned, sem nova janela.
      return Abandoned
    }

    // Avisa o cliente sobre a nova janela combinada.
    send VisitRescheduled {
      // Chave de correlação e dedup da mensagem: a própria visita.
      key: visit
      // Dados levados para o payload da mensagem.
      with {
        // Início da janela reagendada.
        windowStart: visit.windowStart
        // Fim da janela reagendada.
        windowEnd: visit.windowEnd
      }
    }

    // Laço de tentativas de confirmação, limitado a duas iterações.
    loop ConfirmationAttempt max 2 {
      // Tenta obter a confirmação do cliente a cada iteração.
      try {
        // Abre o form de confirmação para o cliente.
        VisitConfirmation.show({ visit })
        // Encerra no desfecho de sucesso assim que confirmado.
        return Rescheduled
      } catch (Timeout) {
        // on timer da confirmação: escala e reapresenta a confirmação
        // Abre o manual de escalação quando a confirmação expira.
        EscalateReschedule.show({ visit })
      }
    }

    // Esgotou as tentativas sem confirmação: encerra no desfecho Abandoned.
    return Abandoned
  } catch (Timeout) {
    // on breach do caso: escala e encerra sem nova janela confirmada
    // Abre o manual de escalação quando o SLA do caso expira.
    EscalateReschedule.show({ visit })
    // Encerra o processo no desfecho de cancelamento.
    return Abandoned
  }

  // Declara o desfecho de sucesso do caso.
  end Rescheduled {
    // Título exibido no histórico e nos filtros.
    title: { pt-BR: "Reagendada", en: "Rescheduled" }
    // Classificação do desfecho para KPI.
    outcome: success
  }

  // Declara o desfecho de cancelamento do caso.
  end Abandoned {
    // Título exibido no histórico.
    title: { pt-BR: "Abandonada", en: "Abandoned" }
    // Classificação do desfecho para KPI.
    outcome: cancelled
  }
}

// Form de reagendamento, preenchido pelo despachante.
form RescheduleReview {
  // Título exibido no formulário e na inbox.
  title: { pt-BR: "Reagendar visita", en: "Reschedule visit" }
  // Documento manipulado pelo form.
  document: Visit
  // Papéis que podem preencher o form.
  roles: [Dispatcher]
  // Prazo para preencher antes de estourar o timeout.
  timeout: 4h
  // Distribuição por pull: o despachante assume o item da fila.
  assign: pull

  // Campos exibidos no formulário.
  fields {
    // Início da nova janela combinada.
    windowStart
    // Fim da nova janela combinada.
    windowEnd
    // Motivo do cancelamento, quando a visita for encerrada sem reagendar.
    reason: string {
      // Título exibido no formulário.
      title: { pt-BR: "Motivo do cancelamento", en: "Withdrawal reason" }
      // Limita o motivo a quinhentos caracteres.
      maxLength: 500
    }
  }

  // Ações do formulário.
  actions {
    // Reagenda a visita chamando a ação do documento com a nova janela.
    reschedule { calls: Visit.reschedule(windowStart, windowEnd) }
    // Cancela a visita com o motivo informado.
    abandon { calls: Visit.withdraw(reason) }
  }
}

// Form de confirmação da nova janela, preenchido pelo cliente.
form VisitConfirmation {
  // Título exibido no formulário e na inbox.
  title: { pt-BR: "Confirmar nova janela", en: "Confirm new window" }
  // Documento manipulado pelo form.
  document: Visit
  // Papéis que podem preencher o form.
  roles: [Customer]
  // Prazo para o cliente confirmar antes de estourar o timeout.
  timeout: 2d

  // Campos exibidos no formulário.
  fields {
    // Observação opcional do cliente sobre a nova janela.
    note: string {
      // Título exibido no formulário.
      title: { pt-BR: "Observação", en: "Note" }
      // Limita a observação a quinhentos caracteres.
      maxLength: 500
    }
  }

  // Ações do formulário.
  actions {
    // Confirma a janela chamando a ação do documento com a observação.
    acknowledge { calls: Visit.acknowledgeWindow(note) }
  }
}

// Manual de escalação usado quando a confirmação ou o SLA falha.
manual EscalateReschedule {
  // Título exibido na inbox e no histórico.
  title: { pt-BR: "Escalar reagendamento da visita", en: "Escalate visit reschedule" }
  // Documento ao qual o manual se refere.
  document: Visit
  // Papéis que podem executar o manual.
  roles: [Supervisor]
  // Instrução exibida ao supervisor escalado.
  instructions: "Ligar para o cliente e confirmar a nova janela"
  // Prazo para concluir a escalação antes de estourar o timeout.
  timeout: 1h
}
