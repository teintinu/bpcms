// REVIEW [2026-12-15] service: example.com/services/field-service

// REVIEW [2026-12-15] View de caixa de entrada que lista o trabalho de despacho pendente.
view DispatchWork {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Fila de despacho", en: "Dispatch queue" }
  // REVIEW [2026-12-15] Tipo da view: inbox de tarefas.
  type: inbox
  // REVIEW [2026-12-15] Papéis que podem abrir a fila.
  roles: [Dispatcher, FieldTechnician]
  // REVIEW [2026-12-15] Escopo por papel: cada usuário enxerga apenas o trabalho do seu papel.
  scope: roles
  // REVIEW [2026-12-15] Agrupa os itens da fila por papel.
  groupBy: role
  // REVIEW [2026-12-15] Filtro que restringe a fila aos papéis do usuário atual.
  filter { role in currentUser.roles }

  // REVIEW [2026-12-15] Colunas exibidas em cada item da fila.
  columns { title; subject; role; dueAt; priority }
}
