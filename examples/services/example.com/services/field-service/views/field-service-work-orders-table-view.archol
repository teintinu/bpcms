// REVIEW [2026-12-15] service: example.com/services/field-service

// REVIEW [2026-12-15] View de tabela que lista as ordens de serviço.
view WorkOrdersTable {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Ordens de serviço", en: "Work orders" }
  // REVIEW [2026-12-15] Tipo da view: tabela de registros.
  type: table
  // REVIEW [2026-12-15] Documento que alimenta a tabela.
  source: WorkOrder
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [Dispatcher, Supervisor]

  // REVIEW [2026-12-15] Colunas exibidas em cada linha.
  columns { number; site; priority; status; dueAt }
  // REVIEW [2026-12-15] Filtros disponíveis sobre a tabela.
  filters { status; priority; site; period }
  // REVIEW [2026-12-15] Quantidade de linhas por página.
  pagination: 50

  // REVIEW [2026-12-15] Ações expostas na tabela, ligadas às ações do documento.
  actions {
    // REVIEW [2026-12-15] Atribui um técnico à ordem selecionada.
    assign -> WorkOrder.assign(assignedTechnician)
    // REVIEW [2026-12-15] Inicia a ordem selecionada.
    start -> WorkOrder.start
    // REVIEW [2026-12-15] Conclui a ordem selecionada.
    finish -> WorkOrder.finish
    // REVIEW [2026-12-15] Cancela a ordem com o motivo informado.
    cancel -> WorkOrder.cancel(reason)
  }
}
