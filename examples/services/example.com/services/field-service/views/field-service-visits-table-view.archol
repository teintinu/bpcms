// REVIEW [2026-12-15] service: example.com/services/field-service

// REVIEW [2026-12-15] View de tabela que lista as visitas técnicas.
view VisitsTable {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Visitas técnicas", en: "Visits" }
  // REVIEW [2026-12-15] Tipo da view: tabela de registros.
  type: table
  // REVIEW [2026-12-15] Documento que alimenta a tabela.
  source: Visit
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [Dispatcher, FieldTechnician, Supervisor]

  // REVIEW [2026-12-15] Colunas exibidas em cada linha.
  columns { number; site; technician; status; windowStart }
  // REVIEW [2026-12-15] Filtros disponíveis sobre a tabela.
  filters { status; site; technician; period }
  // REVIEW [2026-12-15] Quantidade de linhas por página.
  pagination: 50

  // REVIEW [2026-12-15] Ações expostas na tabela, ligadas às ações do documento.
  actions {
    // REVIEW [2026-12-15] Abre o detalhe da visita selecionada.
    open -> VisitDetail
    // REVIEW [2026-12-15] Despacha a visita selecionada.
    dispatch -> Visit.dispatch
    // REVIEW [2026-12-15] Registra a falha com o motivo informado.
    fail -> Visit.fail(failureReason)
  }
}
