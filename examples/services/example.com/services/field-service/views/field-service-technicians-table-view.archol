// REVIEW [2026-12-15] service: example.com/services/field-service

// REVIEW [2026-12-15] View de tabela que lista os técnicos.
view TechniciansTable {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Técnicos", en: "Technicians" }
  // REVIEW [2026-12-15] Tipo da view: tabela de registros.
  type: table
  // REVIEW [2026-12-15] Documento que alimenta a tabela.
  source: Technician
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [Dispatcher, Supervisor]

  // REVIEW [2026-12-15] Colunas exibidas em cada linha.
  columns { registration; person; zone; availability; dailyCapacity }
  // REVIEW [2026-12-15] Filtros disponíveis sobre a tabela.
  filters { availability; zone }

  // REVIEW [2026-12-15] Ações expostas na tabela, ligadas às ações do documento.
  actions {
    // REVIEW [2026-12-15] Atribui o técnico selecionado.
    assign -> Technician.assign
    // REVIEW [2026-12-15] Libera o técnico selecionado.
    release -> Technician.release
    // REVIEW [2026-12-15] Afasta o técnico com o motivo informado.
    goOffDuty -> Technician.goOffDuty(reason)
  }
}
