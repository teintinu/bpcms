// REVIEW [2026-12-15] service: example.com/services/field-service

// REVIEW [2026-12-15] View de painel com os indicadores operacionais do serviço de campo.
view FieldDashboard {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Painel de campo", en: "Field dashboard" }
  // REVIEW [2026-12-15] Tipo da view: painel de métricas.
  type: dashboard
  // REVIEW [2026-12-15] Documentos que alimentam o painel.
  sources: [Visit, WorkOrder]
  // REVIEW [2026-12-15] Papéis que podem abrir o painel.
  roles: [Supervisor, Dispatcher]
  // REVIEW [2026-12-15] Atualização em tempo real, sem recarregar a tela.
  mode: live

  // REVIEW [2026-12-15] Filtros globais oferecidos no painel.
  filters { site; status; period }
  // REVIEW [2026-12-15] Métricas calculadas sobre as fontes declaradas.
  metrics {
    // REVIEW [2026-12-15] Visitas ainda abertas, ou seja, nem concluídas nem falhas.
    openVisits: count(Visit) where Visit.status != Completed and Visit.status != Failed
    // REVIEW [2026-12-15] Visitas em que o técnico já fez check-in no local.
    onSite: count(Visit) where Visit.status == OnSite
    // REVIEW [2026-12-15] Visitas encerradas em falha.
    failedVisits: count(Visit) where Visit.status == Failed
    // REVIEW [2026-12-15] Ordens de serviço ainda em andamento, nem concluídas nem canceladas.
    openOrders: count(WorkOrder) where WorkOrder.status != Done and WorkOrder.status != Cancelled
  }
  // REVIEW [2026-12-15] Idade máxima aceita dos dados antes de atualizar o painel.
  freshness: 5m
}
