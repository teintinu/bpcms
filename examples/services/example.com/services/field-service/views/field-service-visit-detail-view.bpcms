// service: example.com/services/field-service

// View de detalhe de uma visita.
view VisitDetail {
  // Título exibido na navegação.
  title: { pt-BR: "Detalhe da visita", en: "Visit detail" }
  // Tipo da view: ficha de detalhe.
  type: detail
  // Documento exibido na ficha.
  document: Visit
  // Papéis que podem abrir a view, incluindo o cliente.
  roles: [Dispatcher, FieldTechnician, Supervisor, Customer]

  // Seções fixas exibidas na ficha.
  sections { summary; checkin; report; timeline }

  // Ações expostas na ficha.
  actions {
    // Abre o andamento do processo da visita.
    open -> VisitProgress
    // Faz o check-in com o ponto informado.
    checkIn -> Visit.checkIn(point)
  }
}
