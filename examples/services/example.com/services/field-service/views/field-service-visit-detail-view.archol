// REVIEW [2026-12-15] service: example.com/services/field-service

// REVIEW [2026-12-15] View de detalhe de uma visita.
view VisitDetail {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Detalhe da visita", en: "Visit detail" }
  // REVIEW [2026-12-15] Tipo da view: ficha de detalhe.
  type: detail
  // REVIEW [2026-12-15] Documento exibido na ficha.
  document: Visit
  // REVIEW [2026-12-15] Papéis que podem abrir a view, incluindo o cliente.
  roles: [Dispatcher, FieldTechnician, Supervisor, Customer]

  // REVIEW [2026-12-15] Seções fixas exibidas na ficha.
  sections { summary; checkin; report; timeline }

  // REVIEW [2026-12-15] Ações expostas na ficha.
  actions {
    // REVIEW [2026-12-15] Abre o andamento do processo da visita.
    open -> VisitProgress
    // REVIEW [2026-12-15] Faz o check-in com o ponto informado.
    checkIn -> Visit.checkIn(point)
  }
}
