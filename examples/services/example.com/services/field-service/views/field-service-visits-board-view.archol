// REVIEW [2026-12-15] service: example.com/services/field-service

// REVIEW [2026-12-15] View de quadro kanban com as visitas por situação.
view VisitsBoard {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Quadro de visitas", en: "Visits board" }
  // REVIEW [2026-12-15] Tipo da view: quadro kanban.
  type: kanban
  // REVIEW [2026-12-15] Documento que alimenta o quadro.
  source: Visit
  // REVIEW [2026-12-15] Papéis que podem abrir o quadro.
  roles: [Dispatcher, Supervisor]
  // REVIEW [2026-12-15] Agrupa os cartões pela situação da visita.
  groupBy: status

  // REVIEW [2026-12-15] Colunas exibidas em cada cartão.
  columns { number; site; windowStart }
  // REVIEW [2026-12-15] Campos exibidos no resumo do cartão.
  card { number; site; technician }

  // REVIEW [2026-12-15] Ações expostas no quadro.
  actions {
    // REVIEW [2026-12-15] Abre o detalhe da visita selecionada.
    open -> VisitDetail
  }
}
