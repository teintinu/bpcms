// service: example.com/services/field-service

// View de quadro kanban com as visitas por situação.
view VisitsBoard {
  // Título exibido na navegação.
  title: { pt-BR: "Quadro de visitas", en: "Visits board" }
  // Tipo da view: quadro kanban.
  type: kanban
  // Documento que alimenta o quadro.
  source: Visit
  // Papéis que podem abrir o quadro.
  roles: [Dispatcher, Supervisor]
  // Agrupa os cartões pela situação da visita.
  groupBy: status

  // Colunas exibidas em cada cartão.
  columns { number; site; windowStart }
  // Campos exibidos no resumo do cartão.
  card { number; site; technician }

  // Ações expostas no quadro.
  actions {
    // Abre o detalhe da visita selecionada.
    open -> VisitDetail
  }
}
