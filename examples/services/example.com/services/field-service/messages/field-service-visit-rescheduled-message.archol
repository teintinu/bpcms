// REVIEW [2026-12-15] service: example.com/services/field-service

// REVIEW [2026-12-15] Mensagem emitida quando uma visita é reagendada.
message VisitRescheduled {
  // REVIEW [2026-12-15] Título exibido na mensagem e na caixa de entrada.
  title: { pt-BR: "Visita reagendada", en: "Visit rescheduled" }
  // REVIEW [2026-12-15] Documento sobre o qual a mensagem fala.
  about: Visit

  // REVIEW [2026-12-15] Dados carregados pela mensagem.
  payload {
    // REVIEW [2026-12-15] Início da nova janela combinada.
    windowStart: DateTime { title: { pt-BR: "Nova janela de", en: "New window from" } }
    // REVIEW [2026-12-15] Fim da nova janela combinada.
    windowEnd: DateTime { title: { pt-BR: "Nova janela até", en: "New window to" } }
  }
}
