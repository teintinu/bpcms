// REVIEW [2026-12-15] service: example.com/services/citizen

// REVIEW [2026-12-15] Forma compartilhada de e-mail; reutilizável em campos de contato.
shape Email {
  // REVIEW [2026-12-15] Título exibido no formulário.
  title: { pt-BR: "Correio eletrônico", en: "Email" }
  // REVIEW [2026-12-15] Tipo-base textual da forma.
  base: string
  // REVIEW [2026-12-15] Normaliza para minúsculas e remove espaços nas extremidades.
  normalize: lower-trim
  // REVIEW [2026-12-15] Valida o formato de e-mail.
  validate: email
  // REVIEW [2026-12-15] Limita o comprimento ao máximo de 254 caracteres.
  maxLength: 254
  // REVIEW [2026-12-15] Exibe o valor sem máscara.
  format: plain
  // REVIEW [2026-12-15] Indexa o valor de forma exata para busca.
  index: exact
}

// REVIEW [2026-12-15] Forma compartilhada de telefone; reutilizável em campos de contato.
shape Phone {
  // REVIEW [2026-12-15] Título exibido no formulário.
  title: { pt-BR: "Telefone", en: "Phone" }
  // REVIEW [2026-12-15] Tipo-base textual da forma.
  base: string
  // REVIEW [2026-12-15] Normaliza mantendo apenas dígitos.
  normalize: digits
  // REVIEW [2026-12-15] Valida o formato de telefone.
  validate: phone
  // REVIEW [2026-12-15] Limita o comprimento a 20 caracteres.
  maxLength: 20
  // REVIEW [2026-12-15] Exibe o valor com máscara de telefone internacional.
  format: masked("+## (##) #####-####")
}
