// REVIEW [2026-12-15] service: example.com/services/citizen

// REVIEW [2026-12-15] Declara o organograma do serviço, com hierarquia, gestão e regra de quatro olhos.
organogram Citizen {
  // REVIEW [2026-12-15] Título exibido no builder e na administração de papéis.
  title: { pt-BR: "Organograma do cidadão", en: "Citizen organogram" }
  // REVIEW [2026-12-15] Árvore de subordinação entre papéis.
  hierarchy {
    // REVIEW [2026-12-15] Manager fica acima de Clerk na hierarquia.
    Manager > Clerk
  }
  // REVIEW [2026-12-15] Política de quatro olhos aplicada a operações sensíveis.
  fourEyes {
    // REVIEW [2026-12-15] A operação citizen.merge exige aprovação de um Manager.
    citizen.merge requires Manager
  }
}

// REVIEW [2026-12-15] Papel de atendente de cadastro.
role Clerk {
  // REVIEW [2026-12-15] Título exibido na administração de papéis.
  title: { pt-BR: "Atendente de cadastro", en: "Registration clerk" }
  // REVIEW [2026-12-15] Permissões de consulta, cadastro e busca concedidas ao papel.
  permissions: [citizen.view, citizen.register, citizen.search]
}

// REVIEW [2026-12-15] Papel de gestor de cadastro.
role Manager {
  // REVIEW [2026-12-15] Título exibido na administração de papéis.
  title: { pt-BR: "Gestor de cadastro", en: "Registration manager" }
  // REVIEW [2026-12-15] Herda as permissões de Clerk.
  inherits: Clerk
  // REVIEW [2026-12-15] Permissões exclusivas do gestor: mesclar, bloquear e aprovar.
  permissions: [citizen.merge, citizen.block, citizen.approve]
}

// REVIEW [2026-12-15] Papel de auditor de cadastro.
role Auditor {
  // REVIEW [2026-12-15] Título exibido na administração de papéis.
  title: { pt-BR: "Auditor de cadastro", en: "Registration auditor" }
  // REVIEW [2026-12-15] Permissões de auditoria, leitura e acesso a relatórios.
  permissions: [citizen.audit, citizen.view, report.view]
}
