// REVIEW [2026-12-15] service: example.com/services/citizen

// REVIEW [2026-12-15] View de consulta tabular dos cidadãos cadastrados.
view Registry {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Busca de cidadãos", en: "Citizen search" }
  // REVIEW [2026-12-15] Tipo da view: tabela de consulta.
  type: table
  // REVIEW [2026-12-15] Documento consultado pela view.
  source: Citizen
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [Clerk, Manager, Auditor]

  // REVIEW [2026-12-15] Colunas exibidas na tabela.
  columns { avatar; displayName; kind; country; status }
  // REVIEW [2026-12-15] Filtros disponíveis na tabela.
  filters { kind; country; status }
  // REVIEW [2026-12-15] Tamanho da página da tabela.
  pagination: 50
}
