// REVIEW [2026-12-15] service: example.com/services/citizen

// REVIEW [2026-12-15] View de fila de duplicados para tratamento de cadastros repetidos.
view Duplicates {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Fila de duplicados", en: "Duplicate queue" }
  // REVIEW [2026-12-15] Tipo da view: caixa de entrada de trabalho.
  type: inbox
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [Clerk, Manager, Auditor]
  // REVIEW [2026-12-15] Escopo por papel: cada usuário vê os itens do seu papel.
  scope: roles
  // REVIEW [2026-12-15] Agrupa os itens da fila pelo papel do usuário.
  groupBy: role
  // REVIEW [2026-12-15] Filtro: só exibe itens dos papéis do usuário atual.
  filter { role in currentUser.roles }
  // REVIEW [2026-12-15] Colunas exibidas na lista.
  columns { title; subject; role; dueAt; priority }
}
