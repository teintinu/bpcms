// service: example.com/services/citizen
// Process: sintaxe atual (DSL_REFERENCE.md §4)

// Declara o processo de mesclagem; o argumento é o documento-sujeito da instância.
process CitizenMerge(citizen: Citizen) {
  // Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Mesclagem de cidadãos", en: "Citizen merge" }
  // Versão do artefato Process; diff e release comparam.
  version: 1
  // Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // Texto do objetivo em português.
    pt-BR: "Unificar cadastros duplicados com aprovação de quatro olhos, reatribuir usuários e registrar a auditoria"
  }
  // SLA brando do caso: alvo de lead time, não é timer.
  sla: 5d

  // Papéis que podem iniciar o processo.
  by: [Clerk, Manager]

  // Variável durável da instância: contagem de contas reatribuídas.
  let reassignedUsers: std.Count

  // Bloco que captura timeout do caso e das tarefas humanas.
  try {
    // Abre a tarefa manual de análise da duplicidade.
    Analyze.show({ citizen })
  } catch (Timeout) {
    // on timer da análise: escala e segue para a aprovação
    EscalateMerge.show({ citizen })
  }

  // Abre o form de aprovação da mesclagem antes de efetivar.
  MergeApproval.show({ citizen })

  // Bloco que captura falha do diretório de identidade.
  try {
    // Reatribui as contas do duplicado para o cadastro sobrevivente.
    reassignedUsers = IdentityDirectory.reassignAccounts({
      // Cadastro duplicado que será absorvido.
      duplicate: citizen,
      // Cadastro de destino que permanece.
      survivor: citizen.mergedInto
    })
  } catch (DirectoryUnavailable) {
    // Se o diretório falhar, o atendente reatribui manualmente.
    ManualReassign.show({ citizen })
  }

  // Abre a tarefa de registro do parecer de auditoria.
  RegisterAudit.show({ citizen })

  // Encerra a instância no desfecho de sucesso.
  return Completed

  // Declara o desfecho de sucesso do caso.
  end Completed {
    // Título exibido no histórico.
    title: { pt-BR: "Mesclagem concluída", en: "Merge completed" }
    // Classificação do desfecho para KPI.
    outcome: success
  }
}

// Erro de negócio: diretório de identidade indisponível.
error DirectoryUnavailable {
  // Título do erro exibido ao usuário.
  title: { pt-BR: "Diretório de identidade indisponível", en: "Identity directory unavailable" }
}

// Form de aprovação da mesclagem, executado por gestor.
form MergeApproval {
  // Título exibido na inbox e no histórico.
  title: { pt-BR: "Aprovação da mesclagem", en: "Merge approval" }
  // Documento-sujeito do form.
  document: Citizen
  // Papéis que podem assumir a tarefa.
  roles: [Manager]
  // Prazo para conclusão antes do timeout.
  timeout: 1d
  // Distribuição da tarefa por puxada (pull), sem atribuição automática.
  assign: pull

  // Campos exibidos e coletados no form.
  fields {
    // Nome de exibição do cidadão (somente leitura no form).
    displayName
    // Tipo do cidadão (somente leitura no form).
    kind
    // País do cidadão (somente leitura no form).
    country
    // Campo de referência ao cadastro de destino da mesclagem.
    target: Citizen {
      // Título exibido no formulário.
      title: { pt-BR: "Cadastro de destino", en: "Target record" }
      // Torna o destino obrigatório.
      required
    }
  }

  // Ações disponíveis para concluir a tarefa.
  actions {
    // Aprovar dispara a operação merge do documento com o alvo escolhido.
    approve { calls: Citizen.merge(target) }
  }
}

// Tarefa manual de análise da duplicidade.
manual Analyze {
  // Título exibido na inbox.
  title: { pt-BR: "Analisar duplicidade", en: "Analyze duplicate" }
  // Documento-sujeito da tarefa.
  document: Citizen
  // Papéis que podem assumir a tarefa.
  roles: [Clerk]
  // Instruções exibidas ao responsável.
  instructions: "Comparar os cadastros e confirmar a duplicidade"
  // Prazo para conclusão antes do timeout.
  timeout: 2d
  // Prioridade relativa na fila de trabalho.
  priority: 50
  // Distribuição da tarefa por puxada (pull).
  assign: pull
}

// Tarefa manual de reatribuição de contas.
manual ManualReassign {
  // Título exibido na inbox.
  title: { pt-BR: "Reatribuir contas manualmente", en: "Reassign accounts manually" }
  // Documento-sujeito da tarefa.
  document: Citizen
  // Papéis que podem assumir a tarefa.
  roles: [Clerk]
  // Instruções exibidas ao responsável.
  instructions: "Reatribuir as contas do cadastro duplicado no diretório de identidade"
  // Prazo para conclusão antes do timeout.
  timeout: 1d
}

// Tarefa manual de registro da auditoria.
manual RegisterAudit {
  // Título exibido na inbox.
  title: { pt-BR: "Registrar auditoria da mesclagem", en: "Register merge audit" }
  // Documento-sujeito da tarefa.
  document: Citizen
  // Papéis que podem assumir a tarefa.
  roles: [Auditor]
  // Instruções exibidas ao responsável.
  instructions: "Conferir o dossiê da mesclagem e registrar o parecer de auditoria"
  // Prazo para conclusão antes do timeout.
  timeout: 2d
}

// Tarefa manual de escalação da revisão da duplicidade.
manual EscalateMerge {
  // Título exibido na inbox.
  title: { pt-BR: "Escalar revisão da duplicidade", en: "Escalate duplicate review" }
  // Documento-sujeito da tarefa.
  document: Citizen
  // Papéis que podem assumir a tarefa.
  roles: [Manager]
  // Instruções exibidas ao responsável.
  instructions: "Revisar a duplicidade com o solicitante"
  // Prazo para conclusão antes do timeout.
  timeout: 1d
}

// View de andamento derivada da instância do processo.
view MergeProgress {
  // Título exibido na navegação.
  title: { pt-BR: "Andamento da mesclagem", en: "Merge progress" }
  // Tipo da view: tela de andamento de processo.
  type: process
  // Processo cujo andamento esta view exibe.
  process: CitizenMerge
  // Papéis que podem abrir a view.
  roles: [Clerk, Manager, Auditor]

  // Seções fixas exibidas na tela de andamento.
  sections { current; participants; history; deadlines; documents; milestones; next }
}

// Integração com o diretório externo de identidade.
integration IdentityDirectory {
  // Protocolo de comunicação usado pela integração.
  protocol: rest
  // URL base lida da variável de ambiente.
  baseUrl: env.IDENTITY_DIRECTORY_URL
  // Autenticação por OAuth2.
  auth: oauth2
  // Prazo máximo de cada chamada.
  timeout: 20s
  // Retentativa exponencial limitada a três tentativas.
  retry: exponential(3)
  // Cabeçalho usado para garantir idempotência das chamadas.
  idempotency: header "Idempotency-Key"

  // Operações expostas pela integração.
  operations {
    // Reatribui contas do duplicado ao sobrevivente e devolve a contagem.
    reassignAccounts(duplicate: Citizen, survivor: Citizen): std.Count
  }
}
