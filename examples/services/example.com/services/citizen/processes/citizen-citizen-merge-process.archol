// REVIEW [2026-12-15] service: example.com/services/citizen
// REVIEW [2026-12-15] Process: sintaxe atual (DSL_REFERENCE.md §4)

// REVIEW [2026-12-15] Declara o processo de mesclagem; o argumento é o documento-sujeito da instância.
process CitizenMerge(citizen: Citizen) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Mesclagem de cidadãos", en: "Citizen merge" }
  // REVIEW [2026-12-15] Versão do artefato Process; diff e release comparam.
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Unificar cadastros duplicados com aprovação de quatro olhos, reatribuir usuários e registrar a auditoria"
  }
  // REVIEW [2026-12-15] SLA brando do caso: alvo de lead time, não é timer.
  sla: "5d"

  // REVIEW [2026-12-15] Papéis que podem iniciar o processo.
  by: [Clerk, Manager]

  // REVIEW [2026-12-25] Variáveis duráveis do processo; substituem as antigas declarações `let`.
  vars {
    // REVIEW [2026-12-15] Variável durável da instância: contagem de contas reatribuídas.
    reassignedUsers: std.Count
  }

  // REVIEW [2026-12-15] Bloco que captura timeout do caso e das tarefas humanas.
  try {
    // REVIEW [2026-12-15] Abre a tarefa manual de análise da duplicidade.
    Analyze.show({ citizen })
  } catch (Timeout) {
    // REVIEW [2026-12-15] on timer da análise: escala e segue para a aprovação
    EscalateMerge.show({ citizen })
  }

  // REVIEW [2026-12-15] Abre o form de aprovação da mesclagem antes de efetivar.
  MergeApproval.show({ citizen })

  // REVIEW [2026-12-15] Bloco que captura falha do diretório de identidade.
  try {
    // REVIEW [2026-12-15] Reatribui as contas do duplicado para o cadastro sobrevivente.
    reassignedUsers = IdentityDirectory.reassignAccounts({
      // REVIEW [2026-12-15] Cadastro duplicado que será absorvido.
      duplicate: citizen,
      // REVIEW [2026-12-15] Cadastro de destino que permanece.
      survivor: citizen.mergedInto
    })
  } catch (DirectoryUnavailable) {
    // REVIEW [2026-12-15] Se o diretório falhar, o atendente reatribui manualmente.
    ManualReassign.show({ citizen })
  }

  // REVIEW [2026-12-15] Abre a tarefa de registro do parecer de auditoria.
  RegisterAudit.show({ citizen })

  // REVIEW [2026-12-15] Encerra a instância no desfecho de sucesso.
  return Completed

  // REVIEW [2026-12-15] Declara o desfecho de sucesso do caso.
  end Completed {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Mesclagem concluída", en: "Merge completed" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }
}

// REVIEW [2026-12-15] Erro de negócio: diretório de identidade indisponível.
error DirectoryUnavailable {
  // REVIEW [2026-12-15] Título do erro exibido ao usuário.
  title: { pt-BR: "Diretório de identidade indisponível", en: "Identity directory unavailable" }
}

// REVIEW [2026-12-15] Form de aprovação da mesclagem, executado por gestor.
form MergeApproval {
  // REVIEW [2026-12-15] Título exibido na inbox e no histórico.
  title: { pt-BR: "Aprovação da mesclagem", en: "Merge approval" }
  // REVIEW [2026-12-15] Documento-sujeito do form.
  document: Citizen
  // REVIEW [2026-12-15] Papéis que podem assumir a tarefa.
  roles: [Manager]
  // REVIEW [2026-12-15] Prazo para conclusão antes do timeout.
  timeout: 1d
  // REVIEW [2026-12-15] Distribuição da tarefa por puxada (pull), sem atribuição automática.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos e coletados no form.
  fields {
    // REVIEW [2026-12-15] Nome de exibição do cidadão (somente leitura no form).
    displayName
    // REVIEW [2026-12-15] Tipo do cidadão (somente leitura no form).
    kind
    // REVIEW [2026-12-15] País do cidadão (somente leitura no form).
    country
    // REVIEW [2026-12-15] Campo de referência ao cadastro de destino da mesclagem.
    target: Citizen {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Cadastro de destino", en: "Target record" }
      // REVIEW [2026-12-15] Torna o destino obrigatório.
      required
    }
  }

  // REVIEW [2026-12-15] Ações disponíveis para concluir a tarefa.
  actions {
    // REVIEW [2026-12-15] Aprovar dispara a operação merge do documento com o alvo escolhido.
    approve { calls: Citizen.merge(target) }
  }
}

// REVIEW [2026-12-15] Tarefa manual de análise da duplicidade.
manual Analyze {
  // REVIEW [2026-12-15] Título exibido na inbox.
  title: { pt-BR: "Analisar duplicidade", en: "Analyze duplicate" }
  // REVIEW [2026-12-15] Documento-sujeito da tarefa.
  document: Citizen
  // REVIEW [2026-12-15] Papéis que podem assumir a tarefa.
  roles: [Clerk]
  // REVIEW [2026-12-15] Instruções exibidas ao responsável.
  instructions: "Comparar os cadastros e confirmar a duplicidade"
  // REVIEW [2026-12-15] Prazo para conclusão antes do timeout.
  timeout: 2d
  // REVIEW [2026-12-15] Prioridade relativa na fila de trabalho.
  priority: 50
  // REVIEW [2026-12-15] Distribuição da tarefa por puxada (pull).
  assign: pull
}

// REVIEW [2026-12-15] Tarefa manual de reatribuição de contas.
manual ManualReassign {
  // REVIEW [2026-12-15] Título exibido na inbox.
  title: { pt-BR: "Reatribuir contas manualmente", en: "Reassign accounts manually" }
  // REVIEW [2026-12-15] Documento-sujeito da tarefa.
  document: Citizen
  // REVIEW [2026-12-15] Papéis que podem assumir a tarefa.
  roles: [Clerk]
  // REVIEW [2026-12-15] Instruções exibidas ao responsável.
  instructions: "Reatribuir as contas do cadastro duplicado no diretório de identidade"
  // REVIEW [2026-12-15] Prazo para conclusão antes do timeout.
  timeout: 1d
}

// REVIEW [2026-12-15] Tarefa manual de registro da auditoria.
manual RegisterAudit {
  // REVIEW [2026-12-15] Título exibido na inbox.
  title: { pt-BR: "Registrar auditoria da mesclagem", en: "Register merge audit" }
  // REVIEW [2026-12-15] Documento-sujeito da tarefa.
  document: Citizen
  // REVIEW [2026-12-15] Papéis que podem assumir a tarefa.
  roles: [Auditor]
  // REVIEW [2026-12-15] Instruções exibidas ao responsável.
  instructions: "Conferir o dossiê da mesclagem e registrar o parecer de auditoria"
  // REVIEW [2026-12-15] Prazo para conclusão antes do timeout.
  timeout: 2d
}

// REVIEW [2026-12-15] Tarefa manual de escalação da revisão da duplicidade.
manual EscalateMerge {
  // REVIEW [2026-12-15] Título exibido na inbox.
  title: { pt-BR: "Escalar revisão da duplicidade", en: "Escalate duplicate review" }
  // REVIEW [2026-12-15] Documento-sujeito da tarefa.
  document: Citizen
  // REVIEW [2026-12-15] Papéis que podem assumir a tarefa.
  roles: [Manager]
  // REVIEW [2026-12-15] Instruções exibidas ao responsável.
  instructions: "Revisar a duplicidade com o solicitante"
  // REVIEW [2026-12-15] Prazo para conclusão antes do timeout.
  timeout: 1d
}

// REVIEW [2026-12-15] Integração com o diretório externo de identidade.
integration IdentityDirectory {
  // REVIEW [2026-12-15] Protocolo de comunicação usado pela integração.
  protocol: rest
  // REVIEW [2026-12-15] URL base lida da variável de ambiente.
  baseUrl: env.IDENTITY_DIRECTORY_URL
  // REVIEW [2026-12-15] Autenticação por OAuth2.
  auth: oauth2
  // REVIEW [2026-12-15] Prazo máximo de cada chamada.
  timeout: 20s
  // REVIEW [2026-12-15] Retentativa exponencial limitada a três tentativas.
  retry: exponential(3)
  // REVIEW [2026-12-15] Cabeçalho usado para garantir idempotência das chamadas.
  idempotency: header "Idempotency-Key"

  // REVIEW [2026-12-15] Operações expostas pela integração.
  operations {
    // REVIEW [2026-12-15] Reatribui contas do duplicado ao sobrevivente e devolve a contagem.
    reassignAccounts(duplicate: Citizen, survivor: Citizen): std.Count
  }
}
