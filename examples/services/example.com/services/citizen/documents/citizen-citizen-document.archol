// REVIEW [2026-12-15] service: example.com/services/citizen

// REVIEW [2026-12-15] Documento que representa um cidadão (pessoa ou organização) no cadastro.
document Citizen {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Cidadão", en: "Citizen" }
  // REVIEW [2026-12-15] Versão do artefato Document; usada em diff e release.
  // REVIEW [2026-12-15] Responsável pela governança do documento.
  owner: "Citizen"
  // REVIEW [2026-12-15] Modo de sincronização: leitura a partir do documento.
  sync: read
  // REVIEW [2026-12-15] Campos que compõem o cadastro do cidadão.
  fields {
    // REVIEW [2026-12-15] Tipo do cidadão (pessoa ou organização); consultável por busca.
    kind: CitizenKind { title: { pt-BR: "Tipo", en: "Kind" }, lookup }
    // REVIEW [2026-12-15] Nome de exibição do cidadão; consultável e obrigatório.
    displayName: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Nome de exibição", en: "Display name" }
      // REVIEW [2026-12-15] Limita o nome a 160 caracteres.
      maxLength: 160
      // REVIEW [2026-12-15] Permite localizar o cidadão pelo nome.
      lookup
      // REVIEW [2026-12-15] Torna o nome obrigatório no preenchimento.
      required
    }
    // REVIEW [2026-12-15] Imagem de perfil do cidadão.
    avatar: Image { title: { pt-BR: "Imagem de perfil", en: "Avatar" } }
    // REVIEW [2026-12-15] País do cidadão; obrigatório.
    country: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "País", en: "Country" }
      // REVIEW [2026-12-15] Limita o país ao código de duas letras.
      maxLength: 2
      // REVIEW [2026-12-15] Torna o país obrigatório no preenchimento.
      required
    }
    // REVIEW [2026-12-15] Situação atual do cidadão; consultável por busca.
    status: CitizenStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    // REVIEW [2026-12-15] Cadastro de destino quando este cidadão foi mesclado.
    mergedInto: Citizen { title: { pt-BR: "Mesclado em", en: "Merged into" }, lookup }
    // REVIEW [2026-12-15] Instante em que a mesclagem ocorreu.
    mergedAt: DateTime { title: { pt-BR: "Mesclado em", en: "Merged at" } }
    // REVIEW [2026-12-15] Nome legal, dado pessoal privado.
    private legalName: string { title: { pt-BR: "Nome legal", en: "Legal name" }, maxLength: 200 }
    // REVIEW [2026-12-15] Data de nascimento, dado pessoal privado.
    private birthDate: Date { title: { pt-BR: "Data de nascimento", en: "Birth date" } }
    // REVIEW [2026-12-15] Resumo (hash) do documento de identificação, dado privado.
    private documentHash: string { title: { pt-BR: "Resumo do documento", en: "Document hash" }, maxLength: 128 }
    // REVIEW [2026-12-15] Instante de criação do cadastro.
    createdAt: DateTime { title: { pt-BR: "Criado em", en: "Created at" } }
  }

  // REVIEW [2026-12-15] Índices que aceleram buscas e consultas por campo.
  indexes {
    // REVIEW [2026-12-15] Índice de busca textual pelo nome de exibição.
    byDisplayName: [displayName] search
    // REVIEW [2026-12-15] Índice hash por tipo e situação.
    byKind: [kind, status] hash
    // REVIEW [2026-12-15] Índice hash por país.
    byCountry: [country] hash
    // REVIEW [2026-12-15] Índice hash pelo id do cadastro de destino da mesclagem.
    byMergedInto: [mergedInto.id] hash
  }


  // REVIEW [2026-12-15] Ações de negócio que alteram o cadastro.
  actions {
    // REVIEW [2026-12-15] Cadastra um cidadão genérico.
    register(kind: CitizenKind, displayName: string, country: string, legalName: string?, birthDate: Date?){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Cadastrar cidadão", en: "Register citizen" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Clerk]
      // REVIEW [2026-12-15] Corpo executado quando a ação é chamada.
      {
        // REVIEW [2026-12-15] Registra o instante de criação do cadastro.
        createdAt = now()
        // REVIEW [2026-12-15] Emite o evento Registered levando o nome de exibição.
        emit Registered { displayName }
      }
    }

    // REVIEW [2026-12-15] Cadastra uma pessoa física já preenchendo os dados obrigatórios.
    registerPerson(displayName: string, country: string, legalName: string, birthDate: Date?){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Cadastrar pessoa", en: "Register person" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Manager]
      // REVIEW [2026-12-15] Corpo executado quando a ação é chamada.
      {
        // REVIEW [2026-12-15] Fixa o tipo do cidadão como pessoa.
        kind = Person
        // REVIEW [2026-12-15] Registra o instante de criação do cadastro.
        createdAt = now()
        // REVIEW [2026-12-15] Emite o evento Registered levando o nome de exibição.
        emit Registered { displayName }
      }
    }

    // REVIEW [2026-12-15] Cadastra uma organização já preenchendo os dados obrigatórios.
    registerOrganization(displayName: string, country: string, legalName: string){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Cadastrar organização", en: "Register organization" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Manager]
      // REVIEW [2026-12-15] Corpo executado quando a ação é chamada.
      {
        // REVIEW [2026-12-15] Fixa o tipo do cidadão como organização.
        kind = Organization
        // REVIEW [2026-12-15] Registra o instante de criação do cadastro.
        createdAt = now()
        // REVIEW [2026-12-15] Emite o evento Registered levando o nome de exibição.
        emit Registered { displayName }
      }
    }

    // REVIEW [2026-12-15] Mescla este cidadão em outro cadastro alvo.
    merge(target: Citizen){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Mesclar", en: "Merge" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Manager]
      // REVIEW [2026-12-15] Transição de situação disparada pela ação.
      to: status.Merged
      // REVIEW [2026-12-15] Pré-condição da ação: alvo existente e diferente do próprio cadastro.
      rule target != null and target.id != id {
        // REVIEW [2026-12-15] Mensagem da pré-condição em português.
        pt-BR: "Selecione um cidadão de destino diferente do mesclado"
        // REVIEW [2026-12-15] Mensagem da pré-condição em inglês.
        en: "Select a target citizen different from the merged one"
      }
      // REVIEW [2026-12-15] Corpo executado quando a ação é chamada.
      {
        // REVIEW [2026-12-15] Aponta o cadastro para o cidadão sobrevivente.
        mergedInto = target
        // REVIEW [2026-12-15] Registra o instante da mesclagem.
        mergedAt = now()
      }
    }

    // REVIEW [2026-12-15] Bloqueia o cadastro informando uma justificativa.
    block(justification: string){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Bloquear", en: "Block" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Manager]
      // REVIEW [2026-12-15] Transição de situação disparada pela ação.
      to: status.Blocked
      // REVIEW [2026-12-15] Dados enviados no evento da transição.
      emits { reason: justification }
      // REVIEW [2026-12-15] Pré-condição da ação: justificativa com tamanho mínimo.
      rule justification.length >= 10 {
        // REVIEW [2026-12-15] Mensagem da pré-condição em português.
        pt-BR: "Informe um motivo com pelo menos 10 caracteres"
        // REVIEW [2026-12-15] Mensagem da pré-condição em inglês.
        en: "Enter a reason with at least 10 characters"
      }
    }
  }

  // REVIEW [2026-12-15] Validação global: o nome de exibição precisa existir.
  rule displayName != null {
    // REVIEW [2026-12-15] Mensagem de erro em português.
    pt-BR: "Informe o nome de exibição"
    // REVIEW [2026-12-15] Mensagem de erro em inglês.
    en: "Enter the display name"

  }
  // REVIEW [2026-12-15] Validação global: o país deve ter exatamente dois caracteres.
  rule country.length == 2 {
    // REVIEW [2026-12-15] Mensagem de erro em português.
    pt-BR: "Verifique o tamanho do texto informado"
    // REVIEW [2026-12-15] Mensagem de erro em inglês.
    en: "Check the informed text length"

  }
}

// REVIEW [2026-12-15] Forma de classificação que distingue pessoa de organização.
shape CitizenKind {
  // REVIEW [2026-12-15] Título exibido no formulário.
  title: { pt-BR: "Tipo de cidadão", en: "Citizen kind" }
  // REVIEW [2026-12-15] Tipo-base de classificação, com valores enumerados.
  base: classification
  // REVIEW [2026-12-15] Valor que representa uma pessoa física.
  value Person {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Pessoa", en: "Person" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: Person
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 10
  }
  // REVIEW [2026-12-15] Valor que representa uma organização.
  value Organization {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Organização", en: "Organization" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: Organization
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 20
  }
  // REVIEW [2026-12-15] Exibe o valor sem máscara.
  format: plain
}

// REVIEW [2026-12-15] Forma de estado que modela o ciclo de vida do cadastro.
shape CitizenStatus {
  // REVIEW [2026-12-15] Título exibido no formulário.
  title: { pt-BR: "Situação do cidadão", en: "Citizen status" }
  // REVIEW [2026-12-15] Tipo-base de máquina de estados.
  base: state
  // REVIEW [2026-12-15] Estado inicial Active, alcançado pela transição Registered.
  initial: Active with transition Registered {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Cidadão cadastrado", en: "Citizen registered" }
    // REVIEW [2026-12-15] Dados carregados pela transição.
    payload {
      // REVIEW [2026-12-15] Nome de exibição do cidadão cadastrado.
      displayName: string { title: { pt-BR: "Nome de exibição", en: "Display name" } }
    }
  }
  // REVIEW [2026-12-15] Estado Active: cadastro válido e utilizável.
  value Active {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Ativo", en: "Active" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Active
    // REVIEW [2026-12-15] Ordem de exibição do estado.
    ordinal: 10

    // REVIEW [2026-12-15] Transição de Active para Merged.
    transition Merged {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Cidadão mesclado", en: "Citizen merged" }
      // REVIEW [2026-12-15] Dados carregados pela transição.
      payload {
        // REVIEW [2026-12-15] Cidadão de destino da mesclagem.
        target: Citizen { title: { pt-BR: "Cidadão de destino", en: "Target citizen" } }
      }
    }

    // REVIEW [2026-12-15] Transição de Active para Blocked.
    transition Blocked {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Cidadão bloqueado", en: "Citizen blocked" }
      // REVIEW [2026-12-15] Dados carregados pela transição.
      payload {
        // REVIEW [2026-12-15] Motivo do bloqueio do cadastro.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado Merged: cadastro absorvido por outro.
  value Merged {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Mesclado", en: "Merged" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Merged
    // REVIEW [2026-12-15] Ordem de exibição do estado.
    ordinal: 20
  }
  // REVIEW [2026-12-15] Estado Blocked: cadastro impedido de operar.
  value Blocked {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Bloqueado", en: "Blocked" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Blocked
    // REVIEW [2026-12-15] Ordem de exibição do estado.
    ordinal: 30
  }
  // REVIEW [2026-12-15] Exibe o estado sem máscara.
  format: plain
}

// REVIEW [2026-12-15] Forma de imagem usada no avatar do cidadão.
shape Image {
  // REVIEW [2026-12-15] Título exibido no formulário.
  title: { pt-BR: "Imagem", en: "Image" }
  // REVIEW [2026-12-15] Tipo-base de imagem.
  base: image
  // REVIEW [2026-12-15] Capacidades habilitadas para a forma.
  capabilities { gui }
}

// REVIEW [2026-12-15] Form de cadastro de cidadão.
form Registration {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Cadastro de cidadão", en: "Citizen registration" }
  // REVIEW [2026-12-15] Documento-sujeito do form.
  document: Citizen

  // REVIEW [2026-12-15] Campos exibidos e coletados no form.
  fields {
    // REVIEW [2026-12-15] Tipo do cidadão.
    kind
    // REVIEW [2026-12-15] Nome de exibição do cidadão.
    displayName
    // REVIEW [2026-12-15] Imagem de perfil do cidadão.
    avatar
    // REVIEW [2026-12-15] País do cidadão.
    country
    // REVIEW [2026-12-15] Nome legal (dado privado).
    legalName
    // REVIEW [2026-12-15] Data de nascimento (dado privado).
    birthDate
  }

  // REVIEW [2026-12-15] Ações disponíveis no form.
  actions {
    // REVIEW [2026-12-15] Cadastrar delega a ação register do documento.
    register { calls: Citizen.register(kind, displayName, country, legalName, birthDate) }
  }
}
