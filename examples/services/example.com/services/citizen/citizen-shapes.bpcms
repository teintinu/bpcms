// service: example.com/services/citizen

shape Email {
  title: { pt-BR: "Correio eletrônico", en: "Email" }
  base: string
  normalize: lower-trim
  validate: email
  maxLength: 254
  format: plain
  index: exact
}

shape Phone {
  title: { pt-BR: "Telefone", en: "Phone" }
  base: string
  normalize: digits
  validate: phone
  maxLength: 20
  format: masked("+## (##) #####-####")
}
