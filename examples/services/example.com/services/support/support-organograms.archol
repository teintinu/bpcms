// REVIEW [2026-12-15] service: example.com/services/support

// REVIEW [2026-12-15] Organograma do serviço; deve ser o primeiro artefato do arquivo.
organogram Support {
  // REVIEW [2026-12-15] Título exibido no builder.
  title: { pt-BR: "Organograma de suporte", en: "Support organogram" }
  // REVIEW [2026-12-15] Estrutura hierárquica entre os papéis.
  hierarchy {
    // REVIEW [2026-12-15] O gerente fica acima do agente de suporte.
    Manager > SupportAgent
  }
  // REVIEW [2026-12-15] Declara explicitamente que o gerente coordena os agentes.
  Manager manages [SupportAgent]
}

// REVIEW [2026-12-15] Papel com poder de decisão sobre chamados e devoluções.
role Manager {
  // REVIEW [2026-12-15] Título exibido nas telas e nos filtros.
  title: { pt-BR: "Gerente de suporte", en: "Support manager" }
  // REVIEW [2026-12-15] Permissões concedidas ao papel.
  permissions: [
    // REVIEW [2026-12-15] Consultar o chamado.
    ticket.view,
    // REVIEW [2026-12-15] Distribuir o chamado para um agente.
    ticket.assign,
    // REVIEW [2026-12-15] Escalonar o chamado.
    ticket.escalate,
    // REVIEW [2026-12-15] Encerrar o chamado.
    ticket.close,
    // REVIEW [2026-12-15] Aprovar a devolução.
    return.approve,
    // REVIEW [2026-12-15] Rejeitar a devolução.
    return.reject,
    // REVIEW [2026-12-15] Cancelar a devolução.
    return.cancel,
    // REVIEW [2026-12-15] Efetivar o reembolso.
    return.refund,
    // REVIEW [2026-12-15] Consultar relatórios de atendimento.
    report.view
  ]
}

// REVIEW [2026-12-15] Papel operacional que atende e resolve chamados.
role SupportAgent {
  // REVIEW [2026-12-15] Título exibido nas telas e nos filtros.
  title: { pt-BR: "Agente de suporte", en: "Support agent" }
  // REVIEW [2026-12-15] Permissões concedidas ao papel.
  permissions: [
    // REVIEW [2026-12-15] Consultar o chamado.
    ticket.view,
    // REVIEW [2026-12-15] Comentar o chamado.
    ticket.comment,
    // REVIEW [2026-12-15] Assumir o chamado.
    ticket.assign,
    // REVIEW [2026-12-15] Resolver o chamado.
    ticket.resolve,
    // REVIEW [2026-12-15] Conferir a devolução.
    return.review,
    // REVIEW [2026-12-15] Registrar o recebimento da devolução.
    return.receive
  ]
}

// REVIEW [2026-12-15] Papel do cliente, restrito aos próprios registros.
role Customer {
  // REVIEW [2026-12-15] Título exibido nas telas.
  title: { pt-BR: "Cliente", en: "Customer" }
  // REVIEW [2026-12-15] Permissões apenas sobre os próprios chamados e devoluções.
  permissions: [ticket.viewOwn, ticket.commentOwn, return.requestOwn]
}
