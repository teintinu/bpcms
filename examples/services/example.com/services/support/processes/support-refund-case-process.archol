// REVIEW [2026-12-15] service: example.com/services/support
// REVIEW [2026-12-15] Process: sintaxe atual (DSL_REFERENCE.md §4)

// REVIEW [2026-12-15] Declara o processo RefundCase; a solicitação de devolução é o documento-sujeito.
process RefundCase(returnRequest: ReturnRequest) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Caso de devolução", en: "Refund case" }
  // REVIEW [2026-12-15] Versão do artefato Process; diff e release comparam.
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Decidir a elegibilidade, aprovar por alçada e reembolsar o cliente"
  }
  // REVIEW [2026-12-15] SLA brando do caso: alvo de lead time, não é timer.
  sla: "5d"

  // REVIEW [2026-12-15] Gatilho: inicia uma instância quando a devolução emite Requested.
  on [ReturnRequest.Requested]
  // REVIEW [2026-12-15] Chave de identidade, correlação e dedup da instância.
  key: returnRequest

  // REVIEW [2026-12-15] Variável durável da instância: parecer de elegibilidade.
  let verdict: RefundVerdict
  // REVIEW [2026-12-15] Flag durável que registra se o caso foi escalonado por timeout.
  let escalated = false

  // REVIEW [2026-12-15] Bloco que captura timeout do form de conferência.
  try {
    // REVIEW [2026-12-15] Abre o form de conferência da devolução para o agente.
    RefundReview.show({ returnRequest })
  } catch (Timeout) {
    // REVIEW [2026-12-15] Sem conferência no prazo, o caso é escalonado.
    escalated = true
  }

  // REVIEW [2026-12-15] Decide o parecer conforme a escalada.
  if (escalated) {
    // REVIEW [2026-12-15] Escalado sem análise: exige aprovação do gerente.
    verdict = ApprovalRequired
  } else {
    // REVIEW [2026-12-15] Calcula a elegibilidade a partir do valor e da idade do pedido.
    verdict = RefundEligibility.evaluate({
      // REVIEW [2026-12-15] Valor pedido para reembolso.
      amount: returnRequest.refundAmount,
      // REVIEW [2026-12-15] Idade do pedido em dias.
      orderAgeDays: returnRequest.order.ageDays
    })
  }

  // REVIEW [2026-12-15] Encaminha o caso conforme o parecer.
  if (verdict == Eligible) {
    // REVIEW [2026-12-15] Elegível: aprova a devolução automaticamente.
    ReturnRequest.approve()
  } else if (verdict == ApprovalRequired) {
    // REVIEW [2026-12-15] Exige aprovação: abre o form do gerente.
    RefundApproval.show({ returnRequest })
  } else {
    // REVIEW [2026-12-15] Não elegível: abre o form de recusa.
    RefundRejection.show({ returnRequest })
  }

  // REVIEW [2026-12-15] Se o gerente rejeitou, encerra o caso.
  if (returnRequest.status == Rejected) {
    // REVIEW [2026-12-15] Retorna o desfecho de recusa.
    return Rejected
  }

  // REVIEW [2026-12-15] Registra o recebimento da devolução.
  ReturnRequest.receive()
  // REVIEW [2026-12-15] Chama o serviço de pagamentos para estornar o valor.
  Payments.Payment.refund({ refundAmount: returnRequest.refundAmount })
  // REVIEW [2026-12-15] Marca a devolução como reembolsada.
  ReturnRequest.refund()

  // REVIEW [2026-12-15] Envia a mensagem com a decisão final ao cliente.
  send RefundDecision {
    // REVIEW [2026-12-15] Correlaciona a mensagem com a devolução.
    key: returnRequest
    // REVIEW [2026-12-15] Preenche o payload da mensagem.
    with {
      // REVIEW [2026-12-15] Parecer final da análise.
      verdict: verdict
      // REVIEW [2026-12-15] Valor reembolsado.
      amount: returnRequest.refundAmount
    }
  }

  // REVIEW [2026-12-15] Escuta o cancelamento da devolução enquanto o caso corre.
  cancel on ReturnRequest.Cancelled {
    // REVIEW [2026-12-15] Encerra o caso no desfecho de cancelamento.
    return Cancelled
  }

  // REVIEW [2026-12-15] Encerra no desfecho de reembolso concluído.
  return Refunded

  // REVIEW [2026-12-15] Declara o desfecho de sucesso do caso.
  end Refunded {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Devolução reembolsada", en: "Return refunded" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }

  // REVIEW [2026-12-15] Declara o desfecho de recusa do caso.
  end Rejected {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Devolução recusada", en: "Return rejected" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: failure
  }

  // REVIEW [2026-12-15] Declara o desfecho de cancelamento do caso.
  end Cancelled {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Devolução cancelada", en: "Return cancelled" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: cancelled
  }
}

// REVIEW [2026-12-15] Classificação que expressa o parecer de elegibilidade da devolução.
shape RefundVerdict {
  // REVIEW [2026-12-15] Título exibido no builder.
  title: { pt-BR: "Parecer da devolução", en: "Refund verdict" }
  // REVIEW [2026-12-15] Base de classificação: valores sem transições.
  base: classification
  // REVIEW [2026-12-15] Valor de devolução elegível para reembolso automático.
  value Eligible {
    // REVIEW [2026-12-15] Título exibido nas telas e filtros.
    title: { pt-BR: "Elegível", en: "Eligible" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: Eligible
    // REVIEW [2026-12-15] Ordem do valor na classificação.
    ordinal: 10
  }
  // REVIEW [2026-12-15] Valor que exige aprovação de gerente.
  value ApprovalRequired {
    // REVIEW [2026-12-15] Título exibido nas telas e filtros.
    title: { pt-BR: "Exige aprovação", en: "Approval required" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: ApprovalRequired
    // REVIEW [2026-12-15] Ordem do valor na classificação.
    ordinal: 20
  }
  // REVIEW [2026-12-15] Valor de devolução não elegível.
  value NotEligible {
    // REVIEW [2026-12-15] Título exibido nas telas e filtros.
    title: { pt-BR: "Não elegível", en: "Not eligible" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: NotEligible
    // REVIEW [2026-12-15] Ordem do valor na classificação.
    ordinal: 30
  }
  // REVIEW [2026-12-15] Renderização sem formatação especial.
  format: plain
}

// REVIEW [2026-12-15] Form de conferência da devolução pelo agente.
form RefundReview {
  // REVIEW [2026-12-15] Título exibido na inbox e no cabeçalho do form.
  title: { pt-BR: "Conferência da devolução", en: "Refund review" }
  // REVIEW [2026-12-15] Documento manipulado pelo form.
  document: ReturnRequest
  // REVIEW [2026-12-15] Apenas agentes conferem a devolução.
  roles: [SupportAgent]
  // REVIEW [2026-12-15] Prazo para a conferência; expira em Timeout.
  timeout: 4h
  // REVIEW [2026-12-15] Distribuição por retirada: o agente assume o item.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no form.
  fields {
    // REVIEW [2026-12-15] Pedido devolvido.
    order
    // REVIEW [2026-12-15] Pagamento a estornar.
    payment
    // REVIEW [2026-12-15] Remessa devolvida.
    shipment
    // REVIEW [2026-12-15] Motivo declarado pelo cliente.
    reason
    // REVIEW [2026-12-15] Valor pedido para reembolso.
    refundAmount
  }

  // REVIEW [2026-12-15] Ações oferecidas no form.
  actions {
    // REVIEW [2026-12-15] Confirma a conferência chamando a ação do documento.
    confirm { calls: ReturnRequest.review }
  }
}

// REVIEW [2026-12-15] Form de aprovação da devolução pelo gerente.
form RefundApproval {
  // REVIEW [2026-12-15] Título exibido na inbox e no cabeçalho do form.
  title: { pt-BR: "Aprovação da devolução", en: "Refund approval" }
  // REVIEW [2026-12-15] Documento manipulado pelo form.
  document: ReturnRequest
  // REVIEW [2026-12-15] Apenas gerentes aprovam ou rejeitam.
  roles: [Manager]
  // REVIEW [2026-12-15] Prazo para a decisão; expira em Timeout.
  timeout: 2d
  // REVIEW [2026-12-15] Distribuição por retirada: o gerente assume o item.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no form.
  fields {
    // REVIEW [2026-12-15] Pedido devolvido.
    order
    // REVIEW [2026-12-15] Valor a reembolsar.
    refundAmount
    // REVIEW [2026-12-15] Justificativa digitada ao rejeitar.
    justification: string {
      // REVIEW [2026-12-15] Título exibido no campo.
      title: { pt-BR: "Motivo da rejeição", en: "Rejection reason" }
    }
  }

  // REVIEW [2026-12-15] Ações oferecidas no form.
  actions {
    // REVIEW [2026-12-15] Aprova a devolução chamando a ação do documento.
    approve { calls: ReturnRequest.approve }
    // REVIEW [2026-12-15] Rejeita a devolução com a justificativa informada.
    reject { calls: ReturnRequest.reject(justification) }
  }
}

// REVIEW [2026-12-15] Form de recusa da devolução pelo gerente.
form RefundRejection {
  // REVIEW [2026-12-15] Título exibido na inbox e no cabeçalho do form.
  title: { pt-BR: "Recusa da devolução", en: "Refund rejection" }
  // REVIEW [2026-12-15] Documento manipulado pelo form.
  document: ReturnRequest
  // REVIEW [2026-12-15] Apenas gerentes registram a recusa.
  roles: [Manager]
  // REVIEW [2026-12-15] Prazo para registrar a recusa; expira em Timeout.
  timeout: 3d
  // REVIEW [2026-12-15] Distribuição por retirada: o gerente assume o item.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no form.
  fields {
    // REVIEW [2026-12-15] Pedido devolvido.
    order
    // REVIEW [2026-12-15] Motivo declarado pelo cliente.
    reason
    // REVIEW [2026-12-15] Justificativa digitada ao rejeitar.
    justification: string {
      // REVIEW [2026-12-15] Título exibido no campo.
      title: { pt-BR: "Motivo da rejeição", en: "Rejection reason" }
    }
  }

  // REVIEW [2026-12-15] Ações oferecidas no form.
  actions {
    // REVIEW [2026-12-15] Rejeita a devolução com a justificativa informada.
    reject { calls: ReturnRequest.reject(justification) }
  }
}

// REVIEW [2026-12-15] Decisão que calcula a elegibilidade da devolução.
decision RefundEligibility {
  // REVIEW [2026-12-15] Título exibido no builder e nos logs de decisão.
  title: { pt-BR: "Elegibilidade da devolução", en: "Refund eligibility" }
  // REVIEW [2026-12-15] Tipo devolvido pela decisão: o parecer calculado.
  returns: RefundVerdict
  // REVIEW [2026-12-15] Entradas exigidas para avaliar a decisão.
  inputs {
    // REVIEW [2026-12-15] Valor pedido para reembolso.
    amount: std.Money
    // REVIEW [2026-12-15] Idade do pedido em dias.
    orderAgeDays: std.Count
  }
  // REVIEW [2026-12-15] Regras avaliadas em ordem até o primeiro caso verdadeiro.
  cases {
    // REVIEW [2026-12-15] Dentro do limite e do prazo de trinta dias: elegível.
    amount <= RefundLimit and orderAgeDays <= 30 -> Eligible
    // REVIEW [2026-12-15] Acima do prazo de trinta dias: não elegível.
    amount <= RefundLimit -> NotEligible
    // REVIEW [2026-12-15] Acima do limite, mas dentro do prazo: exige aprovação.
    orderAgeDays <= 30 -> ApprovalRequired
    // REVIEW [2026-12-15] Acima do limite e do prazo: não elegível.
    else -> NotEligible
  }
  // REVIEW [2026-12-15] Origem normativa da regra de negócio.
  source: "Política de devolução v1"
  // REVIEW [2026-12-15] Área dona da decisão.
  owner: Support
}
