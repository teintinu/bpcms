// REVIEW [2026-12-15] service: example.com/services/support
// REVIEW [2026-12-15] Process: sintaxe atual (DSL_REFERENCE.md §4)

// REVIEW [2026-12-15] Declara o processo TicketTriage; o chamado é o documento-sujeito da instância.
process TicketTriage(ticket: Ticket) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Triagem do chamado", en: "Ticket triage" }
  // REVIEW [2026-12-15] Versão do artefato Process; diff e release comparam.
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Classificar, encaminhar e responder o chamado dentro do prazo"
  }
  // REVIEW [2026-12-15] SLA brando do caso: alvo de lead time, não é timer.
  sla: 8h

  // REVIEW [2026-12-15] Gatilho: inicia uma instância quando o chamado emite Opened.
  on [Ticket.Opened]
  // REVIEW [2026-12-15] Chave de identidade, correlação e dedup da instância.
  key: ticket

  // REVIEW [2026-12-15] Variável durável da instância: fila de destino calculada na triagem.
  let queue: TicketCategory
  // REVIEW [2026-12-15] Flag durável que registra se a triagem já foi tratada.
  let handled = false

  // REVIEW [2026-12-15] Laço de tentativas de triagem, limitado a duas iterações.
  loop TriageAttempt max 2 {
    // REVIEW [2026-12-15] Reinicia a flag a cada tentativa.
    handled = false

    // REVIEW [2026-12-15] Bloco que captura timeout do form de triagem.
    try {
      // REVIEW [2026-12-15] Abre o form de triagem para o agente classificar o chamado.
      TicketIntake.show({ ticket })
    } catch (Timeout) {
      // REVIEW [2026-12-15] Sem resposta no prazo: marca como tratado e escala para o gerente.
      handled = true
      // REVIEW [2026-12-15] Abre o form de escalonamento.
      TicketEscalation.show({ ticket })
    }

    // REVIEW [2026-12-15] Se o chamado já saiu de Aberto, a triagem terminou.
    if (ticket.status != Open) {
      // REVIEW [2026-12-15] Sai do laço de tentativas.
      break
    }

    // REVIEW [2026-12-15] Se a tentativa não foi tratada, escala o chamado.
    if (!handled) {
      // REVIEW [2026-12-15] Abre o form de escalonamento para o gerente.
      TicketEscalation.show({ ticket })
    }
  }

  // REVIEW [2026-12-15] Calcula a fila de destino a partir de categoria e prioridade.
  queue = TicketRouting.evaluate({
    // REVIEW [2026-12-15] Categoria informada na triagem.
    category: ticket.category,
    // REVIEW [2026-12-15] Prioridade informada na triagem.
    priority: ticket.priority
  })

  // REVIEW [2026-12-15] Technical, Billing e General usam o mesmo form nesta versão; a fila segue no documento.
  TicketResolution.show({ ticket })

  // REVIEW [2026-12-15] Se o form não deixou o chamado Resolvido, insiste no escalonamento.
  if (ticket.status != Resolved) {
    // REVIEW [2026-12-15] Escala para o gerente antes de tentar resolver de novo.
    TicketEscalation.show({ ticket })
    // REVIEW [2026-12-15] Reabre o form de resolução para concluir o atendimento.
    TicketResolution.show({ ticket })
  }

  // REVIEW [2026-12-15] Fecha o chamado ao final do atendimento.
  Ticket.close()

  // REVIEW [2026-12-15] Dispara as duas comunicações em paralelo.
  parallel {
    // REVIEW [2026-12-15] Ramo que avisa o cliente.
    branch TellCustomer {
      // REVIEW [2026-12-15] Envia a confirmação de recebimento do chamado.
      send TicketAcknowledged {
        // REVIEW [2026-12-15] Correlaciona a mensagem com o chamado.
        key: ticket
        // REVIEW [2026-12-15] Preenche o payload da mensagem.
        with {
          // REVIEW [2026-12-15] Assunto do chamado.
          subject: ticket.subject
          // REVIEW [2026-12-15] Prioridade do chamado.
          priority: ticket.priority
        }
      }
    }

    // REVIEW [2026-12-15] Ramo que avisa o back office.
    branch TellBackOffice {
      // REVIEW [2026-12-15] Envia a atualização do chamado para a fila.
      send TicketUpdate {
        // REVIEW [2026-12-15] Correlaciona a mensagem com o chamado.
        key: ticket
        // REVIEW [2026-12-15] Preenche o payload da mensagem.
        with {
          // REVIEW [2026-12-15] Assunto do chamado.
          subject: ticket.subject
          // REVIEW [2026-12-15] Fila calculada pelo roteamento.
          queue: queue
        }
      }
    }
  }

  // REVIEW [2026-12-15] Encerra no desfecho de sucesso.
  return Done

  // REVIEW [2026-12-15] Declara o desfecho de sucesso do caso.
  end Done {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Chamado encerrado", en: "Ticket closed" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }
}

// REVIEW [2026-12-15] Form de triagem inicial do chamado.
form TicketIntake {
  // REVIEW [2026-12-15] Título exibido na inbox e no cabeçalho do form.
  title: { pt-BR: "Triagem do chamado", en: "Ticket intake" }
  // REVIEW [2026-12-15] Documento manipulado pelo form.
  document: Ticket
  // REVIEW [2026-12-15] Papéis que podem preencher o form.
  roles: [SupportAgent]
  // REVIEW [2026-12-15] Prazo para o preenchimento; expira em Timeout.
  timeout: 1d
  // REVIEW [2026-12-15] Prioridade de distribuição na fila de trabalho.
  priority: 50
  // REVIEW [2026-12-15] Distribuição por retirada: o agente assume o item.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no form.
  fields {
    // REVIEW [2026-12-15] Assunto do chamado.
    subject
    // REVIEW [2026-12-15] Descrição do problema.
    description
    // REVIEW [2026-12-15] Prioridade escolhida na triagem.
    priority
    // REVIEW [2026-12-15] Categoria escolhida na triagem.
    category
    // REVIEW [2026-12-15] Pedido relacionado ao chamado.
    order
    // REVIEW [2026-12-15] Cliente que abriu o chamado.
    customer
    // REVIEW [2026-12-15] Justificativa digitada ao escalonar pelo form.
    justification: string {
      // REVIEW [2026-12-15] Título exibido no campo.
      title: { pt-BR: "Motivo do escalonamento", en: "Escalation reason" }
      // REVIEW [2026-12-15] Limita o texto a quinhentos caracteres.
      maxLength: 500
    }
  }

  // REVIEW [2026-12-15] Ações oferecidas no form.
  actions {
    // REVIEW [2026-12-15] Assume o chamado chamando a ação do documento.
    claim { calls: Ticket.claim }
    // REVIEW [2026-12-15] Escala o chamado com a justificativa e permanece no form.
    escalate { calls: Ticket.escalate(justification); stay }
  }
}

// REVIEW [2026-12-15] Form de resolução do chamado.
form TicketResolution {
  // REVIEW [2026-12-15] Título exibido na inbox e no cabeçalho do form.
  title: { pt-BR: "Resolução do chamado", en: "Ticket resolution" }
  // REVIEW [2026-12-15] Documento manipulado pelo form.
  document: Ticket
  // REVIEW [2026-12-15] Agentes e gerentes podem preencher o form.
  roles: [SupportAgent, Manager]
  // REVIEW [2026-12-15] Prazo para o preenchimento; expira em Timeout.
  timeout: 2d
  // REVIEW [2026-12-15] Distribuição por retirada: o agente assume o item.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no form.
  fields {
    // REVIEW [2026-12-15] Assunto do chamado.
    subject
    // REVIEW [2026-12-15] Descrição do problema.
    description
    // REVIEW [2026-12-15] Responsável pelo atendimento.
    assignee
    // REVIEW [2026-12-15] Justificativa digitada ao colocar em espera ou escalonar.
    justification: string {
      // REVIEW [2026-12-15] Título exibido no campo.
      title: { pt-BR: "Motivo da espera ou do escalonamento", en: "Hold or escalation reason" }
      // REVIEW [2026-12-15] Limita o texto a quinhentos caracteres.
      maxLength: 500
    }
  }

  // REVIEW [2026-12-15] Ações oferecidas no form.
  actions {
    // REVIEW [2026-12-15] Resolve o chamado chamando a ação do documento.
    resolve { calls: Ticket.resolve }
    // REVIEW [2026-12-15] Coloca em espera e permanece no form.
    hold { calls: Ticket.hold; stay }
    // REVIEW [2026-12-15] Escala com a justificativa e permanece no form.
    escalate { calls: Ticket.escalate(justification); stay }
  }
}

// REVIEW [2026-12-15] Form de escalonamento para o gerente.
form TicketEscalation {
  // REVIEW [2026-12-15] Título exibido na inbox e no cabeçalho do form.
  title: { pt-BR: "Escalonamento do chamado", en: "Ticket escalation" }
  // REVIEW [2026-12-15] Documento manipulado pelo form.
  document: Ticket
  // REVIEW [2026-12-15] Apenas gerentes preenchem o form.
  roles: [Manager]
  // REVIEW [2026-12-15] Prazo curto de atendimento do escalonamento.
  timeout: 4h
  // REVIEW [2026-12-15] Distribuição por retirada: o gerente assume o item.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no form.
  fields {
    // REVIEW [2026-12-15] Assunto do chamado.
    subject
    // REVIEW [2026-12-15] Prioridade do chamado.
    priority
    // REVIEW [2026-12-15] Justificativa do escalonamento.
    justification: string {
      // REVIEW [2026-12-15] Título exibido no campo.
      title: { pt-BR: "Motivo do escalonamento", en: "Escalation reason" }
      // REVIEW [2026-12-15] Limita o texto a quinhentos caracteres.
      maxLength: 500
    }
  }

  // REVIEW [2026-12-15] Ações oferecidas no form.
  actions {
    // REVIEW [2026-12-15] Escala o chamado chamando a ação do documento.
    escalate { calls: Ticket.escalate(justification) }
  }
}

// REVIEW [2026-12-15] Decisão que calcula a fila de destino do chamado.
decision TicketRouting {
  // REVIEW [2026-12-15] Título exibido no builder e nos logs de decisão.
  title: { pt-BR: "Roteamento do chamado", en: "Ticket routing" }
  // REVIEW [2026-12-15] Tipo devolvido pela decisão: a categoria/fila calculada.
  returns: TicketCategory
  // REVIEW [2026-12-15] Entradas exigidas para avaliar a decisão.
  inputs {
    // REVIEW [2026-12-15] Categoria do chamado.
    category: TicketCategory
    // REVIEW [2026-12-15] Prioridade do chamado.
    priority: TicketPriority
  }
  // REVIEW [2026-12-15] Regras avaliadas em ordem até o primeiro caso verdadeiro.
  cases {
    // REVIEW [2026-12-15] Cobrança sempre vai para a fila de Cobrança.
    category == Billing -> Billing
    // REVIEW [2026-12-15] Problema técnico de prioridade máxima vai para Técnico.
    category == Technical and priority == P1 -> Technical
    // REVIEW [2026-12-15] Qualquer outro caso cai na fila Geral.
    else -> General
  }
  // REVIEW [2026-12-15] Origem normativa da regra de negócio.
  source: "Política de atendimento v1"
  // REVIEW [2026-12-15] Área dona da decisão.
  owner: Support
}
