// service: example.com/services/support

document ReturnRequest {
  title: { pt-BR: "Solicitação de devolução", en: "Return request" }
  version: 1
  owner: "Support"
  sync: live
  fields {
    order: Order {
      title: { pt-BR: "Pedido", en: "Order" }
      lookup
    }
    payment: Payment {
      title: { pt-BR: "Pagamento", en: "Payment" }
    }
    shipment: Shipment {
      title: { pt-BR: "Remessa", en: "Shipment" }
    }
    reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
    status: ReturnStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    refundAmount: std.Money { title: { pt-BR: "Valor do reembolso", en: "Refund amount" }, lookup, currency: BRL }
    requestedAt: DateTime { title: { pt-BR: "Solicitado em", en: "Requested at" } }
    reviewedAt: DateTime { title: { pt-BR: "Conferido em", en: "Reviewed at" } }
    refundedAt: DateTime { title: { pt-BR: "Reembolsado em", en: "Refunded at" } }
  }

  indexes {
    byOrder: [order.id] hash
    byStatus: [status, requestedAt] range
  }


  actions {
    request(justification: string){
      title: { pt-BR: "Solicitar devolução", en: "Request return" }
      roles: [SupportAgent]
      rule justification.length >= 10 {
        pt-BR: "Informe um motivo com pelo menos 10 caracteres"
        en: "Enter a reason with at least 10 characters"
      }
      {
        reason = justification
        requestedAt = now()
        emit Requested { reason: justification }
      }
    }

    review(){
      title: { pt-BR: "Conferir devolução", en: "Review return" }
      roles: [SupportAgent]
      {
        reviewedAt = now()
      }
    }

    approve(){
      title: { pt-BR: "Aprovar devolução", en: "Approve return" }
      roles: [Manager]
      to: status.Approved
    }

    reject(justification: string){
      title: { pt-BR: "Rejeitar devolução", en: "Reject return" }
      roles: [Manager]
      to: status.Rejected
      emits { reason: justification }
      rule justification.length >= 10 {
        pt-BR: "Informe um motivo com pelo menos 10 caracteres"
        en: "Enter a reason with at least 10 characters"
      }
    }

    receive(){
      title: { pt-BR: "Receber devolução", en: "Receive return" }
      roles: [SupportAgent]
      to: status.Received
    }

    refund(){
      title: { pt-BR: "Reembolsar", en: "Refund" }
      roles: [Manager]
      to: status.Refunded
      {
        refundedAt = now()
      }
    }

    cancel(justification: string){
      title: { pt-BR: "Cancelar devolução", en: "Cancel return" }
      roles: [Manager]
      to: status.Cancelled
      emits { reason: justification }
    }
  }

  rule refundAmount >= 0 {
    pt-BR: "Verifique os dados informados"
    en: "Check the informed data"

  }
  rule status == Approved implies refundAmount > 0 {
    pt-BR: "A devolução aprovada precisa ter valor"
    en: "Approved return must have a value"

  }
}

shape ReturnStatus {
  title: { pt-BR: "Situação da devolução", en: "Return status" }
  base: state
  initial: Requested with transition Requested {
    title: { pt-BR: "Devolução solicitada", en: "Return requested" }
    payload {
      reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
    }
  }
  value Requested {
    title: { pt-BR: "Solicitado", en: "Requested" }
    icon: Requested
    ordinal: 10

    transition Approved {
      title: { pt-BR: "Devolução aprovada", en: "Return approved" }
      payload {
        refundAmount: std.Money { title: { pt-BR: "Valor do reembolso", en: "Refund amount" } }
      }
    }

    transition Rejected {
      title: { pt-BR: "Devolução rejeitada", en: "Return rejected" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }

    transition Cancelled {
      title: { pt-BR: "Devolução cancelada", en: "Return cancelled" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Approved {
    title: { pt-BR: "Aprovado", en: "Approved" }
    icon: Approved
    ordinal: 20

    transition Received {
      title: { pt-BR: "Devolução recebida", en: "Return received" }
    }

    transition Cancelled {
      title: { pt-BR: "Devolução cancelada", en: "Return cancelled" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Rejected {
    title: { pt-BR: "Rejeitado", en: "Rejected" }
    icon: Rejected
    ordinal: 30
  }
  value Received {
    title: { pt-BR: "Recebida", en: "Received" }
    icon: Received
    ordinal: 40

    transition Refunded {
      title: { pt-BR: "Devolução reembolsada", en: "Return refunded" }
      payload {
        refundAmount: std.Money { title: { pt-BR: "Valor do reembolso", en: "Refund amount" } }
      }
    }

    transition Cancelled {
      title: { pt-BR: "Devolução cancelada", en: "Return cancelled" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Refunded {
    title: { pt-BR: "Reembolsado", en: "Refunded" }
    icon: Refunded
    ordinal: 50
  }
  value Cancelled {
    title: { pt-BR: "Cancelado", en: "Cancelled" }
    icon: Cancelled
    ordinal: 60
  }
  format: plain
}

view ReturnRequests {
  title: { pt-BR: "Solicitações de devolução", en: "Return requests" }
  type: table
  source: ReturnRequest
  roles: [SupportAgent, Manager]

  columns { order; status; refundAmount; requestedAt }
  filters { status; period }
  pagination: 50
  actions {
    open -> RefundCaseProgress
  }
}

message RefundDecision {
  title: { pt-BR: "Decisão da devolução", en: "Refund decision" }
  about: ReturnRequest
  payload {
    verdict: RefundVerdict { title: { pt-BR: "Parecer", en: "Verdict" } }
    amount: std.Money { title: { pt-BR: "Valor", en: "Amount" } }
  }
}

policy RefundAuthorization {
  appliesTo: ReturnRequest.refund
  rule: refundAmount <= RefundLimit
  severity: block
  message: "Reembolso acima do limite exige aprovação de gerente"
  audit: true
}
