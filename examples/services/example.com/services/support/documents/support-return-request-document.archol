// REVIEW [2026-12-15] service: example.com/services/support

// REVIEW [2026-12-15] Documento que representa uma solicitação de devolução.
document ReturnRequest {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Solicitação de devolução", en: "Return request" }
  // REVIEW [2026-12-15] Versão do artefato Document; diff e release comparam.
  // REVIEW [2026-12-15] Área responsável pelo documento.
  // REVIEW [2026-12-15] Sincronização ao vivo: réplicas acompanham cada transição.
  sync: live
  // REVIEW [2026-12-15] Campos que compõem a solicitação.
  fields {
    // REVIEW [2026-12-15] Pedido que o cliente quer devolver; consultável.
    order: Order {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Pedido", en: "Order" }
      // REVIEW [2026-12-15] Permite localizar a devolução pelo pedido.
      lookup
    }
    // REVIEW [2026-12-15] Pagamento que será estornado no reembolso.
    payment: Payment {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Pagamento", en: "Payment" }
    }
    // REVIEW [2026-12-15] Remessa devolvida pelo cliente.
    shipment: Shipment {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Remessa", en: "Shipment" }
    }
    // REVIEW [2026-12-15] Motivo declarado pelo cliente para devolver.
    reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
    // REVIEW [2026-12-15] Situação atual da devolução, consultável.
    status: ReturnStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    // REVIEW [2026-12-15] Valor a reembolsar em reais; consultável.
    refundAmount: std.Money { title: { pt-BR: "Valor do reembolso", en: "Refund amount" }, lookup, currency: BRL }
    // REVIEW [2026-12-15] Instante em que o cliente pediu a devolução.
    requestedAt: DateTime { title: { pt-BR: "Solicitado em", en: "Requested at" } }
    // REVIEW [2026-12-15] Instante da conferência feita pelo agente.
    reviewedAt: DateTime { title: { pt-BR: "Conferido em", en: "Reviewed at" } }
    // REVIEW [2026-12-15] Instante em que o reembolso foi efetivado.
    refundedAt: DateTime { title: { pt-BR: "Reembolsado em", en: "Refunded at" } }
  }

  // REVIEW [2026-12-15] Índices que sustentam consultas e filas da devolução.
  indexes {
    // REVIEW [2026-12-15] Recupera a devolução a partir do pedido.
    byOrder: [order.id] hash
    // REVIEW [2026-12-15] Fila de devoluções por situação e data do pedido.
    byStatus: [status, requestedAt] range
  }


  // REVIEW [2026-12-15] Ações que operam o ciclo de vida da devolução.
  actions {
    // REVIEW [2026-12-15] Registra o pedido de devolução com justificativa.
    request(justification: string){
      // REVIEW [2026-12-15] Título exibido no botão.
      title: { pt-BR: "Solicitar devolução", en: "Request return" }
      // REVIEW [2026-12-15] Apenas agentes registram a solicitação.
      roles: [SupportAgent]
      // REVIEW [2026-12-15] Exige justificativa com pelo menos 10 caracteres.
      rule justification.length >= 10 {
        // REVIEW [2026-12-15] Mensagem de validação em português.
        pt-BR: "Informe um motivo com pelo menos 10 caracteres"
        // REVIEW [2026-12-15] Mensagem de validação em inglês.
        en: "Enter a reason with at least 10 characters"
      }
      // REVIEW [2026-12-15] Efeitos executados quando a validação passa.
      {
        // REVIEW [2026-12-15] Grava a justificativa como motivo da devolução.
        reason = justification
        // REVIEW [2026-12-15] Registra o instante da solicitação.
        requestedAt = now()
        // REVIEW [2026-12-15] Emite o evento Requested com o motivo.
        emit Requested { reason: justification }
      }
    }

    // REVIEW [2026-12-15] Marca a conferência da devolução pelo agente.
    review(){
      // REVIEW [2026-12-15] Título exibido no botão.
      title: { pt-BR: "Conferir devolução", en: "Review return" }
      // REVIEW [2026-12-15] Apenas agentes conferem devoluções.
      roles: [SupportAgent]
      // REVIEW [2026-12-15] Efeitos da ação.
      {
        // REVIEW [2026-12-15] Registra o instante da conferência.
        reviewedAt = now()
      }
    }

    // REVIEW [2026-12-15] Aprova a devolução.
    approve(){
      // REVIEW [2026-12-15] Título exibido no botão.
      title: { pt-BR: "Aprovar devolução", en: "Approve return" }
      // REVIEW [2026-12-15] Somente gerentes aprovam devoluções.
      roles: [Manager]
      // REVIEW [2026-12-15] Transição para Aprovado.
      to: status.Approved
    }

    // REVIEW [2026-12-15] Rejeita a devolução com justificativa.
    reject(justification: string){
      // REVIEW [2026-12-15] Título exibido no botão.
      title: { pt-BR: "Rejeitar devolução", en: "Reject return" }
      // REVIEW [2026-12-15] Somente gerentes rejeitam devoluções.
      roles: [Manager]
      // REVIEW [2026-12-15] Transição para Rejeitado.
      to: status.Rejected
      // REVIEW [2026-12-15] Mapeia a justificativa para o campo reason do evento Rejected.
      emits { reason: justification }
      // REVIEW [2026-12-15] Exige justificativa com pelo menos 10 caracteres.
      rule justification.length >= 10 {
        // REVIEW [2026-12-15] Mensagem de validação em português.
        pt-BR: "Informe um motivo com pelo menos 10 caracteres"
        // REVIEW [2026-12-15] Mensagem de validação em inglês.
        en: "Enter a reason with at least 10 characters"
      }
    }

    // REVIEW [2026-12-15] Registra o recebimento físico da devolução.
    receive(){
      // REVIEW [2026-12-15] Título exibido no botão.
      title: { pt-BR: "Receber devolução", en: "Receive return" }
      // REVIEW [2026-12-15] Apenas agentes registram o recebimento.
      roles: [SupportAgent]
      // REVIEW [2026-12-15] Transição para Recebida.
      to: status.Received
    }

    // REVIEW [2026-12-15] Efetiva o reembolso da devolução.
    refund(){
      // REVIEW [2026-12-15] Título exibido no botão.
      title: { pt-BR: "Reembolsar", en: "Refund" }
      // REVIEW [2026-12-15] Somente gerentes reembolsam.
      roles: [Manager]
      // REVIEW [2026-12-15] Transição para Reembolsado.
      to: status.Refunded
      // REVIEW [2026-12-15] Efeitos da ação.
      {
        // REVIEW [2026-12-15] Registra o instante do reembolso.
        refundedAt = now()
      }
    }

    // REVIEW [2026-12-15] Cancela a devolução com justificativa.
    cancel(justification: string){
      // REVIEW [2026-12-15] Título exibido no botão.
      title: { pt-BR: "Cancelar devolução", en: "Cancel return" }
      // REVIEW [2026-12-15] Somente gerentes cancelam devoluções.
      roles: [Manager]
      // REVIEW [2026-12-15] Transição para Cancelado.
      to: status.Cancelled
      // REVIEW [2026-12-15] Mapeia a justificativa para o campo reason do evento Cancelled.
      emits { reason: justification }
    }
  }

  // REVIEW [2026-12-15] Invariante: o valor do reembolso nunca pode ser negativo.
  rule refundAmount >= 0 {
    // REVIEW [2026-12-15] Mensagem da invariante em português.
    pt-BR: "Verifique os dados informados"
    // REVIEW [2026-12-15] Mensagem da invariante em inglês.
    en: "Check the informed data"

  }
  // REVIEW [2026-12-15] Invariante: devolução aprovada precisa ter valor de reembolso.
  rule status == Approved implies refundAmount > 0 {
    // REVIEW [2026-12-15] Mensagem da invariante em português.
    pt-BR: "A devolução aprovada precisa ter valor"
    // REVIEW [2026-12-15] Mensagem da invariante em inglês.
    en: "Approved return must have a value"

  }
}

// REVIEW [2026-12-15] Máquina de estados que conduz a situação da devolução.
shape ReturnStatus {
  // REVIEW [2026-12-15] Título exibido no builder.
  title: { pt-BR: "Situação da devolução", en: "Return status" }
  // REVIEW [2026-12-15] Base de estado: valores com transições nomeadas.
  base: state
  // REVIEW [2026-12-15] Estado inicial Solicitado, alcançado pela transição Requested.
  initial: Requested with transition Requested {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Devolução solicitada", en: "Return requested" }
    // REVIEW [2026-12-15] Dados exigidos para entrar no estado inicial.
    payload {
      // REVIEW [2026-12-15] Motivo informado pelo cliente.
      reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
    }
  }
  // REVIEW [2026-12-15] Estado Solicitado.
  value Requested {
    // REVIEW [2026-12-15] Título exibido nas telas e filtros.
    title: { pt-BR: "Solicitado", en: "Requested" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Requested
    // REVIEW [2026-12-15] Ordem do estado no fluxo.
    ordinal: 10

    // REVIEW [2026-12-15] Transição de Solicitado para Aprovado.
    transition Approved {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Devolução aprovada", en: "Return approved" }
      // REVIEW [2026-12-15] Dados levados ao aprovar.
      payload {
        // REVIEW [2026-12-15] Valor aprovado para reembolso.
        refundAmount: std.Money { title: { pt-BR: "Valor do reembolso", en: "Refund amount" } }
      }
    }

    // REVIEW [2026-12-15] Transição de Solicitado para Rejeitado.
    transition Rejected {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Devolução rejeitada", en: "Return rejected" }
      // REVIEW [2026-12-15] Dados levados ao rejeitar.
      payload {
        // REVIEW [2026-12-15] Motivo da rejeição.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }

    // REVIEW [2026-12-15] Transição de Solicitado para Cancelado.
    transition Cancelled {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Devolução cancelada", en: "Return cancelled" }
      // REVIEW [2026-12-15] Dados levados ao cancelar.
      payload {
        // REVIEW [2026-12-15] Motivo do cancelamento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado Aprovado.
  value Approved {
    // REVIEW [2026-12-15] Título exibido nas telas e filtros.
    title: { pt-BR: "Aprovado", en: "Approved" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Approved
    // REVIEW [2026-12-15] Ordem do estado no fluxo.
    ordinal: 20

    // REVIEW [2026-12-15] Transição de Aprovado para Recebida.
    transition Received {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Devolução recebida", en: "Return received" }
    }

    // REVIEW [2026-12-15] Transição de Aprovado para Cancelado.
    transition Cancelled {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Devolução cancelada", en: "Return cancelled" }
      // REVIEW [2026-12-15] Dados levados ao cancelar.
      payload {
        // REVIEW [2026-12-15] Motivo do cancelamento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado Rejeitado, terminal.
  value Rejected {
    // REVIEW [2026-12-15] Título exibido nas telas e filtros.
    title: { pt-BR: "Rejeitado", en: "Rejected" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Rejected
    // REVIEW [2026-12-15] Ordem do estado no fluxo.
    ordinal: 30
  }
  // REVIEW [2026-12-15] Estado Recebida.
  value Received {
    // REVIEW [2026-12-15] Título exibido nas telas e filtros.
    title: { pt-BR: "Recebida", en: "Received" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Received
    // REVIEW [2026-12-15] Ordem do estado no fluxo.
    ordinal: 40

    // REVIEW [2026-12-15] Transição de Recebida para Reembolsado.
    transition Refunded {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Devolução reembolsada", en: "Return refunded" }
      // REVIEW [2026-12-15] Dados levados ao reembolsar.
      payload {
        // REVIEW [2026-12-15] Valor efetivamente reembolsado.
        refundAmount: std.Money { title: { pt-BR: "Valor do reembolso", en: "Refund amount" } }
      }
    }

    // REVIEW [2026-12-15] Transição de Recebida para Cancelado.
    transition Cancelled {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Devolução cancelada", en: "Return cancelled" }
      // REVIEW [2026-12-15] Dados levados ao cancelar.
      payload {
        // REVIEW [2026-12-15] Motivo do cancelamento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado terminal Reembolsado.
  value Refunded {
    // REVIEW [2026-12-15] Título exibido nas telas e filtros.
    title: { pt-BR: "Reembolsado", en: "Refunded" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Refunded
    // REVIEW [2026-12-15] Ordem do estado no fluxo.
    ordinal: 50
  }
  // REVIEW [2026-12-15] Estado terminal Cancelado.
  value Cancelled {
    // REVIEW [2026-12-15] Título exibido nas telas e filtros.
    title: { pt-BR: "Cancelado", en: "Cancelled" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Cancelled
    // REVIEW [2026-12-15] Ordem do estado no fluxo.
    ordinal: 60
  }
  // REVIEW [2026-12-15] Renderização sem formatação especial.
  format: plain
}

// REVIEW [2026-12-15] Política que restringe reembolso acima do limite configurado.
policy RefundAuthorization {
  // REVIEW [2026-12-15] Ação específica à qual a política se aplica.
  appliesTo: ReturnRequest.refund
  // REVIEW [2026-12-15] Condição verificada: o valor não pode passar do limite.
  rule: refundAmount <= RefundLimit
  // REVIEW [2026-12-15] Severidade que bloqueia a ação em caso de violação.
  severity: block
  // REVIEW [2026-12-15] Texto explicativo exibido na violação.
  message: "Reembolso acima do limite exige aprovação de gerente"
  // REVIEW [2026-12-15] Registra a avaliação da política na trilha de auditoria.
  audit: true
}
