// REVIEW [2026-12-15] service: example.com/services/support

// REVIEW [2026-12-15] Documento que representa um chamado de atendimento.
document Ticket {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Chamado", en: "Ticket" }
  // REVIEW [2026-12-15] Versão do artefato Document; diff e release comparam.
  version: 1
  // REVIEW [2026-12-15] Área responsável pelo documento.
  owner: "Support"
  // REVIEW [2026-12-15] Sincronização ao vivo: réplicas acompanham cada transição.
  sync: live
  // REVIEW [2026-12-15] Campos que compõem o chamado.
  fields {
    // REVIEW [2026-12-15] Cliente autor do chamado; referência a usuário consultável.
    customer: User {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Cliente", en: "Customer" }
      // REVIEW [2026-12-15] Permite localizar o chamado pelo cliente.
      lookup
    }
    // REVIEW [2026-12-15] Pedido relacionado ao chamado, quando houver.
    order: Order {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Pedido", en: "Order" }
    }
    // REVIEW [2026-12-15] Assunto curto do chamado, consultável e limitado a 160 caracteres.
    subject: string { title: { pt-BR: "Assunto", en: "Subject" }, maxLength: 160, lookup }
    // REVIEW [2026-12-15] Descrição detalhada do problema; dado sensível em tela e export.
    description: string { title: { pt-BR: "Descrição", en: "Description" }, sensitive }
    // REVIEW [2026-12-15] Prioridade do chamado, consultável e com padrão P3.
    priority: TicketPriority { title: { pt-BR: "Prioridade", en: "Priority" }, lookup, default: P3 }
    // REVIEW [2026-12-15] Categoria do chamado, consultável e com padrão General.
    category: TicketCategory { title: { pt-BR: "Categoria", en: "Category" }, lookup, default: General }
    // REVIEW [2026-12-15] Anotação interna visível só à equipe; campo privado.
    internalNote: string { title: { pt-BR: "Nota interna", en: "Internal note" }, private }
    // REVIEW [2026-12-15] Orçamento associado ao atendimento, em dinheiro padrão.
    budget: std.Money { title: { pt-BR: "Orçamento", en: "Budget" } }
    // REVIEW [2026-12-15] Situação atual do chamado, conduzida pelas transições do shape.
    status: TicketStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    // REVIEW [2026-12-15] Agente responsável pelo atendimento.
    assignee: User {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Responsável", en: "Assignee" }
    }
    // REVIEW [2026-12-15] Prazo-limite de atendimento calculado a partir do SLA.
    slaDue: DateTime { title: { pt-BR: "Prazo até", en: "SLA due" } }
    // REVIEW [2026-12-15] Tempo total gasto até a resolução do chamado.
    resolutionTime: std.Duration { title: { pt-BR: "Tempo de resolução", en: "Resolution time" } }
    // REVIEW [2026-12-15] Marca se o prazo foi cumprido na resolução.
    slaMet: boolean { title: { pt-BR: "Prazo cumprido", en: "SLA met" } }
    // REVIEW [2026-12-15] Indica em tempo real se o prazo já estourou.
    breached: boolean {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Prazo estourado", en: "SLA breached" }
      // REVIEW [2026-12-15] Valor derivado: verdadeiro quando o prazo já passou.
      computed: slaDue < now()
      // REVIEW [2026-12-15] Campo calculado, não editável pelo usuário.
      readonly
    }
    // REVIEW [2026-12-15] Tempo restante até o prazo, recalculado a cada leitura.
    remaining: std.Duration {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Tempo restante", en: "Time remaining" }
      // REVIEW [2026-12-15] Valor derivado: diferença entre o prazo e o instante atual.
      computed: slaDue - now()
      // REVIEW [2026-12-15] Campo calculado, não editável pelo usuário.
      readonly
    }
    // REVIEW [2026-12-15] Instante de abertura do chamado.
    createdAt: DateTime { title: { pt-BR: "Criado em", en: "Created at" } }
  }

  // REVIEW [2026-12-15] Índices que sustentam filas, filtros e busca.
  indexes {
    // REVIEW [2026-12-15] Fila operacional ordenada por prazo, com filtros por situação e prioridade.
    byStatus: [status, priority, slaDue] range
    // REVIEW [2026-12-15] Consulta dos chamados de um responsável específico.
    byAssignee: [assignee.id] hash
    // REVIEW [2026-12-15] Índice textual para busca em assunto e descrição.
    search: [subject, description] search
  }

  // REVIEW [2026-12-15] Eventos disparados pelo documento.
  events {
    // REVIEW [2026-12-15] Evento de escalonamento do chamado.
    Escalated {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Chamado escalonado", en: "Ticket escalated" }
      // REVIEW [2026-12-15] Dados levados pelo evento.
      payload {
        // REVIEW [2026-12-15] Motivo do escalonamento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }

  // REVIEW [2026-12-15] Ações que operam o ciclo de vida do chamado.
  actions {
    // REVIEW [2026-12-15] Abre o chamado registrando assunto e cliente.
    open(subject: string, customer: User){
      // REVIEW [2026-12-15] Título exibido no botão.
      title: { pt-BR: "Abrir chamado", en: "Open ticket" }
      // REVIEW [2026-12-15] Só agentes de suporte podem abrir chamados.
      roles: [SupportAgent]
      // REVIEW [2026-12-15] Impede abrir chamado sem assunto.
      rule subject.length > 0 {
        // REVIEW [2026-12-15] Mensagem de validação em português.
        pt-BR: "Informe o assunto do chamado"
        // REVIEW [2026-12-15] Mensagem de validação em inglês.
        en: "Enter the ticket subject"
      }
      // REVIEW [2026-12-15] Efeitos executados quando a validação passa.
      {
        // REVIEW [2026-12-15] Registra o instante de abertura.
        createdAt = now()
        // REVIEW [2026-12-15] Emite o evento Opened com o assunto informado.
        emit Opened { subject }
      }
    }

    // REVIEW [2026-12-15] Assume o chamado, passando para Em andamento.
    claim(){
      // REVIEW [2026-12-15] Título exibido no botão.
      title: { pt-BR: "Assumir", en: "Claim" }
      // REVIEW [2026-12-15] Apenas agentes assumem chamados.
      roles: [SupportAgent]
      // REVIEW [2026-12-15] Transição para Em andamento.
      to: status.InProgress
    }

    // REVIEW [2026-12-15] Coloca o chamado em espera.
    hold(){
      // REVIEW [2026-12-15] Título exibido no botão.
      title: { pt-BR: "Aguardar", en: "Hold" }
      // REVIEW [2026-12-15] Agentes e gerentes podem colocar em espera.
      roles: [SupportAgent, Manager]
      // REVIEW [2026-12-15] Transição para Aguardando.
      to: status.Waiting
    }

    // REVIEW [2026-12-15] Retoma o atendimento de um chamado em espera.
    resume(){
      // REVIEW [2026-12-15] Título exibido no botão.
      title: { pt-BR: "Retomar", en: "Resume" }
      // REVIEW [2026-12-15] Apenas agentes retomam o atendimento.
      roles: [SupportAgent]
      // REVIEW [2026-12-15] Transição de volta para Em andamento.
      to: status.InProgress
    }

    // REVIEW [2026-12-15] Resolve o chamado e calcula os indicadores de prazo.
    resolve(){
      // REVIEW [2026-12-15] Título exibido no botão.
      title: { pt-BR: "Resolver", en: "Resolve" }
      // REVIEW [2026-12-15] Agentes e gerentes podem resolver.
      roles: [SupportAgent, Manager]
      // REVIEW [2026-12-15] Transição para Resolvido.
      to: status.Resolved
      // REVIEW [2026-12-15] Exige responsável atribuído antes de resolver.
      rule assignee != null {
        // REVIEW [2026-12-15] Mensagem de validação em português.
        pt-BR: "Atribua o chamado antes de resolver"
        // REVIEW [2026-12-15] Mensagem de validação em inglês.
        en: "Assign the ticket before resolving"
      }
      // REVIEW [2026-12-15] Efeitos executados após a validação.
      {
        // REVIEW [2026-12-15] Calcula o tempo total até a resolução.
        resolutionTime = now() - createdAt
        // REVIEW [2026-12-15] Registra se o prazo foi cumprido.
        slaMet = now() <= slaDue
      }
    }

    // REVIEW [2026-12-15] Fecha o chamado após a resolução.
    close(){
      // REVIEW [2026-12-15] Título exibido no botão.
      title: { pt-BR: "Fechar", en: "Close" }
      // REVIEW [2026-12-15] Apenas agentes fecham o chamado.
      roles: [SupportAgent]
      // REVIEW [2026-12-15] Transição para Fechado.
      to: status.Closed
    }

    // REVIEW [2026-12-15] Reabre um chamado fechado com justificativa obrigatória.
    reopen(justification: string){
      // REVIEW [2026-12-15] Título exibido no botão.
      title: { pt-BR: "Reabrir", en: "Reopen" }
      // REVIEW [2026-12-15] Somente gerentes reabrem chamados.
      roles: [Manager]
      // REVIEW [2026-12-15] Transição de volta para Aberto, levando o motivo como payload.
      to: status.Open
      // REVIEW [2026-12-15] Mapeia a justificativa para o campo reason do evento Reopened.
      emits { reason: justification }
      // REVIEW [2026-12-15] Exige justificativa com pelo menos 10 caracteres.
      rule justification.length >= 10 {
        // REVIEW [2026-12-15] Mensagem de validação em português.
        pt-BR: "Informe um motivo com pelo menos 10 caracteres"
        // REVIEW [2026-12-15] Mensagem de validação em inglês.
        en: "Enter a reason with at least 10 characters"
      }
    }

    // REVIEW [2026-12-15] Atribui um responsável ao chamado.
    assign(user: User){
      // REVIEW [2026-12-15] Título exibido no botão.
      title: { pt-BR: "Atribuir", en: "Assign" }
      // REVIEW [2026-12-15] Apenas agentes distribuem chamados.
      roles: [SupportAgent]
      // REVIEW [2026-12-15] Efeitos da ação.
      {
        // REVIEW [2026-12-15] Grava o usuário escolhido como responsável.
        assignee = user
      }
    }

    // REVIEW [2026-12-15] Altera a categoria do chamado.
    categorize(target: TicketCategory){
      // REVIEW [2026-12-15] Título exibido no botão.
      title: { pt-BR: "Categorizar", en: "Categorize" }
      // REVIEW [2026-12-15] Apenas agentes categorizam.
      roles: [SupportAgent]
      // REVIEW [2026-12-15] Efeitos da ação.
      {
        // REVIEW [2026-12-15] Grava a categoria escolhida.
        category = target
      }
    }

    // REVIEW [2026-12-15] Registra um comentário na nota interna.
    comment(note: string){
      // REVIEW [2026-12-15] Título exibido no botão.
      title: { pt-BR: "Comentar", en: "Comment" }
      // REVIEW [2026-12-15] Apenas agentes comentam.
      roles: [SupportAgent]
      // REVIEW [2026-12-15] Impede comentário vazio.
      rule note.length > 0 {
        // REVIEW [2026-12-15] Mensagem de validação em português.
        pt-BR: "Escreva o comentário"
        // REVIEW [2026-12-15] Mensagem de validação em inglês.
        en: "Write the comment"
      }
      // REVIEW [2026-12-15] Efeitos da ação.
      {
        // REVIEW [2026-12-15] Guarda o texto na nota interna do chamado.
        internalNote = note
      }
    }

    // REVIEW [2026-12-15] Escala o chamado para o gerente com justificativa.
    escalate(justification: string){
      // REVIEW [2026-12-15] Título exibido no botão.
      title: { pt-BR: "Escalar", en: "Escalate" }
      // REVIEW [2026-12-15] Agentes e gerentes podem escalar.
      roles: [SupportAgent, Manager]
      // REVIEW [2026-12-15] Efeitos da ação.
      {
        // REVIEW [2026-12-15] Registra a justificativa na nota interna.
        internalNote = justification
        // REVIEW [2026-12-15] Emite o evento Escalated com o motivo.
        emit Escalated { reason: justification }
      }
    }
  }

  // REVIEW [2026-12-15] Invariante do documento: chamado resolvido precisa de responsável.
  rule status == Resolved implies assignee != null {
    // REVIEW [2026-12-15] Mensagem da invariante em português.
    pt-BR: "Atribua o chamado antes de resolver"
    // REVIEW [2026-12-15] Mensagem da invariante em inglês.
    en: "Assign the ticket before resolving"

  }
}

// REVIEW [2026-12-15] Máquina de estados que conduz a situação do chamado.
shape TicketStatus {
  // REVIEW [2026-12-15] Título exibido no builder.
  title: { pt-BR: "Situação do chamado", en: "Ticket status" }
  // REVIEW [2026-12-15] Base de estado: valores com transições nomeadas.
  base: state
  // REVIEW [2026-12-15] Estado inicial Aberto, alcançado pela transição Opened.
  initial: Open with transition Opened {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Chamado aberto", en: "Ticket opened" }
    // REVIEW [2026-12-15] Dados exigidos para entrar no estado inicial.
    payload {
      // REVIEW [2026-12-15] Assunto do chamado na abertura.
      subject: string { title: { pt-BR: "Assunto", en: "Subject" } }
    }
  }
  // REVIEW [2026-12-15] Estado Aberto.
  value Open {
    // REVIEW [2026-12-15] Título exibido nas telas e filtros.
    title: { pt-BR: "Aberta", en: "Open" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Open
    // REVIEW [2026-12-15] Ordem do estado no fluxo.
    ordinal: 10

    // REVIEW [2026-12-15] Transição de Aberto para Em andamento.
    transition InProgress {
      // REVIEW [2026-12-15] Evento que dispara a transição.
      event: Claimed
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Chamado assumido", en: "Ticket claimed" }
    }
  }
  // REVIEW [2026-12-15] Estado Em andamento.
  value InProgress {
    // REVIEW [2026-12-15] Título exibido nas telas e filtros.
    title: { pt-BR: "Em andamento", en: "In progress" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: InProgress
    // REVIEW [2026-12-15] Ordem do estado no fluxo.
    ordinal: 20

    // REVIEW [2026-12-15] Transição de Em andamento para Aguardando.
    transition Waiting {
      // REVIEW [2026-12-15] Evento que dispara a transição.
      event: Held
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Chamado aguardando", en: "Ticket held" }
    }

    // REVIEW [2026-12-15] Transição de Em andamento para Resolvido.
    transition Resolved {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Chamado resolvido", en: "Ticket resolved" }
      // REVIEW [2026-12-15] Dados levados ao entrar em Resolvido.
      payload {
        // REVIEW [2026-12-15] Responsável que resolveu o chamado.
        assignee: User { title: { pt-BR: "Responsável", en: "Assignee" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado Aguardando.
  value Waiting {
    // REVIEW [2026-12-15] Título exibido nas telas e filtros.
    title: { pt-BR: "Aguardando", en: "Waiting" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Waiting
    // REVIEW [2026-12-15] Ordem do estado no fluxo.
    ordinal: 30

    // REVIEW [2026-12-15] Transição de Aguardando de volta para Em andamento.
    transition InProgress {
      // REVIEW [2026-12-15] Evento que dispara a transição.
      event: Resumed
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Chamado retomado", en: "Ticket resumed" }
    }

    // REVIEW [2026-12-15] Transição de Aguardando para Resolvido.
    transition Resolved {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Chamado resolvido", en: "Ticket resolved" }
      // REVIEW [2026-12-15] Dados levados ao entrar em Resolvido.
      payload {
        // REVIEW [2026-12-15] Responsável que resolveu o chamado.
        assignee: User { title: { pt-BR: "Responsável", en: "Assignee" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado Resolvido.
  value Resolved {
    // REVIEW [2026-12-15] Título exibido nas telas e filtros.
    title: { pt-BR: "Resolvido", en: "Resolved" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Resolved
    // REVIEW [2026-12-15] Ordem do estado no fluxo.
    ordinal: 40

    // REVIEW [2026-12-15] Transição de Resolvido para Fechado.
    transition Closed {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Chamado fechado", en: "Ticket closed" }
    }

    // REVIEW [2026-12-15] Transição de Resolvido de volta para Aberto.
    transition Open {
      // REVIEW [2026-12-15] Evento que dispara a reabertura.
      event: Reopened
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Chamado reaberto", en: "Ticket reopened" }
      // REVIEW [2026-12-15] Dados levados ao reabrir.
      payload {
        // REVIEW [2026-12-15] Motivo da reabertura.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado terminal Fechado.
  value Closed {
    // REVIEW [2026-12-15] Título exibido nas telas e filtros.
    title: { pt-BR: "Fechado", en: "Closed" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Closed
    // REVIEW [2026-12-15] Ordem do estado no fluxo.
    ordinal: 50
  }
  // REVIEW [2026-12-15] Renderização sem formatação especial.
  format: plain
}

// REVIEW [2026-12-15] Classificação que ordena a prioridade do chamado.
shape TicketPriority {
  // REVIEW [2026-12-15] Título exibido no builder.
  title: { pt-BR: "Prioridade do chamado", en: "Ticket priority" }
  // REVIEW [2026-12-15] Base de classificação: valores sem transições.
  base: classification
  // REVIEW [2026-12-15] Valor de prioridade máxima.
  value P1 {
    // REVIEW [2026-12-15] Título exibido nas telas e filtros.
    title: { pt-BR: "Prioridade 1", en: "Priority 1" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: P1
    // REVIEW [2026-12-15] Ordem do valor na classificação.
    ordinal: 10
  }
  // REVIEW [2026-12-15] Valor de segunda prioridade.
  value P2 {
    // REVIEW [2026-12-15] Título exibido nas telas e filtros.
    title: { pt-BR: "Prioridade 2", en: "Priority 2" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: P2
    // REVIEW [2026-12-15] Ordem do valor na classificação.
    ordinal: 20
  }
  // REVIEW [2026-12-15] Valor de prioridade padrão.
  value P3 {
    // REVIEW [2026-12-15] Título exibido nas telas e filtros.
    title: { pt-BR: "Prioridade 3", en: "Priority 3" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: P3
    // REVIEW [2026-12-15] Ordem do valor na classificação.
    ordinal: 30
  }
  // REVIEW [2026-12-15] Valor de prioridade mais baixa.
  value P4 {
    // REVIEW [2026-12-15] Título exibido nas telas e filtros.
    title: { pt-BR: "Prioridade 4", en: "Priority 4" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: P4
    // REVIEW [2026-12-15] Ordem do valor na classificação.
    ordinal: 40
  }
  // REVIEW [2026-12-15] Renderização sem formatação especial.
  format: plain
}

// REVIEW [2026-12-15] Classificação que agrupa o chamado em filas de assunto.
shape TicketCategory {
  // REVIEW [2026-12-15] Título exibido no builder.
  title: { pt-BR: "Categoria do chamado", en: "Ticket category" }
  // REVIEW [2026-12-15] Base de classificação: valores sem transições.
  base: classification
  // REVIEW [2026-12-15] Valor da categoria de problema técnico.
  value Technical {
    // REVIEW [2026-12-15] Título exibido nas telas e filtros.
    title: { pt-BR: "Técnico", en: "Technical" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: Technical
    // REVIEW [2026-12-15] Ordem do valor na classificação.
    ordinal: 10
  }
  // REVIEW [2026-12-15] Valor da categoria de cobrança.
  value Billing {
    // REVIEW [2026-12-15] Título exibido nas telas e filtros.
    title: { pt-BR: "Cobrança", en: "Billing" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: Billing
    // REVIEW [2026-12-15] Ordem do valor na classificação.
    ordinal: 20
  }
  // REVIEW [2026-12-15] Valor da categoria geral, usada como padrão.
  value General {
    // REVIEW [2026-12-15] Título exibido nas telas e filtros.
    title: { pt-BR: "Geral", en: "General" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: General
    // REVIEW [2026-12-15] Ordem do valor na classificação.
    ordinal: 30
  }
  // REVIEW [2026-12-15] Renderização sem formatação especial.
  format: plain
}

// REVIEW [2026-12-15] Política que obriga escalonamento de chamado fora do prazo.
policy SlaEscalation {
  // REVIEW [2026-12-15] Documento ao qual a política se aplica.
  appliesTo: Ticket
  // REVIEW [2026-12-15] Condição verificada: exige que o prazo não esteja estourado.
  rule: not breached
  // REVIEW [2026-12-15] Severidade que bloqueia a operação em caso de violação.
  severity: enforce
  // REVIEW [2026-12-15] Texto explicativo exibido na violação.
  message: "Chamado fora do prazo deve ser escalonado ao gerente"
  // REVIEW [2026-12-15] Canais que recebem a notificação.
  notification: [Email, WhatsApp]
  // REVIEW [2026-12-15] Registra a avaliação da política na trilha de auditoria.
  audit: true
}
