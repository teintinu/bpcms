// REVIEW [2026-12-15] service: example.com/services/support

// REVIEW [2026-12-15] View de andamento derivada da instância do processo.
view RefundCaseProgress {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Andamento da devolução", en: "Refund case progress" }
  // REVIEW [2026-12-15] Tipo da view: uma tela de andamento de processo.
  type: process
  // REVIEW [2026-12-15] Processo cujo andamento esta view exibe.
  process: RefundCase
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [SupportAgent, Manager, Customer]

  // REVIEW [2026-12-15] Seções fixas exibidas na tela de andamento, incluindo marcos.
  sections { current; participants; history; deadlines; documents; milestones; next }
}
