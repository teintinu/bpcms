// REVIEW [2026-12-15] service: example.com/services/support

// REVIEW [2026-12-15] Quadro kanban que movimenta chamados pelas colunas de situação.
view TicketKanban {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Quadro de chamados", en: "Ticket kanban" }
  // REVIEW [2026-12-15] Tipo da view: quadro kanban.
  type: kanban
  // REVIEW [2026-12-15] Documento que alimenta o quadro.
  source: Ticket
  // REVIEW [2026-12-15] Papéis que podem abrir o quadro.
  roles: [SupportAgent, Manager]
  // REVIEW [2026-12-15] Agrupa os cartões pela situação do chamado.
  groupBy: status

  // REVIEW [2026-12-15] Colunas exibidas em cada cartão.
  columns { subject; priority; slaDue }
  // REVIEW [2026-12-15] Campos exibidos no resumo do cartão.
  card { subject; priority; slaDue; assignee }
  // REVIEW [2026-12-15] Oculta chamados já fechados do quadro.
  filter { status != Closed }
  // REVIEW [2026-12-15] Ações oferecidas no quadro.
  actions {
    // REVIEW [2026-12-15] Abre o detalhe do chamado.
    open -> TicketDetail
    // REVIEW [2026-12-15] Assume o chamado direto do quadro.
    claim -> Ticket.claim
  }
}
