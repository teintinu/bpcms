// REVIEW [2026-12-15] service: example.com/services/support

// REVIEW [2026-12-15] Relatório de cumprimento do prazo de atendimento.
view SlaCompliance {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Cumprimento de prazo", en: "SLA compliance" }
  // REVIEW [2026-12-15] Tipo da view: relatório com métricas agregadas.
  type: report
  // REVIEW [2026-12-15] Documentos consultados pelo relatório.
  sources: [Ticket]
  // REVIEW [2026-12-15] Apenas gerentes abrem o relatório.
  roles: [Manager]

  // REVIEW [2026-12-15] Filtros disponíveis na tela.
  filters { period; priority }
  // REVIEW [2026-12-15] Métricas calculadas sobre os chamados.
  metrics {
    // REVIEW [2026-12-15] Percentual de chamados com prazo cumprido.
    compliance: percentage(Ticket.slaMet)
    // REVIEW [2026-12-15] Contagem de chamados com prazo estourado.
    breached: count(Ticket) where breached == true
    // REVIEW [2026-12-15] Média do tempo de resolução.
    avgResolution: avg(Ticket.resolutionTime)
  }
  // REVIEW [2026-12-15] Janela de atualização dos dados do relatório.
  freshness: 5m
  // REVIEW [2026-12-15] Formatos de exportação oferecidos.
  export: [pdf, csv]
}
