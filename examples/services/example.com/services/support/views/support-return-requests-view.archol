// REVIEW [2026-12-15] service: example.com/services/support

// REVIEW [2026-12-15] Tabela que lista as solicitações de devolução.
view ReturnRequests {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Solicitações de devolução", en: "Return requests" }
  // REVIEW [2026-12-15] Tipo da view: tabela paginada.
  type: table
  // REVIEW [2026-12-15] Documento que alimenta a tabela.
  source: ReturnRequest
  // REVIEW [2026-12-15] Papéis que podem abrir a lista.
  roles: [SupportAgent, Manager]

  // REVIEW [2026-12-15] Colunas exibidas na tabela.
  columns { order; status; refundAmount; requestedAt }
  // REVIEW [2026-12-15] Filtros disponíveis na tela.
  filters { status; period }
  // REVIEW [2026-12-15] Quantidade de linhas por página.
  pagination: 50
  // REVIEW [2026-12-15] Ações oferecidas na lista.
  actions {
    // REVIEW [2026-12-15] Abre o andamento do caso de devolução.
    open -> RefundCaseProgress
  }
}
