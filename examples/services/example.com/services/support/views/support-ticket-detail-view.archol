// REVIEW [2026-12-15] service: example.com/services/support

// REVIEW [2026-12-15] Tela de detalhe de um chamado.
view TicketDetail {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Detalhe do chamado", en: "Ticket detail" }
  // REVIEW [2026-12-15] Tipo da view: tela de detalhe de documento.
  type: detail
  // REVIEW [2026-12-15] Documento exibido na tela.
  document: Ticket
  // REVIEW [2026-12-15] Papéis que podem abrir o detalhe.
  roles: [SupportAgent, Manager]

  // REVIEW [2026-12-15] Seções fixas exibidas na tela.
  sections { summary; timeline }
  // REVIEW [2026-12-15] Campos calculados exibidos na tela.
  computed { breached; remaining }
  // REVIEW [2026-12-15] Ações oferecidas na tela de detalhe.
  actions {
    // REVIEW [2026-12-15] Resolve o chamado.
    resolve -> Ticket.resolve
    // REVIEW [2026-12-15] Escala o chamado pedindo a justificativa.
    escalate -> Ticket.escalate(justification)
  }
}
