// REVIEW [2026-12-15] service: example.com/services/support

// REVIEW [2026-12-15] Mensagem com a decisão tomada sobre a devolução.
message RefundDecision {
  // REVIEW [2026-12-15] Título exibido no catálogo de mensagens.
  title: { pt-BR: "Decisão da devolução", en: "Refund decision" }
  // REVIEW [2026-12-15] Documento ao qual a mensagem se refere.
  about: ReturnRequest
  // REVIEW [2026-12-15] Dados levados pela mensagem.
  payload {
    // REVIEW [2026-12-15] Parecer final da análise de elegibilidade.
    verdict: RefundVerdict { title: { pt-BR: "Parecer", en: "Verdict" } }
    // REVIEW [2026-12-15] Valor decidido para reembolso.
    amount: std.Money { title: { pt-BR: "Valor", en: "Amount" } }
  }
}
