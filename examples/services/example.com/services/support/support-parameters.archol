// REVIEW [2026-12-15] service: example.com/services/support

// REVIEW [2026-12-15] Prazo padrão de atendimento, configurável pela aplicação no boot.
parameter DefaultSla {
  // REVIEW [2026-12-15] Título exibido na tela de configuração.
  title: { pt-BR: "Prazo padrão", en: "Default SLA" }
  // REVIEW [2026-12-15] Tipo duração, vindo do pseudo-serviço std.
  type: std.Duration
  // REVIEW [2026-12-15] Valor inicial de dois dias quando nada for configurado.
  default: 2d
}

// REVIEW [2026-12-15] Teto de reembolso usado pela alçada e pela política de autorização.
parameter RefundLimit {
  // REVIEW [2026-12-15] Título exibido na tela de configuração.
  title: { pt-BR: "Limite de reembolso", en: "Refund limit" }
  // REVIEW [2026-12-15] Tipo monetário com moeda explícita.
  type: std.Money
  // REVIEW [2026-12-15] Valor inicial de quinhentos reais.
  default: 500 BRL
  // REVIEW [2026-12-15] Piso aceito na configuração; impede valor negativo.
  min: 0 BRL
}
