// REVIEW [2026-12-15] Raiz do serviço de Atendimento; a URI é a identidade do serviço no workspace.
service "example.com/services/support" {
  // REVIEW [2026-12-15] Título exibido no builder e na navegação.
  title: { pt-BR: "Atendimento", en: "Support" }
  locales: [ "pt-BR", "en" ] // REVIEW [2026-12-18] Idiomas suportados pelo serviço; o primeiro é o default do I18N em forma de string.
  // REVIEW [2026-12-15] Versão do serviço, comparada em release e no lock.
  // REVIEW [2026-12-15] Área responsável pelo serviço, usada em governança.
  owner: "Support"
  // REVIEW [2026-12-15] Dependências externas trazidas para o escopo por alias.
  imports {
    // REVIEW [2026-12-15] Medidas e constantes padrão do construtor (dinheiro, duração, contagem).
    service "bpcms.org/std" as std
    // REVIEW [2026-12-15] Pedidos do cliente, usados nos campos Order dos documentos.
    service "example.com/services/orders" as Orders
    // REVIEW [2026-12-15] Pagamentos, usados para executar o reembolso da devolução.
    service "example.com/services/payments" as Payments
    // REVIEW [2026-12-15] Remessas, usadas para conferir a devolução recebida.
    service "example.com/services/shipping" as Shipping
    // REVIEW [2026-12-15] Identidade, origem dos usuários que abrem chamados e assumem filas.
    service "example.com/services/identity" as Identity
  }
}
