// REVIEW [2026-12-15] service: example.com/services/hr

// REVIEW [2026-12-15] Documento que registra a concessão de acesso de um colaborador a um sistema.
document AccessGrant {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Concessão de acesso", en: "Access grant" }
  // REVIEW [2026-12-15] Versão do artefato usada em diff e release.
  // REVIEW [2026-12-15] Área responsável pelo documento.
  // REVIEW [2026-12-15] Sincronização em tempo real entre instâncias e telas.
  sync: live

  // REVIEW [2026-12-15] Campos que compõem a concessão de acesso.
  fields {
    // REVIEW [2026-12-15] Colaborador que recebe o acesso; consultável.
    employee: Employee { title: { pt-BR: "Colaborador", en: "Employee" }, lookup }
    // REVIEW [2026-12-15] Sistema ao qual o acesso se refere; consultável.
    system: AccessSystem { title: { pt-BR: "Sistema", en: "System" }, lookup }
    // REVIEW [2026-12-15] Perfil de permissões concedido no sistema.
    profile: string { title: { pt-BR: "Perfil", en: "Profile" }, maxLength: 60 }
    // REVIEW [2026-12-15] Situação atual do acesso; consultável.
    status: AccessGrantStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    // REVIEW [2026-12-15] Data e hora da solicitação; preenchida pelo sistema.
    requestedAt: DateTime { title: { pt-BR: "Solicitado em", en: "Requested at" }, readonly }
    // REVIEW [2026-12-15] Usuário que solicitou o acesso.
    requestedBy: Identity.User { title: { pt-BR: "Solicitado por", en: "Requested by" } }
    // REVIEW [2026-12-15] Data e hora do provisionamento; preenchida pelo sistema.
    provisionedAt: DateTime { title: { pt-BR: "Provisionado em", en: "Provisioned at" }, readonly }
    // REVIEW [2026-12-15] Data e hora da revogação; preenchida pelo sistema.
    revokedAt: DateTime { title: { pt-BR: "Revogado em", en: "Revoked at" }, readonly }
    // REVIEW [2026-12-15] Motivo informado na revogação do acesso.
    revokeReason: string { title: { pt-BR: "Motivo da revogação", en: "Revocation reason" }, maxLength: 500 }
  }

  // REVIEW [2026-12-15] Índices que aceleram as consultas do documento.
  indexes {
    // REVIEW [2026-12-15] Índice hash por colaborador.
    byEmployee: [employee.id] hash
    // REVIEW [2026-12-15] Índice ordenado por situação e data de solicitação.
    byStatus: [status, requestedAt] range
  }


  // REVIEW [2026-12-15] Ações que alteram a concessão de acesso.
  actions {
    // REVIEW [2026-12-15] Marca o acesso como provisionado no sistema.
    provision() {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Provisionar acesso", en: "Provision access" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [ITAdmin]
      // REVIEW [2026-12-15] Transição de situação disparada pela ação.
      to: status.Provisioned
      // REVIEW [2026-12-15] Payload do evento emitido pela transição.
      emits { at: now() }
      // REVIEW [2026-12-15] Efeito da ação: grava a data de provisionamento.
      { provisionedAt = now() }
    }

    // REVIEW [2026-12-15] Revoga o acesso, registrando o motivo.
    revoke(reason: string) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Revogar acesso", en: "Revoke access" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [ITAdmin, PeopleOps]
      // REVIEW [2026-12-15] Transição de situação disparada pela ação.
      to: status.Revoked
      // REVIEW [2026-12-15] Efeito da ação: grava data e motivo da revogação.
      { revokedAt = now(); revokeReason = reason }
    }
  }
}

// REVIEW [2026-12-15] Máquina de estados da situação da concessão de acesso.
shape AccessGrantStatus {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Situação do acesso", en: "Access grant status" }
  // REVIEW [2026-12-15] Base de estado: valores com ciclo de vida e transições.
  base: state
  // REVIEW [2026-12-15] Situação inicial de uma concessão recém-criada.
  initial: Requested

  // REVIEW [2026-12-15] Situação de acesso solicitado.
  value Requested {
    // REVIEW [2026-12-15] Rótulo exibido para o valor.
    title: { pt-BR: "Solicitado", en: "Requested" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: status.requested
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 10

    // REVIEW [2026-12-15] Transição para acesso provisionado.
    transition Provisioned {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Acesso provisionado", en: "Access provisioned" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Data e hora do provisionamento.
        at: DateTime { title: { pt-BR: "Em", en: "At" } }
      }
    }

    // REVIEW [2026-12-15] Transição para acesso revogado antes do provisionamento.
    transition Revoked {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Acesso revogado", en: "Access revoked" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Motivo da revogação.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Situação de acesso já provisionado.
  value Provisioned {
    // REVIEW [2026-12-15] Rótulo exibido para o valor.
    title: { pt-BR: "Provisionado", en: "Provisioned" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: status.provisioned
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 20

    // REVIEW [2026-12-15] Transição para acesso revogado.
    transition Revoked {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Acesso revogado", en: "Access revoked" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Motivo da revogação.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Situação final de acesso revogado.
  value Revoked {
    // REVIEW [2026-12-15] Rótulo exibido para o valor.
    title: { pt-BR: "Revogado", en: "Revoked" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: status.revoked
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 30
  }
}

// REVIEW [2026-12-15] Classificação dos sistemas que podem receber concessão de acesso.
shape AccessSystem {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Sistema de acesso", en: "Access system" }
  // REVIEW [2026-12-15] Base de classificação: valores estáticos, sem ciclo de vida.
  base: classification

  // REVIEW [2026-12-15] Valor para o e-mail corporativo.
  value Email {
    // REVIEW [2026-12-15] Rótulo exibido para o valor.
    title: { pt-BR: "E-mail corporativo", en: "Corporate email" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: access.email
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 10
  }
  // REVIEW [2026-12-15] Valor para o ERP.
  value ERP {
    // REVIEW [2026-12-15] Rótulo exibido para o valor.
    title: { pt-BR: "ERP", en: "ERP" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: access.erp
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 20
  }
  // REVIEW [2026-12-15] Valor para a VPN.
  value VPN {
    // REVIEW [2026-12-15] Rótulo exibido para o valor.
    title: { pt-BR: "VPN", en: "VPN" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: access.vpn
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 30
  }
  // REVIEW [2026-12-15] Valor para o crachá de acesso físico.
  value Badge {
    // REVIEW [2026-12-15] Rótulo exibido para o valor.
    title: { pt-BR: "Crachá", en: "Badge" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: access.badge
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 40
  }
  // REVIEW [2026-12-15] Valor para a folha de pagamento.
  value Payroll {
    // REVIEW [2026-12-15] Rótulo exibido para o valor.
    title: { pt-BR: "Folha de pagamento", en: "Payroll" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: access.payroll
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 50
  }
}
