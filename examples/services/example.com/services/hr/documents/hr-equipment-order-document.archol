// REVIEW [2026-12-15] service: example.com/services/hr

// REVIEW [2026-12-15] Documento que registra o pedido de equipamento de um colaborador.
document EquipmentOrder {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Pedido de equipamento", en: "Equipment order" }
  // REVIEW [2026-12-15] Versão do artefato usada em diff e release.
  // REVIEW [2026-12-15] Área responsável pelo documento.
  // REVIEW [2026-12-15] Sincronização em tempo real entre instâncias e telas.
  sync: live

  // REVIEW [2026-12-15] Campos que compõem o pedido de equipamento.
  fields {
    // REVIEW [2026-12-15] Colaborador que receberá o equipamento; consultável.
    employee: Employee { title: { pt-BR: "Colaborador", en: "Employee" }, lookup }
    // REVIEW [2026-12-15] Tipo de equipamento pedido; consultável.
    kind: EquipmentKind { title: { pt-BR: "Equipamento", en: "Equipment" }, lookup }
    // REVIEW [2026-12-15] Fornecedor do equipamento.
    vendor: string { title: { pt-BR: "Fornecedor", en: "Vendor" }, maxLength: 120 }
    // REVIEW [2026-12-15] Número de série do equipamento entregue; consultável.
    serial: string { title: { pt-BR: "Número de série", en: "Serial number" }, lookup, maxLength: 60 }
    // REVIEW [2026-12-15] Situação atual do pedido; consultável.
    status: EquipmentOrderStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    // REVIEW [2026-12-15] Data e hora do pedido; preenchida pelo sistema.
    orderedAt: DateTime { title: { pt-BR: "Pedido em", en: "Ordered at" }, readonly }
    // REVIEW [2026-12-15] Data e hora da entrega; preenchida pelo sistema.
    deliveredAt: DateTime { title: { pt-BR: "Entregue em", en: "Delivered at" }, readonly }
    // REVIEW [2026-12-15] Data e hora da devolução; preenchida pelo sistema.
    returnedAt: DateTime { title: { pt-BR: "Devolvido em", en: "Returned at" }, readonly }
  }

  // REVIEW [2026-12-15] Índices que aceleram as consultas do documento.
  indexes {
    // REVIEW [2026-12-15] Índice hash por colaborador.
    byEmployee: [employee.id] hash
    // REVIEW [2026-12-15] Índice ordenado por situação e data do pedido.
    byStatus: [status, orderedAt] range
  }


  // REVIEW [2026-12-15] Ações que alteram o pedido de equipamento.
  actions {
    // REVIEW [2026-12-15] Registra a entrega do equipamento com o número de série.
    deliver(serialNumber: string) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Registrar entrega", en: "Register delivery" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [ITAdmin]
      // REVIEW [2026-12-15] Transição de situação disparada pela ação.
      to: status.Delivered
      // REVIEW [2026-12-15] Payload do evento emitido pela transição.
      emits { serial: serialNumber }
      // REVIEW [2026-12-15] Efeito da ação: grava série e data de entrega.
      { serial = serialNumber; deliveredAt = now() }
    }

    // REVIEW [2026-12-15] Registra a devolução do equipamento.
    returnItem() {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Registrar devolução", en: "Register return" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [ITAdmin]
      // REVIEW [2026-12-15] Transição de situação disparada pela ação.
      to: status.Returned
      // REVIEW [2026-12-15] Payload do evento emitido pela transição.
      emits { at: now() }
      // REVIEW [2026-12-15] Efeito da ação: grava a data de devolução.
      { returnedAt = now() }
    }
  }
}

// REVIEW [2026-12-15] Máquina de estados da situação do pedido de equipamento.
shape EquipmentOrderStatus {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Situação do equipamento", en: "Equipment order status" }
  // REVIEW [2026-12-15] Base de estado: valores com ciclo de vida e transições.
  base: state
  // REVIEW [2026-12-15] Situação inicial de um pedido recém-criado.
  initial: Ordered

  // REVIEW [2026-12-15] Situação de equipamento pedido.
  value Ordered {
    // REVIEW [2026-12-15] Rótulo exibido para o valor.
    title: { pt-BR: "Pedido", en: "Ordered" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: status.ordered
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 10

    // REVIEW [2026-12-15] Transição para equipamento entregue.
    transition Delivered {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Equipamento entregue", en: "Equipment delivered" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Número de série do equipamento entregue.
        serial: string { title: { pt-BR: "Número de série", en: "Serial number" } }
      }
    }
  }
  // REVIEW [2026-12-15] Situação de equipamento entregue.
  value Delivered {
    // REVIEW [2026-12-15] Rótulo exibido para o valor.
    title: { pt-BR: "Entregue", en: "Delivered" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: status.delivered
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 20

    // REVIEW [2026-12-15] Transição para equipamento devolvido.
    transition Returned {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Equipamento devolvido", en: "Equipment returned" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Data e hora da devolução.
        at: DateTime { title: { pt-BR: "Em", en: "At" } }
      }
    }
  }
  // REVIEW [2026-12-15] Situação final de equipamento devolvido.
  value Returned {
    // REVIEW [2026-12-15] Rótulo exibido para o valor.
    title: { pt-BR: "Devolvido", en: "Returned" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: status.returned
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 30
  }
}
