// REVIEW [2026-12-15] service: example.com/services/hr

// REVIEW [2026-12-15] Documento que representa o vínculo de um colaborador com a empresa.
document Employee {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Colaborador", en: "Employee" }
  // REVIEW [2026-12-15] Versão do artefato usada em diff e release.
  // REVIEW [2026-12-15] Área responsável pelo documento.
  owner: "People"
  // REVIEW [2026-12-15] Sincronização em tempo real entre instâncias e telas.
  sync: live
  // REVIEW [2026-12-15] Prazo de retenção dos dados do colaborador.
  retention: 10y

  // REVIEW [2026-12-15] Campos que compõem o colaborador.
  fields {
    // REVIEW [2026-12-15] Matrícula única e consultável do colaborador.
    number: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Matrícula", en: "Employee number" }
      // REVIEW [2026-12-15] Permite localizar o colaborador pela matrícula.
      lookup
      // REVIEW [2026-12-15] Impede duas matrículas iguais.
      unique
      // REVIEW [2026-12-15] Limita a matrícula a vinte caracteres.
      maxLength: 20
    }
    // REVIEW [2026-12-15] Usuário de identidade ligado ao colaborador; consultável.
    person: Identity.User { title: { pt-BR: "Pessoa", en: "Person" }, lookup }
    // REVIEW [2026-12-15] Candidato que originou a contratação; consultável.
    candidate: Candidate { title: { pt-BR: "Candidato", en: "Candidate" }, lookup }
    // REVIEW [2026-12-15] Cargo exercido pelo colaborador; consultável.
    position: string { title: { pt-BR: "Cargo", en: "Position" }, lookup, maxLength: 120 }
    // REVIEW [2026-12-15] Área à qual o colaborador pertence; consultável.
    department: Department { title: { pt-BR: "Área", en: "Department" }, lookup }
    // REVIEW [2026-12-15] Tipo de vínculo empregatício; consultável.
    employmentType: EmploymentType { title: { pt-BR: "Vínculo", en: "Employment type" }, lookup }
    // REVIEW [2026-12-15] Gestor direto do colaborador.
    manager: Identity.User { title: { pt-BR: "Gestor", en: "Manager" } }
    // REVIEW [2026-12-15] Situação atual do colaborador; consultável.
    status: EmployeeStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    // REVIEW [2026-12-15] Data e hora da contratação; preenchida pelo sistema.
    hiredAt: DateTime { title: { pt-BR: "Contratado em", en: "Hired at" }, readonly }
    // REVIEW [2026-12-15] Data de início no trabalho.
    startedAt: DateTime { title: { pt-BR: "Início", en: "Start date" } }
    // REVIEW [2026-12-15] Último dia de trabalho antes do desligamento.
    lastWorkingDay: DateTime { title: { pt-BR: "Último dia", en: "Last working day" } }
    // REVIEW [2026-12-15] Documento de identidade do colaborador; dado sensível.
    identityDocument: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Documento de identidade", en: "Identity document" }
      // REVIEW [2026-12-15] Trata o valor como dado pessoal sensível.
      sensitive
      // REVIEW [2026-12-15] Limita o documento a quarenta caracteres.
      maxLength: 40
    }
    // REVIEW [2026-12-15] Indica se os documentos obrigatórios foram entregues.
    documentsComplete: boolean {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Documentos completos", en: "Documents complete" }
      // REVIEW [2026-12-15] Começa desmarcado até o envio dos documentos.
      default: false
    }
    // REVIEW [2026-12-15] Indica se a caixa de e-mail já foi provisionada.
    mailboxProvisioned: boolean {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Caixa de e-mail provisionada", en: "Mailbox provisioned" }
      // REVIEW [2026-12-15] Começa desmarcado até o provisionamento.
      default: false
    }
    // REVIEW [2026-12-15] Indica se os sistemas de trabalho já foram provisionados.
    systemsProvisioned: boolean {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Sistemas provisionados", en: "Systems provisioned" }
      // REVIEW [2026-12-15] Começa desmarcado até o provisionamento.
      default: false
    }
    // REVIEW [2026-12-15] Indica se a pessoa confirmou que os acessos funcionam.
    accessConfirmed: boolean { title: { pt-BR: "Acesso confirmado", en: "Access confirmed" }, default: false }
    // REVIEW [2026-12-15] Problema de acesso relatado pela pessoa.
    accessIssue: string { title: { pt-BR: "Problema de acesso", en: "Access issue" }, maxLength: 500 }
    // REVIEW [2026-12-15] Data e hora da revogação dos acessos; preenchida pelo sistema.
    accessRevokedAt: DateTime { title: { pt-BR: "Acessos revogados em", en: "Access revoked at" }, readonly }
    // REVIEW [2026-12-15] Data e hora da devolução do equipamento; preenchida pelo sistema.
    equipmentReturnedAt: DateTime {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Equipamento devolvido em", en: "Equipment returned at" }
      // REVIEW [2026-12-15] Impede edição manual da data.
      readonly
    }
    // REVIEW [2026-12-15] Tipo do último equipamento pedido ou devolvido.
    lastEquipmentKind: EquipmentKind { title: { pt-BR: "Último equipamento", en: "Last equipment" } }
    // REVIEW [2026-12-15] Anotações da entrevista de saída.
    exitInterviewNotes: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Entrevista de saída", en: "Exit interview" }
      // REVIEW [2026-12-15] Limita as anotações a dois mil caracteres.
      maxLength: 2000
    }
    // REVIEW [2026-12-15] Motivo registrado para o desligamento.
    offboardingReason: string { title: { pt-BR: "Motivo do desligamento", en: "Offboarding reason" }, maxLength: 500 }
    // REVIEW [2026-12-15] Observação registrada no check-in do gestor.
    checkinNote: string { title: { pt-BR: "Nota do check-in", en: "Check-in note" }, maxLength: 500 }
  }

  // REVIEW [2026-12-15] Índices que aceleram as consultas do documento.
  indexes {
    // REVIEW [2026-12-15] Índice único por matrícula.
    byNumber: [number] unique
    // REVIEW [2026-12-15] Índice ordenado por situação e data de início.
    byStatus: [status, startedAt] range
    // REVIEW [2026-12-15] Índice hash por área.
    byDepartment: [department] hash
    // REVIEW [2026-12-15] Índice hash por pessoa de identidade.
    byPerson: [person.id] hash
  }


  // REVIEW [2026-12-15] Ações que alteram o vínculo do colaborador.
  actions {
    // REVIEW [2026-12-15] Registra a contratação, emitindo o evento Hired.
    hire(firstDay: DateTime) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Registrar contratação", en: "Register hire" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [PeopleOps]
      // REVIEW [2026-12-15] Efeito da ação.
      {
        // REVIEW [2026-12-15] Emite o evento Hired com a data de início.
        emit Hired { startedAt: firstDay }
        // REVIEW [2026-12-15] Grava a data e hora da contratação.
        hiredAt = now()
        // REVIEW [2026-12-15] Grava a data de início informada.
        startedAt = firstDay
      }
    }

    // REVIEW [2026-12-15] Registra o envio dos documentos e marca o checklist como completo.
    submitDocuments(documentNumber: string) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Enviar documentos", en: "Submit documents" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [NewHire, PeopleOps]
      // REVIEW [2026-12-15] Efeito da ação: grava o documento e conclui o checklist.
      { identityDocument = documentNumber; documentsComplete = true }
    }

    // REVIEW [2026-12-15] Marca a caixa de e-mail como provisionada.
    provisionMailbox() {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Provisionar e-mail", en: "Provision mailbox" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [ITAdmin]
      // REVIEW [2026-12-15] Efeito da ação: marca o provisionamento do e-mail.
      { mailboxProvisioned = true }
    }

    // REVIEW [2026-12-15] Marca os sistemas de trabalho como provisionados.
    provisionSystems() {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Provisionar sistemas", en: "Provision systems" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [ITAdmin]
      // REVIEW [2026-12-15] Efeito da ação: marca o provisionamento dos sistemas.
      { systemsProvisioned = true }
    }

    // REVIEW [2026-12-15] Registra que a pessoa confirmou o funcionamento dos acessos.
    confirmAccess() {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Confirmar acesso", en: "Confirm access" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [NewHire]
      // REVIEW [2026-12-15] Efeito da ação: marca o acesso como confirmado.
      { accessConfirmed = true }
    }

    // REVIEW [2026-12-15] Registra um problema de acesso relatado pela pessoa.
    reportAccessIssue(note: string) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Relatar problema de acesso", en: "Report access issue" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [NewHire]
      // REVIEW [2026-12-15] Efeito da ação: guarda o relato e desfaz a confirmação.
      { accessIssue = note; accessConfirmed = false }
    }

    // REVIEW [2026-12-15] Registra o pedido de equipamento do colaborador.
    orderEquipment(kind: EquipmentKind) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Pedir equipamento", en: "Order equipment" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [ITAdmin, PeopleOps]
      // REVIEW [2026-12-15] Documento retornado pela ação.
      returns: EquipmentOrder
      // REVIEW [2026-12-15] Efeito da ação: guarda o tipo do último equipamento.
      { lastEquipmentKind = kind }
    }

    // REVIEW [2026-12-15] Registra a observação do check-in feito pelo gestor.
    recordCheckinNote(note: string) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Registrar check-in do gestor", en: "Record manager check-in" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [HiringManager]
      // REVIEW [2026-12-15] Efeito da ação: grava a observação do gestor.
      { checkinNote = note }
    }

    // REVIEW [2026-12-15] Conclui a integração e torna o colaborador ativo.
    activate() {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Concluir integração", en: "Complete onboarding" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [HiringManager, PeopleOps]
      // REVIEW [2026-12-15] Transição de situação disparada pela ação.
      to: status.Active
      // REVIEW [2026-12-15] Payload do evento emitido pela transição.
      emits { at: now() }
    }

    // REVIEW [2026-12-15] Cancela a integração e encerra o vínculo.
    cancelOnboarding(reason: string) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Cancelar integração", en: "Cancel onboarding" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [PeopleOps]
      // REVIEW [2026-12-15] Transição de situação disparada pela ação.
      to: status.Terminated
      // REVIEW [2026-12-15] Efeito da ação: grava o motivo do encerramento.
      { offboardingReason = reason }
    }

    // REVIEW [2026-12-15] Inicia o desligamento do colaborador.
    startOffboarding(reason: string, lastDay: DateTime) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Iniciar desligamento", en: "Start offboarding" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [PeopleOps, HiringManager]
      // REVIEW [2026-12-15] Transição de situação disparada pela ação.
      to: status.Offboarding
      // REVIEW [2026-12-15] Efeito da ação: grava motivo e último dia de trabalho.
      { offboardingReason = reason; lastWorkingDay = lastDay }
    }

    // REVIEW [2026-12-15] Cancela o desligamento e devolve o colaborador à ativa.
    cancelOffboarding(reason: string) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Cancelar desligamento", en: "Cancel offboarding" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [PeopleOps]
      // REVIEW [2026-12-15] Transição de situação disparada pela ação.
      to: status.Active
    }

    // REVIEW [2026-12-15] Revoga todos os acessos e registra a observação.
    revokeAllAccess(note: string) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Revogar acessos", en: "Revoke all access" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [ITAdmin]
      // REVIEW [2026-12-15] Efeito da ação: grava a data da revogação e a observação.
      { accessRevokedAt = now(); accessIssue = note }
    }

    // REVIEW [2026-12-15] Registra a devolução de um equipamento.
    returnEquipment(kind: EquipmentKind) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Registrar devolução", en: "Register equipment return" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [ITAdmin]
      // REVIEW [2026-12-15] Efeito da ação: grava a data da devolução e o tipo devolvido.
      { equipmentReturnedAt = now(); lastEquipmentKind = kind }
    }

    // REVIEW [2026-12-15] Registra as anotações da entrevista de saída.
    recordExitInterview(notes: string) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Registrar entrevista de saída", en: "Record exit interview" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [PeopleOps]
      // REVIEW [2026-12-15] Efeito da ação: grava as anotações da entrevista.
      { exitInterviewNotes = notes }
    }

    // REVIEW [2026-12-15] Desliga o colaborador ao final do processo.
    terminate() {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Desligar colaborador", en: "Terminate employee" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [PeopleOps]
      // REVIEW [2026-12-15] Transição de situação disparada pela ação.
      to: status.Terminated
      // REVIEW [2026-12-15] Payload do evento emitido pela transição.
      emits { at: now() }
    }
  }
}

// REVIEW [2026-12-15] Máquina de estados da situação do colaborador.
shape EmployeeStatus {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Situação do colaborador", en: "Employee status" }
  // REVIEW [2026-12-15] Base de estado: valores com ciclo de vida e transições.
  base: state
  // REVIEW [2026-12-15] Situação inicial em integração, com a transição Hired declarada junto.
  initial: Onboarding with transition Hired {
    // REVIEW [2026-12-15] Título exibido no histórico da transição.
    title: { pt-BR: "Colaborador contratado", en: "Employee hired" }
    // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
    payload {
      // REVIEW [2026-12-15] Data de início informada na contratação.
      startedAt: DateTime { title: { pt-BR: "Início", en: "Start date" } }
    }
  }

  // REVIEW [2026-12-15] Situação de colaborador em integração.
  value Onboarding {
    // REVIEW [2026-12-15] Rótulo exibido para o valor.
    title: { pt-BR: "Em integração", en: "Onboarding" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: status.onboarding
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 10

    // REVIEW [2026-12-15] Transição para colaborador ativo.
    transition Active {
      // REVIEW [2026-12-15] Evento que dispara a transição.
      event: Activated
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Integração concluída", en: "Onboarding completed" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Data e hora da conclusão.
        at: DateTime { title: { pt-BR: "Em", en: "At" } }
      }
    }

    // REVIEW [2026-12-15] Transição para integração cancelada.
    transition Terminated {
      // REVIEW [2026-12-15] Evento que dispara a transição.
      event: OnboardingCancelled
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Integração cancelada", en: "Onboarding cancelled" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Motivo do cancelamento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Situação de colaborador ativo.
  value Active {
    // REVIEW [2026-12-15] Rótulo exibido para o valor.
    title: { pt-BR: "Ativo", en: "Active" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: status.active
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 20

    // REVIEW [2026-12-15] Transição para desligamento iniciado.
    transition Offboarding {
      // REVIEW [2026-12-15] Evento que dispara a transição.
      event: OffboardingStarted
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Desligamento iniciado", en: "Offboarding started" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Motivo do desligamento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Situação de colaborador em desligamento.
  value Offboarding {
    // REVIEW [2026-12-15] Rótulo exibido para o valor.
    title: { pt-BR: "Em desligamento", en: "Offboarding" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: status.offboarding
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 30

    // REVIEW [2026-12-15] Transição de volta para colaborador ativo.
    transition Active {
      // REVIEW [2026-12-15] Evento que dispara a transição.
      event: OffboardingCancelled
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Desligamento cancelado", en: "Offboarding cancelled" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Motivo do cancelamento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }

    // REVIEW [2026-12-15] Transição para colaborador desligado.
    transition Terminated {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Colaborador desligado", en: "Employee terminated" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Data e hora do desligamento.
        at: DateTime { title: { pt-BR: "Em", en: "At" } }
      }
    }
  }
  // REVIEW [2026-12-15] Situação final de colaborador desligado.
  value Terminated {
    // REVIEW [2026-12-15] Rótulo exibido para o valor.
    title: { pt-BR: "Desligado", en: "Terminated" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: status.terminated
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 40
  }
}

// REVIEW [2026-12-15] Classificação dos tipos de vínculo empregatício.
shape EmploymentType {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Vínculo", en: "Employment type" }
  // REVIEW [2026-12-15] Base de classificação: valores estáticos, sem ciclo de vida.
  base: classification

  // REVIEW [2026-12-15] Valor para tempo integral.
  value FullTime {
    // REVIEW [2026-12-15] Rótulo exibido para o valor.
    title: { pt-BR: "Tempo integral", en: "Full time" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: employment.fullTime
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 10
  }
  // REVIEW [2026-12-15] Valor para meio período.
  value PartTime {
    // REVIEW [2026-12-15] Rótulo exibido para o valor.
    title: { pt-BR: "Meio período", en: "Part time" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: employment.partTime
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 20
  }
  // REVIEW [2026-12-15] Valor para prestador de serviço.
  value Contractor {
    // REVIEW [2026-12-15] Rótulo exibido para o valor.
    title: { pt-BR: "Prestador", en: "Contractor" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: employment.contractor
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 30
  }
}
