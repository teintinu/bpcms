// REVIEW [2026-12-15] service: example.com/services/hr

// REVIEW [2026-12-15] Documento que representa um candidato em processo seletivo.
document Candidate {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Candidato", en: "Candidate" }
  // REVIEW [2026-12-15] Versão do artefato usada em diff e release.
  // REVIEW [2026-12-15] Área responsável pelo documento.
  owner: "People"
  // REVIEW [2026-12-15] Sincronização em tempo real entre instâncias e telas.
  sync: live
  // REVIEW [2026-12-15] Prazo de retenção dos dados do candidato.
  retention: 2y

  // REVIEW [2026-12-15] Campos que compõem o candidato.
  fields {
    // REVIEW [2026-12-15] Nome do candidato; consultável.
    name: string { title: { pt-BR: "Nome", en: "Name" }, lookup, maxLength: 120 }
    // REVIEW [2026-12-15] E-mail do candidato; dado pessoal sensível.
    email: string { title: { pt-BR: "E-mail", en: "Email" }, sensitive, maxLength: 160 }
    // REVIEW [2026-12-15] Vaga à qual o candidato se inscreveu; consultável.
    position: string { title: { pt-BR: "Vaga", en: "Position" }, lookup, maxLength: 120 }
    // REVIEW [2026-12-15] Área da vaga; consultável.
    department: Department { title: { pt-BR: "Área", en: "Department" }, lookup }
    // REVIEW [2026-12-15] Situação atual do candidato no processo; consultável.
    status: CandidateStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    // REVIEW [2026-12-15] Origem da inscrição do candidato.
    source: string { title: { pt-BR: "Origem", en: "Source" }, maxLength: 60 }
    // REVIEW [2026-12-15] Data e hora da inscrição; preenchida pelo sistema.
    appliedAt: DateTime { title: { pt-BR: "Inscrito em", en: "Applied at" }, readonly }
    // REVIEW [2026-12-15] Motivo informado na recusa do candidato.
    rejectReason: string { title: { pt-BR: "Motivo da recusa", en: "Rejection reason" }, maxLength: 500 }
  }

  // REVIEW [2026-12-15] Índices que aceleram as consultas do documento.
  indexes {
    // REVIEW [2026-12-15] Índice ordenado por situação e data de inscrição.
    byStatus: [status, appliedAt] range
    // REVIEW [2026-12-15] Índice hash por vaga.
    byPosition: [position] hash
  }


  // REVIEW [2026-12-15] Ações que movimentam o candidato no processo seletivo.
  actions {
    // REVIEW [2026-12-15] Coloca o candidato em triagem.
    screen() {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Triar candidato", en: "Screen candidate" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Recruiter]
      // REVIEW [2026-12-15] Transição de situação disparada pela ação.
      to: status.Screening
      // REVIEW [2026-12-15] Payload do evento emitido pela transição.
      emits { at: now() }
    }

    // REVIEW [2026-12-15] Agenda a entrevista do candidato.
    scheduleInterview() {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Agendar entrevista", en: "Schedule interview" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Recruiter]
      // REVIEW [2026-12-15] Transição de situação disparada pela ação.
      to: status.Interview
      // REVIEW [2026-12-15] Payload do evento emitido pela transição.
      emits { at: now() }
    }

    // REVIEW [2026-12-15] Envia a proposta ao candidato.
    extendOffer() {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Enviar proposta", en: "Extend offer" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [HiringManager, Recruiter]
      // REVIEW [2026-12-15] Transição de situação disparada pela ação.
      to: status.Offer
      // REVIEW [2026-12-15] Payload do evento emitido pela transição.
      emits { at: now() }
    }

    // REVIEW [2026-12-15] Contrata o candidato.
    hire() {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Contratar", en: "Hire" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [HiringManager]
      // REVIEW [2026-12-15] Transição de situação disparada pela ação.
      to: status.Hired
      // REVIEW [2026-12-15] Payload do evento emitido pela transição.
      emits { at: now() }
    }

    // REVIEW [2026-12-15] Recusa o candidato, registrando o motivo.
    reject(reason: string) {
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Recusar candidato", en: "Reject candidate" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Recruiter, HiringManager]
      // REVIEW [2026-12-15] Transição de situação disparada pela ação.
      to: status.Rejected
      // REVIEW [2026-12-15] Efeito da ação: grava o motivo da recusa.
      { rejectReason = reason }
    }
  }
}

// REVIEW [2026-12-15] Máquina de estados da situação do candidato.
shape CandidateStatus {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Situação do candidato", en: "Candidate status" }
  // REVIEW [2026-12-15] Base de estado: valores com ciclo de vida e transições.
  base: state
  // REVIEW [2026-12-15] Situação inicial de um candidato recém-inscrito.
  initial: Applied

  // REVIEW [2026-12-15] Situação de candidato inscrito.
  value Applied {
    // REVIEW [2026-12-15] Rótulo exibido para o valor.
    title: { pt-BR: "Inscrito", en: "Applied" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: status.applied
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 10

    // REVIEW [2026-12-15] Transição para candidato triado.
    transition Screening {
      // REVIEW [2026-12-15] Evento que dispara a transição.
      event: Screened
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Candidato triado", en: "Candidate screened" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Data e hora da triagem.
        at: DateTime { title: { pt-BR: "Em", en: "At" } }
      }
    }

    // REVIEW [2026-12-15] Transição para candidato recusado.
    transition Rejected {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Candidato recusado", en: "Candidate rejected" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Motivo da recusa.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Situação de candidato em triagem.
  value Screening {
    // REVIEW [2026-12-15] Rótulo exibido para o valor.
    title: { pt-BR: "Em triagem", en: "Screening" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: status.screening
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 20

    // REVIEW [2026-12-15] Transição para entrevista agendada.
    transition Interview {
      // REVIEW [2026-12-15] Evento que dispara a transição.
      event: InterviewScheduled
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Entrevista agendada", en: "Interview scheduled" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Data e hora do agendamento.
        at: DateTime { title: { pt-BR: "Em", en: "At" } }
      }
    }

    // REVIEW [2026-12-15] Transição para candidato recusado.
    transition Rejected {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Candidato recusado", en: "Candidate rejected" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Motivo da recusa.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Situação de candidato em entrevista.
  value Interview {
    // REVIEW [2026-12-15] Rótulo exibido para o valor.
    title: { pt-BR: "Em entrevista", en: "Interview" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: status.interview
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 30

    // REVIEW [2026-12-15] Transição para proposta enviada.
    transition Offer {
      // REVIEW [2026-12-15] Evento que dispara a transição.
      event: OfferExtended
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Proposta enviada", en: "Offer extended" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Data e hora do envio da proposta.
        at: DateTime { title: { pt-BR: "Em", en: "At" } }
      }
    }

    // REVIEW [2026-12-15] Transição para candidato recusado.
    transition Rejected {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Candidato recusado", en: "Candidate rejected" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Motivo da recusa.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Situação de candidato com proposta em aberto.
  value Offer {
    // REVIEW [2026-12-15] Rótulo exibido para o valor.
    title: { pt-BR: "Com proposta", en: "Offer" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: status.offer
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 40

    // REVIEW [2026-12-15] Transição para candidato contratado.
    transition Hired {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Candidato contratado", en: "Candidate hired" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Data e hora da contratação.
        at: DateTime { title: { pt-BR: "Em", en: "At" } }
      }
    }

    // REVIEW [2026-12-15] Transição para candidato recusado.
    transition Rejected {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Candidato recusado", en: "Candidate rejected" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Motivo da recusa.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Situação final de candidato contratado.
  value Hired {
    // REVIEW [2026-12-15] Rótulo exibido para o valor.
    title: { pt-BR: "Contratado", en: "Hired" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: status.hired
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 50
  }
  // REVIEW [2026-12-15] Situação final de candidato recusado.
  value Rejected {
    // REVIEW [2026-12-15] Rótulo exibido para o valor.
    title: { pt-BR: "Recusado", en: "Rejected" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: status.rejected
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 60
  }
}
