// service: example.com/services/hr
// Process: sintaxe atual (DSL_REFERENCE.md §4)

// Processo que encerra o vínculo e devolve acessos e equipamentos.
process Offboarding(employee: Employee) {
  // Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Desligamento do colaborador", en: "Employee offboarding" }
  // Versão do artefato Process; diff e release comparam.
  version: 1
  // Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // Texto do objetivo em português.
    pt-BR: "Encerrar o vínculo com acessos revogados, equipamento devolvido e entrevista registrada"
  }
  // SLA brando do caso: alvo de lead time, não é timer.
  sla: 30d
  // Prazo máximo do caso antes do timeout.
  timeout: 30d

  // Gatilho: inicia uma instância quando o documento inicia o desligamento.
  on [Employee.OffboardingStarted]
  // Chave de identidade, correlação e dedup da instância.
  key: employee

  // Bloco que captura timeout do caso e dos forms.
  try {
    // Executa revogação, devolução e entrevista em paralelo.
    parallel {
      // Ramo de revogação dos acessos.
      branch RevokeAccess {
        // Exibe o form de revogação para o TI.
        AccessRevocation.show({ employee })
      }
      // Ramo de devolução do equipamento.
      branch ReturnEquipment {
        // Exibe o form de devolução para o TI.
        EquipmentReturn.show({ employee })
      }
      // Ramo da entrevista de saída.
      branch ExitInterview {
        // Exibe o form de entrevista de saída para Pessoas e cultura.
        ExitInterview.show({ employee })
      }
    }

    // Espera até o último dia de trabalho antes de encerrar o vínculo.
    wait until employee.lastWorkingDay

    // Desliga o colaborador no documento.
    Employee.terminate()

    // Encerra no desfecho Closed.
    return Closed
  } catch (Timeout) {
    // Timeout do caso: escala o desligamento para o gestor.
    EscalateOffboarding.show({ employee })

    // Desliga o colaborador mesmo fora do prazo.
    Employee.terminate()

    // Encerra no desfecho Closed.
    return Closed
  }

  // Cancelamento: se o desligamento for cancelado no documento...
  cancel on Employee.OffboardingCancelled {
    // ...encerra no desfecho Cancelled.
    return Cancelled
  }

  // Declara o desfecho de sucesso do caso.
  end Closed {
    // Título exibido no histórico e nos filtros.
    title: { pt-BR: "Desligado", en: "Closed" }
    // Classificação do desfecho para KPI.
    outcome: success
  }

  // Declara o desfecho de cancelamento do caso.
  end Cancelled {
    // Título exibido no histórico.
    title: { pt-BR: "Desligamento cancelado", en: "Offboarding cancelled" }
    // Classificação do desfecho para KPI.
    outcome: cancelled
  }
}

// Tarefa manual de escalação do desligamento.
manual EscalateOffboarding {
  // Título exibido na inbox e no histórico.
  title: { pt-BR: "Escalar desligamento", en: "Escalate offboarding" }
  // Documento-sujeito da tarefa.
  document: Employee
  // Papéis que podem assumir a tarefa.
  roles: [HiringManager]
  // Orientação exibida para quem executa a tarefa.
  instructions: "Falar com a pessoa e concluir o desligamento"
  // Prazo para conclusão da tarefa.
  timeout: 1d
  // Prioridade da tarefa na fila.
  priority: 70
  // Distribuição da tarefa por puxada (pull).
  assign: pull
}

// Form de revogação dos acessos do colaborador.
form AccessRevocation {
  // Título exibido na inbox e no histórico.
  title: { pt-BR: "Revogação de acessos", en: "Access revocation" }
  // Documento-sujeito do form.
  document: Employee
  // Papéis que podem preencher o form.
  roles: [ITAdmin]
  // Prazo para preenchimento antes do timeout.
  timeout: 1d
  // Prioridade do form na fila.
  priority: 60
  // Distribuição do form por puxada (pull).
  assign: pull

  // Campos exibidos no form.
  fields {
    // Observação livre sobre a revogação.
    note: string {
      // Título exibido no formulário.
      title: { pt-BR: "Observação", en: "Note" }
      // Limita a observação a quinhentos caracteres.
      maxLength: 500
    }
  }

  // Ações disponíveis no form.
  actions {
    // Revoga todos os acessos e registra a observação.
    revoke { calls: Employee.revokeAllAccess(note) }
  }
}

// Form de devolução do equipamento.
form EquipmentReturn {
  // Título exibido na inbox e no histórico.
  title: { pt-BR: "Devolução de equipamento", en: "Equipment return" }
  // Documento-sujeito do form.
  document: Employee
  // Papéis que podem preencher o form.
  roles: [ITAdmin]
  // Prazo para preenchimento antes do timeout.
  timeout: 2d
  // Prioridade do form na fila.
  priority: 60
  // Distribuição do form por puxada (pull).
  assign: pull

  // Campos exibidos no form.
  fields {
    // Tipo do equipamento devolvido.
    kind: EquipmentKind {
      // Título exibido no formulário.
      title: { pt-BR: "Equipamento", en: "Equipment" }
      // Torna o tipo de equipamento obrigatório.
      required
    }
  }

  // Ações disponíveis no form.
  actions {
    // Registra a devolução com o tipo escolhido.
    returnItem { calls: Employee.returnEquipment(kind) }
  }
}

// Form da entrevista de saída.
form ExitInterview {
  // Título exibido na inbox e no histórico.
  title: { pt-BR: "Entrevista de saída", en: "Exit interview" }
  // Documento-sujeito do form.
  document: Employee
  // Papéis que podem preencher o form.
  roles: [PeopleOps]
  // Prazo para preenchimento antes do timeout.
  timeout: 3d
  // Prioridade do form na fila.
  priority: 50
  // Distribuição do form por puxada (pull).
  assign: pull

  // Campos exibidos no form.
  fields {
    // Anotações da conversa de saída.
    notes: string {
      // Título exibido no formulário.
      title: { pt-BR: "Anotações", en: "Notes" }
      // Limita as anotações a dois mil caracteres.
      maxLength: 2000
    }
  }

  // Ações disponíveis no form.
  actions {
    // Registra as anotações da entrevista.
    record { calls: Employee.recordExitInterview(notes) }
  }
}
