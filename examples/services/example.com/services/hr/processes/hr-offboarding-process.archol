// REVIEW [2026-12-15] service: example.com/services/hr
// REVIEW [2026-12-15] Process: sintaxe atual (DSL_REFERENCE.md §4)

// REVIEW [2026-12-15] Processo que encerra o vínculo e devolve acessos e equipamentos.
process Offboarding(employee: Employee) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Desligamento do colaborador", en: "Employee offboarding" }
  // REVIEW [2026-12-15] Versão do artefato Process; diff e release comparam.
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Encerrar o vínculo com acessos revogados, equipamento devolvido e entrevista registrada"
  }
  // REVIEW [2026-12-15] SLA brando do caso: alvo de lead time, não é timer.
  sla: 30d
  // REVIEW [2026-12-15] Prazo máximo do caso antes do timeout.
  timeout: 30d

  // REVIEW [2026-12-15] Gatilho: inicia uma instância quando o documento inicia o desligamento.
  on [Employee.OffboardingStarted]
  // REVIEW [2026-12-15] Chave de identidade, correlação e dedup da instância.
  key: employee

  // REVIEW [2026-12-15] Bloco que captura timeout do caso e dos forms.
  try {
    // REVIEW [2026-12-15] Executa revogação, devolução e entrevista em paralelo.
    parallel {
      // REVIEW [2026-12-15] Ramo de revogação dos acessos.
      branch RevokeAccess {
        // REVIEW [2026-12-15] Exibe o form de revogação para o TI.
        AccessRevocation.show({ employee })
      }
      // REVIEW [2026-12-15] Ramo de devolução do equipamento.
      branch ReturnEquipment {
        // REVIEW [2026-12-15] Exibe o form de devolução para o TI.
        EquipmentReturn.show({ employee })
      }
      // REVIEW [2026-12-15] Ramo da entrevista de saída.
      branch ExitInterview {
        // REVIEW [2026-12-15] Exibe o form de entrevista de saída para Pessoas e cultura.
        ExitInterview.show({ employee })
      }
    }

    // REVIEW [2026-12-15] Espera até o último dia de trabalho antes de encerrar o vínculo.
    wait until employee.lastWorkingDay

    // REVIEW [2026-12-15] Desliga o colaborador no documento.
    Employee.terminate()

    // REVIEW [2026-12-15] Encerra no desfecho Closed.
    return Closed
  } catch (Timeout) {
    // REVIEW [2026-12-15] Timeout do caso: escala o desligamento para o gestor.
    EscalateOffboarding.show({ employee })

    // REVIEW [2026-12-15] Desliga o colaborador mesmo fora do prazo.
    Employee.terminate()

    // REVIEW [2026-12-15] Encerra no desfecho Closed.
    return Closed
  }

  // REVIEW [2026-12-15] Cancelamento: se o desligamento for cancelado no documento...
  cancel on Employee.OffboardingCancelled {
    // REVIEW [2026-12-15] ...encerra no desfecho Cancelled.
    return Cancelled
  }

  // REVIEW [2026-12-15] Declara o desfecho de sucesso do caso.
  end Closed {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Desligado", en: "Closed" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }

  // REVIEW [2026-12-15] Declara o desfecho de cancelamento do caso.
  end Cancelled {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Desligamento cancelado", en: "Offboarding cancelled" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: cancelled
  }
}

// REVIEW [2026-12-15] Tarefa manual de escalação do desligamento.
manual EscalateOffboarding {
  // REVIEW [2026-12-15] Título exibido na inbox e no histórico.
  title: { pt-BR: "Escalar desligamento", en: "Escalate offboarding" }
  // REVIEW [2026-12-15] Documento-sujeito da tarefa.
  document: Employee
  // REVIEW [2026-12-15] Papéis que podem assumir a tarefa.
  roles: [HiringManager]
  // REVIEW [2026-12-15] Orientação exibida para quem executa a tarefa.
  instructions: "Falar com a pessoa e concluir o desligamento"
  // REVIEW [2026-12-15] Prazo para conclusão da tarefa.
  timeout: 1d
  // REVIEW [2026-12-15] Prioridade da tarefa na fila.
  priority: 70
  // REVIEW [2026-12-15] Distribuição da tarefa por puxada (pull).
  assign: pull
}

// REVIEW [2026-12-15] Form de revogação dos acessos do colaborador.
form AccessRevocation {
  // REVIEW [2026-12-15] Título exibido na inbox e no histórico.
  title: { pt-BR: "Revogação de acessos", en: "Access revocation" }
  // REVIEW [2026-12-15] Documento-sujeito do form.
  document: Employee
  // REVIEW [2026-12-15] Papéis que podem preencher o form.
  roles: [ITAdmin]
  // REVIEW [2026-12-15] Prazo para preenchimento antes do timeout.
  timeout: 1d
  // REVIEW [2026-12-15] Prioridade do form na fila.
  priority: 60
  // REVIEW [2026-12-15] Distribuição do form por puxada (pull).
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no form.
  fields {
    // REVIEW [2026-12-15] Observação livre sobre a revogação.
    note: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Observação", en: "Note" }
      // REVIEW [2026-12-15] Limita a observação a quinhentos caracteres.
      maxLength: 500
    }
  }

  // REVIEW [2026-12-15] Ações disponíveis no form.
  actions {
    // REVIEW [2026-12-15] Revoga todos os acessos e registra a observação.
    revoke { calls: Employee.revokeAllAccess(note) }
  }
}

// REVIEW [2026-12-15] Form de devolução do equipamento.
form EquipmentReturn {
  // REVIEW [2026-12-15] Título exibido na inbox e no histórico.
  title: { pt-BR: "Devolução de equipamento", en: "Equipment return" }
  // REVIEW [2026-12-15] Documento-sujeito do form.
  document: Employee
  // REVIEW [2026-12-15] Papéis que podem preencher o form.
  roles: [ITAdmin]
  // REVIEW [2026-12-15] Prazo para preenchimento antes do timeout.
  timeout: 2d
  // REVIEW [2026-12-15] Prioridade do form na fila.
  priority: 60
  // REVIEW [2026-12-15] Distribuição do form por puxada (pull).
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no form.
  fields {
    // REVIEW [2026-12-15] Tipo do equipamento devolvido.
    kind: EquipmentKind {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Equipamento", en: "Equipment" }
      // REVIEW [2026-12-15] Torna o tipo de equipamento obrigatório.
      required
    }
  }

  // REVIEW [2026-12-15] Ações disponíveis no form.
  actions {
    // REVIEW [2026-12-15] Registra a devolução com o tipo escolhido.
    returnItem { calls: Employee.returnEquipment(kind) }
  }
}

// REVIEW [2026-12-15] Form da entrevista de saída.
form ExitInterview {
  // REVIEW [2026-12-15] Título exibido na inbox e no histórico.
  title: { pt-BR: "Entrevista de saída", en: "Exit interview" }
  // REVIEW [2026-12-15] Documento-sujeito do form.
  document: Employee
  // REVIEW [2026-12-15] Papéis que podem preencher o form.
  roles: [PeopleOps]
  // REVIEW [2026-12-15] Prazo para preenchimento antes do timeout.
  timeout: 3d
  // REVIEW [2026-12-15] Prioridade do form na fila.
  priority: 50
  // REVIEW [2026-12-15] Distribuição do form por puxada (pull).
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no form.
  fields {
    // REVIEW [2026-12-15] Anotações da conversa de saída.
    notes: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Anotações", en: "Notes" }
      // REVIEW [2026-12-15] Limita as anotações a dois mil caracteres.
      maxLength: 2000
    }
  }

  // REVIEW [2026-12-15] Ações disponíveis no form.
  actions {
    // REVIEW [2026-12-15] Registra as anotações da entrevista.
    record { calls: Employee.recordExitInterview(notes) }
  }
}
