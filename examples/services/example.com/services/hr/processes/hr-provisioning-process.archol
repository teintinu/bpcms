// REVIEW [2026-12-15] service: example.com/services/hr
// REVIEW [2026-12-15] Process: sintaxe atual (DSL_REFERENCE.md §4)

// REVIEW [2026-12-15] Processo que provisiona e-mail e sistemas e confirma o acesso da pessoa.
process Provisioning(employee: Employee) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Provisionamento de acessos", en: "Access provisioning" }
  // REVIEW [2026-12-15] Versão do artefato Process; diff e release comparam.
  version: 1
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Entregar e-mail e sistemas funcionando para a pessoa contratada"
  }
  // REVIEW [2026-12-15] SLA brando do caso: alvo de lead time, não é timer.
  sla: 3d
  // REVIEW [2026-12-15] Prazo máximo do caso antes do timeout.
  timeout: 3d

  // REVIEW [2026-12-15] Processo chamado por outro processo, sem gatilho próprio.
  called

  // REVIEW [2026-12-15] Bloco externo: captura timeout do caso e de qualquer form.
  try {
    // REVIEW [2026-12-15] Provisiona a caixa de e-mail corporativo.
    Employee.provisionMailbox()

    // REVIEW [2026-12-15] Bloco interno: tenta provisionar os sistemas de trabalho.
    try {
      // REVIEW [2026-12-15] Provisiona os sistemas do colaborador.
      Employee.provisionSystems()
    } catch (Timeout) {
      // REVIEW [2026-12-15] Se o provisionamento estourar o prazo, escala para o TI.
      EscalateProvisioning.show({ employee })
    }

    // REVIEW [2026-12-15] Bloco interno: pede a confirmação de acesso da pessoa.
    try {
      // REVIEW [2026-12-15] Exibe o form de confirmação para a nova contratação.
      AccessConfirmation.show({ employee })
    } catch (Timeout) {
      // REVIEW [2026-12-15] Sem confirmação no prazo, escala o caso para o TI.
      EscalateProvisioning.show({ employee })
      // REVIEW [2026-12-15] Reabre a confirmação para nova tentativa.
      AccessConfirmation.show({ employee })
    }
  } catch (Timeout) {
    // REVIEW [2026-12-15] Timeout do caso: escala o provisionamento para o TI.
    EscalateProvisioning.show({ employee })
    // REVIEW [2026-12-15] Reabre a confirmação de acesso.
    AccessConfirmation.show({ employee })
  }

  // REVIEW [2026-12-15] Se a pessoa confirmou os acessos...
  if (employee.accessConfirmed) {
    // REVIEW [2026-12-15] ...encerra no desfecho Ready.
    return Ready
  }

  // REVIEW [2026-12-15] Sem confirmação, encerra no desfecho Blocked.
  return Blocked

  // REVIEW [2026-12-15] Declara o desfecho de sucesso do caso.
  end Ready {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Acessos prontos", en: "Access ready" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }

  // REVIEW [2026-12-15] Declara o desfecho de falha do caso.
  end Blocked {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Acesso bloqueado", en: "Access blocked" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: failure
  }
}

// REVIEW [2026-12-15] Tarefa manual de escalação do provisionamento.
manual EscalateProvisioning {
  // REVIEW [2026-12-15] Título exibido na inbox e no histórico.
  title: { pt-BR: "Escalar provisionamento", en: "Escalate provisioning" }
  // REVIEW [2026-12-15] Documento-sujeito da tarefa.
  document: Employee
  // REVIEW [2026-12-15] Papéis que podem assumir a tarefa.
  roles: [ITAdmin]
  // REVIEW [2026-12-15] Orientação exibida para quem executa a tarefa.
  instructions: "Reprovisionar o acesso com a pessoa e registrar o problema"
  // REVIEW [2026-12-15] Prazo para conclusão da tarefa.
  timeout: 4h
  // REVIEW [2026-12-15] Prioridade da tarefa na fila.
  priority: 70
  // REVIEW [2026-12-15] Distribuição da tarefa por puxada (pull).
  assign: pull
}

// REVIEW [2026-12-15] Form de confirmação de acesso preenchido pela nova contratação.
form AccessConfirmation {
  // REVIEW [2026-12-15] Título exibido na inbox e no histórico.
  title: { pt-BR: "Confirmação de acesso", en: "Access confirmation" }
  // REVIEW [2026-12-15] Documento-sujeito do form.
  document: Employee
  // REVIEW [2026-12-15] Papéis que podem preencher o form.
  roles: [NewHire]
  // REVIEW [2026-12-15] Prazo para preenchimento antes do timeout.
  timeout: 2d
  // REVIEW [2026-12-15] Prioridade do form na fila.
  priority: 50
  // REVIEW [2026-12-15] Distribuição do form por puxada (pull).
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no form.
  fields {
    // REVIEW [2026-12-15] Observação livre digitada pela pessoa.
    note: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Observação", en: "Note" }
      // REVIEW [2026-12-15] Limita a observação a quinhentos caracteres.
      maxLength: 500
    }
  }

  // REVIEW [2026-12-15] Ações disponíveis no form.
  actions {
    // REVIEW [2026-12-15] Confirma que os acessos funcionam.
    confirm { calls: Employee.confirmAccess }
    // REVIEW [2026-12-15] Relata um problema de acesso, enviando a observação.
    report { calls: Employee.reportAccessIssue(note) }
  }
}
