// REVIEW [2026-12-15] service: example.com/services/hr
// REVIEW [2026-12-15] Process: sintaxe atual (DSL_REFERENCE.md §4)

// REVIEW [2026-12-15] Processo que integra a pessoa contratada no primeiro dia.
process Onboarding(employee: Employee) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Integração do colaborador", en: "Employee onboarding" }
  // REVIEW [2026-12-15] Versão do artefato Process; diff e release comparam.
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Colocar a pessoa produtiva no primeiro dia, com documentos, acessos e equipamento"
  }
  // REVIEW [2026-12-15] SLA brando do caso: alvo de lead time, não é timer.
  sla: 30d
  // REVIEW [2026-12-15] Prazo máximo do caso antes do timeout.
  timeout: 30d

  // REVIEW [2026-12-15] Gatilho: inicia uma instância quando o documento emite Hired.
  on [Employee.Hired]
  // REVIEW [2026-12-15] Chave de identidade, correlação e dedup da instância.
  key: employee

  // REVIEW [2026-12-15] Bloco que captura timeout do caso e dos forms.
  try {
    // REVIEW [2026-12-15] Executa documentos, acessos e equipamento em paralelo.
    parallel {
      // REVIEW [2026-12-15] Ramo de coleta dos documentos de integração.
      branch CollectDocuments {
        // REVIEW [2026-12-15] Bloco interno: tenta exibir o form de documentos.
        try {
          // REVIEW [2026-12-15] Exibe o form de documentos para a nova contratação.
          OnboardingDocuments.show({ employee })
        } catch (Timeout) {
          // REVIEW [2026-12-15] Sem envio no prazo, escala a integração para o gestor.
          EscalateOnboarding.show({ employee })
        }
      }
      // REVIEW [2026-12-15] Ramo de provisionamento de acessos.
      branch ProvisionAccess {
        // REVIEW [2026-12-15] Chama o subprocesso de provisionamento para o colaborador.
        Provisioning.run({ employee })
      }
      // REVIEW [2026-12-15] Ramo de pedido de equipamento.
      branch OrderEquipment {
        // REVIEW [2026-12-15] Exibe o form de pedido de equipamento para o TI.
        EquipmentRequest.show({ employee })
      }
    }

    // REVIEW [2026-12-15] Bloco interno: pede o check-in do gestor.
    try {
      // REVIEW [2026-12-15] Exibe o form de check-in para o gestor contratante.
      ManagerCheckin.show({ employee })
    } catch (Timeout) {
      // REVIEW [2026-12-15] Sem check-in no prazo, escala a integração para o gestor.
      EscalateOnboarding.show({ employee })
      // REVIEW [2026-12-15] Reabre o check-in para nova tentativa.
      ManagerCheckin.show({ employee })
    }

    // REVIEW [2026-12-15] Encerra no desfecho Ready.
    return Ready
  } catch (Timeout) {
    // REVIEW [2026-12-15] Timeout do caso: escala a integração para o gestor.
    EscalateOnboarding.show({ employee })
    // REVIEW [2026-12-15] Reabre o check-in do gestor.
    ManagerCheckin.show({ employee })

    // REVIEW [2026-12-15] Encerra mesmo assim no desfecho Ready.
    return Ready
  }

  // REVIEW [2026-12-15] Cancelamento: se a contratação for cancelada no documento...
  cancel on Employee.OnboardingCancelled {
    // REVIEW [2026-12-15] ...encerra no desfecho Cancelled.
    return Cancelled
  }

  // REVIEW [2026-12-15] Declara o desfecho de sucesso do caso.
  end Ready {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Pronto para trabalhar", en: "Ready to work" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }

  // REVIEW [2026-12-15] Declara o desfecho de cancelamento do caso.
  end Cancelled {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Integração cancelada", en: "Onboarding cancelled" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: cancelled
  }
}

// REVIEW [2026-12-15] Tarefa manual de escalação da integração.
manual EscalateOnboarding {
  // REVIEW [2026-12-15] Título exibido na inbox e no histórico.
  title: { pt-BR: "Escalar integração", en: "Escalate onboarding" }
  // REVIEW [2026-12-15] Documento-sujeito da tarefa.
  document: Employee
  // REVIEW [2026-12-15] Papéis que podem assumir a tarefa.
  roles: [HiringManager]
  // REVIEW [2026-12-15] Orientação exibida para quem executa a tarefa.
  instructions: "Conversar com a pessoa e destravar o que falta para a integração"
  // REVIEW [2026-12-15] Prazo para conclusão da tarefa.
  timeout: 1d
  // REVIEW [2026-12-15] Prioridade da tarefa na fila.
  priority: 70
  // REVIEW [2026-12-15] Distribuição da tarefa por puxada (pull).
  assign: pull
}

// REVIEW [2026-12-15] Form de envio dos documentos de integração.
form OnboardingDocuments {
  // REVIEW [2026-12-15] Título exibido na inbox e no histórico.
  title: { pt-BR: "Documentos de integração", en: "Onboarding documents" }
  // REVIEW [2026-12-15] Documento-sujeito do form.
  document: Employee
  // REVIEW [2026-12-15] Papéis que podem preencher o form.
  roles: [NewHire]
  // REVIEW [2026-12-15] Prazo para preenchimento antes do timeout.
  timeout: 5d
  // REVIEW [2026-12-15] Prioridade do form na fila.
  priority: 40
  // REVIEW [2026-12-15] Distribuição do form por puxada (pull).
  assign: pull

  // REVIEW [2026-12-15] Campos do documento exibidos no form.
  fields {
    // REVIEW [2026-12-15] Documento de identidade a ser preenchido.
    identityDocument
  }

  // REVIEW [2026-12-15] Ações disponíveis no form.
  actions {
    // REVIEW [2026-12-15] Envia o documento e conclui o checklist.
    submit { calls: Employee.submitDocuments(identityDocument) }
  }
}

// REVIEW [2026-12-15] Form de pedido de equipamento para a nova contratação.
form EquipmentRequest {
  // REVIEW [2026-12-15] Título exibido na inbox e no histórico.
  title: { pt-BR: "Pedido de equipamento", en: "Equipment request" }
  // REVIEW [2026-12-15] Documento-sujeito do form.
  document: Employee
  // REVIEW [2026-12-15] Papéis que podem preencher o form.
  roles: [ITAdmin]
  // REVIEW [2026-12-15] Prazo para preenchimento antes do timeout.
  timeout: 1d
  // REVIEW [2026-12-15] Prioridade do form na fila.
  priority: 50
  // REVIEW [2026-12-15] Distribuição do form por puxada (pull).
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no form.
  fields {
    // REVIEW [2026-12-15] Tipo de equipamento a ser pedido.
    kind: EquipmentKind {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Equipamento", en: "Equipment" }
      // REVIEW [2026-12-15] Torna o tipo de equipamento obrigatório.
      required
    }
  }

  // REVIEW [2026-12-15] Ações disponíveis no form.
  actions {
    // REVIEW [2026-12-15] Registra o pedido com o tipo escolhido.
    order { calls: Employee.orderEquipment(kind) }
  }
}

// REVIEW [2026-12-15] Form de check-in do gestor com a nova contratação.
form ManagerCheckin {
  // REVIEW [2026-12-15] Título exibido na inbox e no histórico.
  title: { pt-BR: "Check-in do gestor", en: "Manager check-in" }
  // REVIEW [2026-12-15] Documento-sujeito do form.
  document: Employee
  // REVIEW [2026-12-15] Papéis que podem preencher o form.
  roles: [HiringManager]
  // REVIEW [2026-12-15] Prazo para preenchimento antes do timeout.
  timeout: 2d
  // REVIEW [2026-12-15] Prioridade do form na fila.
  priority: 60
  // REVIEW [2026-12-15] Distribuição do form por puxada (pull).
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no form.
  fields {
    // REVIEW [2026-12-15] Observação livre digitada pelo gestor.
    note: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Observação", en: "Note" }
      // REVIEW [2026-12-15] Limita a observação a quinhentos caracteres.
      maxLength: 500
    }
  }

  // REVIEW [2026-12-15] Ações disponíveis no form.
  actions {
    // REVIEW [2026-12-15] Confirma o check-in e conclui a integração.
    confirm { calls: Employee.activate }
    // REVIEW [2026-12-15] Registra a observação sem sair do form.
    recordNote { calls: Employee.recordCheckinNote(note); stay }
  }
}
