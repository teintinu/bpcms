// REVIEW [2026-12-15] service: example.com/services/hr

// REVIEW [2026-12-15] Tela de detalhe de um colaborador.
view EmployeeDetail {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Detalhe do colaborador", en: "Employee detail" }
  // REVIEW [2026-12-15] Tipo da view: detalhe de documento.
  type: detail
  // REVIEW [2026-12-15] Documento exibido no detalhe.
  document: Employee
  // REVIEW [2026-12-15] Papéis que podem abrir o detalhe.
  roles: [PeopleOps, HiringManager, ITAdmin, NewHire]

  // REVIEW [2026-12-15] Seções exibidas na tela de detalhe.
  sections { summary; onboarding; access; equipment; timeline }

  // REVIEW [2026-12-15] Ações disponíveis na tela de detalhe.
  actions {
    // REVIEW [2026-12-15] Abre o andamento da integração.
    open -> OnboardingProgress
    // REVIEW [2026-12-15] Cancela a integração, pedindo o motivo.
    cancelOnboarding -> Employee.cancelOnboarding(reason)
    // REVIEW [2026-12-15] Desliga o colaborador.
    terminate -> Employee.terminate
  }
}
