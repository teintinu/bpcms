// REVIEW [2026-12-15] service: example.com/services/hr

// REVIEW [2026-12-15] Tabela de consulta dos colaboradores.
view EmployeesTable {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Colaboradores", en: "Employees" }
  // REVIEW [2026-12-15] Tipo da view: tabela de documentos.
  type: table
  // REVIEW [2026-12-15] Documento exibido na tabela.
  source: Employee
  // REVIEW [2026-12-15] Papéis que podem abrir a tabela.
  roles: [PeopleOps, HiringManager, ITAdmin]

  // REVIEW [2026-12-15] Colunas exibidas na tabela.
  columns { number; person; position; department; status; startedAt }
  // REVIEW [2026-12-15] Filtros disponíveis na tabela.
  filters { status; department; period }
  // REVIEW [2026-12-15] Quantidade de linhas por página.
  pagination: 50

  // REVIEW [2026-12-15] Ações disponíveis sobre as linhas da tabela.
  actions {
    // REVIEW [2026-12-15] Abre o detalhe do colaborador.
    open -> EmployeeDetail
    // REVIEW [2026-12-15] Inicia o desligamento, pedindo motivo e último dia.
    startOffboarding -> Employee.startOffboarding(reason, lastDay)
  }
}
