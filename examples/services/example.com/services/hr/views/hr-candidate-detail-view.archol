// REVIEW [2026-12-15] service: example.com/services/hr

// REVIEW [2026-12-15] Tela de detalhe de um candidato.
view CandidateDetail {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Detalhe do candidato", en: "Candidate detail" }
  // REVIEW [2026-12-15] Tipo da view: detalhe de documento.
  type: detail
  // REVIEW [2026-12-15] Documento exibido no detalhe.
  document: Candidate
  // REVIEW [2026-12-15] Papéis que podem abrir o detalhe.
  roles: [Recruiter, HiringManager, Candidate]

  // REVIEW [2026-12-15] Seções exibidas na tela de detalhe.
  sections { summary; interviews; timeline }

  // REVIEW [2026-12-15] Ações disponíveis na tela de detalhe.
  actions {
    // REVIEW [2026-12-15] Coloca o candidato em triagem.
    screen -> Candidate.screen
    // REVIEW [2026-12-15] Agenda a entrevista do candidato.
    scheduleInterview -> Candidate.scheduleInterview
    // REVIEW [2026-12-15] Envia a proposta ao candidato.
    extendOffer -> Candidate.extendOffer
    // REVIEW [2026-12-15] Contrata o candidato.
    hire -> Candidate.hire
    // REVIEW [2026-12-15] Recusa o candidato, pedindo o motivo.
    reject -> Candidate.reject(reason)
  }
}
