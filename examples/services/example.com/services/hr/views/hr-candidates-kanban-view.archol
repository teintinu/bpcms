// REVIEW [2026-12-15] service: example.com/services/hr

// REVIEW [2026-12-15] Quadro kanban dos candidatos por situação.
view CandidatesKanban {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Quadro de candidatos", en: "Candidates board" }
  // REVIEW [2026-12-15] Tipo da view: quadro kanban.
  type: kanban
  // REVIEW [2026-12-15] Documento exibido no quadro.
  source: Candidate
  // REVIEW [2026-12-15] Papéis que podem abrir o quadro.
  roles: [Recruiter, HiringManager]
  // REVIEW [2026-12-15] Agrupa os cartões pela situação do candidato.
  groupBy: status

  // REVIEW [2026-12-15] Colunas exibidas em cada cartão.
  columns { name; position; department }
  // REVIEW [2026-12-15] Dados resumidos no cartão do kanban.
  card { name; position; appliedAt }

  // REVIEW [2026-12-15] Ações disponíveis no quadro.
  actions {
    // REVIEW [2026-12-15] Abre o detalhe do candidato.
    open -> CandidateDetail
  }
}
