// REVIEW [2026-12-15] service: example.com/services/hr

// REVIEW [2026-12-15] Painel de indicadores de pessoas.
view PeopleDashboard {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Painel de pessoas", en: "People dashboard" }
  // REVIEW [2026-12-15] Tipo da view: painel de indicadores.
  type: dashboard
  // REVIEW [2026-12-15] Documentos que alimentam os indicadores.
  sources: [Employee, Candidate, AccessGrant]
  // REVIEW [2026-12-15] Papéis que podem abrir o painel.
  roles: [PeopleOps, HiringManager]
  // REVIEW [2026-12-15] Atualização contínua dos dados exibidos.
  mode: live

  // REVIEW [2026-12-15] Filtros disponíveis no painel.
  filters { department; status; period }
  // REVIEW [2026-12-15] Indicadores calculados sobre os documentos.
  metrics {
    // REVIEW [2026-12-15] Colaboradores com situação ativa.
    headcount: count(Employee) where Employee.status == Active
    // REVIEW [2026-12-15] Colaboradores em integração.
    onboarding: count(Employee) where Employee.status == Onboarding
    // REVIEW [2026-12-15] Colaboradores em desligamento.
    offboarding: count(Employee) where Employee.status == Offboarding
    // REVIEW [2026-12-15] Candidatos ainda em processo, nem contratados nem recusados.
    openCandidates: count(Candidate) where Candidate.status != Hired and Candidate.status != Rejected
    // REVIEW [2026-12-15] Acessos solicitados e ainda não provisionados.
    pendingAccess: count(AccessGrant) where AccessGrant.status == Requested
  }
  // REVIEW [2026-12-15] Defasagem máxima aceita para os dados do painel.
  freshness: 15m
}
