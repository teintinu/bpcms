// REVIEW [2026-12-15] service: example.com/services/hr

// REVIEW [2026-12-15] Tabela de consulta dos pedidos de equipamento.
view EquipmentOrdersTable {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Equipamentos", en: "Equipment orders" }
  // REVIEW [2026-12-15] Tipo da view: tabela de documentos.
  type: table
  // REVIEW [2026-12-15] Documento exibido na tabela.
  source: EquipmentOrder
  // REVIEW [2026-12-15] Papéis que podem abrir a tabela.
  roles: [ITAdmin, PeopleOps]

  // REVIEW [2026-12-15] Colunas exibidas na tabela.
  columns { employee; kind; vendor; serial; status }
  // REVIEW [2026-12-15] Filtros disponíveis na tabela.
  filters { status; kind }

  // REVIEW [2026-12-15] Ações disponíveis sobre as linhas da tabela.
  actions {
    // REVIEW [2026-12-15] Registra a entrega do equipamento da linha, pedindo o número de série.
    deliver -> EquipmentOrder.deliver(serialNumber)
    // REVIEW [2026-12-15] Registra a devolução do equipamento da linha.
    returnItem -> EquipmentOrder.returnItem
  }
}
