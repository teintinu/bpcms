// service: example.com/services/hr

// Tabela de consulta dos pedidos de equipamento.
view EquipmentOrdersTable {
  // Título exibido na navegação.
  title: { pt-BR: "Equipamentos", en: "Equipment orders" }
  // Tipo da view: tabela de documentos.
  type: table
  // Documento exibido na tabela.
  source: EquipmentOrder
  // Papéis que podem abrir a tabela.
  roles: [ITAdmin, PeopleOps]

  // Colunas exibidas na tabela.
  columns { employee; kind; vendor; serial; status }
  // Filtros disponíveis na tabela.
  filters { status; kind }

  // Ações disponíveis sobre as linhas da tabela.
  actions {
    // Registra a entrega do equipamento da linha, pedindo o número de série.
    deliver -> EquipmentOrder.deliver(serialNumber)
    // Registra a devolução do equipamento da linha.
    returnItem -> EquipmentOrder.returnItem
  }
}
