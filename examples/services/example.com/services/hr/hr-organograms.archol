// REVIEW [2026-12-15] service: example.com/services/hr
// REVIEW [2026-12-15] Organograma do serviço e papéis com suas permissões.

// REVIEW [2026-12-15] Organograma das pessoas envolvidas nos processos de RH.
organogram People {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Organograma de pessoas", en: "People organogram" }

  // REVIEW [2026-12-15] Relações de subordinação entre os papéis.
  hierarchy {
    // REVIEW [2026-12-15] O gestor contratante chefia Pessoas e cultura, que chefia o recrutador.
    HiringManager > PeopleOps > Recruiter
    // REVIEW [2026-12-15] Pessoas e cultura chefia o administrador de TI.
    PeopleOps > ITAdmin
    // REVIEW [2026-12-15] O recrutador chefia o candidato.
    Recruiter > Candidate
    // REVIEW [2026-12-15] Pessoas e cultura chefia a nova contratação.
    PeopleOps > NewHire
  }

  // REVIEW [2026-12-15] Em ausência do gestor por cinco dias, Pessoas e cultura assume o papel.
  HiringManager delegates to PeopleOps when absent for 5d
}

// REVIEW [2026-12-15] Papel do recrutador no processo seletivo.
role Recruiter {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Recrutador", en: "Recruiter" }
  // REVIEW [2026-12-15] Permissões concedidas ao papel.
  permissions: [
    // REVIEW [2026-12-15] Consulta candidatos.
    candidate.view,
    // REVIEW [2026-12-15] Triagem de candidatos.
    candidate.screen,
    // REVIEW [2026-12-15] Agendamento de entrevistas.
    candidate.interview,
    // REVIEW [2026-12-15] Recusa de candidatos.
    candidate.reject
  ]
}

// REVIEW [2026-12-15] Papel do gestor que abre a vaga e acompanha a contratação.
role HiringManager {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Gestor contratante", en: "Hiring manager" }
  // REVIEW [2026-12-15] Permissões concedidas ao papel.
  permissions: [
    // REVIEW [2026-12-15] Consulta candidatos.
    candidate.view,
    // REVIEW [2026-12-15] Envio de proposta ao candidato.
    candidate.offer,
    // REVIEW [2026-12-15] Contratação do candidato.
    candidate.hire,
    // REVIEW [2026-12-15] Consulta colaboradores.
    employee.view,
    // REVIEW [2026-12-15] Registro do check-in do gestor.
    employee.checkin,
    // REVIEW [2026-12-15] Início do desligamento.
    employee.offboarding,
    // REVIEW [2026-12-15] Acesso aos relatórios.
    report.view
  ]
}

// REVIEW [2026-12-15] Papel de Pessoas e cultura, responsável pela operação de RH.
role PeopleOps {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Pessoas e cultura", en: "People operations" }
  // REVIEW [2026-12-15] Herda as permissões do recrutador.
  inherits: Recruiter
  // REVIEW [2026-12-15] Permissões concedidas ao papel.
  permissions: [
    // REVIEW [2026-12-15] Consulta colaboradores.
    employee.view,
    // REVIEW [2026-12-15] Registro de contratação.
    employee.hire,
    // REVIEW [2026-12-15] Desligamento do colaborador.
    employee.terminate,
    // REVIEW [2026-12-15] Gestão dos documentos do colaborador.
    employee.documents,
    // REVIEW [2026-12-15] Consulta de acessos.
    access.view,
    // REVIEW [2026-12-15] Consulta de equipamentos.
    equipment.view,
    // REVIEW [2026-12-15] Registro da entrevista de saída.
    exit.interview,
    // REVIEW [2026-12-15] Acesso aos relatórios.
    report.view
  ]
}

// REVIEW [2026-12-15] Papel do administrador de TI, responsável por acessos e equipamentos.
role ITAdmin {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Administrador de TI", en: "IT administrator" }
  // REVIEW [2026-12-15] Permissões concedidas ao papel.
  permissions: [
    // REVIEW [2026-12-15] Consulta de acessos.
    access.view,
    // REVIEW [2026-12-15] Provisionamento de acessos.
    access.provision,
    // REVIEW [2026-12-15] Revogação de acessos.
    access.revoke,
    // REVIEW [2026-12-15] Consulta de equipamentos.
    equipment.view,
    // REVIEW [2026-12-15] Entrega de equipamentos.
    equipment.deliver,
    // REVIEW [2026-12-15] Consulta colaboradores.
    employee.view
  ]
}

// REVIEW [2026-12-15] Papel do candidato que se inscreve em uma vaga.
role Candidate {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Candidato", en: "Candidate" }
  // REVIEW [2026-12-15] Permite ver os próprios dados e se candidatar.
  permissions: [candidate.viewOwn, candidate.apply]
}

// REVIEW [2026-12-15] Papel da pessoa recém-contratada durante a integração.
role NewHire {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Nova contratação", en: "New hire" }
  // REVIEW [2026-12-15] Permite ver os próprios dados, enviar documentos e confirmar acesso.
  permissions: [employee.viewOwn, employee.documents, employee.confirmAccess]
}
