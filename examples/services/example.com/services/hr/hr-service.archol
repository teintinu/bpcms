// REVIEW [2026-12-15] service: example.com/services/hr
// REVIEW [2026-12-15] Declara o serviço de Recursos Humanos; a URI é o escopo de todos os seus artefatos.
service "example.com/services/hr" {
  // REVIEW [2026-12-15] Título exibido no construtor e na navegação.
  title: { pt-BR: "Recursos humanos", en: "Human resources" }
  locales: [ "pt-BR", "en" ] // REVIEW [2026-12-18] Idiomas suportados pelo serviço; o primeiro é o default do I18N em forma de string.
  // REVIEW [2026-12-15] Versão do serviço usada em diff e release.
  // REVIEW [2026-12-15] Área responsável pela manutenção do serviço.
  owner: "People"

  // REVIEW [2026-12-15] Dependências externas expostas por alias neste arquivo.
  imports {
    // REVIEW [2026-12-15] Importa as medidas e constantes padrão do construtor.
    service "bpcms.org/std" as std
    // REVIEW [2026-12-15] Importa o serviço de identidade, dono de Identity.User.
    service "example.com/services/identity" as Identity
  }
}
