// service: example.com/services/hr
// Declara o serviço de Recursos Humanos; a URI é o escopo de todos os seus artefatos.
service "example.com/services/hr" {
  // Título exibido no construtor e na navegação.
  title: { pt-BR: "Recursos humanos", en: "Human resources" }
  // Versão do serviço usada em diff e release.
  version: 1.0.0
  // Área responsável pela manutenção do serviço.
  owner: "People"

  // Dependências externas expostas por alias neste arquivo.
  imports {
    // Importa as medidas e constantes padrão do construtor.
    service "bpcms.org/std" as std
    // Importa o serviço de identidade, dono de Identity.User.
    service "example.com/services/identity" as Identity
  }
}
