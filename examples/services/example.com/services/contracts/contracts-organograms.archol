// REVIEW [2026-12-15] service: example.com/services/contracts

// REVIEW [2026-12-15] Organograma do serviço: define hierarquia, gestão e quem tem poder de assinatura.
organogram Agreements {
  // REVIEW [2026-12-15] Título exibido na tela do organograma.
  title: { pt-BR: "Organograma de contratos", en: "Contracts organogram" }

  // REVIEW [2026-12-15] Relações de subordinação desenhadas na árvore do organograma.
  hierarchy {
    // REVIEW [2026-12-15] O gestor de contratos está acima do analista.
    ContractManager > ContractAnalyst
    // REVIEW [2026-12-15] O gestor de contratos está acima do advogado.
    ContractManager > LegalCounsel
  }


  // REVIEW [2026-12-15] Papéis com poder de assinatura no organograma.
  signature {
    // REVIEW [2026-12-15] O advogado é o assinante autorizado.
    LegalCounsel
  }
}

// REVIEW [2026-12-15] Papel que aprova, encerra e acompanha contratos.
role ContractManager {
  // REVIEW [2026-12-15] Título exibido na atribuição de tarefas e na inbox.
  title: { pt-BR: "Gestor de contratos", en: "Contract manager" }
  // REVIEW [2026-12-15] Permissões concedidas ao papel sobre contratos e relatórios.
  permissions: [contract.view, contract.approve, contract.terminate, report.view]
}

// REVIEW [2026-12-15] Papel que prepara e renova contratos.
role ContractAnalyst {
  // REVIEW [2026-12-15] Título exibido na atribuição de tarefas e na inbox.
  title: { pt-BR: "Analista de contratos", en: "Contract analyst" }
  // REVIEW [2026-12-15] Permissões de consulta, preparação e renovação.
  permissions: [contract.view, contract.prepare, contract.renew]
}

// REVIEW [2026-12-15] Papel jurídico que revisa e assina contratos.
role LegalCounsel {
  // REVIEW [2026-12-15] Título exibido na atribuição de tarefas e na inbox.
  title: { pt-BR: "Advogado", en: "Legal counsel" }
  // REVIEW [2026-12-15] Permissões de consulta, revisão e assinatura.
  permissions: [contract.view, contract.review, contract.sign]
}
