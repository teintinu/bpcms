// REVIEW [2026-12-15] service: example.com/services/contracts
// REVIEW [2026-12-15] Serviço: declara a URI canônica, os metadados e os imports do serviço de contratos.

// REVIEW [2026-12-15] Abre o serviço; a string é a URI que define o namespace de todos os artefatos.
service "example.com/services/contracts" {
  // REVIEW [2026-12-15] Título exibido no construtor e nos catálogos.
  title: { pt-BR: "Contratos", en: "Contracts" }
  version: 1.0.0 // REVIEW [2026-12-15] Versão do serviço; diff e release comparam.
  owner: "Contracts" // REVIEW [2026-12-15] Área responsável pela evolução do serviço.
  // REVIEW [2026-12-15] Serviços de outros contextos consumidos por este serviço.
  imports {
    // REVIEW [2026-12-15] Pseudo-serviço do construtor com medidas e constantes padrão (std.Money etc.).
    service "bpcms.org/std" as std
    // REVIEW [2026-12-15] Serviço de compras: fornece o tipo Supplier usado pelo contrato.
    service "example.com/services/procurement" as Procurement
  }
}
