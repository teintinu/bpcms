// REVIEW [2026-12-15] service: example.com/services/contracts
// REVIEW [2026-12-15] Process: sintaxe atual (DSL_REFERENCE.md §4)

// REVIEW [2026-12-15] Processo que coleta a assinatura do fornecedor e ativa o contrato.
process ContractSignature(contract: Contract) {
  // REVIEW [2026-12-15] Título exibido no construtor, na inbox e no histórico.
  title: { pt-BR: "Assinatura de contrato", en: "Contract signature" }
  version: 1 // REVIEW [2026-12-15] Versão do artefato Process; diff e release comparam.
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Coletar a assinatura do fornecedor no prazo e ativar o contrato"
  }
  sla: 10d // REVIEW [2026-12-15] SLA brando do caso: alvo de lead time, não é timer.

  // REVIEW [2026-12-15] Gatilho: inicia uma instância quando o contrato emite Submitted.
  on [Contract.Submitted]
  // REVIEW [2026-12-15] Chave de identidade, correlação e dedup da instância.
  key: contract // REVIEW [2026-12-15] o caso é o próprio contrato

  // REVIEW [2026-12-15] Bloco externo: captura timeout do caso e de qualquer form.
  try {
    // REVIEW [2026-12-15] Bloco interno: conduz a revisão jurídica do contrato.
    try {
      // REVIEW [2026-12-15] Abre o form de revisão para o jurídico decidir sobre o contrato.
      LegalReview.show({ contract })
    } catch (Timeout) {
      // REVIEW [2026-12-15] Revisão vencida: abre o form de cancelamento...
      CancelContract.show({ contract })
      // REVIEW [2026-12-15] ...e encerra o processo sem assinatura.
      return Declined
    }

    // REVIEW [2026-12-15] Se o contrato já foi encerrado durante a revisão...
    if (contract.status == Terminated) {
      // REVIEW [2026-12-15] ...encerra o processo no desfecho Declined.
      return Declined
    }

    // REVIEW [2026-12-15] Envia ao fornecedor a solicitação de assinatura.
    send SignatureRequest {
      // REVIEW [2026-12-15] Correlaciona a mensagem à instância pelo contrato.
      key: contract
      // REVIEW [2026-12-15] Preenche o payload da mensagem com dados do contrato.
      with {
        // REVIEW [2026-12-15] Número do contrato levado na mensagem.
        contractNumber: contract.number
        // REVIEW [2026-12-15] Data-limite para o fornecedor assinar.
        expiresAt: contract.endsAt
      }
    }

    // REVIEW [2026-12-15] Aguarda a confirmação da assinatura com prazo de cinco dias.
    try {
      // REVIEW [2026-12-15] Recebe a mensagem de assinatura confirmada.
      receive SignatureConfirmed {
        // REVIEW [2026-12-15] Correlaciona a resposta à instância pelo contrato.
        key: contract
        // REVIEW [2026-12-15] Tempo máximo de espera pela resposta.
        timeout: 5d
        // REVIEW [2026-12-15] Aplica a ação de assinatura no contrato ao receber.
        apply: Contract.sign
      }
    } catch (Timeout) {
      // REVIEW [2026-12-15] Sem resposta no prazo: abre o form de cancelamento...
      CancelContract.show({ contract })
      // REVIEW [2026-12-15] ...e encerra no desfecho Declined.
      return Declined
    }

    // REVIEW [2026-12-15] Assinatura confirmada: encerra no desfecho de sucesso.
    return Signed
  } catch (Timeout) {
    // REVIEW [2026-12-15] on breach do caso: expira a assinatura
    // REVIEW [2026-12-15] Abre o form para registrar o cancelamento do contrato.
    CancelContract.show({ contract })
    // REVIEW [2026-12-15] Encerra o processo sem assinatura.
    return Declined
  }

  // REVIEW [2026-12-15] Declara o desfecho de sucesso do caso.
  end Signed {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Contrato assinado", en: "Contract signed" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }

  // REVIEW [2026-12-15] Declara o desfecho de assinatura não concluída.
  end Declined {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Assinatura não concluída", en: "Signature not completed" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: cancelled
  }
}

// REVIEW [2026-12-15] Form de revisão jurídica: aprova ou cancela o contrato.
form LegalReview {
  // REVIEW [2026-12-15] Título exibido na tarefa do formulário.
  title: { pt-BR: "Revisão jurídica do contrato", en: "Contract legal review" }
  document: Contract // REVIEW [2026-12-15] Documento editado pelo formulário.
  roles: [LegalCounsel] // REVIEW [2026-12-15] Papel que recebe a tarefa.
  timeout: 3d // REVIEW [2026-12-15] Prazo para concluir o formulário.
  assign: pull // REVIEW [2026-12-15] Atribuição por retirada (pull) na inbox.

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    number { readonly } // REVIEW [2026-12-15] Número do contrato, apenas para leitura.
    endsAt { readonly } // REVIEW [2026-12-15] Término do contrato, apenas para leitura.
    cancellationReason // REVIEW [2026-12-15] Motivo do cancelamento, editável.
  }

  // REVIEW [2026-12-15] Botões de decisão do formulário.
  actions {
    approve { calls: Contract.clearLegal } // REVIEW [2026-12-15] Aprova, marcando a liberação jurídica.
    reject { calls: Contract.cancel(cancellationReason) } // REVIEW [2026-12-15] Rejeita, cancelando com o motivo.
  }
}

// REVIEW [2026-12-15] Form de cancelamento do contrato durante a assinatura.
form CancelContract {
  // REVIEW [2026-12-15] Título exibido na tarefa do formulário.
  title: { pt-BR: "Cancelar contrato", en: "Cancel contract" }
  document: Contract // REVIEW [2026-12-15] Documento editado pelo formulário.
  roles: [LegalCounsel] // REVIEW [2026-12-15] Papel que recebe a tarefa.
  timeout: 2d // REVIEW [2026-12-15] Prazo para concluir o formulário.
  assign: pull // REVIEW [2026-12-15] Atribuição por retirada (pull) na inbox.

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    number { readonly } // REVIEW [2026-12-15] Número do contrato, apenas para leitura.
    cancellationReason // REVIEW [2026-12-15] Motivo do cancelamento, editável.
  }

  // REVIEW [2026-12-15] Botões de decisão do formulário.
  actions {
    cancel { calls: Contract.cancel(cancellationReason) } // REVIEW [2026-12-15] Cancela o contrato com o motivo.
  }
}
