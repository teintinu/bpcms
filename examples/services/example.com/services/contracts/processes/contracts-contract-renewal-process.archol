// REVIEW [2026-12-15] service: example.com/services/contracts
// REVIEW [2026-12-15] Process: sintaxe atual (DSL_REFERENCE.md §4)

// REVIEW [2026-12-15] Processo que renova contratos ativos antes do vencimento.
process ContractRenewal(contract: Contract) {
  // REVIEW [2026-12-15] Título exibido no construtor, na inbox e no histórico.
  title: { pt-BR: "Renovação de contrato", en: "Contract renewal" }
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Renovar antes do vencimento, com proposta ao fornecedor e encerramento quando não houver acordo"
  }
  sla: "60d" // REVIEW [2026-12-15] SLA brando do caso: alvo de lead time, não é timer.

  schedule: "0 8 * * *" // REVIEW [2026-12-15] Executa a varredura diariamente às 8h.
  // REVIEW [2026-12-15] Seleciona os contratos ativos que vencem nos próximos sessenta dias.
  fanOut: Contract where status == Active and endsAt <= today() + 60d
  // REVIEW [2026-12-15] Chave de identidade, correlação e dedup da instância.
  key: contract // REVIEW [2026-12-15] o caso é o próprio contrato

  // REVIEW [2026-12-15] Bloco externo: captura timeout do caso e de qualquer form.
  try {
    // REVIEW [2026-12-15] Abre o form de decisão de renovação para o gestor.
    RenewalReview.show({ contract })
  } catch (Timeout) {
    // REVIEW [2026-12-15] escalada: a mesma decisão é reapresentada ao gestor
    RenewalReview.show({ contract })
  }

  // REVIEW [2026-12-15] Se o contrato foi encerrado enquanto isso...
  if (contract.status == Terminated) {
    // REVIEW [2026-12-15] ...encerra o processo no desfecho Cancelled.
    return Cancelled
  }

  // REVIEW [2026-12-15] Abre o form de termos da renovação para o analista.
  RenewalTerms.show({ contract })

  // REVIEW [2026-12-15] Envia ao fornecedor a proposta de renovação.
  send RenewalRequest {
    // REVIEW [2026-12-15] Correlaciona a mensagem à instância pelo contrato.
    key: contract
    // REVIEW [2026-12-15] Preenche o payload da mensagem com dados do contrato.
    with {
      // REVIEW [2026-12-15] Número do contrato levado na mensagem.
      contractNumber: contract.number
      // REVIEW [2026-12-15] Novo término proposto ao fornecedor.
      proposedEndsAt: contract.proposedEndsAt
      // REVIEW [2026-12-15] Data-limite para resposta à proposta.
      expiresAt: contract.endsAt
    }
  }

  // REVIEW [2026-12-15] Aguarda a confirmação da renovação com prazo de dez dias.
  try {
    // REVIEW [2026-12-15] Recebe a mensagem de renovação confirmada.
    receive RenewalConfirmed {
      // REVIEW [2026-12-15] Correlaciona a resposta à instância pelo contrato.
      key: contract
      // REVIEW [2026-12-15] Tempo máximo de espera pela resposta.
      timeout: 10d
      // REVIEW [2026-12-15] Aplica a ação de confirmação da renovação no contrato.
      apply: Contract.confirmRenewal
    }
  } catch (Timeout) {
    // REVIEW [2026-12-15] Sem acordo no prazo: abre o form para encerrar o contrato...
    TerminateContract.show({ contract })
    // REVIEW [2026-12-15] ...e encerra no desfecho Cancelled.
    return Cancelled
  }

  // REVIEW [2026-12-15] Renovação confirmada: encerra no desfecho de sucesso.
  return Renewed

  // REVIEW [2026-12-15] Declara o desfecho de sucesso do caso.
  end Renewed {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Contrato renovado", en: "Contract renewed" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }

  // REVIEW [2026-12-15] Declara o desfecho de renovação não concluída.
  end Cancelled {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Renovação cancelada", en: "Renewal cancelled" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: cancelled
  }
}

// REVIEW [2026-12-15] Form de encerramento do contrato quando não há acordo de renovação.
form TerminateContract {
  // REVIEW [2026-12-15] Título exibido na tarefa do formulário.
  title: { pt-BR: "Encerrar contrato", en: "Terminate contract" }
  document: Contract // REVIEW [2026-12-15] Documento editado pelo formulário.
  roles: [ContractManager] // REVIEW [2026-12-15] Papel que recebe a tarefa.
  timeout: 2d // REVIEW [2026-12-15] Prazo para concluir o formulário.
  assign: pull // REVIEW [2026-12-15] Atribuição por retirada (pull) na inbox.

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    number { readonly } // REVIEW [2026-12-15] Número do contrato, apenas para leitura.
    terminationReason // REVIEW [2026-12-15] Motivo do encerramento, editável.
  }

  // REVIEW [2026-12-15] Botões de decisão do formulário.
  actions {
    terminate { calls: Contract.terminate(terminationReason) } // REVIEW [2026-12-15] Encerra o contrato com o motivo.
  }
}

// REVIEW [2026-12-15] Form em que o gestor decide renovar ou encerrar o contrato.
form RenewalReview {
  // REVIEW [2026-12-15] Título exibido na tarefa do formulário.
  title: { pt-BR: "Decisão de renovação", en: "Renewal decision" }
  document: Contract // REVIEW [2026-12-15] Documento editado pelo formulário.
  roles: [ContractManager] // REVIEW [2026-12-15] Papel que recebe a tarefa.
  timeout: 5d // REVIEW [2026-12-15] Prazo para concluir o formulário.
  assign: pull // REVIEW [2026-12-15] Atribuição por retirada (pull) na inbox.

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    endsAt { readonly } // REVIEW [2026-12-15] Término atual, apenas para leitura.
    amount { readonly } // REVIEW [2026-12-15] Valor do contrato, apenas para leitura.
    terminationReason // REVIEW [2026-12-15] Motivo do encerramento, caso decline.
  }

  // REVIEW [2026-12-15] Botões de decisão do formulário.
  actions {
    renew { calls: Contract.markExpiring } // REVIEW [2026-12-15] Renova, marcando o contrato a vencer.
    decline { calls: Contract.terminate(terminationReason) } // REVIEW [2026-12-15] Declina, encerrando o contrato.
  }
}

// REVIEW [2026-12-15] Form em que o analista registra os termos da renovação.
form RenewalTerms {
  // REVIEW [2026-12-15] Título exibido na tarefa do formulário.
  title: { pt-BR: "Termos da renovação", en: "Renewal terms" }
  document: Contract // REVIEW [2026-12-15] Documento editado pelo formulário.
  roles: [ContractAnalyst] // REVIEW [2026-12-15] Papel que recebe a tarefa.
  timeout: 3d // REVIEW [2026-12-15] Prazo para concluir o formulário.
  assign: pull // REVIEW [2026-12-15] Atribuição por retirada (pull) na inbox.

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    endsAt { readonly } // REVIEW [2026-12-15] Término atual, apenas para leitura.
    proposedEndsAt // REVIEW [2026-12-15] Novo término proposto, editável.
  }

  // REVIEW [2026-12-15] Botões de decisão do formulário.
  actions {
    propose { calls: Contract.proposeRenewal(proposedEndsAt) } // REVIEW [2026-12-15] Registra a proposta de renovação.
  }
}
