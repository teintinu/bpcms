// REVIEW [2026-12-15] service: example.com/services/contracts

// REVIEW [2026-12-15] Documento raiz que representa o contrato firmado com um fornecedor.
document Contract {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Contrato", en: "Contract" }
  owner: "Contracts" // REVIEW [2026-12-15] Área responsável pelo documento.
  sync: read // REVIEW [2026-12-15] Expõe os dados em modo somente leitura a outros serviços.

  // REVIEW [2026-12-15] Campos que compõem o contrato.
  fields {
    // REVIEW [2026-12-15] Número do contrato; único, consultável e limitado a quarenta caracteres.
    number: string {
      // REVIEW [2026-12-15] Rótulo exibido no formulário.
      title: { pt-BR: "Número", en: "Number" }
      maxLength: 40 // REVIEW [2026-12-15] Limite de tamanho do código.
      unique // REVIEW [2026-12-15] Impede que dois contratos tenham o mesmo número.
      lookup // REVIEW [2026-12-15] Permite localizar o contrato pelo número.
    }
    // REVIEW [2026-12-15] Objeto do contrato; consultável e obrigatório.
    subject: string {
      // REVIEW [2026-12-15] Rótulo exibido no formulário.
      title: { pt-BR: "Objeto", en: "Subject" }
      maxLength: 240 // REVIEW [2026-12-15] Limite de tamanho do texto.
      lookup // REVIEW [2026-12-15] Permite localizar o contrato pelo objeto.
      required // REVIEW [2026-12-15] Exige preenchimento.
    }
    // REVIEW [2026-12-15] Tipo do contrato, usualmente escolhido entre as formas de ContractKind.
    kind: ContractKind {
      // REVIEW [2026-12-15] Rótulo exibido no formulário.
      title: { pt-BR: "Tipo", en: "Kind" }
      lookup // REVIEW [2026-12-15] Permite filtrar contratos pelo tipo.
    }
    // REVIEW [2026-12-15] Fornecedor do contrato, vindo do serviço de compras por alias.
    supplier: Procurement.Supplier {
      // REVIEW [2026-12-15] Rótulo exibido no formulário.
      title: { pt-BR: "Fornecedor", en: "Supplier" }
      lookup // REVIEW [2026-12-15] Permite localizar contratos por fornecedor.
    }
    // REVIEW [2026-12-15] Valor monetário do contrato no tipo padrão do construtor.
    amount: std.Money {
      // REVIEW [2026-12-15] Rótulo exibido no formulário.
      title: { pt-BR: "Valor", en: "Amount" }
      currency: BRL // REVIEW [2026-12-15] Moeda usada no campo.
      required // REVIEW [2026-12-15] Exige preenchimento.
    }
    // REVIEW [2026-12-15] Data de início da vigência do contrato.
    startsAt: Date {
      // REVIEW [2026-12-15] Rótulo exibido no formulário.
      title: { pt-BR: "Início", en: "Start date" }
      required // REVIEW [2026-12-15] Exige preenchimento.
    }
    // REVIEW [2026-12-15] Data de término da vigência do contrato.
    endsAt: Date {
      // REVIEW [2026-12-15] Rótulo exibido no formulário.
      title: { pt-BR: "Término", en: "End date" }
      required // REVIEW [2026-12-15] Exige preenchimento.
    }
    // REVIEW [2026-12-15] Situação atual do contrato, governada pela forma ContractStatus.
    status: ContractStatus {
      // REVIEW [2026-12-15] Rótulo exibido no formulário.
      title: { pt-BR: "Situação", en: "Status" }
      lookup // REVIEW [2026-12-15] Permite filtrar contratos pela situação.
    }
    // REVIEW [2026-12-15] Instante em que o contrato foi enviado para revisão.
    submittedAt: DateTime {
      // REVIEW [2026-12-15] Rótulo exibido no formulário.
      title: { pt-BR: "Enviado para revisão em", en: "Submitted for review at" }
    }
    // REVIEW [2026-12-15] Instante em que o jurídico liberou o contrato.
    legalClearedAt: DateTime {
      // REVIEW [2026-12-15] Rótulo exibido no formulário.
      title: { pt-BR: "Liberado pelo jurídico em", en: "Legal cleared at" }
    }
    // REVIEW [2026-12-15] Novo término proposto durante a negociação da renovação.
    proposedEndsAt: Date {
      // REVIEW [2026-12-15] Rótulo exibido no formulário.
      title: { pt-BR: "Término proposto", en: "Proposed end date" }
    }
    // REVIEW [2026-12-15] Instante em que o contrato foi assinado.
    signedAt: DateTime {
      // REVIEW [2026-12-15] Rótulo exibido no formulário.
      title: { pt-BR: "Assinado em", en: "Signed at" }
    }
    // REVIEW [2026-12-15] Identificador devolvido pelo provedor de assinatura.
    signatureId: string {
      // REVIEW [2026-12-15] Rótulo exibido no formulário.
      title: { pt-BR: "Identificador da assinatura", en: "Signature id" }
      maxLength: 80 // REVIEW [2026-12-15] Limite de tamanho do identificador.
    }
    // REVIEW [2026-12-15] Instante em que o contrato foi renovado.
    renewedAt: DateTime {
      // REVIEW [2026-12-15] Rótulo exibido no formulário.
      title: { pt-BR: "Renovado em", en: "Renewed at" }
    }
    // REVIEW [2026-12-15] Instante em que o contrato foi marcado como a vencer.
    markedAt: DateTime {
      // REVIEW [2026-12-15] Rótulo exibido no formulário.
      title: { pt-BR: "Marcado a vencer em", en: "Marked expiring at" }
    }
    // REVIEW [2026-12-15] Instante em que o contrato foi cancelado.
    cancelledAt: DateTime {
      // REVIEW [2026-12-15] Rótulo exibido no formulário.
      title: { pt-BR: "Cancelado em", en: "Cancelled at" }
    }
    // REVIEW [2026-12-15] Motivo informado no cancelamento.
    cancellationReason: string {
      // REVIEW [2026-12-15] Rótulo exibido no formulário.
      title: { pt-BR: "Motivo do cancelamento", en: "Cancellation reason" }
      maxLength: 280 // REVIEW [2026-12-15] Limite de tamanho do texto.
    }
    // REVIEW [2026-12-15] Instante em que o contrato foi encerrado.
    terminatedAt: DateTime {
      // REVIEW [2026-12-15] Rótulo exibido no formulário.
      title: { pt-BR: "Encerrado em", en: "Terminated at" }
    }
    // REVIEW [2026-12-15] Motivo informado no encerramento.
    terminationReason: string {
      // REVIEW [2026-12-15] Rótulo exibido no formulário.
      title: { pt-BR: "Motivo do encerramento", en: "Termination reason" }
      maxLength: 280 // REVIEW [2026-12-15] Limite de tamanho do texto.
    }
  }


  // REVIEW [2026-12-15] Ações de negócio que mudam o estado ou registram datas do contrato.
  actions {
    // REVIEW [2026-12-15] Envia o contrato para revisão, carimbando a data do envio.
    submit() {
      // REVIEW [2026-12-15] Rótulo do botão da ação.
      title: { pt-BR: "Enviar para revisão", en: "Submit for review" }
      roles: [ContractAnalyst] // REVIEW [2026-12-15] Único papel autorizado a enviar.
      to: status.InReview // REVIEW [2026-12-15] Move o contrato para Em revisão.
      // REVIEW [2026-12-15] Efeitos colaterais aplicados ao contrato na transição.
      {
        submittedAt = now() // REVIEW [2026-12-15] Registra o instante do envio.
      }
    }

    // REVIEW [2026-12-15] Marca a liberação jurídica sem mudar a situação do contrato.
    clearLegal() {
      // REVIEW [2026-12-15] Rótulo do botão da ação.
      title: { pt-BR: "Liberar pelo jurídico", en: "Clear by legal" }
      roles: [LegalCounsel] // REVIEW [2026-12-15] Somente o jurídico pode liberar.
      // REVIEW [2026-12-15] Efeitos colaterais aplicados ao contrato.
      {
        legalClearedAt = now() // REVIEW [2026-12-15] Registra o instante da liberação.
      }
    }

    // REVIEW [2026-12-15] Assina o contrato e o ativa; recebe os dados da assinatura.
    sign(signatureId: string, signedAt: DateTime) {
      // REVIEW [2026-12-15] Rótulo do botão da ação.
      title: { pt-BR: "Assinar contrato", en: "Sign contract" }
      roles: [LegalCounsel, ContractManager] // REVIEW [2026-12-15] Papéis que podem assinar.
      to: status.Active // REVIEW [2026-12-15] Ativa o contrato após a assinatura.
    }

    // REVIEW [2026-12-15] Marca o contrato como próximo do vencimento.
    markExpiring() {
      // REVIEW [2026-12-15] Rótulo do botão da ação.
      title: { pt-BR: "Marcar a vencer", en: "Mark expiring" }
      roles: [ContractManager] // REVIEW [2026-12-15] Somente o gestor pode marcar.
      to: status.Expiring // REVIEW [2026-12-15] Move o contrato para A vencer.
      // REVIEW [2026-12-15] Efeitos colaterais aplicados ao contrato na transição.
      {
        markedAt = now() // REVIEW [2026-12-15] Registra o instante da marcação.
      }
    }

    // REVIEW [2026-12-15] Registra a proposta de novo término, sem efetivar a renovação.
    proposeRenewal(proposedEndsAt: Date) {
      // REVIEW [2026-12-15] Rótulo do botão da ação.
      title: { pt-BR: "Propor renovação", en: "Propose renewal" }
      roles: [LegalCounsel, ContractAnalyst] // REVIEW [2026-12-15] Papéis que podem propor.
    }

    // REVIEW [2026-12-15] Confirma a renovação e estende a vigência até o término proposto.
    confirmRenewal(signedAt: DateTime) {
      // REVIEW [2026-12-15] Rótulo do botão da ação.
      title: { pt-BR: "Confirmar renovação", en: "Confirm renewal" }
      roles: [ContractManager] // REVIEW [2026-12-15] Somente o gestor confirma.
      to: status.Active // REVIEW [2026-12-15] Renovação devolve o contrato ao estado Ativo.
      // REVIEW [2026-12-15] Efeitos colaterais aplicados ao contrato na transição.
      {
        endsAt = proposedEndsAt // REVIEW [2026-12-15] Aplica o novo término acordado.
        renewedAt = signedAt // REVIEW [2026-12-15] Registra a data da assinatura da renovação.
      }
    }

    // REVIEW [2026-12-15] Encerra o contrato antecipadamente, registrando o motivo.
    terminate(terminationReason: string) {
      // REVIEW [2026-12-15] Rótulo do botão da ação.
      title: { pt-BR: "Encerrar contrato", en: "Terminate contract" }
      roles: [ContractManager] // REVIEW [2026-12-15] Somente o gestor pode encerrar.
      to: status.Terminated // REVIEW [2026-12-15] Move o contrato para Encerrado.
      emits { reason: terminationReason } // REVIEW [2026-12-15] Publica o motivo no evento.
      // REVIEW [2026-12-15] Efeitos colaterais aplicados ao contrato na transição.
      {
        terminatedAt = now() // REVIEW [2026-12-15] Registra o instante do encerramento.
      }
    }

    // REVIEW [2026-12-15] Cancela o contrato, registrando o motivo informado.
    cancel(cancellationReason: string) {
      // REVIEW [2026-12-15] Rótulo do botão da ação.
      title: { pt-BR: "Cancelar contrato", en: "Cancel contract" }
      roles: [ContractManager, LegalCounsel] // REVIEW [2026-12-15] Papéis que podem cancelar.
      to: status.Terminated // REVIEW [2026-12-15] O cancelamento também encerra o contrato.
      emits { reason: cancellationReason } // REVIEW [2026-12-15] Publica o motivo no evento.
      // REVIEW [2026-12-15] Efeitos colaterais aplicados ao contrato na transição.
      {
        cancelledAt = now() // REVIEW [2026-12-15] Registra o instante do cancelamento.
      }
    }
  }

  // REVIEW [2026-12-15] Índices que garantem unicidade e aceleram as consultas.
  indexes {
    // REVIEW [2026-12-15] Garante número único e serve de busca por número.
    byNumber: [number] unique
    // REVIEW [2026-12-15] Faixa para consultas por situação e data de término.
    byStatus: [status, endsAt] range
    // REVIEW [2026-12-15] Faixa para localizar contratos pela data de término.
    byEndsAt: [endsAt] range
    // REVIEW [2026-12-15] Hash para localizar contratos por fornecedor.
    bySupplier: [supplier.id] hash
  }

  // REVIEW [2026-12-15] Validação: o término precisa ser posterior ao início.
  rule endsAt > startsAt {
    // REVIEW [2026-12-15] Mensagem de erro exibida em português.
    pt-BR: "O término do contrato deve ser posterior ao início"
    // REVIEW [2026-12-15] Mensagem de erro exibida em inglês.
    en: "Contract end date must be after its start date"
  }

  // REVIEW [2026-12-15] Validação: o valor do contrato precisa ser positivo e em reais.
  rule amount > 0 BRL {
    // REVIEW [2026-12-15] Mensagem de erro exibida em português.
    pt-BR: "O contrato precisa ter valor positivo"
    // REVIEW [2026-12-15] Mensagem de erro exibida em inglês.
    en: "The contract must have a positive amount"
  }
}

// REVIEW [2026-12-15] Máquina de estados que governa o ciclo de vida do contrato.
shape ContractStatus {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Situação do contrato", en: "Contract status" }
  base: state // REVIEW [2026-12-15] Forma de estado: valores representam fases com transições.
  initial: Draft // REVIEW [2026-12-15] Situação inicial de todo contrato novo.
  // REVIEW [2026-12-15] Estado de elaboração: contrato ainda não enviado para revisão.
  value Draft {
    // REVIEW [2026-12-15] Título exibido no seletor de estado.
    title: { pt-BR: "Rascunho", en: "Draft" }
    icon: Draft // REVIEW [2026-12-15] Ícone usado para o estado.
    ordinal: 10 // REVIEW [2026-12-15] Posição do estado na linha do tempo.

    // REVIEW [2026-12-15] Transição para Em revisão, disparada no envio do contrato.
    transition InReview {
      event: Submitted // REVIEW [2026-12-15] Nome do evento emitido na transição.
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Contrato enviado para revisão", en: "Contract submitted for review" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Data em que o contrato foi enviado.
        submittedAt: DateTime { title: { pt-BR: "Enviado em", en: "Submitted at" } }
      }
    }

    // REVIEW [2026-12-15] Transição para Encerrado quando o rascunho é cancelado.
    transition Terminated {
      event: Cancelled // REVIEW [2026-12-15] Nome do evento emitido na transição.
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Contrato cancelado", en: "Contract cancelled" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Data em que o contrato foi cancelado.
        cancelledAt: DateTime { title: { pt-BR: "Cancelado em", en: "Cancelled at" } }
        // REVIEW [2026-12-15] Motivo informado no cancelamento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado de revisão: contrato aguardando liberação e assinatura.
  value InReview {
    // REVIEW [2026-12-15] Título exibido no seletor de estado.
    title: { pt-BR: "Em revisão", en: "In review" }
    icon: InReview // REVIEW [2026-12-15] Ícone usado para o estado.
    ordinal: 20 // REVIEW [2026-12-15] Posição do estado na linha do tempo.

    // REVIEW [2026-12-15] Transição para Ativo, disparada na assinatura do contrato.
    transition Active {
      event: Signed // REVIEW [2026-12-15] Nome do evento emitido na transição.
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Contrato assinado", en: "Contract signed" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Data em que o contrato foi assinado.
        signedAt: DateTime { title: { pt-BR: "Assinado em", en: "Signed at" } }
        // REVIEW [2026-12-15] Identificador da assinatura registrada.
        signatureId: string { title: { pt-BR: "Identificador da assinatura", en: "Signature id" } }
      }
    }

    // REVIEW [2026-12-15] Transição para Encerrado quando o contrato é cancelado na revisão.
    transition Terminated {
      event: Cancelled // REVIEW [2026-12-15] Nome do evento emitido na transição.
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Contrato cancelado", en: "Contract cancelled" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Data em que o contrato foi cancelado.
        cancelledAt: DateTime { title: { pt-BR: "Cancelado em", en: "Cancelled at" } }
        // REVIEW [2026-12-15] Motivo informado no cancelamento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado ativo: contrato em vigência e apto a renovação.
  value Active {
    // REVIEW [2026-12-15] Título exibido no seletor de estado.
    title: { pt-BR: "Ativo", en: "Active" }
    icon: Active // REVIEW [2026-12-15] Ícone usado para o estado.
    ordinal: 30 // REVIEW [2026-12-15] Posição do estado na linha do tempo.

    // REVIEW [2026-12-15] Transição para A vencer quando o gestor marca a proximidade do término.
    transition Expiring {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Contrato a vencer", en: "Contract expiring" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Data em que o contrato foi marcado a vencer.
        markedAt: DateTime { title: { pt-BR: "Marcado em", en: "Marked at" } }
      }
    }

    // REVIEW [2026-12-15] Transição para Encerrado quando o contrato é encerrado.
    transition Terminated {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Contrato encerrado", en: "Contract terminated" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Data em que o contrato foi encerrado.
        terminatedAt: DateTime { title: { pt-BR: "Encerrado em", en: "Terminated at" } }
        // REVIEW [2026-12-15] Motivo informado no encerramento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado a vencer: contrato próximo do término, em negociação.
  value Expiring {
    // REVIEW [2026-12-15] Título exibido no seletor de estado.
    title: { pt-BR: "A vencer", en: "Expiring" }
    icon: Expiring // REVIEW [2026-12-15] Ícone usado para o estado.
    ordinal: 40 // REVIEW [2026-12-15] Posição do estado na linha do tempo.

    // REVIEW [2026-12-15] Transição de volta a Ativo quando a renovação é confirmada.
    transition Active {
      event: Renewed // REVIEW [2026-12-15] Nome do evento emitido na transição.
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Contrato renovado", en: "Contract renewed" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Data da assinatura da renovação.
        signedAt: DateTime { title: { pt-BR: "Assinado em", en: "Signed at" } }
      }
    }

    // REVIEW [2026-12-15] Transição para Encerrado quando não há acordo de renovação.
    transition Terminated {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Contrato encerrado", en: "Contract terminated" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Data em que o contrato foi encerrado.
        terminatedAt: DateTime { title: { pt-BR: "Encerrado em", en: "Terminated at" } }
        // REVIEW [2026-12-15] Motivo informado no encerramento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado final: contrato encerrado ou cancelado.
  value Terminated {
    // REVIEW [2026-12-15] Título exibido no seletor de estado.
    title: { pt-BR: "Encerrado", en: "Terminated" }
    icon: Terminated // REVIEW [2026-12-15] Ícone usado para o estado.
    ordinal: 50 // REVIEW [2026-12-15] Posição do estado na linha do tempo.
  }
}

// REVIEW [2026-12-15] Classificação que distingue as naturezas de contrato.
shape ContractKind {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Tipo de contrato", en: "Contract kind" }
  base: classification // REVIEW [2026-12-15] Forma de classificação: apenas rótulos, sem transições.
  // REVIEW [2026-12-15] Contrato de fornecimento de bens.
  value Supply {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Fornecimento", en: "Supply" }
    icon: Supply // REVIEW [2026-12-15] Ícone usado para o valor.
    ordinal: 10 // REVIEW [2026-12-15] Ordem de exibição.
  }
  // REVIEW [2026-12-15] Contrato de prestação de serviços.
  value Service {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Serviço", en: "Service" }
    icon: Service // REVIEW [2026-12-15] Ícone usado para o valor.
    ordinal: 20 // REVIEW [2026-12-15] Ordem de exibição.
  }
  // REVIEW [2026-12-15] Contrato de licenciamento de software.
  value License {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Licença", en: "License" }
    icon: License // REVIEW [2026-12-15] Ícone usado para o valor.
    ordinal: 30 // REVIEW [2026-12-15] Ordem de exibição.
  }
}
