// REVIEW [2026-12-15] service: example.com/services/contracts

// REVIEW [2026-12-15] Documento que registra cada versão revisada de um contrato.
document ContractVersion {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Versão do contrato", en: "Contract version" }
  owner: "Contracts" // REVIEW [2026-12-15] Área responsável pelo documento.
  sync: read // REVIEW [2026-12-15] Expõe os dados em modo somente leitura a outros serviços.

  // REVIEW [2026-12-15] Campos que compõem a versão.
  fields {
    // REVIEW [2026-12-15] Contrato ao qual esta versão pertence.
    contract: Contract {
      // REVIEW [2026-12-15] Rótulo exibido no formulário.
      title: { pt-BR: "Contrato", en: "Contract" }
      lookup // REVIEW [2026-12-15] Permite localizar versões pelo contrato.
    }
    // REVIEW [2026-12-15] Número sequencial da versão dentro do contrato.
    versionNumber: std.Count {
      // REVIEW [2026-12-15] Rótulo exibido no formulário.
      title: { pt-BR: "Número da versão", en: "Version number" }
      required // REVIEW [2026-12-15] Exige preenchimento.
    }
    // REVIEW [2026-12-15] Situação atual da versão, governada pela forma ContractVersionStatus.
    status: ContractVersionStatus {
      // REVIEW [2026-12-15] Rótulo exibido no formulário.
      title: { pt-BR: "Situação", en: "Status" }
      lookup // REVIEW [2026-12-15] Permite filtrar versões pela situação.
    }
    // REVIEW [2026-12-15] Resumo legível das mudanças desta versão.
    summary: string {
      // REVIEW [2026-12-15] Rótulo exibido no formulário.
      title: { pt-BR: "Resumo das mudanças", en: "Change summary" }
      maxLength: 500 // REVIEW [2026-12-15] Limite de tamanho do resumo.
    }
    // REVIEW [2026-12-15] Instante em que a versão foi aprovada.
    approvedAt: DateTime {
      // REVIEW [2026-12-15] Rótulo exibido no formulário.
      title: { pt-BR: "Aprovada em", en: "Approved at" }
    }
    // REVIEW [2026-12-15] Instante em que a versão foi substituída por outra.
    supersededAt: DateTime {
      // REVIEW [2026-12-15] Rótulo exibido no formulário.
      title: { pt-BR: "Substituída em", en: "Superseded at" }
    }
  }


  // REVIEW [2026-12-15] Ações de negócio que mudam a situação da versão.
  actions {
    // REVIEW [2026-12-15] Aprova a versão, carimbando a data de aprovação.
    approve() {
      // REVIEW [2026-12-15] Rótulo do botão da ação.
      title: { pt-BR: "Aprovar versão", en: "Approve version" }
      roles: [LegalCounsel] // REVIEW [2026-12-15] Somente o jurídico aprova versões.
      to: status.Approved // REVIEW [2026-12-15] Move a versão para Aprovada.
      // REVIEW [2026-12-15] Efeitos colaterais aplicados à versão na transição.
      {
        approvedAt = now() // REVIEW [2026-12-15] Registra o instante da aprovação.
      }
    }

    // REVIEW [2026-12-15] Substitui a versão por uma mais nova, carimbando a data.
    supersede() {
      // REVIEW [2026-12-15] Rótulo do botão da ação.
      title: { pt-BR: "Substituir versão", en: "Supersede version" }
      roles: [ContractManager] // REVIEW [2026-12-15] Somente o gestor substitui versões.
      to: status.Superseded // REVIEW [2026-12-15] Move a versão para Substituída.
      // REVIEW [2026-12-15] Efeitos colaterais aplicados à versão na transição.
      {
        supersededAt = now() // REVIEW [2026-12-15] Registra o instante da substituição.
      }
    }
  }

  // REVIEW [2026-12-15] Índices que aceleram as consultas por contrato e situação.
  indexes {
    // REVIEW [2026-12-15] Faixa ordenada por contrato e número da versão.
    byContract: [contract.id, versionNumber] range
    // REVIEW [2026-12-15] Hash para localizar versões pela situação.
    byStatus: [status] hash
  }

  // REVIEW [2026-12-15] Validação: o número da versão precisa ser positivo.
  rule versionNumber > 0 {
    // REVIEW [2026-12-15] Mensagem de erro exibida em português.
    pt-BR: "O número da versão precisa ser positivo"
    // REVIEW [2026-12-15] Mensagem de erro exibida em inglês.
    en: "Version number must be positive"
  }
}

// REVIEW [2026-12-15] Máquina de estados que governa o ciclo de vida de uma versão.
shape ContractVersionStatus {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Situação da versão do contrato", en: "Contract version status" }
  base: state // REVIEW [2026-12-15] Forma de estado: valores representam fases com transições.
  initial: Draft // REVIEW [2026-12-15] Situação inicial de toda versão nova.
  // REVIEW [2026-12-15] Estado de elaboração: versão ainda não aprovada.
  value Draft {
    // REVIEW [2026-12-15] Título exibido no seletor de estado.
    title: { pt-BR: "Rascunho", en: "Draft" }
    icon: Draft // REVIEW [2026-12-15] Ícone usado para o estado.
    ordinal: 10 // REVIEW [2026-12-15] Posição do estado na linha do tempo.

    // REVIEW [2026-12-15] Transição para Aprovada, disparada na aprovação jurídica.
    transition Approved {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Versão aprovada", en: "Version approved" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Data em que a versão foi aprovada.
        approvedAt: DateTime { title: { pt-BR: "Aprovada em", en: "Approved at" } }
      }
    }

    // REVIEW [2026-12-15] Transição para Substituída quando uma versão nova assume.
    transition Superseded {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Versão substituída", en: "Version superseded" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Data em que a versão foi substituída.
        supersededAt: DateTime { title: { pt-BR: "Substituída em", en: "Superseded at" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado aprovado: versão validada pelo jurídico.
  value Approved {
    // REVIEW [2026-12-15] Título exibido no seletor de estado.
    title: { pt-BR: "Aprovada", en: "Approved" }
    icon: Approved // REVIEW [2026-12-15] Ícone usado para o estado.
    ordinal: 20 // REVIEW [2026-12-15] Posição do estado na linha do tempo.

    // REVIEW [2026-12-15] Transição para Substituída quando uma versão mais nova entra em vigor.
    transition Superseded {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Versão substituída", en: "Version superseded" }
      // REVIEW [2026-12-15] Dados carregados pelo evento da transição.
      payload {
        // REVIEW [2026-12-15] Data em que a versão foi substituída.
        supersededAt: DateTime { title: { pt-BR: "Substituída em", en: "Superseded at" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado final: versão que já foi trocada por outra.
  value Superseded {
    // REVIEW [2026-12-15] Título exibido no seletor de estado.
    title: { pt-BR: "Substituída", en: "Superseded" }
    icon: Superseded // REVIEW [2026-12-15] Ícone usado para o estado.
    ordinal: 30 // REVIEW [2026-12-15] Posição do estado na linha do tempo.
  }
}
