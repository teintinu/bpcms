// REVIEW [2026-12-15] service: example.com/services/contracts

// REVIEW [2026-12-15] Mensagem que confirma a assinatura do contrato.
message SignatureConfirmed {
  // REVIEW [2026-12-15] Título exibido na caixa de mensagens.
  title: { pt-BR: "Assinatura confirmada", en: "Signature confirmed" }
  about: Contract // REVIEW [2026-12-15] Documento ao qual a mensagem se refere.
  // REVIEW [2026-12-15] Dados transportados pela mensagem.
  payload {
    // REVIEW [2026-12-15] Identificador da assinatura registrada.
    signatureId: string { title: { pt-BR: "Identificador da assinatura", en: "Signature id" } }
    // REVIEW [2026-12-15] Data e hora da assinatura.
    signedAt: DateTime { title: { pt-BR: "Assinado em", en: "Signed at" } }
  }
}
