// REVIEW [2026-12-15] service: example.com/services/contracts

// REVIEW [2026-12-15] Calendário das datas de término para planejar renovações.
view RenewalCalendar {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Calendário de renovação", en: "Renewal calendar" }
  type: calendar // REVIEW [2026-12-15] Tipo do artefato: calendário.
  source: Contract // REVIEW [2026-12-15] Documento que alimenta o calendário.
  date: endsAt // REVIEW [2026-12-15] Campo usado para posicionar os itens no calendário.
  roles: [ContractManager, ContractAnalyst, LegalCounsel] // REVIEW [2026-12-15] Papéis autorizados.

  // REVIEW [2026-12-15] Filtros oferecidos na barra do calendário.
  filters { status; supplier }
  // REVIEW [2026-12-15] Ações disponíveis sobre o calendário.
  actions {
    open -> ContractDetail // REVIEW [2026-12-15] Abre o detalhe do contrato selecionado.
  }
}
