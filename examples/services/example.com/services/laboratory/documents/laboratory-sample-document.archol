// REVIEW [2026-12-15] service: example.com/services/laboratory

// REVIEW [2026-12-15] Documento que representa uma amostra biológica coletada.
document Sample {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Amostra", en: "Sample" }
  owner: "Laboratory" // REVIEW [2026-12-15] Dono de negócio do documento.
  sync: live // REVIEW [2026-12-15] Sincronização em tempo real entre cliente e servidor.
  // REVIEW [2026-12-15] Campos que compõem a amostra.
  fields {
    // REVIEW [2026-12-15] Código da amostra; único e consultável.
    code: SampleCode { title: { pt-BR: "Código", en: "Code" }, unique, lookup }
    // REVIEW [2026-12-15] Laboratório responsável pela amostra.
    laboratory: Laboratory {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Laboratório", en: "Laboratory" }
    }
    // REVIEW [2026-12-15] Origem da amostra; consultável para filtros.
    kind: SampleKind { title: { pt-BR: "Origem", en: "Origin" }, lookup }
    // REVIEW [2026-12-15] Paciente de quem a amostra foi coletada.
    patient: Citizen {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Paciente", en: "Patient" }
      // REVIEW [2026-12-15] Permite localizar amostras pelo paciente.
      lookup
    }
    // REVIEW [2026-12-15] Laboratório de apoio que forneceu ou recebeu a amostra.
    supportLab: SupportLab {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Laboratório de apoio", en: "Support laboratory" }
    }
    // REVIEW [2026-12-15] Lote de controle de qualidade ao qual a amostra pertence.
    controlLot: string { title: { pt-BR: "Lote de controle", en: "Control lot" } }
    // REVIEW [2026-12-15] Situação da amostra; consultável para filtros.
    status: SampleStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    // REVIEW [2026-12-15] Instante em que a amostra foi coletada.
    collectedAt: DateTime { title: { pt-BR: "Coletada em", en: "Collected at" } }
  }

  // REVIEW [2026-12-15] Índices secundários para consulta.
  indexes {
    // REVIEW [2026-12-15] Índice por situação e data de coleta, consultado por faixa.
    byStatus: [status, collectedAt] range
    // REVIEW [2026-12-15] Índice por paciente, consultado por igualdade.
    byPatient: [patient.id] hash
  }


  // REVIEW [2026-12-15] Ações que movimentam a amostra.
  actions {
    // REVIEW [2026-12-15] Action que registra a coleta da amostra.
    collect(){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Coletar", en: "Collect" }
      roles: [Collector] // REVIEW [2026-12-15] Papéis autorizados a coletar.
      // REVIEW [2026-12-15] Corpo da action: registra a data e emite o evento Collected.
      {
        // REVIEW [2026-12-15] Registra o instante da coleta.
        collectedAt = now()
        // REVIEW [2026-12-15] Emite o evento de amostra coletada.
        emit Collected
      }
    }

    // REVIEW [2026-12-15] Action que refaz a coleta de uma amostra rejeitada.
    recollect(){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Recoletar", en: "Recollect" }
      roles: [Collector] // REVIEW [2026-12-15] Papéis autorizados a recoletar.
      to: status.Collected // REVIEW [2026-12-15] Volta a amostra para o estado Collected.
      // REVIEW [2026-12-15] Corpo da action: atualiza a data da coleta.
      {
        // REVIEW [2026-12-15] Registra o novo instante da coleta.
        collectedAt = now()
      }
    }

    // REVIEW [2026-12-15] Action que registra o recebimento da amostra no laboratório.
    receive(){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Receber", en: "Receive" }
      roles: [Collector] // REVIEW [2026-12-15] Papéis autorizados a receber.
      to: status.Received // REVIEW [2026-12-15] Transição para o estado Received.
    }

    // REVIEW [2026-12-15] Action que rejeita a amostra com justificativa.
    reject(justification: string){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Rejeitar", en: "Reject" }
      roles: [Analyst] // REVIEW [2026-12-15] Papéis autorizados a rejeitar.
      to: status.Rejected // REVIEW [2026-12-15] Transição para o estado Rejected.
      // REVIEW [2026-12-15] Emite a transição levando o motivo da rejeição.
      emits { reason: justification }
      // REVIEW [2026-12-15] Exige justificativa com pelo menos dez caracteres.
      rule justification.length >= 10 {
        pt-BR: "Informe o motivo da rejeição" // REVIEW [2026-12-15] Mensagem do erro em português.
        en: "Enter the rejection reason" // REVIEW [2026-12-15] Mensagem do erro em inglês.
      }
    }

    // REVIEW [2026-12-15] Action que inicia o processamento da amostra.
    process(){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Processar", en: "Process" }
      roles: [Analyst] // REVIEW [2026-12-15] Papéis autorizados a processar.
      to: status.Processing // REVIEW [2026-12-15] Transição para o estado Processing.
    }

    // REVIEW [2026-12-15] Action que encaminha a amostra a um laboratório de apoio.
    refer(lab: SupportLab){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Encaminhar", en: "Refer" }
      roles: [SupportLiaison] // REVIEW [2026-12-15] Papéis autorizados a encaminhar.
      to: status.Referred // REVIEW [2026-12-15] Transição para o estado Referred.
      // REVIEW [2026-12-15] Emite a transição levando o laboratório de destino.
      emits { supportLab: lab }
    }

    // REVIEW [2026-12-15] Action que registra o resultado da amostra.
    result(){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Resultar", en: "Result" }
      roles: [Analyst] // REVIEW [2026-12-15] Papéis autorizados a resultar.
      to: status.Resulted // REVIEW [2026-12-15] Transição para o estado Resulted.
    }
  }

  // REVIEW [2026-12-15] Exige paciente quando a origem da amostra é Patient.
  rule kind == Patient implies patient != null {
    pt-BR: "Selecione o paciente" // REVIEW [2026-12-15] Mensagem do erro em português.
    en: "Select the patient" // REVIEW [2026-12-15] Mensagem do erro em inglês.

  }
  // REVIEW [2026-12-15] Exige laboratório de apoio quando a origem é Support.
  rule kind == Support implies supportLab != null {
    pt-BR: "Selecione o laboratório de apoio" // REVIEW [2026-12-15] Mensagem do erro em português.
    en: "Select the support lab" // REVIEW [2026-12-15] Mensagem do erro em inglês.

  }
  // REVIEW [2026-12-15] Exige lote de controle quando a origem é Control.
  rule kind == Control implies controlLot != null {
    pt-BR: "Informe o lote de controle" // REVIEW [2026-12-15] Mensagem do erro em português.
    en: "Enter the control lot" // REVIEW [2026-12-15] Mensagem do erro em inglês.

  }
}

// REVIEW [2026-12-15] Shape do código da amostra, com normalização para maiúsculas.
shape SampleCode {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Código da amostra", en: "Sample code" }
  base: string // REVIEW [2026-12-15] Tipo base: texto simples.
  normalize: upper-trim // REVIEW [2026-12-15] Normaliza removendo espaços e convertendo para maiúsculas.
  maxLength: 40 // REVIEW [2026-12-15] Limita o código a quarenta caracteres.
  format: plain // REVIEW [2026-12-15] Exibição sem máscara.
}

// REVIEW [2026-12-15] Shape de classificação com a origem da amostra.
shape SampleKind {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Origem da amostra", en: "Sample origin" }
  base: classification // REVIEW [2026-12-15] Tipo base: classificação fechada.
  // REVIEW [2026-12-15] Valor de origem "paciente".
  value Patient {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Paciente", en: "Patient" }
    icon: Patient // REVIEW [2026-12-15] Ícone associado ao valor.
    ordinal: 10 // REVIEW [2026-12-15] Ordem de exibição do valor.
  }
  // REVIEW [2026-12-15] Valor de origem "laboratório de apoio".
  value Support {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Laboratório de apoio", en: "Support laboratory" }
    icon: Support // REVIEW [2026-12-15] Ícone associado ao valor.
    ordinal: 20 // REVIEW [2026-12-15] Ordem de exibição do valor.
  }
  // REVIEW [2026-12-15] Valor de origem "controle".
  value Control {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Controle", en: "Control" }
    icon: Control // REVIEW [2026-12-15] Ícone associado ao valor.
    ordinal: 30 // REVIEW [2026-12-15] Ordem de exibição do valor.
  }
  format: plain // REVIEW [2026-12-15] Exibição sem máscara.
}

// REVIEW [2026-12-15] Shape de estado que acompanha o ciclo de vida da amostra.
shape SampleStatus {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Situação da amostra", en: "Sample status" }
  base: state // REVIEW [2026-12-15] Tipo base: máquina de estados.
  // REVIEW [2026-12-15] Estado inicial Collected, criado pela transição Collected.
  initial: Collected with transition Collected {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Amostra coletada", en: "Sample collected" }
  }
  // REVIEW [2026-12-15] Estado "coletada".
  value Collected {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Coletada", en: "Collected" }
    icon: Collected // REVIEW [2026-12-15] Ícone associado ao estado.
    ordinal: 10 // REVIEW [2026-12-15] Ordem de exibição do estado.

    // REVIEW [2026-12-15] Transição para o estado Received.
    transition Received {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Amostra recebida", en: "Sample received" }
    }

    // REVIEW [2026-12-15] Transição para o estado Rejected.
    transition Rejected {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Amostra rejeitada", en: "Sample rejected" }
      // REVIEW [2026-12-15] Dados levados pela transição.
      payload {
        // REVIEW [2026-12-15] Motivo da rejeição.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado "recebida".
  value Received {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Recebida", en: "Received" }
    icon: Received // REVIEW [2026-12-15] Ícone associado ao estado.
    ordinal: 20 // REVIEW [2026-12-15] Ordem de exibição do estado.

    // REVIEW [2026-12-15] Transição para o estado Rejected.
    transition Rejected {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Amostra rejeitada", en: "Sample rejected" }
      // REVIEW [2026-12-15] Dados levados pela transição.
      payload {
        // REVIEW [2026-12-15] Motivo da rejeição.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }

    // REVIEW [2026-12-15] Transição para o estado Processing.
    transition Processing {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Amostra em processamento", en: "Sample processing" }
    }

    // REVIEW [2026-12-15] Transição para o estado Referred.
    transition Referred {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Amostra encaminhada", en: "Sample referred" }
      // REVIEW [2026-12-15] Dados levados pela transição.
      payload {
        // REVIEW [2026-12-15] Laboratório de apoio de destino.
        supportLab: SupportLab { title: { pt-BR: "Laboratório de apoio", en: "Support laboratory" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado "em processamento".
  value Processing {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Em processamento", en: "Processing" }
    icon: Processing // REVIEW [2026-12-15] Ícone associado ao estado.
    ordinal: 30 // REVIEW [2026-12-15] Ordem de exibição do estado.

    // REVIEW [2026-12-15] Transição para o estado Resulted.
    transition Resulted {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Amostra resultada", en: "Sample resulted" }
    }
  }
  // REVIEW [2026-12-15] Estado "resultada".
  value Resulted {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Resultada", en: "Resulted" }
    icon: Resulted // REVIEW [2026-12-15] Ícone associado ao estado.
    ordinal: 40 // REVIEW [2026-12-15] Ordem de exibição do estado.
  }
  // REVIEW [2026-12-15] Estado "encaminhada".
  value Referred {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Encaminhada", en: "Referred" }
    icon: Referred // REVIEW [2026-12-15] Ícone associado ao estado.
    ordinal: 50 // REVIEW [2026-12-15] Ordem de exibição do estado.

    // REVIEW [2026-12-15] Transição para o estado Resulted.
    transition Resulted {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Amostra resultada", en: "Sample resulted" }
    }
  }
  // REVIEW [2026-12-15] Estado "rejeitada".
  value Rejected {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Rejeitada", en: "Rejected" }
    icon: Rejected // REVIEW [2026-12-15] Ícone associado ao estado.
    ordinal: 60 // REVIEW [2026-12-15] Ordem de exibição do estado.

    // REVIEW [2026-12-15] Transição de recoleta, disparada pelo evento Recollected.
    transition Collected {
      // REVIEW [2026-12-15] Evento que dispara a transição.
      event: Recollected
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Amostra recoletada", en: "Sample recollected" }
    }
  }
  format: plain // REVIEW [2026-12-15] Exibição sem máscara.
}
