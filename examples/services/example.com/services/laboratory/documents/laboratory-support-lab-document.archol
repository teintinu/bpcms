// REVIEW [2026-12-15] service: example.com/services/laboratory

// REVIEW [2026-12-15] Documento que representa um laboratório de apoio terceirizado.
document SupportLab {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Laboratório de apoio", en: "Support laboratory" }
  version: 1 // REVIEW [2026-12-15] Versão do artefato Document.
  owner: "Laboratory" // REVIEW [2026-12-15] Dono de negócio do documento.
  sync: live // REVIEW [2026-12-15] Sincronização em tempo real entre cliente e servidor.
  // REVIEW [2026-12-15] Campos que compõem o laboratório de apoio.
  fields {
    // REVIEW [2026-12-15] Nome do laboratório de apoio; consultável e obrigatório.
    name: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Nome", en: "Name" }
      // REVIEW [2026-12-15] Permite localizar o laboratório pelo nome.
      lookup
      // REVIEW [2026-12-15] Torna o nome obrigatório no preenchimento.
      required
    }
    // REVIEW [2026-12-15] Número de acreditação do laboratório de apoio.
    accreditation: string { title: { pt-BR: "Acreditação", en: "Accreditation" } }
    // REVIEW [2026-12-15] Indica se o laboratório está ativo; começa ativo.
    active: boolean { title: { pt-BR: "Ativo", en: "Active" }, default: true }
  }

  // REVIEW [2026-12-15] Ações que alteram o cadastro do laboratório de apoio.
  actions {
    // REVIEW [2026-12-15] Action que reativa o laboratório de apoio.
    activate(){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Ativar", en: "Activate" }
      roles: [LabManager] // REVIEW [2026-12-15] Papéis autorizados a ativar.
      // REVIEW [2026-12-15] Corpo da action: marca o laboratório como ativo.
      {
        // REVIEW [2026-12-15] Liga o indicador de laboratório ativo.
        active = true
      }
    }

    // REVIEW [2026-12-15] Action que desativa o laboratório de apoio.
    deactivate(){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Desativar", en: "Deactivate" }
      roles: [LabManager] // REVIEW [2026-12-15] Papéis autorizados a desativar.
      // REVIEW [2026-12-15] Corpo da action: marca o laboratório como inativo.
      {
        // REVIEW [2026-12-15] Desliga o indicador de laboratório ativo.
        active = false
      }
    }
  }
}
