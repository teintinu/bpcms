// REVIEW [2026-12-15] service: example.com/services/laboratory

// REVIEW [2026-12-15] Documento que representa o pedido de exame laboratorial.
document ExamOrder {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Pedido de exame", en: "Exam order" }
  sync: live // REVIEW [2026-12-15] Sincronização em tempo real entre cliente e servidor.
  // REVIEW [2026-12-15] Campos que compõem o pedido de exame.
  fields {
    // REVIEW [2026-12-15] Laboratório responsável pelo pedido.
    laboratory: Laboratory {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Laboratório", en: "Laboratory" }
    }
    // REVIEW [2026-12-15] Amostra associada ao pedido; consultável.
    sample: Sample {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Amostra", en: "Sample" }
      // REVIEW [2026-12-15] Permite localizar pedidos pela amostra.
      lookup
    }
    // REVIEW [2026-12-15] Exame solicitado; consultável para filtros.
    exam: ExamCode { title: { pt-BR: "Exame", en: "Exam" }, lookup }
    // REVIEW [2026-12-15] Situação do pedido; consultável para filtros.
    status: ExamOrderStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    // REVIEW [2026-12-15] Usuário responsável pela execução.
    assignedTo: User {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Responsável", en: "Assignee" }
    }
    // REVIEW [2026-12-15] Laboratório de apoio para onde o exame foi encaminhado.
    referredTo: SupportLab {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Encaminhado para", en: "Referred to" }
    }
    // REVIEW [2026-12-15] Instante em que o pedido foi solicitado.
    requestedAt: DateTime { title: { pt-BR: "Solicitado em", en: "Requested at" } }
    // REVIEW [2026-12-15] Instante em que o resultado foi emitido.
    resultedAt: DateTime { title: { pt-BR: "Resultado em", en: "Resulted at" } }
  }

  // REVIEW [2026-12-15] Índices secundários para consulta.
  indexes {
    // REVIEW [2026-12-15] Índice por situação e data de solicitação, consultado por faixa.
    byStatus: [status, requestedAt] range
    // REVIEW [2026-12-15] Índice por amostra, consultado por igualdade.
    bySample: [sample.id] hash
  }


  // REVIEW [2026-12-15] Ações que movimentam o pedido.
  actions {
    // REVIEW [2026-12-15] Action que abre o pedido para um exame e uma amostra.
    request(exam: ExamCode, sample: Sample){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Solicitar exame", en: "Request exam" }
      roles: [Collector] // REVIEW [2026-12-15] Papéis autorizados a solicitar.
      // REVIEW [2026-12-15] Corpo da action: registra a data e emite o evento Requested.
      {
        // REVIEW [2026-12-15] Registra o instante da solicitação.
        requestedAt = now()
        // REVIEW [2026-12-15] Emite o evento que dispara o processo de exame.
        emit Requested { exam }
      }
    }

    // REVIEW [2026-12-15] Action que registra a coleta do material.
    collect(){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Coletar", en: "Collect" }
      roles: [Collector] // REVIEW [2026-12-15] Papéis autorizados a coletar.
      to: status.Collected // REVIEW [2026-12-15] Transição automática para o estado Collected.
    }

    // REVIEW [2026-12-15] Action que inicia a análise do exame.
    process(){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Iniciar análise", en: "Start analysis" }
      roles: [Analyst] // REVIEW [2026-12-15] Papéis autorizados a iniciar a análise.
      to: status.Processing // REVIEW [2026-12-15] Transição automática para o estado Processing.
    }

    // REVIEW [2026-12-15] Action que encaminha o exame a um laboratório de apoio.
    refer(lab: SupportLab){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Encaminhar ao apoio", en: "Refer to support" }
      roles: [SupportLiaison] // REVIEW [2026-12-15] Papéis autorizados a encaminhar.
      to: status.Referred // REVIEW [2026-12-15] Transição automática para o estado Referred.
      // REVIEW [2026-12-15] Emite a transição levando o laboratório de destino.
      emits { supportLab: lab }
    }

    // REVIEW [2026-12-15] Action que registra o resultado no pedido.
    result(){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Resultar", en: "Result" }
      roles: [Analyst] // REVIEW [2026-12-15] Papéis autorizados a resultar.
      to: status.Resulted // REVIEW [2026-12-15] Transição automática para o estado Resulted.
      // REVIEW [2026-12-15] Corpo da action: grava a data do resultado.
      {
        // REVIEW [2026-12-15] Registra o instante em que o resultado foi emitido.
        resultedAt = now()
      }
    }

    // REVIEW [2026-12-15] Action que cancela o pedido com justificativa.
    cancel(justification: string){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Cancelar", en: "Cancel" }
      roles: [LabManager] // REVIEW [2026-12-15] Papéis autorizados a cancelar.
      to: status.Cancelled // REVIEW [2026-12-15] Transição automática para o estado Cancelled.
      // REVIEW [2026-12-15] Emite a transição levando o motivo do cancelamento.
      emits { reason: justification }
    }

    // REVIEW [2026-12-15] Action que atribui um responsável ao pedido.
    assign(user: User){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Atribuir", en: "Assign" }
      roles: [Pathologist] // REVIEW [2026-12-15] Papéis autorizados a atribuir.
      // REVIEW [2026-12-15] Corpo da action: grava o responsável escolhido.
      {
        // REVIEW [2026-12-15] Grava o usuário responsável pelo pedido.
        assignedTo = user
      }
    }
  }

  // REVIEW [2026-12-15] Exige data de resultado quando o pedido está Resulted.
  rule status == Resulted implies resultedAt != null {
    pt-BR: "Informe a data do resultado" // REVIEW [2026-12-15] Mensagem do erro em português.
    en: "Enter the result date" // REVIEW [2026-12-15] Mensagem do erro em inglês.

  }
  // REVIEW [2026-12-15] Exige laboratório de destino quando o pedido está Referred.
  rule status == Referred implies referredTo != null {
    pt-BR: "Selecione o laboratório de destino" // REVIEW [2026-12-15] Mensagem do erro em português.
    en: "Select the destination lab" // REVIEW [2026-12-15] Mensagem do erro em inglês.

  }
}

// REVIEW [2026-12-15] Shape de classificação com os exames disponíveis.
shape ExamCode {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Exame", en: "Exam" }
  base: classification // REVIEW [2026-12-15] Tipo base: classificação fechada.
  // REVIEW [2026-12-15] Valor do exame "hemograma".
  value Hemogram {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Hemograma", en: "Complete blood count" }
    icon: Hemogram // REVIEW [2026-12-15] Ícone associado ao valor.
    ordinal: 10 // REVIEW [2026-12-15] Ordem de exibição do valor.
  }
  // REVIEW [2026-12-15] Valor do exame "glicemia".
  value Glucose {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Glicemia", en: "Glucose" }
    icon: Glucose // REVIEW [2026-12-15] Ícone associado ao valor.
    ordinal: 20 // REVIEW [2026-12-15] Ordem de exibição do valor.
  }
  // REVIEW [2026-12-15] Valor do exame "cultura".
  value Culture {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Cultura", en: "Culture" }
    icon: Culture // REVIEW [2026-12-15] Ícone associado ao valor.
    ordinal: 30 // REVIEW [2026-12-15] Ordem de exibição do valor.
  }
  // REVIEW [2026-12-15] Valor do exame "hemoglobina glicada".
  value Hba1c {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Hemoglobina glicada", en: "HbA1c" }
    icon: Hba1c // REVIEW [2026-12-15] Ícone associado ao valor.
    ordinal: 40 // REVIEW [2026-12-15] Ordem de exibição do valor.
  }
  format: plain // REVIEW [2026-12-15] Exibição sem máscara.
}

// REVIEW [2026-12-15] Shape de estado que acompanha o ciclo de vida do pedido.
shape ExamOrderStatus {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Situação do exame", en: "Exam order status" }
  base: state // REVIEW [2026-12-15] Tipo base: máquina de estados.
  // REVIEW [2026-12-15] Estado inicial Requested, criado pela transição Requested.
  initial: Requested with transition Requested {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Exame solicitado", en: "Exam requested" }
    // REVIEW [2026-12-15] Dados levados pela transição inicial.
    payload {
      exam: ExamCode { title: { pt-BR: "Exame", en: "Exam" } } // REVIEW [2026-12-15] Exame que foi solicitado.
    }
  }
  // REVIEW [2026-12-15] Estado "solicitado".
  value Requested {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Solicitado", en: "Requested" }
    icon: Requested // REVIEW [2026-12-15] Ícone associado ao estado.
    ordinal: 10 // REVIEW [2026-12-15] Ordem de exibição do estado.

    // REVIEW [2026-12-15] Transição para o estado Collected.
    transition Collected {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Exame coletado", en: "Exam collected" }
    }

    // REVIEW [2026-12-15] Transição para o estado Cancelled.
    transition Cancelled {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Exame cancelado", en: "Exam cancelled" }
      // REVIEW [2026-12-15] Dados levados pela transição.
      payload {
        // REVIEW [2026-12-15] Motivo do cancelamento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado "coletado".
  value Collected {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Coletado", en: "Collected" }
    icon: Collected // REVIEW [2026-12-15] Ícone associado ao estado.
    ordinal: 20 // REVIEW [2026-12-15] Ordem de exibição do estado.

    // REVIEW [2026-12-15] Transição para o estado Processing.
    transition Processing {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Exame em processamento", en: "Exam processing" }
    }

    // REVIEW [2026-12-15] Transição para o estado Referred.
    transition Referred {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Exame encaminhado", en: "Exam referred" }
      // REVIEW [2026-12-15] Dados levados pela transição.
      payload {
        // REVIEW [2026-12-15] Laboratório de apoio de destino.
        supportLab: SupportLab { title: { pt-BR: "Laboratório de apoio", en: "Support laboratory" } }
      }
    }

    // REVIEW [2026-12-15] Transição para o estado Cancelled.
    transition Cancelled {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Exame cancelado", en: "Exam cancelled" }
      // REVIEW [2026-12-15] Dados levados pela transição.
      payload {
        // REVIEW [2026-12-15] Motivo do cancelamento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado "em processamento".
  value Processing {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Em processamento", en: "Processing" }
    icon: Processing // REVIEW [2026-12-15] Ícone associado ao estado.
    ordinal: 30 // REVIEW [2026-12-15] Ordem de exibição do estado.

    // REVIEW [2026-12-15] Transição para o estado Referred.
    transition Referred {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Exame encaminhado", en: "Exam referred" }
      // REVIEW [2026-12-15] Dados levados pela transição.
      payload {
        // REVIEW [2026-12-15] Laboratório de apoio de destino.
        supportLab: SupportLab { title: { pt-BR: "Laboratório de apoio", en: "Support laboratory" } }
      }
    }

    // REVIEW [2026-12-15] Transição para o estado Resulted.
    transition Resulted {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Resultado emitido", en: "Result issued" }
    }

    // REVIEW [2026-12-15] Transição para o estado Cancelled.
    transition Cancelled {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Exame cancelado", en: "Exam cancelled" }
      // REVIEW [2026-12-15] Dados levados pela transição.
      payload {
        // REVIEW [2026-12-15] Motivo do cancelamento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado "resultado emitido".
  value Resulted {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Resultado emitido", en: "Resulted" }
    icon: Resulted // REVIEW [2026-12-15] Ícone associado ao estado.
    ordinal: 40 // REVIEW [2026-12-15] Ordem de exibição do estado.
  }
  // REVIEW [2026-12-15] Estado "encaminhado ao apoio".
  value Referred {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Encaminhado ao apoio", en: "Referred to support" }
    icon: Referred // REVIEW [2026-12-15] Ícone associado ao estado.
    ordinal: 50 // REVIEW [2026-12-15] Ordem de exibição do estado.

    // REVIEW [2026-12-15] Transição para o estado Resulted.
    transition Resulted {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Resultado emitido", en: "Result issued" }
    }

    // REVIEW [2026-12-15] Transição para o estado Cancelled.
    transition Cancelled {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Exame cancelado", en: "Exam cancelled" }
      // REVIEW [2026-12-15] Dados levados pela transição.
      payload {
        // REVIEW [2026-12-15] Motivo do cancelamento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado "cancelado".
  value Cancelled {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Cancelado", en: "Cancelled" }
    icon: Cancelled // REVIEW [2026-12-15] Ícone associado ao estado.
    ordinal: 60 // REVIEW [2026-12-15] Ordem de exibição do estado.
  }
  format: plain // REVIEW [2026-12-15] Exibição sem máscara.
}
