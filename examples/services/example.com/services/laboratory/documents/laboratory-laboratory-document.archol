// REVIEW [2026-12-15] service: example.com/services/laboratory

// REVIEW [2026-12-15] Documento com escopo por instância que representa um laboratório.
scopable document Laboratory {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Laboratório", en: "Laboratory" }
  // REVIEW [2026-12-15] Campos que compõem o laboratório.
  fields {
    // REVIEW [2026-12-15] Código identificador do laboratório; único e consultável.
    code: string { title: { pt-BR: "Código", en: "Code" }, unique, lookup }
    // REVIEW [2026-12-15] Nome legível do laboratório, consultável por busca.
    name: string { title: { pt-BR: "Nome", en: "Name" }, lookup }
  }
}
