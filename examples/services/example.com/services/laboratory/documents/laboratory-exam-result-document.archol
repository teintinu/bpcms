// REVIEW [2026-12-15] service: example.com/services/laboratory

// REVIEW [2026-12-15] Documento que representa o resultado de um exame laboratorial.
document ExamResult {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Resultado de exame", en: "Exam result" }
  owner: "Laboratory" // REVIEW [2026-12-15] Dono de negócio do documento.
  sync: live // REVIEW [2026-12-15] Sincronização em tempo real entre cliente e servidor.
  // REVIEW [2026-12-15] Campos que compõem o resultado.
  fields {
    // REVIEW [2026-12-15] Laboratório responsável pelo resultado.
    laboratory: Laboratory {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Laboratório", en: "Laboratory" }
    }
    // REVIEW [2026-12-15] Pedido de exame de origem; consultável.
    examOrder: ExamOrder {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Pedido", en: "Exam order" }
      // REVIEW [2026-12-15] Permite localizar resultados pelo pedido.
      lookup
    }
    // REVIEW [2026-12-15] Amostra analisada; consultável.
    sample: Sample {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Amostra", en: "Sample" }
      // REVIEW [2026-12-15] Permite localizar resultados pela amostra.
      lookup
    }
    value: string { title: { pt-BR: "Valor", en: "Value" } } // REVIEW [2026-12-15] Valor medido na análise.
    unit: string { title: { pt-BR: "Unidade", en: "Unit" } } // REVIEW [2026-12-15] Unidade de medida do valor.
    // REVIEW [2026-12-15] Marca se o resultado é crítico.
    critical: boolean { title: { pt-BR: "Resultado crítico", en: "Critical result" } }
    // REVIEW [2026-12-15] Situação do resultado; consultável para filtros.
    status: ExamResultStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    // REVIEW [2026-12-15] Instante em que o resultado foi validado.
    validatedAt: DateTime { title: { pt-BR: "Validado em", en: "Validated at" } }
    // REVIEW [2026-12-15] Instante em que o resultado foi assinado.
    signedAt: DateTime { title: { pt-BR: "Assinado em", en: "Signed at" } }
    // REVIEW [2026-12-15] Instante em que o resultado foi liberado.
    releasedAt: DateTime { title: { pt-BR: "Liberado em", en: "Released at" } }
  }

  // REVIEW [2026-12-15] Índices secundários para consulta.
  indexes {
    // REVIEW [2026-12-15] Índice por pedido de exame, consultado por igualdade.
    byOrder: [examOrder.id] hash
    // REVIEW [2026-12-15] Índice por situação e data de liberação, consultado por faixa.
    byStatus: [status, releasedAt] range
  }


  // REVIEW [2026-12-15] Ações que movimentam o resultado.
  actions {
    // REVIEW [2026-12-15] Action que registra a leitura do analisador no resultado.
    record(order: ExamOrder, sampleRef: Sample, measured: string, measUnit: string, isCritical: boolean){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Registrar leitura", en: "Record reading" }
      roles: [Analyst] // REVIEW [2026-12-15] Papéis autorizados a registrar a leitura.
      returns: ExamResult // REVIEW [2026-12-15] Devolve o resultado criado ao chamador.
      // REVIEW [2026-12-15] Corpo da action: grava os dados medidos.
      {
        // REVIEW [2026-12-15] Vincula o resultado ao pedido de exame.
        examOrder = order
        // REVIEW [2026-12-15] Vincula o resultado à amostra analisada.
        sample = sampleRef
        // REVIEW [2026-12-15] Grava o valor medido.
        value = measured
        // REVIEW [2026-12-15] Grava a unidade de medida.
        unit = measUnit
        // REVIEW [2026-12-15] Grava a marca de resultado crítico.
        critical = isCritical
      }
    }

    // REVIEW [2026-12-15] Action que valida o resultado.
    validate(){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Validar", en: "Validate" }
      roles: [Analyst] // REVIEW [2026-12-15] Papéis autorizados a validar.
      to: status.Validated // REVIEW [2026-12-15] Transição para o estado Validated.
      // REVIEW [2026-12-15] Corpo da action: grava a data de validação.
      {
        // REVIEW [2026-12-15] Registra o instante da validação.
        validatedAt = now()
      }
    }

    // REVIEW [2026-12-15] Action que assina o resultado.
    sign(){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Assinar", en: "Sign" }
      roles: [Pathologist] // REVIEW [2026-12-15] Papéis autorizados a assinar.
      to: status.Signed // REVIEW [2026-12-15] Transição para o estado Signed.
      // REVIEW [2026-12-15] Corpo da action: grava a data de assinatura.
      {
        // REVIEW [2026-12-15] Registra o instante da assinatura.
        signedAt = now()
      }
    }

    // REVIEW [2026-12-15] Action que libera o resultado ao solicitante.
    release(){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Liberar", en: "Release" }
      roles: [Pathologist] // REVIEW [2026-12-15] Papéis autorizados a liberar.
      to: status.Released // REVIEW [2026-12-15] Transição para o estado Released.
      // REVIEW [2026-12-15] Corpo da action: grava a data de liberação.
      {
        // REVIEW [2026-12-15] Registra o instante da liberação.
        releasedAt = now()
      }
    }
  }

  // REVIEW [2026-12-15] Exige data de liberação quando o resultado está Released.
  rule status == Released implies releasedAt != null {
    pt-BR: "Informe a data de liberação" // REVIEW [2026-12-15] Mensagem do erro em português.
    en: "Enter the release date" // REVIEW [2026-12-15] Mensagem do erro em inglês.

  }

  // REVIEW [2026-12-15] Assinatura exigida para liberar o resultado.
  signature {
    // REVIEW [2026-12-15] Papel que assina a liberação.
    release: Pathologist
  }
}

// REVIEW [2026-12-15] Shape de estado que acompanha o ciclo de vida do resultado.
shape ExamResultStatus {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Situação do resultado", en: "Exam result status" }
  base: state // REVIEW [2026-12-15] Tipo base: máquina de estados.
  // REVIEW [2026-12-15] Estado inicial do resultado.
  initial: Draft
  // REVIEW [2026-12-15] Estado "registrado".
  value Draft {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Registrado", en: "Recorded" }
    icon: Draft // REVIEW [2026-12-15] Ícone associado ao estado.
    ordinal: 10 // REVIEW [2026-12-15] Ordem de exibição do estado.

    // REVIEW [2026-12-15] Transição para o estado Validated.
    transition Validated {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Resultado validado", en: "Result validated" }
    }
  }
  // REVIEW [2026-12-15] Estado "validado".
  value Validated {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Validado", en: "Validated" }
    icon: Validated // REVIEW [2026-12-15] Ícone associado ao estado.
    ordinal: 20 // REVIEW [2026-12-15] Ordem de exibição do estado.

    // REVIEW [2026-12-15] Transição para o estado Signed.
    transition Signed {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Resultado assinado", en: "Result signed" }
    }
  }
  // REVIEW [2026-12-15] Estado "assinado".
  value Signed {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Assinado", en: "Signed" }
    icon: Signed // REVIEW [2026-12-15] Ícone associado ao estado.
    ordinal: 30 // REVIEW [2026-12-15] Ordem de exibição do estado.

    // REVIEW [2026-12-15] Transição para o estado Released.
    transition Released {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Resultado liberado", en: "Result released" }
      // REVIEW [2026-12-15] Dados levados pela transição.
      payload {
        value: string { title: { pt-BR: "Valor", en: "Value" } } // REVIEW [2026-12-15] Valor liberado do resultado.
        unit: string { title: { pt-BR: "Unidade", en: "Unit" } } // REVIEW [2026-12-15] Unidade de medida do valor liberado.
      }
    }
  }
  // REVIEW [2026-12-15] Estado "liberado".
  value Released {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Liberado", en: "Released" }
    icon: Released // REVIEW [2026-12-15] Ícone associado ao estado.
    ordinal: 40 // REVIEW [2026-12-15] Ordem de exibição do estado.
  }
  format: plain // REVIEW [2026-12-15] Exibição sem máscara.
}
