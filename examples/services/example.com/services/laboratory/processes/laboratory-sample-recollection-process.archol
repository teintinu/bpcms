// REVIEW [2026-12-15] service: example.com/services/laboratory
// REVIEW [2026-12-15] Process: sintaxe atual (DSL_REFERENCE.md §4)

// REVIEW [2026-12-15] Declara o processo de recoleta; o argumento é a amostra-sujeito da instância.
process SampleRecollection(sample: Sample) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Recoleta de amostra", en: "Sample recollection" }
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    pt-BR: "Recoletar a amostra rejeitada e liberá-la para análise" // REVIEW [2026-12-15] Texto do objetivo em português.
  }
  sla: "3d" // REVIEW [2026-12-15] SLA brando do caso: alvo de lead time, não é timer.

  // REVIEW [2026-12-15] Gatilho: inicia uma instância quando a amostra é rejeitada.
  on [Sample.Rejected]
  key: sample // REVIEW [2026-12-15] Chave de identidade, correlação e dedup da instância.

  // REVIEW [2026-12-15] Envia o pedido de recoleta ao coletador responsável.
  send RecollectionRequest {
    key: sample // REVIEW [2026-12-15] Correlaciona a mensagem à amostra.
    // REVIEW [2026-12-15] Dados levados pela mensagem.
    with {
      code: sample.code // REVIEW [2026-12-15] Código da amostra a recoletar.
      // REVIEW [2026-12-15] Instante em que a recoleta foi solicitada.
      requestedAt: now()
    }
  }

  // REVIEW [2026-12-15] Laço de tentativas de recoleta, limitado a duas iterações.
  loop RecollectionAttempt max 2 {
    // REVIEW [2026-12-15] Bloco interno: tenta abrir o form de recoleta.
    try {
      // REVIEW [2026-12-15] Abre o form de recoleta para a amostra em pauta.
      Recollection.show({ sample })
      // REVIEW [2026-12-15] Sai do laço quando o form conclui a recoleta.
      break
    } catch (Timeout) {
      // REVIEW [2026-12-15] Recoleta estourou o prazo: aciona o form manual de escalonamento.
      EscalateRecollection.show({ sample })
    }
  }

  // REVIEW [2026-12-15] Registra o recebimento da amostra recoletada.
  Sample.receive()
  // REVIEW [2026-12-15] Inicia o processamento da amostra recoletada.
  Sample.process()

  // REVIEW [2026-12-15] Encerra no desfecho de sucesso.
  return Recollected

  // REVIEW [2026-12-15] Declara o desfecho de sucesso do caso.
  end Recollected {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Amostra recoletada", en: "Sample recollected" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }
}

// REVIEW [2026-12-15] Form de recoleta da amostra rejeitada.
form Recollection {
  // REVIEW [2026-12-15] Título exibido na inbox do form.
  title: { pt-BR: "Recoleta da amostra", en: "Sample recollection" }
  document: Sample // REVIEW [2026-12-15] Documento manipulado pelo form.
  roles: [Collector] // REVIEW [2026-12-15] Papéis que podem executar o form.
  timeout: 2d // REVIEW [2026-12-15] Prazo para conclusão antes de estourar timeout.
  assign: pull // REVIEW [2026-12-15] Distribuição por puxada manual pelo executor.

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Código da amostra.
    code
    // REVIEW [2026-12-15] Origem da amostra.
    kind
    // REVIEW [2026-12-15] Paciente de quem a amostra foi coletada.
    patient
  }

  // REVIEW [2026-12-15] Ações disponíveis no formulário.
  actions {
    // REVIEW [2026-12-15] Conclui a recoleta chamando a action do documento.
    recollect { calls: Sample.recollect }
  }
}

// REVIEW [2026-12-15] Form manual de escalonamento quando a recoleta atrasa.
manual EscalateRecollection {
  // REVIEW [2026-12-15] Título exibido na inbox do form.
  title: { pt-BR: "Escalonar a recoleta", en: "Escalate recollection" }
  document: Sample // REVIEW [2026-12-15] Documento manipulado pelo form.
  roles: [Collector] // REVIEW [2026-12-15] Papéis que podem executar o form.
  instructions: "Contatar o paciente e reagendar a coleta" // REVIEW [2026-12-15] Orientação exibida ao executor.
  timeout: 1d // REVIEW [2026-12-15] Prazo para conclusão antes de estourar timeout.
  assign: pull // REVIEW [2026-12-15] Distribuição por puxada manual pelo executor.
}
