// REVIEW [2026-12-15] service: example.com/services/laboratory
// REVIEW [2026-12-15] Process: sintaxe atual (DSL_REFERENCE.md §4)

// REVIEW [2026-12-15] Declara o processo de exame; o argumento é o pedido-sujeito da instância.
process LabExam(examOrder: ExamOrder) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Exame laboratorial", en: "Laboratory exam" }
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Coletar, analisar, validar, assinar e liberar o resultado no prazo"
  }
  sla: 8h // REVIEW [2026-12-15] SLA brando do caso: alvo de lead time, não é timer.

  // REVIEW [2026-12-15] Gatilho: inicia uma instância quando o pedido emite Requested.
  on [ExamOrder.Requested]
  key: examOrder // REVIEW [2026-12-15] Chave de identidade, correlação e dedup da instância.

  // REVIEW [2026-12-15] Variável durável da instância: leitura do analisador.
  let reading: ExamReading
  // REVIEW [2026-12-15] Variável durável da instância: resultado gerado.
  let result: ExamResult

  // REVIEW [2026-12-15] Laço de tentativas de coleta, limitado a duas iterações.
  loop CollectionAttempt max 2 {
    // REVIEW [2026-12-15] Bloco interno: tenta abrir o form de coleta.
    try {
      // REVIEW [2026-12-15] Abre o form de coleta para o pedido em pauta.
      SampleCollection.show({ examOrder })
      // REVIEW [2026-12-15] Sai do laço quando o form conclui a coleta.
      break
    } catch (Timeout) {
      // REVIEW [2026-12-15] Coleta estourou o prazo: aciona o form manual de escalonamento.
      EscalateCollection.show({ examOrder })
    }
  }

  // REVIEW [2026-12-15] Move o pedido para o estado de processamento.
  ExamOrder.process()

  // REVIEW [2026-12-15] Consulta o analisador e guarda a leitura obtida.
  reading = Analyzer.readResult({ order: examOrder })

  // REVIEW [2026-12-15] Só notifica quando a leitura foi marcada como crítica.
  if (reading.critical) {
    // REVIEW [2026-12-15] Envia o alerta de resultado crítico.
    send CriticalResultAlert {
      key: examOrder // REVIEW [2026-12-15] Correlaciona o alerta ao pedido de exame.
      // REVIEW [2026-12-15] Dados levados pelo alerta.
      with {
        exam: examOrder.exam // REVIEW [2026-12-15] Exame que gerou o alerta.
        value: reading.value // REVIEW [2026-12-15] Valor medido que disparou o alerta.
      }
    }
  }

  // REVIEW [2026-12-15] Registra a leitura do analisador como resultado do exame.
  result = ExamResult.record({
    // REVIEW [2026-12-15] Pedido de exame de origem.
    order: examOrder,
    // REVIEW [2026-12-15] Amostra analisada, herdada do pedido.
    sampleRef: examOrder.sample,
    // REVIEW [2026-12-15] Valor medido na análise.
    measured: reading.value,
    // REVIEW [2026-12-15] Unidade de medida da leitura.
    measUnit: reading.unit,
    isCritical: reading.critical // REVIEW [2026-12-15] Marca de resultado crítico obtida do analisador.
  })

  // REVIEW [2026-12-15] Abre o form de validação do resultado.
  ResultValidation.show({ result })
  // REVIEW [2026-12-15] Abre o form de assinatura do resultado.
  ResultSignature.show({ result })

  // REVIEW [2026-12-15] Libera o resultado já validado e assinado.
  ExamResult.release({ result })
  // REVIEW [2026-12-15] Registra o resultado no pedido, concluindo a etapa de análise.
  ExamOrder.result()

  // REVIEW [2026-12-15] Notifica a liberação do resultado.
  send ResultReleased {
    key: examOrder // REVIEW [2026-12-15] Correlaciona a notificação ao pedido de exame.
    // REVIEW [2026-12-15] Dados levados pela notificação.
    with {
      exam: examOrder.exam // REVIEW [2026-12-15] Exame cujo resultado foi liberado.
      sample: examOrder.sample // REVIEW [2026-12-15] Amostra associada ao resultado.
    }
  }

  // REVIEW [2026-12-15] Cancela a instância se o pedido for cancelado durante a execução.
  cancel on ExamOrder.Cancelled {
    // REVIEW [2026-12-15] Encerra o processo no desfecho de cancelamento.
    return Cancelled
  }

  // REVIEW [2026-12-15] Encerra no desfecho de sucesso após a liberação.
  return Released

  // REVIEW [2026-12-15] Declara o desfecho de sucesso do caso.
  end Released {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Resultado liberado", en: "Result released" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }

  // REVIEW [2026-12-15] Declara o desfecho de cancelamento do caso.
  end Cancelled {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Exame cancelado", en: "Exam cancelled" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: cancelled
  }
}

// REVIEW [2026-12-15] Shape que transporta a leitura bruta do analisador.
shape ExamReading {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Leitura do analisador", en: "Analyzer reading" }
  // REVIEW [2026-12-15] Campos que compõem a leitura.
  fields {
    value: string // REVIEW [2026-12-15] Valor medido pelo analisador.
    unit: string // REVIEW [2026-12-15] Unidade de medida da leitura.
    critical: boolean // REVIEW [2026-12-15] Marca se a leitura é crítica.
    readAt: DateTime // REVIEW [2026-12-15] Instante em que a leitura foi feita.
  }
}

// REVIEW [2026-12-15] Form de coleta da amostra do pedido.
form SampleCollection {
  // REVIEW [2026-12-15] Título exibido na inbox do form.
  title: { pt-BR: "Coleta da amostra", en: "Sample collection" }
  document: ExamOrder // REVIEW [2026-12-15] Documento manipulado pelo form.
  roles: [Collector] // REVIEW [2026-12-15] Papéis que podem executar o form.
  timeout: 4h // REVIEW [2026-12-15] Prazo para conclusão antes de estourar timeout.
  priority: 50 // REVIEW [2026-12-15] Prioridade de exibição na inbox.
  assign: pull // REVIEW [2026-12-15] Distribuição por puxada manual pelo executor.

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Amostra coletada.
    sample
    // REVIEW [2026-12-15] Exame solicitado.
    exam
    // REVIEW [2026-12-15] Laboratório responsável.
    laboratory
  }

  // REVIEW [2026-12-15] Ações disponíveis no formulário.
  actions {
    // REVIEW [2026-12-15] Conclui a coleta chamando a action do documento.
    collect { calls: ExamOrder.collect }
  }
}

// REVIEW [2026-12-15] Form de validação do resultado.
form ResultValidation {
  // REVIEW [2026-12-15] Título exibido na inbox do form.
  title: { pt-BR: "Validação do resultado", en: "Result validation" }
  document: ExamResult // REVIEW [2026-12-15] Documento manipulado pelo form.
  roles: [Analyst] // REVIEW [2026-12-15] Papéis que podem executar o form.
  timeout: 4h // REVIEW [2026-12-15] Prazo para conclusão antes de estourar timeout.
  assign: pull // REVIEW [2026-12-15] Distribuição por puxada manual pelo executor.

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Valor medido.
    value
    // REVIEW [2026-12-15] Unidade de medida.
    unit
    // REVIEW [2026-12-15] Marca de resultado crítico.
    critical
    // REVIEW [2026-12-15] Pedido de exame de origem.
    examOrder
  }

  // REVIEW [2026-12-15] Ações disponíveis no formulário.
  actions {
    // REVIEW [2026-12-15] Valida o resultado chamando a action do documento.
    validate { calls: ExamResult.validate }
  }
}

// REVIEW [2026-12-15] Form de assinatura do resultado.
form ResultSignature {
  // REVIEW [2026-12-15] Título exibido na inbox do form.
  title: { pt-BR: "Assinatura do resultado", en: "Result signature" }
  document: ExamResult // REVIEW [2026-12-15] Documento manipulado pelo form.
  roles: [Pathologist] // REVIEW [2026-12-15] Papéis que podem executar o form.
  timeout: 8h // REVIEW [2026-12-15] Prazo para conclusão antes de estourar timeout.
  assign: pull // REVIEW [2026-12-15] Distribuição por puxada manual pelo executor.

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Valor medido.
    value
    // REVIEW [2026-12-15] Unidade de medida.
    unit
    // REVIEW [2026-12-15] Marca de resultado crítico.
    critical
    // REVIEW [2026-12-15] Pedido de exame de origem.
    examOrder
  }

  // REVIEW [2026-12-15] Ações disponíveis no formulário.
  actions {
    // REVIEW [2026-12-15] Assina o resultado chamando a action do documento.
    sign { calls: ExamResult.sign }
  }
}

// REVIEW [2026-12-15] Form manual de escalonamento quando a coleta atrasa.
manual EscalateCollection {
  // REVIEW [2026-12-15] Título exibido na inbox do form.
  title: { pt-BR: "Escalonar a coleta", en: "Escalate collection" }
  document: ExamOrder // REVIEW [2026-12-15] Documento manipulado pelo form.
  roles: [LabManager] // REVIEW [2026-12-15] Papéis que podem executar o form.
  instructions: "Repactuar o prazo da coleta com o responsável" // REVIEW [2026-12-15] Orientação exibida ao executor.
  timeout: 2h // REVIEW [2026-12-15] Prazo para conclusão antes de estourar timeout.
  assign: pull // REVIEW [2026-12-15] Distribuição por puxada manual pelo executor.
}

// REVIEW [2026-12-15] Integração com os analisadores laboratoriais.
integration Analyzer {
  protocol: mqtt // REVIEW [2026-12-15] Protocolo de mensageria usado na integração.
  topic: "analyzers/+/reading" // REVIEW [2026-12-15] Tópico MQTT das leituras, com curinga por equipamento.
  // REVIEW [2026-12-15] Capacidades exigidas do equipamento.
  capabilities { equipment }
  timeout: 30s // REVIEW [2026-12-15] Prazo máximo de espera por uma leitura.
  // REVIEW [2026-12-15] Requisitos de qualidade do equipamento.
  quality {
    // REVIEW [2026-12-15] Leitura considerada obsoleta após cinco minutos.
    staleAfter: 5m
    // REVIEW [2026-12-15] Calibração mensal exigida do equipamento.
    calibrate: monthly
  }

  // REVIEW [2026-12-15] Operações expostas pela integração.
  operations {
    // REVIEW [2026-12-15] Lê o resultado do analisador para o pedido de exame.
    readResult(order: ExamOrder): ExamReading
  }
}
