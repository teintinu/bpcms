// REVIEW [2026-12-15] service: example.com/services/laboratory

// REVIEW [2026-12-15] Mensagem de alerta sobre resultado crítico de um exame.
message CriticalResultAlert {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Alerta de resultado crítico", en: "Critical result alert" }
  about: ExamOrder // REVIEW [2026-12-15] Documento ao qual a mensagem se refere.
  // REVIEW [2026-12-15] Dados levados pela mensagem.
  payload {
    exam: ExamCode { title: { pt-BR: "Exame", en: "Exam" } } // REVIEW [2026-12-15] Exame que gerou o alerta.
    value: string { title: { pt-BR: "Valor", en: "Value" } } // REVIEW [2026-12-15] Valor medido que disparou o alerta.
  }
}
