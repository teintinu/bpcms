// REVIEW [2026-12-15] service: example.com/services/laboratory

// REVIEW [2026-12-15] Organograma que estrutura papéis e hierarquia do laboratório.
organogram Laboratory {
  // REVIEW [2026-12-15] Título exibido no builder e na revisão.
  title: { pt-BR: "Organograma do laboratório", en: "Laboratory organogram" }
  scopes: [Laboratory] // REVIEW [2026-12-15] Escopos em que as roles deste organograma valem.

  // REVIEW [2026-12-15] Hierarquia de subordinação entre as roles.
  hierarchy {
    // REVIEW [2026-12-15] Cadeia principal: gestor, patologista, analista e coletador.
    LabManager > Pathologist > Analyst > Collector
    // REVIEW [2026-12-15] O gestor também responde pela ligação com laboratórios de apoio.
    LabManager > SupportLiaison
    // REVIEW [2026-12-15] O gestor também responde pelo equipamento analisador.
    LabManager > AnalyzerDevice
  }

  // REVIEW [2026-12-15] Delega ao patologista após sete dias de ausência do gestor.
  LabManager delegates to Pathologist when absent for 7d

  // REVIEW [2026-12-15] Regras de segregação de funções.
  segregation {
    // REVIEW [2026-12-15] Quem executa o exame não pode liberar o resultado.
    exam.perform != exam.release
  }

  // REVIEW [2026-12-15] Assinatura exigida nas decisões do organograma.
  signature {
    // REVIEW [2026-12-15] Papel que assina as liberações.
    Pathologist
  }
}

// REVIEW [2026-12-15] Papel responsável pela coleta das amostras.
role Collector {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Coletador", en: "Collector" }
  scopes: [Laboratory] // REVIEW [2026-12-15] Escopos em que a role é válida.
  // REVIEW [2026-12-15] Permissões concedidas ao coletador.
  permissions: [
    // REVIEW [2026-12-15] Coleta de amostra para hemograma.
    sample.collect.hemogram,
    // REVIEW [2026-12-15] Coleta de amostra para glicemia.
    sample.collect.glucose,
    // REVIEW [2026-12-15] Consulta de amostras.
    sample.view,
    // REVIEW [2026-12-15] Execução de exame de hemograma.
    exam.perform.hemogram
  ]
}

// REVIEW [2026-12-15] Papel do equipamento analisador automatizado.
role AnalyzerDevice {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Equipamento analisador", en: "Analyzer device" }
  scopes: [Laboratory] // REVIEW [2026-12-15] Escopos em que a role é válida.
  // REVIEW [2026-12-15] Capacidades técnicas do equipamento.
  capabilities { equipment, laboratory-protocol }
  // REVIEW [2026-12-15] Permissão de execução do hemograma.
  permissions: [exam.perform.hemogram]
}

// REVIEW [2026-12-15] Papel do analista que processa as amostras.
role Analyst {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Analista", en: "Analyst" }
  scopes: [Laboratory] // REVIEW [2026-12-15] Escopos em que a role é válida.
  inherits: Collector // REVIEW [2026-12-15] Herda as permissões do coletador.
  // REVIEW [2026-12-15] Permissões adicionais do analista.
  permissions: [
    // REVIEW [2026-12-15] Coleta de amostra para cultura.
    sample.collect.culture,
    // REVIEW [2026-12-15] Coleta de amostra para hemoglobina glicada.
    sample.collect.hba1c,
    // REVIEW [2026-12-15] Execução de exame de cultura.
    exam.perform.culture,
    // REVIEW [2026-12-15] Execução de exame de hemoglobina glicada.
    exam.perform.hba1c,
    // REVIEW [2026-12-15] Registro de resultados.
    result.enter
  ]
}

// REVIEW [2026-12-15] Papel do patologista que revisa e libera resultados.
role Pathologist {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Patologista", en: "Pathologist" }
  scopes: [Laboratory] // REVIEW [2026-12-15] Escopos em que a role é válida.
  // REVIEW [2026-12-15] Permissões de revisão e liberação.
  permissions: [exam.review, exam.release, result.release]
}

// REVIEW [2026-12-15] Papel de ligação com os laboratórios de apoio.
role SupportLiaison {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Ligação com apoio", en: "Support liaison" }
  scopes: [Laboratory] // REVIEW [2026-12-15] Escopos em que a role é válida.
  // REVIEW [2026-12-15] Permissões de recebimento e encaminhamento.
  permissions: [sample.receive, support.refer]
}

// REVIEW [2026-12-15] Papel do gestor do laboratório.
role LabManager {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Gerente do laboratório", en: "Laboratory manager" }
  scopes: [Laboratory] // REVIEW [2026-12-15] Escopos em que a role é válida.
  inherits: Pathologist // REVIEW [2026-12-15] Herda as permissões do patologista.
  // REVIEW [2026-12-15] Permissões administrativas e de encaminhamento.
  permissions: [lab.manage, support.refer]
}
