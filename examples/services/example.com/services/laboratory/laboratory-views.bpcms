// service: example.com/services/laboratory

// View de relatório com indicadores de qualidade do laboratório.
view LabQuality {
  // Título exibido na navegação.
  title: { pt-BR: "Qualidade laboratorial", en: "Laboratory quality" }
  // Tipo da view: relatório com métricas agregadas.
  type: report
  // Documentos usados como fonte dos indicadores.
  sources: [Sample, ExamResult]
  roles: [Pathologist, LabManager] // Papéis que podem abrir o relatório.

  // Filtros disponíveis no relatório.
  filters { period; exam; laboratory }
  // Métricas calculadas sobre as fontes.
  metrics {
    // Amostras rejeitadas no período.
    rejected: count(Sample) where status == Rejected
    // Resultados marcados como críticos.
    criticalResults: count(ExamResult) where critical == true
    // Resultados já liberados.
    releasedResults: count(ExamResult) where status == Released
    // Resultados já assinados.
    signedResults: count(ExamResult) where status == Signed
  }
  freshness: 15m // Janela de atualização dos dados do relatório.
  export: [pdf, csv] // Formatos de exportação habilitados.
}

// View de inbox com a fila de coleta por papel.
view CollectionQueue {
  // Título exibido na navegação.
  title: { pt-BR: "Fila de coleta", en: "Collection queue" }
  // Tipo da view: caixa de entrada de trabalho.
  type: inbox
  roles: [Collector, Analyst, Pathologist, LabManager] // Papéis que podem abrir a fila.
  scope: roles // Restringe a fila ao escopo das roles do usuário.
  groupBy: role // Agrupa os itens da fila por papel.
  // Mostra apenas itens das roles do usuário atual.
  filter { role in currentUser.roles }
  // Colunas exibidas em cada item da fila.
  columns { title; subject; role; dueAt; priority }
}
