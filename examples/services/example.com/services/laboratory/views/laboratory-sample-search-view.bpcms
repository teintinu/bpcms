// service: example.com/services/laboratory

// View de busca de amostras em formato de tabela.
view SampleSearch {
  // Título exibido na navegação.
  title: { pt-BR: "Busca de amostras", en: "Sample search" }
  // Tipo da view: tabela de registros.
  type: table
  // Documento que alimenta a tabela.
  source: Sample
  roles: [Collector, Analyst, Pathologist, LabManager] // Papéis que podem abrir a busca.

  // Colunas exibidas na tabela.
  columns { code; kind; patient; status; collectedAt }
  // Filtros disponíveis na busca.
  filters { status; kind; laboratory }
  pagination: 50 // Itens por página.
}
