// REVIEW [2026-12-15] service: example.com/services/laboratory

// REVIEW [2026-12-15] View de relatório com indicadores de qualidade do laboratório.
view LabQuality {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Qualidade laboratorial", en: "Laboratory quality" }
  // REVIEW [2026-12-15] Tipo da view: relatório com métricas agregadas.
  type: report
  // REVIEW [2026-12-15] Documentos usados como fonte dos indicadores.
  sources: [Sample, ExamResult]
  roles: [Pathologist, LabManager] // REVIEW [2026-12-15] Papéis que podem abrir o relatório.

  // REVIEW [2026-12-15] Filtros disponíveis no relatório.
  filters { period; exam; laboratory }
  // REVIEW [2026-12-15] Métricas calculadas sobre as fontes.
  metrics {
    // REVIEW [2026-12-15] Amostras rejeitadas no período.
    rejected: count(Sample) where status == Rejected
    // REVIEW [2026-12-15] Resultados marcados como críticos.
    criticalResults: count(ExamResult) where critical == true
    // REVIEW [2026-12-15] Resultados já liberados.
    releasedResults: count(ExamResult) where status == Released
    // REVIEW [2026-12-15] Resultados já assinados.
    signedResults: count(ExamResult) where status == Signed
  }
  freshness: 15m // REVIEW [2026-12-15] Janela de atualização dos dados do relatório.
  export: [pdf, csv] // REVIEW [2026-12-15] Formatos de exportação habilitados.
}
