// REVIEW [2026-12-15] service: example.com/services/laboratory

// REVIEW [2026-12-15] View de busca de amostras em formato de tabela.
view SampleSearch {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Busca de amostras", en: "Sample search" }
  // REVIEW [2026-12-15] Tipo da view: tabela de registros.
  type: table
  // REVIEW [2026-12-15] Documento que alimenta a tabela.
  source: Sample
  roles: [Collector, Analyst, Pathologist, LabManager] // REVIEW [2026-12-15] Papéis que podem abrir a busca.

  // REVIEW [2026-12-15] Colunas exibidas na tabela.
  columns { code; kind; patient; status; collectedAt }
  // REVIEW [2026-12-15] Filtros disponíveis na busca.
  filters { status; kind; laboratory }
  pagination: 50 // REVIEW [2026-12-15] Itens por página.
}
