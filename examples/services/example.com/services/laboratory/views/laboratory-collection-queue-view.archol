// REVIEW [2026-12-15] service: example.com/services/laboratory

// REVIEW [2026-12-15] View de inbox com a fila de coleta por papel.
view CollectionQueue {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Fila de coleta", en: "Collection queue" }
  // REVIEW [2026-12-15] Tipo da view: caixa de entrada de trabalho.
  type: inbox
  roles: [Collector, Analyst, Pathologist, LabManager] // REVIEW [2026-12-15] Papéis que podem abrir a fila.
  scope: roles // REVIEW [2026-12-15] Restringe a fila ao escopo das roles do usuário.
  groupBy: role // REVIEW [2026-12-15] Agrupa os itens da fila por papel.
  // REVIEW [2026-12-15] Mostra apenas itens das roles do usuário atual.
  filter { role in currentUser.roles }
  // REVIEW [2026-12-15] Colunas exibidas em cada item da fila.
  columns { title; subject; role; dueAt; priority }
}
