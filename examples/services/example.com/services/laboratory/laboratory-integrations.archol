// REVIEW [2026-12-15] service: example.com/services/laboratory

// REVIEW [2026-12-15] Integração com o gateway dos laboratórios de apoio.
integration SupportLabGateway {
  protocol: rest // REVIEW [2026-12-15] Protocolo de transporte usado na chamada.
  baseUrl: env.SUPPORT_LAB_URL // REVIEW [2026-12-15] Endereço base lido da variável de ambiente do serviço.
  auth: oauth2 // REVIEW [2026-12-15] Autenticação OAuth2 nas chamadas ao gateway.
  timeout: 20s // REVIEW [2026-12-15] Prazo máximo de cada chamada antes de estourar timeout.
  retry: exponential(3) // REVIEW [2026-12-15] Repetição exponencial limitada a três tentativas.

  // REVIEW [2026-12-15] Operações expostas pela integração.
  operations {
    // REVIEW [2026-12-15] Envia a amostra ao laboratório de apoio e devolve o protocolo.
    sendSample(sample: Sample): string
    // REVIEW [2026-12-15] Recebe o resultado do laboratório de apoio para a amostra.
    receiveResult(sample: Sample): ExamResult
  }
}
