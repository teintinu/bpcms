// REVIEW [2026-12-15] service: example.com/services/laboratory
// REVIEW [2026-12-15] Declara o serviço que concentra os artefatos de negócio do laboratório.
service "example.com/services/laboratory" {
  // REVIEW [2026-12-15] Título exibido no builder e nos seletores de serviço.
  title: { pt-BR: "Laboratório", en: "Laboratory" }
  locales: [ "pt-BR", "en" ] // REVIEW [2026-12-18] Idiomas suportados pelo serviço; o primeiro é o default do I18N em forma de string.
  // REVIEW [2026-12-15] Dependências de outros serviços, resolvidas por alias.
  imports {
    // REVIEW [2026-12-18] Importa as medidas/constantes padrão; `sla` usa std.Duration.
    service "bpcms.org/std" as std
    // REVIEW [2026-12-15] Importa o serviço Citizen como dono dos tipos de cidadão/paciente.
    service "example.com/services/citizen" as Citizen
    // REVIEW [2026-12-15] Importa o serviço Identity como dono de usuários e papéis.
    service "example.com/services/identity" as Identity
  }
}
