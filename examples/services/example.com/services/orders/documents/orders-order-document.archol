// REVIEW [2026-12-15] service: example.com/services/orders

// REVIEW [2026-12-15] Documento agregado que representa o pedido e concentra o ciclo de vida da compra.
document Order {
  // REVIEW [2026-12-15] Título legível exibido na interface.
  title: { pt-BR: "Pedido", en: "Order" }
  // REVIEW [2026-12-15] Versão do artefato; diff e release comparam este número.
  // REVIEW [2026-12-15] Área responsável pelo documento.
  // REVIEW [2026-12-15] Modo de sincronização em tempo real entre cliente e servidor.
  sync: live

  // REVIEW [2026-12-15] Campos que compõem o pedido.
  fields {
    // REVIEW [2026-12-15] Cliente dono do pedido, referenciando o User do serviço de identidade.
    customer: User {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Cliente", en: "Customer" }
      // REVIEW [2026-12-15] Permite localizar pedidos pelo cliente.
      lookup
    }
    // REVIEW [2026-12-15] Itens do pedido; cada linha é um OrderItem com produto e quantidade.
    items: OrderItem[] { title: { pt-BR: "Itens", en: "Items" } }
    // REVIEW [2026-12-15] Soma dos totais dos itens, calculada pelo servidor.
    subtotal: std.Money {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Subtotal", en: "Subtotal" }
      // REVIEW [2026-12-15] Moeda do valor em reais.
      currency: BRL
      // REVIEW [2026-12-15] Fórmula que agrega o total de cada item.
      computed: items.sum(total)
    }
    // REVIEW [2026-12-15] Desconto aplicado sobre o subtotal.
    discount: std.Money { title: { pt-BR: "Desconto", en: "Discount" }, currency: BRL }
    // REVIEW [2026-12-15] Total a pagar, derivado do subtotal menos o desconto.
    total: std.Money {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Total", en: "Total" }
      // REVIEW [2026-12-15] Permite localizar e filtrar pedidos pelo total.
      lookup
      // REVIEW [2026-12-15] Moeda do valor em reais.
      currency: BRL
      // REVIEW [2026-12-15] Fórmula que calcula o total líquido.
      computed: subtotal - discount
    }
    // REVIEW [2026-12-15] Situação atual do pedido dentro do shape OrderStatus.
    status: OrderStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    // REVIEW [2026-12-15] Data em que o pedido foi realizado.
    placedAt: DateTime { title: { pt-BR: "Realizado em", en: "Placed at" } }
    // REVIEW [2026-12-15] Data em que os itens foram reservados no estoque.
    reservedAt: DateTime { title: { pt-BR: "Reservado em", en: "Reserved at" } }
    // REVIEW [2026-12-15] Data em que o pedido foi cancelado.
    cancelledAt: DateTime { title: { pt-BR: "Cancelado em", en: "Cancelled at" } }
    // REVIEW [2026-12-15] Data em que o pedido cancelado foi reaberto.
    reopenedAt: DateTime { title: { pt-BR: "Reaberto em", en: "Reopened at" } }
    // REVIEW [2026-12-15] Data em que o pedido foi atendido.
    fulfilledAt: DateTime { title: { pt-BR: "Atendido em", en: "Fulfilled at" } }
    // REVIEW [2026-12-15] Motivo textual registrado no cancelamento.
    cancellationReason: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Motivo do cancelamento", en: "Cancellation reason" }
      // REVIEW [2026-12-15] Limita o motivo a quinhentos caracteres.
      maxLength: 500
    }
    // REVIEW [2026-12-15] Observações livres do atendente sobre o pedido.
    notes: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Observações", en: "Notes" }
      // REVIEW [2026-12-15] Limita as observações a mil caracteres.
      maxLength: 1000
    }
    // REVIEW [2026-12-15] Data de criação do registro.
    createdAt: DateTime { title: { pt-BR: "Criado em", en: "Created at" }, lookup }
  }

  // REVIEW [2026-12-15] Índices que aceleram consultas frequentes sobre os pedidos.
  indexes {
    // REVIEW [2026-12-15] Índice por cliente e data para listar o histórico em faixa.
    byCustomer: [customer.id, createdAt] range
    // REVIEW [2026-12-15] Índice por situação e data para funis e filas em faixa.
    byStatus: [status, createdAt] range
  }


  // REVIEW [2026-12-15] Ações que mudam o estado do pedido e disparam eventos do processo.
  actions {
    // REVIEW [2026-12-15] Cria o pedido com cliente e desconto, marcando data e emitindo Drafted.
    create(customer: User, discount: std.Percentage) {
      // REVIEW [2026-12-15] Título exibido no botão da interface.
      title: { pt-BR: "Criar pedido", en: "Create order" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Clerk]
      // REVIEW [2026-12-15] Corpo executado na criação.
      {
        // REVIEW [2026-12-15] Registra o instante de criação.
        createdAt = now()
        // REVIEW [2026-12-15] Emite o evento que inicia o processo de entrada.
        emit Drafted
      }
    }

    // REVIEW [2026-12-15] Adiciona um item ao pedido validando a quantidade.
    addItem(product: Product, quantity: std.Count) {
      // REVIEW [2026-12-15] Título exibido no botão da interface.
      title: { pt-BR: "Adicionar item", en: "Add item" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Clerk]
      // REVIEW [2026-12-15] Regra que rejeita quantidades não positivas.
      rule quantity > 0 {
        // REVIEW [2026-12-15] Mensagem da regra em português.
        pt-BR: "A quantidade deve ser maior que zero"
        // REVIEW [2026-12-15] Mensagem da regra em inglês.
        en: "Quantity must be greater than zero"
      }
    }

    // REVIEW [2026-12-15] Grava uma anotação livre nas observações do pedido.
    annotate(note: string) {
      // REVIEW [2026-12-15] Título exibido no botão da interface.
      title: { pt-BR: "Anotar", en: "Annotate" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Clerk]
      // REVIEW [2026-12-15] Corpo executado ao anotar.
      {
        // REVIEW [2026-12-15] Substitui as observações pelo texto informado.
        notes = note
      }
    }

    // REVIEW [2026-12-15] Realiza o pedido, exigindo ao menos um item e registrando a data.
    place() {
      // REVIEW [2026-12-15] Título exibido no botão da interface.
      title: { pt-BR: "Realizar pedido", en: "Place order" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Clerk]

      // REVIEW [2026-12-15] Transição para a situação Placed.
      to: status.Placed

      // REVIEW [2026-12-15] Regra que exige pelo menos um item no pedido.
      rule items.length > 0 {
        // REVIEW [2026-12-15] Mensagem da regra em português.
        pt-BR: "Adicione ao menos um item"
        // REVIEW [2026-12-15] Mensagem da regra em inglês.
        en: "Add at least one item"
      }
      // REVIEW [2026-12-15] Corpo executado na realização.
      {
        // REVIEW [2026-12-15] Registra o instante em que o pedido foi realizado.
        placedAt = now()
      }
    }

    // REVIEW [2026-12-15] Confirma a reserva de estoque, avançando a situação do pedido.
    confirmReservation() {
      // REVIEW [2026-12-15] Título exibido no botão da interface.
      title: { pt-BR: "Confirmar reserva", en: "Confirm reservation" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [OrderEngine]

      // REVIEW [2026-12-15] Transição para a situação Reserved.
      to: status.Reserved
      // REVIEW [2026-12-15] Corpo executado ao confirmar a reserva.
      {
        // REVIEW [2026-12-15] Registra o instante em que a reserva foi confirmada.
        reservedAt = now()
      }
    }

    // REVIEW [2026-12-15] Abre a solicitação de cancelamento com o motivo informado.
    requestCancellation(reason: string) {
      // REVIEW [2026-12-15] Título exibido no botão da interface.
      title: { pt-BR: "Solicitar cancelamento", en: "Request cancellation" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Clerk, Manager]

      // REVIEW [2026-12-15] Transição para a situação CancellationRequested.
      to: status.CancellationRequested

      // REVIEW [2026-12-15] Regra que exige um motivo com pelo menos dez caracteres.
      rule reason.length >= 10 {
        // REVIEW [2026-12-15] Mensagem da regra em português.
        pt-BR: "Informe um motivo com pelo menos 10 caracteres"
        // REVIEW [2026-12-15] Mensagem da regra em inglês.
        en: "Enter a reason with at least 10 characters"
      }
      // REVIEW [2026-12-15] Corpo executado ao abrir a solicitação.
      {
        // REVIEW [2026-12-15] Guarda o motivo para a análise do gerente.
        cancellationReason = reason
      }
    }

    // REVIEW [2026-12-15] Aprova o cancelamento já solicitado.
    approveCancellation() {
      // REVIEW [2026-12-15] Título exibido no botão da interface.
      title: { pt-BR: "Aprovar cancelamento", en: "Approve cancellation" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Manager]

      // REVIEW [2026-12-15] Transição para a situação CancellationApproved.
      to: status.CancellationApproved
    }

    // REVIEW [2026-12-15] Recusa o cancelamento e devolve o pedido para Placed.
    rejectCancellation() {
      // REVIEW [2026-12-15] Título exibido no botão da interface.
      title: { pt-BR: "Recusar cancelamento", en: "Reject cancellation" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Manager]

      // REVIEW [2026-12-15] Transição de volta para a situação Placed.
      to: status.Placed
    }

    // REVIEW [2026-12-15] Cancela o pedido com o motivo e registra a data do cancelamento.
    cancel(reason: string) {
      // REVIEW [2026-12-15] Título exibido no botão da interface.
      title: { pt-BR: "Cancelar", en: "Cancel" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Clerk, Manager, OrderEngine]

      // REVIEW [2026-12-15] Transição para a situação Cancelled.
      to: status.Cancelled

      // REVIEW [2026-12-15] Regra que exige um motivo com pelo menos dez caracteres.
      rule reason.length >= 10 {
        // REVIEW [2026-12-15] Mensagem da regra em português.
        pt-BR: "Informe um motivo com pelo menos 10 caracteres"
        // REVIEW [2026-12-15] Mensagem da regra em inglês.
        en: "Enter a reason with at least 10 characters"
      }
      // REVIEW [2026-12-15] Corpo executado no cancelamento.
      {
        // REVIEW [2026-12-15] Guarda o motivo do cancelamento no documento.
        cancellationReason = reason
        // REVIEW [2026-12-15] Registra o instante do cancelamento.
        cancelledAt = now()
      }
    }

    // REVIEW [2026-12-15] Reabre um pedido cancelado, devolvendo-o para Placed.
    reopen() {
      // REVIEW [2026-12-15] Título exibido no botão da interface.
      title: { pt-BR: "Reabrir", en: "Reopen" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Manager, OrderEngine]

      // REVIEW [2026-12-15] Transição de volta para a situação Placed.
      to: status.Placed
      // REVIEW [2026-12-15] Corpo executado ao reabrir.
      {
        // REVIEW [2026-12-15] Registra o instante em que o pedido foi reaberto.
        reopenedAt = now()
      }
    }

    // REVIEW [2026-12-15] Marca o pedido como atendido após a entrega.
    fulfill() {
      // REVIEW [2026-12-15] Título exibido no botão da interface.
      title: { pt-BR: "Atender", en: "Fulfill" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [OrderEngine]

      // REVIEW [2026-12-15] Transição para a situação Fulfilled.
      to: status.Fulfilled
      // REVIEW [2026-12-15] Corpo executado ao atender.
      {
        // REVIEW [2026-12-15] Registra o instante em que o pedido foi atendido.
        fulfilledAt = now()
      }
    }
  }

  // REVIEW [2026-12-15] Invariante: todo pedido realizado precisa ter a data de realização.
  rule status == Placed implies placedAt != null {
    // REVIEW [2026-12-15] Mensagem da regra em português.
    pt-BR: "Informe a data do pedido"
    // REVIEW [2026-12-15] Mensagem da regra em inglês.
    en: "Enter the order date"
  }
  // REVIEW [2026-12-15] Invariante que limita o pedido a cinquenta itens.
  rule items.count <= 50 {
    // REVIEW [2026-12-15] Mensagem da regra em português.
    pt-BR: "O pedido excede o limite de 50 itens"
    // REVIEW [2026-12-15] Mensagem da regra em inglês.
    en: "Order exceeds the 50 item limit"
  }
}

// REVIEW [2026-12-15] Forma que descreve uma linha de item do pedido.
shape OrderItem {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Item de pedido", en: "Order item" }

  // REVIEW [2026-12-15] Campos que compõem o item.
  fields {
    // REVIEW [2026-12-15] Produto comprado, referenciando o catálogo.
    product: Product {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Produto", en: "Product" }
      // REVIEW [2026-12-15] Permite localizar itens pelo produto.
      lookup
    }
    // REVIEW [2026-12-15] Quantidade comprada do produto.
    quantity: std.Count {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Quantidade", en: "Quantity" }
      // REVIEW [2026-12-15] Permite localizar itens pela quantidade.
      lookup
      // REVIEW [2026-12-15] Mínimo de uma unidade por item.
      min: 1
      // REVIEW [2026-12-15] Máximo de mil unidades por item.
      max: 1000
      // REVIEW [2026-12-15] Torna a quantidade obrigatória.
      required
    }
    // REVIEW [2026-12-15] Preço unitário do produto no momento da compra.
    unitPrice: std.Money {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Preço unitário", en: "Unit price" }
      // REVIEW [2026-12-15] Moeda do valor em reais.
      currency: BRL
    }
    // REVIEW [2026-12-15] Total da linha, calculado pela quantidade vezes o preço unitário.
    total: std.Money {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Total", en: "Total" }
      // REVIEW [2026-12-15] Moeda do valor em reais.
      currency: BRL
      // REVIEW [2026-12-15] Fórmula que calcula o total do item.
      computed: quantity * unitPrice
    }
  }
}

// REVIEW [2026-12-15] Forma de estado que modela a situação do pedido e suas transições.
shape OrderStatus {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Situação do pedido", en: "Order status" }
  // REVIEW [2026-12-15] Base do shape: uma máquina de estados.
  base: state
  // REVIEW [2026-12-15] Estado inicial Draft e transição que o ativa ao criar o pedido.
  initial: Draft with transition Drafted {
    // REVIEW [2026-12-15] Título da transição exibido no histórico.
    title: { pt-BR: "Pedido criado", en: "Order drafted" }
    // REVIEW [2026-12-15] Dados carregados pelo evento Drafted.
    payload {
      // REVIEW [2026-12-15] Cliente do pedido recém-criado.
      customer: User { title: { pt-BR: "Cliente", en: "Customer" } }
      // REVIEW [2026-12-15] Data de criação do pedido.
      createdAt: DateTime { title: { pt-BR: "Criado em", en: "Created at" } }
    }
  }

  // REVIEW [2026-12-15] Estado Rascunho, primeiro valor do ciclo de vida.
  value Draft {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Rascunho", en: "Draft" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Draft
    // REVIEW [2026-12-15] Ordem do estado na linha do tempo.
    ordinal: 10

    // REVIEW [2026-12-15] Transição que realiza o pedido.
    transition Placed {
      // REVIEW [2026-12-15] Título da transição exibido no histórico.
      title: { pt-BR: "Pedido realizado", en: "Order placed" }
      // REVIEW [2026-12-15] Dados carregados pelo evento de realização.
      payload {
        // REVIEW [2026-12-15] Cliente do pedido realizado.
        customer: User { title: { pt-BR: "Cliente", en: "Customer" } }
        // REVIEW [2026-12-15] Total do pedido realizado.
        total: std.Money { title: { pt-BR: "Total", en: "Total" } }
        // REVIEW [2026-12-15] Data em que o pedido foi realizado.
        placedAt: DateTime { title: { pt-BR: "Realizado em", en: "Placed at" } }
      }
    }

    // REVIEW [2026-12-15] Transição que cancela o pedido diretamente do rascunho.
    transition Cancelled {
      // REVIEW [2026-12-15] Título da transição exibido no histórico.
      title: { pt-BR: "Pedido cancelado", en: "Order cancelled" }
      // REVIEW [2026-12-15] Dados carregados pelo evento de cancelamento.
      payload {
        // REVIEW [2026-12-15] Motivo do cancelamento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
        // REVIEW [2026-12-15] Data do cancelamento.
        cancelledAt: DateTime { title: { pt-BR: "Cancelado em", en: "Cancelled at" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado Realizado, com estoque ainda não reservado.
  value Placed {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Realizado", en: "Placed" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Placed
    // REVIEW [2026-12-15] Ordem do estado na linha do tempo.
    ordinal: 20

    // REVIEW [2026-12-15] Transição que reserva o estoque do pedido.
    transition Reserved {
      // REVIEW [2026-12-15] Título da transição exibido no histórico.
      title: { pt-BR: "Estoque reservado", en: "Stock reserved" }
      // REVIEW [2026-12-15] Dados carregados pela confirmação da reserva.
      payload {
        // REVIEW [2026-12-15] Data em que a reserva foi feita.
        reservedAt: DateTime { title: { pt-BR: "Reservado em", en: "Reserved at" } }
      }
    }

    // REVIEW [2026-12-15] Transição que abre uma solicitação de cancelamento.
    transition CancellationRequested {
      // REVIEW [2026-12-15] Título da transição exibido no histórico.
      title: { pt-BR: "Cancelamento solicitado", en: "Cancellation requested" }
      // REVIEW [2026-12-15] Dados carregados pela solicitação.
      payload {
        // REVIEW [2026-12-15] Motivo informado na solicitação.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado Reservado, com estoque garantido para o pedido.
  value Reserved {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Reservado", en: "Reserved" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Reserved
    // REVIEW [2026-12-15] Ordem do estado na linha do tempo.
    ordinal: 30

    // REVIEW [2026-12-15] Transição que abre uma solicitação de cancelamento.
    transition CancellationRequested {
      // REVIEW [2026-12-15] Título da transição exibido no histórico.
      title: { pt-BR: "Cancelamento solicitado", en: "Cancellation requested" }
      // REVIEW [2026-12-15] Dados carregados pela solicitação.
      payload {
        // REVIEW [2026-12-15] Motivo informado na solicitação.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }

    // REVIEW [2026-12-15] Transição que atende o pedido reservado.
    transition Fulfilled {
      // REVIEW [2026-12-15] Título da transição exibido no histórico.
      title: { pt-BR: "Pedido atendido", en: "Order fulfilled" }
      // REVIEW [2026-12-15] Dados carregados pelo atendimento.
      payload {
        // REVIEW [2026-12-15] Data em que o pedido foi atendido.
        fulfilledAt: DateTime { title: { pt-BR: "Atendido em", en: "Fulfilled at" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado Cancelamento solicitado, aguardando decisão do gerente.
  value CancellationRequested {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Cancelamento solicitado", en: "Cancellation requested" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: CancellationRequested
    // REVIEW [2026-12-15] Ordem do estado na linha do tempo.
    ordinal: 40

    // REVIEW [2026-12-15] Transição que aprova o cancelamento solicitado.
    transition CancellationApproved {
      // REVIEW [2026-12-15] Título da transição exibido no histórico.
      title: { pt-BR: "Cancelamento aprovado", en: "Cancellation approved" }
      // REVIEW [2026-12-15] Dados carregados pela aprovação.
      payload {
        // REVIEW [2026-12-15] Motivo registrado no cancelamento aprovado.
        cancellationReason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }

    // REVIEW [2026-12-15] Transição que recusa o cancelamento e devolve o pedido para Placed.
    transition Placed {
      // REVIEW [2026-12-15] Evento que dispara a devolução do pedido.
      event: CancellationRejected
      // REVIEW [2026-12-15] Título da transição exibido no histórico.
      title: { pt-BR: "Cancelamento recusado", en: "Cancellation rejected" }
      // REVIEW [2026-12-15] Dados carregados pela recusa.
      payload {
        // REVIEW [2026-12-15] Motivo registrado na recusa do cancelamento.
        cancellationReason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado Cancelamento aprovado, pronto para efetivar o cancelamento.
  value CancellationApproved {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Cancelamento aprovado", en: "Cancellation approved" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: CancellationApproved
    // REVIEW [2026-12-15] Ordem do estado na linha do tempo.
    ordinal: 50

    // REVIEW [2026-12-15] Transição que efetiva o cancelamento do pedido.
    transition Cancelled {
      // REVIEW [2026-12-15] Título da transição exibido no histórico.
      title: { pt-BR: "Pedido cancelado", en: "Order cancelled" }
      // REVIEW [2026-12-15] Dados carregados pelo cancelamento.
      payload {
        // REVIEW [2026-12-15] Motivo do cancelamento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
        // REVIEW [2026-12-15] Data do cancelamento.
        cancelledAt: DateTime { title: { pt-BR: "Cancelado em", en: "Cancelled at" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado Cancelado, estado final do ciclo de vida.
  value Cancelled {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Cancelado", en: "Cancelled" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Cancelled
    // REVIEW [2026-12-15] Ordem do estado na linha do tempo.
    ordinal: 60

    // REVIEW [2026-12-15] Transição que reabre um pedido cancelado.
    transition Placed {
      // REVIEW [2026-12-15] Evento que dispara a reabertura do pedido.
      event: Reopened
      // REVIEW [2026-12-15] Título da transição exibido no histórico.
      title: { pt-BR: "Pedido reaberto", en: "Order reopened" }
      // REVIEW [2026-12-15] Dados carregados pela reabertura.
      payload {
        // REVIEW [2026-12-15] Data em que o pedido foi reaberto.
        reopenedAt: DateTime { title: { pt-BR: "Reaberto em", en: "Reopened at" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado Atendido, encerrando o pedido com entrega concluída.
  value Fulfilled {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Atendido", en: "Fulfilled" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Fulfilled
    // REVIEW [2026-12-15] Ordem do estado na linha do tempo.
    ordinal: 70
  }

  // REVIEW [2026-12-15] Formato de exibição simples do estado.
  format: plain
}

// REVIEW [2026-12-15] Política que exige aprovação de gerente para desconto acima de dez por cento.
policy OrderDiscount {
  // REVIEW [2026-12-15] Ponto de aplicação da política.
  appliesTo: Order.place
  // REVIEW [2026-12-15] Desconto acima de 10% do subtotal só passa com aprovação de gerente.
  rule: discount <= subtotal * 10% or approver.role == Manager
  // REVIEW [2026-12-15] Gravidade: bloqueia a operação até ser satisfeita.
  severity: require
  // REVIEW [2026-12-15] Mensagem exibida quando a política barra a operação.
  message: "Desconto acima de 10% exige gerente"
  // REVIEW [2026-12-15] Registra a avaliação da política na auditoria.
  audit: true
}
