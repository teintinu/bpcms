// REVIEW [2026-12-15] service: example.com/services/orders
// REVIEW [2026-12-15] Process: sintaxe atual (DSL_REFERENCE.md §4)

// REVIEW [2026-12-15] Declara o processo de cancelamento; o argumento é o pedido-sujeito da instância.
process OrderCancellation(order: Order) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Cancelamento de pedido", en: "Order cancellation" }
  // REVIEW [2026-12-15] Versão do artefato Process; diff e release comparam.
  version: 1
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Cancelar o pedido com motivo, liberar a reserva e reverter se falhar"
  }
  // REVIEW [2026-12-15] SLA brando do caso: alvo de lead time, não é timer.
  sla: 2d

  // REVIEW [2026-12-15] Gatilho: inicia uma instância quando o pedido emite CancellationRequested.
  on [Order.CancellationRequested]
  // REVIEW [2026-12-15] Chave de identidade, correlação e dedup da instância.
  key: order // REVIEW [2026-12-15] o caso é o próprio pedido

  // REVIEW [2026-12-15] Bloco externo: captura o timeout da análise de cancelamento.
  try {
    // REVIEW [2026-12-15] Abre o form para o gerente aprovar ou recusar o cancelamento.
    CancellationReview.show({ order })
  } catch (Timeout) { // REVIEW [2026-12-15] captura o timeout da análise
    // REVIEW [2026-12-15] O prazo da análise esgotou: reabre o pedido (compensação) e não cancela.
    Order.reopen()
    // REVIEW [2026-12-15] Encerra o caso no desfecho Rejected.
    return Rejected
  }

  // REVIEW [2026-12-15] Sem aprovação registrada no documento, o caso termina sem cancelar.
  if (order.status != CancellationApproved) {
    // REVIEW [2026-12-15] Retorna o desfecho em que o pedido segue ativo.
    return Rejected
  }

  // REVIEW [2026-12-15] Aplica o cancelamento no pedido usando o motivo informado na análise.
  Order.cancel({ reason: order.cancellationReason })

  // REVIEW [2026-12-15] Bloco que tenta liberar a reserva de estoque após o cancelamento.
  try {
    // REVIEW [2026-12-15] Chama o serviço de estoque para liberar a reserva do pedido.
    Inventory.Reservation.release()
  } catch (ReservationLocked) { // REVIEW [2026-12-15] captura a reserva ainda bloqueada
    // REVIEW [2026-12-15] Compensação explícita do cancelamento já aplicado.
    Order.reopen()
    // REVIEW [2026-12-15] Retorna o desfecho de não cancelado.
    return Rejected
  }

  // REVIEW [2026-12-15] Encerra no desfecho de sucesso do cancelamento.
  return Cancelled

  // REVIEW [2026-12-15] Declara o desfecho de sucesso do caso.
  end Cancelled {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Cancelado", en: "Cancelled" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: cancelled
  }
  // REVIEW [2026-12-15] Declara o desfecho de não cancelamento.
  end Rejected {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Não cancelado", en: "Not cancelled" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: failure
  }
}

// REVIEW [2026-12-15] Erro de negócio: a reserva de estoque está bloqueada.
error ReservationLocked {
  // REVIEW [2026-12-15] Título do erro exibido ao usuário.
  title: { pt-BR: "Reserva de estoque bloqueada", en: "Stock reservation locked" }
}

// REVIEW [2026-12-15] Form de decisão do gerente sobre o cancelamento.
form CancellationReview {
  // REVIEW [2026-12-15] Título exibido na inbox e na tarefa.
  title: { pt-BR: "Analisar cancelamento", en: "Review cancellation" }
  // REVIEW [2026-12-15] Documento que a tarefa manipula.
  document: Order
  // REVIEW [2026-12-15] Papéis que podem executar a tarefa.
  roles: [Manager]
  // REVIEW [2026-12-15] Prazo máximo para conclusão da tarefa.
  timeout: 2d
  // REVIEW [2026-12-15] Prioridade da tarefa na fila.
  priority: 70
  // REVIEW [2026-12-15] Modo de atribuição: puxada pelo usuário da fila.
  assign: pull

  // REVIEW [2026-12-15] Campos do pedido visíveis na tarefa.
  fields {
    // REVIEW [2026-12-15] Cliente do pedido.
    customer
    // REVIEW [2026-12-15] Total do pedido.
    total
    // REVIEW [2026-12-15] Situação atual do pedido.
    status
    // REVIEW [2026-12-15] Motivo registrado na solicitação de cancelamento.
    cancellationReason
  }

  // REVIEW [2026-12-15] Ações disponíveis na tarefa.
  actions {
    // REVIEW [2026-12-15] Aprova o cancelamento e leva o pedido a CancellationApproved.
    approve {
      // REVIEW [2026-12-15] Título do botão exibido na tarefa.
      title: { pt-BR: "Aprovar cancelamento", en: "Approve cancellation" }
      // REVIEW [2026-12-15] Chama a action do documento que aprova o cancelamento.
      calls: Order.approveCancellation
    }
    // REVIEW [2026-12-15] Recusa o cancelamento e devolve o pedido para Placed.
    reject {
      // REVIEW [2026-12-15] Título do botão exibido na tarefa.
      title: { pt-BR: "Recusar cancelamento", en: "Reject cancellation" }
      // REVIEW [2026-12-15] Chama a action do documento que recusa o cancelamento.
      calls: Order.rejectCancellation
    }
  }
}
