// REVIEW [2026-12-15] service: example.com/services/orders
// REVIEW [2026-12-15] Process: sintaxe atual (DSL_REFERENCE.md §4)

// REVIEW [2026-12-15] Declara o processo de entrada; o argumento é o pedido-sujeito da instância.
process OrderIntake(order: Order) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Entrada de pedido", en: "Order intake" }
  // REVIEW [2026-12-15] Versão do artefato Process; diff e release comparam.
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Levar o rascunho à confirmação e reservar o estoque"
  }
  // REVIEW [2026-12-15] SLA brando do caso: alvo de lead time, não é timer.
  sla: "2d"

  // REVIEW [2026-12-15] Gatilho: inicia uma instância quando o pedido emite Drafted.
  on [Order.Drafted]
  // REVIEW [2026-12-15] Chave de identidade, correlação e dedup da instância.
  key: order // REVIEW [2026-12-15] o caso é o próprio pedido

  // REVIEW [2026-12-15] Variável durável que percorre cada item do pedido.
  let item: OrderItem

  // REVIEW [2026-12-15] Bloco externo: captura o timeout da revisão do rascunho.
  try {
    // REVIEW [2026-12-15] Abre o form para o atendente revisar e confirmar o rascunho.
    DraftReview.show({ order })
  } catch (Timeout) { // REVIEW [2026-12-15] captura o timeout da revisão
    // REVIEW [2026-12-15] O prazo da revisão esgotou: expira o rascunho cancelando o pedido.
    Order.cancel({ reason: "Rascunho expirado sem confirmação do cliente" })
    // REVIEW [2026-12-15] Encerra o caso no desfecho Expired.
    return Expired
  }

  // REVIEW [2026-12-15] Se o pedido já foi cancelado durante a revisão, o caso termina.
  if (order.status == Cancelled) {
    // REVIEW [2026-12-15] Retorna o desfecho de cancelamento.
    return Cancelled
  }

  // REVIEW [2026-12-15] Bloco que tenta reservar o estoque de todos os itens.
  try {
    // REVIEW [2026-12-15] Reserva em paralelo um item por vez, acelerando pedidos com vários itens.
    parallel each item in order.items {
      // REVIEW [2026-12-15] Chama o estoque pedindo a reserva do item.
      Inventory.Reservation.request({
        // REVIEW [2026-12-15] Produto a reservar.
        product: item.product,
        // REVIEW [2026-12-15] Quantidade solicitada do produto.
        quantity: item.quantity,
        // REVIEW [2026-12-15] Referência externa que correlaciona a reserva ao pedido.
        externalRef: order.id
      })
    }
  } catch (StockOut) { // REVIEW [2026-12-15] captura a falta de estoque
    // REVIEW [2026-12-15] Sem estoque suficiente: avisa o cliente e encerra o caso.
    Unavailable.show({ order })
    // REVIEW [2026-12-15] Retorna o desfecho de falta de estoque.
    return OutOfStock
  }

  // REVIEW [2026-12-15] Confirma no documento que todos os itens foram reservados.
  Order.confirmReservation()
  // REVIEW [2026-12-15] Encerra no desfecho de sucesso da reserva.
  return Reserved

  // REVIEW [2026-12-15] Declara o desfecho de sucesso do caso.
  end Reserved {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Reservado", en: "Reserved" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }
  // REVIEW [2026-12-15] Declara o desfecho de cancelamento do caso.
  end Cancelled {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Cancelado", en: "Cancelled" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: cancelled
  }
  // REVIEW [2026-12-15] Declara o desfecho de falta de estoque.
  end OutOfStock {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Sem estoque", en: "Out of stock" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: failure
  }
  // REVIEW [2026-12-15] Declara o desfecho de expiração do prazo.
  end Expired {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Expirado", en: "Expired" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: failure
  }
}

// REVIEW [2026-12-15] Erro de negócio: estoque insuficiente para reservar os itens.
error StockOut {
  // REVIEW [2026-12-15] Título do erro exibido ao usuário.
  title: { pt-BR: "Estoque insuficiente", en: "Out of stock" }
}

// REVIEW [2026-12-15] Form de revisão do rascunho antes de confirmar o pedido.
form DraftReview {
  // REVIEW [2026-12-15] Título exibido na inbox e na tarefa.
  title: { pt-BR: "Revisar rascunho do pedido", en: "Review order draft" }
  // REVIEW [2026-12-15] Documento que a tarefa manipula.
  document: Order
  // REVIEW [2026-12-15] Papéis que podem executar a tarefa.
  roles: [Clerk]
  // REVIEW [2026-12-15] Prazo máximo para conclusão da tarefa.
  timeout: 2d
  // REVIEW [2026-12-15] Prioridade da tarefa na fila.
  priority: 50
  // REVIEW [2026-12-15] Modo de atribuição: puxada pelo usuário da fila.
  assign: pull

  // REVIEW [2026-12-15] Campos do pedido e entradas livres exibidos na tarefa.
  fields {
    // REVIEW [2026-12-15] Cliente do pedido.
    customer
    // REVIEW [2026-12-15] Itens do pedido.
    items
    // REVIEW [2026-12-15] Total do pedido.
    total
    // REVIEW [2026-12-15] Motivo do cancelamento, caso o atendente cancele.
    reason: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Motivo do cancelamento", en: "Cancellation reason" }
      // REVIEW [2026-12-15] Limita o motivo a quinhentos caracteres.
      maxLength: 500
    }
    // REVIEW [2026-12-15] Observação livre digitada pelo atendente.
    note: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Observação", en: "Note" }
      // REVIEW [2026-12-15] Limita a observação a quinhentos caracteres.
      maxLength: 500
    }
  }

  // REVIEW [2026-12-15] Ações disponíveis na tarefa.
  actions {
    // REVIEW [2026-12-15] Confirma o pedido e o leva à situação Placed.
    confirm {
      // REVIEW [2026-12-15] Título do botão exibido na tarefa.
      title: { pt-BR: "Confirmar pedido", en: "Confirm order" }
      // REVIEW [2026-12-15] Chama a action do documento que realiza o pedido.
      calls: Order.place
    }
    // REVIEW [2026-12-15] Cancela o pedido com o motivo informado.
    cancel {
      // REVIEW [2026-12-15] Título do botão exibido na tarefa.
      title: { pt-BR: "Cancelar pedido", en: "Cancel order" }
      // REVIEW [2026-12-15] Chama a action do documento passando o motivo preenchido.
      calls: Order.cancel(reason)
    }
    // REVIEW [2026-12-15] Salva a observação sem sair da tarefa.
    save {
      // REVIEW [2026-12-15] Título do botão exibido na tarefa.
      title: { pt-BR: "Salvar observação", en: "Save note" }
      // REVIEW [2026-12-15] Chama a action do documento que grava a observação.
      calls: Order.annotate(note)
      // REVIEW [2026-12-15] Mantém a tarefa aberta após salvar.
      stay
    }
  }
}

// REVIEW [2026-12-15] Tarefa manual para avisar o cliente sobre a falta de estoque.
manual Unavailable {
  // REVIEW [2026-12-15] Título exibido na inbox e na tarefa.
  title: { pt-BR: "Avisar cliente da falta de estoque", en: "Notify customer of stock outage" }
  // REVIEW [2026-12-15] Documento que a tarefa manipula.
  document: Order
  // REVIEW [2026-12-15] Papéis que podem executar a tarefa.
  roles: [Clerk]
  // REVIEW [2026-12-15] Instruções mostradas ao executor da tarefa.
  instructions: "Avisar o cliente da falta de estoque e sugerir substitutos"
  // REVIEW [2026-12-15] Prazo máximo para conclusão da tarefa.
  timeout: 2h
  // REVIEW [2026-12-15] Prioridade da tarefa na fila.
  priority: 50
  // REVIEW [2026-12-15] Modo de atribuição: puxada pelo usuário da fila.
  assign: pull
}
