// REVIEW [2026-12-15] Declara o serviço de pedidos pela URI canônica do exemplo.
service "example.com/services/orders" {
  // REVIEW [2026-12-15] Título legível do serviço exibido no builder e na navegação.
  title: { pt-BR: "Pedidos", en: "Orders" }
  locales: [ "pt-BR", "en" ] // REVIEW [2026-12-18] Idiomas suportados pelo serviço; o primeiro é o default do I18N em forma de string.
  // REVIEW [2026-12-15] Versão do serviço; release e diff comparam este número.
  // REVIEW [2026-12-15] Área responsável pelo serviço.
  // REVIEW [2026-12-15] Dependências externas usadas pelos artefatos deste serviço.
  imports {
    // REVIEW [2026-12-15] Importa o pseudo-serviço de medidas e constantes padrão.
    service "bpcms.org/std" as std
    // REVIEW [2026-12-15] Importa o catálogo para referenciar Product.
    service "example.com/services/catalog" as Catalog
    // REVIEW [2026-12-15] Importa o estoque para reservar e liberar itens.
    service "example.com/services/inventory" as Inventory
    // REVIEW [2026-12-15] Importa a identidade para referenciar User.
    service "example.com/services/identity" as Identity
  }
}
