// REVIEW [2026-12-15] service: example.com/services/orders

// REVIEW [2026-12-15] View de inbox que mostra as tarefas de pedido atribuídas ao atendente.
view SalesInbox {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Minha fila de pedidos", en: "My order queue" }
  // REVIEW [2026-12-15] Tipo da view: fila de trabalho.
  type: inbox
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [Clerk]
  // REVIEW [2026-12-15] Escopo da fila: apenas itens do próprio usuário.
  scope: mine
  // REVIEW [2026-12-15] Agrupa as tarefas pelo processo de origem.
  groupBy: process
  // REVIEW [2026-12-15] Colunas exibidas na lista.
  columns { title; subject; role; dueAt; priority }
}
