// REVIEW [2026-12-15] service: example.com/services/orders

// REVIEW [2026-12-15] View de painel que mostra o pulso operacional dos pedidos.
view OrderPulse {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Pulso dos pedidos", en: "Order pulse" }
  // REVIEW [2026-12-15] Tipo da view: painel.
  type: dashboard
  // REVIEW [2026-12-15] Documentos consultados pelo painel.
  sources: [Order]
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [Manager]
  // REVIEW [2026-12-15] Atualização em tempo real do painel.
  mode: live

  // REVIEW [2026-12-15] Filtros disponíveis no painel.
  filters { status }
  // REVIEW [2026-12-15] Métricas calculadas sobre os pedidos.
  metrics {
    // REVIEW [2026-12-15] Pedidos em rascunho aguardando revisão.
    awaitingReview: count(Order) where status == Draft
    // REVIEW [2026-12-15] Pedidos realizados aguardando reserva.
    awaitingReservation: count(Order) where status == Placed
    // REVIEW [2026-12-15] Pedidos aguardando decisão de cancelamento.
    awaitingDecision: count(Order) where status == CancellationRequested
  }
  // REVIEW [2026-12-15] Idade máxima dos dados antes de atualizar.
  freshness: 5m
}
