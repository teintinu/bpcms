// REVIEW [2026-12-15] service: example.com/services/orders

// REVIEW [2026-12-15] View de detalhe que mostra um pedido e permite operá-lo.
view OrderDetail {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Detalhe do pedido", en: "Order detail" }
  // REVIEW [2026-12-15] Tipo da view: detalhe.
  type: detail
  // REVIEW [2026-12-15] Documento exibido no detalhe.
  document: Order
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [Clerk, Manager]

  // REVIEW [2026-12-15] Seções fixas exibidas no detalhe.
  sections { summary; items; timeline }
  // REVIEW [2026-12-15] Ações disponíveis no detalhe.
  actions {
    // REVIEW [2026-12-15] Abre a view de andamento do processo.
    progress -> OrderProgress
    // REVIEW [2026-12-15] Cancela o pedido informando o motivo.
    cancel -> Order.cancel(reason)
    // REVIEW [2026-12-15] Reabre o pedido cancelado.
    reopen -> Order.reopen
  }
}
