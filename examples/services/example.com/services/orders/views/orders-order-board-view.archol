// REVIEW [2026-12-15] service: example.com/services/orders

// REVIEW [2026-12-15] View de quadro kanban que agrupa os pedidos por situação.
view OrderBoard {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Quadro de pedidos", en: "Order board" }
  // REVIEW [2026-12-15] Tipo da view: quadro kanban.
  type: kanban
  // REVIEW [2026-12-15] Documento fonte do quadro.
  source: Order
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [Clerk, Manager]

  // REVIEW [2026-12-15] Campo usado para formar as colunas do quadro.
  groupBy: status
  // REVIEW [2026-12-15] Campos exibidos em cada cartão.
  card { customer; total; placedAt }
  // REVIEW [2026-12-15] Filtro que esconde pedidos cancelados.
  filter { status != Cancelled }
  // REVIEW [2026-12-15] Ações disponíveis no quadro.
  actions {
    // REVIEW [2026-12-15] Abre o detalhe do pedido do cartão.
    open -> OrderDetail
  }
}
