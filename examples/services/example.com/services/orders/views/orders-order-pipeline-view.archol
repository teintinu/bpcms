// REVIEW [2026-12-15] service: example.com/services/orders

// REVIEW [2026-12-15] View de relatório que acompanha o funil de pedidos.
view OrderPipeline {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Funil de pedidos", en: "Order pipeline" }
  // REVIEW [2026-12-15] Tipo da view: relatório.
  type: report
  // REVIEW [2026-12-15] Documentos consultados pelo relatório.
  sources: [Order]
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [Manager]

  // REVIEW [2026-12-15] Filtros disponíveis no relatório.
  filters { period; status }
  // REVIEW [2026-12-15] Métricas calculadas sobre os pedidos.
  metrics {
    // REVIEW [2026-12-15] Conta os pedidos na situação Placed.
    placed: count(Order) where status == Placed
    // REVIEW [2026-12-15] Conta os pedidos na situação Cancelled.
    cancelled: count(Order) where status == Cancelled
    // REVIEW [2026-12-15] Soma o total dos pedidos não cancelados.
    revenue: sum(Order.total) where status != Cancelled
    // REVIEW [2026-12-15] Calcula o ticket médio dos pedidos.
    avgTicket: avg(Order.total)
  }
  // REVIEW [2026-12-15] Unidades monetárias das métricas.
  units { revenue: BRL; avgTicket: BRL }
  // REVIEW [2026-12-15] Idade máxima dos dados antes de atualizar.
  freshness: 10m
  // REVIEW [2026-12-15] Formatos de exportação disponíveis.
  export: [pdf, csv]
}
