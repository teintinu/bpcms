// REVIEW [2026-12-15] service: example.com/services/orders

// REVIEW [2026-12-15] View de tabela que lista os pedidos para a operação.
view OrderList {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Pedidos", en: "Orders" }
  // REVIEW [2026-12-15] Tipo da view: tabela.
  type: table
  // REVIEW [2026-12-15] Documento fonte da lista.
  source: Order
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [Clerk, Manager]

  // REVIEW [2026-12-15] Colunas exibidas na tabela.
  columns { customer; total; status; placedAt }
  // REVIEW [2026-12-15] Filtros disponíveis na tabela.
  filters { status; period; customer }
  // REVIEW [2026-12-15] Quantidade de linhas por página.
  pagination: 50

  // REVIEW [2026-12-15] Ações disponíveis na lista.
  actions {
    // REVIEW [2026-12-15] Abre o detalhe do pedido selecionado.
    open -> OrderDetail
    // REVIEW [2026-12-15] Cria um novo pedido a partir da lista.
    newOrder -> Order.create(customer, discount)
    // REVIEW [2026-12-15] Solicita o cancelamento do pedido selecionado.
    requestCancellation -> Order.requestCancellation(reason)
  }
}
