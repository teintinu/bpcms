// REVIEW [2026-12-15] service: example.com/services/orders

// REVIEW [2026-12-15] Organograma que define a hierarquia de papéis do serviço de pedidos.
organogram Sales {
  // REVIEW [2026-12-15] Título exibido na interface de administração.
  title: { pt-BR: "Organograma de vendas", en: "Sales organogram" }

  // REVIEW [2026-12-15] Estrutura de subordinação entre os papéis.
  hierarchy {
    Manager > Clerk > Customer // REVIEW [2026-12-15] gerente acima do atendente, que está acima do cliente
  }

}

// REVIEW [2026-12-15] Papel do cliente: acompanha e solicita cancelamento dos próprios pedidos.
role Customer {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Cliente", en: "Customer" }
  // REVIEW [2026-12-15] Permissões concedidas ao papel.
  permissions: [order.viewOwn, order.requestCancellation]
}

// REVIEW [2026-12-15] Papel do atendente: cria e gerencia os pedidos.
role Clerk {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Atendente de pedidos", en: "Order clerk" }
  // REVIEW [2026-12-15] Herda as permissões do papel Customer.
  inherits: Customer
  // REVIEW [2026-12-15] Permissões concedidas ao papel.
  permissions: [order.manage, order.create, order.cancel]
}

// REVIEW [2026-12-15] Papel do gerente: decide cancelamentos e reabre pedidos.
role Manager {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Gerente de pedidos", en: "Order manager" }
  // REVIEW [2026-12-15] Herda as permissões do papel Clerk.
  inherits: Clerk
  // REVIEW [2026-12-15] Permissões concedidas ao papel.
  permissions: [order.cancel, order.reopen, report.view]
}

// REVIEW [2026-12-15] Papel do motor de pedidos: reserva e atende pedidos automaticamente.
role OrderEngine {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Motor de pedidos", en: "Order engine" }
  // REVIEW [2026-12-15] Permissões concedidas ao papel.
  permissions: [order.reserve, order.fulfill]
}
