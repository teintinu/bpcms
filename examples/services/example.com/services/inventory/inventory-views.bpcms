// service: example.com/services/inventory
// Views compartilhadas do serviço de estoque.

// Relatório de envelhecimento do estoque por armazém e categoria.
view StockAging {
  // Título exibido na navegação.
  title: { pt-BR: "Envelhecimento de estoque", en: "Inventory aging" }
  // Tipo da view: relatório analítico.
  type: report
  // Fontes de dados consultadas pelo relatório.
  sources: [StockItem, Product]
  // Papéis autorizados a abrir o relatório.
  roles: [StockManager]

  // Filtros disponíveis na tela do relatório.
  filters { warehouse; category }

  // Métricas calculadas sobre as fontes do relatório.
  metrics {
    // Soma da quantidade disponível de todos os itens.
    quantity: sum(StockItem.available)
    // Valor financeiro do estoque disponível.
    value: sum(StockItem.available * Product.price)
    // Faixas de envelhecimento pela data da última movimentação.
    aging: bucket(StockItem.lastMovement, [30d, 60d, 90d, 180d])
  }

  // Recalcula os dados a cada 15 minutos (cache).
  freshness: 15m
  // Formatos de exportação oferecidos ao usuário.
  export: [csv, xlsx]
}

// Fila de contagens pendentes para operadores e gestores.
view CountInbox {
  // Título exibido na navegação.
  title: { pt-BR: "Fila de contagens", en: "Count queue" }
  // Tipo da view: caixa de entrada de tarefas.
  type: inbox
  // Papéis que enxergam esta fila.
  roles: [WarehouseOperator, StockManager]

  // Escopo da fila: apenas tarefas atribuídas aos papéis do usuário.
  scope: roles
  // Filtro que restringe as tarefas aos papéis do usuário atual.
  filter { role in currentUser.roles }
  // Agrupa os cartões pelo processo de origem.
  groupBy: process
  // Colunas exibidas em cada item da fila.
  columns { title; subject; role; dueAt; priority }
}
