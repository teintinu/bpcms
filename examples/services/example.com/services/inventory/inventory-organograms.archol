// REVIEW [2026-12-15] service: example.com/services/inventory
// REVIEW [2026-12-15] Organograma e papéis do serviço de estoque.

// REVIEW [2026-12-15] Organograma que estrutura a hierarquia de suprimentos.
organogram Supply {
  // REVIEW [2026-12-15] Título exibido na administração de papéis.
  title: { pt-BR: "Organograma de suprimentos", en: "Supply organogram" }

  // REVIEW [2026-12-15] Bloco da hierarquia de subordinação entre os papéis.
  hierarchy {
    // REVIEW [2026-12-15] O gerente de estoque chefia o operador de armazém.
    StockManager > WarehouseOperator
  }

}

// REVIEW [2026-12-15] Papel operacional que executa contagens, ajustes e reservas no armazém.
role WarehouseOperator {
  // REVIEW [2026-12-15] Título exibido na atribuição de papéis.
  title: { pt-BR: "Operador de armazém", en: "Warehouse operator" }
  // REVIEW [2026-12-15] Permissões operacionais concedidas a este papel.
  permissions: [stock.view, stock.count, stock.adjust, stock.reserve]
}

// REVIEW [2026-12-15] Papel de gestão que aprova, repõe e bloqueia estoque.
role StockManager {
  // REVIEW [2026-12-15] Título exibido na atribuição de papéis.
  title: { pt-BR: "Gerente de estoque", en: "Inventory manager" }
  // REVIEW [2026-12-15] Herda todas as permissões do operador de armazém.
  inherits: WarehouseOperator
  // REVIEW [2026-12-15] Permissões adicionais exclusivas da gestão.
  permissions: [stock.approve, stock.replenish, stock.block, report.view]
}
