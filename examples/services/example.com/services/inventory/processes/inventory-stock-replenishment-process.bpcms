// service: example.com/services/inventory
// Process: sintaxe atual (DSL_REFERENCE.md §4)
// Processo agendado que repõe os itens de estoque abaixo do ponto de pedido.

// Declara o processo StockReplenishment; o argumento é o documento-sujeito da instância.
process StockReplenishment(stockItem: StockItem) {
  // Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Reposição de estoque", en: "Stock replenishment" }
  // Versão do artefato Process; diff e release comparam.
  version: 1
  // Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // Texto do objetivo em português.
    pt-BR: "Identificar itens abaixo do ponto de pedido e criar a requisição de compra"
  }

  // Agenda diária às 5h para varrer os itens de estoque.
  schedule: "0 5 * * *"
  // Cria uma instância por item cujo disponível esteja no ponto de pedido.
  fanOut: StockItem where available <= reorderPoint
  // Chave de identidade, correlação e dedup da instância.
  key: stockItem

  // Variável durável da instância: decisão de reposição do item.
  let decision: ReorderDecision

  // Avalia o ponto de pedido do item e guarda a decisão retornada.
  decision = ReorderPoint.evaluate({
    // Quantidade atualmente disponível no armazém.
    available: stockItem.available,
    // Nível que dispara a reposição.
    reorderPoint: stockItem.reorderPoint
  })

  // Se a decisão indicar que o item precisa ser reposto...
  if (decision == Reorder) {
    // ...cria a requisição de reposição para o item.
    ReplenishmentRequest.create({ stockItem })
    // Encerra no desfecho Requested.
    return Requested
  }

  // Sem necessidade de reposição, encerra no desfecho NotNeeded.
  return NotNeeded

  // Declara o desfecho de requisição criada.
  end Requested {
    // Título exibido no histórico e nos filtros.
    title: { pt-BR: "Reposição solicitada", en: "Replenishment requested" }
    // Classificação do desfecho para KPI.
    outcome: success
  }

  // Declara o desfecho de estoque suficiente.
  end NotNeeded {
    // Título exibido no histórico.
    title: { pt-BR: "Sem reposição", en: "No replenishment needed" }
    // Classificação do desfecho para KPI.
    outcome: success
  }
}

// Shape de classificação que expressa a decisão de reposição.
shape ReorderDecision {
  // Título exibido no builder e nos filtros.
  title: { pt-BR: "Decisão de reposição", en: "Reorder decision" }
  // Base do shape: classificação (sem transições).
  base: classification
  // Classificação de que o item precisa ser reposto.
  value Reorder {
    // Título exibido na interface.
    title: { pt-BR: "Repor", en: "Reorder" }
    // Ícone associado à classificação.
    icon: Reorder
    // Ordem de exibição da classificação no fluxo.
    ordinal: 10
  }
  // Classificação de que o estoque é suficiente.
  value Ok {
    // Título exibido na interface.
    title: { pt-BR: "Suficiente", en: "Sufficient" }
    // Ícone associado à classificação.
    icon: Ok
    // Ordem de exibição da classificação no fluxo.
    ordinal: 20
  }
  // Formato de apresentação do shape.
  format: plain
}

// Decisão de negócio que compara o disponível com o ponto de pedido.
decision ReorderPoint {
  // Título exibido no builder e na revisão.
  title: { pt-BR: "Ponto de pedido", en: "Reorder point" }
  // Área responsável pela decisão.
  owner: "Supply Chain"
  // Shape de classificação devolvido pela decisão.
  returns: ReorderDecision

  // Entradas necessárias para avaliar a decisão.
  inputs {
    // Quantidade atualmente disponível no armazém.
    available: std.Count
    // Nível que dispara a reposição.
    reorderPoint: std.Count
  }

  // Casos avaliados em ordem até o primeiro que casar.
  cases {
    // Se o disponível alcançou o ponto de pedido, decide repor.
    available <= reorderPoint -> Reorder
    // Caso contrário, considera o estoque suficiente.
    else -> Ok
  }
}
