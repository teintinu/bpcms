// REVIEW [2026-12-15] service: example.com/services/inventory
// REVIEW [2026-12-15] Process: sintaxe atual (DSL_REFERENCE.md §4)
// REVIEW [2026-12-15] Processo agendado que repõe os itens de estoque abaixo do ponto de pedido.

// REVIEW [2026-12-15] Declara o processo StockReplenishment; o argumento é o documento-sujeito da instância.
process StockReplenishment(stockItem: StockItem) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Reposição de estoque", en: "Stock replenishment" }
  // REVIEW [2026-12-15] Versão do artefato Process; diff e release comparam.
  version: 1
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Identificar itens abaixo do ponto de pedido e criar a requisição de compra"
  }

  // REVIEW [2026-12-15] Agenda diária às 5h para varrer os itens de estoque.
  schedule: "0 5 * * *"
  // REVIEW [2026-12-15] Cria uma instância por item cujo disponível esteja no ponto de pedido.
  fanOut: StockItem where available <= reorderPoint
  // REVIEW [2026-12-15] Chave de identidade, correlação e dedup da instância.
  key: stockItem

  // REVIEW [2026-12-15] Variável durável da instância: decisão de reposição do item.
  let decision: ReorderDecision

  // REVIEW [2026-12-15] Avalia o ponto de pedido do item e guarda a decisão retornada.
  decision = ReorderPoint.evaluate({
    // REVIEW [2026-12-15] Quantidade atualmente disponível no armazém.
    available: stockItem.available,
    // REVIEW [2026-12-15] Nível que dispara a reposição.
    reorderPoint: stockItem.reorderPoint
  })

  // REVIEW [2026-12-15] Se a decisão indicar que o item precisa ser reposto...
  if (decision == Reorder) {
    // REVIEW [2026-12-15] ...cria a requisição de reposição para o item.
    ReplenishmentRequest.create({ stockItem })
    // REVIEW [2026-12-15] Encerra no desfecho Requested.
    return Requested
  }

  // REVIEW [2026-12-15] Sem necessidade de reposição, encerra no desfecho NotNeeded.
  return NotNeeded

  // REVIEW [2026-12-15] Declara o desfecho de requisição criada.
  end Requested {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Reposição solicitada", en: "Replenishment requested" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }

  // REVIEW [2026-12-15] Declara o desfecho de estoque suficiente.
  end NotNeeded {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Sem reposição", en: "No replenishment needed" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }
}

// REVIEW [2026-12-15] Shape de classificação que expressa a decisão de reposição.
shape ReorderDecision {
  // REVIEW [2026-12-15] Título exibido no builder e nos filtros.
  title: { pt-BR: "Decisão de reposição", en: "Reorder decision" }
  // REVIEW [2026-12-15] Base do shape: classificação (sem transições).
  base: classification
  // REVIEW [2026-12-15] Classificação de que o item precisa ser reposto.
  value Reorder {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Repor", en: "Reorder" }
    // REVIEW [2026-12-15] Ícone associado à classificação.
    icon: Reorder
    // REVIEW [2026-12-15] Ordem de exibição da classificação no fluxo.
    ordinal: 10
  }
  // REVIEW [2026-12-15] Classificação de que o estoque é suficiente.
  value Ok {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Suficiente", en: "Sufficient" }
    // REVIEW [2026-12-15] Ícone associado à classificação.
    icon: Ok
    // REVIEW [2026-12-15] Ordem de exibição da classificação no fluxo.
    ordinal: 20
  }
  // REVIEW [2026-12-15] Formato de apresentação do shape.
  format: plain
}

// REVIEW [2026-12-15] Decisão de negócio que compara o disponível com o ponto de pedido.
decision ReorderPoint {
  // REVIEW [2026-12-15] Título exibido no builder e na revisão.
  title: { pt-BR: "Ponto de pedido", en: "Reorder point" }
  // REVIEW [2026-12-15] Área responsável pela decisão.
  owner: "Supply Chain"
  // REVIEW [2026-12-15] Shape de classificação devolvido pela decisão.
  returns: ReorderDecision

  // REVIEW [2026-12-15] Entradas necessárias para avaliar a decisão.
  inputs {
    // REVIEW [2026-12-15] Quantidade atualmente disponível no armazém.
    available: std.Count
    // REVIEW [2026-12-15] Nível que dispara a reposição.
    reorderPoint: std.Count
  }

  // REVIEW [2026-12-15] Casos avaliados em ordem até o primeiro que casar.
  cases {
    // REVIEW [2026-12-15] Se o disponível alcançou o ponto de pedido, decide repor.
    available <= reorderPoint -> Reorder
    // REVIEW [2026-12-15] Caso contrário, considera o estoque suficiente.
    else -> Ok
  }
}
