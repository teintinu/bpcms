// REVIEW [2026-12-15] service: example.com/services/inventory
// REVIEW [2026-12-15] Process: sintaxe atual (DSL_REFERENCE.md §4)
// REVIEW [2026-12-15] Processo que conduz a contagem cíclica de um item até a aprovação ou rejeição.

// REVIEW [2026-12-15] Declara o processo CycleCount; o argumento é o documento-sujeito da instância.
process CycleCount(countSheet: CountSheet) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Contagem cíclica", en: "Cycle count" }
  // REVIEW [2026-12-15] Versão do artefato Process; diff e release comparam.
  version: 1
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Contar o estoque com leitura de dispositivo, tratar divergência e aprovar"
  }

  // REVIEW [2026-12-15] Gatilho: inicia uma instância quando a folha de contagem é criada.
  on [CountSheet.Created]
  // REVIEW [2026-12-15] Chave de identidade, correlação e dedup da instância.
  key: countSheet

  // REVIEW [2026-12-15] Abre o form de captura para o operador registrar a contagem.
  CountCapture.show({ countSheet })
  // REVIEW [2026-12-15] Abre o form de aprovação para o gestor decidir sobre a contagem.
  CountApproval.show({ countSheet })

  // REVIEW [2026-12-15] Se a contagem foi aprovada no atendimento...
  if (countSheet.status == Approved) {
    // REVIEW [2026-12-15] ...encerra o processo no desfecho Approved.
    return Approved
  }

  // REVIEW [2026-12-15] Caso contrário, encerra no desfecho de rejeição.
  return Rejected

  // REVIEW [2026-12-15] Declara o desfecho de sucesso do caso.
  end Approved {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Contagem aprovada", en: "Count approved" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }

  // REVIEW [2026-12-15] Declara o desfecho de cancelamento do caso.
  end Rejected {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Contagem rejeitada", en: "Count rejected" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: cancelled
  }
}

// REVIEW [2026-12-15] Form de captura da contagem, preenchido pelo operador de armazém.
form CountCapture {
  // REVIEW [2026-12-15] Título exibido na inbox e na tela do form.
  title: { pt-BR: "Conferir contagem", en: "Check count" }
  // REVIEW [2026-12-15] Documento manipulado pelo form.
  document: CountSheet
  // REVIEW [2026-12-15] Papéis que podem atender o form.
  roles: [WarehouseOperator]
  // REVIEW [2026-12-15] Prazo para conclusão do form antes do timeout.
  timeout: 1d
  // REVIEW [2026-12-15] Prioridade de exibição na fila de trabalho.
  priority: 50
  // REVIEW [2026-12-15] Forma de atribuição: o operador puxa a tarefa da fila.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no form.
  fields {
    // REVIEW [2026-12-15] Item de estoque que está sendo contado.
    stockItem
    // REVIEW [2026-12-15] Quantidade esperada segundo o sistema.
    expected
    // REVIEW [2026-12-15] Quantidade informada pelo operador.
    counted
    // REVIEW [2026-12-15] Divergência calculada pelo documento.
    divergence
  }

  // REVIEW [2026-12-15] Ações disponíveis no form.
  actions {
    // REVIEW [2026-12-15] Envia a contagem chamando a action do documento.
    submit { calls: CountSheet.submit }
  }
}

// REVIEW [2026-12-15] Form de aprovação da contagem, preenchido pelo gestor.
form CountApproval {
  // REVIEW [2026-12-15] Título exibido na inbox e na tela do form.
  title: { pt-BR: "Aprovar contagem", en: "Approve count" }
  // REVIEW [2026-12-15] Documento manipulado pelo form.
  document: CountSheet
  // REVIEW [2026-12-15] Papéis que podem atender o form.
  roles: [StockManager]
  // REVIEW [2026-12-15] Prazo para conclusão do form antes do timeout.
  timeout: 1d
  // REVIEW [2026-12-15] Prioridade de exibição na fila de trabalho.
  priority: 60
  // REVIEW [2026-12-15] Forma de atribuição: o gestor puxa a tarefa da fila.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no form.
  fields {
    // REVIEW [2026-12-15] Item de estoque que está sendo avaliado.
    stockItem
    // REVIEW [2026-12-15] Quantidade registrada na contagem.
    counted
    // REVIEW [2026-12-15] Divergência apurada pelo documento.
    divergence
    // REVIEW [2026-12-15] Motivo opcional informado ao rejeitar.
    reason: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Motivo da rejeição", en: "Rejection reason" }
      // REVIEW [2026-12-15] Limite de caracteres do motivo.
      maxLength: 500
    }
  }

  // REVIEW [2026-12-15] Ações disponíveis no form.
  actions {
    // REVIEW [2026-12-15] Aprova a contagem chamando a action do documento.
    approve { calls: CountSheet.approve }
    // REVIEW [2026-12-15] Rejeita a contagem passando o motivo informado.
    reject { calls: CountSheet.reject(reason) }
  }
}

// REVIEW [2026-12-15] A task discricionária de recontagem foi removida nesta versão (CMMN adiado);
// REVIEW [2026-12-15] a action CountSheet.recount continua disponível no documento.
// REVIEW [2026-12-15] Form de recontagem, para conferir o item quando há divergência.
form RecountCapture {
  // REVIEW [2026-12-15] Título exibido na inbox e na tela do form.
  title: { pt-BR: "Recontagem", en: "Recount" }
  // REVIEW [2026-12-15] Documento manipulado pelo form.
  document: CountSheet
  // REVIEW [2026-12-15] Papéis que podem atender o form.
  roles: [WarehouseOperator]
  // REVIEW [2026-12-15] Prazo para conclusão do form antes do timeout.
  timeout: 1d
  // REVIEW [2026-12-15] Prioridade de exibição na fila de trabalho.
  priority: 50
  // REVIEW [2026-12-15] Forma de atribuição: o operador puxa a tarefa da fila.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no form.
  fields {
    // REVIEW [2026-12-15] Quantidade informada na recontagem.
    counted
    // REVIEW [2026-12-15] Divergência recalculada após a recontagem.
    divergence
  }

  // REVIEW [2026-12-15] Ações disponíveis no form.
  actions {
    // REVIEW [2026-12-15] Registra a recontagem chamando a action do documento.
    recount { calls: CountSheet.recount }
  }
}
