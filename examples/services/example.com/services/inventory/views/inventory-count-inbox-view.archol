// REVIEW [2026-12-15] service: example.com/services/inventory

// REVIEW [2026-12-15] Fila de contagens pendentes para operadores e gestores.
view CountInbox {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Fila de contagens", en: "Count queue" }
  // REVIEW [2026-12-15] Tipo da view: caixa de entrada de tarefas.
  type: inbox
  // REVIEW [2026-12-15] Papéis que enxergam esta fila.
  roles: [WarehouseOperator, StockManager]

  // REVIEW [2026-12-15] Escopo da fila: apenas tarefas atribuídas aos papéis do usuário.
  scope: roles
  // REVIEW [2026-12-15] Filtro que restringe as tarefas aos papéis do usuário atual.
  filter { role in currentUser.roles }
  // REVIEW [2026-12-15] Agrupa os cartões pelo processo de origem.
  groupBy: process
  // REVIEW [2026-12-15] Colunas exibidas em cada item da fila.
  columns { title; subject; role; dueAt; priority }
}
