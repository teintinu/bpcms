// REVIEW [2026-12-15] service: example.com/services/inventory

// REVIEW [2026-12-15] Painel de controle de estoque do gestor.
view StockControl {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Controle de estoque", en: "Stock control" }
  // REVIEW [2026-12-15] Tipo da view: painel com métricas.
  type: dashboard
  // REVIEW [2026-12-15] Fonte de dados do painel.
  sources: [StockItem]
  // REVIEW [2026-12-15] Papéis autorizados a abrir o painel.
  roles: [StockManager]
  // REVIEW [2026-12-15] Modo de atualização dos dados do painel.
  mode: live

  // REVIEW [2026-12-15] Filtro disponível no painel.
  filters { warehouse }

  // REVIEW [2026-12-15] Métricas calculadas sobre os itens de estoque.
  metrics {
    // REVIEW [2026-12-15] Conta os itens cujo disponível atingiu o ponto de reposição.
    lowStock: count(StockItem) where available <= reorderPoint
    // REVIEW [2026-12-15] Soma a quantidade reservada de todos os itens.
    reserved: sum(StockItem.reserved)
  }

  // REVIEW [2026-12-15] Recalcula os dados a cada 15 minutos (cache).
  freshness: 15m
}
