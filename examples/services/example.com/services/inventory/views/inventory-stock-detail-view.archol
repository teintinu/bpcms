// REVIEW [2026-12-15] service: example.com/services/inventory

// REVIEW [2026-12-15] Tela de detalhe de um item de estoque.
view StockDetail {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Detalhe do item", en: "Stock item detail" }
  // REVIEW [2026-12-15] Tipo da view: detalhe de documento.
  type: detail
  // REVIEW [2026-12-15] Documento exibido no detalhe.
  document: StockItem
  // REVIEW [2026-12-15] Papéis autorizados a abrir o detalhe.
  roles: [WarehouseOperator, StockManager]

  // REVIEW [2026-12-15] Seções fixas exibidas na tela de detalhe.
  sections { summary; movements }

  // REVIEW [2026-12-15] Ações disponíveis na tela de detalhe.
  actions {
    // REVIEW [2026-12-15] Ajusta o saldo do item.
    adjust -> StockItem.adjust(quantity, reason)
    // REVIEW [2026-12-15] Bloqueia o item.
    block -> StockItem.block(reason)
    // REVIEW [2026-12-15] Desbloqueia o item.
    unblock -> StockItem.unblock
  }
}
