// REVIEW [2026-12-15] service: example.com/services/inventory

// REVIEW [2026-12-15] Tabela paginada de itens de estoque.
view StockTable {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Itens de estoque", en: "Stock items" }
  // REVIEW [2026-12-15] Tipo da view: tabela de registros.
  type: table
  // REVIEW [2026-12-15] Documento exibido na tabela.
  source: StockItem
  // REVIEW [2026-12-15] Papéis autorizados a abrir a tabela.
  roles: [WarehouseOperator, StockManager]

  // REVIEW [2026-12-15] Colunas exibidas na tabela.
  columns { product; warehouse; available; reserved; reorderPoint; status }
  // REVIEW [2026-12-15] Filtros disponíveis na tabela.
  filters { warehouse; status; available }
  // REVIEW [2026-12-15] Quantidade de linhas por página.
  pagination: 50

  // REVIEW [2026-12-15] Ações disponíveis em cada linha da tabela.
  actions {
    // REVIEW [2026-12-15] Abre o detalhe do item selecionado.
    open -> StockDetail
    // REVIEW [2026-12-15] Ajusta o saldo do item direto da tabela.
    adjust -> StockItem.adjust(quantity, reason)
    // REVIEW [2026-12-15] Bloqueia o item direto da tabela.
    block -> StockItem.block(reason)
  }
}
