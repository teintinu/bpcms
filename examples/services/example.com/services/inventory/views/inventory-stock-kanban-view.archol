// service: example.com/services/inventory

// Quadro kanban do estoque agrupado por situação.
view StockKanban {
  // Título exibido na navegação.
  title: { pt-BR: "Estoque por situação", en: "Stock by status" }
  // Tipo da view: quadro kanban.
  type: kanban
  // Documento exibido no quadro.
  source: StockItem
  // Papéis autorizados a abrir o quadro.
  roles: [WarehouseOperator, StockManager]

  // Agrupa os cartões pela situação do item.
  groupBy: status
  // Colunas exibidas em cada cartão do quadro.
  columns { product; warehouse; available; reorderPoint }
  // Resumo exibido no cartão do kanban.
  card { product; warehouse; available; status }

  // Ações disponíveis nos cartões do quadro.
  actions {
    // Abre o detalhe do item selecionado.
    open -> StockDetail
  }
}
