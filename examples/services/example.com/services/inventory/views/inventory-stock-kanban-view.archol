// REVIEW [2026-12-15] service: example.com/services/inventory

// REVIEW [2026-12-15] Quadro kanban do estoque agrupado por situação.
view StockKanban {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Estoque por situação", en: "Stock by status" }
  // REVIEW [2026-12-15] Tipo da view: quadro kanban.
  type: kanban
  // REVIEW [2026-12-15] Documento exibido no quadro.
  source: StockItem
  // REVIEW [2026-12-15] Papéis autorizados a abrir o quadro.
  roles: [WarehouseOperator, StockManager]

  // REVIEW [2026-12-15] Agrupa os cartões pela situação do item.
  groupBy: status
  // REVIEW [2026-12-15] Colunas exibidas em cada cartão do quadro.
  columns { product; warehouse; available; reorderPoint }
  // REVIEW [2026-12-15] Resumo exibido no cartão do kanban.
  card { product; warehouse; available; status }

  // REVIEW [2026-12-15] Ações disponíveis nos cartões do quadro.
  actions {
    // REVIEW [2026-12-15] Abre o detalhe do item selecionado.
    open -> StockDetail
  }
}
