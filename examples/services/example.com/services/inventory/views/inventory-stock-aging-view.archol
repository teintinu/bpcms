// REVIEW [2026-12-15] service: example.com/services/inventory

// REVIEW [2026-12-15] Relatório de envelhecimento do estoque por armazém e categoria.
view StockAging {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Envelhecimento de estoque", en: "Inventory aging" }
  // REVIEW [2026-12-15] Tipo da view: relatório analítico.
  type: report
  // REVIEW [2026-12-15] Fontes de dados consultadas pelo relatório.
  sources: [StockItem, Product]
  // REVIEW [2026-12-15] Papéis autorizados a abrir o relatório.
  roles: [StockManager]

  // REVIEW [2026-12-15] Filtros disponíveis na tela do relatório.
  filters { warehouse; category }

  // REVIEW [2026-12-15] Métricas calculadas sobre as fontes do relatório.
  metrics {
    // REVIEW [2026-12-15] Soma da quantidade disponível de todos os itens.
    quantity: sum(StockItem.available)
    // REVIEW [2026-12-15] Valor financeiro do estoque disponível.
    value: sum(StockItem.available * Product.price)
    // REVIEW [2026-12-15] Faixas de envelhecimento pela data da última movimentação.
    aging: bucket(StockItem.lastMovement, [30d, 60d, 90d, 180d])
  }

  // REVIEW [2026-12-15] Recalcula os dados a cada 15 minutos (cache).
  freshness: 15m
  // REVIEW [2026-12-15] Formatos de exportação oferecidos ao usuário.
  export: [csv, xlsx]
}
