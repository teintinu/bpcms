// REVIEW [2026-12-15] service: example.com/services/inventory
// REVIEW [2026-12-15] Documento que registra a reserva de quantidade de um produto.
document Reservation {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e nos históricos.
  title: { pt-BR: "Reserva", en: "Reservation" }
  // REVIEW [2026-12-15] Versão do artefato Document; diff e release comparam.
  version: 1
  // REVIEW [2026-12-15] Área responsável pelo documento.
  owner: "Inventory"
  // REVIEW [2026-12-15] Sincronização em tempo real entre as instâncias do documento.
  sync: live

  // REVIEW [2026-12-15] Campos persistidos na reserva.
  fields {
    // REVIEW [2026-12-15] Produto cuja quantidade está sendo reservada.
    product: Product {
      // REVIEW [2026-12-15] Título exibido no formulário e nas colunas.
      title: { pt-BR: "Produto", en: "Product" }
      // REVIEW [2026-12-15] Permite buscar e filtrar pelo produto relacionado.
      lookup
    }
    // REVIEW [2026-12-15] Quantidade reservada do produto.
    quantity: std.Count { title: { pt-BR: "Quantidade", en: "Quantity" }, lookup }
    // REVIEW [2026-12-15] Referência do pedido externo que originou a reserva.
    externalRef: string { title: { pt-BR: "Referência externa", en: "External reference" } }
    // REVIEW [2026-12-15] Situação da reserva no shape ReservationStatus.
    status: ReservationStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    // REVIEW [2026-12-15] Data e hora em que a reserva deixa de valer.
    expiresAt: DateTime { title: { pt-BR: "Expira em", en: "Expires at" } }
  }

  // REVIEW [2026-12-15] Índices que aceleram as consultas mais frequentes.
  indexes {
    // REVIEW [2026-12-15] Busca exata da reserva pela referência externa.
    byExternal: [externalRef] hash
    // REVIEW [2026-12-15] Consulta das reservas vencidas por situação e validade.
    byExpiry: [status, expiresAt] range
  }


  // REVIEW [2026-12-15] Ações que alteram a reserva.
  actions {
    // REVIEW [2026-12-15] Cria a reserva a partir do produto, quantidade e referência externa.
    request(product: Product, quantity: std.Count, externalRef: string){
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Reservar", en: "Reserve" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [WarehouseOperator]
    }

    // REVIEW [2026-12-15] Libera a reserva antes do consumo.
    release(){
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Liberar", en: "Release" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [WarehouseOperator]

      // REVIEW [2026-12-15] Transição automática para a situação Released.
      to: status.Released
      // REVIEW [2026-12-15] Payload emitido na transição, transportando a data de liberação.
      emits { releasedAt: now() }
    }

    // REVIEW [2026-12-15] Expira a reserva quando o prazo vence.
    expire(){
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Expirar", en: "Expire" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [StockManager]

      // REVIEW [2026-12-15] Transição automática para a situação Expired.
      to: status.Expired
      // REVIEW [2026-12-15] Payload emitido na transição, transportando a data de expiração.
      emits { expiredAt: now() }
    }
  }

  // REVIEW [2026-12-15] A quantidade reservada deve ser positiva.
  rule quantity > 0 {
    // REVIEW [2026-12-15] Mensagem de validação em português.
    pt-BR: "A quantidade deve ser maior que zero"
    // REVIEW [2026-12-15] Mensagem de validação em inglês.
    en: "Quantity must be greater than zero"
  }
}

// REVIEW [2026-12-15] Shape de estado que modela o ciclo de vida da reserva.
shape ReservationStatus {
  // REVIEW [2026-12-15] Título exibido no builder e nos filtros.
  title: { pt-BR: "Situação da reserva", en: "Reservation status" }
  // REVIEW [2026-12-15] Base do shape: máquina de estados.
  base: state
  // REVIEW [2026-12-15] Estado inicial da reserva recém-criada.
  initial: Active
  // REVIEW [2026-12-15] Estado em que a reserva está ativa e ainda válida.
  value Active {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Ativo", en: "Active" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Active
    // REVIEW [2026-12-15] Ordem de exibição do estado no fluxo.
    ordinal: 10

    // REVIEW [2026-12-15] Transição para Released quando a reserva é liberada.
    transition Released {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Reserva liberada", en: "Reservation released" }
      // REVIEW [2026-12-15] Dados carregados pela transição de liberação.
      payload {
        // REVIEW [2026-12-15] Instante em que a reserva foi liberada.
        releasedAt: DateTime { title: { pt-BR: "Liberada em", en: "Released at" } }
      }
    }

    // REVIEW [2026-12-15] Transição para Expired quando o prazo da reserva vence.
    transition Expired {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Reserva expirada", en: "Reservation expired" }
      // REVIEW [2026-12-15] Dados carregados pela transição de expiração.
      payload {
        // REVIEW [2026-12-15] Instante em que a reserva expirou.
        expiredAt: DateTime { title: { pt-BR: "Expirada em", en: "Expired at" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado final de reserva liberada.
  value Released {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Liberada", en: "Released" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Released
    // REVIEW [2026-12-15] Ordem de exibição do estado no fluxo.
    ordinal: 20
  }
  // REVIEW [2026-12-15] Estado final de reserva expirada.
  value Expired {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Expirada", en: "Expired" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Expired
    // REVIEW [2026-12-15] Ordem de exibição do estado no fluxo.
    ordinal: 30
  }
  // REVIEW [2026-12-15] Formato de apresentação do shape.
  format: plain
}
