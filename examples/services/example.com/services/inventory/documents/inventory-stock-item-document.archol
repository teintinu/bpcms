// REVIEW [2026-12-15] service: example.com/services/inventory
// REVIEW [2026-12-15] Documento que mantém o saldo e a situação de estoque por produto e armazém.
document StockItem {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e nos históricos.
  title: { pt-BR: "Item de estoque", en: "Stock item" }
  // REVIEW [2026-12-15] Versão do artefato Document; diff e release comparam.
  // REVIEW [2026-12-15] Área responsável pelo documento.
  // REVIEW [2026-12-15] Sincronização em tempo real entre as instâncias do documento.
  sync: live
  // REVIEW [2026-12-15] Campos persistidos no item de estoque.
  fields {
    // REVIEW [2026-12-15] Produto ao qual este item de estoque se refere.
    product: Product {
      // REVIEW [2026-12-15] Título exibido no formulário e nas colunas.
      title: { pt-BR: "Produto", en: "Product" }
      // REVIEW [2026-12-15] Permite buscar e filtrar pelo produto relacionado.
      lookup
    }
    // REVIEW [2026-12-15] Armazém onde as unidades estão fisicamente guardadas.
    warehouse: string { title: { pt-BR: "Armazém", en: "Warehouse" }, maxLength: 40, lookup }
    // REVIEW [2026-12-15] Quantidade disponível para novas reservas.
    available: std.Count { title: { pt-BR: "Disponível", en: "Available" }, min: 0, max: 100000 }
    // REVIEW [2026-12-15] Quantidade já comprometida com reservas ativas.
    reserved: std.Count { title: { pt-BR: "Reservado", en: "Reserved" } }
    // REVIEW [2026-12-15] Nível de estoque que dispara a reposição.
    reorderPoint: std.Count { title: { pt-BR: "Ponto de reposição", en: "Reorder point" } }
    // REVIEW [2026-12-15] Situação do item no shape StockStatus.
    status: StockStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    // REVIEW [2026-12-15] Motivo informado quando o item é bloqueado.
    blockedReason: string { title: { pt-BR: "Motivo do bloqueio", en: "Block reason" } }
    // REVIEW [2026-12-15] Data e hora da última movimentação registrada.
    lastMovement: DateTime { title: { pt-BR: "Última movimentação", en: "Last movement" } }
  }

  // REVIEW [2026-12-15] Índices que aceleram as consultas mais frequentes.
  indexes {
    // REVIEW [2026-12-15] Garante um único item por produto em cada armazém.
    uniqueProduct: [product.id, warehouse] unique
    // REVIEW [2026-12-15] Consulta ordenada pela quantidade disponível.
    byAvailable: [available] range
    // REVIEW [2026-12-15] Consulta ordenada pela última movimentação.
    byMovement: [lastMovement] range
    // REVIEW [2026-12-15] Consulta por situação, ordenada pela última movimentação.
    byStatus: [status, lastMovement] range
  }


  // REVIEW [2026-12-15] Ações que alteram o item de estoque.
  actions {
    // REVIEW [2026-12-15] Ajusta manualmente a quantidade disponível com justificativa.
    adjust(quantity: std.Count, reason: string){
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Ajustar estoque", en: "Adjust stock" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [WarehouseOperator]
      // REVIEW [2026-12-15] Exige justificativa com pelo menos 10 caracteres.
      rule reason.length >= 10 {
        // REVIEW [2026-12-15] Mensagem de validação em português.
        pt-BR: "Informe um motivo com pelo menos 10 caracteres"
        // REVIEW [2026-12-15] Mensagem de validação em inglês.
        en: "Enter a reason with at least 10 characters"
      }
      {
        // REVIEW [2026-12-15] Soma o ajuste à quantidade disponível (pode ser negativo).
        available = available + quantity
      }
    }

    // REVIEW [2026-12-15] Reserva parte do estoque disponível.
    reserve(quantity: std.Count){
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Reservar", en: "Reserve" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [WarehouseOperator]

      // REVIEW [2026-12-15] Transição automática para a situação Reserved.
      to: status.Reserved

      {
        // REVIEW [2026-12-15] Soma a quantidade reservada ao saldo de reservas.
        reserved = reserved + quantity
      }
    }

    // REVIEW [2026-12-15] Libera quantidade previamente reservada.
    release(quantity: std.Count){
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Liberar", en: "Release" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [WarehouseOperator]

      // REVIEW [2026-12-15] Transição automática para a situação Available.
      to: status.Available

      {
        // REVIEW [2026-12-15] Devolve a quantidade reservada ao saldo disponível.
        reserved = reserved - quantity
      }
    }

    // REVIEW [2026-12-15] Bloqueia o item para novas movimentações.
    block(reason: string){
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Bloquear", en: "Block" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [StockManager]

      // REVIEW [2026-12-15] Transição automática para a situação Blocked.
      to: status.Blocked

      {
        // REVIEW [2026-12-15] Persiste o motivo informado no bloqueio.
        blockedReason = reason
      }
    }

    // REVIEW [2026-12-15] Desbloqueia o item devolvendo-o à situação Available.
    unblock(){
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Desbloquear", en: "Unblock" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [StockManager]

      // REVIEW [2026-12-15] Transição automática para a situação Available.
      to: status.Available
      // REVIEW [2026-12-15] Payload emitido na transição, transportando o instante do desbloqueio.
      emits { at: now() }
    }
  }

  // REVIEW [2026-12-15] O saldo disponível nunca pode ficar negativo.
  rule available >= 0 {
    // REVIEW [2026-12-15] Mensagem de validação em português.
    pt-BR: "Verifique os dados informados"
    // REVIEW [2026-12-15] Mensagem de validação em inglês.
    en: "Check the informed data"
  }
  // REVIEW [2026-12-15] O saldo reservado nunca pode ficar negativo.
  rule reserved >= 0 {
    // REVIEW [2026-12-15] Mensagem de validação em português.
    pt-BR: "Verifique os dados informados"
    // REVIEW [2026-12-15] Mensagem de validação em inglês.
    en: "Check the informed data"
  }
}

// REVIEW [2026-12-15] Shape de estado que modela o ciclo de vida do item de estoque.
shape StockStatus {
  // REVIEW [2026-12-15] Título exibido no builder e nos filtros.
  title: { pt-BR: "Situação do estoque", en: "Stock status" }
  // REVIEW [2026-12-15] Base do shape: máquina de estados.
  base: state
  // REVIEW [2026-12-15] Estado inicial do item recém-cadastrado.
  initial: Available
  // REVIEW [2026-12-15] Estado em que o item está disponível para reservas.
  value Available {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Disponível", en: "Available" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Available
    // REVIEW [2026-12-15] Ordem de exibição do estado no fluxo.
    ordinal: 10

    // REVIEW [2026-12-15] Transição para Reserved quando parte do estoque é reservada.
    transition Reserved {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Estoque reservado", en: "Stock reserved" }
      // REVIEW [2026-12-15] Dados carregados pela transição de reserva.
      payload {
        // REVIEW [2026-12-15] Quantidade reservada nesta transição.
        quantity: std.Count { title: { pt-BR: "Quantidade", en: "Quantity" } }
      }
    }

    // REVIEW [2026-12-15] Transição para Blocked quando o item é bloqueado.
    transition Blocked {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Estoque bloqueado", en: "Stock blocked" }
      // REVIEW [2026-12-15] Dados carregados pela transição de bloqueio.
      payload {
        // REVIEW [2026-12-15] Motivo do bloqueio informado pelo gestor.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado em que o item tem quantidade comprometida com reservas.
  value Reserved {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Reservado", en: "Reserved" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Reserved
    // REVIEW [2026-12-15] Ordem de exibição do estado no fluxo.
    ordinal: 20

    // REVIEW [2026-12-15] Transição de volta para Available quando a reserva é liberada.
    transition Available {
      // REVIEW [2026-12-15] Evento que dispara a transição de liberação.
      event: Released
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Estoque liberado", en: "Stock released" }
      // REVIEW [2026-12-15] Dados carregados pela transição de liberação.
      payload {
        // REVIEW [2026-12-15] Quantidade liberada nesta transição.
        quantity: std.Count { title: { pt-BR: "Quantidade", en: "Quantity" } }
      }
    }

    // REVIEW [2026-12-15] Transição para Blocked quando o item é bloqueado.
    transition Blocked {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Estoque bloqueado", en: "Stock blocked" }
      // REVIEW [2026-12-15] Dados carregados pela transição de bloqueio.
      payload {
        // REVIEW [2026-12-15] Motivo do bloqueio informado pelo gestor.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado em que o item está impedido de movimentar.
  value Blocked {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Bloqueado", en: "Blocked" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Blocked
    // REVIEW [2026-12-15] Ordem de exibição do estado no fluxo.
    ordinal: 30

    // REVIEW [2026-12-15] Transição de volta para Available quando o item é desbloqueado.
    transition Available {
      // REVIEW [2026-12-15] Evento que dispara a transição de desbloqueio.
      event: Unblocked
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Estoque desbloqueado", en: "Stock unblocked" }
      // REVIEW [2026-12-15] Dados carregados pela transição de desbloqueio.
      payload {
        // REVIEW [2026-12-15] Instante em que o item foi desbloqueado.
        at: DateTime { title: { pt-BR: "Em", en: "At" } }
      }
    }
  }
  // REVIEW [2026-12-15] Formato de apresentação do shape.
  format: plain
}

// REVIEW [2026-12-15] Política que exige justificativa nos ajustes de estoque.
policy StockAdjustment {
  // REVIEW [2026-12-15] Ação do documento à qual a política se aplica.
  appliesTo: StockItem.adjust
  // REVIEW [2026-12-15] Condição que precisa ser verdadeira para a ação seguir.
  rule: quantity != 0
  // REVIEW [2026-12-15] Severidade da política: exige atenção antes de prosseguir.
  severity: require
  // REVIEW [2026-12-15] Mensagem exibida quando a política é acionada.
  message: "Ajuste de estoque exige justificativa"
  // REVIEW [2026-12-15] Registra a avaliação da política na trilha de auditoria.
  audit: true
}
