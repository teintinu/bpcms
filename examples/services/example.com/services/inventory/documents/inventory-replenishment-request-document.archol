// REVIEW [2026-12-15] service: example.com/services/inventory
// REVIEW [2026-12-15] Documento que registra o pedido de reposição de um item de estoque.
document ReplenishmentRequest {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e nos históricos.
  title: { pt-BR: "Requisição de reposição", en: "Replenishment request" }
  // REVIEW [2026-12-15] Versão do artefato Document; diff e release comparam.
  // REVIEW [2026-12-15] Área responsável pelo documento.
  // REVIEW [2026-12-15] Sincronização em tempo real entre as instâncias do documento.
  sync: live

  // REVIEW [2026-12-15] Campos persistidos na requisição de reposição.
  fields {
    // REVIEW [2026-12-15] Referência ao item de estoque que precisa ser reposto.
    stockItem: StockItem {
      // REVIEW [2026-12-15] Título exibido no formulário e nas colunas.
      title: { pt-BR: "Item de estoque", en: "Stock item" }
      // REVIEW [2026-12-15] Permite buscar e filtrar pelo item relacionado.
      lookup
    }
    // REVIEW [2026-12-15] Quantidade solicitada de reposição.
    quantity: std.Count { title: { pt-BR: "Quantidade", en: "Quantity" }, lookup }
    // REVIEW [2026-12-15] Situação da requisição no shape RequisitionStatus.
    status: RequisitionStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    // REVIEW [2026-12-15] Data e hora em que a requisição foi criada.
    requestedAt: DateTime { title: { pt-BR: "Solicitada em", en: "Requested at" } }
    // REVIEW [2026-12-15] Motivo informado quando a requisição é cancelada.
    cancelledReason: string { title: { pt-BR: "Motivo do cancelamento", en: "Cancellation reason" } }
  }

  // REVIEW [2026-12-15] Índices que aceleram as consultas mais frequentes.
  indexes {
    // REVIEW [2026-12-15] Consulta por situação, ordenada pela data da solicitação.
    byStatus: [status, requestedAt] range
    // REVIEW [2026-12-15] Consulta por item, ordenada pela data da solicitação.
    byItem: [stockItem.id, requestedAt] range
  }


  // REVIEW [2026-12-15] Ações que alteram a requisição de reposição.
  actions {
    // REVIEW [2026-12-15] Cria a requisição para o item informado.
    create(stockItem: StockItem){
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Criar requisição", en: "Create request" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [StockManager]
      // REVIEW [2026-12-15] Documento devolvido pela ação após a criação.
      returns: ReplenishmentRequest
      {
        // REVIEW [2026-12-15] Sugere repor até o ponto de reposição do item.
        quantity = stockItem.reorderPoint
        // REVIEW [2026-12-15] Grava o instante da solicitação.
        requestedAt = now()
        // REVIEW [2026-12-15] Emite o evento de solicitação com a quantidade pedida.
        emit Requested { quantity }
      }
    }

    // REVIEW [2026-12-15] Cancela a requisição com um motivo obrigatório.
    cancel(reason: string){
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Cancelar requisição", en: "Cancel request" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [StockManager]

      // REVIEW [2026-12-15] Transição automática para a situação Cancelled.
      to: status.Cancelled

      {
        // REVIEW [2026-12-15] Persiste o motivo informado no cancelamento.
        cancelledReason = reason
      }
    }
  }
}

// REVIEW [2026-12-15] Shape de estado que modela o ciclo de vida da requisição.
shape RequisitionStatus {
  // REVIEW [2026-12-15] Título exibido no builder e nos filtros.
  title: { pt-BR: "Situação da requisição", en: "Requisition status" }
  // REVIEW [2026-12-15] Base do shape: máquina de estados.
  base: state
  // REVIEW [2026-12-15] Estado inicial e transição disparada pela criação da requisição.
  initial: Requested with transition Requested {
    // REVIEW [2026-12-15] Título exibido no histórico da transição.
    title: { pt-BR: "Reposição solicitada", en: "Replenishment requested" }
    // REVIEW [2026-12-15] Dados carregados pela transição de criação.
    payload {
      // REVIEW [2026-12-15] Quantidade pedida na requisição.
      quantity: std.Count { title: { pt-BR: "Quantidade", en: "Quantity" } }
    }
  }
  // REVIEW [2026-12-15] Estado em que a requisição está aberta aguardando atendimento.
  value Requested {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Solicitada", en: "Requested" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Requested
    // REVIEW [2026-12-15] Ordem de exibição do estado no fluxo.
    ordinal: 10

    // REVIEW [2026-12-15] Transição para Cancelled quando a requisição é cancelada.
    transition Cancelled {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Requisição cancelada", en: "Request cancelled" }
      // REVIEW [2026-12-15] Dados carregados pela transição de cancelamento.
      payload {
        // REVIEW [2026-12-15] Motivo do cancelamento informado pelo gestor.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado final de requisição cancelada.
  value Cancelled {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Cancelada", en: "Cancelled" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Cancelled
    // REVIEW [2026-12-15] Ordem de exibição do estado no fluxo.
    ordinal: 20
  }
  // REVIEW [2026-12-15] Formato de apresentação do shape.
  format: plain
}
