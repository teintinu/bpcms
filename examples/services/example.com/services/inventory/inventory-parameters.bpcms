// service: example.com/services/inventory

// Parâmetro do serviço: tempo de vida padrão de uma reserva de estoque.
parameter ReservationTtl {
  // Título exibido na tela de configuração.
  title: { pt-BR: "Validade da reserva", en: "Reservation TTL" }
  // Tipo do valor: duração padrão fornecida pelo construtor.
  type: std.Duration
  // Valor padrão de 30 minutos quando a aplicação não sobrescreve.
  default: 30m
}
