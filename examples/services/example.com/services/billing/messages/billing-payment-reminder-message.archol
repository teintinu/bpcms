// REVIEW [2026-12-15] service: example.com/services/billing

// REVIEW [2026-12-15] Mensagem de lembrete de pagamento de uma nota.
message PaymentReminder {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Lembrete de pagamento", en: "Payment reminder" }
  // REVIEW [2026-12-15] Documento ao qual a mensagem se refere.
  about: Invoice

  // REVIEW [2026-12-15] Dados transportados pela mensagem.
  payload {
    // REVIEW [2026-12-15] Número da nota a pagar.
    number: InvoiceNumber { title: { pt-BR: "Número", en: "Number" } }
    // REVIEW [2026-12-15] Total a pagar.
    total: std.Money { title: { pt-BR: "Total", en: "Total" } }
    // REVIEW [2026-12-15] Data de vencimento da nota.
    dueAt: DateTime { title: { pt-BR: "Vencimento", en: "Due at" } }
  }
}
