// service: example.com/services/billing

// Relatório consolidado de entradas e saídas de caixa.
view CashFlow {
  // Título exibido na navegação.
  title: { pt-BR: "Fluxo de caixa", en: "Cash flow" }
  type: report // Tipo do artefato: relatório.
  // Documentos usados como fonte dos dados.
  sources: [Invoice, Payment, Bill]
  // Papéis autorizados a abrir o relatório.
  roles: [FinanceManager]

  // Filtros disponíveis na tela.
  filters { period; store }

  // Métricas calculadas a partir das fontes.
  metrics {
    // Soma dos pagamentos capturados no período.
    inflow: sum(Payment.amount) where status == Captured
    // Soma das contas pagas no período.
    outflow: sum(Bill.amount) where status == Paid
    // Saldo líquido entre entradas e saídas.
    balance: inflow - outflow
  }

  // Unidade monetária de cada métrica.
  units { inflow: BRL; outflow: BRL; balance: BRL }
  freshness: 1h // Tempo máximo antes de recomputar os dados.
  export: [pdf, csv] // Formatos disponíveis para exportação.
}

// Painel de acompanhamento do faturamento e das contas.
view RevenueControl {
  // Título exibido na navegação.
  title: { pt-BR: "Controle de faturamento", en: "Billing control" }
  // Tipo do artefato: dashboard.
  type: dashboard
  // Documentos usados como fonte dos dados.
  sources: [Invoice, Bill]
  // Papéis autorizados a abrir o painel.
  roles: [FinanceManager]
  // Atualização em tempo real dos dados.
  mode: live

  // Filtros disponíveis no painel.
  filters { status; period }

  // Métricas calculadas a partir das fontes.
  metrics {
    // Quantidade de notas vencidas.
    overdue: count(Invoice) where status == Overdue
    // Quantidade de contas ainda não pagas.
    openBills: count(Bill) where status != Paid
  }

  // Tempo máximo antes de recomputar os dados.
  freshness: 15m
}

// Caixa de entrada das tarefas de cobrança.
view DunningInbox {
  // Título exibido na navegação.
  title: { pt-BR: "Fila de cobrança", en: "Dunning queue" }
  // Tipo do artefato: inbox.
  type: inbox
  // Papéis que podem atender a fila.
  roles: [CollectionAgent, FinanceManager]

  // Restringe os itens da fila aos papéis do usuário atual.
  scope: roles
  // Filtro que mantém apenas itens de papéis do usuário logado.
  filter { role in currentUser.roles }
  // Agrupa os itens pelo processo de origem.
  groupBy: process
  // Colunas exibidas em cada item da fila.
  columns { title; subject; role; dueAt; priority }
}
