// REVIEW [2026-12-15] service: example.com/services/billing

// REVIEW [2026-12-15] Shape de classificação para os regimes tributários aceitos.
shape TaxRegimeCode {
  // REVIEW [2026-12-15] Título exibido no construtor.
  title: { pt-BR: "Regime tributário", en: "Tax regime" }
  // REVIEW [2026-12-15] Deriva de uma classificação fechada de valores.
  base: classification
  // REVIEW [2026-12-15] Valor do Simples Nacional.
  value SIMPLES {
    // REVIEW [2026-12-15] Rótulo do regime.
    title: { pt-BR: "Simples Nacional", en: "Simples Nacional" }
    // REVIEW [2026-12-15] Ícone associado ao regime.
    icon: Simples
    ordinal: 10 // REVIEW [2026-12-15] Ordem de exibição do valor.
  }
  // REVIEW [2026-12-15] Valor do Lucro Presumido.
  value LUCRO_PRESUMIDO {
    // REVIEW [2026-12-15] Rótulo do regime.
    title: { pt-BR: "Lucro Presumido", en: "Presumed profit" }
    // REVIEW [2026-12-15] Ícone associado ao regime.
    icon: LucroPresumido
    ordinal: 20 // REVIEW [2026-12-15] Ordem de exibição do valor.
  }
  // REVIEW [2026-12-15] Valor do Lucro Real.
  value LUCRO_REAL {
    // REVIEW [2026-12-15] Rótulo do regime.
    title: { pt-BR: "Lucro Real", en: "Actual profit" }
    // REVIEW [2026-12-15] Ícone associado ao regime.
    icon: LucroReal
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 30
  }
  // REVIEW [2026-12-15] Formatação textual simples, sem máscara.
  format: plain
}

// REVIEW [2026-12-15] Shape textual que representa um ano e mês.
shape YearMonth {
  // REVIEW [2026-12-15] Título exibido no construtor.
  title: { pt-BR: "Ano/mês", en: "Year-month" }
  // REVIEW [2026-12-15] Deriva do tipo textual nativo.
  base: string
  // REVIEW [2026-12-15] Valida o formato ano-mês.
  validate: year-month
  // REVIEW [2026-12-15] Formatação textual simples, sem máscara.
  format: plain
}
