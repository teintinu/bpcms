// service: example.com/services/billing
// Process: sintaxe atual (DSL_REFERENCE.md §4)

// Processo de fechamento mensal de cada período fiscal aberto.
process MonthClose(fiscalPeriod: FiscalPeriod) {
  // Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Fechamento mensal", en: "Month close" }
  version: 1 // Versão do artefato Process; diff e release comparam.
  // Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // Texto do objetivo em português.
    pt-BR: "Consolidar o período, revisar os números e fechar ou registrar a falha"
  }
  // SLA brando do caso: alvo de lead time, não é timer.
  sla: 5d

  // Agenda a execução no primeiro dia do mês às três da manhã.
  schedule: "0 3 1 * *"
  // Cria uma instância para cada período fiscal aberto.
  fanOut: FiscalPeriod where status == Open
  key: fiscalPeriod // Chave de identidade, correlação e dedup da instância.

  // Consolida os números do período antes da revisão.
  FiscalPeriod.consolidate()

  // Bloco externo: captura timeout da revisão do fechamento.
  try {
    // Abre a revisão manual do fechamento com o gestor financeiro.
    MonthCloseReview.show({ fiscalPeriod })
  // Captura o timeout da revisão e trata a falha do fechamento.
  } catch (Timeout) {
    // Em caso de prazo esgotado, registra a falha com o motivo.
    FiscalPeriod.fail({ reason: "Prazo de revisão do fechamento esgotado" })
    // Encerra no desfecho de falha.
    return Failed
  }

  // Encerra como falha se a revisão já registrou a falha no período.
  if (fiscalPeriod.status == Failed) {
    // Retorna o desfecho de falha.
    return Failed
  }

  // Encerra no desfecho de sucesso após a revisão.
  return Closed

  // Declara o desfecho de sucesso do caso.
  end Closed {
    // Título exibido no histórico e nos filtros.
    title: { pt-BR: "Fechado", en: "Closed" }
    // Classificação do desfecho para KPI.
    outcome: success
  }

  // Declara o desfecho de falha do caso.
  end Failed {
    // Título exibido no histórico e nos filtros.
    title: { pt-BR: "Falhou", en: "Failed" }
    // Classificação do desfecho para KPI.
    outcome: failure
  }
}

// Erro reservado de prazo.
error Timeout {
  // Título do erro exibido ao usuário.
  title: { pt-BR: "Prazo esgotado", en: "Timed out" }
}

// Formulário de revisão e fechamento do período fiscal.
form MonthCloseReview {
  // Título exibido no formulário.
  title: { pt-BR: "Revisar fechamento", en: "Review month close" }
  // Documento manipulado pelo formulário.
  document: FiscalPeriod
  // Papéis que podem preencher o formulário.
  roles: [FinanceManager]
  // Prazo para preenchimento e envio.
  timeout: 2d
  // Prioridade na fila de trabalho.
  priority: 60
  // Distribuição da tarefa por retirada da fila.
  assign: pull

  // Campos exibidos no formulário.
  fields {
    // Loja do período como contexto somente leitura.
    store
    // Mês do período como contexto somente leitura.
    month
    // Receita consolidada como contexto somente leitura.
    revenue
    // Imposto consolidado como contexto somente leitura.
    tax
    // Quantidade de notas como contexto somente leitura.
    invoiceCount
    // Motivo da falha informado pelo usuário.
    reason: string {
      // Título exibido no campo.
      title: { pt-BR: "Motivo da falha", en: "Failure reason" }
      // Limita o motivo a quinhentos caracteres.
      maxLength: 500
    }
  }

  // Ações disparadas pelo formulário.
  actions {
    // Fecha o período chamando a ação do documento.
    close { calls: FiscalPeriod.close }
    // Registra a falha chamando a ação do documento com o motivo.
    fail { calls: FiscalPeriod.fail(reason) }
  }
}

// View de andamento derivada da instância do processo.
view MonthCloseProgress {
  // Título exibido na navegação.
  title: { pt-BR: "Andamento do fechamento", en: "Month close progress" }
  // Tipo da view: uma tela de andamento de processo.
  type: process
  // Processo cujo andamento esta view exibe.
  process: MonthClose
  // Papéis que podem abrir a view.
  roles: [FinanceManager]

  // Seções fixas exibidas na tela de andamento.
  sections { current; participants; history; deadlines; documents; milestones; next }
}
