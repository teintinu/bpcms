// REVIEW [2026-12-15] service: example.com/services/billing
// REVIEW [2026-12-15] Process: sintaxe atual (DSL_REFERENCE.md §4)

// REVIEW [2026-12-15] Processo de cobrança que acompanha cada nota vencida.
process Dunning(invoice: Invoice) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Cobrança", en: "Dunning" }
  version: 1 // REVIEW [2026-12-15] Versão do artefato Process; diff e release comparam.
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Cobrar faturas vencidas com lembrete, escalonamento e cancelamento"
  }
  // REVIEW [2026-12-15] SLA brando do caso: alvo de lead time, não é timer.
  sla: 30d

  // REVIEW [2026-12-15] Agenda a execução diária às seis da manhã.
  schedule: "0 6 * * *"
  // REVIEW [2026-12-15] Cria uma instância para cada nota vencida.
  fanOut: Invoice where status == Overdue
  key: invoice // REVIEW [2026-12-15] Chave de identidade, correlação e dedup da instância.

  // REVIEW [2026-12-15] Envia o lembrete de pagamento ao cliente.
  send PaymentReminder {
    // REVIEW [2026-12-15] Correlaciona a mensagem com a nota.
    key: invoice
    // REVIEW [2026-12-15] Preenche os dados da mensagem a partir da nota.
    with {
      // REVIEW [2026-12-15] Número da nota.
      number: invoice.number
      // REVIEW [2026-12-15] Total em aberto.
      total: invoice.total
      // REVIEW [2026-12-15] Data de vencimento.
      dueAt: invoice.dueAt
    }
  }

  // REVIEW [2026-12-15] Aguarda cinco dias antes de reavaliar a cobrança.
  wait 5d

  // REVIEW [2026-12-15] Só escala a cobrança se a nota continuar vencida.
  if (invoice.status == Overdue) {
    // REVIEW [2026-12-15] Abre a tarefa manual de negociação com o cliente.
    Escalate.show({ invoice })

    // REVIEW [2026-12-15] Aguarda mais sete dias antes da próxima verificação.
    wait 7d

    // REVIEW [2026-12-15] Reavalia a nota após a negociação.
    if (invoice.status == Overdue) {
      // REVIEW [2026-12-15] Abre o formulário para cancelar a nota vencida.
      DunningCancellation.show({ invoice })

      // REVIEW [2026-12-15] Encerra como cancelada se o formulário cancelou a nota.
      if (invoice.status == Cancelled) {
        // REVIEW [2026-12-15] Retorna o desfecho de cancelamento.
        return Cancelled
      }
    }
  }

  // REVIEW [2026-12-15] Encerra como liquidada quando a nota deixou de estar vencida.
  return Settled

  // REVIEW [2026-12-15] Declara o desfecho de sucesso do caso.
  end Settled {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Liquidada", en: "Settled" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }

  // REVIEW [2026-12-15] Declara o desfecho de cancelamento do caso.
  end Cancelled {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Cancelada", en: "Cancelled" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: cancelled
  }
}

// REVIEW [2026-12-15] Tarefa manual de negociação de pagamento com o cliente.
manual Escalate {
  // REVIEW [2026-12-15] Título exibido na inbox e no histórico.
  title: { pt-BR: "Negociar pagamento", en: "Negotiate payment" }
  // REVIEW [2026-12-15] Documento-sujeito da tarefa.
  document: Invoice
  // REVIEW [2026-12-15] Papéis que podem atender a tarefa.
  roles: [CollectionAgent]
  // REVIEW [2026-12-15] Orientações exibidas ao responsável.
  instructions: {
    // REVIEW [2026-12-15] Instrução em português.
    pt-BR: "Ligar ao cliente e negociar o pagamento"
  }
  // REVIEW [2026-12-15] Prazo para conclusão da tarefa.
  timeout: 2d
  // REVIEW [2026-12-15] Prioridade na fila de trabalho.
  priority: 60
  // REVIEW [2026-12-15] Distribuição da tarefa por retirada da fila.
  assign: pull
}

// REVIEW [2026-12-15] Formulário para cancelar uma nota vencida durante a cobrança.
form DunningCancellation {
  // REVIEW [2026-12-15] Título exibido no formulário.
  title: { pt-BR: "Cancelar nota vencida", en: "Cancel overdue invoice" }
  // REVIEW [2026-12-15] Documento manipulado pelo formulário.
  document: Invoice
  // REVIEW [2026-12-15] Papéis que podem preencher o formulário.
  roles: [FinanceManager]
  // REVIEW [2026-12-15] Prazo para preenchimento e envio.
  timeout: 1d
  // REVIEW [2026-12-15] Prioridade na fila de trabalho.
  priority: 70
  // REVIEW [2026-12-15] Distribuição da tarefa por retirada da fila.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Número da nota como contexto somente leitura.
    number
    // REVIEW [2026-12-15] Cliente da nota como contexto somente leitura.
    customer
    // REVIEW [2026-12-15] Total da nota como contexto somente leitura.
    total
    // REVIEW [2026-12-15] Vencimento da nota como contexto somente leitura.
    dueAt
    // REVIEW [2026-12-15] Motivo do cancelamento informado pelo usuário.
    reason: string {
      // REVIEW [2026-12-15] Título exibido no campo.
      title: { pt-BR: "Motivo do cancelamento", en: "Cancellation reason" }
      // REVIEW [2026-12-15] Limita o motivo a quinhentos caracteres.
      maxLength: 500
      // REVIEW [2026-12-15] Torna o motivo obrigatório.
      required
    }
  }

  // REVIEW [2026-12-15] Ações disparadas pelo formulário.
  actions {
    // REVIEW [2026-12-15] Cancela a nota chamando a ação do documento com o motivo.
    cancel { calls: Invoice.cancel(reason) }
  }
}
