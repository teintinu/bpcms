// REVIEW [2026-12-15] service: example.com/services/billing
// REVIEW [2026-12-15] Process: sintaxe atual (DSL_REFERENCE.md §4)

// REVIEW [2026-12-15] Processo de fechamento mensal de cada período fiscal aberto.
process MonthClose(fiscalPeriod: FiscalPeriod) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Fechamento mensal", en: "Month close" }
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Consolidar o período, revisar os números e fechar ou registrar a falha"
  }
  // REVIEW [2026-12-15] SLA brando do caso: alvo de lead time, não é timer.
  sla: 5d

  // REVIEW [2026-12-15] Agenda a execução no primeiro dia do mês às três da manhã.
  schedule: "0 3 1 * *"
  // REVIEW [2026-12-15] Cria uma instância para cada período fiscal aberto.
  fanOut: FiscalPeriod where status == Open
  key: fiscalPeriod // REVIEW [2026-12-15] Chave de identidade, correlação e dedup da instância.

  // REVIEW [2026-12-15] Consolida os números do período antes da revisão.
  FiscalPeriod.consolidate()

  // REVIEW [2026-12-15] Bloco externo: captura timeout da revisão do fechamento.
  try {
    // REVIEW [2026-12-15] Abre a revisão manual do fechamento com o gestor financeiro.
    MonthCloseReview.show({ fiscalPeriod })
  // REVIEW [2026-12-15] Captura o timeout da revisão e trata a falha do fechamento.
  } catch (Timeout) {
    // REVIEW [2026-12-15] Em caso de prazo esgotado, registra a falha com o motivo.
    FiscalPeriod.fail({ reason: "Prazo de revisão do fechamento esgotado" })
    // REVIEW [2026-12-15] Encerra no desfecho de falha.
    return Failed
  }

  // REVIEW [2026-12-15] Encerra como falha se a revisão já registrou a falha no período.
  if (fiscalPeriod.status == Failed) {
    // REVIEW [2026-12-15] Retorna o desfecho de falha.
    return Failed
  }

  // REVIEW [2026-12-15] Encerra no desfecho de sucesso após a revisão.
  return Closed

  // REVIEW [2026-12-15] Declara o desfecho de sucesso do caso.
  end Closed {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Fechado", en: "Closed" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }

  // REVIEW [2026-12-15] Declara o desfecho de falha do caso.
  end Failed {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Falhou", en: "Failed" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: failure
  }
}

// REVIEW [2026-12-15] Erro reservado de prazo.
error Timeout {
  // REVIEW [2026-12-15] Título do erro exibido ao usuário.
  title: { pt-BR: "Prazo esgotado", en: "Timed out" }
}

// REVIEW [2026-12-15] Formulário de revisão e fechamento do período fiscal.
form MonthCloseReview {
  // REVIEW [2026-12-15] Título exibido no formulário.
  title: { pt-BR: "Revisar fechamento", en: "Review month close" }
  // REVIEW [2026-12-15] Documento manipulado pelo formulário.
  document: FiscalPeriod
  // REVIEW [2026-12-15] Papéis que podem preencher o formulário.
  roles: [FinanceManager]
  // REVIEW [2026-12-15] Prazo para preenchimento e envio.
  timeout: 2d
  // REVIEW [2026-12-15] Prioridade na fila de trabalho.
  priority: 60
  // REVIEW [2026-12-15] Distribuição da tarefa por retirada da fila.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Loja do período como contexto somente leitura.
    store
    // REVIEW [2026-12-15] Mês do período como contexto somente leitura.
    month
    // REVIEW [2026-12-15] Receita consolidada como contexto somente leitura.
    revenue
    // REVIEW [2026-12-15] Imposto consolidado como contexto somente leitura.
    tax
    // REVIEW [2026-12-15] Quantidade de notas como contexto somente leitura.
    invoiceCount
    // REVIEW [2026-12-15] Motivo da falha informado pelo usuário.
    reason: string {
      // REVIEW [2026-12-15] Título exibido no campo.
      title: { pt-BR: "Motivo da falha", en: "Failure reason" }
      // REVIEW [2026-12-15] Limita o motivo a quinhentos caracteres.
      maxLength: 500
    }
  }

  // REVIEW [2026-12-15] Ações disparadas pelo formulário.
  actions {
    // REVIEW [2026-12-15] Fecha o período chamando a ação do documento.
    close { calls: FiscalPeriod.close }
    // REVIEW [2026-12-15] Registra a falha chamando a ação do documento com o motivo.
    fail { calls: FiscalPeriod.fail(reason) }
  }
}
