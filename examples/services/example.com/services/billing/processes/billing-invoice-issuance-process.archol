// REVIEW [2026-12-15] service: example.com/services/billing
// REVIEW [2026-12-15] Process: sintaxe atual (DSL_REFERENCE.md §4)

// REVIEW [2026-12-15] Processo que emite a nota fiscal a partir de um pedido.
process InvoiceIssuance(invoice: Invoice) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Emissão de nota", en: "Invoice issuance" }
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Emitir a nota a partir do pedido, com imposto aplicado e envio ao cliente"
  }

  // REVIEW [2026-12-15] Gatilho: inicia uma instância quando a nota é solicitada.
  on [Invoice.Requested]
  key: invoice // REVIEW [2026-12-15] Chave de identidade, correlação e dedup da instância.

  // REVIEW [2026-12-15] Deriva os dados da nota a partir do pedido de origem.
  Invoice.deriveFromOrder()
  // REVIEW [2026-12-15] Aplica o imposto correspondente ao regime tributário.
  Invoice.applyTax()
  // REVIEW [2026-12-15] Emite a nota e registra a data de emissão.
  Invoice.issue()

  // REVIEW [2026-12-15] Envia a mensagem de nota emitida ao cliente.
  InvoiceIssued.send(
    // REVIEW [2026-12-15] Correlaciona a mensagem com a nota.
    key: invoice
    // REVIEW [2026-12-15] Preenche os dados da mensagem a partir da nota.
    with {
      // REVIEW [2026-12-15] Número da nota emitida.
      number: invoice.number
      // REVIEW [2026-12-15] Total da nota emitida.
      total: invoice.total
      // REVIEW [2026-12-15] Data de emissão da nota.
      issuedAt: invoice.issuedAt
    }
  )

  // REVIEW [2026-12-15] Encerra no desfecho de sucesso.
  return Issued

  // REVIEW [2026-12-15] Declara o desfecho de sucesso do caso.
  end Issued {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Nota emitida", en: "Invoice issued" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }
}
