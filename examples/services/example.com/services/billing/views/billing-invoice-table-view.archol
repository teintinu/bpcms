// REVIEW [2026-12-15] service: example.com/services/billing

// REVIEW [2026-12-15] Tabela de notas com filtros e ações rápidas.
view InvoiceTable {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Notas fiscais", en: "Invoices" }
  // REVIEW [2026-12-15] Tipo do artefato: tabela.
  type: table
  // REVIEW [2026-12-15] Documento exibido na tabela.
  source: Invoice
  // REVIEW [2026-12-15] Papéis autorizados a abrir a tabela.
  roles: [Clerk, CollectionAgent, FinanceManager]

  // REVIEW [2026-12-15] Colunas exibidas em cada linha.
  columns { number; customer; total; status; dueAt }
  // REVIEW [2026-12-15] Filtros disponíveis na tela.
  filters { status; period; customer }
  // REVIEW [2026-12-15] Quantidade de linhas por página.
  pagination: 50

  // REVIEW [2026-12-15] Ações disponíveis na tabela.
  actions {
    // REVIEW [2026-12-15] Abre o detalhe da nota selecionada.
    open -> InvoiceDetail
    // REVIEW [2026-12-15] Emite a nota selecionada.
    issue -> Invoice.issue
    // REVIEW [2026-12-15] Cancela a nota solicitando o motivo.
    cancel -> Invoice.cancel(reason)
  }
}
