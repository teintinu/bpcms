// REVIEW [2026-12-15] service: example.com/services/billing

// REVIEW [2026-12-15] Caixa de entrada das tarefas de cobrança.
view DunningInbox {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Fila de cobrança", en: "Dunning queue" }
  // REVIEW [2026-12-15] Tipo do artefato: inbox.
  type: inbox
  // REVIEW [2026-12-15] Papéis que podem atender a fila.
  roles: [CollectionAgent, FinanceManager]

  // REVIEW [2026-12-15] Restringe os itens da fila aos papéis do usuário atual.
  scope: roles
  // REVIEW [2026-12-15] Filtro que mantém apenas itens de papéis do usuário logado.
  filter { role in currentUser.roles }
  // REVIEW [2026-12-15] Agrupa os itens pelo processo de origem.
  groupBy: process
  // REVIEW [2026-12-15] Colunas exibidas em cada item da fila.
  columns { title; subject; role; dueAt; priority }
}
