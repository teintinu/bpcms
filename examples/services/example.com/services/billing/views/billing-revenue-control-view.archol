// REVIEW [2026-12-15] service: example.com/services/billing

// REVIEW [2026-12-15] Painel de acompanhamento do faturamento e das contas.
view RevenueControl {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Controle de faturamento", en: "Billing control" }
  // REVIEW [2026-12-15] Tipo do artefato: dashboard.
  type: dashboard
  // REVIEW [2026-12-15] Documentos usados como fonte dos dados.
  sources: [Invoice, Bill]
  // REVIEW [2026-12-15] Papéis autorizados a abrir o painel.
  roles: [FinanceManager]
  // REVIEW [2026-12-15] Atualização em tempo real dos dados.
  mode: live

  // REVIEW [2026-12-15] Filtros disponíveis no painel.
  filters { status; period }

  // REVIEW [2026-12-15] Métricas calculadas a partir das fontes.
  metrics {
    // REVIEW [2026-12-15] Quantidade de notas vencidas.
    overdue: count(Invoice) where status == Overdue
    // REVIEW [2026-12-15] Quantidade de contas ainda não pagas.
    openBills: count(Bill) where status != Paid
  }

  // REVIEW [2026-12-15] Tempo máximo antes de recomputar os dados.
  freshness: 15m
}
