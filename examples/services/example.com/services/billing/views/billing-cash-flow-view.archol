// REVIEW [2026-12-15] service: example.com/services/billing

// REVIEW [2026-12-15] Relatório consolidado de entradas e saídas de caixa.
view CashFlow {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Fluxo de caixa", en: "Cash flow" }
  type: report // REVIEW [2026-12-15] Tipo do artefato: relatório.
  // REVIEW [2026-12-15] Documentos usados como fonte dos dados.
  sources: [Invoice, Payment, Bill]
  // REVIEW [2026-12-15] Papéis autorizados a abrir o relatório.
  roles: [FinanceManager]

  // REVIEW [2026-12-15] Filtros disponíveis na tela.
  filters { period; store }

  // REVIEW [2026-12-15] Métricas calculadas a partir das fontes.
  metrics {
    // REVIEW [2026-12-15] Soma dos pagamentos capturados no período.
    inflow: sum(Payment.amount) where status == Captured
    // REVIEW [2026-12-15] Soma das contas pagas no período.
    outflow: sum(Bill.amount) where status == Paid
    // REVIEW [2026-12-15] Saldo líquido entre entradas e saídas.
    balance: inflow - outflow
  }

  // REVIEW [2026-12-15] Unidade monetária de cada métrica.
  units { inflow: BRL; outflow: BRL; balance: BRL }
  freshness: 1h // REVIEW [2026-12-15] Tempo máximo antes de recomputar os dados.
  export: [pdf, csv] // REVIEW [2026-12-15] Formatos disponíveis para exportação.
}
