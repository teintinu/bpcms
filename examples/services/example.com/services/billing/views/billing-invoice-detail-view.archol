// REVIEW [2026-12-15] service: example.com/services/billing

// REVIEW [2026-12-15] Tela de detalhe de uma nota fiscal.
view InvoiceDetail {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Detalhe da nota", en: "Invoice detail" }
  // REVIEW [2026-12-15] Tipo do artefato: detalhe.
  type: detail
  // REVIEW [2026-12-15] Documento exibido no detalhe.
  document: Invoice
  // REVIEW [2026-12-15] Papéis autorizados a abrir o detalhe.
  roles: [Clerk, CollectionAgent, FinanceManager]

  // REVIEW [2026-12-15] Seções exibidas na tela de detalhe.
  sections { summary; items; customer; timeline }

  // REVIEW [2026-12-15] Ações disponíveis no detalhe.
  actions {
    // REVIEW [2026-12-15] Registra o pagamento da nota.
    pay -> Invoice.pay(paidAt)
    // REVIEW [2026-12-15] Cancela a nota solicitando o motivo.
    cancel -> Invoice.cancel(reason)
  }
}
