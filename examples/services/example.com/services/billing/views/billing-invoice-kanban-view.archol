// REVIEW [2026-12-15] service: example.com/services/billing

// REVIEW [2026-12-15] Quadro kanban das notas agrupadas por situação.
view InvoiceKanban {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Notas por situação", en: "Invoices by status" }
  // REVIEW [2026-12-15] Tipo do artefato: kanban.
  type: kanban
  // REVIEW [2026-12-15] Documento exibido no quadro.
  source: Invoice
  // REVIEW [2026-12-15] Papéis autorizados a abrir o quadro.
  roles: [Clerk, CollectionAgent, FinanceManager]

  // REVIEW [2026-12-15] Agrupa os cartões pela situação da nota.
  groupBy: status
  // REVIEW [2026-12-15] Colunas exibidas em cada cartão.
  columns { number; customer; total; dueAt }
  // REVIEW [2026-12-15] Conteúdo resumido do cartão.
  card { number; customer; total; dueAt }

  // REVIEW [2026-12-15] Ações disponíveis no quadro.
  actions {
    // REVIEW [2026-12-15] Abre o detalhe da nota selecionada.
    open -> InvoiceDetail
  }
}
