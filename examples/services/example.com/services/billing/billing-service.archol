// REVIEW [2026-12-15] Declara o serviço de faturamento no caminho canônico do workspace.
service "example.com/services/billing" {
  // REVIEW [2026-12-15] Título legível do serviço exibido no construtor.
  title:  "Faturamento"
  locales: [ "pt-BR" ] // REVIEW [2026-12-18] Idiomas suportados pelo serviço.
  // REVIEW [2026-12-15] Dependências externas referenciadas por este serviço.
  imports {
    // REVIEW [2026-12-15] Importa medidas e constantes padrão do construtor sob o alias std.
    service "bpcms.org/std" as std
    // REVIEW [2026-12-15] Importa o serviço de pedidos para referenciar Order.
    service "example.com/services/orders" as Orders
    // REVIEW [2026-12-15] Importa o serviço de pagamentos para referenciar Payment.
    service "example.com/services/payments" as Payments
    // REVIEW [2026-12-15] Importa o serviço de identidade para referenciar User.
    service "example.com/services/identity" as Identity
  }
}
