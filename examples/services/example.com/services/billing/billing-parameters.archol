// REVIEW [2026-12-15] service: example.com/services/billing

// REVIEW [2026-12-15] Parâmetro que define o regime tributário padrão do faturamento.
parameter TaxRegime {
  // REVIEW [2026-12-15] Título exibido na configuração.
  title: { pt-BR: "Regime tributário", en: "Tax regime" }
  // REVIEW [2026-12-15] Tipo do valor aceito pelo parâmetro.
  type: TaxRegimeCode
  default: "SIMPLES" // REVIEW [2026-12-15] Regime tributário inicial: Simples Nacional.
}

// REVIEW [2026-12-15] Parâmetro que define a série padrão das notas fiscais.
parameter InvoiceSeries {
  // REVIEW [2026-12-15] Título exibido na configuração.
  title: { pt-BR: "Série da nota", en: "Invoice series" }
  // REVIEW [2026-12-15] Tipo textual do valor da série.
  type: string
  default: "A" // REVIEW [2026-12-15] Série inicial usada na numeração.
  maxLength: 10 // REVIEW [2026-12-15] Tamanho máximo permitido para a série.
}
