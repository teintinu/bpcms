// REVIEW [2026-12-15] service: example.com/services/billing

// REVIEW [2026-12-15] Documento que registra créditos emitidos contra notas fiscais.
document CreditNote {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Nota de crédito", en: "Credit note" }
  // REVIEW [2026-12-15] Área responsável pelo documento.
  sync: live // REVIEW [2026-12-15] Sincronização em tempo real entre as partes.
  // REVIEW [2026-12-15] Campos que compõem a nota de crédito.
  fields {
    // REVIEW [2026-12-15] Nota fiscal à qual o crédito se refere; consultável.
    invoice: Invoice {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Nota fiscal", en: "Invoice" }
      // REVIEW [2026-12-15] Permite localizar a nota por este vínculo.
      lookup
    }
    // REVIEW [2026-12-15] Valor monetário do crédito em reais; consultável.
    amount: std.Money { title: { pt-BR: "Valor", en: "Amount" }, lookup, currency: BRL }
    // REVIEW [2026-12-15] Justificativa do crédito.
    reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
    // REVIEW [2026-12-15] Situação atual no ciclo de vida da nota de crédito; consultável.
    status: CreditNoteStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    // REVIEW [2026-12-15] Data em que o crédito foi emitido.
    issuedAt: DateTime { title: { pt-BR: "Emitido em", en: "Issued at" } }
    // REVIEW [2026-12-15] Data em que o crédito foi aplicado.
    appliedAt: DateTime { title: { pt-BR: "Aplicado em", en: "Applied at" } }
  }

  // REVIEW [2026-12-15] Índices que aceleram as consultas mais frequentes.
  indexes {
    // REVIEW [2026-12-15] Indexa as notas de crédito por nota fiscal.
    byInvoice: [invoice.id] hash
    // REVIEW [2026-12-15] Indexa situação e emissão para listar por estado.
    byStatus: [status, issuedAt] range
  }


  // REVIEW [2026-12-15] Ações que alteram o estado da nota de crédito.
  actions {
    // REVIEW [2026-12-15] Emite a nota de crédito a partir do rascunho.
    issue(){
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Emitir", en: "Issue" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [FinanceManager]

      // REVIEW [2026-12-15] Transição para o estado emitido.
      to: status.Issued
      // REVIEW [2026-12-15] Emite o evento de emissão com a data atual.
      emits { issuedAt: now() }

      // REVIEW [2026-12-15] Efeitos colaterais aplicados ao documento.
      {
        // REVIEW [2026-12-15] Grava a data de emissão.
        issuedAt = now()
      }
    }

    // REVIEW [2026-12-15] Aplica o crédito para abater o valor da nota.
    apply(){
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Aplicar", en: "Apply" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [FinanceManager]

      // REVIEW [2026-12-15] Transição para o estado aplicado.
      to: status.Applied
      // REVIEW [2026-12-15] Emite o evento de aplicação com a data atual.
      emits { appliedAt: now() }

      // REVIEW [2026-12-15] Efeitos colaterais aplicados ao documento.
      {
        // REVIEW [2026-12-15] Grava a data de aplicação.
        appliedAt = now()
      }
    }
  }

  // REVIEW [2026-12-15] Invariante: o valor do crédito precisa ser positivo.
  rule amount > 0 {
    // REVIEW [2026-12-15] Mensagem de validação em português.
    pt-BR: "O valor deve ser maior que zero"
    // REVIEW [2026-12-15] Mensagem de validação em inglês.
    en: "Amount must be greater than zero"
  }
  // REVIEW [2026-12-15] Invariante: limita o crédito a 100.000 BRL.
  rule amount <= 100000 BRL {
    // REVIEW [2026-12-15] Mensagem de validação em português.
    pt-BR: "O valor excede o limite de 100.000 BRL"
    // REVIEW [2026-12-15] Mensagem de validação em inglês.
    en: "Amount exceeds the 100,000 BRL limit"
  }
}

// REVIEW [2026-12-15] Shape de estado que modela o ciclo de vida da nota de crédito.
shape CreditNoteStatus {
  // REVIEW [2026-12-15] Título exibido no construtor.
  title: { pt-BR: "Situação da nota de crédito", en: "Credit note status" }
  // REVIEW [2026-12-15] Deriva de uma máquina de estados.
  base: state
  // REVIEW [2026-12-15] Estado inicial de toda nota de crédito.
  initial: Draft
  // REVIEW [2026-12-15] Estado de rascunho, ainda não emitido.
  value Draft {
    // REVIEW [2026-12-15] Rótulo do estado.
    title: { pt-BR: "Rascunho", en: "Draft" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Draft
    // REVIEW [2026-12-15] Ordem de exibição do estado.
    ordinal: 10

    // REVIEW [2026-12-15] Transição permitida de rascunho para emitida.
    transition Issued {
      // REVIEW [2026-12-15] Título da transição no histórico.
      title: { pt-BR: "Nota de crédito emitida", en: "Credit note issued" }
      // REVIEW [2026-12-15] Dados carregados junto com a transição.
      payload {
        // REVIEW [2026-12-15] Data de emissão da nota de crédito.
        issuedAt: DateTime { title: { pt-BR: "Emitida em", en: "Issued at" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado em que a nota de crédito foi emitida.
  value Issued {
    // REVIEW [2026-12-15] Rótulo do estado.
    title: { pt-BR: "Emitida", en: "Issued" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Issued
    // REVIEW [2026-12-15] Ordem de exibição do estado.
    ordinal: 20

    // REVIEW [2026-12-15] Transição permitida de emitida para aplicada.
    transition Applied {
      // REVIEW [2026-12-15] Título da transição no histórico.
      title: { pt-BR: "Nota de crédito aplicada", en: "Credit note applied" }
      // REVIEW [2026-12-15] Dados carregados junto com a transição.
      payload {
        // REVIEW [2026-12-15] Data de aplicação do crédito.
        appliedAt: DateTime { title: { pt-BR: "Aplicada em", en: "Applied at" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado em que o crédito já foi aplicado.
  value Applied {
    // REVIEW [2026-12-15] Rótulo do estado.
    title: { pt-BR: "Aplicada", en: "Applied" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Applied
    // REVIEW [2026-12-15] Ordem de exibição do estado.
    ordinal: 30
  }
  // REVIEW [2026-12-15] Formatação textual simples, sem máscara.
  format: plain
}
