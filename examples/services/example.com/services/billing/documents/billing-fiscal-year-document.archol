// REVIEW [2026-12-15] service: example.com/services/billing

// REVIEW [2026-12-15] Documento com escopo por instância que representa um exercício fiscal.
scopable document FiscalYear {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Exercício fiscal", en: "Fiscal year" }
  // REVIEW [2026-12-15] Campos que compõem o exercício fiscal.
  fields {
    // REVIEW [2026-12-15] Ano do exercício; único, consultável e obrigatório.
    year: integer {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Ano", en: "Year" }
      // REVIEW [2026-12-15] Impede dois exercícios com o mesmo ano.
      unique
      // REVIEW [2026-12-15] Permite localizar o exercício pelo ano.
      lookup
      // REVIEW [2026-12-15] Torna o ano obrigatório no preenchimento.
      required
    }
    // REVIEW [2026-12-15] Data de início do exercício.
    startsAt: DateTime { title: { pt-BR: "Início", en: "Start" } }
    // REVIEW [2026-12-15] Data de fim do exercício.
    endsAt: DateTime { title: { pt-BR: "Fim", en: "End" } }
  }

  // REVIEW [2026-12-15] Dados iniciais semeados com o serviço.
  seed {
    // REVIEW [2026-12-15] Exercício de 2026.
    Y2026 {
      // REVIEW [2026-12-15] Ano do exercício semeado.
      year: 2026
      // REVIEW [2026-12-15] Início em primeiro de janeiro de 2026.
      startsAt: 2026-01-01
      // REVIEW [2026-12-15] Fim em trinta e um de dezembro de 2026.
      endsAt: 2026-12-31
    }
  }
}
