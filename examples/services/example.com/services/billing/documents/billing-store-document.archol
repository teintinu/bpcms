// REVIEW [2026-12-15] service: example.com/services/billing

// REVIEW [2026-12-15] Documento com escopo por instância que representa uma loja.
scopable document Store {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Loja", en: "Store" }
  // REVIEW [2026-12-15] Campos que compõem a loja.
  fields {
    // REVIEW [2026-12-15] Código identificador da loja; único, consultável e obrigatório.
    code: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Código", en: "Code" }
      // REVIEW [2026-12-15] Limita o código a oito caracteres.
      maxLength: 8
      // REVIEW [2026-12-15] Impede duas lojas com o mesmo código.
      unique
      // REVIEW [2026-12-15] Permite localizar a loja pelo código.
      lookup
      // REVIEW [2026-12-15] Torna o código obrigatório no preenchimento.
      required
    }
    // REVIEW [2026-12-15] Nome legível da loja; consultável e obrigatório.
    name: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Nome", en: "Name" }
      // REVIEW [2026-12-15] Limita o nome a cento e vinte caracteres.
      maxLength: 120
      // REVIEW [2026-12-15] Permite localizar a loja pelo nome.
      lookup
      // REVIEW [2026-12-15] Torna o nome obrigatório no preenchimento.
      required
    }
  }

  // REVIEW [2026-12-15] Dados iniciais semeados com o serviço.
  seed {
    // REVIEW [2026-12-15] Loja de São Paulo.
    SP {
      // REVIEW [2026-12-15] Código da loja de São Paulo.
      code: "SP"
      // REVIEW [2026-12-15] Nome da loja de São Paulo.
      name: "São Paulo"
    }
    // REVIEW [2026-12-15] Loja do Rio de Janeiro.
    RJ {
      // REVIEW [2026-12-15] Código da loja do Rio de Janeiro.
      code: "RJ"
      // REVIEW [2026-12-15] Nome da loja do Rio de Janeiro.
      name: "Rio de Janeiro"
    }
  }
}
