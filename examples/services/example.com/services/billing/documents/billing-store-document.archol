// service: example.com/services/billing

// Documento com escopo por instância que representa uma loja.
scopable document Store {
  // Título exibido na interface.
  title: { pt-BR: "Loja", en: "Store" }
  // Campos que compõem a loja.
  fields {
    // Código identificador da loja; único, consultável e obrigatório.
    code: string {
      // Título exibido no formulário.
      title: { pt-BR: "Código", en: "Code" }
      // Limita o código a oito caracteres.
      maxLength: 8
      // Impede duas lojas com o mesmo código.
      unique
      // Permite localizar a loja pelo código.
      lookup
      // Torna o código obrigatório no preenchimento.
      required
    }
    // Nome legível da loja; consultável e obrigatório.
    name: string {
      // Título exibido no formulário.
      title: { pt-BR: "Nome", en: "Name" }
      // Limita o nome a cento e vinte caracteres.
      maxLength: 120
      // Permite localizar a loja pelo nome.
      lookup
      // Torna o nome obrigatório no preenchimento.
      required
    }
  }

  // Dados iniciais semeados com o serviço.
  seed {
    // Loja de São Paulo.
    SP {
      // Código da loja de São Paulo.
      code: "SP"
      // Nome da loja de São Paulo.
      name: "São Paulo"
    }
    // Loja do Rio de Janeiro.
    RJ {
      // Código da loja do Rio de Janeiro.
      code: "RJ"
      // Nome da loja do Rio de Janeiro.
      name: "Rio de Janeiro"
    }
  }
}
