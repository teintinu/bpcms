// REVIEW [2026-12-15] service: example.com/services/billing

// REVIEW [2026-12-15] Documento que representa o período fiscal mensal de uma loja.
document FiscalPeriod {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Período fiscal", en: "Fiscal period" }
  version: 1 // REVIEW [2026-12-15] Versão do documento usada em release e comparação.
  // REVIEW [2026-12-15] Área responsável pelo documento.
  owner: "Billing"
  sync: live // REVIEW [2026-12-15] Sincronização em tempo real entre as partes.

  // REVIEW [2026-12-15] Campos que compõem o período fiscal.
  fields {
    // REVIEW [2026-12-15] Loja à qual o período pertence; obrigatória.
    store: Store {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Loja", en: "Store" }
      // REVIEW [2026-12-15] Torna a loja obrigatória no preenchimento.
      required
    }
    // REVIEW [2026-12-15] Mês de competência do período; consultável e obrigatório.
    month: YearMonth {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Mês", en: "Month" }
      // REVIEW [2026-12-15] Permite localizar o período pelo mês.
      lookup
      // REVIEW [2026-12-15] Torna o mês obrigatório no preenchimento.
      required
    }
    // REVIEW [2026-12-15] Situação atual no ciclo de vida do período; consultável.
    status: FiscalPeriodStatus {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Situação", en: "Status" }
      // REVIEW [2026-12-15] Permite localizar o período pela situação.
      lookup
    }
    // REVIEW [2026-12-15] Quantidade de notas do período.
    invoiceCount: std.Count { title: { pt-BR: "Qtd. de notas", en: "Invoice count" } }
    // REVIEW [2026-12-15] Receita total do período em reais; consultável.
    revenue: std.Money { title: { pt-BR: "Receita", en: "Revenue" }, lookup, currency: BRL }
    // REVIEW [2026-12-15] Imposto total do período em reais.
    tax: std.Money { title: { pt-BR: "Imposto", en: "Tax" }, currency: BRL }
    // REVIEW [2026-12-15] Data em que o período foi fechado.
    closedAt: DateTime { title: { pt-BR: "Fechado em", en: "Closed at" } }
    // REVIEW [2026-12-15] Motivo registrado quando o fechamento falha.
    failureReason: string { title: { pt-BR: "Motivo da falha", en: "Failure reason" } }
  }

  // REVIEW [2026-12-15] Índices que aceleram as consultas mais frequentes.
  indexes {
    // REVIEW [2026-12-15] Garante um único período por loja e mês.
    byPeriod: [store.id, month] unique
    // REVIEW [2026-12-15] Indexa situação e mês para listar períodos por estado.
    byStatus: [status, month] range
  }


  // REVIEW [2026-12-15] Ações que alteram o estado do período fiscal.
  actions {
    // REVIEW [2026-12-15] Consolida os números do período antes do fechamento.
    consolidate(){
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Consolidar período", en: "Consolidate period" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [FinanceManager]
    }

    // REVIEW [2026-12-15] Fecha o período consolidado.
    close(){
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Fechar período", en: "Close period" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [FinanceManager]

      // REVIEW [2026-12-15] Transição para o estado fechado.
      to: status.Closed

      // REVIEW [2026-12-15] Efeitos colaterais aplicados ao documento.
      {
        // REVIEW [2026-12-15] Grava a data de fechamento.
        closedAt = now()
      }
    }

    // REVIEW [2026-12-15] Registra uma falha no fechamento com o motivo informado.
    fail(reason: string){
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Registrar falha", en: "Record failure" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [FinanceManager]

      // REVIEW [2026-12-15] Transição para o estado de falha.
      to: status.Failed

      // REVIEW [2026-12-15] Exige um motivo com pelo menos cinco caracteres.
      rule reason.length >= 5 {
        // REVIEW [2026-12-15] Mensagem de validação em português.
        pt-BR: "Informe o motivo da falha"
        // REVIEW [2026-12-15] Mensagem de validação em inglês.
        en: "Enter the failure reason"
      }

      // REVIEW [2026-12-15] Efeitos colaterais aplicados ao documento.
      {
        // REVIEW [2026-12-15] Persiste o motivo da falha.
        failureReason = reason
      }
    }
  }
}

// REVIEW [2026-12-15] Shape de estado que modela o ciclo de vida do período fiscal.
shape FiscalPeriodStatus {
  // REVIEW [2026-12-15] Título exibido no construtor.
  title: { pt-BR: "Situação do período fiscal", en: "Fiscal period status" }
  // REVIEW [2026-12-15] Deriva de uma máquina de estados.
  base: state
  // REVIEW [2026-12-15] Estado inicial de todo período.
  initial: Open
  // REVIEW [2026-12-15] Estado em que o período está aberto para consolidação.
  value Open {
    // REVIEW [2026-12-15] Rótulo do estado.
    title: { pt-BR: "Aberto", en: "Open" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Open
    // REVIEW [2026-12-15] Ordem de exibição do estado.
    ordinal: 10

    // REVIEW [2026-12-15] Transição permitida de aberto para fechado.
    transition Closed {
      // REVIEW [2026-12-15] Título da transição no histórico.
      title: { pt-BR: "Período fechado", en: "Period closed" }
      // REVIEW [2026-12-15] Dados carregados junto com a transição.
      payload {
        // REVIEW [2026-12-15] Data de fechamento do período.
        closedAt: DateTime { title: { pt-BR: "Fechado em", en: "Closed at" } }
      }
    }

    // REVIEW [2026-12-15] Transição permitida de aberto para falha.
    transition Failed {
      // REVIEW [2026-12-15] Título da transição no histórico.
      title: { pt-BR: "Fechamento falhou", en: "Period close failed" }
      // REVIEW [2026-12-15] Dados carregados junto com a transição.
      payload {
        // REVIEW [2026-12-15] Motivo da falha no fechamento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado em que o período foi fechado.
  value Closed {
    // REVIEW [2026-12-15] Rótulo do estado.
    title: { pt-BR: "Fechado", en: "Closed" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Closed
    // REVIEW [2026-12-15] Ordem de exibição do estado.
    ordinal: 20
  }
  // REVIEW [2026-12-15] Estado em que o fechamento falhou.
  value Failed {
    // REVIEW [2026-12-15] Rótulo do estado.
    title: { pt-BR: "Falhou", en: "Failed" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Failed
    // REVIEW [2026-12-15] Ordem de exibição do estado.
    ordinal: 30
  }
  // REVIEW [2026-12-15] Formatação textual simples, sem máscara.
  format: plain
}
