// REVIEW [2026-12-15] service: example.com/services/billing

// REVIEW [2026-12-15] Documento que registra o cancelamento de um pedido.
document OrderCancellation {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Cancelamento de pedido", en: "Order cancellation" }
  // REVIEW [2026-12-15] Área responsável pelo documento.
  owner: "Billing"
  sync: live // REVIEW [2026-12-15] Sincronização em tempo real entre as partes.
  // REVIEW [2026-12-15] Campos que compõem o cancelamento.
  fields {
    // REVIEW [2026-12-15] Pedido cancelado; consultável.
    order: Order {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Pedido", en: "Order" }
      // REVIEW [2026-12-15] Permite localizar o cancelamento pelo pedido.
      lookup
    }
    // REVIEW [2026-12-15] Motivo do cancelamento; consultável.
    reason: string { title: { pt-BR: "Motivo", en: "Reason" }, lookup }
    // REVIEW [2026-12-15] Data em que o pedido foi cancelado.
    cancelledAt: DateTime { title: { pt-BR: "Cancelado em", en: "Cancelled at" } }
  }

  // REVIEW [2026-12-15] Ações disponíveis sobre o cancelamento.
  actions {
    // REVIEW [2026-12-15] Cancela o pedido com o motivo informado.
    cancel(reason: string){
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Cancelar", en: "Cancel" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [FinanceManager]
      // REVIEW [2026-12-15] Exige um motivo com pelo menos dez caracteres.
      rule reason.length >= 10 {
        // REVIEW [2026-12-15] Mensagem de validação em português.
        pt-BR: "Informe um motivo com pelo menos 10 caracteres"
        // REVIEW [2026-12-15] Mensagem de validação em inglês.
        en: "Enter a reason with at least 10 characters"
      }
    }
  }

  // REVIEW [2026-12-15] Invariante: todo cancelamento precisa de um motivo.
  rule reason != null {
    // REVIEW [2026-12-15] Mensagem de validação em português.
    pt-BR: "Preencha os campos obrigatórios"
    // REVIEW [2026-12-15] Mensagem de validação em inglês.
    en: "Fill the required fields"
  }
}
