// REVIEW [2026-12-15] service: example.com/services/billing

// REVIEW [2026-12-15] Documento que representa o faturamento consolidado de um mês.
document MonthlyRevenue {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Receita mensal", en: "Monthly revenue" }
  // REVIEW [2026-12-15] Área responsável pelo documento.
  // REVIEW [2026-12-15] Documento calculado a partir de notas e pagamentos.
  computed from Invoice, Payment
  freshness: 1h // REVIEW [2026-12-15] Tempo máximo antes de recomputar os dados.
  sync: read // REVIEW [2026-12-15] Sincronização apenas de leitura para consumidores externos.

  // REVIEW [2026-12-15] Campos que compõem a receita mensal.
  fields {
    // REVIEW [2026-12-15] Mês de referência da receita; consultável.
    month: YearMonth { title: { pt-BR: "Mês", en: "Month" }, lookup }
    // REVIEW [2026-12-15] Receita total do mês em reais; consultável.
    revenue: std.Money { title: { pt-BR: "Receita", en: "Revenue" }, lookup, currency: BRL }
    // REVIEW [2026-12-15] Quantidade de notas consideradas no mês.
    invoiceCount: std.Count { title: { pt-BR: "Qtd. de notas", en: "Invoice count" } }
    // REVIEW [2026-12-15] Momento em que o consolidado foi calculado.
    calculatedAt: DateTime { title: { pt-BR: "Calculado em", en: "Calculated at" } }
  }

  // REVIEW [2026-12-15] Garante um único registro por mês.
  indexes { month: [month] unique }

  // REVIEW [2026-12-15] Ações disponíveis sobre a receita mensal.
  actions {
    // REVIEW [2026-12-15] Recomputa os valores do consolidado.
    refresh(){
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Atualizar", en: "Refresh" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [FinanceManager]
    }
  }

  // REVIEW [2026-12-15] Invariante: a receita só existe a partir de janeiro de 2026.
  rule month >= 2026-01 {
    // REVIEW [2026-12-15] Mensagem de validação em português.
    pt-BR: "Verifique os dados informados"
    // REVIEW [2026-12-15] Mensagem de validação em inglês.
    en: "Check the informed data"
  }
}
