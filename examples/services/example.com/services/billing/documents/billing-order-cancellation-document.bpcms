// service: example.com/services/billing

// Documento que registra o cancelamento de um pedido.
document OrderCancellation {
  // Título exibido na interface.
  title: { pt-BR: "Cancelamento de pedido", en: "Order cancellation" }
  version: 1 // Versão do documento usada em release e comparação.
  // Área responsável pelo documento.
  owner: "Billing"
  sync: live // Sincronização em tempo real entre as partes.
  // Campos que compõem o cancelamento.
  fields {
    // Pedido cancelado; consultável.
    order: Order {
      // Título exibido no formulário.
      title: { pt-BR: "Pedido", en: "Order" }
      // Permite localizar o cancelamento pelo pedido.
      lookup
    }
    // Motivo do cancelamento; consultável.
    reason: string { title: { pt-BR: "Motivo", en: "Reason" }, lookup }
    // Data em que o pedido foi cancelado.
    cancelledAt: DateTime { title: { pt-BR: "Cancelado em", en: "Cancelled at" } }
  }

  // Ações disponíveis sobre o cancelamento.
  actions {
    // Cancela o pedido com o motivo informado.
    cancel(reason: string){
      // Título exibido no botão da ação.
      title: { pt-BR: "Cancelar", en: "Cancel" }
      // Papéis autorizados a executar a ação.
      roles: [FinanceManager]
      // Exige um motivo com pelo menos dez caracteres.
      rule reason.length >= 10 {
        // Mensagem de validação em português.
        pt-BR: "Informe um motivo com pelo menos 10 caracteres"
        // Mensagem de validação em inglês.
        en: "Enter a reason with at least 10 characters"
      }
    }
  }

  // Invariante: todo cancelamento precisa de um motivo.
  rule reason != null {
    // Mensagem de validação em português.
    pt-BR: "Preencha os campos obrigatórios"
    // Mensagem de validação em inglês.
    en: "Fill the required fields"
  }
}
