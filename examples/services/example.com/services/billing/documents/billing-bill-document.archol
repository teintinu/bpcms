// REVIEW [2026-12-15] service: example.com/services/billing

// REVIEW [2026-12-15] Documento que representa uma conta a pagar a fornecedores.
document Bill {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Conta a pagar", en: "Bill" }
  // REVIEW [2026-12-15] Área responsável pelo documento.
  owner: "Billing"
  sync: read // REVIEW [2026-12-15] Sincronização apenas de leitura para consumidores externos.
  // REVIEW [2026-12-15] Campos que compõem a conta a pagar.
  fields {
    // REVIEW [2026-12-15] Fornecedor credor da conta; consultável em buscas.
    supplier: string { title: { pt-BR: "Fornecedor", en: "Supplier" }, maxLength: 120, lookup }
    // REVIEW [2026-12-15] Valor monetário da conta em reais; consultável em buscas.
    amount: std.Money { title: { pt-BR: "Valor", en: "Amount" }, lookup, currency: BRL }
    // REVIEW [2026-12-15] Data de vencimento da conta.
    dueAt: DateTime { title: { pt-BR: "Vence em", en: "Due at" } }
    // REVIEW [2026-12-15] Situação atual no ciclo de vida da conta; consultável.
    status: BillStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    // REVIEW [2026-12-15] Data em que a conta foi efetivamente paga.
    paidAt: DateTime { title: { pt-BR: "Pago em", en: "Paid at" } }
  }

  // REVIEW [2026-12-15] Índices que aceleram as consultas mais frequentes.
  indexes {
    // REVIEW [2026-12-15] Indexa situação e vencimento para listar contas por estado.
    byStatus: [status, dueAt] range
  }


  // REVIEW [2026-12-15] Ações que alteram o estado da conta.
  actions {
    // REVIEW [2026-12-15] Registra o pagamento e move a conta para Paid.
    pay(paidAt: DateTime){
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Pagar", en: "Pay" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Clerk]

      // REVIEW [2026-12-15] Transição para o estado pago.
      to: status.Paid
      // REVIEW [2026-12-15] Emite o evento de pagamento com a data informada.
      emits { paidAt: now() }

      // REVIEW [2026-12-15] Efeitos colaterais aplicados ao documento.
      {
        // REVIEW [2026-12-15] Grava a data do pagamento.
        paidAt = now()
      }
    }

    // REVIEW [2026-12-15] Sinaliza que a conta venceu sem pagamento.
    markOverdue(){
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Marcar vencida", en: "Mark overdue" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Clerk]

      // REVIEW [2026-12-15] Transição para o estado vencido.
      to: status.Overdue
    }
  }

  // REVIEW [2026-12-15] Invariante: o valor da conta precisa ser positivo.
  rule amount > 0 {
    // REVIEW [2026-12-15] Mensagem de validação em português.
    pt-BR: "O valor deve ser maior que zero"
    // REVIEW [2026-12-15] Mensagem de validação em inglês.
    en: "Amount must be greater than zero"
  }
}

// REVIEW [2026-12-15] Shape de estado que modela o ciclo de vida da conta.
shape BillStatus {
  // REVIEW [2026-12-15] Título exibido no construtor.
  title: { pt-BR: "Situação da conta", en: "Bill status" }
  // REVIEW [2026-12-15] Deriva de uma máquina de estados.
  base: state
  // REVIEW [2026-12-15] Estado inicial de toda conta criada.
  initial: Open
  // REVIEW [2026-12-15] Estado em que a conta está em aberto.
  value Open {
    // REVIEW [2026-12-15] Rótulo do estado.
    title: { pt-BR: "Aberta", en: "Open" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Open
    // REVIEW [2026-12-15] Ordem de exibição do estado.
    ordinal: 10

    // REVIEW [2026-12-15] Transição permitida de aberta para paga.
    transition Paid {
      // REVIEW [2026-12-15] Título da transição no histórico.
      title: { pt-BR: "Conta paga", en: "Bill paid" }
      // REVIEW [2026-12-15] Dados carregados junto com a transição.
      payload {
        // REVIEW [2026-12-15] Data em que a conta foi paga.
        paidAt: DateTime { title: { pt-BR: "Paga em", en: "Paid at" } }
        // REVIEW [2026-12-15] Valor pago na quitação.
        amount: std.Money { title: { pt-BR: "Valor", en: "Amount" } }
      }
    }

    // REVIEW [2026-12-15] Transição permitida de aberta para vencida.
    transition Overdue {
      // REVIEW [2026-12-15] Título da transição no histórico.
      title: { pt-BR: "Conta vencida", en: "Bill overdue" }
      // REVIEW [2026-12-15] Dados carregados junto com a transição.
      payload {
        // REVIEW [2026-12-15] Data em que a conta venceu.
        dueAt: DateTime { title: { pt-BR: "Vencia em", en: "Due at" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado em que a conta foi quitada.
  value Paid {
    // REVIEW [2026-12-15] Rótulo do estado.
    title: { pt-BR: "Paga", en: "Paid" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Paid
    // REVIEW [2026-12-15] Ordem de exibição do estado.
    ordinal: 20
  }
  // REVIEW [2026-12-15] Estado em que a conta está vencida.
  value Overdue {
    // REVIEW [2026-12-15] Rótulo do estado.
    title: { pt-BR: "Vencida", en: "Overdue" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Overdue
    // REVIEW [2026-12-15] Ordem de exibição do estado.
    ordinal: 30

    // REVIEW [2026-12-15] Transição permitida de vencida para paga.
    transition Paid {
      // REVIEW [2026-12-15] Título da transição no histórico.
      title: { pt-BR: "Conta paga", en: "Bill paid" }
      // REVIEW [2026-12-15] Dados carregados junto com a transição.
      payload {
        // REVIEW [2026-12-15] Data em que a conta foi paga.
        paidAt: DateTime { title: { pt-BR: "Paga em", en: "Paid at" } }
        // REVIEW [2026-12-15] Valor pago na quitação.
        amount: std.Money { title: { pt-BR: "Valor", en: "Amount" } }
      }
    }
  }
  // REVIEW [2026-12-15] Formatação textual simples, sem máscara.
  format: plain
}
