// REVIEW [2026-12-15] service: example.com/services/billing

// REVIEW [2026-12-15] Documento fiscal que representa a nota emitida para um pedido.
document Invoice {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Nota fiscal", en: "Invoice" }
  version: 1 // REVIEW [2026-12-15] Versão do documento usada em release e comparação.
  // REVIEW [2026-12-15] Área responsável pelo documento.
  owner: "Billing"
  sync: live // REVIEW [2026-12-15] Sincronização em tempo real entre as partes.
  retention: 5y // REVIEW [2026-12-15] Retenção obrigatória do documento por cinco anos.

  // REVIEW [2026-12-15] Campos que compõem a nota fiscal.
  fields {
    // REVIEW [2026-12-15] Loja emissora; obrigatória e com padrão São Paulo.
    store: Store {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Loja", en: "Store" }
      // REVIEW [2026-12-15] Torna a loja obrigatória no preenchimento.
      required
      // REVIEW [2026-12-15] Loja padrão ao criar uma nota.
      default: Store.SP
    }
    // REVIEW [2026-12-15] Exercício fiscal da nota; obrigatório e com padrão 2026.
    fiscalYear: FiscalYear {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Exercício", en: "Fiscal year" }
      // REVIEW [2026-12-15] Torna o exercício obrigatório no preenchimento.
      required
      // REVIEW [2026-12-15] Exercício padrão ao criar uma nota.
      default: FiscalYear.Y2026
    }
    // REVIEW [2026-12-15] Número da nota; sequencial, único e consultável.
    number: InvoiceNumber {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Número", en: "Number" }
      // REVIEW [2026-12-15] Formato ano, código da loja e sequência.
      format: "{fiscalYear.year:yy}-{store.code:4}-{sequence:6}"
      // REVIEW [2026-12-15] Reinicia a sequência por loja e exercício.
      sequence: per(Store, FiscalYear)
      // REVIEW [2026-12-15] Impede números de nota repetidos.
      unique
      // REVIEW [2026-12-15] Permite localizar a nota pelo número.
      lookup
    }
    // REVIEW [2026-12-15] Pedido que originou a nota.
    order: Order {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Pedido", en: "Order" }
    }
    // REVIEW [2026-12-15] Cliente destinatário da nota; consultável.
    customer: User {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Cliente", en: "Customer" }
      // REVIEW [2026-12-15] Permite localizar a nota pelo cliente.
      lookup
    }
    // REVIEW [2026-12-15] Itens que compõem a nota.
    items: InvoiceItem[] { title: { pt-BR: "Itens", en: "Items" } }
    // REVIEW [2026-12-15] Subtotal calculado pela soma dos itens.
    subtotal: std.Money {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Subtotal", en: "Subtotal" }
      // REVIEW [2026-12-15] Moeda do subtotal.
      currency: BRL
      // REVIEW [2026-12-15] Calcula o subtotal a partir dos itens.
      computed: items.sum(total)
    }
    // REVIEW [2026-12-15] Imposto incidente sobre a nota.
    tax: std.Money { title: { pt-BR: "Imposto", en: "Tax" }, currency: BRL }
    // REVIEW [2026-12-15] Total da nota; consultável.
    total: std.Money {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Total", en: "Total" }
      // REVIEW [2026-12-15] Permite localizar a nota pelo total.
      lookup
      // REVIEW [2026-12-15] Moeda do total.
      currency: BRL
      // REVIEW [2026-12-15] Calcula o total somando subtotal e imposto.
      computed: subtotal + tax
    }
    // REVIEW [2026-12-15] Situação atual no ciclo de vida da nota; consultável.
    status: InvoiceStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    // REVIEW [2026-12-15] Data de emissão da nota.
    issuedAt: DateTime { title: { pt-BR: "Emitido em", en: "Issued at" } }
    // REVIEW [2026-12-15] Data de vencimento da nota.
    dueAt: DateTime { title: { pt-BR: "Vence em", en: "Due at" } }
  }

  // REVIEW [2026-12-15] Índices que aceleram as consultas mais frequentes.
  indexes {
    // REVIEW [2026-12-15] Garante unicidade do número da nota.
    number: [number] unique
    // REVIEW [2026-12-15] Indexa as notas por pedido de origem.
    byOrder: [order.id] hash
    // REVIEW [2026-12-15] Indexa situação e vencimento para listar por estado.
    byStatus: [status, dueAt] range
  }

  // REVIEW [2026-12-15] Ações que alteram o estado da nota.
  actions {
    // REVIEW [2026-12-15] Solicita a emissão da nota a partir de um pedido.
    request(order: Order){
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Solicitar nota", en: "Request invoice" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Clerk]
      // REVIEW [2026-12-15] Devolve a nota criada.
      returns: Invoice
      // REVIEW [2026-12-15] Efeitos colaterais aplicados ao documento.
      {
        // REVIEW [2026-12-15] Copia o cliente do pedido para a nota.
        customer = order.customer
        // REVIEW [2026-12-15] Emite o evento de nota solicitada com o pedido.
        emit Requested { order: order }
      }
    }

    // REVIEW [2026-12-15] Deriva os dados da nota a partir do pedido.
    deriveFromOrder(){
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Derivar do pedido", en: "Derive from order" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Clerk]
    }

    // REVIEW [2026-12-15] Aplica o imposto correspondente ao regime tributário.
    applyTax(){
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Aplicar imposto", en: "Apply tax" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Clerk]
    }

    // REVIEW [2026-12-15] Emite a nota e registra a data de emissão.
    issue(){
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Emitir", en: "Issue" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [FinanceManager]

      // REVIEW [2026-12-15] Transição para o estado emitido.
      to: status.Issued
      // REVIEW [2026-12-15] Emite o evento de emissão com a data atual.
      emits { issuedAt: now() }

      // REVIEW [2026-12-15] Exige total positivo para emitir a nota.
      rule total > 0 BRL {
        // REVIEW [2026-12-15] Mensagem de validação em português.
        pt-BR: "O valor deve ser maior que zero"
        // REVIEW [2026-12-15] Mensagem de validação em inglês.
        en: "Value must be greater than zero"
      }

      // REVIEW [2026-12-15] Efeitos colaterais aplicados ao documento.
      {
        // REVIEW [2026-12-15] Grava a data de emissão.
        issuedAt = now()
      }
    }

    // REVIEW [2026-12-15] Registra o pagamento da nota.
    pay(paidAt: DateTime){
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Pagar", en: "Pay" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Clerk]

      // REVIEW [2026-12-15] Transição para o estado pago.
      to: status.Paid
      // REVIEW [2026-12-15] Emite o valor total como evento de pagamento.
      emits { amount: total }
    }

    // REVIEW [2026-12-15] Sinaliza que a nota venceu sem pagamento.
    markOverdue(){
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Marcar vencida", en: "Mark overdue" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Clerk]

      // REVIEW [2026-12-15] Transição para o estado vencido.
      to: status.Overdue
    }

    // REVIEW [2026-12-15] Cancela a nota com um motivo justificado.
    cancel(reason: string){
      // REVIEW [2026-12-15] Título exibido no botão da ação.
      title: { pt-BR: "Cancelar", en: "Cancel" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [FinanceManager]

      // REVIEW [2026-12-15] Transição para o estado cancelado.
      to: status.Cancelled

      // REVIEW [2026-12-15] Exige um motivo com pelo menos dez caracteres.
      rule reason.length >= 10 {
        // REVIEW [2026-12-15] Mensagem de validação em português.
        pt-BR: "Informe um motivo com pelo menos 10 caracteres"
        // REVIEW [2026-12-15] Mensagem de validação em inglês.
        en: "Enter a reason with at least 10 characters"
      }
    }
  }

  // REVIEW [2026-12-15] Invariante: nota emitida precisa ter data de emissão.
  rule status == Issued implies issuedAt != null {
    // REVIEW [2026-12-15] Mensagem de validação em português.
    pt-BR: "Informe a data de emissão"
    // REVIEW [2026-12-15] Mensagem de validação em inglês.
    en: "Enter the issue date"
  }
}

// REVIEW [2026-12-15] Shape que representa uma linha de item da nota.
shape InvoiceItem {
  // REVIEW [2026-12-15] Título exibido no construtor.
  title: { pt-BR: "Item da nota", en: "Invoice item" }

  // REVIEW [2026-12-15] Campos que compõem o item da nota.
  fields {
    // REVIEW [2026-12-15] Produto vendido; consultável.
    product: Product {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Produto", en: "Product" }
      // REVIEW [2026-12-15] Permite localizar o item pelo produto.
      lookup
    }
    // REVIEW [2026-12-15] Quantidade vendida; consultável.
    quantity: std.Count {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Quantidade", en: "Quantity" }
      // REVIEW [2026-12-15] Permite localizar o item pela quantidade.
      lookup
    }
    // REVIEW [2026-12-15] Preço unitário do produto em reais.
    unitPrice: std.Money {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Preço unitário", en: "Unit price" }
      // REVIEW [2026-12-15] Moeda do preço unitário.
      currency: BRL
    }
    // REVIEW [2026-12-15] Total do item calculado por quantidade e preço.
    total: std.Money {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Total", en: "Total" }
      // REVIEW [2026-12-15] Moeda do total do item.
      currency: BRL
      // REVIEW [2026-12-15] Calcula o total multiplicando quantidade e preço.
      computed: quantity * unitPrice
    }
  }
}

// REVIEW [2026-12-15] Shape de estado que modela o ciclo de vida da nota fiscal.
shape InvoiceStatus {
  // REVIEW [2026-12-15] Título exibido no construtor.
  title: { pt-BR: "Situação da nota", en: "Invoice status" }
  // REVIEW [2026-12-15] Deriva de uma máquina de estados.
  base: state
  // REVIEW [2026-12-15] Estado inicial de rascunho, já com a transição de solicitação.
  initial: Draft with transition Requested {
    // REVIEW [2026-12-15] Título da transição no histórico.
    title: { pt-BR: "Nota solicitada", en: "Invoice requested" }
    // REVIEW [2026-12-15] Dados carregados junto com a transição.
    payload {
      // REVIEW [2026-12-15] Pedido que originou a nota.
      order: Order { title: { pt-BR: "Pedido", en: "Order" } }
    }
  }

  // REVIEW [2026-12-15] Estado de rascunho, ainda não emitido.
  value Draft {
    // REVIEW [2026-12-15] Rótulo do estado.
    title: { pt-BR: "Rascunho", en: "Draft" }
    // REVIEW [2026-12-15] Ícone do estado no namespace status.
    icon: status.draft
    // REVIEW [2026-12-15] Ordem de exibição do estado.
    ordinal: 10

    // REVIEW [2026-12-15] Transição permitida de rascunho para emitida.
    transition Issued {
      // REVIEW [2026-12-15] Título da transição no histórico.
      title: { pt-BR: "Nota emitida", en: "Invoice issued" }
      // REVIEW [2026-12-15] Dados carregados junto com a transição.
      payload {
        // REVIEW [2026-12-15] Data de emissão da nota.
        issuedAt: DateTime { title: { pt-BR: "Emitida em", en: "Issued at" } }
        // REVIEW [2026-12-15] Número atribuído à nota.
        number: InvoiceNumber { title: { pt-BR: "Número", en: "Number" } }
        // REVIEW [2026-12-15] Total apurado na emissão.
        total: std.Money { title: { pt-BR: "Total", en: "Total" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado em que a nota foi emitida.
  value Issued {
    // REVIEW [2026-12-15] Rótulo do estado.
    title: { pt-BR: "Emitida", en: "Issued" }
    // REVIEW [2026-12-15] Ícone do estado no namespace finance.
    icon: finance.invoice.issued
    // REVIEW [2026-12-15] Ordem de exibição do estado.
    ordinal: 20

    // REVIEW [2026-12-15] Transição permitida de emitida para paga.
    transition Paid {
      // REVIEW [2026-12-15] Título da transição no histórico.
      title: { pt-BR: "Nota paga", en: "Invoice paid" }
      // REVIEW [2026-12-15] Dados carregados junto com a transição.
      payload {
        // REVIEW [2026-12-15] Data em que a nota foi paga.
        paidAt: DateTime { title: { pt-BR: "Paga em", en: "Paid at" } }
        // REVIEW [2026-12-15] Valor pago na quitação.
        amount: std.Money { title: { pt-BR: "Valor", en: "Amount" } }
      }
    }

    // REVIEW [2026-12-15] Transição permitida de emitida para vencida.
    transition Overdue {
      // REVIEW [2026-12-15] Título da transição no histórico.
      title: { pt-BR: "Nota vencida", en: "Invoice overdue" }
      // REVIEW [2026-12-15] Dados carregados junto com a transição.
      payload {
        // REVIEW [2026-12-15] Data em que a nota venceu.
        dueAt: DateTime { title: { pt-BR: "Vencia em", en: "Due at" } }
      }
    }

    // REVIEW [2026-12-15] Transição permitida de emitida para cancelada.
    transition Cancelled {
      // REVIEW [2026-12-15] Título da transição no histórico.
      title: { pt-BR: "Nota cancelada", en: "Invoice cancelled" }
      // REVIEW [2026-12-15] Dados carregados junto com a transição.
      payload {
        // REVIEW [2026-12-15] Motivo do cancelamento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado em que a nota foi paga.
  value Paid {
    // REVIEW [2026-12-15] Rótulo do estado.
    title: { pt-BR: "Paga", en: "Paid" }
    // REVIEW [2026-12-15] Ícone do estado no namespace status.
    icon: status.paid
    // REVIEW [2026-12-15] Ordem de exibição do estado.
    ordinal: 30
  }
  // REVIEW [2026-12-15] Estado em que a nota está vencida.
  value Overdue {
    // REVIEW [2026-12-15] Rótulo do estado.
    title: { pt-BR: "Vencida", en: "Overdue" }
    // REVIEW [2026-12-15] Ícone do estado no namespace status.
    icon: status.overdue
    // REVIEW [2026-12-15] Ordem de exibição do estado.
    ordinal: 40

    // REVIEW [2026-12-15] Transição permitida de vencida para paga.
    transition Paid {
      // REVIEW [2026-12-15] Título da transição no histórico.
      title: { pt-BR: "Nota paga", en: "Invoice paid" }
      // REVIEW [2026-12-15] Dados carregados junto com a transição.
      payload {
        // REVIEW [2026-12-15] Data em que a nota foi paga.
        paidAt: DateTime { title: { pt-BR: "Paga em", en: "Paid at" } }
        // REVIEW [2026-12-15] Valor pago na quitação.
        amount: std.Money { title: { pt-BR: "Valor", en: "Amount" } }
      }
    }

    // REVIEW [2026-12-15] Transição permitida de vencida para cancelada.
    transition Cancelled {
      // REVIEW [2026-12-15] Título da transição no histórico.
      title: { pt-BR: "Nota cancelada", en: "Invoice cancelled" }
      // REVIEW [2026-12-15] Dados carregados junto com a transição.
      payload {
        // REVIEW [2026-12-15] Motivo do cancelamento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado em que a nota foi cancelada.
  value Cancelled {
    // REVIEW [2026-12-15] Rótulo do estado.
    title: { pt-BR: "Cancelada", en: "Cancelled" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Cancelled
    // REVIEW [2026-12-15] Ordem de exibição do estado.
    ordinal: 50
  }
  // REVIEW [2026-12-15] Formatação textual simples, sem máscara.
  format: plain
}

// REVIEW [2026-12-15] Shape textual que representa o número da nota.
shape InvoiceNumber {
  // REVIEW [2026-12-15] Título exibido no construtor.
  title: { pt-BR: "Número da nota", en: "Invoice number" }
  // REVIEW [2026-12-15] Deriva do tipo textual nativo.
  base: string
  // REVIEW [2026-12-15] Limita o número a quarenta caracteres.
  maxLength: 40
}

// REVIEW [2026-12-15] Política de retenção e anonimização das notas.
policy InvoiceRetention {
  // REVIEW [2026-12-15] Documento ao qual a política se aplica.
  appliesTo: Invoice
  // REVIEW [2026-12-15] Retém por cinco anos e depois anonimiza.
  rule: retainFor(5y) then anonymize
  // REVIEW [2026-12-15] Aplica a política de forma obrigatória.
  severity: enforce
  // REVIEW [2026-12-15] Registra a execução da política em auditoria.
  audit: true
}
