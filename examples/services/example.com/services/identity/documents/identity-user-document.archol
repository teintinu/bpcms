// REVIEW [2026-12-15] service: example.com/services/identity

// REVIEW [2026-12-15] Declara o documento de usuário, base para sessões, consumidores e recuperação de acesso.
document User {
  // REVIEW [2026-12-15] Título exibido no construtor e nas telas.
  title: { pt-BR: "Usuário", en: "User" }
  // REVIEW [2026-12-15] Versão do artefato Document; diff e release comparam.
  version: 1
  // REVIEW [2026-12-15] Time/área responsável pelo documento.
  owner: "Identity"
  // REVIEW [2026-12-15] Sincronização somente de leitura com a fonte de identidade.
  sync: read
  // REVIEW [2026-12-15] Campos do documento.
  fields {
    // REVIEW [2026-12-15] Nome completo da pessoa.
    name: string {
      // REVIEW [2026-12-15] Rótulos e textos de apoio do campo.
      title: {
        // REVIEW [2026-12-15] Rótulo longo em português.
        pt-BR: "Nome da pessoa"
        // REVIEW [2026-12-15] Rótulo longo em inglês.
        en: "Person name"
        // REVIEW [2026-12-15] Rótulo curto para telas estreitas.
        short: { pt-BR: "Pessoa", en: "Person" }
        // REVIEW [2026-12-15] Texto de ajuda exibido ao passar o mouse.
        tooltip: { pt-BR: "Nome completo da pessoa", en: "Full person name" }
      }
      // REVIEW [2026-12-15] Limite de caracteres do nome.
      maxLength: 120
      // REVIEW [2026-12-15] Torna o campo consultável em buscas.
      lookup
      // REVIEW [2026-12-15] Torna o preenchimento obrigatório.
      required
    }
    // REVIEW [2026-12-15] Apelido pelo qual a pessoa é tratada.
    nickname: string { title: { pt-BR: "Apelido", en: "Nickname" }, maxLength: 40, lookup }
    // REVIEW [2026-12-15] Imagem de perfil da pessoa.
    avatar: Image { title: { pt-BR: "Imagem de perfil", en: "Avatar" }, lookup }
    // REVIEW [2026-12-15] Correio eletrônico, único por usuário.
    email: Email { title: { pt-BR: "Correio eletrônico", en: "Email" }, unique, lookup }
    // REVIEW [2026-12-15] Situação atual do usuário no shape UserStatus.
    status: UserStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    // REVIEW [2026-12-15] Momento em que a identidade foi verificada.
    identityVerifiedAt: DateTime { title: { pt-BR: "Identidade verificada em", en: "Identity verified at" } }
    // REVIEW [2026-12-15] Momento em que a recuperação de acesso foi aprovada.
    recoveryApprovedAt: DateTime { title: { pt-BR: "Recuperação aprovada em", en: "Recovery approved at" } }
    // REVIEW [2026-12-15] Contador de tentativas de acesso, privado ao serviço.
    private loginAttempts: std.Count { title: { pt-BR: "Tentativas de acesso", en: "Login attempts" } }
    // REVIEW [2026-12-15] Momento de criação do usuário.
    createdAt: DateTime { title: { pt-BR: "Criado em", en: "Created at" } }
  }

  // REVIEW [2026-12-15] Índices de consulta do documento.
  indexes {
    // REVIEW [2026-12-15] Índice único por correio eletrônico, impedindo duplicidade.
    email: [email] unique
    // REVIEW [2026-12-15] Índice por situação e criação, para listar usuários por estado.
    byStatus: [status, createdAt] range
  }


  // REVIEW [2026-12-15] Ações de escrita disponíveis no documento.
  actions {
    // REVIEW [2026-12-15] Cria o usuário já com o evento de criação e a data de cadastro.
    create(name: string, email: Email){
      // REVIEW [2026-12-15] Título exibido na ação.
      title: { pt-BR: "Criar usuário", en: "Create user" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Admin]
      // REVIEW [2026-12-15] Corpo da ação: grava a criação e emite o evento com o nome.
      {
        // REVIEW [2026-12-15] Marca o instante de criação do usuário.
        createdAt = now()
        // REVIEW [2026-12-15] Emite o evento Created levando o nome no payload.
        emit Created { name }
      }
    }

    // REVIEW [2026-12-15] Suspende o acesso do usuário, exigindo justificativa.
    suspend(justification: string){
      // REVIEW [2026-12-15] Título exibido na ação.
      title: { pt-BR: "Suspender", en: "Suspend" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Admin]
      // REVIEW [2026-12-15] Transição aplicada: leva o status para Suspended.
      to: status.Suspended
      // REVIEW [2026-12-15] Payload da transição: motivo da suspensão.
      emits { reason: justification }
    }

    // REVIEW [2026-12-15] Desativa definitivamente o acesso do usuário.
    disable(){
      // REVIEW [2026-12-15] Título exibido na ação.
      title: { pt-BR: "Desativar", en: "Disable" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Manager]
      // REVIEW [2026-12-15] Transição aplicada: leva o status para Disabled.
      to: status.Disabled
    }

    // REVIEW [2026-12-15] Desbloqueia o acesso do usuário, voltando ao estado ativo.
    unlock(){
      // REVIEW [2026-12-15] Título exibido na ação.
      title: { pt-BR: "Desbloquear", en: "Unlock" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Manager]
      // REVIEW [2026-12-15] Transição aplicada: leva o status para Active.
      to: status.Active
    }

    // REVIEW [2026-12-15] Registra a verificação de identidade do usuário.
    confirmIdentity(){
      // REVIEW [2026-12-15] Título exibido na ação.
      title: { pt-BR: "Confirmar identidade", en: "Confirm identity" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Clerk]
      // REVIEW [2026-12-15] Corpo da ação: grava o instante da verificação.
      {
        // REVIEW [2026-12-15] Marca o momento em que a identidade foi confirmada.
        identityVerifiedAt = now()
      }
    }

    // REVIEW [2026-12-15] Registra a aprovação da recuperação de acesso.
    approveRecovery(){
      // REVIEW [2026-12-15] Título exibido na ação.
      title: { pt-BR: "Aprovar recuperação", en: "Approve recovery" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Manager]
      // REVIEW [2026-12-15] Corpo da ação: grava o instante da aprovação.
      {
        // REVIEW [2026-12-15] Marca o momento em que a recuperação foi aprovada.
        recoveryApprovedAt = now()
      }
    }

    // REVIEW [2026-12-15] Recalcula o risco do usuário, uso interno do serviço.
    private recalculateRisk(){
      // REVIEW [2026-12-15] Título exibido na ação.
      title: { pt-BR: "Recalcular risco", en: "Recalculate risk" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Admin]
      // REVIEW [2026-12-15] Tipo do valor devolvido pela ação.
      returns: std.Count
    }
  }

  // REVIEW [2026-12-15] Invariante: a aprovação da recuperação exige a verificação de identidade antes.
  rule recoveryApprovedAt != null implies identityVerifiedAt != null {
    // REVIEW [2026-12-15] Mensagem da regra em português.
    pt-BR: "A recuperação exige a verificação de identidade antes da aprovação"
    // REVIEW [2026-12-15] Mensagem da regra em inglês.
    en: "Recovery requires identity verification before approval"

  }
}

// REVIEW [2026-12-15] Shape de estados do ciclo de vida do usuário.
shape UserStatus {
  // REVIEW [2026-12-15] Título exibido no construtor e nas telas.
  title: { pt-BR: "Situação do usuário", en: "User status" }
  // REVIEW [2026-12-15] Base do shape: máquina de estados.
  base: state
  // REVIEW [2026-12-15] Estado inicial Active, alcançado pela transição Created.
  initial: Active with transition Created {
    // REVIEW [2026-12-15] Título da transição de criação.
    title: { pt-BR: "Usuário criado", en: "User created" }
    // REVIEW [2026-12-15] Payload exigido pela transição de criação.
    payload {
      // REVIEW [2026-12-15] Nome levado na criação do usuário.
      name: string { title: { pt-BR: "Nome", en: "Name" } }
    }
  }
  // REVIEW [2026-12-15] Estado de usuário ativo.
  value Active {
    // REVIEW [2026-12-15] Título exibido para o valor.
    title: { pt-BR: "Ativo", en: "Active" }
    // REVIEW [2026-12-15] Ícone exibido junto ao valor.
    icon: Active
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 10

    // REVIEW [2026-12-15] Transição de suspensão do usuário.
    transition Suspended {
      // REVIEW [2026-12-15] Título da transição.
      title: { pt-BR: "Usuário suspenso", en: "User suspended" }
      // REVIEW [2026-12-15] Payload exigido pela transição de suspensão.
      payload {
        // REVIEW [2026-12-15] Motivo da suspensão.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }

    // REVIEW [2026-12-15] Transição de desativação do usuário.
    transition Disabled {
      // REVIEW [2026-12-15] Título da transição.
      title: { pt-BR: "Usuário desativado", en: "User disabled" }
    }
  }
  // REVIEW [2026-12-15] Estado de usuário suspenso.
  value Suspended {
    // REVIEW [2026-12-15] Título exibido para o valor.
    title: { pt-BR: "Suspenso", en: "Suspended" }
    // REVIEW [2026-12-15] Ícone exibido junto ao valor.
    icon: Suspended
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 20

    // REVIEW [2026-12-15] Transição de desativação a partir da suspensão.
    transition Disabled {
      // REVIEW [2026-12-15] Título da transição.
      title: { pt-BR: "Usuário desativado", en: "User disabled" }
    }

    // REVIEW [2026-12-15] Transição de reativação do acesso.
    transition Active {
      // REVIEW [2026-12-15] Nome do evento que dispara a reativação.
      event: Unlocked
      // REVIEW [2026-12-15] Título da transição.
      title: { pt-BR: "Acesso liberado", en: "Access unlocked" }
    }
  }
  // REVIEW [2026-12-15] Estado de usuário desativado.
  value Disabled {
    // REVIEW [2026-12-15] Título exibido para o valor.
    title: { pt-BR: "Desativado", en: "Disabled" }
    // REVIEW [2026-12-15] Ícone exibido junto ao valor.
    icon: Disabled
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 30

    // REVIEW [2026-12-15] Transição de reativação do acesso.
    transition Active {
      // REVIEW [2026-12-15] Nome do evento que dispara a reativação.
      event: Unlocked
      // REVIEW [2026-12-15] Título da transição.
      title: { pt-BR: "Acesso liberado", en: "Access unlocked" }
    }
  }
  // REVIEW [2026-12-15] Formato de apresentação do shape: texto simples.
  format: plain
}
