// REVIEW [2026-12-15] service: example.com/services/identity

// REVIEW [2026-12-15] Consumer compartilha User: Consumer é alias do mesmo id.
// REVIEW [2026-12-15] Vários Users podem referenciar o mesmo Citizen; não há unique aqui.
// REVIEW [2026-12-15] Declara o documento Consumer, que estende User e acrescenta o vínculo com o cidadão.
document Consumer extends User {
  // REVIEW [2026-12-15] Título exibido no construtor e nas telas.
  title: { pt-BR: "Consumidor", en: "Consumer" }
  // REVIEW [2026-12-15] Versão do artefato Document; diff e release comparam.
  // REVIEW [2026-12-15] Time/área responsável pelo documento.
  owner: "Identity"
  // REVIEW [2026-12-15] Sincronização somente de leitura com a fonte de identidade.
  sync: read

  // REVIEW [2026-12-15] Campos próprios do Consumer, além dos herdados de User.
  fields {
    // REVIEW [2026-12-15] Referência ao cidadão vinculado ao consumidor.
    citizen: Citizen {
      // REVIEW [2026-12-15] Título exibido para o campo.
      title: { pt-BR: "Cidadão", en: "Citizen" }
    }
  }

  // REVIEW [2026-12-15] Índices de consulta do documento.
  indexes {
    // REVIEW [2026-12-15] Índice hash pelo id do cidadão, para achar os consumidores de um cidadão.
    byCitizen: [citizen.id] hash
  }

  // REVIEW [2026-12-15] Ações de escrita disponíveis no documento.
  actions {
    // REVIEW [2026-12-15] Vincula um cidadão ao consumidor.
    setCitizen(citizen: Citizen){
      // REVIEW [2026-12-15] Título exibido na ação.
      title: { pt-BR: "Vincular cidadão", en: "Link citizen" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Admin]
    }
  }

  // REVIEW [2026-12-15] Invariante: ter cidadão vinculado exige o consumidor ativo.
  rule citizen != null implies status == Active {
    // REVIEW [2026-12-15] Mensagem da regra em português.
    pt-BR: "Cidadão vinculado deve estar ativo"
    // REVIEW [2026-12-15] Mensagem da regra em inglês.
    en: "Linked citizen must be active"

  }
}
