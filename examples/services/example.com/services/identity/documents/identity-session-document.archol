// REVIEW [2026-12-15] service: example.com/services/identity

// REVIEW [2026-12-15] Declara o documento de sessão de acesso do usuário.
document Session {
  // REVIEW [2026-12-15] Título exibido no construtor e nas telas.
  title: { pt-BR: "Sessão", en: "Session" }
  // REVIEW [2026-12-15] Versão do artefato Document; diff e release comparam.
  // REVIEW [2026-12-15] Time/área responsável pelo documento.
  // REVIEW [2026-12-15] Sincronização somente de leitura com a fonte de identidade.
  sync: read

  // REVIEW [2026-12-15] Campos do documento.
  fields {
    // REVIEW [2026-12-15] Referência ao usuário dono da sessão.
    user: User {
      // REVIEW [2026-12-15] Título exibido para o campo.
      title: { pt-BR: "Usuário", en: "User" }
    }
    // REVIEW [2026-12-15] Momento de emissão da sessão, indexado para busca.
    issuedAt: DateTime { title: { pt-BR: "Emitido em", en: "Issued at" }, lookup }
    // REVIEW [2026-12-15] Momento em que a sessão deixa de valer.
    expiresAt: DateTime { title: { pt-BR: "Expira em", en: "Expires at" } }
    // REVIEW [2026-12-15] Situação atual da sessão, indexada para busca.
    status: SessionStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
  }

  // REVIEW [2026-12-15] Índices de consulta do documento.
  indexes {
    // REVIEW [2026-12-15] Índice por usuário e emissão, para listar sessões em ordem cronológica.
    byUser: [user.id, issuedAt] range
    // REVIEW [2026-12-15] Índice por expiração, para varrer sessões vencidas.
    byExpiry: [expiresAt] range
  }


  // REVIEW [2026-12-15] Ações de escrita disponíveis no documento.
  actions {
    // REVIEW [2026-12-15] Inicia uma sessão validando credenciais.
    start(email: Email, password: string){
      // REVIEW [2026-12-15] Título exibido na ação.
      title: { pt-BR: "Iniciar sessão", en: "Sign in" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Customer]
      // REVIEW [2026-12-15] Corpo da ação: define emissão, expiração e emite o evento de início.
      {
        // REVIEW [2026-12-15] Marca o instante de emissão da sessão.
        issuedAt = now()
        // REVIEW [2026-12-15] Expira a sessão depois do TTL configurado no parâmetro SessionTtl.
        expiresAt = now() + SessionTtl
        // REVIEW [2026-12-15] Emite o evento Started, que leva o estado a Active.
        emit Started
      }
    }

    // REVIEW [2026-12-15] Encerra a sessão a pedido do usuário.
    end(){
      // REVIEW [2026-12-15] Título exibido na ação.
      title: { pt-BR: "Encerrar", en: "End" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Customer]
      // REVIEW [2026-12-15] Transição aplicada: leva o status para Ended.
      to: status.Ended
    }

    // REVIEW [2026-12-15] Expira a sessão em nome da administração.
    expire(){
      // REVIEW [2026-12-15] Título exibido na ação.
      title: { pt-BR: "Expirar", en: "Expire" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a ação.
      roles: [Admin]
      // REVIEW [2026-12-15] Transição aplicada: leva o status para Expired.
      to: status.Expired
    }
  }

  // REVIEW [2026-12-15] Invariante: a expiração precisa ser posterior à emissão.
  rule expiresAt > issuedAt {
    // REVIEW [2026-12-15] Mensagem da regra em português.
    pt-BR: "A expiração deve ser posterior à emissão"
    // REVIEW [2026-12-15] Mensagem da regra em inglês.
    en: "Expiration must be after issuance"

  }
}

// REVIEW [2026-12-15] Shape de estados do ciclo de vida da sessão.
shape SessionStatus {
  // REVIEW [2026-12-15] Título exibido no construtor e nas telas.
  title: { pt-BR: "Situação da sessão", en: "Session status" }
  // REVIEW [2026-12-15] Base do shape: máquina de estados.
  base: state
  // REVIEW [2026-12-15] Estado inicial Active, alcançado pela transição Created.
  initial: Active with transition Started {
    // REVIEW [2026-12-15] Título da transição de criação.
    title: { pt-BR: "Sessão iniciada", en: "Session started" }
  }
  // REVIEW [2026-12-15] Estado de sessão válida.
  value Active {
    // REVIEW [2026-12-15] Título exibido para o valor.
    title: { pt-BR: "Ativa", en: "Active" }
    // REVIEW [2026-12-15] Ícone exibido junto ao valor.
    icon: Active
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 10

    // REVIEW [2026-12-15] Transição de encerramento da sessão.
    transition Ended {
      // REVIEW [2026-12-15] Título da transição.
      title: { pt-BR: "Sessão encerrada", en: "Session ended" }
    }

    // REVIEW [2026-12-15] Transição de expiração da sessão.
    transition Expired {
      // REVIEW [2026-12-15] Título da transição.
      title: { pt-BR: "Sessão expirada", en: "Session expired" }
    }
  }
  // REVIEW [2026-12-15] Estado de sessão encerrada.
  value Ended {
    // REVIEW [2026-12-15] Título exibido para o valor.
    title: { pt-BR: "Encerrada", en: "Ended" }
    // REVIEW [2026-12-15] Ícone exibido junto ao valor.
    icon: Ended
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 20
  }
  // REVIEW [2026-12-15] Estado de sessão expirada.
  value Expired {
    // REVIEW [2026-12-15] Título exibido para o valor.
    title: { pt-BR: "Expirada", en: "Expired" }
    // REVIEW [2026-12-15] Ícone exibido junto ao valor.
    icon: Expired
    // REVIEW [2026-12-15] Ordem de exibição do valor.
    ordinal: 30
  }
  // REVIEW [2026-12-15] Formato de apresentação do shape: texto simples.
  format: plain
}

// REVIEW [2026-12-15] Form de acesso que coleta as credenciais e inicia a sessão.
form SignIn {
  // REVIEW [2026-12-15] Título exibido na tela de acesso.
  title: { pt-BR: "Formulário de acesso", en: "Sign in" }
  // REVIEW [2026-12-15] Documento manipulado pelo form.
  document: Session

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Correio eletrônico usado como identificação.
    email: Email {
      // REVIEW [2026-12-15] Título exibido para o campo.
      title: { pt-BR: "Correio eletrônico", en: "Email" }
      // REVIEW [2026-12-15] Torna o preenchimento obrigatório.
      required
    }
    // REVIEW [2026-12-15] Senha informada pelo usuário.
    password: string {
      // REVIEW [2026-12-15] Título exibido para o campo.
      title: { pt-BR: "Senha", en: "Password" }
      // REVIEW [2026-12-15] Limite de caracteres aceito no campo.
      maxLength: 128
      // REVIEW [2026-12-15] Torna o preenchimento obrigatório.
      required
    }
  }

  // REVIEW [2026-12-15] Ações disponíveis no formulário.
  actions {
    // REVIEW [2026-12-15] Envia as credenciais; a action inicia a sessão com email e senha.
    signIn { calls: Session.start(email, password) }
  }
}
