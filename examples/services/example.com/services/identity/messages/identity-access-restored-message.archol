// REVIEW [2026-12-15] service: example.com/services/identity

// REVIEW [2026-12-15] Mensagem de acesso restaurado enviada ao usuário ao fim da recuperação.
message AccessRestored {
  // REVIEW [2026-12-15] Título exibido no construtor e no histórico.
  title: { pt-BR: "Acesso restaurado", en: "Access restored" }
  // REVIEW [2026-12-15] Documento sobre o qual a mensagem fala.
  about: User
  // REVIEW [2026-12-15] Dados levados no payload da mensagem.
  payload {
    // REVIEW [2026-12-15] Nome do usuário notificado.
    name: string { title: { pt-BR: "Nome", en: "Name" } }
    // REVIEW [2026-12-15] Correio eletrônico do usuário notificado.
    email: Email { title: { pt-BR: "Correio eletrônico", en: "Email" } }
  }
}
