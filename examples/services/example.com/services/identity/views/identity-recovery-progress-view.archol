// service: example.com/services/identity

// View de andamento derivada da instância do processo.
view RecoveryProgress {
  // Título exibido na navegação.
  title: { pt-BR: "Andamento da recuperação", en: "Recovery progress" }
  // Tipo da view: tela de andamento de processo.
  type: process
  // Processo cujo andamento esta view exibe.
  process: AccountRecovery
  // Papéis que podem abrir a view.
  roles: [Clerk, Manager, Customer]

  // Seções fixas exibidas na tela de andamento.
  sections { current; participants; history; deadlines; documents; next }
}
