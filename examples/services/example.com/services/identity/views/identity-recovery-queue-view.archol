// REVIEW [2026-12-15] service: example.com/services/identity

// REVIEW [2026-12-15] View de inbox que organiza os casos de recuperação de acesso por papel.
view RecoveryQueue {
  // REVIEW [2026-12-15] Título exibido na navegação e na tela da fila.
  title: { pt-BR: "Fila de recuperação de acesso", en: "Account recovery queue" }
  // REVIEW [2026-12-15] Tipo da view: caixa de entrada de trabalho.
  type: inbox
  // REVIEW [2026-12-15] Papéis que podem abrir a fila.
  roles: [Clerk, Manager]
  // REVIEW [2026-12-15] Escopo dos itens: restrito aos papéis do usuário.
  scope: roles
  // REVIEW [2026-12-15] Agrupa os itens da fila pelo papel do usuário.
  groupBy: role
  // REVIEW [2026-12-15] Filtro da consulta: só itens de papéis que o usuário possui.
  filter { role in currentUser.roles }
  // REVIEW [2026-12-15] Colunas exibidas em cada linha da fila.
  columns { title; subject; role; dueAt; priority }
}
