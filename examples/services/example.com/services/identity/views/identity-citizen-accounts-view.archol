// REVIEW [2026-12-15] service: example.com/services/identity

// REVIEW [2026-12-15] View de tabela que lista as contas de um cidadão.
view CitizenAccounts {
  // REVIEW [2026-12-15] Título exibido na navegação e na tela.
  title: { pt-BR: "Usuários do cidadão", en: "Citizen accounts" }
  // REVIEW [2026-12-15] Tipo da view: tabela consultável.
  type: table
  // REVIEW [2026-12-15] Documento que alimenta a tabela.
  source: Consumer
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [Clerk, Manager]

  // REVIEW [2026-12-15] Colunas exibidas na tabela.
  columns { nickname; email; citizen; status }
  // REVIEW [2026-12-15] Filtros disponíveis para refinar a consulta.
  filters { citizen; status }
  // REVIEW [2026-12-15] Itens por página da tabela.
  pagination: 50
}
