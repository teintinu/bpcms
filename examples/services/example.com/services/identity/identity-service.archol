// REVIEW [2026-12-15] Declara o serviço de negócio Identidade, dono de usuários, sessões, consumidores e recuperação de acesso.
service "example.com/services/identity" {
  // REVIEW [2026-12-15] Título exibido no construtor e na navegação.
  title: { pt-BR: "Identidade", en: "Identity" }
  // REVIEW [2026-12-15] Versão do artefato Service; diff e release comparam.
  version: 1.0.0
  // REVIEW [2026-12-15] Time/área responsável pelo serviço.
  owner: "Platform Identity"
  // REVIEW [2026-12-15] Dependências externas usadas pelos artefatos deste serviço.
  imports {
    // REVIEW [2026-12-15] Importa as medidas e constantes padrão do construtor sob o alias std.
    service "bpcms.org/std" as std
    // REVIEW [2026-12-15] Importa o serviço Citizen, dono do tipo de cidadão vinculado ao consumidor.
    service "example.com/services/citizen" as Citizen
  }
}
