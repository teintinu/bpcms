// REVIEW [2026-12-15] service: example.com/services/identity
// REVIEW [2026-12-15] Process: sintaxe atual (DSL_REFERENCE.md §4)

// REVIEW [2026-12-15] Declara o processo de recuperação de acesso; o argumento é o documento-sujeito da instância.
process AccountRecovery(user: User) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Recuperação de acesso", en: "Account recovery" }
  // REVIEW [2026-12-15] Versão do artefato Process; diff e release comparam.
  version: 1
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Verificar a identidade, aprovar a recuperação e desbloquear o acesso"
  }
  // REVIEW [2026-12-15] SLA brando do caso: alvo de lead time, não é timer.
  sla: 3d

  // REVIEW [2026-12-15] Papéis que participam do caso.
  by: [Clerk, Manager]

  // REVIEW [2026-12-15] Bloco que captura o timeout da verificação de identidade.
  try {
    // REVIEW [2026-12-15] Abre o form de verificação de identidade para o usuário.
    IdentityVerification.show({ user })
  } catch (Timeout) {
    // REVIEW [2026-12-15] on timer da verificação: escala e segue para a aprovação
    // REVIEW [2026-12-15] Prazo estourado: abre a tarefa manual de escalonamento do caso.
    EscalateRecovery.show({ user })
  }

  // REVIEW [2026-12-15] Verificação concluída: abre o form de aprovação da recuperação.
  RecoveryApproval.show({ user })

  // REVIEW [2026-12-15] Aprovação dada: desbloqueia o acesso, levando o status a Active.
  User.unlock()

  // REVIEW [2026-12-15] Envia a mensagem de acesso restaurado ao usuário.
  send AccessRestored {
    // REVIEW [2026-12-15] Chave de identidade/correlação da mensagem.
    key: user
    // REVIEW [2026-12-15] Dados levados no payload da mensagem.
    with {
      // REVIEW [2026-12-15] Nome do usuário usado na mensagem.
      name: user.name
      // REVIEW [2026-12-15] Correio eletrônico usado na mensagem.
      email: user.email
    }
  }

  // REVIEW [2026-12-15] Encerra o caso no desfecho de sucesso.
  return Restored

  // REVIEW [2026-12-15] Declara o desfecho de sucesso do caso.
  end Restored {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Acesso restaurado", en: "Access restored" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }
}

// REVIEW [2026-12-15] Form de verificação de identidade do solicitante.
form IdentityVerification {
  // REVIEW [2026-12-15] Título exibido na inbox e no formulário.
  title: { pt-BR: "Verificação de identidade", en: "Identity verification" }
  // REVIEW [2026-12-15] Documento manipulado pelo form.
  document: User
  // REVIEW [2026-12-15] Papéis que podem atender o form.
  roles: [Clerk]
  // REVIEW [2026-12-15] Prazo para conclusão; estourar dispara o erro Timeout.
  timeout: 2d
  // REVIEW [2026-12-15] Prioridade do item na fila de trabalho.
  priority: 50
  // REVIEW [2026-12-15] Modo de atribuição: o atendente puxa o item da fila.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Nome da pessoa, usado na conferência da identidade.
    name
    // REVIEW [2026-12-15] Correio eletrônico da pessoa.
    email
    // REVIEW [2026-12-15] Apelido da pessoa.
    nickname
    // REVIEW [2026-12-15] Situação atual do usuário.
    status
  }

  // REVIEW [2026-12-15] Ações disponíveis no formulário.
  actions {
    // REVIEW [2026-12-15] Confirma a identidade verificada; a action grava identityVerifiedAt.
    confirm { calls: User.confirmIdentity }
  }
}

// REVIEW [2026-12-15] Form de aprovação da recuperação, restrito ao gerente.
form RecoveryApproval {
  // REVIEW [2026-12-15] Título exibido na inbox e no formulário.
  title: { pt-BR: "Aprovação da recuperação", en: "Recovery approval" }
  // REVIEW [2026-12-15] Documento manipulado pelo form.
  document: User
  // REVIEW [2026-12-15] Papéis que podem atender o form.
  roles: [Manager]
  // REVIEW [2026-12-15] Prazo para conclusão; estourar dispara o erro Timeout.
  timeout: 1d
  // REVIEW [2026-12-15] Modo de atribuição: o gerente puxa o item da fila.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Nome da pessoa.
    name
    // REVIEW [2026-12-15] Correio eletrônico da pessoa.
    email
    // REVIEW [2026-12-15] Situação atual do usuário.
    status
    // REVIEW [2026-12-15] Momento em que a identidade foi verificada.
    identityVerifiedAt
  }

  // REVIEW [2026-12-15] Ações disponíveis no formulário.
  actions {
    // REVIEW [2026-12-15] Aprova a recuperação; a action grava recoveryApprovedAt.
    approve { calls: User.approveRecovery }
  }
}

// REVIEW [2026-12-15] Tarefa manual de escalonamento quando a verificação não conclui no prazo.
manual EscalateRecovery {
  // REVIEW [2026-12-15] Título exibido na inbox e no histórico.
  title: { pt-BR: "Escalar recuperação de acesso", en: "Escalate account recovery" }
  // REVIEW [2026-12-15] Documento manipulado pela tarefa.
  document: User
  // REVIEW [2026-12-15] Papéis que podem atender a tarefa.
  roles: [Manager]
  // REVIEW [2026-12-15] Orientações exibidas ao responsável pela tarefa.
  instructions: "Falar com o solicitante e revisar a verificação"
  // REVIEW [2026-12-15] Prazo para conclusão da tarefa.
  timeout: 4h
}
