// REVIEW [2026-12-15] service: example.com/services/payments

// REVIEW [2026-12-15] Documento que representa uma cobrança feita a um pedido.
document Payment {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Pagamento", en: "Payment" }
  version: 2 // REVIEW [2026-12-15] Versão do artefato Document; entra no diff e no release.
  owner: "Payments" // REVIEW [2026-12-15] Área responsável pelo documento.
  sync: live // REVIEW [2026-12-15] Sincronização em tempo real entre instâncias.

  // REVIEW [2026-12-15] Campos que compõem o pagamento.
  fields {
    // REVIEW [2026-12-15] Pedido de origem da cobrança; consultável.
    order: Order {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Pedido", en: "Order" }
      lookup // REVIEW [2026-12-15] Permite localizar pelo pedido.
    }
    // REVIEW [2026-12-15] Valor da cobrança em reais; consultável.
    amount: std.Money { title: { pt-BR: "Valor", en: "Amount" }, lookup, currency: BRL }
    // REVIEW [2026-12-15] Forma de pagamento escolhida.
    method: PaymentMethod { title: { pt-BR: "Método", en: "Method" } }
    // REVIEW [2026-12-15] Situação atual da cobrança; consultável.
    status: PaymentStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    // REVIEW [2026-12-15] Código devolvido pelo adquirente ao autorizar.
    authorizationCode: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Código de autorização", en: "Authorization code" }
      maxLength: 60 // REVIEW [2026-12-15] Limita o código a sessenta caracteres.
    }
    // REVIEW [2026-12-15] Instante em que a cobrança foi autorizada.
    authorizedAt: DateTime { title: { pt-BR: "Autorizado em", en: "Authorized at" } }
    // REVIEW [2026-12-15] Instante em que a cobrança foi capturada.
    capturedAt: DateTime { title: { pt-BR: "Capturado em", en: "Captured at" } }
    // REVIEW [2026-12-15] Texto do comprovante emitido pelo adquirente.
    acquirerReceipt: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Comprovante do adquirente", en: "Acquirer receipt" }
      maxLength: 60 // REVIEW [2026-12-15] Limita o comprovante a sessenta caracteres.
    }
    // REVIEW [2026-12-15] Motivo detalhado da falha, quando houver.
    failureDetail: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Detalhe da falha", en: "Failure detail" }
      maxLength: 300 // REVIEW [2026-12-15] Limita o detalhe a trezentos caracteres.
    }
    // REVIEW [2026-12-15] Observações internas livres.
    notes: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Observações", en: "Notes" }
      maxLength: 1000 // REVIEW [2026-12-15] Limita as observações a mil caracteres.
    }
    // REVIEW [2026-12-15] Instante de criação do registro.
    createdAt: DateTime { title: { pt-BR: "Criado em", en: "Created at" } }
  }

  // REVIEW [2026-12-15] Índices de consulta do documento.
  indexes {
    // REVIEW [2026-12-15] Busca os pagamentos de um pedido por hash.
    byOrder: [order.id] hash
    // REVIEW [2026-12-15] Ordena os pagamentos por situação e data de captura.
    byStatus: [status, capturedAt] range
  }


  // REVIEW [2026-12-15] Ações que alteram o pagamento e disparam transições de situação.
  actions {
    // REVIEW [2026-12-15] Registra uma nova cobrança a partir do pedido, valor e método.
    create(order: Order, amount: std.Money, method: PaymentMethod) {
      // REVIEW [2026-12-15] Título exibido no botão e na trilha.
      title: { pt-BR: "Registrar cobrança", en: "Register charge" }
      // REVIEW [2026-12-15] Papéis autorizados a registrar a cobrança.
      roles: [Analyst]
      {
        // REVIEW [2026-12-15] Carimba o instante de criação.
        createdAt = now()
        emit Created // REVIEW [2026-12-15] Emite o evento de cobrança criada.
      }
    }

    // REVIEW [2026-12-15] Autoriza a cobrança com o código devolvido pelo gateway.
    authorize(authorization: string) {
      // REVIEW [2026-12-15] Título exibido no botão e na trilha.
      title: { pt-BR: "Autorizar", en: "Authorize" }
      // REVIEW [2026-12-15] Papéis autorizados a autorizar.
      roles: [PaymentEngine]

      // REVIEW [2026-12-15] Move a situação para Autorizado.
      to: status.Authorized
      // REVIEW [2026-12-15] Payload do evento de autorização emitido pela transição.
      emits { authorizationCode: authorization }
      {
        // REVIEW [2026-12-15] Grava o código de autorização no pagamento.
        authorizationCode = authorization
        // REVIEW [2026-12-15] Carimba o instante da autorização.
        authorizedAt = now()
      }
    }

    // REVIEW [2026-12-15] Captura a cobrança já autorizada.
    capture(receipt: string) {
      // REVIEW [2026-12-15] Título exibido no botão e na trilha.
      title: { pt-BR: "Capturar", en: "Capture" }
      // REVIEW [2026-12-15] Papéis autorizados a capturar.
      roles: [PaymentEngine]

      // REVIEW [2026-12-15] Move a situação para Capturado.
      to: status.Captured
      {
        // REVIEW [2026-12-15] Guarda o comprovante do adquirente.
        acquirerReceipt = receipt
        // REVIEW [2026-12-15] Carimba o instante da captura.
        capturedAt = now()
      }
    }

    // REVIEW [2026-12-15] Registra a falha da cobrança com um motivo.
    fail(failureReason: string) {
      // REVIEW [2026-12-15] Título exibido no botão e na trilha.
      title: { pt-BR: "Registrar falha", en: "Record failure" }
      // REVIEW [2026-12-15] Papéis autorizados a registrar falha.
      roles: [PaymentEngine]

      // REVIEW [2026-12-15] Move a situação para Falhou.
      to: status.Failed
      {
        // REVIEW [2026-12-15] Persiste o motivo da falha.
        failureDetail = failureReason
      }
    }

    // REVIEW [2026-12-15] Estorna o valor da cobrança.
    refund(refundAmount: std.Money) {
      // REVIEW [2026-12-15] Título exibido no botão e na trilha.
      title: { pt-BR: "Estornar", en: "Refund" }
      // REVIEW [2026-12-15] Papéis autorizados a estornar.
      roles: [Manager, PaymentEngine]

      // REVIEW [2026-12-15] Move a situação para Reembolsado.
      to: status.Refunded
      // REVIEW [2026-12-15] Payload do evento de estorno emitido pela transição.
      emits { amount: refundAmount }

      // REVIEW [2026-12-15] Regra de negócio: o estorno precisa ter valor positivo.
      rule refundAmount > 0 BRL {
        // REVIEW [2026-12-15] Mensagem da regra em português.
        pt-BR: "O valor do estorno deve ser maior que zero"
        // REVIEW [2026-12-15] Mensagem da regra em inglês.
        en: "Refund amount must be greater than zero"
      }
    }

    // REVIEW [2026-12-15] Acrescenta uma observação interna ao pagamento.
    annotate(note: string) {
      // REVIEW [2026-12-15] Título exibido no botão e na trilha.
      title: { pt-BR: "Anotar", en: "Annotate" }
      // REVIEW [2026-12-15] Papéis autorizados a anotar.
      roles: [Analyst]
      {
        // REVIEW [2026-12-15] Persiste a observação no campo de notas.
        notes = note
      }
    }
  }

  // REVIEW [2026-12-15] Regra de negócio: todo pagamento precisa ter valor positivo.
  rule amount > 0 {
    // REVIEW [2026-12-15] Mensagem da regra em português.
    pt-BR: "O valor deve ser maior que zero"
    // REVIEW [2026-12-15] Mensagem da regra em inglês.
    en: "Amount must be greater than zero"
  }
  // REVIEW [2026-12-15] Regra de negócio: pagamento capturado precisa ter data de captura.
  rule status == Captured implies capturedAt != null {
    // REVIEW [2026-12-15] Mensagem da regra em português.
    pt-BR: "Informe a data de captura"
    // REVIEW [2026-12-15] Mensagem da regra em inglês.
    en: "Enter the capture date"
  }
}

// REVIEW [2026-12-15] Máquina de estados da situação do pagamento.
shape PaymentStatus {
  // REVIEW [2026-12-15] Título exibido no builder.
  title: { pt-BR: "Situação do pagamento", en: "Payment status" }
  base: state // REVIEW [2026-12-15] Forma de estado: valores com transições.
  // REVIEW [2026-12-15] Estado inicial e transição que o cria.
  initial: Pending with transition Created {
    // REVIEW [2026-12-15] Título da transição exibido na trilha.
    title: { pt-BR: "Cobrança registrada", en: "Charge registered" }
    // REVIEW [2026-12-15] Dados que acompanham a transição inicial.
    payload {
      // REVIEW [2026-12-15] Pedido de origem no payload.
      order: Order { title: { pt-BR: "Pedido", en: "Order" } }
      // REVIEW [2026-12-15] Valor da cobrança no payload.
      amount: std.Money { title: { pt-BR: "Valor", en: "Amount" } }
    }
  }

  // REVIEW [2026-12-15] Estado de cobrança ainda não autorizada.
  value Pending {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Pendente", en: "Pending" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Pending
    ordinal: 10 // REVIEW [2026-12-15] Ordem de exibição entre os estados.

    // REVIEW [2026-12-15] Transição para Autorizado.
    transition Authorized {
      // REVIEW [2026-12-15] Título da transição exibido na trilha.
      title: { pt-BR: "Pagamento autorizado", en: "Payment authorized" }
      // REVIEW [2026-12-15] Dados que acompanham a transição.
      payload {
        // REVIEW [2026-12-15] Valor autorizado.
        amount: std.Money { title: { pt-BR: "Valor", en: "Amount" } }
        // REVIEW [2026-12-15] Código de autorização recebido.
        authorizationCode: string { title: { pt-BR: "Autorização", en: "Authorization" } }
      }
    }

    // REVIEW [2026-12-15] Transição para Falhou.
    transition Failed {
      // REVIEW [2026-12-15] Título da transição exibido na trilha.
      title: { pt-BR: "Pagamento falhou", en: "Payment failed" }
      // REVIEW [2026-12-15] Dados que acompanham a transição.
      payload {
        // REVIEW [2026-12-15] Motivo da falha.
        failureReason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado de cobrança autorizada.
  value Authorized {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Autorizado", en: "Authorized" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Authorized
    ordinal: 20 // REVIEW [2026-12-15] Ordem de exibição entre os estados.

    // REVIEW [2026-12-15] Transição para Capturado.
    transition Captured {
      // REVIEW [2026-12-15] Título da transição exibido na trilha.
      title: { pt-BR: "Pagamento capturado", en: "Payment captured" }
      // REVIEW [2026-12-15] Dados que acompanham a transição.
      payload {
        // REVIEW [2026-12-15] Valor capturado.
        amount: std.Money { title: { pt-BR: "Valor", en: "Amount" } }
        // REVIEW [2026-12-15] Instante da captura.
        capturedAt: DateTime { title: { pt-BR: "Capturado em", en: "Captured at" } }
      }
    }

    // REVIEW [2026-12-15] Transição para Falhou.
    transition Failed {
      // REVIEW [2026-12-15] Título da transição exibido na trilha.
      title: { pt-BR: "Pagamento falhou", en: "Payment failed" }
      // REVIEW [2026-12-15] Dados que acompanham a transição.
      payload {
        // REVIEW [2026-12-15] Motivo da falha.
        failureReason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }

    // REVIEW [2026-12-15] Transição para Reembolsado, disparada pelo evento de estorno.
    transition Refunded {
      // REVIEW [2026-12-15] Nome do evento que dispara a transição.
      event: RefundIssued
      // REVIEW [2026-12-15] Título da transição exibido na trilha.
      title: { pt-BR: "Estorno emitido", en: "Refund issued" }
      // REVIEW [2026-12-15] Dados que acompanham a transição.
      payload {
        // REVIEW [2026-12-15] Valor estornado.
        amount: std.Money { title: { pt-BR: "Valor", en: "Amount" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado de cobrança capturada.
  value Captured {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Capturado", en: "Captured" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Captured
    ordinal: 30 // REVIEW [2026-12-15] Ordem de exibição entre os estados.

    // REVIEW [2026-12-15] Transição para Reembolsado, disparada pelo evento de estorno.
    transition Refunded {
      // REVIEW [2026-12-15] Nome do evento que dispara a transição.
      event: RefundIssued
      // REVIEW [2026-12-15] Título da transição exibido na trilha.
      title: { pt-BR: "Estorno emitido", en: "Refund issued" }
      // REVIEW [2026-12-15] Dados que acompanham a transição.
      payload {
        // REVIEW [2026-12-15] Valor estornado.
        amount: std.Money { title: { pt-BR: "Valor", en: "Amount" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado de cobrança que falhou.
  value Failed {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Falhou", en: "Failed" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Failed
    ordinal: 40 // REVIEW [2026-12-15] Ordem de exibição entre os estados.
  }
  // REVIEW [2026-12-15] Estado de cobrança reembolsada.
  value Refunded {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Reembolsado", en: "Refunded" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Refunded
    ordinal: 50 // REVIEW [2026-12-15] Ordem de exibição entre os estados.
  }

  format: plain // REVIEW [2026-12-15] Formato simples de exibição da situação.
}

// REVIEW [2026-12-15] Classificação das formas de pagamento aceitas.
shape PaymentMethod {
  // REVIEW [2026-12-15] Título exibido no builder.
  title: { pt-BR: "Método de pagamento", en: "Payment method" }
  base: classification // REVIEW [2026-12-15] Forma de classificação: apenas valores enumerados.

  // REVIEW [2026-12-15] Pagamento por cartão de crédito.
  value CreditCard {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Cartão de crédito", en: "Credit card" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: CreditCard
    ordinal: 10 // REVIEW [2026-12-15] Ordem de exibição entre os valores.
  }
  // REVIEW [2026-12-15] Pagamento por Pix.
  value Pix {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Pix", en: "Pix" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: Pix
    ordinal: 20 // REVIEW [2026-12-15] Ordem de exibição entre os valores.
  }
  // REVIEW [2026-12-15] Pagamento por boleto.
  value Boleto {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Boleto", en: "Boleto" }
    // REVIEW [2026-12-15] Ícone associado ao valor.
    icon: Boleto
    ordinal: 30 // REVIEW [2026-12-15] Ordem de exibição entre os valores.
  }

  format: plain // REVIEW [2026-12-15] Formato simples de exibição do método.
}
