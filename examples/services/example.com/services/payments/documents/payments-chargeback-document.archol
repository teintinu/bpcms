// REVIEW [2026-12-15] service: example.com/services/payments

// REVIEW [2026-12-15] Documento que representa uma contestação de pagamento aberta pela bandeira.
document Chargeback {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Contestação", en: "Chargeback" }
  sync: live // REVIEW [2026-12-15] Sincronização em tempo real entre instâncias.

  // REVIEW [2026-12-15] Campos que compõem a contestação.
  fields {
    // REVIEW [2026-12-15] Pagamento contestado; consultável.
    payment: Payment {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Pagamento", en: "Payment" }
      lookup // REVIEW [2026-12-15] Permite localizar a cobrança pelo pagamento contestado.
    }
    // REVIEW [2026-12-15] Valor contestado em reais; consultável.
    amount: std.Money { title: { pt-BR: "Valor", en: "Amount" }, lookup, currency: BRL }
    // REVIEW [2026-12-15] Motivo informado pela bandeira ao abrir a contestação.
    disputeReason: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Motivo da contestação", en: "Dispute reason" }
      maxLength: 500 // REVIEW [2026-12-15] Limita o motivo a quinhentos caracteres.
    }
    // REVIEW [2026-12-15] Situação atual da contestação; consultável.
    status: ChargebackStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    // REVIEW [2026-12-15] Prazo-limite para responder à bandeira; consultável.
    dueAt: DateTime { title: { pt-BR: "Prazo de resposta", en: "Response due" }, lookup }
    // REVIEW [2026-12-15] Instante em que a contestação foi aberta.
    openedAt: DateTime { title: { pt-BR: "Aberta em", en: "Opened at" } }
    // REVIEW [2026-12-15] Instante em que a contestação foi decidida.
    decidedOn: DateTime { title: { pt-BR: "Decidida em", en: "Decided on" } }
    // REVIEW [2026-12-15] Indica se a decisão da bandeira foi favorável ao lojista.
    networkFavorable: boolean {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Decisão favorável", en: "Favorable decision" }
    }
    // REVIEW [2026-12-15] Resumo textual das evidências reunidas.
    evidenceNotes: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Evidências", en: "Evidence" }
      maxLength: 2000 // REVIEW [2026-12-15] Limita as evidências a dois mil caracteres.
    }
    // REVIEW [2026-12-15] Documento comprobatório anexado.
    evidence: EvidenceDocument {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Documento de evidência", en: "Evidence document" }
    }
  }

  // REVIEW [2026-12-15] Índices de consulta do documento.
  indexes {
    // REVIEW [2026-12-15] Busca as contestações de um pagamento por hash.
    byPayment: [payment.id] hash
    // REVIEW [2026-12-15] Ordena as contestações por situação e prazo.
    byDue: [status, dueAt] range
  }


  // REVIEW [2026-12-15] Ações que alteram a contestação e disparam transições de situação.
  actions {
    // REVIEW [2026-12-15] Abre a contestação com motivo e prazo de resposta.
    open(chargebackReason: string, dueAt: DateTime) {
      // REVIEW [2026-12-15] Título exibido no botão e na trilha.
      title: { pt-BR: "Abrir contestação", en: "Open chargeback" }
      // REVIEW [2026-12-15] Papéis autorizados a abrir contestações.
      roles: [PaymentEngine]
      {
        // REVIEW [2026-12-15] Persiste o motivo informado pela bandeira.
        disputeReason = chargebackReason
        // REVIEW [2026-12-15] Carimba o instante de abertura.
        openedAt = now()
        emit Opened // REVIEW [2026-12-15] Emite o evento de contestação aberta.
      }
    }

    // REVIEW [2026-12-15] Envia as evidências de defesa à bandeira.
    submitEvidence(evidenceNote: string, evidenceFile: EvidenceDocument) {
      // REVIEW [2026-12-15] Título exibido no botão e na trilha.
      title: { pt-BR: "Enviar evidências", en: "Submit evidence" }
      // REVIEW [2026-12-15] Papéis autorizados a enviar evidências.
      roles: [Analyst]

      // REVIEW [2026-12-15] Move a situação para Em análise.
      to: status.UnderReview

      // REVIEW [2026-12-15] Regra de negócio: exige justificativa mínima nas evidências.
      rule evidenceNote.length >= 20 {
        // REVIEW [2026-12-15] Mensagem da regra em português.
        pt-BR: "Descreva as evidências com pelo menos 20 caracteres"
        // REVIEW [2026-12-15] Mensagem da regra em inglês.
        en: "Describe the evidence with at least 20 characters"
      }
      {
        // REVIEW [2026-12-15] Persiste o resumo das evidências.
        evidenceNotes = evidenceNote
        // REVIEW [2026-12-15] Anexa o documento comprobatório.
        evidence = evidenceFile
      }
    }

    // REVIEW [2026-12-15] Acrescenta uma anotação interna às evidências.
    annotateEvidence(note: string) {
      // REVIEW [2026-12-15] Título exibido no botão e na trilha.
      title: { pt-BR: "Anotar evidências", en: "Annotate evidence" }
      // REVIEW [2026-12-15] Papéis autorizados a anotar.
      roles: [Analyst]
      {
        // REVIEW [2026-12-15] Persiste a anotação no resumo de evidências.
        evidenceNotes = note
      }
    }

    // REVIEW [2026-12-15] Registra a decisão recebida da bandeira.
    registerDecision(favorable: boolean, decidedAt: DateTime) {
      // REVIEW [2026-12-15] Título exibido no botão e na trilha.
      title: { pt-BR: "Registrar decisão da bandeira", en: "Record network decision" }
      // REVIEW [2026-12-15] Papéis autorizados a registrar a decisão.
      roles: [PaymentEngine]
      {
        // REVIEW [2026-12-15] Guarda se a decisão foi favorável.
        networkFavorable = favorable
        // REVIEW [2026-12-15] Carimba o instante da decisão.
        decidedOn = decidedAt
      }
    }

    // REVIEW [2026-12-15] Marca a contestação como ganha.
    win() {
      // REVIEW [2026-12-15] Título exibido no botão e na trilha.
      title: { pt-BR: "Marcar vitória", en: "Mark as won" }
      // REVIEW [2026-12-15] Papéis autorizados a marcar vitória.
      roles: [Manager, PaymentEngine]

      // REVIEW [2026-12-15] Move a situação para Ganha.
      to: status.Won
      // REVIEW [2026-12-15] Payload do evento de vitória emitido pela transição.
      emits { decidedAt: decidedOn }
    }

    // REVIEW [2026-12-15] Marca a contestação como perdida.
    lose() {
      // REVIEW [2026-12-15] Título exibido no botão e na trilha.
      title: { pt-BR: "Marcar perda", en: "Mark as lost" }
      // REVIEW [2026-12-15] Papéis autorizados a marcar perda.
      roles: [Manager, PaymentEngine]

      // REVIEW [2026-12-15] Move a situação para Perdida.
      to: status.Lost
      // REVIEW [2026-12-15] Payload do evento de perda emitido pela transição.
      emits { decidedAt: decidedOn }
    }

    // REVIEW [2026-12-15] Aceita a contestação, encerrando-a como perdida.
    concede() {
      // REVIEW [2026-12-15] Título exibido no botão e na trilha.
      title: { pt-BR: "Aceitar a contestação", en: "Accept the chargeback" }
      // REVIEW [2026-12-15] Papéis autorizados a aceitar a contestação.
      roles: [Manager]

      // REVIEW [2026-12-15] Move a situação para Perdida.
      to: status.Lost
      // REVIEW [2026-12-15] Payload do evento de perda emitido pela transição.
      emits { decidedAt: decidedOn }
      {
        // REVIEW [2026-12-15] Carimba o instante da decisão.
        decidedOn = now()
      }
    }
  }

  // REVIEW [2026-12-15] Regra de negócio: contestação perdida exige data de decisão.
  rule status == Lost implies decidedOn != null {
    // REVIEW [2026-12-15] Mensagem da regra em português.
    pt-BR: "Informe a decisão da bandeira"
    // REVIEW [2026-12-15] Mensagem da regra em inglês.
    en: "Enter the network decision"
  }
}

// REVIEW [2026-12-15] Máquina de estados da situação da contestação.
shape ChargebackStatus {
  // REVIEW [2026-12-15] Título exibido no builder.
  title: { pt-BR: "Situação da contestação", en: "Chargeback status" }
  base: state // REVIEW [2026-12-15] Forma de estado: valores com transições.
  // REVIEW [2026-12-15] Estado inicial e transição que o cria.
  initial: Open with transition Opened {
    // REVIEW [2026-12-15] Título da transição exibido na trilha.
    title: { pt-BR: "Contestação aberta", en: "Chargeback opened" }
    // REVIEW [2026-12-15] Dados que acompanham a transição inicial.
    payload {
      // REVIEW [2026-12-15] Valor contestado no payload.
      amount: std.Money { title: { pt-BR: "Valor", en: "Amount" } }
      // REVIEW [2026-12-15] Prazo de resposta no payload.
      dueAt: DateTime { title: { pt-BR: "Prazo", en: "Due" } }
    }
  }

  // REVIEW [2026-12-15] Estado de contestação recém-aberta.
  value Open {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Aberta", en: "Open" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Open
    ordinal: 10 // REVIEW [2026-12-15] Ordem de exibição entre os estados.

    // REVIEW [2026-12-15] Transição para Em análise, disparada pelo envio de evidências.
    transition UnderReview {
      // REVIEW [2026-12-15] Nome do evento que dispara a transição.
      event: EvidenceSubmitted
      // REVIEW [2026-12-15] Título da transição exibido na trilha.
      title: { pt-BR: "Evidências enviadas", en: "Evidence submitted" }
      // REVIEW [2026-12-15] Dados que acompanham a transição.
      payload {
        // REVIEW [2026-12-15] Resumo das evidências enviadas.
        evidenceNote: string { title: { pt-BR: "Resumo", en: "Summary" } }
      }
    }

    // REVIEW [2026-12-15] Transição para Perdida.
    transition Lost {
      // REVIEW [2026-12-15] Título da transição exibido na trilha.
      title: { pt-BR: "Contestação perdida", en: "Chargeback lost" }
      // REVIEW [2026-12-15] Dados que acompanham a transição.
      payload {
        // REVIEW [2026-12-15] Instante da decisão.
        decidedAt: DateTime { title: { pt-BR: "Decidida em", en: "Decided at" } }
      }
    }

    // REVIEW [2026-12-15] Transição adicional para Perdida, quando a decisão chega antes das evidências.
    transition Lost {
      // REVIEW [2026-12-15] Título da transição exibido na trilha.
      title: { pt-BR: "Contestação perdida", en: "Chargeback lost" }
      // REVIEW [2026-12-15] Dados que acompanham a transição.
      payload {
        // REVIEW [2026-12-15] Instante da decisão.
        decidedAt: DateTime { title: { pt-BR: "Decidida em", en: "Decided at" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado de contestação em análise pela bandeira.
  value UnderReview {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Em análise", en: "Under review" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: UnderReview
    ordinal: 20 // REVIEW [2026-12-15] Ordem de exibição entre os estados.

    // REVIEW [2026-12-15] Transição para Ganha.
    transition Won {
      // REVIEW [2026-12-15] Título da transição exibido na trilha.
      title: { pt-BR: "Contestação ganha", en: "Chargeback won" }
      // REVIEW [2026-12-15] Dados que acompanham a transição.
      payload {
        // REVIEW [2026-12-15] Instante da decisão.
        decidedAt: DateTime { title: { pt-BR: "Decidida em", en: "Decided at" } }
      }
    }

    // REVIEW [2026-12-15] Transição para Perdida.
    transition Lost {
      // REVIEW [2026-12-15] Título da transição exibido na trilha.
      title: { pt-BR: "Contestação perdida", en: "Chargeback lost" }
      // REVIEW [2026-12-15] Dados que acompanham a transição.
      payload {
        // REVIEW [2026-12-15] Instante da decisão.
        decidedAt: DateTime { title: { pt-BR: "Decidida em", en: "Decided at" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado final de contestação ganha.
  value Won {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Ganha", en: "Won" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Won
    ordinal: 30 // REVIEW [2026-12-15] Ordem de exibição entre os estados.
  }
  // REVIEW [2026-12-15] Estado final de contestação perdida.
  value Lost {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Perdida", en: "Lost" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Lost
    ordinal: 40 // REVIEW [2026-12-15] Ordem de exibição entre os estados.
  }

  format: plain // REVIEW [2026-12-15] Formato simples de exibição da situação.
}

// REVIEW [2026-12-15] Forma de anexo usada como documento comprobatório.
shape EvidenceDocument {
  // REVIEW [2026-12-15] Título exibido no builder.
  title: { pt-BR: "Documento de evidência", en: "Evidence document" }
  base: attachment // REVIEW [2026-12-15] Forma de anexo de arquivo.
  // REVIEW [2026-12-15] Tipos de arquivo aceitos: PDF e imagens.
  mime: [application/pdf, image/*]
}
