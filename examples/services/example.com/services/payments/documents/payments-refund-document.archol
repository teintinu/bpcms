// REVIEW [2026-12-15] service: example.com/services/payments

// REVIEW [2026-12-15] Documento que representa um pedido de reembolso sobre um pagamento.
document Refund {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Reembolso", en: "Refund" }
  version: 2 // REVIEW [2026-12-15] Versão do artefato Document; entra no diff e no release.
  owner: "Payments" // REVIEW [2026-12-15] Área responsável pelo documento.
  sync: live // REVIEW [2026-12-15] Sincronização em tempo real entre instâncias.

  // REVIEW [2026-12-15] Campos que compõem o reembolso.
  fields {
    // REVIEW [2026-12-15] Pagamento de origem do reembolso; consultável.
    payment: Payment {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Pagamento", en: "Payment" }
      lookup // REVIEW [2026-12-15] Permite localizar o reembolso pelo pagamento.
    }
    // REVIEW [2026-12-15] Valor reembolsado em reais; consultável.
    amount: std.Money { title: { pt-BR: "Valor", en: "Amount" }, lookup, currency: BRL }
    // REVIEW [2026-12-15] Motivo declarado pelo solicitante.
    requestReason: string { title: { pt-BR: "Motivo", en: "Reason" }, maxLength: 500 }
    // REVIEW [2026-12-15] Situação atual do reembolso; consultável.
    status: RefundStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    // REVIEW [2026-12-15] Instante em que o reembolso foi solicitado.
    requestedAt: DateTime { title: { pt-BR: "Solicitado em", en: "Requested at" } }
    // REVIEW [2026-12-15] Instante em que o reembolso foi aprovado.
    approvedAt: DateTime { title: { pt-BR: "Aprovado em", en: "Approved at" } }
    // REVIEW [2026-12-15] Instante em que o reembolso foi concluído.
    completedAt: DateTime { title: { pt-BR: "Concluído em", en: "Completed at" } }
  }

  // REVIEW [2026-12-15] Índices de consulta do documento.
  indexes {
    // REVIEW [2026-12-15] Busca os reembolsos de um pagamento por hash.
    byPayment: [payment.id] hash
    // REVIEW [2026-12-15] Ordena os reembolsos por situação e data da solicitação.
    byStatus: [status, requestedAt] range
  }


  // REVIEW [2026-12-15] Ações que alteram o reembolso e disparam transições de situação.
  actions {
    // REVIEW [2026-12-15] Registra a solicitação de reembolso com um motivo.
    request(reason: string) {
      // REVIEW [2026-12-15] Título exibido no botão e na trilha.
      title: { pt-BR: "Solicitar reembolso", en: "Request refund" }
      // REVIEW [2026-12-15] Papéis autorizados a solicitar reembolso.
      roles: [Analyst]

      // REVIEW [2026-12-15] Regra de negócio: exige motivo minimamente descritivo.
      rule reason.length >= 10 {
        // REVIEW [2026-12-15] Mensagem da regra em português.
        pt-BR: "Informe um motivo com pelo menos 10 caracteres"
        // REVIEW [2026-12-15] Mensagem da regra em inglês.
        en: "Enter a reason with at least 10 characters"
      }
      {
        // REVIEW [2026-12-15] Persiste o motivo da solicitação.
        requestReason = reason
        // REVIEW [2026-12-15] Carimba o instante da solicitação.
        requestedAt = now()
        emit Requested // REVIEW [2026-12-15] Emite o evento de reembolso solicitado.
      }
    }

    // REVIEW [2026-12-15] Aprova o reembolso solicitado.
    approve() {
      // REVIEW [2026-12-15] Título exibido no botão e na trilha.
      title: { pt-BR: "Aprovar", en: "Approve" }
      // REVIEW [2026-12-15] Papéis autorizados a aprovar.
      roles: [Manager]

      // REVIEW [2026-12-15] Move a situação para Aprovado.
      to: status.Approved
      {
        // REVIEW [2026-12-15] Carimba o instante da aprovação.
        approvedAt = now()
      }
    }

    // REVIEW [2026-12-15] Conclui o reembolso aprovado.
    complete() {
      // REVIEW [2026-12-15] Título exibido no botão e na trilha.
      title: { pt-BR: "Concluir", en: "Complete" }
      // REVIEW [2026-12-15] Papéis autorizados a concluir.
      roles: [PaymentEngine]

      // REVIEW [2026-12-15] Move a situação para Concluído.
      to: status.Completed
      {
        // REVIEW [2026-12-15] Carimba o instante da conclusão.
        completedAt = now()
      }
    }

    // REVIEW [2026-12-15] Rejeita o reembolso solicitado.
    reject(reason: string) {
      // REVIEW [2026-12-15] Título exibido no botão e na trilha.
      title: { pt-BR: "Rejeitar", en: "Reject" }
      // REVIEW [2026-12-15] Papéis autorizados a rejeitar.
      roles: [Manager]

      // REVIEW [2026-12-15] Move a situação para Rejeitado.
      to: status.Rejected
    }
  }

  // REVIEW [2026-12-15] Regra de negócio: todo reembolso precisa ter valor positivo.
  rule amount > 0 {
    // REVIEW [2026-12-15] Mensagem da regra em português.
    pt-BR: "O valor deve ser maior que zero"
    // REVIEW [2026-12-15] Mensagem da regra em inglês.
    en: "Amount must be greater than zero"
  }
  // REVIEW [2026-12-15] Regra de negócio: teto de valor por reembolso.
  rule amount <= 100000 BRL {
    // REVIEW [2026-12-15] Mensagem da regra em português.
    pt-BR: "O valor excede o limite de 100.000 BRL"
    // REVIEW [2026-12-15] Mensagem da regra em inglês.
    en: "Amount exceeds the 100,000 BRL limit"
  }
}

// REVIEW [2026-12-15] Máquina de estados da situação do reembolso.
shape RefundStatus {
  // REVIEW [2026-12-15] Título exibido no builder.
  title: { pt-BR: "Situação do reembolso", en: "Refund status" }
  base: state // REVIEW [2026-12-15] Forma de estado: valores com transições.
  // REVIEW [2026-12-15] Estado inicial e transição que o cria.
  initial: Requested with transition Requested {
    // REVIEW [2026-12-15] Título da transição exibido na trilha.
    title: { pt-BR: "Reembolso solicitado", en: "Refund requested" }
    // REVIEW [2026-12-15] Dados que acompanham a transição inicial.
    payload {
      // REVIEW [2026-12-15] Valor solicitado no payload.
      amount: std.Money { title: { pt-BR: "Valor", en: "Amount" } }
      // REVIEW [2026-12-15] Motivo da solicitação no payload.
      reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
    }
  }

  // REVIEW [2026-12-15] Estado de reembolso recém-solicitado.
  value Requested {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Solicitado", en: "Requested" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Requested
    ordinal: 10 // REVIEW [2026-12-15] Ordem de exibição entre os estados.

    // REVIEW [2026-12-15] Transição para Aprovado.
    transition Approved {
      // REVIEW [2026-12-15] Título da transição exibido na trilha.
      title: { pt-BR: "Reembolso aprovado", en: "Refund approved" }
      // REVIEW [2026-12-15] Dados que acompanham a transição.
      payload {
        // REVIEW [2026-12-15] Instante da aprovação.
        approvedAt: DateTime { title: { pt-BR: "Aprovado em", en: "Approved at" } }
      }
    }

    // REVIEW [2026-12-15] Transição para Rejeitado.
    transition Rejected {
      // REVIEW [2026-12-15] Título da transição exibido na trilha.
      title: { pt-BR: "Reembolso rejeitado", en: "Refund rejected" }
      // REVIEW [2026-12-15] Dados que acompanham a transição.
      payload {
        // REVIEW [2026-12-15] Motivo da rejeição.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado de reembolso aprovado.
  value Approved {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Aprovado", en: "Approved" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Approved
    ordinal: 20 // REVIEW [2026-12-15] Ordem de exibição entre os estados.

    // REVIEW [2026-12-15] Transição para Concluído.
    transition Completed {
      // REVIEW [2026-12-15] Título da transição exibido na trilha.
      title: { pt-BR: "Reembolso concluído", en: "Refund completed" }
      // REVIEW [2026-12-15] Dados que acompanham a transição.
      payload {
        // REVIEW [2026-12-15] Instante da conclusão.
        completedAt: DateTime { title: { pt-BR: "Concluído em", en: "Completed at" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado final de reembolso concluído.
  value Completed {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Concluído", en: "Completed" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Completed
    ordinal: 30 // REVIEW [2026-12-15] Ordem de exibição entre os estados.
  }
  // REVIEW [2026-12-15] Estado final de reembolso rejeitado.
  value Rejected {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Rejeitado", en: "Rejected" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Rejected
    ordinal: 40 // REVIEW [2026-12-15] Ordem de exibição entre os estados.
  }

  format: plain // REVIEW [2026-12-15] Formato simples de exibição da situação.
}

// REVIEW [2026-12-15] Política que exige aprovação por um segundo usuário.
policy FourEyesRefund {
  // REVIEW [2026-12-15] Ação do documento à qual a política se aplica.
  appliesTo: Refund.approve
  // REVIEW [2026-12-15] Regra: quem aprova não pode ser quem criou.
  rule: approver != creator
  severity: block // REVIEW [2026-12-15] Severidade: bloqueia a ação quando violada.
  // REVIEW [2026-12-15] Mensagem exibida quando a política bloqueia.
  message: "Reembolso exige segundo aprovador"
  audit: true // REVIEW [2026-12-15] Registra a avaliação da política na auditoria.
}
