// service: example.com/services/payments

// Segredo usado para autenticar chamadas ao gateway de pagamento.
secret GatewayKey {
  // Título exibido na tela de configuração do segredo.
  title: { pt-BR: "Chave do gateway", en: "Gateway key" }
  type: string // Tipo do valor armazenado.
  required // Exige que a chave seja configurada no ambiente.
}
