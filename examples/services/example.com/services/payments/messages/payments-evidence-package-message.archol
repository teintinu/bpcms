// REVIEW [2026-12-15] service: example.com/services/payments

// REVIEW [2026-12-15] Mensagem que empacota as evidências enviadas à bandeira.
message EvidencePackage {
  // REVIEW [2026-12-15] Título exibido no builder e na trilha.
  title: { pt-BR: "Pacote de evidências", en: "Evidence package" }
  // REVIEW [2026-12-15] Documento ao qual a mensagem se refere.
  about: Chargeback

  // REVIEW [2026-12-15] Dados transportados pela mensagem.
  payload {
    // REVIEW [2026-12-15] Instante em que as evidências foram enviadas.
    submittedAt: DateTime { title: { pt-BR: "Enviado em", en: "Submitted at" } }
    // REVIEW [2026-12-15] Resumo textual das evidências.
    note: string { title: { pt-BR: "Resumo", en: "Summary" } }
    // REVIEW [2026-12-15] Documento comprobatório anexado.
    evidence: EvidenceDocument { title: { pt-BR: "Documento", en: "Document" } }
  }
}
