// REVIEW [2026-12-15] service: example.com/services/payments

// REVIEW [2026-12-15] Mensagem com o resultado da contestação devolvido pela bandeira.
message ChargebackResult {
  // REVIEW [2026-12-15] Título exibido no builder e na trilha.
  title: { pt-BR: "Resultado da contestação", en: "Chargeback result" }
  // REVIEW [2026-12-15] Documento ao qual a mensagem se refere.
  about: Chargeback

  // REVIEW [2026-12-15] Dados transportados pela mensagem.
  payload {
    // REVIEW [2026-12-15] Indica se a decisão favoreceu o lojista.
    favorable: boolean { title: { pt-BR: "Favorável", en: "Favorable" } }
    // REVIEW [2026-12-15] Instante da decisão da bandeira.
    decidedAt: DateTime { title: { pt-BR: "Decidida em", en: "Decided at" } }
  }
}
