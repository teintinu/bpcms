// REVIEW [2026-12-15] service: example.com/services/payments
// REVIEW [2026-12-15] Process: sintaxe atual (DSL_REFERENCE.md §4)

// REVIEW [2026-12-15] Declara o processo de contestação; o argumento é a contestação-sujeito da instância.
process ChargebackDispute(chargeback: Chargeback) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Contestação da bandeira", en: "Chargeback dispute" }
  version: 1 // REVIEW [2026-12-15] Versão do artefato Process; diff e release comparam.
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Responder a contestação dentro do prazo, com evidências"
  }
  sla: 20d // REVIEW [2026-12-15] SLA brando do caso: alvo de lead time, não é timer.

  // REVIEW [2026-12-15] Gatilho: inicia uma instância quando a contestação emite Opened.
  on [Chargeback.Opened]
  // REVIEW [2026-12-15] Chave de identidade, correlação e dedup da instância.
  key: chargeback

  // REVIEW [2026-12-15] Bloco que captura timeout do caso e de qualquer form.
  try {
    // REVIEW [2026-12-15] Abre o form para o analista anexar as evidências de defesa.
    ChargebackEvidence.show({ chargeback })
  } catch (Timeout) {
    // REVIEW [2026-12-15] O prazo para reunir evidências esgotou: concede a contestação.
    ChargebackConcession.show({ chargeback })
    return Lost // REVIEW [2026-12-15] Encerra o processo no desfecho de perda.
  }

  // REVIEW [2026-12-15] Se a contestação já foi perdida durante o preenchimento do form...
  if (chargeback.status == Lost) {
    // REVIEW [2026-12-15] O analista concedeu a contestação no próprio form de evidências.
    ChargebackConcession.show({ chargeback })
    return Lost // REVIEW [2026-12-15] Encerra o processo no desfecho de perda.
  }

  // REVIEW [2026-12-15] Bloco que envia o pacote de evidências e trata indisponibilidade da rede.
  try {
    // REVIEW [2026-12-15] Envia a mensagem com as evidências reunidas.
    send EvidencePackage {
      // REVIEW [2026-12-15] Correlaciona a mensagem com a contestação.
      key: chargeback
      // REVIEW [2026-12-15] Preenche o payload da mensagem.
      with {
        // REVIEW [2026-12-15] Instante do envio.
        submittedAt: now()
        // REVIEW [2026-12-15] Resumo das evidências registradas.
        note: chargeback.evidenceNotes
        // REVIEW [2026-12-15] Documento comprobatório anexado.
        evidence: chargeback.evidence
      }
    }
  } catch (NetworkUnavailable) {
    // REVIEW [2026-12-15] Rede da bandeira indisponível: cai para o envio manual.
    try {
      // REVIEW [2026-12-15] Abre a tarefa manual de envio pelo portal da bandeira.
      ManualSend.show({ chargeback })
    } catch (Timeout) {
      // REVIEW [2026-12-15] O envio manual também expirou: concede a contestação.
      ChargebackConcession.show({ chargeback })
      return Lost // REVIEW [2026-12-15] Encerra o processo no desfecho de perda.
    }
  }

  // REVIEW [2026-12-15] Bloco que aguarda o resultado da análise da bandeira.
  try {
    // REVIEW [2026-12-15] Aguarda a mensagem de resultado correlacionada à contestação.
    receive ChargebackResult {
      // REVIEW [2026-12-15] Correlaciona a resposta com a contestação.
      key: chargeback
      timeout: 30d // REVIEW [2026-12-15] Prazo máximo de espera pela resposta.
      // REVIEW [2026-12-15] Aplica a decisão recebida na ação do documento.
      apply: Chargeback.registerDecision
    }
  } catch (Timeout) {
    // REVIEW [2026-12-15] Sem resposta no prazo: concede a contestação.
    ChargebackConcession.show({ chargeback })
    return Lost // REVIEW [2026-12-15] Encerra o processo no desfecho de perda.
  }

  // REVIEW [2026-12-15] Se a bandeira decidiu a favor do lojista...
  if (chargeback.networkFavorable) {
    // REVIEW [2026-12-15] Marca a contestação como ganha.
    Chargeback.win()
    return Won // REVIEW [2026-12-15] Encerra no desfecho de sucesso.
  }

  // REVIEW [2026-12-15] Caso contrário, marca a contestação como perdida.
  Chargeback.lose()
  return Lost // REVIEW [2026-12-15] Encerra no desfecho de perda.

  // REVIEW [2026-12-15] Declara o desfecho de sucesso do caso.
  end Won {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Contestação ganha", en: "Chargeback won" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }
  // REVIEW [2026-12-15] Declara o desfecho de falha do caso.
  end Lost {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Contestação perdida", en: "Chargeback lost" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: failure
  }
}

// REVIEW [2026-12-15] Erro de negócio: indisponibilidade da rede da bandeira.
error NetworkUnavailable {
  // REVIEW [2026-12-15] Título do erro exibido ao usuário.
  title: { pt-BR: "Rede da bandeira indisponível", en: "Card network unavailable" }
}

// REVIEW [2026-12-15] Form de preenchimento das evidências de defesa.
form ChargebackEvidence {
  // REVIEW [2026-12-15] Título exibido na inbox e no histórico.
  title: { pt-BR: "Evidências da contestação", en: "Chargeback evidence" }
  // REVIEW [2026-12-15] Documento manipulado pelo form.
  document: Chargeback
  // REVIEW [2026-12-15] Papéis que podem preencher o form.
  roles: [Analyst]
  timeout: 10d // REVIEW [2026-12-15] Prazo para conclusão do preenchimento.
  priority: 90 // REVIEW [2026-12-15] Prioridade do form na fila.
  assign: pull // REVIEW [2026-12-15] Distribuição do form por retirada voluntária.

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    payment // REVIEW [2026-12-15] Pagamento contestado, somente leitura.
    amount // REVIEW [2026-12-15] Valor contestado, somente leitura.
    dueAt // REVIEW [2026-12-15] Prazo de resposta, somente leitura.
    // REVIEW [2026-12-15] Resumo textual das evidências.
    evidenceNote: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Resumo das evidências", en: "Evidence summary" }
      maxLength: 2000 // REVIEW [2026-12-15] Limita o resumo a dois mil caracteres.
      required // REVIEW [2026-12-15] Torna o resumo obrigatório.
    }
    // REVIEW [2026-12-15] Documento comprobatório anexado.
    evidenceFile: EvidenceDocument {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Documento comprobatório", en: "Supporting document" }
      required // REVIEW [2026-12-15] Torna o anexo obrigatório.
    }
    // REVIEW [2026-12-15] Anotação interna opcional.
    note: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Anotação interna", en: "Internal note" }
      maxLength: 500 // REVIEW [2026-12-15] Limita a anotação a quinhentos caracteres.
    }
  }

  // REVIEW [2026-12-15] Ações disponíveis no formulário.
  actions {
    // REVIEW [2026-12-15] Envia as evidências à bandeira.
    submit {
      // REVIEW [2026-12-15] Título exibido no botão.
      title: { pt-BR: "Enviar à bandeira", en: "Send to the network" }
      // REVIEW [2026-12-15] Chama a ação do documento que registra as evidências.
      calls: Chargeback.submitEvidence(evidenceNote, evidenceFile)
    }
    // REVIEW [2026-12-15] Aceita a contestação.
    concede {
      // REVIEW [2026-12-15] Título exibido no botão.
      title: { pt-BR: "Aceitar a contestação", en: "Accept the chargeback" }
      // REVIEW [2026-12-15] Chama a ação do documento que concede a contestação.
      calls: Chargeback.concede
    }
    // REVIEW [2026-12-15] Salva a anotação sem sair do formulário.
    annotate {
      // REVIEW [2026-12-15] Título exibido no botão.
      title: { pt-BR: "Salvar anotação", en: "Save note" }
      // REVIEW [2026-12-15] Chama a ação do documento que grava a anotação.
      calls: Chargeback.annotateEvidence(note)
      stay // REVIEW [2026-12-15] Mantém o formulário aberto após salvar.
    }
  }
}

// REVIEW [2026-12-15] Tarefa manual para enviar as evidências pelo portal da bandeira.
manual ManualSend {
  // REVIEW [2026-12-15] Título exibido na inbox e no histórico.
  title: { pt-BR: "Enviar evidências manualmente", en: "Send evidence manually" }
  // REVIEW [2026-12-15] Documento ao qual a tarefa se refere.
  document: Chargeback
  // REVIEW [2026-12-15] Papéis que podem assumir a tarefa.
  roles: [Analyst]
  // REVIEW [2026-12-15] Orientação exibida ao executor da tarefa.
  instructions: "Enviar as evidências pelo portal da bandeira"
  timeout: 4h // REVIEW [2026-12-15] Prazo para conclusão da tarefa.
  priority: 80 // REVIEW [2026-12-15] Prioridade da tarefa na fila.
  assign: pull // REVIEW [2026-12-15] Distribuição da tarefa por retirada voluntária.
}

// REVIEW [2026-12-15] Form de aceite da contestação.
form ChargebackConcession {
  // REVIEW [2026-12-15] Título exibido na inbox e no histórico.
  title: { pt-BR: "Aceitar contestação", en: "Accept chargeback" }
  // REVIEW [2026-12-15] Documento manipulado pelo form.
  document: Chargeback
  // REVIEW [2026-12-15] Papéis que podem assumir o form.
  roles: [Manager]
  timeout: 1h // REVIEW [2026-12-15] Prazo para conclusão do aceite.
  priority: 90 // REVIEW [2026-12-15] Prioridade do form na fila.
  assign: pull // REVIEW [2026-12-15] Distribuição do form por retirada voluntária.

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    payment // REVIEW [2026-12-15] Pagamento contestado, somente leitura.
    amount // REVIEW [2026-12-15] Valor contestado, somente leitura.
    dueAt // REVIEW [2026-12-15] Prazo de resposta, somente leitura.
    status // REVIEW [2026-12-15] Situação atual da contestação.
  }

  // REVIEW [2026-12-15] Ações disponíveis no formulário.
  actions {
    // REVIEW [2026-12-15] Aceita a contestação.
    accept {
      // REVIEW [2026-12-15] Título exibido no botão.
      title: { pt-BR: "Aceitar a contestação", en: "Accept the chargeback" }
      // REVIEW [2026-12-15] Chama a ação do documento que concede a contestação.
      calls: Chargeback.concede
    }
  }
}
