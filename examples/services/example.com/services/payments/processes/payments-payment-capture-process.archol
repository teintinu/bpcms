// REVIEW [2026-12-15] service: example.com/services/payments
// REVIEW [2026-12-15] Process: sintaxe atual (DSL_REFERENCE.md §4)

// REVIEW [2026-12-15] Declara o processo de captura; o argumento é o pagamento-sujeito da instância.
process PaymentCapture(payment: Payment) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Captura do pagamento", en: "Payment capture" }
  version: 1 // REVIEW [2026-12-15] Versão do artefato Process; diff e release comparam.
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Autorizar, capturar e estornar o valor quando a captura não puder ser registrada"
  }
  sla: 1d // REVIEW [2026-12-15] SLA brando do caso: alvo de lead time, não é timer.

  // REVIEW [2026-12-15] Gatilho: inicia uma instância quando o documento emite Created.
  on [Payment.Created]
  // REVIEW [2026-12-15] Chave de identidade, correlação e dedup da instância.
  key: payment

  // REVIEW [2026-12-15] Variável durável: código de autorização devolvido pelo gateway.
  let authorization: string
  // REVIEW [2026-12-15] Variável durável: comprovante devolvido na captura.
  let receipt: string

  // REVIEW [2026-12-15] Bloco que captura timeout do caso e de qualquer form.
  try {
    // REVIEW [2026-12-15] Chama o gateway e guarda o código de autorização.
    authorization = PaymentGateway.authorize({
      // REVIEW [2026-12-15] Pedido cujo valor será autorizado.
      order: payment.order,
      // REVIEW [2026-12-15] Valor a autorizar.
      amount: payment.amount
    })

    // REVIEW [2026-12-15] Registra a autorização no documento, disparando a transição.
    Payment.authorize({ authorization })
  } catch (Declined) {
    // REVIEW [2026-12-15] Autorização recusada: registra a falha no pagamento.
    Payment.fail({ failureReason: "Autorização recusada pelo adquirente" })
    return Failed // REVIEW [2026-12-15] Encerra o processo no desfecho de falha.
  }

  // REVIEW [2026-12-15] Laço de tentativas de captura, limitado a três iterações.
  loop CaptureAttempt max 3 {
    // REVIEW [2026-12-15] Bloco interno de tentativa de captura.
    try {
      // REVIEW [2026-12-15] Chama o gateway e guarda o comprovante retornado.
      receipt = PaymentGateway.capture({ payment })

      // REVIEW [2026-12-15] Registra a captura no documento, disparando a transição.
      Payment.capture({ receipt })
      return Captured // REVIEW [2026-12-15] Encerra no desfecho de sucesso.
    } catch (CaptureDeclined) {
      // REVIEW [2026-12-15] Captura recusada: tenta novamente via tarefa manual.
      try {
        // REVIEW [2026-12-15] Abre a tarefa manual para o analista repetir a captura.
        Retry.show({ payment })
      } catch (Timeout) {
        // REVIEW [2026-12-15] Compensação: nada foi capturado; registra a falha do pagamento.
        Payment.fail({ failureReason: "Autorização recusada pelo adquirente" })
        return Failed // REVIEW [2026-12-15] Encerra o processo no desfecho de falha.
      }
    } catch (ReceiptRejected) {
      // REVIEW [2026-12-15] Compensação explícita: estorna o valor e registra a falha.
      Payment.refund({ refundAmount: payment.amount })
      // REVIEW [2026-12-15] Registra a falha após o estorno.
      Payment.fail({ failureReason: "Autorização recusada pelo adquirente" })
      return Failed // REVIEW [2026-12-15] Encerra o processo no desfecho de falha.
    }
  }

  // REVIEW [2026-12-15] Esgotou as tentativas de captura: registra a falha e encerra.
  Payment.fail({ failureReason: "Autorização recusada pelo adquirente" })
  return Failed // REVIEW [2026-12-15] Retorna o desfecho de falha.

  // REVIEW [2026-12-15] Declara o desfecho de sucesso do caso.
  end Captured {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Capturado", en: "Captured" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }
  // REVIEW [2026-12-15] Declara o desfecho de falha do caso.
  end Failed {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Não capturado", en: "Not captured" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: failure
  }
}

// REVIEW [2026-12-15] Erro de negócio: autorização recusada pelo adquirente.
error Declined {
  // REVIEW [2026-12-15] Título do erro exibido ao usuário.
  title: { pt-BR: "Pagamento recusado", en: "Payment declined" }
}

// REVIEW [2026-12-15] Erro de negócio: captura recusada pelo adquirente.
error CaptureDeclined {
  // REVIEW [2026-12-15] Título do erro exibido ao usuário.
  title: { pt-BR: "Captura recusada", en: "Capture declined" }
}

// REVIEW [2026-12-15] Erro de negócio: comprovante recusado pelo adquirente.
error ReceiptRejected {
  // REVIEW [2026-12-15] Título do erro exibido ao usuário.
  title: { pt-BR: "Comprovante rejeitado", en: "Receipt rejected" }
}

// REVIEW [2026-12-15] Tarefa manual para o analista repetir a captura no portal do adquirente.
manual Retry {
  // REVIEW [2026-12-15] Título exibido na inbox e no histórico.
  title: { pt-BR: "Repetir captura", en: "Retry capture" }
  // REVIEW [2026-12-15] Documento ao qual a tarefa se refere.
  document: Payment
  // REVIEW [2026-12-15] Papéis que podem assumir a tarefa.
  roles: [Analyst]
  // REVIEW [2026-12-15] Orientação exibida ao executor da tarefa.
  instructions: "Contatar o adquirente e repetir a captura no portal"
  timeout: 8h // REVIEW [2026-12-15] Prazo para conclusão da tarefa.
  priority: 80 // REVIEW [2026-12-15] Prioridade da tarefa na fila.
  assign: pull // REVIEW [2026-12-15] Distribuição da tarefa por retirada voluntária.
}

// REVIEW [2026-12-15] Integração REST com o gateway de pagamentos.
integration PaymentGateway {
  protocol: rest // REVIEW [2026-12-15] Protocolo usado na integração.
  baseUrl: env.PAYMENT_URL // REVIEW [2026-12-15] URL base lida da variável de ambiente do gateway.
  auth: api-key // REVIEW [2026-12-15] Autenticação por chave de API.
  timeout: 15s // REVIEW [2026-12-15] Tempo máximo de cada chamada.
  idempotency: header "Idempotency-Key" // REVIEW [2026-12-15] Chave de idempotência enviada no cabeçalho.

  // REVIEW [2026-12-15] Operações expostas pela integração.
  operations {
    // REVIEW [2026-12-15] Autoriza um valor de um pedido e devolve o código de autorização.
    authorize(order: Order, amount: std.Money): string
    // REVIEW [2026-12-15] Captura um pagamento e devolve o comprovante.
    capture(payment: Payment): string
    // REVIEW [2026-12-15] Estorna o valor de um pagamento e devolve o identificador.
    refund(payment: Payment, amount: std.Money): string
  }

  // REVIEW [2026-12-15] Eventos externos que atualizam os documentos.
  webhooks {
    // REVIEW [2026-12-15] Captura confirmada atualiza o pagamento.
    payment.succeeded -> Payment.Captured
    // REVIEW [2026-12-15] Falha no pagamento atualiza o pagamento.
    payment.failed -> Payment.Failed
    // REVIEW [2026-12-15] Contestação aberta atualiza a contestação.
    chargeback.opened -> Chargeback.Opened
  }
}
