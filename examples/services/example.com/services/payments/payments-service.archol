// REVIEW [2026-12-15] Serviço de pagamentos: cobranças, estornos e contestações.
service "example.com/services/payments" {
  // REVIEW [2026-12-15] Título exibido no builder e na navegação.
  title: { pt-BR: "Pagamentos", en: "Payments" }
  version: 1.1.0 // REVIEW [2026-12-15] Versão do serviço; entra no diff e no lock.
  owner: "Payments" // REVIEW [2026-12-15] Área responsável pelo serviço.
  // REVIEW [2026-12-15] Dependências externas usadas pelos artefatos deste serviço.
  imports {
    // REVIEW [2026-12-15] Medidas e moedas padrão do construtor, referenciadas como std.*.
    service "bpcms.org/std" as std
    // REVIEW [2026-12-15] Serviço de pedidos, referenciado como Orders.*.
    service "example.com/services/orders" as Orders
  }
}
