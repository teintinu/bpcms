// Serviço de pagamentos: cobranças, estornos e contestações.
service "example.com/services/payments" {
  // Título exibido no builder e na navegação.
  title: { pt-BR: "Pagamentos", en: "Payments" }
  version: 1.1.0 // Versão do serviço; entra no diff e no lock.
  owner: "Payments" // Área responsável pelo serviço.
  // Dependências externas usadas pelos artefatos deste serviço.
  imports {
    // Medidas e moedas padrão do construtor, referenciadas como std.*.
    service "bpcms.org/std" as std
    // Serviço de pedidos, referenciado como Orders.*.
    service "example.com/services/orders" as Orders
  }
}
