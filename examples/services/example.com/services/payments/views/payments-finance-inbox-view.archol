// REVIEW [2026-12-15] service: example.com/services/payments

// REVIEW [2026-12-15] Caixa de entrada que organiza as tarefas por papel do usuário.
view FinanceInbox {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Fila do financeiro", en: "Finance queue" }
  type: inbox // REVIEW [2026-12-15] Tipo da view: caixa de entrada de trabalho.
  // REVIEW [2026-12-15] Papéis que podem abrir a fila.
  roles: [Analyst, Manager]
  scope: roles // REVIEW [2026-12-15] Escopo das tarefas: apenas dos papéis do usuário.
  // REVIEW [2026-12-15] Restringe as tarefas aos papéis do usuário atual.
  filter { role in currentUser.roles }
  groupBy: role // REVIEW [2026-12-15] Agrupa as tarefas pela coluna de papel.
  // REVIEW [2026-12-15] Colunas exibidas em cada linha da fila.
  columns { title; subject; role; dueAt; priority }
}
