// REVIEW [2026-12-15] service: example.com/services/payments

// REVIEW [2026-12-15] Painel ao vivo do risco de contestações.
view RiskPulse {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Pulso de risco", en: "Risk pulse" }
  type: dashboard // REVIEW [2026-12-15] Tipo da view: painel de indicadores.
  // REVIEW [2026-12-15] Documentos lidos para montar os indicadores.
  sources: [Chargeback, Payment]
  // REVIEW [2026-12-15] Papéis que podem abrir o painel.
  roles: [Manager]
  mode: live // REVIEW [2026-12-15] Atualização em tempo real.

  // REVIEW [2026-12-15] Filtro disponível no painel.
  filters { status }
  // REVIEW [2026-12-15] Indicadores de risco calculados sobre as fontes.
  metrics {
    // REVIEW [2026-12-15] Contestações abertas.
    openDisputes: count(Chargeback) where Chargeback.status == Open
    // REVIEW [2026-12-15] Contestações abertas com prazo de resposta vencido.
    overdue: count(Chargeback) where Chargeback.status == Open and Chargeback.dueAt < now()
    // REVIEW [2026-12-15] Contestações perdidas.
    lost: count(Chargeback) where Chargeback.status == Lost
  }
  // REVIEW [2026-12-15] Janela de atualização dos dados.
  freshness: 5m
}
