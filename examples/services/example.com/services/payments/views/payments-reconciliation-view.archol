// REVIEW [2026-12-15] service: example.com/services/payments

// REVIEW [2026-12-15] Relatório de conciliação que consolida pagamentos, estornos e contestações.
view Reconciliation {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Conciliação de pagamentos", en: "Payment reconciliation" }
  type: report // REVIEW [2026-12-15] Tipo da view: relatório analítico.
  // REVIEW [2026-12-15] Documentos lidos para montar os números.
  sources: [Payment, Refund, Chargeback]
  // REVIEW [2026-12-15] Papéis que podem abrir o relatório.
  roles: [Manager]

  // REVIEW [2026-12-15] Filtros disponíveis no topo do relatório.
  filters { period; status; method }
  // REVIEW [2026-12-15] Indicadores calculados sobre as fontes.
  metrics {
    // REVIEW [2026-12-15] Soma dos pagamentos capturados.
    captured: sum(Payment.amount) where Payment.status == Captured
    // REVIEW [2026-12-15] Soma dos reembolsos concluídos.
    refunded: sum(Refund.amount) where Refund.status == Completed
    // REVIEW [2026-12-15] Quantidade de pagamentos que falharam.
    failed: count(Payment) where Payment.status == Failed
    // REVIEW [2026-12-15] Quantidade de contestações ainda em aberto.
    disputes: count(Chargeback) where Chargeback.status != Lost
  }
  // REVIEW [2026-12-15] Unidade monetária dos indicadores.
  units { captured: BRL; refunded: BRL }
  // REVIEW [2026-12-15] Janela de atualização dos dados.
  freshness: 5m
  export: [csv, pdf] // REVIEW [2026-12-15] Formatos de exportação oferecidos.
}
