// REVIEW [2026-12-15] service: example.com/services/payments

// REVIEW [2026-12-15] Lista tabular de cobranças.
view Charges {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Cobranças", en: "Charges" }
  type: table // REVIEW [2026-12-15] Tipo da view: tabela.
  // REVIEW [2026-12-15] Documento que alimenta a tabela.
  source: Payment
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [Analyst, Manager]

  // REVIEW [2026-12-15] Colunas exibidas em cada linha.
  columns { order; amount; method; status; capturedAt }
  // REVIEW [2026-12-15] Filtros disponíveis no topo da tabela.
  filters { status; period; method }
  pagination: 50 // REVIEW [2026-12-15] Tamanho da página da tabela.

  // REVIEW [2026-12-15] Ações disponíveis sobre as linhas.
  actions {
    // REVIEW [2026-12-15] Abre o detalhe do pagamento selecionado.
    open -> PaymentDetail
    // REVIEW [2026-12-15] Cria uma cobrança chamando a ação do documento.
    charge -> Payment.create(order, amount, method)
    // REVIEW [2026-12-15] Solicita o estorno de uma cobrança.
    refund -> Payment.refund(refundAmount)
  }
}
