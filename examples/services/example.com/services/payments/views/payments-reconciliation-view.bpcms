// service: example.com/services/payments

// Relatório de conciliação que consolida pagamentos, estornos e contestações.
view Reconciliation {
  // Título exibido na navegação.
  title: { pt-BR: "Conciliação de pagamentos", en: "Payment reconciliation" }
  type: report // Tipo da view: relatório analítico.
  // Documentos lidos para montar os números.
  sources: [Payment, Refund, Chargeback]
  // Papéis que podem abrir o relatório.
  roles: [Manager]

  // Filtros disponíveis no topo do relatório.
  filters { period; status; method }
  // Indicadores calculados sobre as fontes.
  metrics {
    // Soma dos pagamentos capturados.
    captured: sum(Payment.amount) where Payment.status == Captured
    // Soma dos reembolsos concluídos.
    refunded: sum(Refund.amount) where Refund.status == Completed
    // Quantidade de pagamentos que falharam.
    failed: count(Payment) where Payment.status == Failed
    // Quantidade de contestações ainda em aberto.
    disputes: count(Chargeback) where Chargeback.status != Lost
  }
  // Unidade monetária dos indicadores.
  units { captured: BRL; refunded: BRL }
  // Janela de atualização dos dados.
  freshness: 5m
  export: [csv, pdf] // Formatos de exportação oferecidos.
}
