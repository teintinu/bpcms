// REVIEW [2026-12-15] service: example.com/services/payments

// REVIEW [2026-12-15] Tela de detalhe de uma contestação.
view ChargebackDetail {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Detalhe da contestação", en: "Chargeback detail" }
  type: detail // REVIEW [2026-12-15] Tipo da view: detalhe de documento.
  // REVIEW [2026-12-15] Documento exibido na tela.
  document: Chargeback
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [Analyst, Manager]

  // REVIEW [2026-12-15] Seções exibidas na tela de detalhe.
  sections { summary; evidence; timeline }
  // REVIEW [2026-12-15] Ações disponíveis na tela de detalhe.
  actions {
    // REVIEW [2026-12-15] Abre o andamento do processo de contestação.
    progress -> ChargebackProgress
  }
}
