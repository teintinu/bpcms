// REVIEW [2026-12-15] service: example.com/services/catalog

// REVIEW [2026-12-15] Declara o processo de publicação; o argumento é o documento-sujeito da instância.
process ProductPublish(product: Product) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Publicação de produto", en: "Product publish" }
  // REVIEW [2026-12-15] Versão do artefato Process; diff e release comparam.
  version: 1
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Revisar e publicar o produto com aprovação em quatro olhos"
  }
  // REVIEW [2026-12-15] SLA brando do caso: alvo de lead time, não é timer.
  sla: 2d

  // REVIEW [2026-12-15] Gatilho: inicia uma instância quando o produto é submetido para revisão.
  on [Product.SubmittedForReview]
  // REVIEW [2026-12-15] Chave de identidade, correlação e dedup da instância.
  key: product

  // REVIEW [2026-12-15] Abre o form de revisão para o publicador decidir.
  ProductReview.show({ product })

  // REVIEW [2026-12-15] Se a revisão publicou o produto...
  if (product.status == Published) {
    // REVIEW [2026-12-15] ...encerra no desfecho de sucesso.
    return Published
  }

  // REVIEW [2026-12-15] Caso contrário, encerra no desfecho de rejeição.
  return Rejected

  // REVIEW [2026-12-15] Declara o desfecho de sucesso do caso.
  end Published {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Publicado", en: "Published" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }

  // REVIEW [2026-12-15] Declara o desfecho de cancelamento do caso.
  end Rejected {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Rejeitado", en: "Rejected" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: cancelled
  }
}

// REVIEW [2026-12-15] Form de revisão do produto executado pelo publicador.
form ProductReview {
  // REVIEW [2026-12-15] Título exibido ao usuário na tarefa.
  title: { pt-BR: "Revisar produto", en: "Review product" }
  // REVIEW [2026-12-15] Documento editado pelo form.
  document: Product
  // REVIEW [2026-12-15] Papéis que podem executar o form.
  roles: [Publisher]
  // REVIEW [2026-12-15] Prazo máximo para conclusão do form.
  timeout: 1d
  // REVIEW [2026-12-15] Modo de atribuição: o executor puxa a tarefa da fila.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Código SKU do produto.
    sku
    // REVIEW [2026-12-15] Nome do produto.
    name
    // REVIEW [2026-12-15] Preço do produto.
    price
    // REVIEW [2026-12-15] Categoria do produto.
    category
    // REVIEW [2026-12-15] Imagem do produto.
    image
    // REVIEW [2026-12-15] Campo textual para o motivo da rejeição.
    reason: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Motivo da rejeição", en: "Rejection reason" }
      // REVIEW [2026-12-15] Limite de caracteres aceito no motivo.
      maxLength: 500
    }
  }

  // REVIEW [2026-12-15] Botões de decisão disponíveis no form.
  actions {
    // REVIEW [2026-12-15] Aprova e chama a action de publicação do documento.
    approve { calls: Product.publish }
    // REVIEW [2026-12-15] Rejeita e chama a action de rejeição passando o motivo informado.
    reject { calls: Product.reject(reason) }
  }
}
