// REVIEW [2026-12-15] service: example.com/services/catalog

// REVIEW [2026-12-15] Declara o organograma de merchandising do serviço.
organogram Merchandising {
  // REVIEW [2026-12-15] Título exibido no builder.
  title: { pt-BR: "Organograma de merchandising", en: "Merchandising organogram" }

  // REVIEW [2026-12-15] Estrutura hierárquica de subordinação entre as roles.
  hierarchy {
    // REVIEW [2026-12-15] Publisher é o superior imediato de Curator.
    Publisher > Curator
  }


  // REVIEW [2026-12-15] Regra de quatro olhos para operações sensíveis.
  fourEyes {
    // REVIEW [2026-12-15] A publicação de produto exige aprovação de um Publisher.
    product.publish requires Publisher
  }

  // REVIEW [2026-12-15] Segregação de funções entre etapas do fluxo de publicação.
  segregation {
    // REVIEW [2026-12-15] Quem submete para revisão não pode ser quem publica.
    product.submitForReview != product.publish
  }
}

// REVIEW [2026-12-15] Role de editor do catálogo.
role Curator {
  // REVIEW [2026-12-15] Título exibido na administração de papéis.
  title: { pt-BR: "Editor de catálogo", en: "Catalog editor" }
  // REVIEW [2026-12-15] Permissões de edição, envio para revisão e leitura do catálogo.
  permissions: [product.edit, product.submitForReview, catalog.view]
}

// REVIEW [2026-12-15] Role de gerente do catálogo, com poder de publicação.
role Publisher {
  // REVIEW [2026-12-15] Título exibido na administração de papéis.
  title: { pt-BR: "Gerente de catálogo", en: "Catalog manager" }
  // REVIEW [2026-12-15] Herda todas as permissões de Curator.
  inherits: Curator
  // REVIEW [2026-12-15] Permissões exclusivas de publicação, rejeição e relatórios.
  permissions: [product.publish, product.reject, report.view]
}
