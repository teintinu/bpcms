// REVIEW [2026-12-15] service: example.com/services/catalog

// REVIEW [2026-12-15] Declara o serviço Catálogo, dono dos artefatos de produtos e categorias.
service "example.com/services/catalog" {
  // REVIEW [2026-12-15] Nome exibido no builder e na navegação, por idioma.
  title: { pt-BR: "Catálogo", en: "Catalog" }
  // REVIEW [2026-12-15] Versão semântica do artefato serviço, usada em release e diff.
  version: 1.0.0
  // REVIEW [2026-12-15] Área de negócio responsável pela manutenção do serviço.
  owner: "Catalog"
  // REVIEW [2026-12-15] Dependências externas usadas por este serviço.
  imports {
    // REVIEW [2026-12-15] Importa o pseudo-serviço de medidas/constantes padrão do construtor.
    service "bpcms.org/std" as std
  }

  // REVIEW [2026-12-15] Reabre o shape std.Currency para acrescentar valores de moeda locais.
  reintroduce std.Currency {
    // REVIEW [2026-12-15] Valor de moeda Real brasileiro acrescentado ao Currency.
    value BRL {
        // REVIEW [2026-12-15] Rótulo do valor exibido na interface.
        title: { pt-BR: "Real", en: "Brazilian real" }
        // REVIEW [2026-12-15] Símbolo de prefixo da moeda por idioma.
        prefix: {
          // REVIEW [2026-12-15] Prefixo usado em português.
          pt-BR: "R$"
          // REVIEW [2026-12-15] Prefixo usado em inglês.
          en: "BRL"
        }
        // REVIEW [2026-12-15] Ícone associado à moeda no seletor.
        icon: Brl
        // REVIEW [2026-12-15] Ordem de exibição do valor na lista.
        ordinal: 10
    }
  }
}
