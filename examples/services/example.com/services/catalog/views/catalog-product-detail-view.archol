// REVIEW [2026-12-15] service: example.com/services/catalog

// REVIEW [2026-12-15] View de detalhe de um produto.
view ProductDetail {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Detalhe do produto", en: "Product detail" }
  // REVIEW [2026-12-15] Tipo da view: página de detalhe.
  type: detail
  // REVIEW [2026-12-15] Documento exibido no detalhe.
  document: Product
  // REVIEW [2026-12-15] Papéis autorizados a abrir a view.
  roles: [Curator, Publisher]

  // REVIEW [2026-12-15] Seções exibidas na página de detalhe.
  sections { summary; pricing; media }

  // REVIEW [2026-12-15] Ações disponíveis no detalhe.
  actions {
    // REVIEW [2026-12-15] Envia o produto para revisão.
    submit -> Product.submitForReview
    // REVIEW [2026-12-15] Publica o produto.
    publish -> Product.publish
    // REVIEW [2026-12-15] Arquiva o produto.
    archive -> Product.archive
  }
}
