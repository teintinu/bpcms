// REVIEW [2026-12-15] service: example.com/services/catalog

// REVIEW [2026-12-15] View kanban com produtos agrupados por situação.
view ProductKanban {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Produtos por situação", en: "Products by status" }
  // REVIEW [2026-12-15] Tipo da view: quadro kanban.
  type: kanban
  // REVIEW [2026-12-15] Documento exibido nos cartões.
  source: Product
  // REVIEW [2026-12-15] Papéis autorizados a abrir a view.
  roles: [Curator, Publisher]

  // REVIEW [2026-12-15] Campos usados para formar as colunas do quadro.
  groupBy: status
  // REVIEW [2026-12-15] Colunas exibidas nos cartões.
  columns { sku; name; price }
  // REVIEW [2026-12-15] Conteúdo resumido de cada cartão.
  card { sku; name; price; status }

  // REVIEW [2026-12-15] Ações disponíveis no quadro.
  actions {
    // REVIEW [2026-12-15] Abre o detalhe do produto do cartão.
    open -> ProductDetail
  }
}
