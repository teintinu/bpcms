// REVIEW [2026-12-15] service: example.com/services/catalog

// REVIEW [2026-12-15] Dashboard de controle do catálogo para gerentes.
view PublishingControl {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Controle do catálogo", en: "Catalog control" }
  // REVIEW [2026-12-15] Tipo da view: painel de indicadores.
  type: dashboard
  // REVIEW [2026-12-15] Documentos consultados como fonte dos indicadores.
  sources: [Product]
  // REVIEW [2026-12-15] Papéis autorizados a abrir a view.
  roles: [Publisher]
  // REVIEW [2026-12-15] Modo de atualização: em tempo real.
  mode: live

  // REVIEW [2026-12-15] Filtros disponíveis no painel.
  filters { category }

  // REVIEW [2026-12-15] Métricas calculadas sobre os produtos.
  metrics {
    // REVIEW [2026-12-15] Quantidade de produtos em revisão.
    inReview: count(Product) where status == InReview
    // REVIEW [2026-12-15] Quantidade de produtos rejeitados.
    rejected: count(Product) where status == Rejected
  }

  // REVIEW [2026-12-15] Frescor máximo aceitável dos dados antes de recálculo.
  freshness: 15m
}
