// REVIEW [2026-12-15] service: example.com/services/catalog

// REVIEW [2026-12-15] View de inbox com a fila de publicação por papel.
view PublishInbox {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Fila de publicação", en: "Publish queue" }
  // REVIEW [2026-12-15] Tipo da view: caixa de entrada de trabalho.
  type: inbox
  // REVIEW [2026-12-15] Papéis autorizados a abrir a inbox.
  roles: [Publisher]

  // REVIEW [2026-12-15] Escopo dos itens: apenas os papéis do usuário atual.
  scope: roles
  // REVIEW [2026-12-15] Filtro aplicado aos itens exibidos na lista.
  filter { role in currentUser.roles }
  // REVIEW [2026-12-15] Agrupa os itens por processo.
  groupBy: process
  // REVIEW [2026-12-15] Colunas exibidas em cada linha da fila.
  columns { title; subject; role; dueAt; priority }
}
