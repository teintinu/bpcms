// REVIEW [2026-12-15] service: example.com/services/catalog

// REVIEW [2026-12-15] View de tabela com a listagem de produtos.
view ProductTable {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Produtos", en: "Products" }
  // REVIEW [2026-12-15] Tipo da view: tabela paginada.
  type: table
  // REVIEW [2026-12-15] Documento exibido nas linhas da tabela.
  source: Product
  // REVIEW [2026-12-15] Papéis autorizados a abrir a view.
  roles: [Curator, Publisher]

  // REVIEW [2026-12-15] Colunas exibidas em cada linha.
  columns { image; sku; name; price; weight; status; createdAt }
  // REVIEW [2026-12-15] Filtros disponíveis sobre a listagem.
  filters { status; category; period }
  // REVIEW [2026-12-15] Quantidade de itens por página.
  pagination: 50

  // REVIEW [2026-12-15] Ações disponíveis na tabela.
  actions {
    // REVIEW [2026-12-15] Abre o detalhe do produto selecionado.
    open -> ProductDetail
    // REVIEW [2026-12-15] Envia o produto para revisão.
    submit -> Product.submitForReview
    // REVIEW [2026-12-15] Publica o produto.
    publish -> Product.publish
    // REVIEW [2026-12-15] Arquiva o produto.
    archive -> Product.archive
  }
}
