// REVIEW [2026-12-15] service: example.com/services/catalog

// REVIEW [2026-12-15] View de relatório com indicadores de saúde do catálogo.
view ProductHealth {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Saúde do catálogo", en: "Catalog health" }
  // REVIEW [2026-12-15] Tipo da view: relatório agregado.
  type: report
  // REVIEW [2026-12-15] Documentos consultados como fonte dos indicadores.
  sources: [Product, Category]
  // REVIEW [2026-12-15] Papéis autorizados a abrir a view.
  roles: [Publisher]

  // REVIEW [2026-12-15] Filtros disponíveis na tela do relatório.
  filters { category; status }

  // REVIEW [2026-12-15] Métricas calculadas sobre os documentos de origem.
  metrics {
    // REVIEW [2026-12-15] Quantidade de produtos publicados.
    published: count(Product) where status == Published
    // REVIEW [2026-12-15] Quantidade de produtos em rascunho.
    drafts: count(Product) where status == Draft
    // REVIEW [2026-12-15] Preço médio dos produtos.
    avgPrice: avg(Product.price)
    // REVIEW [2026-12-15] Soma dos pesos dos produtos.
    totalWeight: sum(Product.weight)
  }

  // REVIEW [2026-12-15] Unidades de medida usadas na exibição das métricas.
  units { avgPrice: BRL; totalWeight: kg }
  // REVIEW [2026-12-15] Frescor máximo aceitável dos dados antes de recálculo.
  freshness: 15m
  // REVIEW [2026-12-15] Formatos de exportação disponíveis para o relatório.
  export: [csv]
}
