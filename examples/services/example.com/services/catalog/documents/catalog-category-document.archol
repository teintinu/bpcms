// REVIEW [2026-12-15] service: example.com/services/catalog

// REVIEW [2026-12-15] Documento que representa uma categoria da árvore do catálogo.
document Category {
  // REVIEW [2026-12-15] Título exibido no builder e na interface.
  title: { pt-BR: "Categoria", en: "Category" }
  // REVIEW [2026-12-15] Versão do artefato Document; diff e release comparam.
  // REVIEW [2026-12-15] Área de negócio responsável pelo documento.
  // REVIEW [2026-12-15] Modo de sincronização: consumidores recebem apenas leitura.
  sync: read

  // REVIEW [2026-12-15] Campos persistidos da categoria.
  fields {
    // REVIEW [2026-12-15] Nome único da categoria, obrigatório, usado também em busca.
    name: string { title: { pt-BR: "Nome", en: "Name" }, maxLength: 120, required, lookup }
    // REVIEW [2026-12-15] Categoria superior na árvore de categorias.
    parent: Category {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Categoria pai", en: "Parent category" }
    }
  }

  // REVIEW [2026-12-15] Índices que sustentam unicidade e consultas.
  indexes {
    // REVIEW [2026-12-15] Garante unicidade do nome da categoria.
    name: [name] unique
    // REVIEW [2026-12-15] Índice hash para localizar filhos pela categoria pai.
    parent: [parent.id] hash
  }

  // REVIEW [2026-12-15] Dados iniciais criados no primeiro provisionamento.
  seed {
    // REVIEW [2026-12-15] Categoria raiz "Geral".
    General {
      // REVIEW [2026-12-15] Nome exibido da categoria raiz.
      name: "Geral"
    }
  }

  // REVIEW [2026-12-15] Ações de negócio sobre a categoria.
  actions {
    // REVIEW [2026-12-15] Cadastra uma categoria, opcionalmente filha de outra.
    add(name: string, parent: Category?){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Cadastrar categoria", en: "Add category" }
      // REVIEW [2026-12-15] Papéis autorizados a cadastrar categorias.
      roles: [Curator]
    }
    // REVIEW [2026-12-15] Renomeia uma categoria existente.
    rename(name: string){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Renomear", en: "Rename" }
      // REVIEW [2026-12-15] Papéis autorizados a renomear categorias.
      roles: [Curator]
    }
  }
}
