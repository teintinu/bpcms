// REVIEW [2026-12-15] service: example.com/services/catalog

// REVIEW [2026-12-15] Documento que representa o produto do catálogo.
document Product {
  // REVIEW [2026-12-15] Título exibido no builder e na interface.
  title: { pt-BR: "Produto", en: "Product" }
  // REVIEW [2026-12-15] Versão do artefato Document; diff e release comparam.
  // REVIEW [2026-12-15] Área de negócio responsável pelo documento.
  // REVIEW [2026-12-15] Modo de sincronização: atualização em tempo real entre instâncias.
  sync: live
  // REVIEW [2026-12-15] Campos persistidos do produto.
  fields {
    // REVIEW [2026-12-15] Código SKU do produto: único e pesquisável.
    sku: SKU { title: { pt-BR: "Código", en: "SKU" }, unique, lookup }
    // REVIEW [2026-12-15] Nome do produto: obrigatório, limitado e pesquisável.
    name: string { title: { pt-BR: "Nome", en: "Name" }, maxLength: 160, required, lookup }
    // REVIEW [2026-12-15] Categoria à qual o produto pertence.
    category: Category {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Categoria", en: "Category" }
    }
    // REVIEW [2026-12-15] Preço em dinheiro, com duas casas decimais e moeda BRL.
    price: std.Money { title: { pt-BR: "Preço", en: "Price" }, scale: 2, currency: BRL }
    // REVIEW [2026-12-15] Peso do produto, com unidade de massa do std.
    weight: std.Mass { title: { pt-BR: "Peso", en: "Weight" } }
    // REVIEW [2026-12-15] Comprimento do produto, com unidade de comprimento do std.
    length: std.Length { title: { pt-BR: "Comprimento", en: "Length" } }
    // REVIEW [2026-12-15] Situação do produto no ciclo de vida, indexada para busca.
    status: ProductStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    // REVIEW [2026-12-15] Imagem principal do produto.
    image: ProductImage { title: { pt-BR: "Imagem", en: "Image" } }
    // REVIEW [2026-12-15] Vídeo de apresentação do produto.
    video: ProductVideo { title: { pt-BR: "Vídeo", en: "Video" } }
    // REVIEW [2026-12-15] Áudio descritivo do produto.
    audio: ProductAudio { title: { pt-BR: "Áudio", en: "Audio" } }
    // REVIEW [2026-12-15] Manual em anexo do produto.
    manual: ProductManual { title: { pt-BR: "Manual", en: "Manual" } }
    // REVIEW [2026-12-15] Descrição rica, formatada, do produto.
    richDescription: ProductRichDescription { title: { pt-BR: "Descrição rica", en: "Rich description" } }
    // REVIEW [2026-12-15] Data e hora de criação do registro.
    createdAt: DateTime { title: { pt-BR: "Criado em", en: "Created at" } }
    // REVIEW [2026-12-15] Data e hora em que o produto foi submetido para revisão.
    submittedAt: DateTime { title: { pt-BR: "Submetido em", en: "Submitted at" } }
    // REVIEW [2026-12-15] Data e hora em que o produto foi publicado.
    publishedAt: DateTime { title: { pt-BR: "Publicado em", en: "Published at" } }
    // REVIEW [2026-12-15] Data e hora em que o produto foi arquivado.
    archivedAt: DateTime { title: { pt-BR: "Arquivado em", en: "Archived at" } }
  }

  // REVIEW [2026-12-15] Índices que sustentam unicidade, busca, filtros e ordenação.
  indexes {
    // REVIEW [2026-12-15] Garante unicidade do código SKU.
    sku: [sku] unique
    // REVIEW [2026-12-15] Índice de busca textual sobre o nome do produto.
    name: [name] search
    // REVIEW [2026-12-15] Índice por intervalo para filtrar situação e data de criação.
    byStatus: [status, createdAt] range
    // REVIEW [2026-12-15] Índice por intervalo sobre o peso normalizado.
    byWeight: [weight.normalized] range
  }


  // REVIEW [2026-12-15] Ações de negócio que alteram o ciclo de vida do produto.
  actions {
    // REVIEW [2026-12-15] Cria um novo produto com os dados mínimos.
    create(sku: SKU, name: string, price: std.Money){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Criar produto", en: "Create product" }
      // REVIEW [2026-12-15] Papéis autorizados a criar produtos.
      roles: [Curator]
    }
    // REVIEW [2026-12-15] Atualiza nome e preço de um produto existente.
    update(name: string, price: std.Money){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Atualizar", en: "Update" }
      // REVIEW [2026-12-15] Papéis autorizados a atualizar produtos.
      roles: [Curator]
    }
    // REVIEW [2026-12-15] Envia o produto para a revisão de publicação.
    submitForReview(){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Enviar para revisão", en: "Submit for review" }
      // REVIEW [2026-12-15] Papéis autorizados a enviar para revisão.
      roles: [Curator]

      // REVIEW [2026-12-15] Muda a situação do produto para Em revisão.
      to: status.InReview
      // REVIEW [2026-12-15] Emite o evento de transição com a data de submissão.
      emits { submittedAt: now() }

      // REVIEW [2026-12-15] Bloco de efeito colateral executado na transição.
      {
        // REVIEW [2026-12-15] Grava o carimbo de tempo da submissão no documento.
        submittedAt = now()
      }
    }
    // REVIEW [2026-12-15] Publica o produto no catálogo.
    publish(){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Publicar", en: "Publish" }
      // REVIEW [2026-12-15] Papéis autorizados a publicar produtos.
      roles: [Publisher]

      // REVIEW [2026-12-15] Muda a situação do produto para Publicado.
      to: status.Published
      // REVIEW [2026-12-15] Emite o evento de transição com a data de publicação.
      emits { publishedAt: now() }

      // REVIEW [2026-12-15] Bloco de efeito colateral executado na transição.
      {
        // REVIEW [2026-12-15] Grava o carimbo de tempo da publicação no documento.
        publishedAt = now()
      }
    }
    // REVIEW [2026-12-15] Rejeita o produto com um motivo obrigatório.
    reject(reason: string){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Rejeitar", en: "Reject" }
      // REVIEW [2026-12-15] Papéis autorizados a rejeitar produtos.
      roles: [Publisher]

      // REVIEW [2026-12-15] Muda a situação do produto para Rejeitado.
      to: status.Rejected

      // REVIEW [2026-12-15] Validação do motivo antes de concluir a rejeição.
      rule reason.length >= 5 {
        // REVIEW [2026-12-15] Mensagem de erro em português.
        pt-BR: "Informe o motivo da rejeição"
        // REVIEW [2026-12-15] Mensagem de erro em inglês.
        en: "Enter the rejection reason"
      }
    }
    // REVIEW [2026-12-15] Arquiva o produto, retirando-o do catálogo ativo.
    archive(){
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Arquivar", en: "Archive" }
      // REVIEW [2026-12-15] Papéis autorizados a arquivar produtos.
      roles: [Publisher]

      // REVIEW [2026-12-15] Muda a situação do produto para Arquivado.
      to: status.Archived
      // REVIEW [2026-12-15] Emite o evento de transição com a data de arquivamento.
      emits { archivedAt: now() }

      // REVIEW [2026-12-15] Bloco de efeito colateral executado na transição.
      {
        // REVIEW [2026-12-15] Grava o carimbo de tempo do arquivamento no documento.
        archivedAt = now()
      }
    }
  }

  // REVIEW [2026-12-15] Regra de integridade: o preço precisa ser positivo.
  rule price > 0 {
    // REVIEW [2026-12-15] Mensagem de erro em português.
    pt-BR: "O preço deve ser maior que zero"
    // REVIEW [2026-12-15] Mensagem de erro em inglês.
    en: "Price must be greater than zero"
  }
  // REVIEW [2026-12-15] Regra de consistência: produto publicado precisa de preço válido.
  rule status == Published implies price > 0 {
    // REVIEW [2026-12-15] Mensagem de erro em português.
    pt-BR: "Publique apenas produtos com preço"
    // REVIEW [2026-12-15] Mensagem de erro em inglês.
    en: "Publish only products with a price"
  }
}

// REVIEW [2026-12-15] Shape do código SKU, com normalização de caixa e espaços.
shape SKU {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Código", en: "SKU" }
  // REVIEW [2026-12-15] Tipo base do shape.
  base: string
  // REVIEW [2026-12-15] Normaliza o valor para maiúsculas e remove espaços nas pontas.
  normalize: upper-trim
  // REVIEW [2026-12-15] Comprimento máximo do código.
  maxLength: 40
  // REVIEW [2026-12-15] Formato de entrada e exibição, sem máscara.
  format: plain
}

// REVIEW [2026-12-15] Shape da imagem do produto.
shape ProductImage {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Imagem do produto", en: "Product image" }
  // REVIEW [2026-12-15] Tipo base do shape.
  base: image
  // REVIEW [2026-12-15] Habilita o editor de imagem na GUI.
  capabilities { gui }
}

// REVIEW [2026-12-15] Shape do vídeo do produto.
shape ProductVideo {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Vídeo do produto", en: "Product video" }
  // REVIEW [2026-12-15] Tipo base do shape.
  base: video
  // REVIEW [2026-12-15] Habilita o editor de vídeo na GUI.
  capabilities { gui }
}

// REVIEW [2026-12-15] Shape do áudio do produto.
shape ProductAudio {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Áudio do produto", en: "Product audio" }
  // REVIEW [2026-12-15] Tipo base do shape.
  base: audio
  // REVIEW [2026-12-15] Habilita o editor de áudio na GUI.
  capabilities { gui }
}

// REVIEW [2026-12-15] Shape do manual em anexo do produto.
shape ProductManual {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Manual do produto", en: "Product manual" }
  // REVIEW [2026-12-15] Tipo base do shape.
  base: attachment
  // REVIEW [2026-12-15] Tipos MIME aceitos no anexo.
  mime: [application/pdf]
  // REVIEW [2026-12-15] Habilita a gestão de anexos.
  capabilities { attachments }
}

// REVIEW [2026-12-15] Shape da descrição rica do produto.
shape ProductRichDescription {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Descrição rica", en: "Rich description" }
  // REVIEW [2026-12-15] Tipo base do shape: texto com formatação.
  base: richtext
}

// REVIEW [2026-12-15] Shape do estado do produto no ciclo de vida.
shape ProductStatus {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Situação do produto", en: "Product status" }
  // REVIEW [2026-12-15] Tipo base do shape: máquina de estados.
  base: state
  // REVIEW [2026-12-15] Valor inicial assumido por um novo produto.
  initial: Draft
  // REVIEW [2026-12-15] Valor de situação Rascunho.
  value Draft {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Rascunho", en: "Draft" }
    // REVIEW [2026-12-15] Ícone associado a esta situação.
    icon: Draft
    // REVIEW [2026-12-15] Ordem de exibição da situação.
    ordinal: 10

    // REVIEW [2026-12-15] Transição de Rascunho para Em revisão.
    transition InReview {
      // REVIEW [2026-12-15] Nome do evento emitido por esta transição.
      event: SubmittedForReview
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Produto em revisão", en: "Product submitted for review" }
      // REVIEW [2026-12-15] Dados carregados pelo evento de transição.
      payload {
        // REVIEW [2026-12-15] Data e hora da submissão.
        submittedAt: DateTime { title: { pt-BR: "Submetido em", en: "Submitted at" } }
      }
    }
  }
  // REVIEW [2026-12-15] Valor de situação Em revisão.
  value InReview {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Em revisão", en: "In review" }
    // REVIEW [2026-12-15] Ícone associado a esta situação.
    icon: InReview
    // REVIEW [2026-12-15] Ordem de exibição da situação.
    ordinal: 20

    // REVIEW [2026-12-15] Transição de Em revisão para Publicado.
    transition Published {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Produto publicado", en: "Product published" }
      // REVIEW [2026-12-15] Dados carregados pelo evento de transição.
      payload {
        // REVIEW [2026-12-15] Data e hora da publicação.
        publishedAt: DateTime { title: { pt-BR: "Publicado em", en: "Published at" } }
      }
    }

    // REVIEW [2026-12-15] Transição de Em revisão para Rejeitado.
    transition Rejected {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Produto rejeitado", en: "Product rejected" }
      // REVIEW [2026-12-15] Dados carregados pelo evento de transição.
      payload {
        // REVIEW [2026-12-15] Motivo textual da rejeição.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Valor de situação Publicado.
  value Published {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Publicado", en: "Published" }
    // REVIEW [2026-12-15] Ícone associado a esta situação.
    icon: Published
    // REVIEW [2026-12-15] Ordem de exibição da situação.
    ordinal: 30

    // REVIEW [2026-12-15] Transição de Publicado para Arquivado.
    transition Archived {
      // REVIEW [2026-12-15] Título exibido no histórico.
      title: { pt-BR: "Produto arquivado", en: "Product archived" }
      // REVIEW [2026-12-15] Dados carregados pelo evento de transição.
      payload {
        // REVIEW [2026-12-15] Data e hora do arquivamento.
        archivedAt: DateTime { title: { pt-BR: "Arquivado em", en: "Archived at" } }
      }
    }
  }
  // REVIEW [2026-12-15] Valor de situação Rejeitado, estado terminal.
  value Rejected {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Rejeitado", en: "Rejected" }
    // REVIEW [2026-12-15] Ícone associado a esta situação.
    icon: Rejected
    // REVIEW [2026-12-15] Ordem de exibição da situação.
    ordinal: 40
  }
  // REVIEW [2026-12-15] Valor de situação Arquivado, estado terminal.
  value Archived {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Arquivado", en: "Archived" }
    // REVIEW [2026-12-15] Ícone associado a esta situação.
    icon: Archived
    // REVIEW [2026-12-15] Ordem de exibição da situação.
    ordinal: 50
  }
  // REVIEW [2026-12-15] Formato de exibição do estado, sem máscara.
  format: plain
}

// REVIEW [2026-12-15] Política que bloqueia a publicação de produto inválido.
policy PublishApproval {
  // REVIEW [2026-12-15] Action do documento à qual a política se aplica.
  appliesTo: Product.publish
  // REVIEW [2026-12-15] Condição que precisa ser verdadeira para permitir a action.
  rule: price > 0 and status == InReview
  // REVIEW [2026-12-15] Severidade: bloqueia a execução da action.
  severity: block
  // REVIEW [2026-12-15] Mensagem exibida quando a política falha.
  message: "Produto precisa de preço e estar em rascunho para publicar"
  // REVIEW [2026-12-15] Registra a avaliação na trilha de auditoria.
  audit: true
}
