// REVIEW [2026-12-15] service: example.com/services/catalog

// REVIEW [2026-12-15] Parâmetro configurável que define a moeda padrão do catálogo.
parameter DefaultCurrency {
  // REVIEW [2026-12-15] Título exibido na tela de configuração.
  title: { pt-BR: "Moeda padrão", en: "Default currency" }
  // REVIEW [2026-12-15] Tipo do parâmetro: moeda declarada no std.
  type: std.Currency
  // REVIEW [2026-12-15] Valor inicial usado enquanto não houver configuração.
  default: "BRL"
}
