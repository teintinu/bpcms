// REVIEW [2026-12-15] service: example.com/services/fraud-checkout
// REVIEW [2026-12-15] Declara o serviço de finalização de compra com verificação antifraude.
service "example.com/services/fraud-checkout" {
  // REVIEW [2026-12-15] Título exibido no builder e na navegação.
  title: { pt-BR: "Finalização da compra antifraude", en: "Fraud checkout" }
  locales: [ "pt-BR", "en" ] // REVIEW [2026-12-18] Idiomas suportados pelo serviço; o primeiro é o default do I18N em forma de string.
  // REVIEW [2026-12-15] Versão do artefato de serviço.
  // REVIEW [2026-12-15] Área de negócio responsável pelo serviço.
  owner: "Risk"
  // REVIEW [2026-12-15] Serviços externos usados por este serviço.
  imports {
    // REVIEW [2026-12-15] Importa a finalização de compra com o alias Checkout.
    service "example.com/services/checkout" as Checkout
  }

  // REVIEW [2026-12-15] Reabre o shape CheckoutStatus do checkout para acrescentar valores.
  reintroduce Checkout.CheckoutStatus {
    // REVIEW [2026-12-15] Novo valor ShippingQuoted, alcançável pela transição FraudChecked.
    value ShippingQuoted {
      // REVIEW [2026-12-15] Transição que leva ao estado de risco verificado.
      transition FraudChecked {
        // REVIEW [2026-12-15] Título exibido na timeline do documento.
        title: { pt-BR: "Risco verificado", en: "Risk checked" }
      }
    }

    // REVIEW [2026-12-15] Novo estado FraudChecked, de risco verificado.
    value FraudChecked {
      // REVIEW [2026-12-15] Título exibido na timeline do documento.
      title: { pt-BR: "Risco verificado", en: "Risk checked" }
      // REVIEW [2026-12-15] Ícone do estado, definido neste serviço.
      icon: status.fraudChecked
      // REVIEW [2026-12-15] Posição do estado na ordenação do shape.
      ordinal: 25
    }

    // REVIEW [2026-12-15] Insere FraudChecked antes de PaymentAuthorized na ordem dos estados.
    insert FraudChecked before PaymentAuthorized
  }

  // REVIEW [2026-12-15] Reabre o documento CheckoutSession do checkout para acrescentar ação.
  reintroduce Checkout.CheckoutSession {
    // REVIEW [2026-12-15] Nova action de verificação de risco na sessão de checkout.
    action checkFraud() {
      // REVIEW [2026-12-15] Título exibido no botão da action.
      title: { pt-BR: "Verificar risco", en: "Check risk" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a action.
      roles: [RiskAnalyst]
      // REVIEW [2026-12-15] Estado de destino após a action.
      to: status.FraudChecked
    }
  }

  // REVIEW [2026-12-15] Composição do passo FraudCheck no processo Checkout fica adiada nesta versão
  // REVIEW [2026-12-15] (não há insert/task em processo-código; ver DSL_REFERENCE.md §4.12).
}
