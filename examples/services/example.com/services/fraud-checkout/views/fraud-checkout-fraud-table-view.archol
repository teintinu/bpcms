// REVIEW [2026-12-15] service: example.com/services/fraud-checkout

// REVIEW [2026-12-15] View de tabela que lista as verificações antifraude.
view FraudTable {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Verificações antifraude", en: "Fraud checks" }
  // REVIEW [2026-12-15] Tipo da view: tabela de documentos.
  type: table
  // REVIEW [2026-12-15] Documento consultado pela tabela.
  source: FraudCheck
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [RiskAnalyst, RiskManager]

  // REVIEW [2026-12-15] Colunas exibidas na tabela.
  columns { session; score; approved; status; evaluatedAt }
  // REVIEW [2026-12-15] Filtros disponíveis na tabela.
  filters { status; period }
  // REVIEW [2026-12-15] Quantidade de itens por página.
  pagination: 50

  // REVIEW [2026-12-15] Ações da tabela.
  actions {
    // REVIEW [2026-12-15] Abre o detalhe da verificação selecionada.
    open -> FraudDetail
  }
}
