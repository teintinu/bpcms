// REVIEW [2026-12-15] service: example.com/services/fraud-checkout

// REVIEW [2026-12-15] Declara a caixa de entrada da fila de risco.
view RiskInbox {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Fila de risco", en: "Risk queue" }
  // REVIEW [2026-12-15] Tipo da view: caixa de entrada de trabalho.
  type: inbox
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [RiskAnalyst, RiskManager]

  // REVIEW [2026-12-15] Escopo dos itens: apenas os papéis do usuário corrente.
  scope: roles
  // REVIEW [2026-12-15] Filtro aplicado à lista de itens.
  filter { role in currentUser.roles }
  // REVIEW [2026-12-15] Agrupa os itens por processo.
  groupBy: process
  // REVIEW [2026-12-15] Colunas exibidas na fila.
  columns { title; subject; role; dueAt; priority }
}
