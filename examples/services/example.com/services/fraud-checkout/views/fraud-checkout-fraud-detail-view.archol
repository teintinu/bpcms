// REVIEW [2026-12-15] service: example.com/services/fraud-checkout

// REVIEW [2026-12-15] View de detalhe de uma verificação antifraude.
view FraudDetail {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Detalhe da verificação", en: "Fraud check detail" }
  // REVIEW [2026-12-15] Tipo da view: detalhe de documento.
  type: detail
  // REVIEW [2026-12-15] Documento exibido pela view.
  document: FraudCheck
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [RiskAnalyst, RiskManager]

  // REVIEW [2026-12-15] Seções fixas exibidas no detalhe.
  sections { summary; decision; timeline }
}
