// REVIEW [2026-12-15] service: example.com/services/fraud-checkout

// REVIEW [2026-12-15] View de andamento derivada da instância do processo.
view FraudProgress {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Andamento da análise", en: "Fraud review progress" }
  // REVIEW [2026-12-15] Tipo da view: tela de andamento de processo.
  type: process
  // REVIEW [2026-12-15] Processo cujo andamento esta view exibe.
  process: FraudReview
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [RiskAnalyst, RiskManager]

  // REVIEW [2026-12-15] Seções fixas exibidas na tela de andamento.
  sections { current; participants; history; deadlines; documents; milestones; next }
}
