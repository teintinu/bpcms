// REVIEW [2026-12-15] service: example.com/services/fraud-checkout

// REVIEW [2026-12-15] Declara o organograma de risco, que estrutura os papéis da análise antifraude.
organogram Risk {
  // REVIEW [2026-12-15] Título exibido no builder e na navegação de papéis.
  title: { pt-BR: "Organograma de risco", en: "Risk organogram" }

  // REVIEW [2026-12-15] Bloco da hierarquia de papéis do organograma.
  hierarchy {
    // REVIEW [2026-12-15] Define o gerente de risco como superior do analista de risco.
    RiskManager > RiskAnalyst
  }

  // REVIEW [2026-12-15] Declara que o gerente gerencia diretamente o analista de risco.
  RiskManager manages [RiskAnalyst]
}

// REVIEW [2026-12-15] Papel do analista de risco, base da cadeia hierárquica.
role RiskAnalyst {
  // REVIEW [2026-12-15] Título exibido ao usuário.
  title: { pt-BR: "Analista de risco", en: "Risk analyst" }
  // REVIEW [2026-12-15] Permissões de revisar, aprovar e rejeitar verificações antifraude.
  permissions: [fraud.review, fraud.approve, fraud.reject]
}

// REVIEW [2026-12-15] Papel do gerente de risco, acima do analista na hierarquia.
role RiskManager {
  // REVIEW [2026-12-15] Título exibido ao usuário.
  title: { pt-BR: "Gerente de risco", en: "Risk manager" }
  // REVIEW [2026-12-15] Herda as permissões do analista de risco.
  inherits: RiskAnalyst
  // REVIEW [2026-12-15] Permissões adicionais de sobrescrever decisões e visualizar relatórios.
  permissions: [fraud.override, report.view]
}
