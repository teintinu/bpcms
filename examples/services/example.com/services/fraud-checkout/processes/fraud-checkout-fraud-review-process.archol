// REVIEW [2026-12-15] service: example.com/services/fraud-checkout

// REVIEW [2026-12-15] Declara o processo FraudReview; o documento-sujeito é o FraudCheck.
process FraudReview(fraudCheck: FraudCheck) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Análise antifraude", en: "Fraud review" }
  // REVIEW [2026-12-15] Versão do artefato Process.
  version: 1
  // REVIEW [2026-12-15] Objetivo de negócio do processo.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Avaliar o risco e decidir automaticamente ou por análise manual"
  }
  // REVIEW [2026-12-15] SLA brando do caso: alvo de lead time, não é timer.
  sla: 1d

  // REVIEW [2026-12-15] Gatilho: inicia o caso quando o documento emite Created.
  on [FraudCheck.Created]
  // REVIEW [2026-12-15] Chave de identidade e correlação da instância.
  key: fraudCheck

  // REVIEW [2026-12-15] Dispara a avaliação automática do risco no documento.
  FraudCheck.evaluate()

  // REVIEW [2026-12-15] Score alto exige análise manual de um analista de risco.
  if (fraudCheck.score >= 70) {
    // REVIEW [2026-12-15] Abre o form de revisão manual para o analista.
    RiskReview.show({ fraudCheck })

    // REVIEW [2026-12-15] Se o analista rejeitou no form, decide pela rejeição.
    if (fraudCheck.status == Rejected) {
      // REVIEW [2026-12-15] Encerra o processo no desfecho de rejeição.
      return Rejected
    }

    // REVIEW [2026-12-15] Sem rejeição, encerra o processo no desfecho de aprovação.
    return Approved
  }

  // REVIEW [2026-12-15] Score baixo: aprova a verificação automaticamente.
  FraudCheck.approve()
  // REVIEW [2026-12-15] Encerra no desfecho de liberação automática.
  return Cleared

  // REVIEW [2026-12-15] Declara o desfecho de liberação automática.
  end Cleared {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Liberada", en: "Cleared" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }

  // REVIEW [2026-12-15] Declara o desfecho de aprovação após revisão.
  end Approved {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Aprovada", en: "Approved" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }

  // REVIEW [2026-12-15] Declara o desfecho de rejeição.
  end Rejected {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Rejeitada", en: "Rejected" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: cancelled
  }
}

// REVIEW [2026-12-15] Form de revisão manual, aberto quando o score exige análise.
form RiskReview {
  // REVIEW [2026-12-15] Título exibido na inbox e no formulário.
  title: { pt-BR: "Revisar risco", en: "Review risk" }
  // REVIEW [2026-12-15] Documento-sujeito manipulado pelo form.
  document: FraudCheck
  // REVIEW [2026-12-15] Papéis que podem atender o form.
  roles: [RiskAnalyst]
  // REVIEW [2026-12-15] Prazo para o analista concluir a revisão.
  timeout: 2h
  // REVIEW [2026-12-15] Prioridade do item na fila.
  priority: 80
  // REVIEW [2026-12-15] Distribuição por puxar: o analista assume o item da fila.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Sessão de finalização correlacionada, exibida como referência.
    session
    // REVIEW [2026-12-15] Pontuação de risco calculada, exibida ao analista.
    score
    // REVIEW [2026-12-15] Motivo digitado pelo analista ao rejeitar.
    reason: string {
      // REVIEW [2026-12-15] Título exibido no campo.
      title: { pt-BR: "Motivo da rejeição", en: "Rejection reason" }
      // REVIEW [2026-12-15] Limite de caracteres aceito no campo.
      maxLength: 500
    }
  }

  // REVIEW [2026-12-15] Ações disponíveis no formulário.
  actions {
    // REVIEW [2026-12-15] Aprova a verificação chamando a action do documento.
    approve { calls: FraudCheck.approve }
    // REVIEW [2026-12-15] Rejeita a verificação repassando o motivo informado.
    reject { calls: FraudCheck.reject(reason) }
  }
}
