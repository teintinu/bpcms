// REVIEW [2026-12-15] service: example.com/services/fraud-checkout

// REVIEW [2026-12-15] Declara o documento FraudCheck, que guarda a verificação antifraude.
document FraudCheck {
  // REVIEW [2026-12-15] Título exibido no builder e nas views.
  title: { pt-BR: "Verificação antifraude", en: "Fraud check" }
  // REVIEW [2026-12-15] Versão do artefato Document.
  version: 1
  // REVIEW [2026-12-15] Área de negócio responsável pelo documento.
  owner: "Risk"
  // REVIEW [2026-12-15] Mantém a leitura do documento sempre atualizada.
  sync: live

  // REVIEW [2026-12-15] Campos persistidos no documento.
  fields {
    // REVIEW [2026-12-15] Sessão de finalização que originou a verificação.
    session: CheckoutSession {
      // REVIEW [2026-12-15] Título exibido no campo.
      title: { pt-BR: "Sessão de finalização", en: "Checkout session" }
      // REVIEW [2026-12-15] Permite consultar e exibir a sessão relacionada.
      lookup
    }
    // REVIEW [2026-12-15] Pontuação de risco calculada para a verificação.
    score: number {
      // REVIEW [2026-12-15] Título exibido no campo.
      title: { pt-BR: "Pontuação de risco", en: "Risk score" }
      // REVIEW [2026-12-15] Valor mínimo aceito para o score.
      min: 0
      // REVIEW [2026-12-15] Valor máximo aceito para o score.
      max: 100
      // REVIEW [2026-12-15] Campo indexado para busca e filtro.
      lookup
    }
    // REVIEW [2026-12-15] Indica se a verificação foi aprovada.
    approved: boolean {
      // REVIEW [2026-12-15] Título exibido no campo.
      title: { pt-BR: "Aprovado", en: "Approved" }
    }
    // REVIEW [2026-12-15] Situação atual no shape FraudCheckStatus.
    status: FraudCheckStatus {
      // REVIEW [2026-12-15] Título exibido no campo.
      title: { pt-BR: "Situação", en: "Status" }
      // REVIEW [2026-12-15] Campo indexado para busca e filtro.
      lookup
    }
    // REVIEW [2026-12-15] Motivo informado quando a verificação é rejeitada.
    rejectionReason: string { title: { pt-BR: "Motivo da rejeição", en: "Rejection reason" } }
    // REVIEW [2026-12-15] Data e hora em que a verificação foi avaliada.
    evaluatedAt: DateTime { title: { pt-BR: "Avaliada em", en: "Evaluated at" } }
    // REVIEW [2026-12-15] Data e hora em que a verificação foi revisada.
    reviewedAt: DateTime { title: { pt-BR: "Revisada em", en: "Reviewed at" } }
  }

  // REVIEW [2026-12-15] Índices para consulta eficiente.
  indexes {
    // REVIEW [2026-12-15] Índice hash pela sessão de origem.
    bySession: [session.id] hash
    // REVIEW [2026-12-15] Índice range por situação e data de avaliação.
    byStatus: [status, evaluatedAt] range
  }


  // REVIEW [2026-12-15] Ações que alteram o documento.
  actions {
    // REVIEW [2026-12-15] Cria a verificação a partir de uma sessão e de um score.
    create(session: CheckoutSession, riskScore: number){
      // REVIEW [2026-12-15] Título exibido no botão da action.
      title: { pt-BR: "Criar verificação", en: "Create check" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a action.
      roles: [RiskAnalyst]
      // REVIEW [2026-12-15] Tipo do documento devolvido pela action.
      returns: FraudCheck
      // REVIEW [2026-12-15] Corpo executado pela action.
      {
        // REVIEW [2026-12-15] Grava a pontuação recebida como score.
        score = riskScore
        // REVIEW [2026-12-15] Emite o evento Created com a sessão de origem.
        emit Created { session: session }
      }
    }

    // REVIEW [2026-12-15] Avalia o risco e transita a situação para Evaluated.
    evaluate(){
      // REVIEW [2026-12-15] Título exibido no botão da action.
      title: { pt-BR: "Avaliar risco", en: "Evaluate risk" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a action.
      roles: [RiskAnalyst]

      // REVIEW [2026-12-15] Estado de destino da transição.
      to: status.Evaluated

      // REVIEW [2026-12-15] Corpo executado pela action.
      {
        // REVIEW [2026-12-15] Registra a data e hora da avaliação.
        evaluatedAt = now()
      }
    }

    // REVIEW [2026-12-15] Aprova a verificação.
    approve(){
      // REVIEW [2026-12-15] Título exibido no botão da action.
      title: { pt-BR: "Aprovar risco", en: "Approve risk" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a action.
      roles: [RiskAnalyst]

      // REVIEW [2026-12-15] Estado de destino da transição.
      to: status.Approved
      // REVIEW [2026-12-15] Payload do evento emitido: data e hora da aprovação.
      emits { approvedAt: now() }

      // REVIEW [2026-12-15] Corpo executado pela action.
      {
        // REVIEW [2026-12-15] Marca a verificação como aprovada.
        approved = true
        // REVIEW [2026-12-15] Registra a data e hora da revisão.
        reviewedAt = now()
      }
    }

    // REVIEW [2026-12-15] Rejeita a verificação com um motivo.
    reject(reason: string){
      // REVIEW [2026-12-15] Título exibido no botão da action.
      title: { pt-BR: "Rejeitar risco", en: "Reject risk" }
      // REVIEW [2026-12-15] Papéis autorizados a executar a action.
      roles: [RiskAnalyst]

      // REVIEW [2026-12-15] Estado de destino da transição.
      to: status.Rejected

      // REVIEW [2026-12-15] Exige motivo com pelo menos cinco caracteres.
      rule reason.length >= 5 {
        // REVIEW [2026-12-15] Mensagem de validação em português.
        pt-BR: "Informe o motivo da rejeição"
        // REVIEW [2026-12-15] Mensagem de validação em inglês.
        en: "Enter the rejection reason"
      }

      // REVIEW [2026-12-15] Corpo executado pela action.
      {
        // REVIEW [2026-12-15] Desmarca a aprovação da verificação.
        approved = false
        // REVIEW [2026-12-15] Guarda o motivo informado.
        rejectionReason = reason
        // REVIEW [2026-12-15] Registra a data e hora da revisão.
        reviewedAt = now()
      }
    }
  }

  // REVIEW [2026-12-15] Invariante: o score deve permanecer entre 0 e 100.
  rule score >= 0 and score <= 100 {
    // REVIEW [2026-12-15] Mensagem de validação em português.
    pt-BR: "A pontuação deve ficar entre 0 e 100"
    // REVIEW [2026-12-15] Mensagem de validação em inglês.
    en: "Score must be between 0 and 100"
  }
}

// REVIEW [2026-12-15] Shape de estados por que passa a verificação antifraude.
shape FraudCheckStatus {
  // REVIEW [2026-12-15] Título exibido no builder.
  title: { pt-BR: "Situação da verificação antifraude", en: "Fraud check status" }
  // REVIEW [2026-12-15] Tipo base do shape: máquina de estados.
  base: state
  // REVIEW [2026-12-15] Estado inicial Pending, alcançado pela transição Created.
  initial: Pending with transition Created {
    // REVIEW [2026-12-15] Título exibido na timeline do documento.
    title: { pt-BR: "Verificação criada", en: "Fraud check created" }
    // REVIEW [2026-12-15] Dados transportados pelo evento Created.
    payload {
      // REVIEW [2026-12-15] Sessão de finalização que originou a criação.
      session: CheckoutSession { title: { pt-BR: "Sessão", en: "Session" } }
    }
  }
  // REVIEW [2026-12-15] Estado Pendente, primeiro da ordenação.
  value Pending {
    // REVIEW [2026-12-15] Título exibido na timeline do documento.
    title: { pt-BR: "Pendente", en: "Pending" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Pending
    // REVIEW [2026-12-15] Posição do estado na ordenação.
    ordinal: 10

    // REVIEW [2026-12-15] Transição para o estado Evaluated.
    transition Evaluated {
      // REVIEW [2026-12-15] Título exibido na timeline do documento.
      title: { pt-BR: "Risco avaliado", en: "Risk evaluated" }
      // REVIEW [2026-12-15] Dados transportados pelo evento.
      payload {
        // REVIEW [2026-12-15] Pontuação de risco calculada.
        score: number { title: { pt-BR: "Pontuação", en: "Score" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado Avaliada, após a avaliação automática do risco.
  value Evaluated {
    // REVIEW [2026-12-15] Título exibido na timeline do documento.
    title: { pt-BR: "Avaliada", en: "Evaluated" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Evaluated
    // REVIEW [2026-12-15] Posição do estado na ordenação.
    ordinal: 20

    // REVIEW [2026-12-15] Transição para o estado Approved.
    transition Approved {
      // REVIEW [2026-12-15] Título exibido na timeline do documento.
      title: { pt-BR: "Risco aprovado", en: "Risk approved" }
      // REVIEW [2026-12-15] Dados transportados pelo evento.
      payload {
        // REVIEW [2026-12-15] Data e hora da aprovação.
        approvedAt: DateTime { title: { pt-BR: "Aprovado em", en: "Approved at" } }
      }
    }

    // REVIEW [2026-12-15] Transição para o estado Rejected.
    transition Rejected {
      // REVIEW [2026-12-15] Título exibido na timeline do documento.
      title: { pt-BR: "Risco rejeitado", en: "Risk rejected" }
      // REVIEW [2026-12-15] Dados transportados pelo evento.
      payload {
        // REVIEW [2026-12-15] Motivo da rejeição.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado Aprovada, após decisão favorável.
  value Approved {
    // REVIEW [2026-12-15] Título exibido na timeline do documento.
    title: { pt-BR: "Aprovada", en: "Approved" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Approved
    // REVIEW [2026-12-15] Posição do estado na ordenação.
    ordinal: 30
  }
  // REVIEW [2026-12-15] Estado Rejeitada, após decisão contrária.
  value Rejected {
    // REVIEW [2026-12-15] Título exibido na timeline do documento.
    title: { pt-BR: "Rejeitada", en: "Rejected" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Rejected
    // REVIEW [2026-12-15] Posição do estado na ordenação.
    ordinal: 40
  }
  // REVIEW [2026-12-15] Formato de exibição do shape.
  format: plain
}
