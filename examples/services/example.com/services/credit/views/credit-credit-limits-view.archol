// REVIEW [2026-12-15] service: example.com/services/credit

// REVIEW [2026-12-15] View de listagem dos limites de crédito.
view CreditLimits {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Limites de crédito", en: "Credit limits" }
  // REVIEW [2026-12-15] Tipo table: listagem paginada em formato tabular.
  type: table
  // REVIEW [2026-12-15] Documento que fornece as linhas da tabela.
  source: CreditLimit
  // REVIEW [2026-12-15] Papéis autorizados a abrir a listagem.
  roles: [CreditAnalyst, CreditManager]

  // REVIEW [2026-12-15] Colunas exibidas em cada linha da tabela.
  columns { number; holder; amount; used; status; expiresAt }
  // REVIEW [2026-12-15] Filtros disponíveis na listagem.
  filters { status; holder }
  // REVIEW [2026-12-15] Tamanho da página: cinquenta registros por vez.
  pagination: 50

  // REVIEW [2026-12-15] Ações de linha disponíveis na listagem.
  actions {
    // REVIEW [2026-12-15] Abrir um limite navega para a view de detalhe.
    open -> CreditLimitDetail
  }
}
