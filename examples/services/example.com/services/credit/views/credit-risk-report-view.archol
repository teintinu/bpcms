// REVIEW [2026-12-15] service: example.com/services/credit

// REVIEW [2026-12-15] View de relatório agregado de risco de crédito.
view RiskReport {
  // REVIEW [2026-12-15] Título exibido na navegação do construtor e do painel.
  title: { pt-BR: "Relatório de risco de crédito", en: "Credit risk report" }
  // REVIEW [2026-12-15] Tipo report: visão somente leitura, agregada e exportável.
  type: report
  // REVIEW [2026-12-15] Documentos que fornecem os dados do relatório.
  sources: [CreditApplication, RiskAssessment]
  // REVIEW [2026-12-15] Papéis autorizados a abrir o relatório.
  roles: [CreditAnalyst, CreditManager]

  // REVIEW [2026-12-15] Filtros disponíveis: situação da proposta e período.
  filters { status; period }
  // REVIEW [2026-12-15] Métricas calculadas sobre os documentos de origem.
  metrics {
    // REVIEW [2026-12-15] Quantidade total de propostas de crédito.
    applications: count(CreditApplication)
    // REVIEW [2026-12-15] Quantidade de avaliações na faixa de risco alta.
    highRisk: count(RiskAssessment) where band == High
    // REVIEW [2026-12-15] Score médio das avaliações de risco.
    averageScore: avg(RiskAssessment.score)
  }
  // REVIEW [2026-12-15] Janela de atualização dos dados agregados: quinze minutos.
  freshness: 15m
  // REVIEW [2026-12-15] Formatos de exportação oferecidos: PDF e CSV.
  export: [pdf, csv]
}
