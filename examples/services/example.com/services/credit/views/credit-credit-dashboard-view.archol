// REVIEW [2026-12-15] service: example.com/services/credit

// REVIEW [2026-12-15] View de painel operacional de crédito.
view CreditDashboard {
  // REVIEW [2026-12-15] Título exibido na navegação do painel.
  title: { pt-BR: "Painel de crédito", en: "Credit dashboard" }
  // REVIEW [2026-12-15] Tipo dashboard: painel com atualização contínua.
  type: dashboard
  // REVIEW [2026-12-15] Documentos que alimentam os indicadores do painel.
  sources: [CreditApplication, CreditLimit]
  // REVIEW [2026-12-15] Papéis autorizados a abrir o painel.
  roles: [CreditAnalyst, CreditManager]
  // REVIEW [2026-12-15] Modo live: os números são atualizados em tempo real.
  mode: live

  // REVIEW [2026-12-15] Filtros disponíveis: situação da proposta e período.
  filters { status; period }
  // REVIEW [2026-12-15] Indicadores calculados sobre os documentos de origem.
  metrics {
    // REVIEW [2026-12-15] Propostas já enviadas para análise.
    submitted: count(CreditApplication) where status == Submitted
    // REVIEW [2026-12-15] Propostas aprovadas.
    approved: count(CreditApplication) where status == Approved
    // REVIEW [2026-12-15] Limites de crédito ativos.
    activeLimits: count(CreditLimit) where status == Active
    // REVIEW [2026-12-15] Valor médio dos limites de crédito.
    averageLimit: avg(CreditLimit.amount)
  }
  // REVIEW [2026-12-15] Unidade de exibição do indicador de limite médio: reais.
  units { averageLimit: BRL }
  // REVIEW [2026-12-15] Recalcula os indicadores a cada cinco minutos.
  freshness: 5m
}
