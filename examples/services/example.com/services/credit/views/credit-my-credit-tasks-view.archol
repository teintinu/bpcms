// REVIEW [2026-12-15] service: example.com/services/credit

// REVIEW [2026-12-15] View de caixa de entrada com as tarefas do usuário logado.
view MyCreditTasks {
  // REVIEW [2026-12-15] Título exibido na navegação da inbox.
  title: { pt-BR: "Minhas tarefas de crédito", en: "My credit tasks" }
  // REVIEW [2026-12-15] Tipo inbox: lista de tarefas atribuídas ao usuário.
  type: inbox
  // REVIEW [2026-12-15] Papéis que enxergam a inbox de crédito.
  roles: [CreditAnalyst, CreditManager]

  // REVIEW [2026-12-15] Escopo mine: mostra apenas as tarefas do próprio usuário.
  scope: mine
  // REVIEW [2026-12-15] Agrupa as tarefas pelo processo de origem.
  groupBy: process
  // REVIEW [2026-12-15] Colunas exibidas em cada tarefa da lista.
  columns { title; subject; role; dueAt; priority }
}
