// REVIEW [2026-12-15] service: example.com/services/credit

// REVIEW [2026-12-15] View de detalhe de uma proposta de crédito.
view CreditApplicationDetail {
  // REVIEW [2026-12-15] Título exibido na navegação e no cabeçalho da tela.
  title: { pt-BR: "Detalhe da proposta", en: "Credit application detail" }
  // REVIEW [2026-12-15] Tipo detail: tela de detalhe de um registro.
  type: detail
  // REVIEW [2026-12-15] Documento exibido pela view.
  document: CreditApplication
  // REVIEW [2026-12-15] Papéis autorizados a abrir o detalhe.
  roles: [CreditAnalyst, CreditManager]

  // REVIEW [2026-12-15] Seções fixas exibidas na tela de detalhe.
  sections { summary; timeline }
}
