// service: example.com/services/credit

// View de detalhe de uma proposta de crédito.
view CreditApplicationDetail {
  // Título exibido na navegação e no cabeçalho da tela.
  title: { pt-BR: "Detalhe da proposta", en: "Credit application detail" }
  // Tipo detail: tela de detalhe de um registro.
  type: detail
  // Documento exibido pela view.
  document: CreditApplication
  // Papéis autorizados a abrir o detalhe.
  roles: [CreditAnalyst, CreditManager]

  // Seções fixas exibidas na tela de detalhe.
  sections { summary; timeline }
}
