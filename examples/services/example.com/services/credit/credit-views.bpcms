// service: example.com/services/credit

// View de relatório agregado de risco de crédito.
view RiskReport {
  // Título exibido na navegação do construtor e do painel.
  title: { pt-BR: "Relatório de risco de crédito", en: "Credit risk report" }
  // Tipo report: visão somente leitura, agregada e exportável.
  type: report
  // Documentos que fornecem os dados do relatório.
  sources: [CreditApplication, RiskAssessment]
  // Papéis autorizados a abrir o relatório.
  roles: [CreditAnalyst, CreditManager]

  // Filtros disponíveis: situação da proposta e período.
  filters { status; period }
  // Métricas calculadas sobre os documentos de origem.
  metrics {
    // Quantidade total de propostas de crédito.
    applications: count(CreditApplication)
    // Quantidade de avaliações na faixa de risco alta.
    highRisk: count(RiskAssessment) where band == High
    // Score médio das avaliações de risco.
    averageScore: avg(RiskAssessment.score)
  }
  // Janela de atualização dos dados agregados: quinze minutos.
  freshness: 15m
  // Formatos de exportação oferecidos: PDF e CSV.
  export: [pdf, csv]
}

// View de painel operacional de crédito.
view CreditDashboard {
  // Título exibido na navegação do painel.
  title: { pt-BR: "Painel de crédito", en: "Credit dashboard" }
  // Tipo dashboard: painel com atualização contínua.
  type: dashboard
  // Documentos que alimentam os indicadores do painel.
  sources: [CreditApplication, CreditLimit]
  // Papéis autorizados a abrir o painel.
  roles: [CreditAnalyst, CreditManager]
  // Modo live: os números são atualizados em tempo real.
  mode: live

  // Filtros disponíveis: situação da proposta e período.
  filters { status; period }
  // Indicadores calculados sobre os documentos de origem.
  metrics {
    // Propostas já enviadas para análise.
    submitted: count(CreditApplication) where status == Submitted
    // Propostas aprovadas.
    approved: count(CreditApplication) where status == Approved
    // Limites de crédito ativos.
    activeLimits: count(CreditLimit) where status == Active
    // Valor médio dos limites de crédito.
    averageLimit: avg(CreditLimit.amount)
  }
  // Unidade de exibição do indicador de limite médio: reais.
  units { averageLimit: BRL }
  // Recalcula os indicadores a cada cinco minutos.
  freshness: 5m
}

// View de caixa de entrada com as tarefas do usuário logado.
view MyCreditTasks {
  // Título exibido na navegação da inbox.
  title: { pt-BR: "Minhas tarefas de crédito", en: "My credit tasks" }
  // Tipo inbox: lista de tarefas atribuídas ao usuário.
  type: inbox
  // Papéis que enxergam a inbox de crédito.
  roles: [CreditAnalyst, CreditManager]

  // Escopo mine: mostra apenas as tarefas do próprio usuário.
  scope: mine
  // Agrupa as tarefas pelo processo de origem.
  groupBy: process
  // Colunas exibidas em cada tarefa da lista.
  columns { title; subject; role; dueAt; priority }
}
