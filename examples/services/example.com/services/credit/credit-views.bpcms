// service: example.com/services/credit

view RiskReport {
  title: { pt-BR: "Relatório de risco de crédito", en: "Credit risk report" }
  type: report
  sources: [CreditApplication, RiskAssessment]
  roles: [CreditAnalyst, CreditManager]

  filters { status; period }
  metrics {
    applications: count(CreditApplication)
    highRisk: count(RiskAssessment) where band == High
    averageScore: avg(RiskAssessment.score)
  }
  freshness: 15m
  export: [pdf, csv]
}

view CreditDashboard {
  title: { pt-BR: "Painel de crédito", en: "Credit dashboard" }
  type: dashboard
  sources: [CreditApplication, CreditLimit]
  roles: [CreditAnalyst, CreditManager]
  mode: live

  filters { status; period }
  metrics {
    submitted: count(CreditApplication) where status == Submitted
    approved: count(CreditApplication) where status == Approved
    activeLimits: count(CreditLimit) where status == Active
    averageLimit: avg(CreditLimit.amount)
  }
  units { averageLimit: BRL }
  freshness: 5m
}

view MyCreditTasks {
  title: { pt-BR: "Minhas tarefas de crédito", en: "My credit tasks" }
  type: inbox
  roles: [CreditAnalyst, CreditManager]

  scope: mine
  groupBy: process
  columns { title; subject; lane; dueAt; priority }
}
