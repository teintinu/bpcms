// REVIEW [2026-12-15] service: example.com/services/credit

// REVIEW [2026-12-15] Declara o organograma que estrutura os papéis do serviço de crédito.
organogram RiskDesk {
  // REVIEW [2026-12-15] Título exibido na visualização do organograma.
  title: { pt-BR: "Organograma de crédito", en: "Credit organogram" }

  // REVIEW [2026-12-15] Define a hierarquia de subordinação entre os papéis.
  hierarchy {
    // REVIEW [2026-12-15] O gerente de crédito está acima do analista de crédito.
    CreditManager > CreditAnalyst
  }


  // REVIEW [2026-12-15] Segregação de funções: impede que a mesma pessoa execute as duas actions.
  segregation {
    // REVIEW [2026-12-15] Quem envia a proposta não pode aprová-la.
    creditApplication.submit != creditApplication.approve
  }
}

// REVIEW [2026-12-15] Papel do analista: analisa propostas e registra risco.
role CreditAnalyst {
  // REVIEW [2026-12-15] Título exibido na atribuição de tarefas e no histórico.
  title: { pt-BR: "Analista de crédito", en: "Credit analyst" }
  // REVIEW [2026-12-15] Permissões: ver, analisar e decidir sobre propostas de crédito.
  permissions: [credit.view, credit.review, credit.decide]
}

// REVIEW [2026-12-15] Papel do gerente: decide, define limites e consulta relatórios.
role CreditManager {
  // REVIEW [2026-12-15] Título exibido na atribuição de tarefas e no histórico.
  title: { pt-BR: "Gerente de crédito", en: "Credit manager" }
  // REVIEW [2026-12-15] Permissões: ver, decidir, definir limite e acessar relatórios.
  permissions: [credit.view, credit.decide, credit.limit, report.view]
}
