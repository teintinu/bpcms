// REVIEW [2026-12-15] Declara o serviço de crédito pelo caminho completo da URI no workspace.
service "example.com/services/credit" {
  // REVIEW [2026-12-15] Título exibido no catálogo e nos seletores de serviço.
  title: { pt-BR: "Crédito", en: "Credit" }
  locales: [ "pt-BR", "en" ] // REVIEW [2026-12-18] Idiomas suportados pelo serviço; o primeiro é o default do I18N em forma de string.
  // REVIEW [2026-12-15] Versão semântica do serviço; releases e diffs comparam este valor.
  // REVIEW [2026-12-15] Área de negócio responsável pela manutenção do serviço.
  owner: "Credit"
  // REVIEW [2026-12-15] Serviços externos consumidos, cada um com um alias de referência.
  imports {
    // REVIEW [2026-12-15] Importa medidas e constantes padrão do construtor sob o alias std.
    service "bpcms.org/std" as std
    // REVIEW [2026-12-15] Importa identidade de usuários sob o alias Identity (Identity.User).
    service "example.com/services/identity" as Identity
  }
}
