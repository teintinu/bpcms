// REVIEW [2026-12-15] service: example.com/services/credit

// REVIEW [2026-12-15] Documento que representa o limite de crédito concedido a um titular.
document CreditLimit {
  // REVIEW [2026-12-15] Título exibido na interface e nos relatórios.
  title: { pt-BR: "Limite de crédito", en: "Credit limit" }
  // REVIEW [2026-12-15] Versão do artefato Document; releases e diffs comparam.
  // REVIEW [2026-12-15] Área de negócio responsável pelo documento.
  owner: "Credit"
  // REVIEW [2026-12-15] Sincronização de leitura: consumidores leem sem escrever no documento.
  sync: read

  // REVIEW [2026-12-15] Campos que compõem o limite de crédito.
  fields {
    // REVIEW [2026-12-15] Número identificador legível do limite.
    number: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Número", en: "Number" }
      // REVIEW [2026-12-15] Limita o número a quarenta caracteres.
      maxLength: 40
      // REVIEW [2026-12-15] Impede dois limites com o mesmo número.
      unique
      // REVIEW [2026-12-15] Permite localizar o limite pelo número.
      lookup
    }
    // REVIEW [2026-12-15] Proposta de crédito que originou o limite.
    application: CreditApplication {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Proposta", en: "Application" }
      // REVIEW [2026-12-15] Permite localizar o limite pela proposta.
      lookup
    }
    // REVIEW [2026-12-15] Usuário titular do limite de crédito.
    holder: Identity.User {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Titular", en: "Holder" }
      // REVIEW [2026-12-15] Permite localizar o limite pelo titular.
      lookup
    }
    // REVIEW [2026-12-15] Valor total do limite concedido.
    amount: std.Money {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Limite", en: "Limit" }
      // REVIEW [2026-12-15] Moeda do valor: reais brasileiros.
      currency: BRL
      // REVIEW [2026-12-15] Torna o valor obrigatório no preenchimento.
      required
    }
    // REVIEW [2026-12-15] Valor do limite já utilizado pelo titular.
    used: std.Money {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Utilizado", en: "Used" }
      // REVIEW [2026-12-15] Moeda do valor: reais brasileiros.
      currency: BRL
    }
    // REVIEW [2026-12-15] Situação atual do limite no ciclo de vida.
    status: CreditLimitStatus {
      // REVIEW [2026-12-15] Título exibido no formulário e nos filtros.
      title: { pt-BR: "Situação", en: "Status" }
      // REVIEW [2026-12-15] Permite localizar e filtrar limites pela situação.
      lookup
    }
    // REVIEW [2026-12-15] Instante em que o limite entrou em vigor.
    activatedAt: DateTime {
      // REVIEW [2026-12-15] Título exibido no formulário e no histórico.
      title: { pt-BR: "Ativado em", en: "Activated at" }
    }
    // REVIEW [2026-12-15] Data de validade do limite concedido.
    expiresAt: Date {
      // REVIEW [2026-12-15] Título exibido no formulário e no histórico.
      title: { pt-BR: "Validade", en: "Expiry date" }
    }
    // REVIEW [2026-12-15] Instante em que o limite foi suspenso.
    suspendedAt: DateTime {
      // REVIEW [2026-12-15] Título exibido no formulário e no histórico.
      title: { pt-BR: "Suspenso em", en: "Suspended at" }
    }
    // REVIEW [2026-12-15] Motivo textual informado ao suspender o limite.
    suspendedReason: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Motivo da suspensão", en: "Suspension reason" }
      // REVIEW [2026-12-15] Limita o motivo a duzentos e oitenta caracteres.
      maxLength: 280
    }
    // REVIEW [2026-12-15] Instante em que o limite foi reativado.
    reinstatedAt: DateTime {
      // REVIEW [2026-12-15] Título exibido no formulário e no histórico.
      title: { pt-BR: "Reativado em", en: "Reinstated at" }
    }
    // REVIEW [2026-12-15] Instante em que o limite foi revogado.
    revokedAt: DateTime {
      // REVIEW [2026-12-15] Título exibido no formulário e no histórico.
      title: { pt-BR: "Revogado em", en: "Revoked at" }
    }
    // REVIEW [2026-12-15] Motivo textual informado ao revogar o limite.
    revocationReason: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Motivo da revogação", en: "Revocation reason" }
      // REVIEW [2026-12-15] Limita o motivo a duzentos e oitenta caracteres.
      maxLength: 280
    }
  }


  // REVIEW [2026-12-15] Comandos que alteram o estado do limite e disparam transições.
  actions {
    // REVIEW [2026-12-15] Define ou redefine o limite de um titular a partir de uma proposta.
    set(application: CreditApplication, holder: Identity.User, amount: std.Money) {
      // REVIEW [2026-12-15] Título do botão exibido no formulário.
      title: { pt-BR: "Definir limite", en: "Set limit" }
      // REVIEW [2026-12-15] Restringe a action ao gerente de crédito.
      roles: [CreditManager]
      // REVIEW [2026-12-15] Corpo executado na action.
      {
        // REVIEW [2026-12-15] Registra o instante de ativação do limite.
        activatedAt = now()
      }
    }

    // REVIEW [2026-12-15] Suspende temporariamente o uso do limite.
    suspend(suspendedReason: string) {
      // REVIEW [2026-12-15] Título do botão exibido no formulário.
      title: { pt-BR: "Suspender limite", en: "Suspend limit" }
      // REVIEW [2026-12-15] Restringe a action ao gerente de crédito.
      roles: [CreditManager]
      // REVIEW [2026-12-15] Transita a situação para Suspended.
      to: status.Suspended
      // REVIEW [2026-12-15] Emite o evento de suspensão com o motivo informado.
      emits { reason: suspendedReason }
      // REVIEW [2026-12-15] Corpo executado na transição.
      {
        // REVIEW [2026-12-15] Registra o instante da suspensão.
        suspendedAt = now()
      }
    }

    // REVIEW [2026-12-15] Reativa um limite suspenso.
    reinstate() {
      // REVIEW [2026-12-15] Título do botão exibido no formulário.
      title: { pt-BR: "Reativar limite", en: "Reinstate limit" }
      // REVIEW [2026-12-15] Restringe a action ao gerente de crédito.
      roles: [CreditManager]
      // REVIEW [2026-12-15] Transita a situação de volta para Active.
      to: status.Active
      // REVIEW [2026-12-15] Corpo executado na transição.
      {
        // REVIEW [2026-12-15] Registra o instante da reativação.
        reinstatedAt = now()
      }
    }

    // REVIEW [2026-12-15] Revoga definitivamente o limite concedido.
    revoke(revocationReason: string) {
      // REVIEW [2026-12-15] Título do botão exibido no formulário.
      title: { pt-BR: "Revogar limite", en: "Revoke limit" }
      // REVIEW [2026-12-15] Restringe a action ao gerente de crédito.
      roles: [CreditManager]
      // REVIEW [2026-12-15] Transita a situação para Revoked.
      to: status.Revoked
      // REVIEW [2026-12-15] Emite o evento de revogação com o motivo informado.
      emits { reason: revocationReason }
      // REVIEW [2026-12-15] Corpo executado na transição.
      {
        // REVIEW [2026-12-15] Registra o instante da revogação.
        revokedAt = now()
      }
    }
  }

  // REVIEW [2026-12-15] Índices de consulta do documento.
  indexes {
    // REVIEW [2026-12-15] Índice único pelo número do limite.
    byNumber: [number] unique
    // REVIEW [2026-12-15] Índice hash para consultar limites pela situação.
    byStatus: [status] hash
    // REVIEW [2026-12-15] Índice hash pelo id do titular.
    byHolder: [holder.id] hash
  }

  // REVIEW [2026-12-15] Invariante de negócio validada a cada gravação do limite.
  rule amount > 0 BRL {
    // REVIEW [2026-12-15] Mensagem da regra em português.
    pt-BR: "O limite precisa ser positivo"
    // REVIEW [2026-12-15] Mensagem da regra em inglês.
    en: "The limit must be positive"
  }
}

// REVIEW [2026-12-15] Forma de estado com as situações possíveis do limite de crédito.
shape CreditLimitStatus {
  // REVIEW [2026-12-15] Título exibido onde a situação é referenciada.
  title: { pt-BR: "Situação do limite de crédito", en: "Credit limit status" }
  // REVIEW [2026-12-15] Base state: os valores são estados de uma máquina de estados.
  base: state
  // REVIEW [2026-12-15] Estado inicial de todo limite criado.
  initial: Active
  // REVIEW [2026-12-15] Estado ativo: limite disponível para uso.
  value Active {
    // REVIEW [2026-12-15] Título exibido no formulário e nos filtros.
    title: { pt-BR: "Ativo", en: "Active" }
    // REVIEW [2026-12-15] Ícone associado ao estado, resolvido pelo nome Active.
    icon: Active
    // REVIEW [2026-12-15] Ordem de exibição do estado na linha do tempo.
    ordinal: 10

    // REVIEW [2026-12-15] Transição disparada pela suspensão do limite.
    transition Suspended {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Limite suspenso", en: "Credit limit suspended" }
      // REVIEW [2026-12-15] Dados transportados pelo evento de transição.
      payload {
        // REVIEW [2026-12-15] Instante da suspensão transportado no evento.
        suspendedAt: DateTime { title: { pt-BR: "Suspenso em", en: "Suspended at" } }
        // REVIEW [2026-12-15] Motivo da suspensão transportado no evento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }

    // REVIEW [2026-12-15] Transição disparada pela revogação do limite.
    transition Revoked {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Limite revogado", en: "Credit limit revoked" }
      // REVIEW [2026-12-15] Dados transportados pelo evento de transição.
      payload {
        // REVIEW [2026-12-15] Instante da revogação transportado no evento.
        revokedAt: DateTime { title: { pt-BR: "Revogado em", en: "Revoked at" } }
        // REVIEW [2026-12-15] Motivo da revogação transportado no evento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado suspenso: uso do limite temporariamente bloqueado.
  value Suspended {
    // REVIEW [2026-12-15] Título exibido no formulário e nos filtros.
    title: { pt-BR: "Suspenso", en: "Suspended" }
    // REVIEW [2026-12-15] Ícone associado ao estado, resolvido pelo nome Suspended.
    icon: Suspended
    // REVIEW [2026-12-15] Ordem de exibição do estado na linha do tempo.
    ordinal: 20

    // REVIEW [2026-12-15] Transição disparada pela reativação do limite.
    transition Active {
      // REVIEW [2026-12-15] Nome do evento que dispara a transição.
      event: Reinstated
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Limite reativado", en: "Credit limit reinstated" }
      // REVIEW [2026-12-15] Dados transportados pelo evento de transição.
      payload {
        // REVIEW [2026-12-15] Instante da reativação transportado no evento.
        reinstatedAt: DateTime { title: { pt-BR: "Reativado em", en: "Reinstated at" } }
      }
    }

    // REVIEW [2026-12-15] Transição disparada pela revogação de um limite suspenso.
    transition Revoked {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Limite revogado", en: "Credit limit revoked" }
      // REVIEW [2026-12-15] Dados transportados pelo evento de transição.
      payload {
        // REVIEW [2026-12-15] Instante da revogação transportado no evento.
        revokedAt: DateTime { title: { pt-BR: "Revogado em", en: "Revoked at" } }
        // REVIEW [2026-12-15] Motivo da revogação transportado no evento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado final de limite revogado.
  value Revoked {
    // REVIEW [2026-12-15] Título exibido no formulário e nos filtros.
    title: { pt-BR: "Revogado", en: "Revoked" }
    // REVIEW [2026-12-15] Ícone associado ao estado, resolvido pelo nome Revoked.
    icon: Revoked
    // REVIEW [2026-12-15] Ordem de exibição do estado na linha do tempo.
    ordinal: 30
  }
}
