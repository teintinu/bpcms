// REVIEW [2026-12-15] service: example.com/services/credit

// REVIEW [2026-12-15] Documento computado que materializa o resultado da avaliação de risco.
document RiskAssessment {
  // REVIEW [2026-12-15] Título exibido na interface e nos relatórios.
  title: { pt-BR: "Avaliação de risco", en: "Risk assessment" }
  // REVIEW [2026-12-15] Versão do artefato Document; releases e diffs comparam.
  // REVIEW [2026-12-15] Área de negócio responsável pelo documento.
  owner: "Credit"
  // REVIEW [2026-12-15] Deriva os dados da proposta; não é editado manualmente.
  computed from CreditApplication
  // REVIEW [2026-12-15] Recalcula a avaliação no máximo a cada dez minutos.
  freshness: 10m
  // REVIEW [2026-12-15] Campos expostos como leitura para outros artefatos.
  exposes: [score, band, calculatedAt]

  // REVIEW [2026-12-15] Campos que compõem a avaliação de risco.
  fields {
    // REVIEW [2026-12-15] Proposta de crédito que originou a avaliação.
    application: CreditApplication {
      // REVIEW [2026-12-15] Título exibido no formulário e nas consultas.
      title: { pt-BR: "Proposta", en: "Application" }
      // REVIEW [2026-12-15] Permite localizar avaliações pela proposta.
      lookup
    }
    // REVIEW [2026-12-15] Score de risco apurado para a proposta.
    score: std.Count {
      // REVIEW [2026-12-15] Título exibido no formulário e nas consultas.
      title: { pt-BR: "Score", en: "Score" }
    }
    // REVIEW [2026-12-15] Faixa de risco correspondente ao score.
    band: RiskBand {
      // REVIEW [2026-12-15] Título exibido no formulário e nas consultas.
      title: { pt-BR: "Faixa", en: "Band" }
    }
  }

  // REVIEW [2026-12-15] Índices de consulta do documento.
  indexes {
    // REVIEW [2026-12-15] Índice hash para localizar a avaliação pela proposta.
    byApplication: [application.id] hash
  }
}
