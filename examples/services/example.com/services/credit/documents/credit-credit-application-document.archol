// REVIEW [2026-12-15] service: example.com/services/credit

// REVIEW [2026-12-15] Documento que representa a proposta de crédito de um proponente.
document CreditApplication {
  // REVIEW [2026-12-15] Título exibido na interface e nos relatórios.
  title: { pt-BR: "Proposta de crédito", en: "Credit application" }
  // REVIEW [2026-12-15] Versão do artefato Document; releases e diffs comparam.
  // REVIEW [2026-12-15] Área de negócio responsável pelo documento.
  // REVIEW [2026-12-15] Sincronização de leitura: consumidores leem sem escrever no documento.
  sync: read

  // REVIEW [2026-12-15] Campos que compõem a proposta de crédito.
  fields {
    // REVIEW [2026-12-15] Número identificador legível da proposta.
    number: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Número", en: "Number" }
      // REVIEW [2026-12-15] Limita o número a quarenta caracteres.
      maxLength: 40
      // REVIEW [2026-12-15] Impede duas propostas com o mesmo número.
      unique
      // REVIEW [2026-12-15] Permite localizar a proposta pelo número.
      lookup
    }
    // REVIEW [2026-12-15] Proponente que solicita o crédito; referência a um usuário.
    applicant: Identity.User {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Proponente", en: "Applicant" }
      // REVIEW [2026-12-15] Permite localizar a proposta pelo proponente.
      lookup
    }
    // REVIEW [2026-12-15] Valor de crédito solicitado, em medida monetária padrão.
    requestedAmount: std.Money {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Valor solicitado", en: "Requested amount" }
      // REVIEW [2026-12-15] Moeda do valor: reais brasileiros.
      currency: BRL
      // REVIEW [2026-12-15] Torna o valor obrigatório no preenchimento.
      required
    }
    // REVIEW [2026-12-15] Renda mensal declarada pelo proponente.
    monthlyIncome: std.Money {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Renda mensal", en: "Monthly income" }
      // REVIEW [2026-12-15] Moeda do valor: reais brasileiros.
      currency: BRL
    }
    // REVIEW [2026-12-15] Exposição de crédito que o proponente já possui.
    existingExposure: std.Money {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Exposição atual", en: "Existing exposure" }
      // REVIEW [2026-12-15] Moeda do valor: reais brasileiros.
      currency: BRL
    }
    // REVIEW [2026-12-15] Finalidade declarada para o crédito solicitado.
    purpose: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Finalidade", en: "Purpose" }
      // REVIEW [2026-12-15] Limita o texto a duzentos e quarenta caracteres.
      maxLength: 240
    }
    // REVIEW [2026-12-15] Situação da proposta dentro do fluxo de análise.
    status: CreditApplicationStatus {
      // REVIEW [2026-12-15] Título exibido no formulário e nos filtros.
      title: { pt-BR: "Situação", en: "Status" }
      // REVIEW [2026-12-15] Permite localizar e filtrar propostas pela situação.
      lookup
    }
    // REVIEW [2026-12-15] Score de risco devolvido pelo bureau de crédito.
    bureauScore: std.Count {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Score do bureau", en: "Bureau score" }
    }
    // REVIEW [2026-12-15] Faixa de risco calculada a partir do score.
    riskBand: RiskBand {
      // REVIEW [2026-12-15] Título exibido no formulário e nos filtros.
      title: { pt-BR: "Faixa de risco", en: "Risk band" }
      // REVIEW [2026-12-15] Permite filtrar propostas pela faixa de risco.
      lookup
    }
    // REVIEW [2026-12-15] Limite de crédito aprovado ao final da análise.
    approvedLimit: std.Money {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Limite aprovado", en: "Approved limit" }
      // REVIEW [2026-12-15] Moeda do valor: reais brasileiros.
      currency: BRL
    }
    // REVIEW [2026-12-15] Instante em que a proposta foi enviada para análise.
    submittedAt: DateTime {
      // REVIEW [2026-12-15] Título exibido no formulário e no histórico.
      title: { pt-BR: "Enviada em", en: "Submitted at" }
    }
    // REVIEW [2026-12-15] Instante em que a análise da proposta foi iniciada.
    reviewStartedAt: DateTime {
      // REVIEW [2026-12-15] Título exibido no formulário e no histórico.
      title: { pt-BR: "Análise iniciada em", en: "Review started at" }
    }
    // REVIEW [2026-12-15] Instante em que a proposta foi aprovada.
    approvedAt: DateTime {
      // REVIEW [2026-12-15] Título exibido no formulário e no histórico.
      title: { pt-BR: "Aprovada em", en: "Approved at" }
    }
    // REVIEW [2026-12-15] Instante em que a proposta foi rejeitada.
    rejectedAt: DateTime {
      // REVIEW [2026-12-15] Título exibido no formulário e no histórico.
      title: { pt-BR: "Rejeitada em", en: "Rejected at" }
    }
    // REVIEW [2026-12-15] Motivo textual informado ao rejeitar a proposta.
    rejectionReason: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Motivo da rejeição", en: "Rejection reason" }
      // REVIEW [2026-12-15] Limita o motivo a duzentos e oitenta caracteres.
      maxLength: 280
    }
    // REVIEW [2026-12-15] Analista responsável pela análise da proposta.
    analyst: Identity.User {
      // REVIEW [2026-12-15] Título exibido no formulário e no histórico.
      title: { pt-BR: "Analista", en: "Analyst" }
    }
  }


  // REVIEW [2026-12-15] Comandos que alteram o estado da proposta e disparam transições.
  actions {
    // REVIEW [2026-12-15] Envia a proposta: qualquer interessado pode iniciar o fluxo.
    submit() {
      // REVIEW [2026-12-15] Título do botão exibido no formulário.
      title: { pt-BR: "Enviar proposta", en: "Submit application" }
      // REVIEW [2026-12-15] Acesso público: não exige papel autenticado.
      roles: public
      // REVIEW [2026-12-15] Transita a situação para Submitted.
      to: status.Submitted
      // REVIEW [2026-12-15] Corpo executado na transição.
      {
        // REVIEW [2026-12-15] Registra o instante do envio.
        submittedAt = now()
      }
    }

    // REVIEW [2026-12-15] Inicia a análise manual da proposta.
    startReview() {
      // REVIEW [2026-12-15] Título do botão exibido no formulário.
      title: { pt-BR: "Iniciar análise", en: "Start review" }
      // REVIEW [2026-12-15] Restringe a action ao analista de crédito.
      roles: [CreditAnalyst]
      // REVIEW [2026-12-15] Transita a situação para UnderReview.
      to: status.UnderReview
      // REVIEW [2026-12-15] Corpo executado na transição.
      {
        // REVIEW [2026-12-15] Registra o instante de início da análise.
        reviewStartedAt = now()
      }
    }

    // REVIEW [2026-12-15] Registra o score e a faixa de risco apurados pelo bureau.
    recordRisk(bureauScore: std.Count, riskBand: RiskBand) {
      // REVIEW [2026-12-15] Título do botão exibido no formulário.
      title: { pt-BR: "Registrar risco", en: "Record risk" }
      // REVIEW [2026-12-15] Restringe a action ao analista de crédito.
      roles: [CreditAnalyst]
    }

    // REVIEW [2026-12-15] Aprova a proposta com o limite concedido.
    approve(approvedLimit: std.Money) {
      // REVIEW [2026-12-15] Título do botão exibido no formulário.
      title: { pt-BR: "Aprovar crédito", en: "Approve credit" }
      // REVIEW [2026-12-15] Permite a aprovação ao analista e ao gerente.
      roles: [CreditAnalyst, CreditManager]
      // REVIEW [2026-12-15] Transita a situação para Approved.
      to: status.Approved
      // REVIEW [2026-12-15] Corpo executado na transição.
      {
        // REVIEW [2026-12-15] Registra o instante da aprovação.
        approvedAt = now()
      }
    }

    // REVIEW [2026-12-15] Rejeita a proposta informando o motivo.
    reject(rejectionReason: string) {
      // REVIEW [2026-12-15] Título do botão exibido no formulário.
      title: { pt-BR: "Rejeitar crédito", en: "Reject credit" }
      // REVIEW [2026-12-15] Permite a rejeição ao analista e ao gerente.
      roles: [CreditAnalyst, CreditManager]
      // REVIEW [2026-12-15] Transita a situação para Rejected.
      to: status.Rejected
      // REVIEW [2026-12-15] Emite o evento de rejeição com o motivo informado.
      emits { reason: rejectionReason }
      // REVIEW [2026-12-15] Corpo executado na transição.
      {
        // REVIEW [2026-12-15] Registra o instante da rejeição.
        rejectedAt = now()
      }
    }
  }

  // REVIEW [2026-12-15] Índices de consulta do documento.
  indexes {
    // REVIEW [2026-12-15] Índice único pelo número da proposta.
    byNumber: [number] unique
    // REVIEW [2026-12-15] Índice de faixa para consultar por situação e data de envio.
    byStatus: [status, submittedAt] range
    // REVIEW [2026-12-15] Índice hash pelo id do proponente.
    byApplicant: [applicant.id] hash
  }

  // REVIEW [2026-12-15] Invariante de negócio validada a cada gravação da proposta.
  rule requestedAmount > 0 BRL {
    // REVIEW [2026-12-15] Mensagem da regra em português.
    pt-BR: "O valor solicitado precisa ser positivo"
    // REVIEW [2026-12-15] Mensagem da regra em inglês.
    en: "Requested amount must be positive"
  }

  // REVIEW [2026-12-15] Segregação de funções entre as actions do documento.
  segregation {
    // REVIEW [2026-12-15] Quem envia a proposta não pode aprová-la.
    submit != approve
  }
}

// REVIEW [2026-12-15] Forma de estado com as situações possíveis da proposta.
shape CreditApplicationStatus {
  // REVIEW [2026-12-15] Título exibido onde a situação é referenciada.
  title: { pt-BR: "Situação da proposta de crédito", en: "Credit application status" }
  // REVIEW [2026-12-15] Base state: os valores são estados de uma máquina de estados.
  base: state
  // REVIEW [2026-12-15] Estado inicial de toda proposta criada.
  initial: Draft
  // REVIEW [2026-12-15] Estado de rascunho: proposta ainda não enviada.
  value Draft {
    // REVIEW [2026-12-15] Título exibido no formulário e nos filtros.
    title: { pt-BR: "Rascunho", en: "Draft" }
    // REVIEW [2026-12-15] Ícone associado ao estado, resolvido pelo nome Draft.
    icon: Draft
    // REVIEW [2026-12-15] Ordem de exibição do estado na linha do tempo.
    ordinal: 10

    // REVIEW [2026-12-15] Transição disparada pelo envio da proposta.
    transition Submitted {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Proposta enviada", en: "Credit application submitted" }
      // REVIEW [2026-12-15] Dados transportados pelo evento de transição.
      payload {
        // REVIEW [2026-12-15] Instante do envio transportado no evento.
        submittedAt: DateTime { title: { pt-BR: "Enviada em", en: "Submitted at" } }
        // REVIEW [2026-12-15] Valor solicitado transportado no evento.
        requestedAmount: std.Money { title: { pt-BR: "Valor solicitado", en: "Requested amount" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado de proposta enviada, aguardando análise.
  value Submitted {
    // REVIEW [2026-12-15] Título exibido no formulário e nos filtros.
    title: { pt-BR: "Enviada", en: "Submitted" }
    // REVIEW [2026-12-15] Ícone associado ao estado, resolvido pelo nome Submitted.
    icon: Submitted
    // REVIEW [2026-12-15] Ordem de exibição do estado na linha do tempo.
    ordinal: 20

    // REVIEW [2026-12-15] Transição disparada pelo início da análise.
    transition UnderReview {
      // REVIEW [2026-12-15] Nome do evento que dispara a transição.
      event: ReviewStarted
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Análise iniciada", en: "Credit review started" }
      // REVIEW [2026-12-15] Dados transportados pelo evento de transição.
      payload {
        // REVIEW [2026-12-15] Instante de início da análise transportado no evento.
        reviewStartedAt: DateTime { title: { pt-BR: "Iniciada em", en: "Started at" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado de proposta em análise manual.
  value UnderReview {
    // REVIEW [2026-12-15] Título exibido no formulário e nos filtros.
    title: { pt-BR: "Em análise", en: "Under review" }
    // REVIEW [2026-12-15] Ícone associado ao estado, resolvido pelo nome UnderReview.
    icon: UnderReview
    // REVIEW [2026-12-15] Ordem de exibição do estado na linha do tempo.
    ordinal: 30

    // REVIEW [2026-12-15] Transição disparada pela aprovação do crédito.
    transition Approved {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Crédito aprovado", en: "Credit approved" }
      // REVIEW [2026-12-15] Dados transportados pelo evento de transição.
      payload {
        // REVIEW [2026-12-15] Instante da aprovação transportado no evento.
        approvedAt: DateTime { title: { pt-BR: "Aprovada em", en: "Approved at" } }
        // REVIEW [2026-12-15] Limite aprovado transportado no evento.
        approvedLimit: std.Money { title: { pt-BR: "Limite aprovado", en: "Approved limit" } }
      }
    }

    // REVIEW [2026-12-15] Transição disparada pela rejeição do crédito.
    transition Rejected {
      // REVIEW [2026-12-15] Título exibido no histórico da transição.
      title: { pt-BR: "Crédito rejeitado", en: "Credit rejected" }
      // REVIEW [2026-12-15] Dados transportados pelo evento de transição.
      payload {
        // REVIEW [2026-12-15] Instante da rejeição transportado no evento.
        rejectedAt: DateTime { title: { pt-BR: "Rejeitada em", en: "Rejected at" } }
        // REVIEW [2026-12-15] Motivo da rejeição transportado no evento.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado final de proposta aprovada.
  value Approved {
    // REVIEW [2026-12-15] Título exibido no formulário e nos filtros.
    title: { pt-BR: "Aprovada", en: "Approved" }
    // REVIEW [2026-12-15] Ícone associado ao estado, resolvido pelo nome Approved.
    icon: Approved
    // REVIEW [2026-12-15] Ordem de exibição do estado na linha do tempo.
    ordinal: 40
  }
  // REVIEW [2026-12-15] Estado final de proposta rejeitada.
  value Rejected {
    // REVIEW [2026-12-15] Título exibido no formulário e nos filtros.
    title: { pt-BR: "Rejeitada", en: "Rejected" }
    // REVIEW [2026-12-15] Ícone associado ao estado, resolvido pelo nome Rejected.
    icon: Rejected
    // REVIEW [2026-12-15] Ordem de exibição do estado na linha do tempo.
    ordinal: 50
  }
}
