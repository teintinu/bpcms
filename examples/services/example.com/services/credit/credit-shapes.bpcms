// service: example.com/services/credit

shape RiskBand {
  title: { pt-BR: "Faixa de risco", en: "Risk band" }
  base: classification
  value Low {
    title: { pt-BR: "Baixo", en: "Low" }
    icon: Low
    ordinal: 10
  }
  value Medium {
    title: { pt-BR: "Médio", en: "Medium" }
    icon: Medium
    ordinal: 20
  }
  value High {
    title: { pt-BR: "Alto", en: "High" }
    icon: High
    ordinal: 30
  }
}
