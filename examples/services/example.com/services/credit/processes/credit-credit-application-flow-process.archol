// REVIEW [2026-12-15] service: example.com/services/credit

// REVIEW [2026-12-15] Declara o processo de análise de crédito; o argumento é o documento-sujeito.
process CreditApplicationFlow(creditApplication: CreditApplication) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Análise de crédito", en: "Credit analysis" }
  // REVIEW [2026-12-15] Versão do artefato Process; diff e release comparam.
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Conceder limite com risco calculado, alçada explícita e decisão rastreável"
  }
  // REVIEW [2026-12-15] SLA brando do caso: alvo de lead time de dez dias, não é timer.
  sla: "10d"

  // REVIEW [2026-12-15] Gatilho: inicia uma instância quando a proposta emite Submitted.
  on [CreditApplication.Submitted]
  // REVIEW [2026-12-15] Chave de identidade, correlação e dedup da instância.
  key: creditApplication

  // REVIEW [2026-12-15] Variável durável da instância: score do bureau; começa nula.
  let bureauScore: std.Count | null = null
  // REVIEW [2026-12-15] Variável durável da instância: faixa de risco; começa nula.
  let band: RiskBand | null = null

  // REVIEW [2026-12-15] Inicia a análise manual da proposta antes de consultar o bureau.
  CreditApplication.startReview()

  // REVIEW [2026-12-15] Bloco de tentativa: captura falha de disponibilidade do bureau.
  try {
    // REVIEW [2026-12-15] Chama o bureau de crédito e guarda o score retornado.
    bureauScore = CreditBureau.score({ application: creditApplication })
  // REVIEW [2026-12-15] Tratamento do erro de bureau indisponível.
  } catch (BureauUnavailable) {
    // REVIEW [2026-12-15] Bureau indisponível: a proposta segue direto para a análise manual.
  }

  // REVIEW [2026-12-15] Só calcula a faixa de risco quando o bureau devolveu um score.
  if (bureauScore != null) {
    // REVIEW [2026-12-15] Chama a decisão de scoring com score, valor e exposição da proposta.
    band = CreditScoring.evaluate({
      // REVIEW [2026-12-15] Score apurado no bureau.
      bureauScore: bureauScore,
      // REVIEW [2026-12-15] Valor solicitado na proposta.
      requestedAmount: creditApplication.requestedAmount,
      // REVIEW [2026-12-15] Exposição de crédito já existente do proponente.
      existingExposure: creditApplication.existingExposure
    })

    // REVIEW [2026-12-15] Registra score e faixa de risco no documento da proposta.
    CreditApplication.recordRisk({
      // REVIEW [2026-12-15] Score apurado que será persistido.
      bureauScore: bureauScore,
      // REVIEW [2026-12-15] Faixa de risco apurada que será persistida.
      riskBand: band
    })
  }

  // REVIEW [2026-12-15] Sem score do bureau, abre a decisão manual do analista.
  if (bureauScore == null) {
    // REVIEW [2026-12-15] Análise manual sem score do bureau.
    try {
      // REVIEW [2026-12-15] Abre o form de decisão para o analista.
      CreditDecision.show({ creditApplication })
    // REVIEW [2026-12-15] Tratamento do timeout ao aguardar a decisão do form.
    } catch (Timeout) {
      // REVIEW [2026-12-15] Sem resposta no prazo, escala a decisão para a alçada gerencial.
      Escalate.show({ creditApplication })
    }
  // REVIEW [2026-12-15] Ramo automático: risco baixo e valor dentro do teto de vinte mil reais.
  } else if (band == Low and creditApplication.requestedAmount <= 20000 BRL) {
    // REVIEW [2026-12-15] Risco baixo e valor até vinte mil reais: aprova automaticamente.
    CreditApplication.approve({
      // REVIEW [2026-12-15] Aprova exatamente o valor solicitado.
      approvedLimit: creditApplication.requestedAmount
    })
  // REVIEW [2026-12-15] Ramo de decisão humana: risco baixo acima do teto ou risco médio.
  } else if (band == Low or band == Medium) {
    // REVIEW [2026-12-15] Risco baixo ou médio acima do limite automático: decisão humana.
    try {
      // REVIEW [2026-12-15] Abre o form de decisão para o analista.
      CreditDecision.show({ creditApplication })
    // REVIEW [2026-12-15] Tratamento do timeout ao aguardar a decisão do form.
    } catch (Timeout) {
      // REVIEW [2026-12-15] Sem resposta no prazo, escala a decisão para a alçada gerencial.
      Escalate.show({ creditApplication })
    }
  // REVIEW [2026-12-15] Ramo de risco alto: a decisão nunca é automática.
  } else {
    // REVIEW [2026-12-15] Risco alto: decisão humana obrigatória.
    try {
      // REVIEW [2026-12-15] Abre o form de decisão para o analista.
      CreditDecision.show({ creditApplication })
    // REVIEW [2026-12-15] Tratamento do timeout ao aguardar a decisão do form.
    } catch (Timeout) {
      // REVIEW [2026-12-15] Sem resposta no prazo, escala a decisão para a alçada gerencial.
      Escalate.show({ creditApplication })
    }
  }

  // REVIEW [2026-12-15] Se a proposta terminou rejeitada, encerra o caso nesse desfecho.
  if (creditApplication.status == Rejected) {
    // REVIEW [2026-12-15] Retorna o desfecho de falha, sem criar limite.
    return Rejected
  }

  // REVIEW [2026-12-15] Cria o limite de crédito com o valor aprovado na proposta.
  CreditLimit.set({
    // REVIEW [2026-12-15] Proposta que origina o limite.
    application: creditApplication,
    // REVIEW [2026-12-15] Titular do limite: o proponente da proposta.
    holder: creditApplication.applicant,
    // REVIEW [2026-12-15] Valor do limite: o limite aprovado na análise.
    amount: creditApplication.approvedLimit
  })

  // REVIEW [2026-12-15] Encerra no desfecho de sucesso.
  return Approved

  // REVIEW [2026-12-15] Declara o desfecho de sucesso do caso.
  end Approved {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Crédito aprovado", en: "Credit approved" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }

  // REVIEW [2026-12-15] Declara o desfecho de falha do caso.
  end Rejected {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Crédito negado", en: "Credit rejected" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: failure
  }
}

// REVIEW [2026-12-15] Erro de negócio: bureau de crédito fora do ar.
error BureauUnavailable {
  // REVIEW [2026-12-15] Título do erro exibido ao usuário.
  title: { pt-BR: "Bureau de crédito indisponível", en: "Credit bureau unavailable" }
}

// REVIEW [2026-12-15] Erro reservado de prazo esgotado.
error Timeout {
  // REVIEW [2026-12-15] Título do erro exibido ao usuário.
  title: { pt-BR: "Prazo esgotado", en: "Timed out" }
}

// REVIEW [2026-12-15] Form de decisão manual da proposta pelo analista.
form CreditDecision {
  // REVIEW [2026-12-15] Título exibido na inbox e no cabeçalho do form.
  title: { pt-BR: "Decisão de crédito", en: "Credit decision" }
  // REVIEW [2026-12-15] Documento cujos dados o form apresenta e atualiza.
  document: CreditApplication
  // REVIEW [2026-12-15] Papéis que podem atender o form.
  roles: [CreditAnalyst, CreditManager]
  // REVIEW [2026-12-15] Prazo de atendimento: três dias antes de escalar.
  timeout: 3d
  // REVIEW [2026-12-15] Prioridade de exibição na fila de tarefas.
  priority: 40
  // REVIEW [2026-12-15] Distribuição pull: o próprio atendente puxa a tarefa.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Proponente exibido somente para leitura.
    applicant { readonly }
    // REVIEW [2026-12-15] Valor solicitado exibido somente para leitura.
    requestedAmount { readonly }
    // REVIEW [2026-12-15] Score do bureau exibido somente para leitura.
    bureauScore { readonly }
    // REVIEW [2026-12-15] Faixa de risco exibida somente para leitura.
    riskBand { readonly }
    // REVIEW [2026-12-15] Limite aprovado informado na decisão.
    approvedLimit
    // REVIEW [2026-12-15] Motivo da rejeição informado na decisão.
    rejectionReason
  }

  // REVIEW [2026-12-15] Botões do formulário e as actions que eles disparam.
  actions {
    // REVIEW [2026-12-15] Aprovar chama a action approve com o limite informado.
    approve { calls: CreditApplication.approve(approvedLimit) }
    // REVIEW [2026-12-15] Rejeitar chama a action reject com o motivo informado.
    reject { calls: CreditApplication.reject(rejectionReason) }
  }
}

// REVIEW [2026-12-15] Form de decisão escalada para a alçada gerencial.
form Escalate {
  // REVIEW [2026-12-15] Título exibido na inbox e no cabeçalho do form.
  title: { pt-BR: "Decisão de crédito — alçada gerencial", en: "Credit decision — manager approval" }
  // REVIEW [2026-12-15] Documento cujos dados o form apresenta e atualiza.
  document: CreditApplication
  // REVIEW [2026-12-15] Papéis que podem atender o form.
  roles: [CreditManager]
  // REVIEW [2026-12-15] Prazo de atendimento: um dia antes de expirar.
  timeout: 1d
  // REVIEW [2026-12-15] Distribuição pull: o próprio gerente puxa a tarefa.
  assign: pull

  // REVIEW [2026-12-15] Campos exibidos no formulário.
  fields {
    // REVIEW [2026-12-15] Proponente exibido somente para leitura.
    applicant { readonly }
    // REVIEW [2026-12-15] Valor solicitado exibido somente para leitura.
    requestedAmount { readonly }
    // REVIEW [2026-12-15] Score do bureau exibido somente para leitura.
    bureauScore { readonly }
    // REVIEW [2026-12-15] Faixa de risco exibida somente para leitura.
    riskBand { readonly }
    // REVIEW [2026-12-15] Limite aprovado informado na decisão.
    approvedLimit
    // REVIEW [2026-12-15] Motivo da rejeição informado na decisão.
    rejectionReason
  }

  // REVIEW [2026-12-15] Botões do formulário e as actions que eles disparam.
  actions {
    // REVIEW [2026-12-15] Aprovar chama a action approve com o limite informado.
    approve { calls: CreditApplication.approve(approvedLimit) }
    // REVIEW [2026-12-15] Rejeitar chama a action reject com o motivo informado.
    reject { calls: CreditApplication.reject(rejectionReason) }
  }
}

// REVIEW [2026-12-15] Decisão de scoring que converte score e valores em uma faixa de risco.
decision CreditScoring {
  // REVIEW [2026-12-15] Título exibido na revisão e no painel de decisões.
  title: { pt-BR: "Faixa de risco da proposta", en: "Credit application risk band" }
  // REVIEW [2026-12-15] Tipo devolvido pela decisão.
  returns: RiskBand
  // REVIEW [2026-12-15] Entradas exigidas para avaliar a faixa de risco.
  inputs {
    // REVIEW [2026-12-15] Score apurado no bureau de crédito.
    bureauScore: std.Count
    // REVIEW [2026-12-15] Valor de crédito solicitado na proposta.
    requestedAmount: std.Money
    // REVIEW [2026-12-15] Exposição de crédito já existente do proponente.
    existingExposure: std.Money
  }
  // REVIEW [2026-12-15] Casos avaliados em ordem até o primeiro que casar.
  cases {
    // REVIEW [2026-12-15] Score alto e valores contidos nos limites da política: risco baixo.
    bureauScore >= 750 and requestedAmount <= 50000 BRL and existingExposure <= 10000 BRL -> Low
    // REVIEW [2026-12-15] Score ainda razoável: risco médio.
    bureauScore >= 550 -> Medium
    // REVIEW [2026-12-15] Qualquer outro caso: risco alto.
    else -> High
  }
  // REVIEW [2026-12-15] Documento-fonte da política de crédito aplicada.
  source: "Política de Crédito v4"
  // REVIEW [2026-12-15] Área responsável pela manutenção da decisão.
  owner: "Credit"
}

// REVIEW [2026-12-15] Integração REST com o bureau externo de crédito.
integration CreditBureau {
  // REVIEW [2026-12-15] Protocolo de comunicação da integração.
  protocol: rest
  // REVIEW [2026-12-15] URL base lida da variável de ambiente do serviço.
  baseUrl: env.CREDIT_BUREAU_URL
  // REVIEW [2026-12-15] Autenticação por chave de API.
  auth: api-key
  // REVIEW [2026-12-15] Tempo máximo de espera por chamada: cinco segundos.
  timeout: 5s
  // REVIEW [2026-12-15] Até três tentativas com espera exponencial.
  retry: exponential(3)
  // REVIEW [2026-12-15] Envia o cabeçalho de idempotência para evitar cobrança duplicada.
  idempotency: header "Idempotency-Key"

  // REVIEW [2026-12-15] Operações expostas pela integração.
  operations {
    // REVIEW [2026-12-15] Consulta o score do bureau para uma proposta, devolvendo um count.
    score(application: CreditApplication): std.Count
  }
}
