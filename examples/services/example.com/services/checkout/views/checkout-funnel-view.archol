// REVIEW [2026-12-15] service: example.com/services/checkout

// REVIEW [2026-12-15] Relatório de funil: acompanha o avanço das sessões por etapa.
view Funnel {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Funil de finalização", en: "Checkout funnel" }
  // REVIEW [2026-12-15] Tipo da view: relatório agregado.
  type: report
  // REVIEW [2026-12-15] Documentos usados como fonte dos dados.
  sources: [CheckoutSession]
  // REVIEW [2026-12-15] Papéis que podem abrir o relatório.
  roles: [SupportAgent]

  // REVIEW [2026-12-15] Filtros oferecidos ao usuário.
  filters { period; status }
  // REVIEW [2026-12-15] Métricas calculadas sobre as sessões.
  metrics {
    // REVIEW [2026-12-15] Total de sessões iniciadas.
    started: count(CheckoutSession)
    // REVIEW [2026-12-15] Sessões que passaram do rascunho.
    validated: count(CheckoutSession) where status != Draft
    // REVIEW [2026-12-15] Sessões confirmadas.
    paid: count(CheckoutSession) where status == Confirmed
    // REVIEW [2026-12-15] Sessões abandonadas.
    abandoned: count(CheckoutSession) where status == Abandoned
    // REVIEW [2026-12-15] Receita somada das sessões confirmadas.
    revenue: sum(CheckoutSession.total) where status == Confirmed
  }
  // REVIEW [2026-12-15] Unidade usada pela métrica de receita.
  units { revenue: BRL }
  // REVIEW [2026-12-15] Idade máxima dos dados antes de recarregar.
  freshness: 10m
  // REVIEW [2026-12-15] Formatos de exportação permitidos.
  export: [pdf, csv]
}
