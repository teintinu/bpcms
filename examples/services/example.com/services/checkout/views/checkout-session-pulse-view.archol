// service: example.com/services/checkout

// Painel ao vivo com o pulso operacional das sessões.
view SessionPulse {
  // Título exibido na navegação.
  title: { pt-BR: "Pulso das finalizações", en: "Session pulse" }
  // Tipo da view: painel de indicadores.
  type: dashboard
  // Documentos usados como fonte dos dados.
  sources: [CheckoutSession]
  // Papéis que podem abrir o painel.
  roles: [SupportAgent]
  // Atualização em tempo real enquanto o painel está aberto.
  mode: live

  // Filtros oferecidos ao usuário.
  filters { status }
  // Métricas calculadas sobre as sessões.
  metrics {
    // Sessões aguardando pagamento.
    awaitingPayment: count(CheckoutSession) where status == PaymentAuthorized
    // Sessões aguardando cotação de frete.
    awaitingQuote: count(CheckoutSession) where status == Validated
    // Sessões abandonadas no dia.
    abandonedToday: count(CheckoutSession) where status == Abandoned
  }
  // Idade máxima dos dados antes de recarregar.
  freshness: 1m
}
