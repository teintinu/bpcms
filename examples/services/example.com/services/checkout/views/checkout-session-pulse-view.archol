// REVIEW [2026-12-15] service: example.com/services/checkout

// REVIEW [2026-12-15] Painel ao vivo com o pulso operacional das sessões.
view SessionPulse {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Pulso das finalizações", en: "Session pulse" }
  // REVIEW [2026-12-15] Tipo da view: painel de indicadores.
  type: dashboard
  // REVIEW [2026-12-15] Documentos usados como fonte dos dados.
  sources: [CheckoutSession]
  // REVIEW [2026-12-15] Papéis que podem abrir o painel.
  roles: [SupportAgent]
  // REVIEW [2026-12-15] Atualização em tempo real enquanto o painel está aberto.
  mode: live

  // REVIEW [2026-12-15] Filtros oferecidos ao usuário.
  filters { status }
  // REVIEW [2026-12-15] Métricas calculadas sobre as sessões.
  metrics {
    // REVIEW [2026-12-15] Sessões aguardando pagamento.
    awaitingPayment: count(CheckoutSession) where status == PaymentAuthorized
    // REVIEW [2026-12-15] Sessões aguardando cotação de frete.
    awaitingQuote: count(CheckoutSession) where status == Validated
    // REVIEW [2026-12-15] Sessões abandonadas no dia.
    abandonedToday: count(CheckoutSession) where status == Abandoned
  }
  // REVIEW [2026-12-15] Idade máxima dos dados antes de recarregar.
  freshness: 1m
}
