// REVIEW [2026-12-15] service: example.com/services/checkout

// REVIEW [2026-12-15] View de inbox com as finalizações do próprio usuário.
view MyCheckouts {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Minhas finalizações", en: "My checkouts" }
  // REVIEW [2026-12-15] Tipo da view: lista de tarefas de entrada.
  type: inbox
  // REVIEW [2026-12-15] Papéis que podem abrir a view.
  roles: [Customer, SupportAgent]
  // REVIEW [2026-12-15] Mostra apenas os itens do próprio usuário.
  scope: mine
  // REVIEW [2026-12-15] Agrupa os itens pelo processo de origem.
  groupBy: process
  // REVIEW [2026-12-15] Colunas exibidas na lista.
  columns { title; subject; dueAt; priority }
}
