// service: example.com/services/checkout

// Detalhe de uma sessão de finalização.
view SessionDetail {
  // Título exibido na navegação.
  title: { pt-BR: "Detalhe da sessão", en: "Session detail" }
  // Tipo da view: tela de detalhe de registro.
  type: detail
  // Documento exibido no detalhe.
  document: CheckoutSession
  // Papéis que podem abrir o detalhe.
  roles: [SupportAgent, Customer]

  // Seções exibidas na tela de detalhe.
  sections { summary; timeline }
  // Ações disponíveis no detalhe.
  actions {
    // Leva à view de andamento do processo.
    progress -> CheckoutProgress
  }
}
