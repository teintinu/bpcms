// REVIEW [2026-12-15] service: example.com/services/checkout

// REVIEW [2026-12-15] Tabela com todas as sessões de finalização.
view Sessions {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Sessões de finalização", en: "Checkout sessions" }
  // REVIEW [2026-12-15] Tipo da view: tabela de registros.
  type: table
  // REVIEW [2026-12-15] Documento exibido nas linhas da tabela.
  source: CheckoutSession
  // REVIEW [2026-12-15] Papéis que podem abrir a tabela.
  roles: [SupportAgent, Customer]

  // REVIEW [2026-12-15] Colunas exibidas na tabela.
  columns { customer; total; status; createdAt }
  // REVIEW [2026-12-15] Filtros oferecidos ao usuário.
  filters { status; period; customer }
  // REVIEW [2026-12-15] Quantidade de linhas por página.
  pagination: 50

  // REVIEW [2026-12-15] Ações disponíveis na tabela.
  actions {
    // REVIEW [2026-12-15] Abre o detalhe da sessão selecionada.
    open -> SessionDetail
    // REVIEW [2026-12-15] Cria uma nova sessão de finalização.
    startCheckout -> CheckoutSession.create(customer, total)
    // REVIEW [2026-12-15] Valida o carrinho da sessão.
    validate -> CheckoutSession.validateCart
    // REVIEW [2026-12-15] Abandona a sessão informando o motivo.
    abandon -> CheckoutSession.abandon(reason)
  }
}
