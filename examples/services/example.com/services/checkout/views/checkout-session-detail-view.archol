// REVIEW [2026-12-15] service: example.com/services/checkout

// REVIEW [2026-12-15] Detalhe de uma sessão de finalização.
view SessionDetail {
  // REVIEW [2026-12-15] Título exibido na navegação.
  title: { pt-BR: "Detalhe da sessão", en: "Session detail" }
  // REVIEW [2026-12-15] Tipo da view: tela de detalhe de registro.
  type: detail
  // REVIEW [2026-12-15] Documento exibido no detalhe.
  document: CheckoutSession
  // REVIEW [2026-12-15] Papéis que podem abrir o detalhe.
  roles: [SupportAgent, Customer]

  // REVIEW [2026-12-15] Seções exibidas na tela de detalhe.
  sections { summary; timeline }
  // REVIEW [2026-12-15] Ações disponíveis no detalhe.
  actions {
    // REVIEW [2026-12-15] Leva à view de andamento do processo.
    progress -> CheckoutProgress
  }
}
