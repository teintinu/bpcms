// REVIEW [2026-12-15] service: example.com/services/checkout

// REVIEW [2026-12-15] Formulário de retentativa: aparece quando o pagamento é recusado.
form PaymentRetry {
  // REVIEW [2026-12-15] Título exibido na inbox e na tarefa.
  title: { pt-BR: "Repetir pagamento", en: "Retry payment" }
  // REVIEW [2026-12-15] Documento que o formulário edita; é a sessão do processo.
  document: CheckoutSession
  // REVIEW [2026-12-15] Papéis que podem preencher o formulário.
  roles: [Customer]
  // REVIEW [2026-12-15] Prazo para preencher antes de o formulário expirar.
  timeout: 1d
  // REVIEW [2026-12-15] Prioridade da tarefa na inbox (maior aparece primeiro).
  priority: 80

  // REVIEW [2026-12-15] Campos apresentados ao cliente.
  fields {
    // REVIEW [2026-12-15] Cliente dono da sessão, exibido sem edição.
    customer { readonly }
    // REVIEW [2026-12-15] Total do pedido, exibido sem edição.
    total { readonly }

    // REVIEW [2026-12-15] Forma de pagamento nova; campo obrigatório só ao tentar de novo.
    method: PaymentMethod {
      // REVIEW [2026-12-15] Título que explica a obrigatoriedade ao repetir a tentativa.
      title: { pt-BR: "Nova forma de pagamento (obrigatória ao tentar novamente)", en: "New payment method (required to retry)" }
    }

    // REVIEW [2026-12-15] Motivo do abandono; obrigatório apenas para desistir da compra.
    reason: string {
      // REVIEW [2026-12-15] Título que explica quando o motivo é exigido.
      title: { pt-BR: "Motivo do abandono (obrigatório ao desistir)", en: "Abandonment reason (required to give up)" }
      // REVIEW [2026-12-15] Limita o motivo a quinhentos caracteres.
      maxLength: 500
    }
  }

  // REVIEW [2026-12-15] Ações que o cliente pode disparar neste formulário.
  actions {
    // REVIEW [2026-12-15] Retenta o pagamento com a forma escolhida.
    retry {
      // REVIEW [2026-12-15] Título do botão na tela.
      title: { pt-BR: "Tentar novamente", en: "Try again" }
      // REVIEW [2026-12-15] Executa a action do documento passando a forma informada.
      calls: CheckoutSession.retryPayment(method)
    }

    // REVIEW [2026-12-15] Desiste da compra informando o motivo.
    cancel {
      // REVIEW [2026-12-15] Título do botão na tela.
      title: { pt-BR: "Desistir da compra", en: "Give up" }
      // REVIEW [2026-12-15] Executa a action de abandono passando o motivo informado.
      calls: CheckoutSession.abandon(reason)
    }
  }
}

// REVIEW [2026-12-15] Formulário de contingência: o suporte informa o frete quando a cotação falha.
form FreightReview {
  // REVIEW [2026-12-15] Título exibido na inbox e na tarefa.
  title: { pt-BR: "Informar frete manual", en: "Enter freight manually" }
  // REVIEW [2026-12-15] Documento que o formulário edita; é a sessão do processo.
  document: CheckoutSession
  // REVIEW [2026-12-15] Papéis que podem preencher o formulário.
  roles: [SupportAgent]
  // REVIEW [2026-12-15] Prazo para preencher antes de o formulário expirar.
  timeout: 1d
  // REVIEW [2026-12-15] Tarefa é puxada: fica disponível para o agente assumir, sem atribuição fixa.
  assign: pull

  // REVIEW [2026-12-15] Campos apresentados ao agente.
  fields {
    // REVIEW [2026-12-15] Cliente dono da sessão, exibido sem edição.
    customer { readonly }
    // REVIEW [2026-12-15] Total do pedido, exibido sem edição.
    total { readonly }

    // REVIEW [2026-12-15] Frete negociado manualmente; obrigatório no preenchimento.
    freightAmount: std.Money {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Frete negociado", en: "Negotiated freight" }
      // REVIEW [2026-12-15] Moeda do valor informado.
      currency: BRL
      // REVIEW [2026-12-15] Torna o campo obrigatório no preenchimento.
      required
    }

    // REVIEW [2026-12-15] Prazo de entrega negociado; obrigatório no preenchimento.
    days: std.Count {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Prazo em dias", en: "Days" }
      // REVIEW [2026-12-15] Menor prazo aceito, em dias.
      min: 1
      // REVIEW [2026-12-15] Maior prazo aceito, em dias.
      max: 90
      // REVIEW [2026-12-15] Torna o campo obrigatório no preenchimento.
      required
    }
  }

  // REVIEW [2026-12-15] Ações que o agente pode disparar neste formulário.
  actions {
    // REVIEW [2026-12-15] Aplica o frete manual à sessão.
    apply {
      // REVIEW [2026-12-15] Título do botão na tela.
      title: { pt-BR: "Aplicar frete", en: "Apply freight" }
      // REVIEW [2026-12-15] Executa a action de cotação com os valores informados.
      calls: CheckoutSession.quoteShipping(freightAmount, days)
    }
  }
}
