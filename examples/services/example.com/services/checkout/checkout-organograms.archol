// REVIEW [2026-12-15] service: example.com/services/checkout

// REVIEW [2026-12-15] Organograma do serviço: define a hierarquia entre os papéis.
organogram Storefront {
  // REVIEW [2026-12-15] Título exibido no builder.
  title: { pt-BR: "Organograma da loja", en: "Storefront organogram" }

  // REVIEW [2026-12-15] Bloco que declara as relações de subordinação entre os papéis.
  hierarchy {
    // REVIEW [2026-12-15] O agente de atendimento está acima do cliente na hierarquia.
    SupportAgent > Customer
  }
}

// REVIEW [2026-12-15] Papel do cliente que finaliza a compra.
role Customer {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Cliente", en: "Customer" }
  // REVIEW [2026-12-15] Permissões para iniciar e pagar a finalização.
  permissions: [checkout.start, checkout.pay]
}

// REVIEW [2026-12-15] Papel do agente de atendimento, herda as permissões do cliente.
role SupportAgent {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Agente de atendimento", en: "Support agent" }
  // REVIEW [2026-12-15] Herda as permissões do papel Customer.
  inherits: Customer
  // REVIEW [2026-12-15] Permissões de consulta, recuperação e relatórios.
  permissions: [checkout.view, checkout.recover, report.view]
}

// REVIEW [2026-12-15] Papel técnico que executa as operações automáticas do processo.
role SessionEngine {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Motor de finalização", en: "Session engine" }
  // REVIEW [2026-12-15] Permissões para cotar, autorizar e confirmar a compra.
  permissions: [checkout.quote, checkout.authorize, checkout.confirm]
}
