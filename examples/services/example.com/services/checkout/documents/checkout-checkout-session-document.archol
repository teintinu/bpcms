// REVIEW [2026-12-15] service: example.com/services/checkout

// REVIEW [2026-12-15] Documento que representa a sessão de finalização de uma compra.
document CheckoutSession {
  // REVIEW [2026-12-15] Título exibido na interface.
  title: { pt-BR: "Sessão de finalização", en: "Checkout session" }
  // REVIEW [2026-12-15] Versão do documento; releases e diffs comparam este valor.
  version: 2
  // REVIEW [2026-12-15] Área responsável pelo documento.
  owner: "Checkout"
  // REVIEW [2026-12-15] Mantém as telas abertas sincronizadas ao vivo com o documento.
  sync: live

  // REVIEW [2026-12-15] Campos que compõem a sessão.
  fields {
    // REVIEW [2026-12-15] Cliente que está finalizando a compra.
    customer: User {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Cliente", en: "Customer" }
      // REVIEW [2026-12-15] Permite localizar sessões pelo cliente.
      lookup
    }
    // REVIEW [2026-12-15] Valor total do pedido.
    total: std.Money {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Total", en: "Total" }
      // REVIEW [2026-12-15] Permite localizar sessões pelo total.
      lookup
      // REVIEW [2026-12-15] Moeda do valor total.
      currency: BRL
    }
    // REVIEW [2026-12-15] Valor do frete registrado para a sessão.
    freight: std.Money {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Frete", en: "Freight" }
      // REVIEW [2026-12-15] Moeda do valor do frete.
      currency: BRL
    }
    // REVIEW [2026-12-15] Prazo de entrega acordado, em dias.
    deliveryDays: std.Count {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Prazo de entrega", en: "Delivery days" }
      // REVIEW [2026-12-15] Menor prazo aceito, em dias.
      min: 1
      // REVIEW [2026-12-15] Maior prazo aceito, em dias.
      max: 90
    }
    // REVIEW [2026-12-15] Forma de pagamento escolhida pelo cliente.
    paymentMethod: PaymentMethod {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Método de pagamento", en: "Payment method" }
      // REVIEW [2026-12-15] Permite localizar sessões pela forma de pagamento.
      lookup
    }
    // REVIEW [2026-12-15] Código devolvido pelo gateway ao autorizar o pagamento.
    authorizationCode: string {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Código de autorização", en: "Authorization code" }
      // REVIEW [2026-12-15] Limita o código a sessenta caracteres.
      maxLength: 60
    }
    // REVIEW [2026-12-15] Situação atual da sessão no ciclo de vida.
    status: CheckoutStatus {
      // REVIEW [2026-12-15] Título exibido no formulário.
      title: { pt-BR: "Situação", en: "Status" }
      // REVIEW [2026-12-15] Permite localizar sessões pela situação.
      lookup
    }
    // REVIEW [2026-12-15] Data e hora em que a sessão foi criada.
    createdAt: DateTime { title: { pt-BR: "Criada em", en: "Created at" } }
    // REVIEW [2026-12-15] Data e hora em que a compra foi confirmada.
    confirmedAt: DateTime { title: { pt-BR: "Confirmada em", en: "Confirmed at" } }
  }

  // REVIEW [2026-12-15] Índices que aceleram as consultas mais frequentes.
  indexes {
    // REVIEW [2026-12-15] Ordena por cliente e data de criação para listar o histórico.
    byCustomer: [customer.id, createdAt] range
    // REVIEW [2026-12-15] Ordena por situação e data para filtros operacionais.
    byStatus: [status, createdAt] range
  }


  // REVIEW [2026-12-15] Ações que alteram a sessão.
  actions {
    // REVIEW [2026-12-15] Abre uma nova sessão de finalização para o cliente.
    create(customer: User, total: std.Money) {
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Abrir sessão", en: "Open session" }
      // REVIEW [2026-12-15] Papéis autorizados a abrir a sessão.
      roles: [Customer]
      {
        // REVIEW [2026-12-15] Registra o instante de criação da sessão.
        createdAt = now()
      }
    }

    // REVIEW [2026-12-15] Valida o carrinho antes de seguir para o frete.
    validateCart() {
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Validar carrinho", en: "Validate cart" }
      // REVIEW [2026-12-15] Papéis autorizados a validar o carrinho.
      roles: [Customer]

      // REVIEW [2026-12-15] Move a sessão para o estado Validated.
      to: status.Validated

      // REVIEW [2026-12-15] Regra de negócio avaliada antes da transição.
      rule total > 0 {
        // REVIEW [2026-12-15] Mensagem de erro em português.
        pt-BR: "O carrinho está vazio"
        // REVIEW [2026-12-15] Mensagem de erro em inglês.
        en: "The cart is empty"
      }
    }

    // REVIEW [2026-12-15] Registra o frete cotado e o prazo de entrega.
    quoteShipping(freightAmount: std.Money, days: std.Count) {
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Registrar frete", en: "Record shipping" }
      // REVIEW [2026-12-15] Papéis autorizados a registrar o frete.
      roles: [SessionEngine, SupportAgent]

      // REVIEW [2026-12-15] Move a sessão para o estado ShippingQuoted.
      to: status.ShippingQuoted
      // REVIEW [2026-12-15] Publica os valores de frete e prazo como dados da transição.
      emits { freight: freightAmount; deliveryDays: days }

      // REVIEW [2026-12-15] Regra de negócio: o frete não pode ser negativo.
      rule freightAmount >= 0 BRL {
        // REVIEW [2026-12-15] Mensagem de erro em português.
        pt-BR: "O frete não pode ser negativo"
        // REVIEW [2026-12-15] Mensagem de erro em inglês.
        en: "Freight cannot be negative"
      }
      {
        // REVIEW [2026-12-15] Grava o valor do frete no documento.
        freight = freightAmount
        // REVIEW [2026-12-15] Grava o prazo de entrega no documento.
        deliveryDays = days
      }
    }

    // REVIEW [2026-12-15] Registra o código de autorização devolvido pelo gateway.
    authorizePayment(authorization: string) {
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Registrar autorização", en: "Record authorization" }
      // REVIEW [2026-12-15] Papéis autorizados a registrar a autorização.
      roles: [SessionEngine]

      // REVIEW [2026-12-15] Move a sessão para o estado PaymentAuthorized.
      to: status.PaymentAuthorized
      // REVIEW [2026-12-15] Publica o código de autorização como dado da transição.
      emits { authorizationCode: authorization }

      // REVIEW [2026-12-15] Regra de negócio: exige um código com tamanho mínimo.
      rule authorization.length >= 4 {
        // REVIEW [2026-12-15] Mensagem de erro em português.
        pt-BR: "Informe o código de autorização"
        // REVIEW [2026-12-15] Mensagem de erro em inglês.
        en: "Enter the authorization code"
      }
      {
        // REVIEW [2026-12-15] Grava o código de autorização no documento.
        authorizationCode = authorization
      }
    }

    // REVIEW [2026-12-15] Troca a forma de pagamento para uma nova tentativa.
    retryPayment(method: PaymentMethod) {
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Trocar forma de pagamento", en: "Change payment method" }
      // REVIEW [2026-12-15] Papéis autorizados a trocar a forma de pagamento.
      roles: [Customer]
      {
        // REVIEW [2026-12-15] Atualiza a forma de pagamento escolhida.
        paymentMethod = method
      }
    }

    // REVIEW [2026-12-15] Abandona a compra, encerrando a sessão.
    abandon(reason: string) {
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Abandonar compra", en: "Abandon purchase" }
      // REVIEW [2026-12-15] Papéis autorizados a abandonar a sessão.
      roles: [Customer, SupportAgent, SessionEngine]

      // REVIEW [2026-12-15] Move a sessão para o estado Abandoned.
      to: status.Abandoned

      // REVIEW [2026-12-15] Regra de negócio: exige um motivo suficientemente descritivo.
      rule reason.length >= 10 {
        // REVIEW [2026-12-15] Mensagem de erro em português.
        pt-BR: "Informe um motivo com pelo menos 10 caracteres"
        // REVIEW [2026-12-15] Mensagem de erro em inglês.
        en: "Enter a reason with at least 10 characters"
      }
    }

    // REVIEW [2026-12-15] Confirma a compra após a autorização do pagamento.
    confirmOrder() {
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Confirmar compra", en: "Confirm purchase" }
      // REVIEW [2026-12-15] Papéis autorizados a confirmar a compra.
      roles: [SessionEngine]

      // REVIEW [2026-12-15] Move a sessão para o estado Confirmed.
      to: status.Confirmed
      {
        // REVIEW [2026-12-15] Registra o instante da confirmação.
        confirmedAt = now()
      }
    }
  }

  // REVIEW [2026-12-15] Invariante: toda sessão confirmada precisa ter data de confirmação.
  rule status == Confirmed implies confirmedAt != null {
    // REVIEW [2026-12-15] Mensagem de erro em português.
    pt-BR: "Informe a data de confirmação"
    // REVIEW [2026-12-15] Mensagem de erro em inglês.
    en: "Enter the confirmation date"
  }
}

// REVIEW [2026-12-15] Forma de estado que modela o ciclo de vida da sessão.
shape CheckoutStatus {
  // REVIEW [2026-12-15] Título exibido onde a forma aparece.
  title: { pt-BR: "Situação da finalização", en: "Checkout status" }
  // REVIEW [2026-12-15] Base "state": os valores são estados com transições.
  base: state
  // REVIEW [2026-12-15] Estado em que toda sessão começa.
  initial: Draft

  // REVIEW [2026-12-15] Estado inicial: carrinho ainda não validado.
  value Draft {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Rascunho", en: "Draft" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Draft
    // REVIEW [2026-12-15] Ordem do estado nas listas e no funil.
    ordinal: 10

    // REVIEW [2026-12-15] Transição disparada quando o carrinho é validado.
    transition Validated {
      // REVIEW [2026-12-15] Evento que provoca a transição.
      event: CartValidated
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Carrinho validado", en: "Cart validated" }
      // REVIEW [2026-12-15] Dados que acompanham o evento.
      payload {
        // REVIEW [2026-12-15] Cliente que validou o carrinho.
        customer: User { title: { pt-BR: "Cliente", en: "Customer" } }
        // REVIEW [2026-12-15] Total do pedido no momento da validação.
        total: std.Money { title: { pt-BR: "Total", en: "Total" } }
      }
    }

    // REVIEW [2026-12-15] Transição que abandona a compra a partir do rascunho.
    transition Abandoned {
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Compra abandonada", en: "Purchase abandoned" }
      // REVIEW [2026-12-15] Dados que acompanham o evento.
      payload {
        // REVIEW [2026-12-15] Motivo informado para o abandono.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado com o carrinho validado, à espera do frete.
  value Validated {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Carrinho validado", en: "Cart validated" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Validated
    // REVIEW [2026-12-15] Ordem do estado nas listas e no funil.
    ordinal: 20

    // REVIEW [2026-12-15] Transição disparada após o registro do frete.
    transition ShippingQuoted {
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Frete cotado", en: "Shipping quoted" }
      // REVIEW [2026-12-15] Dados que acompanham o evento.
      payload {
        // REVIEW [2026-12-15] Valor do frete registrado.
        freight: std.Money { title: { pt-BR: "Frete", en: "Freight" } }
        // REVIEW [2026-12-15] Prazo de entrega registrado.
        deliveryDays: std.Count { title: { pt-BR: "Prazo", en: "Days" } }
      }
    }

    // REVIEW [2026-12-15] Transição que abandona a compra depois da validação.
    transition Abandoned {
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Compra abandonada", en: "Purchase abandoned" }
      // REVIEW [2026-12-15] Dados que acompanham o evento.
      payload {
        // REVIEW [2026-12-15] Motivo informado para o abandono.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado com o frete cotado, à espera do pagamento.
  value ShippingQuoted {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Frete cotado", en: "Shipping quoted" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: ShippingQuoted
    // REVIEW [2026-12-15] Ordem do estado nas listas e no funil.
    ordinal: 30

    // REVIEW [2026-12-15] Transição disparada após a autorização do pagamento.
    transition PaymentAuthorized {
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Pagamento autorizado", en: "Payment authorized" }
      // REVIEW [2026-12-15] Dados que acompanham o evento.
      payload {
        // REVIEW [2026-12-15] Código devolvido pelo gateway.
        authorizationCode: string { title: { pt-BR: "Autorização", en: "Authorization" } }
      }
    }

    // REVIEW [2026-12-15] Transição que abandona a compra depois da cotação do frete.
    transition Abandoned {
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Compra abandonada", en: "Purchase abandoned" }
      // REVIEW [2026-12-15] Dados que acompanham o evento.
      payload {
        // REVIEW [2026-12-15] Motivo informado para o abandono.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado com o pagamento autorizado, à espera da confirmação.
  value PaymentAuthorized {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Pagamento autorizado", en: "Payment authorized" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: PaymentAuthorized
    // REVIEW [2026-12-15] Ordem do estado nas listas e no funil.
    ordinal: 40

    // REVIEW [2026-12-15] Transição que abandona a compra mesmo após a autorização.
    transition Abandoned {
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Compra abandonada", en: "Purchase abandoned" }
      // REVIEW [2026-12-15] Dados que acompanham o evento.
      payload {
        // REVIEW [2026-12-15] Motivo informado para o abandono.
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }

    // REVIEW [2026-12-15] Transição que confirma a compra.
    transition Confirmed {
      // REVIEW [2026-12-15] Título exibido na interface.
      title: { pt-BR: "Compra confirmada", en: "Purchase confirmed" }
      // REVIEW [2026-12-15] Dados que acompanham o evento.
      payload {
        // REVIEW [2026-12-15] Instante em que a compra foi confirmada.
        confirmedAt: DateTime { title: { pt-BR: "Confirmada em", en: "Confirmed at" } }
      }
    }
  }
  // REVIEW [2026-12-15] Estado final de sucesso.
  value Confirmed {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Pedido confirmado", en: "Order confirmed" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Confirmed
    // REVIEW [2026-12-15] Ordem do estado nas listas e no funil.
    ordinal: 50
  }
  // REVIEW [2026-12-15] Estado final de abandono.
  value Abandoned {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Abandonada", en: "Abandoned" }
    // REVIEW [2026-12-15] Ícone associado ao estado.
    icon: Abandoned
    // REVIEW [2026-12-15] Ordem do estado nas listas e no funil.
    ordinal: 60
  }

  // REVIEW [2026-12-15] Formato de exibição simples, sem máscara.
  format: plain
}

// REVIEW [2026-12-15] Forma de classificação com as formas de pagamento aceitas.
shape PaymentMethod {
  // REVIEW [2026-12-15] Título exibido onde a forma aparece.
  title: { pt-BR: "Método de pagamento", en: "Payment method" }
  // REVIEW [2026-12-15] Base "classification": valores sem transições, usados como categoria.
  base: classification

  // REVIEW [2026-12-15] Pagamento por cartão de crédito.
  value CreditCard {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Cartão de crédito", en: "Credit card" }
    // REVIEW [2026-12-15] Ícone associado à forma de pagamento.
    icon: CreditCard
    // REVIEW [2026-12-15] Ordem da opção nas listas.
    ordinal: 10
  }
  // REVIEW [2026-12-15] Pagamento por Pix.
  value Pix {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Pix", en: "Pix" }
    // REVIEW [2026-12-15] Ícone associado à forma de pagamento.
    icon: Pix
    // REVIEW [2026-12-15] Ordem da opção nas listas.
    ordinal: 20
  }
  // REVIEW [2026-12-15] Pagamento por boleto.
  value Boleto {
    // REVIEW [2026-12-15] Título exibido na interface.
    title: { pt-BR: "Boleto", en: "Boleto" }
    // REVIEW [2026-12-15] Ícone associado à forma de pagamento.
    icon: Boleto
    // REVIEW [2026-12-15] Ordem da opção nas listas.
    ordinal: 30
  }

  // REVIEW [2026-12-15] Formato de exibição simples, sem máscara.
  format: plain
}
