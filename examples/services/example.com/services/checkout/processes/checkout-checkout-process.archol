// REVIEW [2026-12-15] service: example.com/services/checkout
// REVIEW [2026-12-15] Process: sintaxe atual documentada em DSL_REFERENCE.md §4.

// REVIEW [2026-12-15] Declara o processo Checkout; o argumento é o documento-sujeito da instância.
process Checkout(session: CheckoutSession) {
  // REVIEW [2026-12-15] Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Finalização da compra", en: "Checkout" }
  // REVIEW [2026-12-15] Versão do artefato Process; diff e release comparam.
  // REVIEW [2026-12-15] Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // REVIEW [2026-12-15] Texto do objetivo em português.
    pt-BR: "Cotar o frete, autorizar o pagamento e confirmar a compra"
  }
  // REVIEW [2026-12-15] SLA brando do caso: alvo de lead time, não é timer.
  sla: 1d

  // REVIEW [2026-12-15] Gatilho: inicia uma instância quando o documento emite CartValidated.
  on [CheckoutSession.CartValidated]
  // REVIEW [2026-12-15] Chave de identidade, correlação e dedup da instância.
  key: session // REVIEW [2026-12-15] o caso é a própria CheckoutSession

  // REVIEW [2026-12-15] Variável durável da instância: oferta de frete; começa nula.
  let offer: FreightOffer | null = null
  // REVIEW [2026-12-15] Flag durável que registra se o pagamento foi autorizado.
  let authorized = false
  // REVIEW [2026-12-15] Código de autorização devolvido pelo gateway de pagamento.
  let authorization: string

  // REVIEW [2026-12-15] Bloco externo: captura timeout do caso e de qualquer form.
  try {
    // REVIEW [2026-12-15] Bloco interno: tenta cotar o frete automaticamente.
    try {
      // REVIEW [2026-12-15] Chama a integração de frete e guarda a oferta retornada.
      offer = FreightGateway.quote({ session })
    // REVIEW [2026-12-15] Captura a indisponibilidade da cotação para abrir o form manual.
    } catch (Unavailable) {
      // REVIEW [2026-12-15] Se a cotação falhar, o suporte informa o frete manualmente pelo form.
      FreightReview.show({ session })
    }

    // REVIEW [2026-12-15] Só registra o frete automático quando a cotação produziu uma oferta.
    if (offer != null) {
      // REVIEW [2026-12-15] Persiste frete e prazo no documento; a action dispara a transição.
      CheckoutSession.quoteShipping({
        // REVIEW [2026-12-15] Valor do frete cotado.
        freightAmount: offer.freight,
        // REVIEW [2026-12-15] Prazo de entrega em dias.
        days: offer.days
      })
    }

    // REVIEW [2026-12-15] Laço de tentativas de pagamento, limitado a três iterações.
    loop PaymentAttempt max 3 {
      // REVIEW [2026-12-15] Tenta autorizar o pagamento a cada iteração.
      try {
        // REVIEW [2026-12-15] Chama o gateway e guarda o código de autorização.
        authorization = PaymentGateway.authorize({
          // REVIEW [2026-12-15] Total do pedido a autorizar.
          total: session.total,
          // REVIEW [2026-12-15] Forma de pagamento escolhida pelo cliente.
          method: session.paymentMethod
        })

        // REVIEW [2026-12-15] Registra a autorização no documento.
        CheckoutSession.authorizePayment({ authorization })
        // REVIEW [2026-12-15] Marca que a autorização ocorreu.
        authorized = true
        // REVIEW [2026-12-15] Sai do laço de tentativas.
        break
      // REVIEW [2026-12-15] Captura a recusa do pagamento para oferecer nova tentativa.
      } catch (Declined) {
        // REVIEW [2026-12-15] Pagamento recusado: abre o form para tentar de novo ou desistir.
        PaymentRetry.show({ session })

        // REVIEW [2026-12-15] Se o cliente desistiu, o documento foi abandonado.
        if (session.status == Abandoned) {
          // REVIEW [2026-12-15] Encerra o processo no desfecho Abandoned.
          return Abandoned
        }
      }
    }

    // REVIEW [2026-12-15] Se as três tentativas terminaram sem autorização...
    if (!authorized) {
      // REVIEW [2026-12-15] ...abandona a sessão com um motivo legível.
      CheckoutSession.abandon({ reason: "Tentativas de pagamento esgotadas" })
      // REVIEW [2026-12-15] ...e encerra no desfecho Expired.
      return Expired
    }

    // REVIEW [2026-12-15] Confirma a compra no documento.
    CheckoutSession.confirmOrder()
    // REVIEW [2026-12-15] Encerra no desfecho de sucesso.
    return Confirmed
  // REVIEW [2026-12-15] Captura o estouro de prazo do caso ou de um form.
  } catch (Timeout) {
    // REVIEW [2026-12-15] Timeout de form ou do caso: abandona a sessão e encerra em Expired.
    CheckoutSession.abandon({ reason: "Prazo de finalização esgotado sem conclusão" })
    // REVIEW [2026-12-15] Retorna o desfecho de falha.
    return Expired
  }

  // REVIEW [2026-12-15] Declara o desfecho de sucesso do caso.
  end Confirmed {
    // REVIEW [2026-12-15] Título exibido no histórico e nos filtros.
    title: { pt-BR: "Compra confirmada", en: "Purchase confirmed" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: success
  }
  // REVIEW [2026-12-15] Declara o desfecho de cancelamento do caso.
  end Abandoned {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Compra abandonada", en: "Purchase abandoned" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: cancelled
  }
  // REVIEW [2026-12-15] Declara o desfecho de falha do caso.
  end Expired {
    // REVIEW [2026-12-15] Título exibido no histórico.
    title: { pt-BR: "Expirada", en: "Expired" }
    // REVIEW [2026-12-15] Classificação do desfecho para KPI.
    outcome: failure
  }
}

// REVIEW [2026-12-15] Erro de negócio: frete indisponível.
error Unavailable {
  // REVIEW [2026-12-15] Título do erro exibido ao usuário.
  title: { pt-BR: "Frete indisponível", en: "Freight unavailable" }
}

// REVIEW [2026-12-15] Erro de negócio: pagamento recusado.
error Declined {
  // REVIEW [2026-12-15] Título do erro exibido ao usuário.
  title: { pt-BR: "Pagamento recusado", en: "Payment declined" }
}

// REVIEW [2026-12-15] Erro reservado de prazo.
error Timeout {
  // REVIEW [2026-12-15] Título do erro exibido ao usuário.
  title: { pt-BR: "Prazo esgotado", en: "Timed out" }
}
