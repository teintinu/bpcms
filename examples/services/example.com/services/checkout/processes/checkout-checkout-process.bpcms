// service: example.com/services/checkout
// Process: sintaxe atual documentada em DSL_REFERENCE.md §4.

// Declara o processo Checkout; o argumento é o documento-sujeito da instância.
process Checkout(session: CheckoutSession) {
  // Título exibido no builder, na inbox e no histórico.
  title: { pt-BR: "Finalização da compra", en: "Checkout" }
  // Versão do artefato Process; diff e release comparam.
  version: 1
  // Objetivo de negócio usado na revisão e no painel do processo.
  goal: {
    // Texto do objetivo em português.
    pt-BR: "Cotar o frete, autorizar o pagamento e confirmar a compra"
  }
  // SLA brando do caso: alvo de lead time, não é timer.
  sla: 1d

  // Gatilho: inicia uma instância quando o documento emite CartValidated.
  on [CheckoutSession.CartValidated]
  // Chave de identidade, correlação e dedup da instância.
  key: session // o caso é a própria CheckoutSession

  // Variável durável da instância: oferta de frete; começa nula.
  let offer: FreightOffer | null = null
  // Flag durável que registra se o pagamento foi autorizado.
  let authorized = false
  // Código de autorização devolvido pelo gateway de pagamento.
  let authorization: string

  // Bloco externo: captura timeout do caso e de qualquer form.
  try {
    // Bloco interno: tenta cotar o frete automaticamente.
    try {
      // Chama a integração de frete e guarda a oferta retornada.
      offer = FreightGateway.quote({ session })
    // Captura a indisponibilidade da cotação para abrir o form manual.
    } catch (Unavailable) {
      // Se a cotação falhar, o suporte informa o frete manualmente pelo form.
      FreightReview.show({ session })
    }

    // Só registra o frete automático quando a cotação produziu uma oferta.
    if (offer != null) {
      // Persiste frete e prazo no documento; a action dispara a transição.
      CheckoutSession.quoteShipping({
        // Valor do frete cotado.
        freightAmount: offer.freight,
        // Prazo de entrega em dias.
        days: offer.days
      })
    }

    // Laço de tentativas de pagamento, limitado a três iterações.
    loop PaymentAttempt max 3 {
      // Tenta autorizar o pagamento a cada iteração.
      try {
        // Chama o gateway e guarda o código de autorização.
        authorization = PaymentGateway.authorize({
          // Total do pedido a autorizar.
          total: session.total,
          // Forma de pagamento escolhida pelo cliente.
          method: session.paymentMethod
        })

        // Registra a autorização no documento.
        CheckoutSession.authorizePayment({ authorization })
        // Marca que a autorização ocorreu.
        authorized = true
        // Sai do laço de tentativas.
        break
      // Captura a recusa do pagamento para oferecer nova tentativa.
      } catch (Declined) {
        // Pagamento recusado: abre o form para tentar de novo ou desistir.
        PaymentRetry.show({ session })

        // Se o cliente desistiu, o documento foi abandonado.
        if (session.status == Abandoned) {
          // Encerra o processo no desfecho Abandoned.
          return Abandoned
        }
      }
    }

    // Se as três tentativas terminaram sem autorização...
    if (!authorized) {
      // ...abandona a sessão com um motivo legível.
      CheckoutSession.abandon({ reason: "Tentativas de pagamento esgotadas" })
      // ...e encerra no desfecho Expired.
      return Expired
    }

    // Confirma a compra no documento.
    CheckoutSession.confirmOrder()
    // Encerra no desfecho de sucesso.
    return Confirmed
  // Captura o estouro de prazo do caso ou de um form.
  } catch (Timeout) {
    // Timeout de form ou do caso: abandona a sessão e encerra em Expired.
    CheckoutSession.abandon({ reason: "Prazo de finalização esgotado sem conclusão" })
    // Retorna o desfecho de falha.
    return Expired
  }

  // Declara o desfecho de sucesso do caso.
  end Confirmed {
    // Título exibido no histórico e nos filtros.
    title: { pt-BR: "Compra confirmada", en: "Purchase confirmed" }
    // Classificação do desfecho para KPI.
    outcome: success
  }
  // Declara o desfecho de cancelamento do caso.
  end Abandoned {
    // Título exibido no histórico.
    title: { pt-BR: "Compra abandonada", en: "Purchase abandoned" }
    // Classificação do desfecho para KPI.
    outcome: cancelled
  }
  // Declara o desfecho de falha do caso.
  end Expired {
    // Título exibido no histórico.
    title: { pt-BR: "Expirada", en: "Expired" }
    // Classificação do desfecho para KPI.
    outcome: failure
  }
}

// Erro de negócio: frete indisponível.
error Unavailable {
  // Título do erro exibido ao usuário.
  title: { pt-BR: "Frete indisponível", en: "Freight unavailable" }
}

// Erro de negócio: pagamento recusado.
error Declined {
  // Título do erro exibido ao usuário.
  title: { pt-BR: "Pagamento recusado", en: "Payment declined" }
}

// Erro reservado de prazo.
error Timeout {
  // Título do erro exibido ao usuário.
  title: { pt-BR: "Prazo esgotado", en: "Timed out" }
}

// View de andamento derivada da instância do processo.
view CheckoutProgress {
  // Título exibido na navegação.
  title: { pt-BR: "Andamento da finalização", en: "Checkout progress" }
  // Tipo da view: uma tela de andamento de processo.
  type: process
  // Processo cujo andamento esta view exibe.
  process: Checkout
  // Papéis que podem abrir a view.
  roles: [SupportAgent, Customer]

  // Seções fixas exibidas na tela de andamento.
  sections { current; participants; history; deadlines; documents; next }
}
