// REVIEW [2026-12-15] service: example.com/services/checkout

// REVIEW [2026-12-15] Integração com o gateway de frete, usada para cotar a entrega.
integration FreightGateway {
  // REVIEW [2026-12-15] Protocolo de transporte da integração.
  protocol: rest
  // REVIEW [2026-12-15] URL base lida da variável de ambiente FREIGHT_URL.
  baseUrl: env.FREIGHT_URL
  // REVIEW [2026-12-15] Autenticação por chave de API.
  auth: api-key
  // REVIEW [2026-12-15] Tempo máximo de espera por resposta.
  timeout: 10s
  // REVIEW [2026-12-15] Envia cabeçalho de idempotência para evitar cotação duplicada.
  idempotency: header "Idempotency-Key"

  // REVIEW [2026-12-15] Operações expostas pela integração.
  operations {
    // REVIEW [2026-12-15] Cota o frete de uma sessão e devolve a oferta.
    quote(session: CheckoutSession): FreightOffer
  }
}

// REVIEW [2026-12-15] Integração com o gateway de pagamento, usada para autorizar a compra.
integration PaymentGateway {
  // REVIEW [2026-12-15] Protocolo de transporte da integração.
  protocol: rest
  // REVIEW [2026-12-15] URL base lida da variável de ambiente PAYMENT_URL.
  baseUrl: env.PAYMENT_URL
  // REVIEW [2026-12-15] Autenticação via OAuth2.
  auth: oauth2
  // REVIEW [2026-12-15] Tempo máximo de espera por resposta.
  timeout: 15s
  // REVIEW [2026-12-15] Envia cabeçalho de idempotência para não autorizar duas vezes.
  idempotency: header "Idempotency-Key"

  // REVIEW [2026-12-15] Operações expostas pela integração.
  operations {
    // REVIEW [2026-12-15] Autoriza o total na forma de pagamento e devolve o código.
    authorize(total: std.Money, method: PaymentMethod): string
  }
}
