// REVIEW [2026-12-15] service: example.com/services/checkout

// REVIEW [2026-12-15] Forma reutilizável que descreve a oferta de frete devolvida pela cotação.
shape FreightOffer {
  // REVIEW [2026-12-15] Título exibido onde a forma aparece.
  title: { pt-BR: "Oferta de frete", en: "Freight offer" }

  // REVIEW [2026-12-15] Campos que compõem a oferta de frete.
  fields {
    // REVIEW [2026-12-15] Nome da transportadora responsável pela entrega.
    carrier: string { title: { pt-BR: "Transportadora", en: "Carrier" } }
    // REVIEW [2026-12-15] Valor do frete; usa o tipo monetário padrão importado de std.
    freight: std.Money { title: { pt-BR: "Frete", en: "Freight" } }
    // REVIEW [2026-12-15] Prazo estimado de entrega, contado em dias.
    days: std.Count { title: { pt-BR: "Prazo em dias", en: "Days" } }
  }
}
