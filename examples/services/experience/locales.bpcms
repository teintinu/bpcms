// service: example.com/services/experience
locale pt-BR {
  fallback: en-US
  currency: BRL
  units: metric
  date: "dd/MM/yyyy"
  time: "HH:mm"
  direction: ltr
  decimal: ","
  thousands: "."
  messages: "locales/pt-BR.json"
}

locale en-US {
  currency: USD
  units: imperial
  date: "MM/dd/yyyy"
  time: "h:mm a"
  direction: ltr
  decimal: "."
  thousands: ","
  messages: "locales/en-US.json"
}
