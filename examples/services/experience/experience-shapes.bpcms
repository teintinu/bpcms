// service: example.com/services/experience
shape MoneyBRL {
  title: { pt-BR: "Dinheiro (BRL)", en: "Money (BRL)" }
  base: decimal
  currency: BRL
  scale: 2
  parse: locale-number
  format: currency
  compare: exact
  aggregate: sum
}

shape Mass {
  title: { pt-BR: "Massa", en: "Mass" }
  base: decimal
  dimension: mass
  unit: kg
  displayUnits: [kg, g, t, lb, oz]
  precision: 6
  min: 0
  parse: quantity
  convert: units.mass
  index: normalized
  aggregate: sum
}

shape Length {
  title: { pt-BR: "Comprimento", en: "Length" }
  base: decimal
  dimension: length
  unit: cm
  displayUnits: [cm, m, km, in, ft, yd, mi]
  precision: 3
  min: 0
  parse: quantity
  convert: units.length
  index: normalized
}

shape Volume {
  title: { pt-BR: "Volume", en: "Volume" }
  base: decimal
  dimension: volume
  unit: m3
  displayUnits: [m3, L, cm3, gal]
  precision: 6
  min: 0
  parse: quantity
  convert: units.volume
  index: normalized
}

shape Count {
  title: { pt-BR: "Contagem", en: "Count" }
  base: integer
  min: 0
  precision: 0
  format: plain
  aggregate: sum
}

shape Percentage {
  title: { pt-BR: "Percentual", en: "Percentage" }
  base: decimal
  dimension: ratio
  unit: "%"
  min: 0
  max: 100
  scale: 2
  parse: percent
  format: percent
  aggregate: weighted-average
}

shape CurrencyCode {
  title: { pt-BR: "Código de moeda", en: "Currency code" }
  base: text
  values {
    BRL {
      title: { pt-BR: "Real", en: "Brazilian real" }
      icon: Brl
    }
    USD {
      title: { pt-BR: "Dólar", en: "US dollar" }
      icon: Usd
    }
    EUR {
      title: { pt-BR: "Euro", en: "Euro" }
      icon: Eur
    }
  }
  format: plain
}

shape YearMonth {
  title: { pt-BR: "Ano/mês", en: "Year-month" }
  base: text
  validate: year-month
  format: plain
}

shape Email {
  title: { pt-BR: "E-mail", en: "Email" }
  base: text
  normalize: lower-trim
  validate: email
  maxLength: 254
  format: plain
  index: exact
}

shape LocaleTag {
  title: { pt-BR: "Idioma", en: "Locale" }
  base: text
  values {
    pt-BR {
      title: { pt-BR: "Português (Brasil)", en: "Portuguese (Brazil)" }
      icon: LocalePtBr
    }
    en-US {
      title: { pt-BR: "Inglês (EUA)", en: "English (US)" }
      icon: LocaleEnUs
    }
  }
  format: plain
}

shape Phone {
  title: { pt-BR: "Telefone", en: "Phone" }
  base: text
  normalize: digits
  validate: phone
  maxLength: 20
  format: masked("+## (##) #####-####")
}

shape Image {
  title: { pt-BR: "Imagem", en: "Image" }
  base: text
  validate: url
  format: image
  maxLength: 2048
}
