// service: example.com/services/support
event TicketOpened {
  version: 1
  payload {
    ticketId: TicketId
    customerId: CustomerId
    priority: TicketPriority
    openedAt: DateTime
  }
  producer: Ticket
  consumers: [Notifications]
  key: ticketId
}

event ReturnRequested {
  version: 1
  payload {
    returnId: ReturnId
    orderId: OrderId
    requestedAt: DateTime
  }
  producer: ReturnRequest
  consumers: [Payments, Shipping, Notifications]
  key: returnId
}

event ReturnApproved {
  version: 1
  payload {
    returnId: ReturnId
    orderId: OrderId
    refundAmount: MoneyBRL
    approvedAt: DateTime
  }
  producer: ReturnRequest
  consumers: [Payments, Billing, Notifications]
  key: returnId
}
