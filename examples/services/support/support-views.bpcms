// service: example.com/services/support

view TicketKanban {
  title: { pt-BR: "Quadro de chamados", en: "Ticket kanban" }
  type: kanban
  source: Ticket
  roles: [SupportAgent, Manager]
  groupBy: status

  columns { subject; priority; slaDue }
  card { subject; priority; slaDue; assignee }
  filter { status != Closed }
  actions {
    open -> TicketDetail
    claim -> Ticket.claim
  }
}

view TicketDetail {
  title: { pt-BR: "Detalhe do chamado", en: "Ticket detail" }
  type: detail
  document: Ticket
  roles: [SupportAgent, Manager]

  sections { summary; timeline }
  computed { breached; remaining }
  actions {
    resolve -> Ticket.resolve
    escalate -> Ticket.escalate(justification)
  }
}

view TicketQueue {
  title: { pt-BR: "Fila de atendimento", en: "Ticket queue" }
  type: inbox
  roles: [SupportAgent, Manager]
  scope: lanes
  groupBy: lane
  filter { lane in currentUser.lanes }
  columns { title; subject; lane; dueAt; priority }
}

view ReturnRequests {
  title: { pt-BR: "Solicitações de devolução", en: "Return requests" }
  type: table
  source: ReturnRequest
  roles: [SupportAgent, Manager]

  columns { order; status; refundAmount; requestedAt }
  filters { status; period }
  pagination: 50
  actions {
    open -> RefundCaseProgress
  }
}

view TicketTriageProgress {
  title: { pt-BR: "Andamento da triagem", en: "Ticket triage progress" }
  type: process
  process: TicketTriage
  roles: [SupportAgent, Manager]

  sections { current; participants; history; deadlines; documents; next }
}

view RefundCaseProgress {
  title: { pt-BR: "Andamento da devolução", en: "Refund case progress" }
  type: process
  process: RefundCase
  roles: [SupportAgent, Manager, Customer]

  sections { current; participants; history; deadlines; documents; milestones; next }
}
