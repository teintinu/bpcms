// service: example.com/services/support
view TicketKanban {
  title: { pt-BR: "Kanban de chamados", en: "Ticket kanban" }
  type: kanban
  source: Ticket
  roles: [SupportAgent, Manager]
  groupBy: status

  columns { open; in_progress; waiting; resolved }
  card { subject; priority; slaDue; assignee }
  filter { assignee = currentUser }
  actions {
    move -> Ticket.assign
    resolve -> Ticket.resolve
  }
}

view ReturnForm {
  title: { pt-BR: "Formulário de devolução", en: "Return form" }
  type: form
  document: ReturnRequest
  roles: [SupportAgent, Manager]

  fields {
    orderId: OrderId { title: { pt-BR: "Pedido", en: "Order" }, required }
    paymentId: PaymentId { title: { pt-BR: "Pagamento", en: "Payment" } }
    shipmentId: ShipmentId { title: { pt-BR: "Remessa", en: "Shipment" } }
    reason: string { title: { pt-BR: "Motivo", en: "Reason" }, required }
    refundAmount: std.Money { title: { pt-BR: "Valor do reembolso", en: "Refund amount" }, currency: BRL }
  }

  actions {
    save -> ReturnRequest.request
    approve -> ReturnRequest.approve
    reject -> ReturnRequest.reject
  }
}
