// service: example.com/services/support
view TicketKanban {
  type: kanban
  source: Ticket
  roles: [SupportAgent, Manager]
  groupBy: status

  columns { open; in_progress; waiting; resolved }
  card { subject; priority; slaDue; assignee }
  filter { assignee = currentUser }
  actions {
    move -> Ticket.assign
    resolve -> Ticket.resolve
  }
}

view ReturnForm {
  type: form
  document: ReturnRequest
  roles: [SupportAgent, Manager]

  fields {
    orderId: OrderId { required: true }
    paymentId: PaymentId?
    shipmentId: ShipmentId?
    reason: Text { required: true }
    refundAmount: MoneyBRL
  }

  actions {
    save -> ReturnRequest.request
    approve -> ReturnRequest.approve
    reject -> ReturnRequest.reject
  }
}
