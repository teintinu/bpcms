// service: example.com/services/support
document Ticket {
  title: { pt-BR: "Chamado", en: "Ticket" }
  version: 1
  owner: "Support"
  sync: live
  audit: true

  fields {
    customerId: UserId { title: { pt-BR: "Cliente", en: "Customer" } }
    orderId: OrderId? { title: { pt-BR: "Pedido", en: "Order" } }
    subject: string { title: { pt-BR: "Assunto", en: "Subject" }, maxLength: 160, lookup }
    description: string { title: { pt-BR: "Descrição", en: "Description" } }
    priority: TicketPriority { title: { pt-BR: "Prioridade", en: "Priority" }, lookup }
    status: TicketStatus { title: { pt-BR: "Status", en: "Status" }, lookup }
    assignee: UserId? { title: { pt-BR: "Responsável", en: "Assignee" } }
    slaDue: DateTime { title: { pt-BR: "SLA até", en: "SLA due" } }
    resolutionTime: std.Duration? { title: { pt-BR: "Tempo de resolução", en: "Resolution time" } }
    slaMet: boolean? { title: { pt-BR: "SLA cumprido", en: "SLA met" } }
    createdAt: DateTime { title: { pt-BR: "Criado em", en: "Created at" } }
  }

  computed SlaBreach from Ticket {
    freshness: 1m
    exposes: [breached, remaining]
  }

  indexes {
    byStatus: [status, priority, slaDue] range
    byAssignee: [assignee] hash
    search: [subject, description] search
  }

  actions {
    assign(user: UserId): Ticket
    comment(body: string): Ticket
    resolve(): Ticket
    reopen(reason: string): Ticket
    escalateBreached(): void
  }

  rules {
    status == resolved implies assignee != null
  }
}

document ReturnRequest {
  title: { pt-BR: "Solicitação de devolução", en: "Return request" }
  version: 1
  owner: "Support"
  sync: live
  audit: true

  fields {
    orderId: OrderId { title: { pt-BR: "Pedido", en: "Order" }, lookup }
    paymentId: PaymentId? { title: { pt-BR: "Pagamento", en: "Payment" } }
    shipmentId: ShipmentId? { title: { pt-BR: "Remessa", en: "Shipment" } }
    reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
    status: ReturnStatus { title: { pt-BR: "Status", en: "Status" }, lookup }
    refundAmount: MoneyBRL { title: { pt-BR: "Valor do reembolso", en: "Refund amount" }, lookup }
    requestedAt: DateTime { title: { pt-BR: "Solicitado em", en: "Requested at" } }
  }

  indexes {
    byOrder: [orderId] hash
    byStatus: [status, requestedAt] range
  }

  actions {
    request(reason: string): ReturnRequest
    approve(): ReturnRequest
    reject(reason: string): ReturnRequest
    refund(): ReturnRequest
  }

  rules {
    refundAmount >= 0
    status == approved implies refundAmount > 0
  }
}
