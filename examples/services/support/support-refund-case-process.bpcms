// service: example.com/services/support

process RefundCase for ReturnRequest {
  title: { pt-BR: "Caso de devolução", en: "Refund case" }
  version: 1
  goal: "Decidir a elegibilidade, aprovar por alçada e reembolsar o cliente"
  owner: "Support"
  timezone: America/Fortaleza
  sla: 5d

  pool Company {
    internal

    lane Support {
      role: SupportAgent
    }

    lane Finance {
      role: Manager
    }
  }

  pool Customer {
    external

    lane Client {
      role: Customer
    }
  }

  variables {
    verdict: RefundVerdict
  }

  start Requested {
    event: ReturnRequest.Requested
  }

  task Review {
    lane: Support
    form: RefundReview
    sla: 4h
    assign: pull
    on breach -> Escalate
  }

  task Eligibility {
    lane: System
    decision: RefundEligibility
    with {
      amount: returnRequest.refundAmount
      orderAgeDays: order.ageDays
    }
    gives: verdict
  }

  gateway Vote {
    if verdict == Eligible -> AutoApprove
    if verdict == ApprovalRequired -> ManagerApprove
    else -> RejectCase
  }

  task AutoApprove {
    lane: System
    action: ReturnRequest.approve
  }

  task ManagerApprove {
    lane: Finance
    form: RefundApproval
    sla: 2d
    assign: pull
  }

  task RejectCase {
    lane: Finance
    form: RefundRejection
    sla: 3d
    assign: pull
  }

  task Receive {
    lane: System
    action: ReturnRequest.receive
  }

  task Settle {
    lane: System
    action: Payment.refund
    with {
      payment: returnRequest.payment
    }
  }

  task Refund {
    lane: System
    action: ReturnRequest.refund
  }

  task NotifyCustomer {
    lane: System
    sends: RefundDecision
    partner: Customer
    with {
      verdict
      amount: returnRequest.refundAmount
    }
  }

  task Escalate {
    lane: Finance
    form: RefundApproval
    sla: 1d
    assign: pull
  }

  milestone Decided {
    title: { pt-BR: "Decisão registrada", en: "Decision recorded" }
    on: ReturnRequest.Approved
  }

  rollback Undo

  end Refunded {
    title: { pt-BR: "Devolução reembolsada", en: "Return refunded" }
    outcome: success
  }

  end Rejected {
    title: { pt-BR: "Devolução recusada", en: "Return rejected" }
    outcome: failure
  }

  end Cancelled {
    title: { pt-BR: "Devolução cancelada", en: "Return cancelled" }
    outcome: cancelled
  }

  Requested -> Review
  Review.confirm -> Eligibility
  Eligibility -> Vote
  Vote -> AutoApprove
  Vote -> ManagerApprove
  Vote -> RejectCase
  AutoApprove -> Receive
  ManagerApprove.approve -> Receive
  ManagerApprove.reject -> Rejected
  Escalate.approve -> Receive
  Escalate.reject -> Rejected
  RejectCase.reject -> Rejected
  Receive -> Settle
  Settle -> Refund
  Refund -> NotifyCustomer
  NotifyCustomer -> Refunded
  Undo -> Cancelled

  cancel on ReturnRequest.Cancelled -> Undo
  on breach -> Escalate
}

shape RefundVerdict {
  title: { pt-BR: "Parecer da devolução", en: "Refund verdict" }
  base: classification
  value Eligible {
    title: { pt-BR: "Elegível", en: "Eligible" }
    icon: Eligible
    ordinal: 10
  }
  value ApprovalRequired {
    title: { pt-BR: "Exige aprovação", en: "Approval required" }
    icon: ApprovalRequired
    ordinal: 20
  }
  value NotEligible {
    title: { pt-BR: "Não elegível", en: "Not eligible" }
    icon: NotEligible
    ordinal: 30
  }
  format: plain
}

form RefundReview {
  title: { pt-BR: "Conferência da devolução", en: "Refund review" }
  document: ReturnRequest

  fields {
    order
    payment
    shipment
    reason
    refundAmount
  }

  actions {
    confirm { calls: ReturnRequest.review }
  }
}

form RefundApproval {
  title: { pt-BR: "Aprovação da devolução", en: "Refund approval" }
  document: ReturnRequest

  fields {
    order
    refundAmount
    justification: string {
      title: { pt-BR: "Motivo da rejeição", en: "Rejection reason" }
    }
  }

  actions {
    approve { calls: ReturnRequest.approve }
    reject { calls: ReturnRequest.reject(justification) }
  }
}

form RefundRejection {
  title: { pt-BR: "Recusa da devolução", en: "Refund rejection" }
  document: ReturnRequest

  fields {
    order
    reason
    justification: string {
      title: { pt-BR: "Motivo da rejeição", en: "Rejection reason" }
    }
  }

  actions {
    reject { calls: ReturnRequest.reject(justification) }
  }
}

view RefundCaseProgress {
  title: { pt-BR: "Andamento da devolução", en: "Refund case progress" }
  type: process
  process: RefundCase
  roles: [SupportAgent, Manager, Customer]

  sections { current; participants; history; deadlines; documents; milestones; next }
}

decision RefundEligibility {
  title: { pt-BR: "Elegibilidade da devolução", en: "Refund eligibility" }
  returns: RefundVerdict
  inputs {
    amount: std.Money
    orderAgeDays: std.Count
  }
  cases {
    amount <= RefundLimit and orderAgeDays <= 30 -> Eligible
    amount <= RefundLimit -> NotEligible
    orderAgeDays <= 30 -> ApprovalRequired
    else -> NotEligible
  }
  source: "Política de devolução v1"
  owner: Support
}
