// service: example.com/services/support

shape TicketStatus {
  title: { pt-BR: "Situação do chamado", en: "Ticket status" }
  base: state
  initial: Open with transition Opened {
    title: { pt-BR: "Chamado aberto", en: "Ticket opened" }
    payload {
      subject: string { title: { pt-BR: "Assunto", en: "Subject" } }
    }
  }
  value Open {
    title: { pt-BR: "Aberta", en: "Open" }
    icon: Open
    ordinal: 10

    transition InProgress {
      event: Claimed
      title: { pt-BR: "Chamado assumido", en: "Ticket claimed" }
    }
  }
  value InProgress {
    title: { pt-BR: "Em andamento", en: "In progress" }
    icon: InProgress
    ordinal: 20

    transition Waiting {
      event: Held
      title: { pt-BR: "Chamado aguardando", en: "Ticket held" }
    }

    transition Resolved {
      title: { pt-BR: "Chamado resolvido", en: "Ticket resolved" }
      payload {
        assignee: User { title: { pt-BR: "Responsável", en: "Assignee" } }
      }
    }
  }
  value Waiting {
    title: { pt-BR: "Aguardando", en: "Waiting" }
    icon: Waiting
    ordinal: 30

    transition InProgress {
      event: Resumed
      title: { pt-BR: "Chamado retomado", en: "Ticket resumed" }
    }

    transition Resolved {
      title: { pt-BR: "Chamado resolvido", en: "Ticket resolved" }
      payload {
        assignee: User { title: { pt-BR: "Responsável", en: "Assignee" } }
      }
    }
  }
  value Resolved {
    title: { pt-BR: "Resolvido", en: "Resolved" }
    icon: Resolved
    ordinal: 40

    transition Closed {
      title: { pt-BR: "Chamado fechado", en: "Ticket closed" }
    }

    transition Open {
      event: Reopened
      title: { pt-BR: "Chamado reaberto", en: "Ticket reopened" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Closed {
    title: { pt-BR: "Fechado", en: "Closed" }
    icon: Closed
    ordinal: 50
  }
  format: plain
}

shape ReturnStatus {
  title: { pt-BR: "Situação da devolução", en: "Return status" }
  base: state
  initial: Requested with transition Requested {
    title: { pt-BR: "Devolução solicitada", en: "Return requested" }
    payload {
      reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
    }
  }
  value Requested {
    title: { pt-BR: "Solicitado", en: "Requested" }
    icon: Requested
    ordinal: 10

    transition Approved {
      title: { pt-BR: "Devolução aprovada", en: "Return approved" }
      payload {
        refundAmount: std.Money { title: { pt-BR: "Valor do reembolso", en: "Refund amount" } }
      }
    }

    transition Rejected {
      title: { pt-BR: "Devolução rejeitada", en: "Return rejected" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }

    transition Cancelled {
      title: { pt-BR: "Devolução cancelada", en: "Return cancelled" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Approved {
    title: { pt-BR: "Aprovado", en: "Approved" }
    icon: Approved
    ordinal: 20

    transition Received {
      title: { pt-BR: "Devolução recebida", en: "Return received" }
    }

    transition Cancelled {
      title: { pt-BR: "Devolução cancelada", en: "Return cancelled" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Rejected {
    title: { pt-BR: "Rejeitado", en: "Rejected" }
    icon: Rejected
    ordinal: 30
  }
  value Received {
    title: { pt-BR: "Recebida", en: "Received" }
    icon: Received
    ordinal: 40

    transition Refunded {
      title: { pt-BR: "Devolução reembolsada", en: "Return refunded" }
      payload {
        refundAmount: std.Money { title: { pt-BR: "Valor do reembolso", en: "Refund amount" } }
      }
    }

    transition Cancelled {
      title: { pt-BR: "Devolução cancelada", en: "Return cancelled" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Refunded {
    title: { pt-BR: "Reembolsado", en: "Refunded" }
    icon: Refunded
    ordinal: 50
  }
  value Cancelled {
    title: { pt-BR: "Cancelado", en: "Cancelled" }
    icon: Cancelled
    ordinal: 60
  }
  format: plain
}

shape TicketPriority {
  title: { pt-BR: "Prioridade do chamado", en: "Ticket priority" }
  base: classification
  value P1 {
    title: { pt-BR: "Prioridade 1", en: "Priority 1" }
    icon: P1
    ordinal: 10
  }
  value P2 {
    title: { pt-BR: "Prioridade 2", en: "Priority 2" }
    icon: P2
    ordinal: 20
  }
  value P3 {
    title: { pt-BR: "Prioridade 3", en: "Priority 3" }
    icon: P3
    ordinal: 30
  }
  value P4 {
    title: { pt-BR: "Prioridade 4", en: "Priority 4" }
    icon: P4
    ordinal: 40
  }
  format: plain
}

shape TicketCategory {
  title: { pt-BR: "Categoria do chamado", en: "Ticket category" }
  base: classification
  value Technical {
    title: { pt-BR: "Técnico", en: "Technical" }
    icon: Technical
    ordinal: 10
  }
  value Billing {
    title: { pt-BR: "Cobrança", en: "Billing" }
    icon: Billing
    ordinal: 20
  }
  value General {
    title: { pt-BR: "Geral", en: "General" }
    icon: General
    ordinal: 30
  }
  format: plain
}

shape RefundVerdict {
  title: { pt-BR: "Parecer da devolução", en: "Refund verdict" }
  base: classification
  value Eligible {
    title: { pt-BR: "Elegível", en: "Eligible" }
    icon: Eligible
    ordinal: 10
  }
  value ApprovalRequired {
    title: { pt-BR: "Exige aprovação", en: "Approval required" }
    icon: ApprovalRequired
    ordinal: 20
  }
  value NotEligible {
    title: { pt-BR: "Não elegível", en: "Not eligible" }
    icon: NotEligible
    ordinal: 30
  }
  format: plain
}
