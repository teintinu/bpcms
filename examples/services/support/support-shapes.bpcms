// service: example.com/services/support


shape TicketStatus {
  title: { pt-BR: "Situação do chamado", en: "Ticket status" }
  base: workflow
  initial: Open
  value Open {
    title: { pt-BR: "Aberta", en: "Open" }
    icon: Open
    ordinal: 10
    transition InProgress {
      title: { pt-BR: "Em andamento", en: "In progress" }
    }
    transition Waiting {
      title: { pt-BR: "Aguardando", en: "Waiting" }
    }
    transition Resolved {
      title: { pt-BR: "Resolvido", en: "Resolved" }
      payload {
        assignee: User
      }
    }
  }
  value InProgress {
    title: { pt-BR: "Em andamento", en: "In progress" }
    icon: InProgress
    ordinal: 20
    transition Waiting {
      title: { pt-BR: "Aguardando", en: "Waiting" }
    }
    transition Resolved {
      title: { pt-BR: "Resolvido", en: "Resolved" }
      payload {
        assignee: User
      }
    }
  }
  value Waiting {
    title: { pt-BR: "Aguardando", en: "Waiting" }
    icon: Waiting
    ordinal: 30
    transition InProgress {
      title: { pt-BR: "Em andamento", en: "In progress" }
    }
    transition Resolved {
      title: { pt-BR: "Resolvido", en: "Resolved" }
      payload {
        assignee: User
      }
    }
  }
  value Resolved {
    title: { pt-BR: "Resolvido", en: "Resolved" }
    icon: Resolved
    ordinal: 40
    transition Closed {
      title: { pt-BR: "Fechado", en: "Closed" }
    }
    transition Open {
      title: { pt-BR: "Reaberto", en: "Reopened" }
      event: Reopened
      payload {
        reason: string
      }
    }
  }
  value Closed {
    title: { pt-BR: "Fechado", en: "Closed" }
    icon: Closed
    ordinal: 50
  }
  format: plain

}

shape ReturnStatus {
  title: { pt-BR: "Situação da devolução", en: "Return status" }
  base: workflow
  initial: Requested
  value Requested {
    title: { pt-BR: "Solicitado", en: "Requested" }
    icon: Requested
    ordinal: 10
    transition Approved {
      title: { pt-BR: "Aprovado", en: "Approved" }
    }
    transition Rejected {
      title: { pt-BR: "Rejeitado", en: "Rejected" }
    }
  }
  value Approved {
    title: { pt-BR: "Aprovado", en: "Approved" }
    icon: Approved
    ordinal: 20
    transition Received {
      title: { pt-BR: "Recebida", en: "Received" }
    }
  }
  value Rejected {
    title: { pt-BR: "Rejeitado", en: "Rejected" }
    icon: Rejected
    ordinal: 30
  }
  value Received {
    title: { pt-BR: "Recebida", en: "Received" }
    icon: Received
    ordinal: 40
    transition Refunded {
      title: { pt-BR: "Reembolsado", en: "Refunded" }
    }
  }
  value Refunded {
    title: { pt-BR: "Reembolsado", en: "Refunded" }
    icon: Refunded
    ordinal: 50
  }
  format: plain

}

shape TicketPriority {
  title: { pt-BR: "Prioridade do chamado", en: "Ticket priority" }
  base: classification
  value P1 {
    title: { pt-BR: "Prioridade 1", en: "Priority 1" }
    icon: P1
    ordinal: 10
  }
  value P2 {
    title: { pt-BR: "Prioridade 2", en: "Priority 2" }
    icon: P2
    ordinal: 20
  }
  value P3 {
    title: { pt-BR: "Prioridade 3", en: "Priority 3" }
    icon: P3
    ordinal: 30
  }
  value P4 {
    title: { pt-BR: "Prioridade 4", en: "Priority 4" }
    icon: P4
    ordinal: 40
  }
  format: plain

}
