// service: example.com/services/support


shape TicketStatus {
  title: { pt-BR: "Status do chamado", en: "Ticket status" }
  base: text
  values {
    open {
      title: { pt-BR: "Aberta", en: "Open" }
      icon: Open
    }
    in_progress {
      title: { pt-BR: "Em andamento", en: "In progress" }
      icon: InProgress
    }
    waiting {
      title: { pt-BR: "Aguardando", en: "Waiting" }
      icon: Waiting
    }
    resolved {
      title: { pt-BR: "Resolvido", en: "Resolved" }
      icon: Resolved
    }
    closed {
      title: { pt-BR: "Fechado", en: "Closed" }
      icon: Closed
    }
  }
  format: plain
}

shape ReturnStatus {
  title: { pt-BR: "Status da devolução", en: "Return status" }
  base: text
  values {
    requested {
      title: { pt-BR: "Solicitado", en: "Requested" }
      icon: Requested
    }
    approved {
      title: { pt-BR: "Aprovado", en: "Approved" }
      icon: Approved
    }
    rejected {
      title: { pt-BR: "Rejeitado", en: "Rejected" }
      icon: Rejected
    }
    received {
      title: { pt-BR: "Recebida", en: "Received" }
      icon: Received
    }
    refunded {
      title: { pt-BR: "Reembolsado", en: "Refunded" }
      icon: Refunded
    }
  }
  format: plain
}

shape TicketPriority {
  title: { pt-BR: "Prioridade do chamado", en: "Ticket priority" }
  base: text
  values {
    P1 {
      title: { pt-BR: "Prioridade 1", en: "Priority 1" }
      icon: P1
    }
    P2 {
      title: { pt-BR: "Prioridade 2", en: "Priority 2" }
      icon: P2
    }
    P3 {
      title: { pt-BR: "Prioridade 3", en: "Priority 3" }
      icon: P3
    }
    P4 {
      title: { pt-BR: "Prioridade 4", en: "Priority 4" }
      icon: P4
    }
  }
  format: plain
}
