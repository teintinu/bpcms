// service: example.com/services/support


shape TicketStatus {
  title: { pt-BR: "Status do chamado", en: "Ticket status" }
  base: workflow
  initial: open
  values {
    open {
      title: { pt-BR: "Aberta", en: "Open" }
      icon: Open
      ordinal: 10
      next: [in_progress, waiting, resolved]
    }
    in_progress {
      title: { pt-BR: "Em andamento", en: "In progress" }
      icon: InProgress
      ordinal: 20
      next: [waiting, resolved]
    }
    waiting {
      title: { pt-BR: "Aguardando", en: "Waiting" }
      icon: Waiting
      ordinal: 30
      next: [in_progress, resolved]
    }
    resolved {
      title: { pt-BR: "Resolvido", en: "Resolved" }
      icon: Resolved
      ordinal: 40
      next: [closed]
    }
    closed {
      title: { pt-BR: "Fechado", en: "Closed" }
      icon: Closed
      ordinal: 50
      next: []
    }
  }
  format: plain
}

shape ReturnStatus {
  title: { pt-BR: "Status da devolução", en: "Return status" }
  base: workflow
  initial: requested
  values {
    requested {
      title: { pt-BR: "Solicitado", en: "Requested" }
      icon: Requested
      ordinal: 10
      next: [approved, rejected]
    }
    approved {
      title: { pt-BR: "Aprovado", en: "Approved" }
      icon: Approved
      ordinal: 20
      next: [received]
    }
    rejected {
      title: { pt-BR: "Rejeitado", en: "Rejected" }
      icon: Rejected
      ordinal: 30
      next: []
    }
    received {
      title: { pt-BR: "Recebida", en: "Received" }
      icon: Received
      ordinal: 40
      next: [refunded]
    }
    refunded {
      title: { pt-BR: "Reembolsado", en: "Refunded" }
      icon: Refunded
      ordinal: 50
      next: []
    }
  }
  format: plain
}

shape TicketPriority {
  title: { pt-BR: "Prioridade do chamado", en: "Ticket priority" }
  base: classification
  values {
    P1 {
      title: { pt-BR: "Prioridade 1", en: "Priority 1" }
      icon: P1
      ordinal: 10
    }
    P2 {
      title: { pt-BR: "Prioridade 2", en: "Priority 2" }
      icon: P2
      ordinal: 20
    }
    P3 {
      title: { pt-BR: "Prioridade 3", en: "Priority 3" }
      icon: P3
      ordinal: 30
    }
    P4 {
      title: { pt-BR: "Prioridade 4", en: "Priority 4" }
      icon: P4
      ordinal: 40
    }
  }
  format: plain
}
