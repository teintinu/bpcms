// service: example.com/services/support

policy SlaEscalation {
  appliesTo: Ticket
  rule: not breached
  severity: enforce
  message: "Chamado fora do prazo deve ser escalonado ao gerente"
  notification: [Email, WhatsApp]
  audit: true
}

policy RefundAuthorization {
  appliesTo: ReturnRequest.refund
  rule: refundAmount <= RefundLimit
  severity: block
  message: "Reembolso acima do limite exige aprovação de gerente"
  audit: true
}
