// service: example.com/services/support

form TicketIntake {
  title: { pt-BR: "Triagem do chamado", en: "Ticket intake" }
  document: Ticket

  fields {
    subject
    description
    priority
    category
    order
    customer
    justification: string {
      title: { pt-BR: "Motivo do escalonamento", en: "Escalation reason" }
      maxLength: 500
    }
  }

  actions {
    claim { calls: Ticket.claim }
    escalate { calls: Ticket.escalate(justification); stay }
  }
}

form TicketResolution {
  title: { pt-BR: "Resolução do chamado", en: "Ticket resolution" }
  document: Ticket

  fields {
    subject
    description
    assignee
    justification: string {
      title: { pt-BR: "Motivo da espera ou do escalonamento", en: "Hold or escalation reason" }
      maxLength: 500
    }
  }

  actions {
    resolve { calls: Ticket.resolve }
    hold { calls: Ticket.hold; stay }
    escalate { calls: Ticket.escalate(justification); stay }
  }
}

form TicketEscalation {
  title: { pt-BR: "Escalonamento do chamado", en: "Ticket escalation" }
  document: Ticket

  fields {
    subject
    priority
    justification: string {
      title: { pt-BR: "Motivo do escalonamento", en: "Escalation reason" }
      maxLength: 500
    }
  }

  actions {
    escalate { calls: Ticket.escalate(justification) }
  }
}

form RefundReview {
  title: { pt-BR: "Conferência da devolução", en: "Refund review" }
  document: ReturnRequest

  fields {
    order
    payment
    shipment
    reason
    refundAmount
  }

  actions {
    confirm { calls: ReturnRequest.review }
  }
}

form RefundApproval {
  title: { pt-BR: "Aprovação da devolução", en: "Refund approval" }
  document: ReturnRequest

  fields {
    order
    refundAmount
    justification: string {
      title: { pt-BR: "Motivo da rejeição", en: "Rejection reason" }
    }
  }

  actions {
    approve { calls: ReturnRequest.approve }
    reject { calls: ReturnRequest.reject(justification) }
  }
}

form RefundRejection {
  title: { pt-BR: "Recusa da devolução", en: "Refund rejection" }
  document: ReturnRequest

  fields {
    order
    reason
    justification: string {
      title: { pt-BR: "Motivo da rejeição", en: "Rejection reason" }
    }
  }

  actions {
    reject { calls: ReturnRequest.reject(justification) }
  }
}
