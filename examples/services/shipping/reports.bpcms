// service: example.com/services/shipping
report FreightCost {
  type: dashboard
  sources: [Shipment]
  roles: [Manager]

  filters { period; carrier; status }
  metrics {
    shipments: count(Shipment)
    freight: sum(Shipment.frete)
    avgWeight: avg(Shipment.pesoBruto)
    late: count(Shipment) where status == delivered and DeliveryDelayed
  }
  freshness: 15m
  units { freight: BRL; avgWeight: kg }
}
