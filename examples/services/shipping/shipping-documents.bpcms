// service: example.com/services/shipping
document ShipmentItem {
  title: { pt-BR: "Item de remessa", en: "Shipment item" }
  version: 1
  owner: "Shipping"
  sync: live

  fields {
    shipment: link Shipment {
      title: { pt-BR: "Remessa", en: "Shipment" }
    }
    product: link Product {
      title: { pt-BR: "Produto", en: "Product" }
      lookup
    }
    quantity: std.Count { title: { pt-BR: "Quantidade", en: "Quantity" }, lookup }
    pesoUnitario: std.Mass { title: { pt-BR: "Peso unitário", en: "Unit weight" } }
  }

  indexes {
    byShipment: [shipment.id] hash
  }

  rules {
    quantity > 0
  }
}

document Shipment {
  title: { pt-BR: "Remessa", en: "Shipment" }
  version: 1
  owner: "Shipping"
  sync: live
  audit: true

  fields {
    order: link Order {
      title: { pt-BR: "Pedido", en: "Order" }
      lookup
    }
    items: ShipmentItem[] { title: { pt-BR: "Itens", en: "Items" } }
    pesoBruto: std.Mass { title: { pt-BR: "Peso bruto", en: "Gross weight" } }
    volume: std.Volume { title: { pt-BR: "Volume", en: "Volume" } }
    frete: std.Money { title: { pt-BR: "Frete", en: "Freight" }, currency: BRL }
    tracking: TrackingCode { title: { pt-BR: "Rastreio", en: "Tracking" }, lookup }
    status: ShipmentStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    readAt: DateTime { title: { pt-BR: "Lido em", en: "Read at" } }
    calculatedAt: DateTime { title: { pt-BR: "Calculado em", en: "Calculated at" } }
    createdAt: DateTime { title: { pt-BR: "Criado em", en: "Created at" } }
  }

  capabilities { capture, units }
  source: device "scale-01" for pesoBruto

  computed frete from Shipment {
    freshness: 15m
    exposes: [frete, calculatedAt]
  }

  indexes {
    byOrder: [order.id] hash
    byStatus: [status, createdAt] range
    byWeight: [pesoBruto.normalized] range
  }

  actions {
    create(orderId: OrderId){
      title: { pt-BR: "Criar remessa", en: "Create shipment" }
      permission: Clerk
    }
    addItem(productId: ProductId, quantity: std.Count){
      title: { pt-BR: "Adicionar item", en: "Add item" }
      permission: Manager
    }
    split(){
      title: { pt-BR: "Dividir", en: "Split" }
      permission: Manager
    }
    dispatch(){
      title: { pt-BR: "Despachar", en: "Dispatch" }
      permission: Manager
    }
    trackAll(){
      title: { pt-BR: "Rastrear tudo", en: "Track all" }
      permission: Manager
    }
  }

  rules {
    pesoBruto <= MaxWeight
    status == dispatched implies tracking != null
  }
}
