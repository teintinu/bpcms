// service: example.com/services/shipping


shape ShipmentStatus {
  title: { pt-BR: "Situação da remessa", en: "Shipment status" }
  base: workflow
  initial: draft
  values {
    draft {
      title: { pt-BR: "Rascunho", en: "Draft" }
      icon: Draft
      ordinal: 10
      next: [packed, returned]
    }
    packed {
      title: { pt-BR: "Embalada", en: "Packed" }
      icon: Packed
      ordinal: 20
      next: [dispatched, returned]
    }
    dispatched {
      title: { pt-BR: "Despachada", en: "Dispatched" }
      icon: Dispatched
      ordinal: 30
      next: [delivered, returned]
    }
    delivered {
      title: { pt-BR: "Entregue", en: "Delivered" }
      icon: Delivered
      ordinal: 40
      next: []
    }
    returned {
      title: { pt-BR: "Devolvida", en: "Returned" }
      icon: Returned
      ordinal: 50
      next: []
    }
  }
  format: plain

}

shape TrackingEvent {
  title: { pt-BR: "Evento de rastreio", en: "Tracking event" }
  fields {
    at: DateTime { title: { pt-BR: "Data/hora", en: "At" } }
    status: ShipmentStatus { title: { pt-BR: "Situação", en: "Status" } }
    description: string { title: { pt-BR: "Descrição", en: "Description" } }
  }
}

shape TrackingCode {
  title: { pt-BR: "Código de rastreio", en: "Tracking code" }
  base: string
  normalize: upper-trim
  maxLength: 40
  format: plain
}
