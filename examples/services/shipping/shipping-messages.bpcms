// service: example.com/services/shipping
message PickupRequest {
  title: { pt-BR: "Solicitação de coleta", en: "Pickup request" }
  about: Shipment

  payload {
    requestedAt: DateTime { title: { pt-BR: "Solicitado em", en: "Requested at" } }
    window: Duration { title: { pt-BR: "Janela de coleta", en: "Pickup window" } }
  }
}

message PickupConfirmed {
  title: { pt-BR: "Coleta confirmada", en: "Pickup confirmed" }
  about: Shipment

  payload {
    pickedUpOn: DateTime { title: { pt-BR: "Coletada em", en: "Picked up at" } }
    tracking: TrackingCode { title: { pt-BR: "Rastreio", en: "Tracking" } }
  }
}

message TrackingUpdated {
  title: { pt-BR: "Rastreio atualizado", en: "Tracking updated" }
  about: Shipment

  payload {
    kind: TrackingKind { title: { pt-BR: "Tipo de evento", en: "Event kind" } }
    at: DateTime { title: { pt-BR: "Data/hora", en: "At" } }
    receivedBy: string { title: { pt-BR: "Recebido por", en: "Received by" } }
  }
}
