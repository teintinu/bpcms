// service: example.com/services/shipping
event Dispatched {
  title: { pt-BR: "Remessa despachada", en: "Shipment dispatched" }
  version: 1
  payload {
    shipmentId: ShipmentId { title: { pt-BR: "Remessa", en: "Shipment" } }
    orderId: OrderId { title: { pt-BR: "Pedido", en: "Order" } }
    tracking: TrackingCode { title: { pt-BR: "Rastreio", en: "Tracking" } }
    dispatchedAt: DateTime { title: { pt-BR: "Despachado em", en: "Dispatched at" } }
  }
  producer: Shipment
  consumers: [Orders, Billing, Notifications]
  key: shipmentId
}

event DeliveryDelayed {
  title: { pt-BR: "Entrega atrasada", en: "Delivery delayed" }
  version: 1
  payload {
    shipmentId: ShipmentId { title: { pt-BR: "Remessa", en: "Shipment" } }
    expectedAt: DateTime { title: { pt-BR: "Previsão", en: "Expected at" } }
    newEta: DateTime { title: { pt-BR: "Nova previsão", en: "New ETA" } }
  }
  producer: Shipment
  consumers: [Support, Notifications]
  key: shipmentId
}
