// service: example.com/services/shipping
process DispatchOrder for Shipment {
  title: { pt-BR: "Despacho do pedido", en: "Order dispatch" }
  version: 1
  goal: "Separar, embalar, pesar, cotar o frete e despachar com etiqueta"
  owner: "Shipping"
  timezone: America/Fortaleza
  sla: 1d

  pool Company {
    internal
    lane Warehouse { role: Packer }
    lane Dispatch { role: Dispatcher }
    lane Management { role: Manager }
  }

  pool Carrier {
    external
  }

  variables {
    freight: std.Money
    tracking: TrackingCode
  }

  start Created { event: Shipment.Created }

  task Pick {
    lane: Warehouse
    manual: "Separar os itens do pedido no armazém"
    sla: 2h
    priority: 60
    assign: pull
    on timer 4h -> Escalate
  }

  task Escalate {
    lane: Management
    manual: "Priorizar a separação com o supervisor"
    sla: 1h
  }

  task Pack {
    lane: Warehouse
    form: Packing
    sla: 1h
    assign: pull
  }

  task Weigh {
    lane: Warehouse
    manual: "Conferir o peso da remessa na balança do posto"
    sla: 15m
  }

  gateway WeightLimit {
    if shipment.pesoBruto <= MaxWeight -> QuoteFreight
    else -> Split
  }

  task Split {
    lane: Management
    form: SplitShipment
    sla: 4h
    assign: pull
  }

  task QuoteFreight {
    lane: System
    call: Carrier.quote
    with {
      shipment
      carrier: "CarrierX"
    }
    gives: freight
    sla: 2m
    on error CarrierUnavailable -> ManualQuote
  }

  task ManualQuote {
    lane: Management
    form: FreightOverride
    sla: 2h
    assign: pull
  }

  task RecordFreight {
    lane: System
    action: Shipment.applyFreight
    with {
      carrier: "CarrierX"
      amount: freight
    }
    sla: 1m
  }

  task CreateLabel {
    lane: System
    call: Carrier.createLabel
    with {
      shipment
      carrier: "CarrierX"
    }
    gives: tracking
    sla: 2m
    on error LabelRejected -> ManualQuote
  }

  task RecordDispatch {
    lane: System
    action: Shipment.dispatch
    with { trackingCode: tracking }
    sla: 1m
  }

  task RequestPickup {
    lane: System
    sends: PickupRequest
    partner: Carrier
    with { shipment }
    sla: 5m
  }

  task ConfirmPickup {
    lane: System
    receives: PickupConfirmed
    partner: Carrier
    apply: Shipment.confirmPickup
    sla: 2d
    on timer 2d -> ManualPickup
  }

  task ManualPickup {
    lane: Dispatch
    form: PickupConfirmation
    sla: 1d
    assign: pull
  }

  task Track {
    lane: System
    runs: DeliveryTracking
    with { shipment }
    sla: 30d
  }

  end Dispatched {
    title: { pt-BR: "Despachada", en: "Dispatched" }
    outcome: success
  }
  end SplitDone {
    title: { pt-BR: "Dividida", en: "Split" }
    outcome: success
  }
  end Cancelled {
    title: { pt-BR: "Cancelada", en: "Cancelled" }
    outcome: cancelled
  }

  Created -> Pick
  Pick -> Pack
  Escalate -> Pack
  Pack.confirm -> Weigh
  Weigh -> WeightLimit
  WeightLimit -> QuoteFreight
  WeightLimit -> Split
  Split.split -> SplitDone
  Split.cancel -> Cancelled
  QuoteFreight -> RecordFreight
  ManualQuote.apply -> RecordFreight
  RecordFreight -> CreateLabel
  CreateLabel -> RecordDispatch
  RecordDispatch -> RequestPickup
  RequestPickup -> ConfirmPickup
  ConfirmPickup -> Track
  ManualPickup.confirm -> Track
  Track -> Dispatched
}

process DeliveryTracking for Shipment {
  title: { pt-BR: "Acompanhamento da entrega", en: "Delivery tracking" }
  version: 1
  goal: "Acompanhar a entrega, tratar tentativa falha e reentregar"
  owner: "Shipping"
  timezone: America/Fortaleza
  sla: 30d

  pool Company {
    internal
    lane Operations { role: Dispatcher }
  }

  pool Carrier {
    external
  }


  start Begin { called }

  task AwaitTracking {
    lane: System
    receives: TrackingUpdated
    partner: Carrier
    apply: Shipment.applyTracking
    sla: 3d
    on timer 3d -> Chase
  }

  gateway Outcome {
    if shipment.lastTrackingKind == Completed -> Confirm
    if shipment.lastTrackingKind == AttemptFailed -> FlagFailure
    else -> AwaitTracking
  }

  task Confirm {
    lane: System
    action: Shipment.markDelivered
    sla: 1m
  }

  task FlagFailure {
    lane: System
    action: Shipment.markAttemptFailed
    with { reason: "Tentativa de entrega frustrada pelo parceiro" }
    sla: 1m
  }

  task Retry {
    lane: Operations
    form: DeliveryRetry
    sla: 4h
    priority: 70
    assign: pull
  }

  task Chase {
    lane: Operations
    manual: "Ligar para a transportadora e pedir posição do rastreio"
    sla: 1d
  }

  wait NextAttempt {
    until: shipment.nextAttemptAt
  }

  milestone HandedOver {
    title: { pt-BR: "Coleta confirmada", en: "Pickup confirmed" }
    on: Shipment.PickedUp
  }

  end Delivered {
    title: { pt-BR: "Entregue", en: "Delivered" }
    outcome: success
  }
  end Returned {
    title: { pt-BR: "Devolvida", en: "Returned" }
    outcome: cancelled
  }
  end Stopped {
    title: { pt-BR: "Encerrada", en: "Stopped" }
    outcome: cancelled
  }

  cancel on Shipment.Cancelled -> Stopped

  AwaitTracking -> Outcome
  Outcome -> Confirm
  Outcome -> FlagFailure
  Outcome -> AwaitTracking
  Confirm -> Delivered
  FlagFailure -> Retry
  Retry.confirm -> NextAttempt
  Retry.sendBack -> Returned
  NextAttempt -> AwaitTracking
  Chase -> AwaitTracking
  Begin -> AwaitTracking
}

process FreightQuote for Shipment {
  title: { pt-BR: "Cotação de frete", en: "Freight quote" }
  version: 1
  goal: "Cotar frete em várias transportadoras e aplicar a melhor oferta"
  owner: "Shipping"
  timezone: America/Fortaleza
  sla: 1d

  pool Company {
    internal
    lane Dispatch { role: Dispatcher }
    lane Management { role: Manager }
  }

  pool Carrier {
    external
  }

  variables {
    quoteA: std.Money
    quoteB: std.Money
    quoteC: std.Money
  }

  start Requested { event: Shipment.QuoteRequested }

  fork Ask

  task AskA {
    lane: System
    call: Carrier.quote
    with {
      shipment
      carrier: "CarrierA"
    }
    gives: quoteA
    sla: 2m
    on timer 2m -> Fallback
  }

  task AskB {
    lane: System
    call: Carrier.quote
    with {
      shipment
      carrier: "CarrierB"
    }
    gives: quoteB
    sla: 2m
    on timer 2m -> Fallback
  }

  task AskC {
    lane: System
    call: Carrier.quote
    with {
      shipment
      carrier: "CarrierC"
    }
    gives: quoteC
    sla: 2m
    on timer 2m -> Fallback
  }

  join Qualified

  gateway Cheapest {
    if quoteA <= quoteB and quoteA <= quoteC -> UseA
    if quoteB <= quoteC -> UseB
    else -> UseC
  }

  task UseA {
    lane: System
    action: Shipment.applyFreight
    with {
      carrier: "CarrierA"
      amount: quoteA
    }
    sla: 1m
  }

  task UseB {
    lane: System
    action: Shipment.applyFreight
    with {
      carrier: "CarrierB"
      amount: quoteB
    }
    sla: 1m
  }

  task UseC {
    lane: System
    action: Shipment.applyFreight
    with {
      carrier: "CarrierC"
      amount: quoteC
    }
    sla: 1m
  }

  task Fallback {
    lane: Management
    form: FreightOverride
    sla: 2h
    assign: pull
    on timer 1d -> AbandonQuote
  }

  task AbandonQuote {
    lane: Management
    manual: "Encerrar a cotação como expirada e avisar o despachante"
    sla: 1h
  }

  end Quoted {
    title: { pt-BR: "Cotada", en: "Quoted" }
    outcome: success
  }
  end Expired {
    title: { pt-BR: "Cotação expirada", en: "Quote expired" }
    outcome: failure
  }

  Requested -> Ask
  Ask -> AskA
  Ask -> AskB
  Ask -> AskC
  AskA -> Qualified
  AskB -> Qualified
  AskC -> Qualified
  Qualified -> Cheapest
  Cheapest -> UseA
  Cheapest -> UseB
  Cheapest -> UseC
  UseA -> Quoted
  UseB -> Quoted
  UseC -> Quoted
  Fallback.apply -> Quoted
  AbandonQuote -> Expired
}
