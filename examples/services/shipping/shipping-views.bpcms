// service: example.com/services/shipping
view ShipmentForm {
  type: form
  document: Shipment
  roles: [Dispatcher]

  fields {
    orderId: OrderId { required }
    pesoBruto: Mass { readonly }
    volume: Volume
    status: ShipmentStatus { readonly }
  }

  actions {
    save -> Shipment.create
    dispatch -> Shipment.dispatch
    cancel -> none
  }
}

view DispatchBoard {
  type: kanban
  source: Shipment
  roles: [Dispatcher, Manager]
  groupBy: status

  columns { draft; packed; dispatched; delivered }
  card { orderId; pesoBruto; volume; tracking }
  actions {
    dispatch -> Shipment.dispatch
    track -> Shipment.trackAll
  }
}
