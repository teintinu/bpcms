// service: example.com/services/shipping
view Shipments {
  title: { pt-BR: "Remessas", en: "Shipments" }
  type: table
  source: Shipment
  roles: [Packer, Dispatcher, Manager]

  columns { order; carrierName; status; tracking; frete }
  filters { status; period; carrierName }
  pagination: 50

  actions {
    open -> ShipmentDetail
    receive -> Shipment.create(order)
    requestQuote -> Shipment.requestQuote
  }
}

view ShipmentDetail {
  title: { pt-BR: "Detalhe da remessa", en: "Shipment detail" }
  type: detail
  document: Shipment
  roles: [Packer, Dispatcher, Manager]

  sections { summary; items; timeline }
  actions {
    progress -> DispatchProgress
    delivery -> DeliveryProgress
  }
}

view DispatchBoard {
  title: { pt-BR: "Quadro de expedição", en: "Dispatch board" }
  type: kanban
  source: Shipment
  roles: [Packer, Dispatcher, Manager]

  groupBy: status
  card { order; tracking; frete }
  filter { status != Cancelled }
  actions {
    open -> ShipmentDetail
  }
}

view DispatchProgress {
  title: { pt-BR: "Andamento do despacho", en: "Dispatch progress" }
  type: process
  process: DispatchOrder
  roles: [Packer, Dispatcher, Manager]

  sections { current; participants; history; deadlines; subprocesses; documents; milestones; next }
}

view DeliveryProgress {
  title: { pt-BR: "Andamento da entrega", en: "Delivery progress" }
  type: process
  process: DeliveryTracking
  roles: [Packer, Dispatcher, Manager]

  sections { current; participants; history; deadlines; documents; milestones; next }
}

view LogisticsInbox {
  title: { pt-BR: "Minha fila de expedição", en: "My dispatch queue" }
  type: inbox
  roles: [Packer, Dispatcher]
  scope: mine
  groupBy: process
  columns { title; subject; lane; dueAt; priority }
}
