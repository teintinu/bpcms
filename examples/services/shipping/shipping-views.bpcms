// service: example.com/services/shipping
view ShipmentForm {
  title: { pt-BR: "Formulário de remessa", en: "Shipment form" }
  type: form
  document: Shipment
  roles: [Dispatcher]

  fields {
    orderId: OrderId { title: { pt-BR: "Pedido", en: "Order" }, required }
    pesoBruto: std.Mass { title: { pt-BR: "Peso bruto", en: "Gross weight" }, readonly }
    volume: std.Volume { title: { pt-BR: "Volume", en: "Volume" } }
    status: ShipmentStatus { title: { pt-BR: "Situação", en: "Status" }, readonly }
  }

  actions {
    save -> Shipment.create
    dispatch -> Shipment.dispatch
    cancel -> none
  }
}

view DispatchBoard {
  title: { pt-BR: "Quadro de expedição", en: "Dispatch board" }
  type: kanban
  source: Shipment
  roles: [Dispatcher, Manager]
  groupBy: status

  columns { draft; packed; dispatched; delivered }
  card { orderId; pesoBruto; volume; tracking }
  actions {
    dispatch -> Shipment.dispatch
    track -> Shipment.trackAll
  }
}
