// service: example.com/services/shipping

role Packer {
  title: { pt-BR: "Embalador", en: "Packer" }
  permissions: [shipment.pack, shipment.view]
}

role Dispatcher {
  title: { pt-BR: "Despachante", en: "Dispatcher" }
  inherits: Packer
  permissions: [shipment.dispatch, shipment.track, shipment.retry]
}

role Manager {
  title: { pt-BR: "Gerente de logística", en: "Logistics manager" }
  inherits: Dispatcher
  permissions: [shipment.cancel, shipment.split, report.view]
}

role ShipmentEngine {
  title: { pt-BR: "Motor de expedição", en: "Shipment engine" }
  permissions: [shipment.capture, shipment.deliver]
}

organogram Logistics {
  title: { pt-BR: "Organograma de logística", en: "Logistics organogram" }

  hierarchy {
    Manager > Dispatcher > Packer
  }

  Manager manages [Dispatcher]
  Dispatcher manages [Packer]
}
