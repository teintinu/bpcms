service "example.com/services/shipping" {
  title: { pt-BR: "Expedição", en: "Shipping" }
  version: 1.0.0
  owner: "Shipping"
  imports {
    service "example.com/services/orders" as Orders
    service "example.com/services/inventory" as Inventory
    service "example.com/services/identity" as Identity
  }
  requires { oltp, scheduling, location, timezone, regionalization, units }
  provides { shipping }
}
