// service: example.com/services/checkout
document CheckoutSession {
  title: { pt-BR: "Sessão de finalização", en: "Checkout session" }
  version: 1
  owner: "Checkout"
  sync: live
  audit: true

  fields {
    customer: link User {
      title: { pt-BR: "Cliente", en: "Customer" }
      lookup
    }
    total: std.Money {
      title: { pt-BR: "Total", en: "Total" }
      currency: BRL
    }
    status: string {
      title: { pt-BR: "Situação", en: "Status" }
      lookup
    }
  }

  actions {
    validateCart() {
      title: { pt-BR: "Validar carrinho", en: "Validate cart" }
      permission: Customer
      emit Validated
    }

    quoteShipping() {
      title: { pt-BR: "Cotar frete", en: "Quote shipping" }
      permission: Customer
      emit ShippingQuoted
    }

    authorizePayment() {
      title: { pt-BR: "Autorizar pagamento", en: "Authorize payment" }
      permission: Customer
      emit PaymentAuthorized
    }

    confirmOrder() {
      title: { pt-BR: "Confirmar pedido", en: "Confirm order" }
      permission: Customer
      emit OrderConfirmed
    }
  }
}
