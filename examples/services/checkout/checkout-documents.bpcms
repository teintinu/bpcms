// service: example.com/services/checkout
document CheckoutSession {
  title: { pt-BR: "Sessão de finalização", en: "Checkout session" }
  version: 1
  owner: "Checkout"
  sync: live
  fields {
    customer: User {
      title: { pt-BR: "Cliente", en: "Customer" }
      lookup
    }
    total: std.Money {
      title: { pt-BR: "Total", en: "Total" }
      currency: BRL
    }
    status: string {
      title: { pt-BR: "Situação", en: "Status" }
      lookup
    }
  }

  events {
Validated {
      title: { pt-BR: "Operação não permitida", en: "Operation not allowed" }
      key: this.id
    }
ShippingQuoted {
      title: { pt-BR: "Operação não permitida", en: "Operation not allowed" }
      key: this.id
    }
PaymentAuthorized {
      title: { pt-BR: "Operação não permitida", en: "Operation not allowed" }
      key: this.id
    }
OrderConfirmed {
      title: { pt-BR: "Operação não permitida", en: "Operation not allowed" }
      key: this.id
    }
  }

  actions {
validateCart() {
      title: { pt-BR: "Operação não permitida", en: "Operation not allowed" }
      roles: [Customer]
      {
      emit Validated
      }
    }

quoteShipping() {
      title: { pt-BR: "Operação não permitida", en: "Operation not allowed" }
      roles: [Customer]
      {
      emit ShippingQuoted
      }
    }

authorizePayment() {
      title: { pt-BR: "Operação não permitida", en: "Operation not allowed" }
      roles: [Customer]
      {
      emit PaymentAuthorized
      }
    }

confirmOrder() {
      title: { pt-BR: "Operação não permitida", en: "Operation not allowed" }
      roles: [Customer]
      {
      emit OrderConfirmed
      }
    }
  }
}
