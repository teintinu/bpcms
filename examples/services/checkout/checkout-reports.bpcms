// service: example.com/services/checkout
view Funnel {
  title: { pt-BR: "Funil de finalização", en: "Checkout funnel" }
  type: report
  sources: [CheckoutSession]
  roles: [SupportAgent]

  filters { period; status }
  metrics {
    started: count(CheckoutSession)
    validated: count(CheckoutSession) where status != Draft
    paid: count(CheckoutSession) where status == Confirmed
    abandoned: count(CheckoutSession) where status == Abandoned
    revenue: sum(CheckoutSession.total) where status == Confirmed
  }
  units { revenue: BRL }
  freshness: 10m
  export: [pdf, csv]
}

view SessionPulse {
  title: { pt-BR: "Pulso das finalizações", en: "Session pulse" }
  type: dashboard
  sources: [CheckoutSession]
  roles: [SupportAgent]
  mode: live

  filters { status }
  metrics {
    awaitingPayment: count(CheckoutSession) where status == PaymentAuthorized
    awaitingQuote: count(CheckoutSession) where status == Validated
    abandonedToday: count(CheckoutSession) where status == Abandoned
  }
  freshness: 1m
}
