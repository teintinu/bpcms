// service: example.com/services/checkout
process Checkout {
  title: { pt-BR: "Finalização da compra", en: "Checkout" }
  version: 1
  goal: "Validar carrinho, cotar frete, autorizar pagamento e confirmar pedido"
  start on CheckoutSession.Validated
  end on CheckoutSession.OrderConfirmed

  task ValidateCart {
    type: service
    action: CheckoutSession.validateCart
  }

  task QuoteShipping {
    type: service
    action: CheckoutSession.quoteShipping
  }

  task AuthorizePayment {
    type: service
    action: CheckoutSession.authorizePayment
  }

  task ConfirmOrder {
    type: service
    action: CheckoutSession.confirmOrder
  }

  ValidateCart -> QuoteShipping
  QuoteShipping -> AuthorizePayment
  AuthorizePayment -> ConfirmOrder
}
