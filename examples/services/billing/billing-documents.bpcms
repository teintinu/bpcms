// service: example.com/services/billing
document InvoiceItem {
  title: { pt-BR: "Item da nota", en: "Invoice item" }
  version: 1
  owner: "Billing"
  sync: live

  fields {
    invoice: link Invoice { number }
    product: link Product { sku, name } // TODO quando estiver revisando documento, rever sobre lookup-indices de lookup, view de lookup...
    quantity: std.Count { title: { pt-BR: "Quantidade", en: "Quantity" }, lookup }
    unitPrice: std.Money { title: { pt-BR: "Preço unitário", en: "Unit price" }, currency: BRL }
    total: std.Money { title: { pt-BR: "Total", en: "Total" }, currency: BRL }
  }

  indexes {
    byInvoice: [invoice.id] hash
  }

  rules {
    total == quantity * unitPrice
  }
}

document Invoice {
  title: { pt-BR: "Nota fiscal", en: "Invoice" }
  version: 1
  owner: "Billing"
  sync: live
  audit: true
  retention: 5y

  fields {
    number: string { title: { pt-BR: "Número", en: "Number" }, maxLength: 40, unique, lookup }
    series: string { title: { pt-BR: "Série", en: "Series" }, maxLength: 10 }
    order: link Order { status, createdAt }
    customer: link User { name, nickname }
    items: InvoiceItem[] { title: { pt-BR: "Itens", en: "Items" } }
    subtotal: std.Money { title: { pt-BR: "Subtotal", en: "Subtotal" }, currency: BRL }
    tax: std.Money { title: { pt-BR: "Imposto", en: "Tax" }, currency: BRL }
    total: std.Money { title: { pt-BR: "Total", en: "Total" }, lookup, currency: BRL }
    status: InvoiceStatus { title: { pt-BR: "Status", en: "Status" } }
    issuedAt: DateTime? { title: { pt-BR: "Emitido em", en: "Issued at" } }
    dueAt: DateTime? { title: { pt-BR: "Vence em", en: "Due at" } }
  }

  indexes {
    number: [series, number] unique
    byOrder: [order.id] hash
    byStatus: [status, dueAt] range
  }

  actions {
    issue(series: string, number: string): Invoice
    cancel(reason: string): Invoice
    closeMonth(): void
  }

  rules {
    total == subtotal + tax
    total == items.sum(total)
    status == issued implies issuedAt != null
  }
}

document CreditNote {
  title: { pt-BR: "Nota de crédito", en: "Credit note" }
  version: 1
  owner: "Billing"
  sync: live
  audit: true

  fields {
    invoice: link Invoice { number }
    amount: std.Money { title: { pt-BR: "Valor", en: "Amount" }, lookup, currency: BRL }
    reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
    status: CreditNoteStatus { title: { pt-BR: "Status", en: "Status" }, lookup }
    issuedAt: DateTime? { title: { pt-BR: "Emitido em", en: "Issued at" } }
  }

  indexes {
    byInvoice: [invoice.id] hash
    byStatus: [status, issuedAt] range
  }

  actions {
    issue(): CreditNote
    apply(): CreditNote
  }

  rules {
    amount > 0
    amount <= 100000 BRL
  }
}

document Bill {
  title: { pt-BR: "Conta a pagar", en: "Bill" }
  version: 1
  owner: "Billing"
  sync: read
  audit: true

  fields {
    supplier: string { title: { pt-BR: "Fornecedor", en: "Supplier" }, maxLength: 120, lookup }
    amount: std.Money { title: { pt-BR: "Valor", en: "Amount" }, lookup, currency: BRL }
    dueAt: DateTime { title: { pt-BR: "Vence em", en: "Due at" } }
    status: BillStatus { title: { pt-BR: "Status", en: "Status" }, lookup }
    paidAt: DateTime? { title: { pt-BR: "Pago em", en: "Paid at" } }
  }

  indexes {
    byStatus: [status, dueAt] range
  }

  actions {
    pay(): Bill
  }

  rules {
    amount > 0
  }
}

document OrderCancellation {
  title: { pt-BR: "Cancelamento de pedido", en: "Order cancellation" }
  version: 1
  owner: "Billing"
  sync: live
  audit: true

  fields {
    order: link Order { status, createdAt }
    reason: string { title: { pt-BR: "Motivo", en: "Reason" }, lookup }
    cancelledAt: DateTime { title: { pt-BR: "Cancelado em", en: "Cancelled at" } }
  }

  actions {
    cancel(reason: string): Order
  }

  rules {
    reason != null
  }
}

document MonthlyRevenue {
  title: { pt-BR: "Receita mensal", en: "Monthly revenue" }
  version: 1
  owner: "Billing"
  computed from Invoice, Payment
  freshness: 1h
  sync: read

  fields {
    month: YearMonth { title: { pt-BR: "Mês", en: "Month" }, lookup }
    revenue: std.Money { title: { pt-BR: "Receita", en: "Revenue" }, lookup, currency: BRL }
    invoiceCount: std.Count { title: { pt-BR: "Qtd. de notas", en: "Invoice count" } }
    calculatedAt: DateTime { title: { pt-BR: "Calculado em", en: "Calculated at" } }
  }

  indexes { month: [month] unique }

  actions { refresh(): MonthlyRevenue }

  rules { month >= 2026-01 }
}
