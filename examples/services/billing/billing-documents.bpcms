// service: example.com/services/billing
shape InvoiceItem {
  title: { pt-BR: "Item da nota", en: "Invoice item" }

  fields {
    product: Product {
      title: { pt-BR: "Produto", en: "Product" }
      lookup
    }
    quantity: std.Count {
      title: { pt-BR: "Quantidade", en: "Quantity" }
      lookup
    }
    unitPrice: std.Money {
      title: { pt-BR: "Preço unitário", en: "Unit price" }
      currency: BRL
    }
    total: std.Money {
      title: { pt-BR: "Total", en: "Total" }
      currency: BRL
      computed: quantity * unitPrice
    }
  }
}

scopable document Store {
  title: { pt-BR: "Loja", en: "Store" }
  fields {
    code: string {
      title: { pt-BR: "Código", en: "Code" }
      maxLength: 8
      unique
      lookup
      required
    }
    name: string {
      title: { pt-BR: "Nome", en: "Name" }
      maxLength: 120
      lookup
      required
    }
  }

  seed {
    SP {
      code: "SP"
      name: "São Paulo"
    }
    RJ {
      code: "RJ"
      name: "Rio de Janeiro"
    }
  }
}

scopable document FiscalYear {
  title: { pt-BR: "Exercício fiscal", en: "Fiscal year" }
  fields {
    year: integer {
      title: { pt-BR: "Ano", en: "Year" }
      unique
      lookup
      required
    }
    startsAt: DateTime { title: { pt-BR: "Início", en: "Start" } }
    endsAt: DateTime { title: { pt-BR: "Fim", en: "End" } }
  }

  seed {
    Y2026 {
      year: 2026
      startsAt: 2026-01-01
      endsAt: 2026-12-31
    }
  }
}

document Invoice {
  title: { pt-BR: "Nota fiscal", en: "Invoice" }
  version: 1
  owner: "Billing"
  sync: live
  retention: 5y

  fields {
    store: Store {
      title: { pt-BR: "Loja", en: "Store" }
      required
      default: Store.SP
    }
    fiscalYear: FiscalYear {
      title: { pt-BR: "Exercício", en: "Fiscal year" }
      required
      default: FiscalYear.Y2026
    }
    number: InvoiceNumber {
      title: { pt-BR: "Número", en: "Number" }
      format: "{fiscalYear.year:yy}-{store.code:4}-{sequence:6}"
      sequence: per(Store, FiscalYear)
      unique
      lookup
    }
    order: Order {
      title: { pt-BR: "Pedido", en: "Order" }
    }
    customer: User {
      title: { pt-BR: "Cliente", en: "Customer" }
      lookup
    }
    items: InvoiceItem[] { title: { pt-BR: "Itens", en: "Items" } }
    subtotal: std.Money {
      title: { pt-BR: "Subtotal", en: "Subtotal" }
      currency: BRL
      computed: items.sum(total)
    }
    tax: std.Money { title: { pt-BR: "Imposto", en: "Tax" }, currency: BRL }
    total: std.Money {
      title: { pt-BR: "Total", en: "Total" }
      lookup
      currency: BRL
      computed: subtotal + tax
    }
    status: InvoiceStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    issuedAt: DateTime { title: { pt-BR: "Emitido em", en: "Issued at" } }
    dueAt: DateTime { title: { pt-BR: "Vence em", en: "Due at" } }
  }

  indexes {
    number: [number] unique
    byOrder: [order.id] hash
    byStatus: [status, dueAt] range
  }

  events {
    Requested {
      title: { pt-BR: "Nota solicitada", en: "Invoice requested" }
      payload {
        order: Order { title: { pt-BR: "Pedido", en: "Order" } }
      }
    }
  }

  actions {
    create(order: Order){
      title: { pt-BR: "Solicitar nota", en: "Request invoice" }
      roles: [Clerk]
      returns: Invoice
      {
        customer = order.customer
        emit Requested { order: order }
      }
    }

    deriveFromOrder(){
      title: { pt-BR: "Derivar do pedido", en: "Derive from order" }
      roles: [Clerk]
    }

    applyTax(){
      title: { pt-BR: "Aplicar imposto", en: "Apply tax" }
      roles: [Clerk]
    }

    issue(){
      title: { pt-BR: "Emitir", en: "Issue" }
      roles: [FinanceManager]

      to: status.Issued
      emits { issuedAt: now() }

      rule total > 0 BRL {
        pt-BR: "O valor deve ser maior que zero"
        en: "Value must be greater than zero"
      }

      {
        issuedAt = now()
      }
    }

    pay(paidAt: DateTime){
      title: { pt-BR: "Pagar", en: "Pay" }
      roles: [Clerk]

      to: status.Paid
      emits { amount: total }
    }

    markOverdue(){
      title: { pt-BR: "Marcar vencida", en: "Mark overdue" }
      roles: [Clerk]

      to: status.Overdue
    }

    cancel(reason: string){
      title: { pt-BR: "Cancelar", en: "Cancel" }
      roles: [FinanceManager]

      to: status.Cancelled

      rule reason.length >= 10 {
        pt-BR: "Informe um motivo com pelo menos 10 caracteres"
        en: "Enter a reason with at least 10 characters"
      }
    }
  }

  rule status == Issued implies issuedAt != null {
    pt-BR: "Informe a data de emissão"
    en: "Enter the issue date"
  }
}

document CreditNote {
  title: { pt-BR: "Nota de crédito", en: "Credit note" }
  version: 1
  owner: "Billing"
  sync: live
  fields {
    invoice: Invoice {
      title: { pt-BR: "Nota fiscal", en: "Invoice" }
      lookup
    }
    amount: std.Money { title: { pt-BR: "Valor", en: "Amount" }, lookup, currency: BRL }
    reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
    status: CreditNoteStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    issuedAt: DateTime { title: { pt-BR: "Emitido em", en: "Issued at" } }
    appliedAt: DateTime { title: { pt-BR: "Aplicado em", en: "Applied at" } }
  }

  indexes {
    byInvoice: [invoice.id] hash
    byStatus: [status, issuedAt] range
  }


  actions {
    issue(){
      title: { pt-BR: "Emitir", en: "Issue" }
      roles: [FinanceManager]

      to: status.Issued
      emits { issuedAt: now() }

      {
        issuedAt = now()
      }
    }

    apply(){
      title: { pt-BR: "Aplicar", en: "Apply" }
      roles: [FinanceManager]

      to: status.Applied
      emits { appliedAt: now() }

      {
        appliedAt = now()
      }
    }
  }

  rule amount > 0 {
    pt-BR: "O valor deve ser maior que zero"
    en: "Amount must be greater than zero"
  }
  rule amount <= 100000 BRL {
    pt-BR: "O valor excede o limite de 100.000 BRL"
    en: "Amount exceeds the 100,000 BRL limit"
  }
}

document Bill {
  title: { pt-BR: "Conta a pagar", en: "Bill" }
  version: 1
  owner: "Billing"
  sync: read
  fields {
    supplier: string { title: { pt-BR: "Fornecedor", en: "Supplier" }, maxLength: 120, lookup }
    amount: std.Money { title: { pt-BR: "Valor", en: "Amount" }, lookup, currency: BRL }
    dueAt: DateTime { title: { pt-BR: "Vence em", en: "Due at" } }
    status: BillStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    paidAt: DateTime { title: { pt-BR: "Pago em", en: "Paid at" } }
  }

  indexes {
    byStatus: [status, dueAt] range
  }


  actions {
    pay(paidAt: DateTime){
      title: { pt-BR: "Pagar", en: "Pay" }
      roles: [Clerk]

      to: status.Paid
      emits { paidAt: now() }

      {
        paidAt = now()
      }
    }

    markOverdue(){
      title: { pt-BR: "Marcar vencida", en: "Mark overdue" }
      roles: [Clerk]

      to: status.Overdue
    }
  }

  rule amount > 0 {
    pt-BR: "O valor deve ser maior que zero"
    en: "Amount must be greater than zero"
  }
}

document OrderCancellation {
  title: { pt-BR: "Cancelamento de pedido", en: "Order cancellation" }
  version: 1
  owner: "Billing"
  sync: live
  fields {
    order: Order {
      title: { pt-BR: "Pedido", en: "Order" }
      lookup
    }
    reason: string { title: { pt-BR: "Motivo", en: "Reason" }, lookup }
    cancelledAt: DateTime { title: { pt-BR: "Cancelado em", en: "Cancelled at" } }
  }

  actions {
    cancel(reason: string){
      title: { pt-BR: "Cancelar", en: "Cancel" }
      roles: [FinanceManager]
      rule reason.length >= 10 {
        pt-BR: "Informe um motivo com pelo menos 10 caracteres"
        en: "Enter a reason with at least 10 characters"
      }
    }
  }

  rule reason != null {
    pt-BR: "Preencha os campos obrigatórios"
    en: "Fill the required fields"
  }
}

document FiscalPeriod {
  title: { pt-BR: "Período fiscal", en: "Fiscal period" }
  version: 1
  owner: "Billing"
  sync: live

  fields {
    store: Store {
      title: { pt-BR: "Loja", en: "Store" }
      required
    }
    month: YearMonth {
      title: { pt-BR: "Mês", en: "Month" }
      lookup
      required
    }
    status: FiscalPeriodStatus {
      title: { pt-BR: "Situação", en: "Status" }
      lookup
    }
    invoiceCount: std.Count { title: { pt-BR: "Qtd. de notas", en: "Invoice count" } }
    revenue: std.Money { title: { pt-BR: "Receita", en: "Revenue" }, lookup, currency: BRL }
    tax: std.Money { title: { pt-BR: "Imposto", en: "Tax" }, currency: BRL }
    closedAt: DateTime { title: { pt-BR: "Fechado em", en: "Closed at" } }
    failureReason: string { title: { pt-BR: "Motivo da falha", en: "Failure reason" } }
  }

  indexes {
    byPeriod: [store.id, month] unique
    byStatus: [status, month] range
  }


  actions {
    consolidate(){
      title: { pt-BR: "Consolidar período", en: "Consolidate period" }
      roles: [FinanceManager]
    }

    close(){
      title: { pt-BR: "Fechar período", en: "Close period" }
      roles: [FinanceManager]

      to: status.Closed

      {
        closedAt = now()
      }
    }

    fail(reason: string){
      title: { pt-BR: "Registrar falha", en: "Record failure" }
      roles: [FinanceManager]

      to: status.Failed

      rule reason.length >= 5 {
        pt-BR: "Informe o motivo da falha"
        en: "Enter the failure reason"
      }

      {
        failureReason = reason
      }
    }
  }
}

document MonthlyRevenue {
  title: { pt-BR: "Receita mensal", en: "Monthly revenue" }
  version: 1
  owner: "Billing"
  computed from Invoice, Payment
  freshness: 1h
  sync: read

  fields {
    month: YearMonth { title: { pt-BR: "Mês", en: "Month" }, lookup }
    revenue: std.Money { title: { pt-BR: "Receita", en: "Revenue" }, lookup, currency: BRL }
    invoiceCount: std.Count { title: { pt-BR: "Qtd. de notas", en: "Invoice count" } }
    calculatedAt: DateTime { title: { pt-BR: "Calculado em", en: "Calculated at" } }
  }

  indexes { month: [month] unique }

  actions {
    refresh(){
      title: { pt-BR: "Atualizar", en: "Refresh" }
      roles: [FinanceManager]
    }
  }

  rule month >= 2026-01 {
    pt-BR: "Verifique os dados informados"
    en: "Check the informed data"
  }
}
