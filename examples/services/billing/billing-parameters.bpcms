// service: example.com/services/billing
parameter TaxRegime {
  title: { pt-BR: "Regime tributário", en: "Tax regime" }
  type: TaxRegimeCode
  source: config
  default: "SIMPLES"
}

parameter InvoiceSeries {
  title: { pt-BR: "Série da nota", en: "Invoice series" }
  type: Text
  source: config
  default: "A"
  maxLength: 10
}
