// service: example.com/services/billing
form DunningCancellation {
  title: { pt-BR: "Cancelar nota vencida", en: "Cancel overdue invoice" }
  document: Invoice

  fields {
    number
    customer
    total
    dueAt
    reason: string {
      title: { pt-BR: "Motivo do cancelamento", en: "Cancellation reason" }
      maxLength: 500
      required
    }
  }

  actions {
    cancel { calls: Invoice.cancel(reason) }
  }
}

form MonthCloseReview {
  title: { pt-BR: "Revisar fechamento", en: "Review month close" }
  document: FiscalPeriod

  fields {
    store
    month
    revenue
    tax
    invoiceCount
    reason: string {
      title: { pt-BR: "Motivo da falha", en: "Failure reason" }
      maxLength: 500
    }
  }

  actions {
    close { calls: FiscalPeriod.close }
    fail { calls: FiscalPeriod.fail(reason) }
  }
}
