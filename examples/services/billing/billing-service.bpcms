service "example.com/services/billing" {
  title: { pt-BR: "Faturamento", en: "Billing" }
  version: 1.0.0
  owner: "Billing"
  imports {
    service "example.com/services/orders" as Orders
    service "example.com/services/payments" as Payments
    service "example.com/services/identity" as Identity
  }
  requires { oltp, scheduling, attachments, identity, timezone, regionalization, units }
  provides { billing }

  // Ativo apenas em apps que incluem billing na closure.
  override "example.com/services/orders#Order.cancel" {
    with: "example.com/services/billing#OrderCancellation.cancel"
  }
}
