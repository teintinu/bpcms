// service: example.com/services/billing

view CashFlow {
  title: { pt-BR: "Fluxo de caixa", en: "Cash flow" }
  type: report
  sources: [Invoice, Payment, Bill]
  roles: [FinanceManager]

  filters { period; store }

  metrics {
    inflow: sum(Payment.amount) where status == Captured
    outflow: sum(Bill.amount) where status == Paid
    balance: inflow - outflow
  }

  units { inflow: BRL; outflow: BRL; balance: BRL }
  freshness: 1h
  export: [pdf, csv]
}

view RevenueControl {
  title: { pt-BR: "Controle de faturamento", en: "Billing control" }
  type: dashboard
  sources: [Invoice, Bill]
  roles: [FinanceManager]
  mode: live

  filters { status; period }

  metrics {
    overdue: count(Invoice) where status == Overdue
    openBills: count(Bill) where status != Paid
  }

  freshness: 15m
}

view DunningInbox {
  title: { pt-BR: "Fila de cobrança", en: "Dunning queue" }
  type: inbox
  roles: [CollectionAgent, FinanceManager]

  scope: lanes
  filter { lane in currentUser.lanes }
  groupBy: process
  columns { title; subject; lane; dueAt; priority }
}
