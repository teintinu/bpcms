// service: example.com/services/billing
view InvoiceTable {
  title: { pt-BR: "Notas fiscais", en: "Invoices" }
  type: table
  source: Invoice
  roles: [Clerk, CollectionAgent, FinanceManager]

  columns { number; customer; total; status; dueAt }
  filters { status; period; customer }
  pagination: 50

  actions {
    open -> InvoiceDetail
    issue -> Invoice.issue
    cancel -> Invoice.cancel(reason)
  }
}

view InvoiceDetail {
  title: { pt-BR: "Detalhe da nota", en: "Invoice detail" }
  type: detail
  document: Invoice
  roles: [Clerk, CollectionAgent, FinanceManager]

  sections { summary; items; customer; timeline }

  actions {
    pay -> Invoice.pay(paidAt)
    cancel -> Invoice.cancel(reason)
  }
}

view InvoiceKanban {
  title: { pt-BR: "Notas por situação", en: "Invoices by status" }
  type: kanban
  source: Invoice
  roles: [Clerk, CollectionAgent, FinanceManager]

  groupBy: status
  columns { number; customer; total; dueAt }
  card { number; customer; total; dueAt }

  actions {
    open -> InvoiceDetail
  }
}

view InvoiceProgress {
  title: { pt-BR: "Andamento da emissão", en: "Invoice issuance progress" }
  type: process
  process: InvoiceIssuance
  roles: [Clerk, FinanceManager]

  sections { current; participants; history; deadlines; documents; milestones; next }
}

view DunningInbox {
  title: { pt-BR: "Fila de cobrança", en: "Dunning queue" }
  type: inbox
  roles: [CollectionAgent, FinanceManager]

  scope: lanes
  filter { lane in currentUser.lanes }
  groupBy: process
  columns { title; subject; lane; dueAt; priority }
}

view MonthCloseProgress {
  title: { pt-BR: "Andamento do fechamento", en: "Month close progress" }
  type: process
  process: MonthClose
  roles: [FinanceManager]

  sections { current; participants; history; deadlines; documents; milestones; next }
}
