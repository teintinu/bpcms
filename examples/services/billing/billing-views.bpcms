// service: example.com/services/billing
view InvoiceForm {
  title: { pt-BR: "Formulário de nota", en: "Invoice form" }
  type: form
  document: Invoice
  roles: [Manager]

  fields {
    order: Order { title: { pt-BR: "Pedido", en: "Order" }, required }
    series: string { title: { pt-BR: "Série", en: "Series" }, required }
    number: string { title: { pt-BR: "Número", en: "Number" }, required }
    status: InvoiceStatus { title: { pt-BR: "Situação", en: "Status" }, readonly }
  }

  actions {
    save -> Invoice.issue
    cancel -> none
  }
}

view InvoiceDetail {
  title: { pt-BR: "Detalhe da nota", en: "Invoice detail" }
  type: detail
  document: Invoice
  roles: [Manager]

  sections { summary; items; customer; timeline }
  actions { issue; print; cancel }
}
