// service: example.com/services/identity
shape UserId {
  base: text
  validate: uuid
  format: plain
  index: exact
}

shape SessionId {
  base: text
  validate: uuid
  format: plain
  index: exact
}

shape CustomerId {
  base: text
  validate: uuid
  format: plain
  index: exact
}

shape UserStatus {
  base: text
  values: [active, suspended, disabled]
  format: plain
}

shape SessionStatus {
  base: text
  values: [active, ended, expired]
  format: plain
}

shape CustomerSnapshot {
  fields {
    id: CustomerId
    name: Text
    email: Email
    taxId: Text?
  }
  format: plain
}
