// service: example.com/services/identity



shape UserStatus {
  title: { pt-BR: "Situação do usuário", en: "User status" }
  base: workflow
  initial: Active
  value Active {
    title: { pt-BR: "Ativo", en: "Active" }
    icon: Active
    ordinal: 10
    transition Suspended {
      title: { pt-BR: "Suspenso", en: "Suspended" }
    }
    transition Disabled {
      title: { pt-BR: "Desativado", en: "Disabled" }
    }
  }
  value Suspended {
    title: { pt-BR: "Suspenso", en: "Suspended" }
    icon: Suspended
    ordinal: 20
    transition Active {
      title: { pt-BR: "Ativo", en: "Active" }
    }
    transition Disabled {
      title: { pt-BR: "Desativado", en: "Disabled" }
    }
  }
  value Disabled {
    title: { pt-BR: "Desativado", en: "Disabled" }
    icon: Disabled
    ordinal: 30
  }
  format: plain

}

shape SessionStatus {
  title: { pt-BR: "Situação da sessão", en: "Session status" }
  base: workflow
  initial: Active
  value Active {
    title: { pt-BR: "Ativo", en: "Active" }
    icon: Active
    ordinal: 10
    transition Ended {
      title: { pt-BR: "Encerrada", en: "Ended" }
    }
    transition Expired {
      title: { pt-BR: "Expirada", en: "Expired" }
    }
  }
  value Ended {
    title: { pt-BR: "Encerrada", en: "Ended" }
    icon: Ended
    ordinal: 20
  }
  value Expired {
    title: { pt-BR: "Expirada", en: "Expired" }
    icon: Expired
    ordinal: 30
  }
  format: plain

}
