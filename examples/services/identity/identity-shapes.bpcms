// service: example.com/services/identity



shape UserStatus {
  title: { pt-BR: "Status do usuário", en: "User status" }
  base: text
  values {
    active {
      title: { pt-BR: "Ativo", en: "Active" }
      icon: Active
    }
    suspended {
      title: { pt-BR: "Suspenso", en: "Suspended" }
      icon: Suspended
    }
    disabled {
      title: { pt-BR: "Desativado", en: "Disabled" }
      icon: Disabled
    }
  }
  format: plain
}

shape SessionStatus {
  title: { pt-BR: "Status da sessão", en: "Session status" }
  base: text
  values {
    active {
      title: { pt-BR: "Ativo", en: "Active" }
      icon: Active
    }
    ended {
      title: { pt-BR: "Encerrada", en: "Ended" }
      icon: Ended
    }
    expired {
      title: { pt-BR: "Expirada", en: "Expired" }
      icon: Expired
    }
  }
  format: plain
}

shape Count {
  title: { pt-BR: "Contagem", en: "Count" }
  base: integer
  min: 0
  precision: 0
  format: plain
  aggregate: sum
}
