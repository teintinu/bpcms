// service: example.com/services/identity

shape UserStatus {
  title: { pt-BR: "Situação do usuário", en: "User status" }
  base: state
  initial: Active
  value Active {
    title: { pt-BR: "Ativo", en: "Active" }
    icon: Active
    ordinal: 10

    transition Suspended {
      title: { pt-BR: "Usuário suspenso", en: "User suspended" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }

    transition Disabled {
      title: { pt-BR: "Usuário desativado", en: "User disabled" }
    }
  }
  value Suspended {
    title: { pt-BR: "Suspenso", en: "Suspended" }
    icon: Suspended
    ordinal: 20

    transition Disabled {
      title: { pt-BR: "Usuário desativado", en: "User disabled" }
    }

    transition Active {
      event: Unlocked
      title: { pt-BR: "Acesso liberado", en: "Access unlocked" }
    }
  }
  value Disabled {
    title: { pt-BR: "Desativado", en: "Disabled" }
    icon: Disabled
    ordinal: 30

    transition Active {
      event: Unlocked
      title: { pt-BR: "Acesso liberado", en: "Access unlocked" }
    }
  }
  format: plain
}

shape SessionStatus {
  title: { pt-BR: "Situação da sessão", en: "Session status" }
  base: state
  initial: Active
  value Active {
    title: { pt-BR: "Ativa", en: "Active" }
    icon: Active
    ordinal: 10

    transition Ended {
      title: { pt-BR: "Sessão encerrada", en: "Session ended" }
    }

    transition Expired {
      title: { pt-BR: "Sessão expirada", en: "Session expired" }
    }
  }
  value Ended {
    title: { pt-BR: "Encerrada", en: "Ended" }
    icon: Ended
    ordinal: 20
  }
  value Expired {
    title: { pt-BR: "Expirada", en: "Expired" }
    icon: Expired
    ordinal: 30
  }
  format: plain
}
