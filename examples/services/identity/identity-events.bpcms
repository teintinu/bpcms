// service: example.com/services/identity
event UserLoggedIn {
  title: { pt-BR: "Usuário autenticado", en: "User logged in" }
  version: 1
  payload {
    userId: UserId { title: { pt-BR: "Usuário", en: "User" } }
    at: DateTime { title: { pt-BR: "Data/hora", en: "At" } }
  }
  producer: Session
  consumers: [Notifications]
  key: userId
}
