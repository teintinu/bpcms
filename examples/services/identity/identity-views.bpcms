// service: example.com/services/identity
view LoginForm {
  title: { pt-BR: "Formulário de login", en: "Login form" }
  type: form
  document: User

  fields {
    email: Email { title: { pt-BR: "E-mail", en: "Email" }, required }
    password: string { title: { pt-BR: "Password", en: "Password" }, maxLength: 128, required }
  }

  actions {
    login -> Session.start
    cancel -> none
  }
}

view CitizenAccounts {
  title: { pt-BR: "Usuários do cidadão", en: "Citizen accounts" }
  type: table
  source: Consumer
  roles: [Clerk, Manager]

  columns { nickname; email; citizenId; status }
  filters { citizenId; status }
  pagination: 50
}
