// service: example.com/services/identity

view CitizenAccounts {
  title: { pt-BR: "Usuários do cidadão", en: "Citizen accounts" }
  type: table
  source: Consumer
  roles: [Clerk, Manager]

  columns { nickname; email; citizen; status }
  filters { citizen; status }
  pagination: 50
}

view RecoveryQueue {
  title: { pt-BR: "Fila de recuperação de acesso", en: "Account recovery queue" }
  type: inbox
  roles: [Clerk, Manager]
  scope: lanes
  groupBy: lane
  filter { lane in currentUser.lanes }
  columns { title; subject; lane; dueAt; priority }
}

view RecoveryProgress {
  title: { pt-BR: "Andamento da recuperação", en: "Recovery progress" }
  type: process
  process: AccountRecovery
  roles: [Clerk, Manager, Customer]

  sections { current; participants; history; deadlines; documents; next }
}
