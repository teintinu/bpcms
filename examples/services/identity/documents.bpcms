// service: example.com/services/identity
document User {
  version: 1
  owner: "Identity"
  sync: read
  audit: true

  fields {
    id: UserId
    name: Text { maxLength: 120, required: true }
    email: Email { unique: true }
    status: UserStatus
    private loginAttempts: Count
    createdAt: DateTime
  }

  indexes {
    email: [email] unique
    byStatus: [status, createdAt] range
  }

  actions {
    create(name: Text, email: Email): User
    disable(): User
    private recalculateRisk(): Count
  }

  rules {
    status in [active, suspended, disabled]
  }
}

document Session {
  version: 1
  owner: "Identity"
  sync: read

  fields {
    id: SessionId
    userId: UserId
    issuedAt: DateTime
    expiresAt: DateTime
    status: SessionStatus
  }

  indexes {
    byUser: [userId, issuedAt] range
    byExpiry: [expiresAt] range
  }

  actions {
    start(email: Email, password: Text): Session
    end(): Session
  }

  rules {
    expiresAt > issuedAt
  }
}
