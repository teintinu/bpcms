// service: example.com/services/identity

document User {
  title: { pt-BR: "Usuário", en: "User" }
  version: 1
  owner: "Identity"
  sync: read
  fields {
    name: string {
      title: {
        pt-BR: "Nome da pessoa"
        en: "Person name"
        short: { pt-BR: "Pessoa", en: "Person" }
        tooltip: { pt-BR: "Nome completo da pessoa", en: "Full person name" }
      }
      maxLength: 120
      lookup
      required
    }
    nickname: string { title: { pt-BR: "Apelido", en: "Nickname" }, maxLength: 40, lookup }
    avatar: Image { title: { pt-BR: "Imagem de perfil", en: "Avatar" }, lookup }
    email: Email { title: { pt-BR: "Correio eletrônico", en: "Email" }, unique, lookup }
    status: UserStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    identityVerifiedAt: DateTime { title: { pt-BR: "Identidade verificada em", en: "Identity verified at" } }
    recoveryApprovedAt: DateTime { title: { pt-BR: "Recuperação aprovada em", en: "Recovery approved at" } }
    private loginAttempts: std.Count { title: { pt-BR: "Tentativas de acesso", en: "Login attempts" } }
    createdAt: DateTime { title: { pt-BR: "Criado em", en: "Created at" } }
  }

  indexes {
    email: [email] unique
    byStatus: [status, createdAt] range
  }

  events {
    Created {
      title: { pt-BR: "Usuário criado", en: "User created" }
      payload {
        name: string { title: { pt-BR: "Nome", en: "Name" } }
      }
    }
  }

  actions {
    create(name: string, email: Email){
      title: { pt-BR: "Criar usuário", en: "Create user" }
      roles: [Admin]
      {
        createdAt = now()
        emit Created { name }
      }
    }

    suspend(justification: string){
      title: { pt-BR: "Suspender", en: "Suspend" }
      roles: [Admin]
      to: status.Suspended
      emits { reason: justification }
    }

    disable(){
      title: { pt-BR: "Desativar", en: "Disable" }
      roles: [Manager]
      to: status.Disabled
    }

    unlock(){
      title: { pt-BR: "Desbloquear", en: "Unlock" }
      roles: [Manager]
      to: status.Active
    }

    confirmIdentity(){
      title: { pt-BR: "Confirmar identidade", en: "Confirm identity" }
      roles: [Clerk]
      {
        identityVerifiedAt = now()
      }
    }

    approveRecovery(){
      title: { pt-BR: "Aprovar recuperação", en: "Approve recovery" }
      roles: [Manager]
      {
        recoveryApprovedAt = now()
      }
    }

    private recalculateRisk(){
      title: { pt-BR: "Recalcular risco", en: "Recalculate risk" }
      roles: [Admin]
      returns: std.Count
    }
  }

  rule recoveryApprovedAt != null implies identityVerifiedAt != null {
    pt-BR: "A recuperação exige a verificação de identidade antes da aprovação"
    en: "Recovery requires identity verification before approval"

  }
}

// Consumer compartilha User: Consumer é alias do mesmo id.
// Vários Users podem referenciar o mesmo Citizen; não há unique aqui.
document Consumer extends User {
  title: { pt-BR: "Consumidor", en: "Consumer" }
  version: 1
  owner: "Identity"
  sync: read

  fields {
    citizen: Citizen {
      title: { pt-BR: "Cidadão", en: "Citizen" }
    }
  }

  indexes {
    byCitizen: [citizen.id] hash
  }

  actions {
    setCitizen(citizen: Citizen){
      title: { pt-BR: "Vincular cidadão", en: "Link citizen" }
      roles: [Admin]
    }
  }

  rule citizen != null implies status == Active {
    pt-BR: "Cidadão vinculado deve estar ativo"
    en: "Linked citizen must be active"

  }
}

document Session {
  title: { pt-BR: "Sessão", en: "Session" }
  version: 1
  owner: "Identity"
  sync: read

  fields {
    user: User {
      title: { pt-BR: "Usuário", en: "User" }
    }
    issuedAt: DateTime { title: { pt-BR: "Emitido em", en: "Issued at" }, lookup }
    expiresAt: DateTime { title: { pt-BR: "Expira em", en: "Expires at" } }
    status: SessionStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
  }

  indexes {
    byUser: [user.id, issuedAt] range
    byExpiry: [expiresAt] range
  }

  events {
    Started {
      title: { pt-BR: "Sessão iniciada", en: "Session started" }
    }
  }

  actions {
    start(email: Email, password: string){
      title: { pt-BR: "Iniciar sessão", en: "Sign in" }
      roles: [Customer]
      {
        issuedAt = now()
        expiresAt = now() + SessionTtl
        emit Started
      }
    }

    end(){
      title: { pt-BR: "Encerrar", en: "End" }
      roles: [Customer]
      to: status.Ended
    }

    expire(){
      title: { pt-BR: "Expirar", en: "Expire" }
      roles: [Admin]
      to: status.Expired
    }
  }

  rule expiresAt > issuedAt {
    pt-BR: "A expiração deve ser posterior à emissão"
    en: "Expiration must be after issuance"

  }
}
