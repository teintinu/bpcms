// service: example.com/services/identity
document User {
  title: { pt-BR: "Usuário", en: "User" }
  version: 1
  owner: "Identity"
  sync: read
  audit: true

  fields {
    name: string {
      title: {
        pt-BR: "Nome da pessoa"
        en: "Person name"
        short: { pt-BR: "Pessoa", en: "Person" }
        tooltip: { pt-BR: "Nome completo da pessoa", en: "Full person name" }
      }
      maxLength: 120
      lookup
      rules {
        value != null: {
          fields: [name]
          pt-BR: "Informe o nome da pessoa"
          en: "Enter the person name"
        }
      }
    }
    nickname: string { title: { pt-BR: "Apelido", en: "Nickname" }, maxLength: 40, lookup }
    avatar: Image { title: { pt-BR: "Imagem de perfil", en: "Avatar" }, lookup }
    email: Email { title: { pt-BR: "Correio eletrônico", en: "Email" }, unique }
    status: UserStatus { title: { pt-BR: "Situação", en: "Status" } }
    private loginAttempts: std.Count { title: { pt-BR: "Tentativas de acesso", en: "Login attempts" } }
    createdAt: DateTime { title: { pt-BR: "Criado em", en: "Created at" } }
  }

  indexes {
    email: [email] unique
    byStatus: [status, createdAt] range
  }

  actions {
    create(name: string, email: Email){
      title: { pt-BR: "Criar usuário", en: "Create user" }
      roles: [Admin]
      {
      }
    }
    disable(){
      title: { pt-BR: "Desativar", en: "Disable" }
      roles: [Manager]
      {
      }
    }
    private recalculateRisk(): std.Count
  }

  rules {
    status in [active, suspended, disabled]: {
      fields: []
      pt-BR: "Regra do documento não atendida"
      en: "Document rule not met"
    }
  }
}

// Consumer compartilha User: Consumer é alias do mesmo id.
// Vários Users podem referenciar o mesmo Citizen; não há unique aqui.
document Consumer extends User {
  title: { pt-BR: "Consumidor", en: "Consumer" }
  version: 1
  owner: "Identity"
  sync: read

  fields {
    citizen: Citizen {
      title: { pt-BR: "Cidadão", en: "Citizen" }
    }
  }

  indexes {
    byCitizen: [citizen.id] hash
  }

  actions {
    setCitizen(citizen: Citizen){
      title: { pt-BR: "Vincular cidadão", en: "Link citizen" }
      roles: [Admin]
      {
      }
    }
  }

  rules {
    citizen != null implies status == active: {
      fields: []
      pt-BR: "Regra do documento não atendida"
      en: "Document rule not met"
    }
  }
}

document Session {
  title: { pt-BR: "Sessão", en: "Session" }
  version: 1
  owner: "Identity"
  sync: read

  fields {
    user: User {
      title: { pt-BR: "Usuário", en: "User" }
    }
    issuedAt: DateTime { title: { pt-BR: "Emitido em", en: "Issued at" }, lookup }
    expiresAt: DateTime { title: { pt-BR: "Expira em", en: "Expires at" } }
    status: SessionStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
  }

  indexes {
    byUser: [user.id, issuedAt] range
    byExpiry: [expiresAt] range
  }

  actions {
    start(email: Email, password: string){
      title: { pt-BR: "Iniciar sessão", en: "Sign in" }
      roles: [Customer]
      {
      }
    }
    end(){
      title: { pt-BR: "Encerrar", en: "End" }
      roles: [Manager]
      {
      }
    }
  }

  rules {
    expiresAt > issuedAt: {
      fields: []
      pt-BR: "Regra do documento não atendida"
      en: "Document rule not met"
    }
  }
}
