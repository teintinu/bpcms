// service: example.com/services/identity
document User {
  title: { pt-BR: "Usuário", en: "User" }
  version: 1
  owner: "Identity"
  sync: read
  audit: true

  fields {
    name: string {
      title: {
        pt-BR: "Nome da pessoa"
        en: "Person name"
        short: { pt-BR: "Pessoa", en: "Person" }
        tooltip: { pt-BR: "Nome completo da pessoa", en: "Full person name" }
      }
      maxLength: 120
      required
    }
    nickname: string { title: { pt-BR: "Apelido", en: "Nickname" }, maxLength: 40, lookup }
    avatar: Image? { title: { pt-BR: "Avatar", en: "Avatar" }, lookup }
    email: Email { title: { pt-BR: "E-mail", en: "Email" }, unique }
    status: UserStatus { title: { pt-BR: "Status", en: "Status" } }
    private loginAttempts: std.Count { title: { pt-BR: "Tentativas de login", en: "Login attempts" } }
    createdAt: DateTime { title: { pt-BR: "Criado em", en: "Created at" } }
  }

  indexes {
    email: [email] unique
    byStatus: [status, createdAt] range
  }

  actions {
    create(name: string, email: Email): User
    disable(): User
    private recalculateRisk(): std.Count
  }

  rules {
    status in [active, suspended, disabled]
  }
}

// Consumer compartilha UserId: ConsumerId é alias do mesmo id.
// Vários Users podem referenciar o mesmo CitizenId; não há unique aqui.
document Consumer extends User {
  title: { pt-BR: "Consumidor", en: "Consumer" }
  version: 1
  owner: "Identity"
  sync: read

  fields {
    citizen: link Citizen { displayName, avatar }?
  }

  indexes {
    byCitizen: [citizen.id] hash
  }

  actions {
    setCitizen(citizen: CitizenId): Consumer
  }

  rules {
    citizen != null implies status == active
  }
}

document Session {
  title: { pt-BR: "Sessão", en: "Session" }
  version: 1
  owner: "Identity"
  sync: read

  fields {
    user: link User { name }
    issuedAt: DateTime { title: { pt-BR: "Emitido em", en: "Issued at" }, lookup }
    expiresAt: DateTime { title: { pt-BR: "Expira em", en: "Expires at" } }
    status: SessionStatus { title: { pt-BR: "Status", en: "Status" }, lookup }
  }

  indexes {
    byUser: [user.id, issuedAt] range
    byExpiry: [expiresAt] range
  }

  actions {
    start(email: Email, password: string): Session
    end(): Session
  }

  rules {
    expiresAt > issuedAt
  }
}
