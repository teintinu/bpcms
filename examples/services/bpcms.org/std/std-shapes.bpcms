// Shape de corrente elétrica: fluxo de carga por tempo.
shape ElectricCurrent {
  // Rótulo do shape exibido no builder e nos formulários.
  title: { pt-BR: "Corrente elétrica", en: "Electric current" }
  // Tipo do valor bruto guardado internamente pelo shape.
  base: decimal
  // Dimensão física usada em circuitos e equipamentos.
  dimension: electric-current
  // Catálogo de unidades de corrente elétrica aceitas.
  units {
    // Ampère: unidade-base do SI para corrente elétrica.
    A: {
      // Fator de conversão para a unidade-base (1 = identidade).
      factor: 1
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "ampère", other: "ampères" } // português: singular/plural
        en: { one: "ampere", other: "amperes" } // inglês: singular/plural
      }
    }
    // Miliampère: milésimo do ampère, comum em eletrônica.
    mA: {
      // Fator de conversão: 1 mA vale 0,001 A.
      factor: 0.001
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "miliampère", other: "miliampères" } // português: singular/plural
        en: { one: "milliampere", other: "milliamperes" } // inglês: singular/plural
      }
    }
    // Microampère: milionésimo do ampère, comum em sensores.
    uA: {
      // Fator de conversão: 1 µA vale 1e-6 A.
      factor: 1e-06
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "microampère", other: "microampères" } // português: singular/plural
        en: { one: "microampere", other: "microamperes" } // inglês: singular/plural
      }
    }
    // Quiloampère: mil ampères, usado em instalações elétricas.
    kA: {
      // Fator de conversão: 1 kA vale 1000 A.
      factor: 1000
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "quiloampère", other: "quiloampères" } // português: singular/plural
        en: { one: "kiloampere", other: "kiloamperes" } // inglês: singular/plural
      }
    }
  }
  // Leitura de texto aceita quantidade com unidade (ex.: "5 A").
  parse: quantity

  // Multiplica corrente por duração e produz carga elétrica.
  operator *(left: ElectricCurrent, right: Duration): ElectricCharge {
    // Converte a corrente para ampères.
    const i = convert(left.raw, left.unit, A);
    // Converte o tempo para segundos.
    const t = convert(right.raw, right.unit, s);
    // Resultado em coulombs.
    return new ElectricCharge{raw: i * t, unit: C};
  }
}

// Shape de carga elétrica: quantidade de eletricidade acumulada.
shape ElectricCharge {
  // Rótulo do shape exibido no builder e nos formulários.
  title: { pt-BR: "Carga elétrica", en: "Electric charge" }
  // Tipo do valor bruto guardado internamente pelo shape.
  base: decimal
  // Dimensão física usada em baterias e capacitores.
  dimension: electric-charge
  // Catálogo de unidades de carga elétrica aceitas.
  units {
    // Coulomb: unidade-base do SI para carga elétrica.
    C: {
      // Fator de conversão para a unidade-base (1 = identidade).
      factor: 1
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "coulomb", other: "coulombs" } // português: singular/plural
        en: { one: "coulomb", other: "coulombs" } // inglês: singular/plural
      }
    }
    // Milicoulomb: milésimo do coulomb.
    mC: {
      // Fator de conversão: 1 mC vale 0,001 C.
      factor: 0.001
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "milicoulomb", other: "milicoulombs" } // português: singular/plural
        en: { one: "millicoulomb", other: "millicoulombs" } // inglês: singular/plural
      }
    }
    // Microcoulomb: milionésimo do coulomb.
    uC: {
      // Fator de conversão: 1 µC vale 1e-6 C.
      factor: 1e-06
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "microcoulomb", other: "microcoulombs" } // português: singular/plural
        en: { one: "microcoulomb", other: "microcoulombs" } // inglês: singular/plural
      }
    }
    // Ampère-hora: carga de um ampère durante uma hora (baterias).
    Ah: {
      // Fator de conversão: 1 Ah vale 3600 C.
      factor: 3600
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "ampère-hora", other: "ampère-horas" } // português: singular/plural
        en: { one: "ampere-hour", other: "ampere-hours" } // inglês: singular/plural
      }
    }
    // Miliampère-hora: milésimo do ampère-hora, comum em celulares.
    mAh: {
      // Fator de conversão: 1 mAh vale 3,6 C.
      factor: 3.6
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "miliampère-hora", other: "miliampère-horas" } // português: singular/plural
        en: { one: "milliampere-hour", other: "milliampere-hours" } // inglês: singular/plural
      }
    }
  }
  // Leitura de texto aceita quantidade com unidade (ex.: "2 Ah").
  parse: quantity

  // Divide carga por duração e produz corrente elétrica.
  operator /(left: ElectricCharge, right: Duration): ElectricCurrent {
    // Converte a carga para coulombs.
    const q = convert(left.raw, left.unit, C);
    // Converte o tempo para segundos.
    const t = convert(right.raw, right.unit, s);
    // Resultado em ampères.
    return new ElectricCurrent{raw: q / t, unit: A};
  }
}

// Shape de tensão elétrica: diferença de potencial.
shape Voltage {
  // Rótulo do shape exibido no builder e nos formulários.
  title: { pt-BR: "Tensão elétrica", en: "Voltage" }
  // Tipo do valor bruto guardado internamente pelo shape.
  base: decimal
  // Dimensão física usada em redes e componentes.
  dimension: voltage
  // Catálogo de unidades de tensão elétrica aceitas.
  units {
    // Volt: unidade-base do SI para tensão elétrica.
    V: {
      // Fator de conversão para a unidade-base (1 = identidade).
      factor: 1
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "volt", other: "volts" } // português: singular/plural
        en: { one: "volt", other: "volts" } // inglês: singular/plural
      }
    }
    // Milivolt: milésimo do volt, comum em sinais.
    mV: {
      // Fator de conversão: 1 mV vale 0,001 V.
      factor: 0.001
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "milivolt", other: "milivolts" } // português: singular/plural
        en: { one: "millivolt", other: "millivolts" } // inglês: singular/plural
      }
    }
    // Quilovolt: mil volts, usado em transmissão de energia.
    kV: {
      // Fator de conversão: 1 kV vale 1000 V.
      factor: 1000
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "quilovolt", other: "quilovolts" } // português: singular/plural
        en: { one: "kilovolt", other: "kilovolts" } // inglês: singular/plural
      }
    }
    // Microvolt: milionésimo do volt, comum em biossinais.
    uV: {
      // Fator de conversão: 1 µV vale 1e-6 V.
      factor: 1e-06
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "microvolt", other: "microvolts" } // português: singular/plural
        en: { one: "microvolt", other: "microvolts" } // inglês: singular/plural
      }
    }
  }
  // Leitura de texto aceita quantidade com unidade (ex.: "220 V").
  parse: quantity

  // Multiplica tensão por corrente e produz potência.
  operator *(left: Voltage, right: ElectricCurrent): Power {
    // Converte a tensão para volts.
    const v = convert(left.raw, left.unit, V);
    // Converte a corrente para ampères.
    const i = convert(right.raw, right.unit, A);
    // Resultado em watts.
    return new Power{raw: v * i, unit: W};
  }
}

// Shape de resistência elétrica: oposição à passagem de corrente.
