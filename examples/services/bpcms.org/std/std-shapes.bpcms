// Shape de temperatura: escala kelvin como base, com conversões não lineares.
shape Temperature {
  // Rótulo do shape exibido no builder e nos formulários.
  title: { pt-BR: "Temperatura", en: "Temperature" }
  // Tipo do valor bruto guardado internamente pelo shape.
  base: decimal
  // Dimensão física usada para compatibilidade e operadores.
  dimension: temperature
  // Catálogo de escalas de temperatura aceitas.
  units {
    // Kelvin: unidade-base do SI para temperatura termodinâmica.
    K: {
      // Fator de conversão para a unidade-base (1 = identidade).
      factor: 1
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "kelvin", other: "kelvins" } // português: singular/plural
        en: { one: "kelvin", other: "kelvins" } // inglês: singular/plural
      }
    }
    // Grau Celsius: deslocado 273,15 K da escala absoluta.
    C: {
      // Conversão linear: subtrai o ponto de congelamento da água.
      formula: K - 273.15
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "grau Celsius", other: "graus Celsius" } // português: singular/plural
        en: { one: "degree Celsius", other: "degrees Celsius" } // inglês: singular/plural
      }
    }
    // Grau Fahrenheit: escala usada principalmente nos EUA.
    F: {
      // Conversões de ida e volta entre Fahrenheit e kelvin.
      formula: {
        to(K) { return (K - 273.15) * 1.8 + 32; } // converte kelvin em Fahrenheit
        from(F) { return (F - 32) / 1.8 + 273.15; } // converte Fahrenheit em kelvin
      }
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "grau Fahrenheit", other: "graus Fahrenheit" } // português: singular/plural
        en: { one: "degree Fahrenheit", other: "degrees Fahrenheit" } // inglês: singular/plural
      }
    }
    // Grau Rankine: escala absoluta com grau do tamanho do Fahrenheit.
    R: {
      // Conversões de ida e volta entre Rankine e kelvin.
      formula: {
        to(K) { return K * 1.8; } // converte kelvin em Rankine
        from(R) { return R / 1.8; } // converte Rankine em kelvin
      }
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "grau Rankine", other: "graus Rankine" } // português: singular/plural
        en: { one: "degree Rankine", other: "degrees Rankine" } // inglês: singular/plural
      }
    }
  }
  // Leitura de texto aceita quantidade com unidade (ex.: "25 °C").
  parse: quantity
}

// Shape de contagem: inteiros não fracionários.
shape Count {
  // Rótulo do shape exibido no builder e nos formulários.
  title: { pt-BR: "Contagem", en: "Count" }
  // Tipo inteiro impede valores fracionários em contagens.
  base: integer
  // Dimensão própria, sem unidades físicas.
  dimension: count
