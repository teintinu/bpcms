        pt-BR: { one: "gigabit por segundo", other: "gigabits por segundo" } // português: singular/plural
        en: { one: "gigabit per second", other: "gigabits per second" } // inglês: singular/plural
      }
    }
    // Byte por segundo: oito bits por segundo.
    B_s: {
      // Fator de conversão: 1 B/s vale 8 bps.
      factor: 8
