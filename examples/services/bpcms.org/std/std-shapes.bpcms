  // Dimensão física usada em química e farmácia.
  dimension: amount-of-substance
  // Catálogo de unidades de quantidade de substância aceitas.
  units {
    // Mol: unidade-base do SI para quantidade de substância.
    mol: {
      // Fator de conversão para a unidade-base (1 = identidade).
      factor: 1
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "mol", other: "mols" } // português: singular/plural
        en: { one: "mole", other: "moles" } // inglês: singular/plural
      }
    }
    // Milimol: milésimo do mol.
    mmol: {
      // Fator de conversão: 1 mmol vale 0,001 mol.
      factor: 0.001
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "milimol", other: "milimols" } // português: singular/plural
        en: { one: "millimole", other: "millimoles" } // inglês: singular/plural
      }
    }
    // Micromol: milionésimo do mol.
    umol: {
      // Fator de conversão: 1 µmol vale 1e-6 mol.
      factor: 1e-06
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "micromol", other: "micromols" } // português: singular/plural
        en: { one: "micromole", other: "micromoles" } // inglês: singular/plural
      }
    }
    // Quilomol: mil mols, usado em processos industriais.
    kmol: {
      // Fator de conversão: 1 kmol vale 1000 mol.
      factor: 1000
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "quilomol", other: "quilomols" } // português: singular/plural
        en: { one: "kilomole", other: "kilomoles" } // inglês: singular/plural
      }
    }
  }
  // Leitura de texto aceita quantidade com unidade (ex.: "0,5 mol").
  parse: quantity
  // Soma quantidades de matéria convertendo para a mesma unidade.
  aggregate: sum
}

