      }
    }
    // Dina por centímetro: unidade CGS equivalente a 0,001 N/m.
    dyn_cm: {
      // Fator de conversão: 1 dyn/cm vale 0,001 N/m.
      factor: 0.001
      // Nomes exibidos para a unidade em cada idioma.
      title: {
