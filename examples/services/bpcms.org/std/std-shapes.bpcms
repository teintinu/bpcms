  // Catálogo de unidades de área aceitas.
  units {
    // Metro quadrado: unidade-base do SI para área.
    m2: {
      // Fator de conversão para a unidade-base (1 = identidade).
      factor: 1
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "metro quadrado", other: "metros quadrados" } // português: singular/plural
        en: { one: "square meter", other: "square meters" } // inglês: singular/plural
      }
    }
    // Centímetro quadrado: área de um quadrado de 1 cm de lado.
    cm2: {
      // Fator de conversão: 1 cm² vale 0,0001 m².
      factor: 0.0001
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "centímetro quadrado", other: "centímetros quadrados" } // português: singular/plural
        en: { one: "square centimeter", other: "square centimeters" } // inglês: singular/plural
      }
    }
