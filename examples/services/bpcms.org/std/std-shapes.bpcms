// Shape de energia: trabalho, calor e energia de partículas.
shape Energy {
  // Rótulo do shape exibido no builder e nos formulários.
  title: { pt-BR: "Energia", en: "Energy" }
  // Tipo do valor bruto guardado internamente pelo shape.
  base: decimal
  // Dimensão física usada em consumo, física e nutrição.
  dimension: energy
  // Catálogo de unidades de energia aceitas.
  units {
    // Joule: unidade-base do SI para energia.
    J: {
      // Fator de conversão para a unidade-base (1 = identidade).
      factor: 1
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "joule", other: "joules" } // português: singular/plural
        en: { one: "joule", other: "joules" } // inglês: singular/plural
      }
    }
    // Quilojoule: mil joules, usado em rótulos de alimentos.
    kJ: {
      // Fator de conversão: 1 kJ vale 1000 J.
      factor: 1000
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "quilojoule", other: "quilojoules" } // português: singular/plural
        en: { one: "kilojoule", other: "kilojoules" } // inglês: singular/plural
      }
    }
    // Megajoule: um milhão de joules.
    MJ: {
      // Fator de conversão: 1 MJ vale 1 000 000 J.
      factor: 1000000.0
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "megajoule", other: "megajoules" } // português: singular/plural
        en: { one: "megajoule", other: "megajoules" } // inglês: singular/plural
      }
    }
    // Caloria: energia para elevar 1 g de água em 1 °C.
    cal: {
      // Fator de conversão: 1 cal vale 4,184 J.
      factor: 4.184
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "caloria", other: "calorias" } // português: singular/plural
        en: { one: "calorie", other: "calories" } // inglês: singular/plural
      }
    }
    // Quilocaloria: mil calorias, a "caloria" dos rótulos alimentares.
    kcal: {
      // Fator de conversão: 1 kcal vale 4184 J.
      factor: 4184
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "quilocaloria", other: "quilocalorias" } // português: singular/plural
        en: { one: "kilocalorie", other: "kilocalories" } // inglês: singular/plural
      }
    }
    // Watt-hora: energia de um watt durante uma hora.
    Wh: {
      // Fator de conversão: 1 Wh vale 3600 J.
      factor: 3600
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "watt-hora", other: "watt-horas" } // português: singular/plural
        en: { one: "watt-hour", other: "watt-hours" } // inglês: singular/plural
      }
    }
    // Quilowatt-hora: unidade de consumo de energia elétrica.
    kWh: {
      // Fator de conversão: 1 kWh vale 3 600 000 J.
      factor: 3600000.0
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "quilowatt-hora", other: "quilowatt-horas" } // português: singular/plural
        en: { one: "kilowatt-hour", other: "kilowatt-hours" } // inglês: singular/plural
      }
    }
    // Elétron-volt: energia em escala atômica.
    eV: {
      // Fator em joules conforme o valor exato da carga elementar.
      factor: 1.602176634e-19
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "elétron-volt", other: "elétron-volts" } // português: singular/plural
        en: { one: "electronvolt", other: "electronvolts" } // inglês: singular/plural
      }
    }
    // Quiloelétron-volt: mil elétron-volts.
    keV: {
      // Fator em joules: 1 keV vale 1,602176634e-16 J.
      factor: 1.602176634e-16
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "quiloelétron-volt", other: "quiloelétron-volts" } // português: singular/plural
        en: { one: "kiloelectronvolt", other: "kiloelectronvolts" } // inglês: singular/plural
      }
    }
    // Megaelétron-volt: um milhão de elétron-volts.
    MeV: {
      // Fator em joules: 1 MeV vale 1,602176634e-13 J.
      factor: 1.602176634e-13
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "megaelétron-volt", other: "megaelétron-volts" } // português: singular/plural
        en: { one: "megaelectronvolt", other: "megaelectronvolts" } // inglês: singular/plural
      }
    }
    // Unidade térmica britânica: usada em climatização.
    BTU: {
      // Fator de conversão: 1 BTU vale 1055,05585262 J.
      factor: 1055.05585262
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "unidade térmica britânica", other: "unidades térmicas britânicas" } // português: singular/plural
        en: { one: "British thermal unit", other: "British thermal units" } // inglês: singular/plural
      }
    }
    // Erg: unidade de energia do sistema CGS.
    erg: {
      // Fator de conversão: 1 erg vale 1e-7 J.
      factor: 1e-07
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "erg", other: "ergs" } // português: singular/plural
        en: { one: "erg", other: "ergs" } // inglês: singular/plural
      }
    }
    // Pé-libra-força: trabalho de uma libra-força por um pé.
    ft_lbf: {
      // Fator de conversão: 1 ft·lbf vale 1,3558179483314 J.
      factor: 1.3558179483314
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "pé-libra-força", other: "pés-libra-força" } // português: singular/plural
        en: { one: "foot-pound force", other: "foot-pounds force" } // inglês: singular/plural
      }
    }
  }
  // Leitura de texto aceita quantidade com unidade (ex.: "150 kJ").
  parse: quantity
  // Soma energias convertendo antes para a mesma unidade.
  aggregate: sum

  // Divide energia por duração e produz potência.
  operator /(left: Energy, right: Duration): Power {
    // Converte a energia para joules.
    const e = convert(left.raw, left.unit, J);
    // Converte o tempo para segundos.
    const t = convert(right.raw, right.unit, s);
    // Resultado em watts.
    return new Power{raw: e / t, unit: W};
  }
}

// Shape de potência: taxa de energia por tempo.
shape Power {
  // Rótulo do shape exibido no builder e nos formulários.
  title: { pt-BR: "Potência", en: "Power" }
  // Tipo do valor bruto guardado internamente pelo shape.
  base: decimal
  // Dimensão física usada em motores e equipamentos elétricos.
  dimension: power
  // Catálogo de unidades de potência aceitas.
  units {
    // Watt: unidade-base do SI para potência.
    W: {
      // Fator de conversão para a unidade-base (1 = identidade).
      factor: 1
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "watt", other: "watts" } // português: singular/plural
        en: { one: "watt", other: "watts" } // inglês: singular/plural
      }
    }
    // Quilowatt: mil watts.
    kW: {
      // Fator de conversão: 1 kW vale 1000 W.
      factor: 1000
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "quilowatt", other: "quilowatts" } // português: singular/plural
        en: { one: "kilowatt", other: "kilowatts" } // inglês: singular/plural
      }
    }
    // Megawatt: um milhão de watts.
    MW: {
      // Fator de conversão: 1 MW vale 1 000 000 W.
      factor: 1000000.0
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "megawatt", other: "megawatts" } // português: singular/plural
        en: { one: "megawatt", other: "megawatts" } // inglês: singular/plural
      }
    }
    // Cavalo-vapor: potência mecânica em veículos.
    hp: {
      // Fator de conversão: 1 hp vale 745,6998715823 W.
      factor: 745.6998715823
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "cavalo-vapor", other: "cavalos-vapor" } // português: singular/plural
        en: { one: "horsepower", other: "horsepower" } // inglês: singular/plural
      }
    }
    // BTU por hora: potência de climatização.
    BTU_h: {
      // Fator de conversão: 1 BTU/h vale 0,29307107017 W.
      factor: 0.29307107017
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "BTU por hora", other: "BTU por hora" } // português: singular/plural
        en: { one: "BTU per hour", other: "BTU per hour" } // inglês: singular/plural
      }
    }
  }
  // Leitura de texto aceita quantidade com unidade (ex.: "2 MW").
  parse: quantity
}

// Shape de frequência: ciclos por segundo e rotações.
shape Frequency {
  // Rótulo do shape exibido no builder e nos formulários.
  title: { pt-BR: "Frequência", en: "Frequency" }
  // Tipo do valor bruto guardado internamente pelo shape.
  base: decimal
  // Dimensão física usada em sinais, áudio e motores.
  dimension: frequency
  // Catálogo de unidades de frequência aceitas.
  units {
    // Hertz: unidade-base do SI para frequência.
    Hz: {
      // Fator de conversão para a unidade-base (1 = identidade).
      factor: 1
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "hertz", other: "hertz" } // português: singular/plural
        en: { one: "hertz", other: "hertz" } // inglês: singular/plural
      }
    }
    // Quilohertz: mil hertz, faixa de áudio.
    kHz: {
      // Fator de conversão: 1 kHz vale 1000 Hz.
      factor: 1000
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "quilohertz", other: "quilohertz" } // português: singular/plural
        en: { one: "kilohertz", other: "kilohertz" } // inglês: singular/plural
      }
    }
    // Megahertz: um milhão de hertz, faixa de rádio e CPU.
    MHz: {
      // Fator de conversão: 1 MHz vale 1 000 000 Hz.
      factor: 1000000.0
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "megahertz", other: "megahertz" } // português: singular/plural
        en: { one: "megahertz", other: "megahertz" } // inglês: singular/plural
      }
    }
    // Gigahertz: um bilhão de hertz, faixa de micro-ondas.
    GHz: {
      // Fator de conversão: 1 GHz vale 1 000 000 000 Hz.
      factor: 1000000000.0
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "gigahertz", other: "gigahertz" } // português: singular/plural
        en: { one: "gigahertz", other: "gigahertz" } // inglês: singular/plural
      }
    }
    // Rotação por minuto: frequência de eixos e motores.
    rpm: {
      // Fator de conversão: 1 rpm equivale a 0,01666... Hz.
      factor: 0.016666666666666666
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "rotação por minuto", other: "rotações por minuto" } // português: singular/plural
        en: { one: "revolution per minute", other: "revolutions per minute" } // inglês: singular/plural
      }
    }
  }
  // Leitura de texto aceita quantidade com unidade (ex.: "60 Hz").
  parse: quantity
  // Índice normalizado permite comparar e ordenar frequências.
  index: normalized
}

