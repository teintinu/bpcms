// Shape de fluxo magnético: campo que atravessa uma superfície.
shape MagneticFlux {
  // Rótulo do shape exibido no builder e nos formulários.
  title: { pt-BR: "Fluxo magnético", en: "Magnetic flux" }
  // Tipo do valor bruto guardado internamente pelo shape.
  base: decimal
  // Dimensão física usada em ímãs e transformadores.
  dimension: magnetic-flux
  // Catálogo de unidades de fluxo magnético aceitas.
  units {
    // Weber: unidade-base do SI para fluxo magnético.
    Wb: {
      // Fator de conversão para a unidade-base (1 = identidade).
      factor: 1
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "weber", other: "webers" } // português: singular/plural
        en: { one: "weber", other: "webers" } // inglês: singular/plural
      }
    }
    // Maxwell: unidade CGS equivalente a 1e-8 weber.
    Mx: {
      // Fator de conversão: 1 Mx vale 1e-8 Wb.
      factor: 1e-08
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "maxwell", other: "maxwells" } // português: singular/plural
        en: { one: "maxwell", other: "maxwells" } // inglês: singular/plural
      }
    }
  }
  // Leitura de texto aceita quantidade com unidade (ex.: "2 Wb").
  parse: quantity
}

// Shape de densidade de fluxo magnético: campo por área.
shape MagneticFluxDensity {
  // Rótulo do shape exibido no builder e nos formulários.
  title: { pt-BR: "Densidade de fluxo magnético", en: "Magnetic flux density" }
  // Tipo do valor bruto guardado internamente pelo shape.
  base: decimal
  // Dimensão física usada em ímãs e ressonância magnética.
  dimension: magnetic-flux-density
  // Catálogo de unidades de densidade de fluxo aceitas.
  units {
    // Tesla: unidade-base do SI para densidade de fluxo magnético.
    T: {
      // Fator de conversão para a unidade-base (1 = identidade).
      factor: 1
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "tesla", other: "teslas" } // português: singular/plural
        en: { one: "tesla", other: "teslas" } // inglês: singular/plural
      }
    }
    // Militesla: milésimo do tesla.
    mT: {
      // Fator de conversão: 1 mT vale 0,001 T.
      factor: 0.001
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "militesla", other: "militeslas" } // português: singular/plural
        en: { one: "millitesla", other: "milliteslas" } // inglês: singular/plural
      }
    }
    // Microtesla: milionésimo do tesla, usado em geomagnetismo.
    uT: {
      // Fator de conversão: 1 µT vale 1e-6 T.
      factor: 1e-06
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "microtesla", other: "microteslas" } // português: singular/plural
        en: { one: "microtesla", other: "microteslas" } // inglês: singular/plural
      }
    }
    // Gauss: unidade CGS equivalente a 1e-4 tesla.
    G: {
      // Fator de conversão: 1 G vale 0,0001 T.
      factor: 0.0001
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "gauss", other: "gauss" } // português: singular/plural
        en: { one: "gauss", other: "gauss" } // inglês: singular/plural
      }
    }
  }
  // Leitura de texto aceita quantidade com unidade (ex.: "1,5 T").
  parse: quantity
}

