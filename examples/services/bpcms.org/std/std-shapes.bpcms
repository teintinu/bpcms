  units {
    // Becquerel: um decaimento por segundo.
    Bq: {
      // Fator de conversão para a unidade-base (1 = identidade).
      factor: 1
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "becquerel", other: "becquerels" } // português: singular/plural
        en: { one: "becquerel", other: "becquerels" } // inglês: singular/plural
      }
    }
    // Quilobecquerel: mil decaimentos por segundo.
    kBq: {
      // Fator de conversão: 1 kBq vale 1000 Bq.
      factor: 1000
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "quilobecquerel", other: "quilobecquerels" } // português: singular/plural
        en: { one: "kilobecquerel", other: "kilobecquerels" } // inglês: singular/plural
      }
    }
    // Megabecquerel: um milhão de decaimentos por segundo.
    MBq: {
      // Fator de conversão: 1 MBq vale 1 000 000 Bq.
      factor: 1000000.0
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "megabecquerel", other: "megabecquerels" } // português: singular/plural
        en: { one: "megabecquerel", other: "megabecquerels" } // inglês: singular/plural
      }
    }
    // Curie: unidade histórica equivalente a 37 bilhões de becquerels.
    Ci: {
      // Fator de conversão: 1 Ci vale 37 000 000 000 Bq.
      factor: 37000000000.0
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "curie", other: "curies" } // português: singular/plural
        en: { one: "curie", other: "curies" } // inglês: singular/plural
      }
    }
  }
  // Leitura de texto aceita quantidade com unidade (ex.: "5 MBq").
  parse: quantity
}

// Shape de dose absorvida: energia depositada por massa.
shape AbsorbedDose {
  // Rótulo do shape exibido no builder e nos formulários.
  title: { pt-BR: "Dose absorvida", en: "Absorbed dose" }
  // Tipo do valor bruto guardado internamente pelo shape.
  base: decimal
  // Dimensão física usada em radioproteção.
  dimension: absorbed-dose
  // Catálogo de unidades de dose absorvida aceitas.
  units {
    // Gray: um joule por quilograma.
    Gy: {
      // Fator de conversão para a unidade-base (1 = identidade).
      factor: 1
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "gray", other: "grays" } // português: singular/plural
        en: { one: "gray", other: "grays" } // inglês: singular/plural
      }
    }
    // Miligray: milésimo do gray.
    mGy: {
      // Fator de conversão: 1 mGy vale 0,001 Gy.
      factor: 0.001
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "miligray", other: "miligrays" } // português: singular/plural
        en: { one: "milligray", other: "milligrays" } // inglês: singular/plural
      }
    }
    // Rad: unidade histórica equivalente a 0,01 gray.
    rad: {
      // Fator de conversão: 1 rad vale 0,01 Gy.
      factor: 0.01
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "rad", other: "rads" } // português: singular/plural
        en: { one: "rad", other: "rads" } // inglês: singular/plural
      }
    }
  }
  // Leitura de texto aceita quantidade com unidade (ex.: "2 mGy").
  parse: quantity
}

// Shape de dose equivalente: dose ponderada pelo efeito biológico.
shape EquivalentDose {
  // Rótulo do shape exibido no builder e nos formulários.
  title: { pt-BR: "Dose equivalente", en: "Equivalent dose" }
  // Tipo do valor bruto guardado internamente pelo shape.
  base: decimal
  // Dimensão física usada em radioproteção ocupacional.
  dimension: equivalent-dose
  // Catálogo de unidades de dose equivalente aceitas.
  units {
    // Sievert: unidade-base do SI para dose equivalente.
    Sv: {
      // Fator de conversão para a unidade-base (1 = identidade).
      factor: 1
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "sievert", other: "sieverts" } // português: singular/plural
        en: { one: "sievert", other: "sieverts" } // inglês: singular/plural
      }
    }
    // Milisievert: milésimo do sievert.
    mSv: {
      // Fator de conversão: 1 mSv vale 0,001 Sv.
      factor: 0.001
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "milisievert", other: "milisieverts" } // português: singular/plural
        en: { one: "millisievert", other: "millisieverts" } // inglês: singular/plural
      }
    }
    // Rem: unidade histórica equivalente a 0,01 sievert.
    rem: {
      // Fator de conversão: 1 rem vale 0,01 Sv.
      factor: 0.01
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "rem", other: "rems" } // português: singular/plural
        en: { one: "rem", other: "rems" } // inglês: singular/plural
      }
    }
  }
  // Leitura de texto aceita quantidade com unidade (ex.: "1 mSv").
  parse: quantity
}
