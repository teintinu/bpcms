      }
    }
    // Pé por segundo ao quadrado: equivalente imperial.
    ft_s2: {
      // Fator de conversão: 1 ft/s² vale 0,3048 m/s².
      factor: 0.3048
      // Nomes exibidos para a unidade em cada idioma.
