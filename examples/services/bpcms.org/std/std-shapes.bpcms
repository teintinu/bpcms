        pt-BR: { one: "molar", other: "molar" } // português: singular/plural
        en: { one: "molar", other: "molar" } // inglês: singular/plural
      }
    }
    // Milimolar: milésimo do molar.
    mM: {
      // Fator de conversão: 1 mM vale 0,001 mol/L.
      factor: 0.001
      // Nomes exibidos para a unidade em cada idioma.
