        en: { one: "gram centimeter per second", other: "gram centimeters per second" } // inglês: singular/plural
      }
    }
    // Libra pé por segundo: momento no sistema imperial/US.
    lb_ft_s: {
      // Fator de conversão: 1 lb·ft/s vale 0,138254954376 kg·m/s.
      factor: 0.138254954376
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "libra pé por segundo", other: "libras pé por segundo" } // português: singular/plural
        en: { one: "pound foot per second", other: "pound feet per second" } // inglês: singular/plural
      }
    }
  }
  // Leitura de texto aceita quantidade com unidade.
