// Arquivo compartilhado de shapes do pseudo-serviço bpcms.org/std.
// Pseudo-service bpcms.org/std: definido pelo builder, não publicado.
// Modos: SI, imperial/US, CGS, astronômico, atômico/nuclear, química, dados e estatística.

// Shape de comprimento: grandezas métricas, imperiais, náuticas e astronômicas.
shape Length {
  // Rótulo do shape exibido no builder e nos formulários.
  title: { pt-BR: "Comprimento", en: "Length" }
  // Tipo do valor bruto guardado internamente pelo shape.
  base: decimal
  // Dimensão física usada para compatibilidade e operadores entre shapes.
  dimension: length
  // Catálogo de unidades aceitas; cada chave vira o símbolo escrito do valor.
  units {
    // Metro: unidade-base do SI para comprimento.
    m: {
      // Fator de conversão para a unidade-base (1 = identidade).
      factor: 1
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "metro", other: "metros" } // português: singular/plural
        en: { one: "meter", other: "meters" } // inglês: singular/plural
      }
    }
    // Centímetro: centésimo do metro, comum em medidas domésticas.
    cm: {
      // Fator de conversão: 1 cm vale 0,01 m.
      factor: 0.01
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "centímetro", other: "centímetros" } // português: singular/plural
        en: { one: "centimeter", other: "centimeters" } // inglês: singular/plural
      }
    }
    // Milímetro: milésimo do metro, usado em peças e tolerâncias.
    mm: {
      // Fator de conversão: 1 mm vale 0,001 m.
      factor: 0.001
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "milímetro", other: "milímetros" } // português: singular/plural
        en: { one: "millimeter", other: "millimeters" } // inglês: singular/plural
      }
    }
    // Micrômetro (mícron): milésimo do milímetro.
    um: {
      // Fator de conversão: 1 µm vale 1e-6 m.
      factor: 1e-06
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "micrômetro", other: "micrômetros" } // português: singular/plural
        en: { one: "micrometer", other: "micrometers" } // inglês: singular/plural
      }
    }
    // Nanômetro: usado em microeletrônica e óptica.
    nm: {
      // Fator de conversão: 1 nm vale 1e-9 m.
      factor: 1e-09
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "nanômetro", other: "nanômetros" } // português: singular/plural
        en: { one: "nanometer", other: "nanometers" } // inglês: singular/plural
      }
    }
    // Quilômetro: mil metros, usado em distâncias geográficas.
    km: {
      // Fator de conversão: 1 km vale 1000 m.
      factor: 1000
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "quilômetro", other: "quilômetros" } // português: singular/plural
        en: { one: "kilometer", other: "kilometers" } // inglês: singular/plural
      }
    }
    // Polegada: unidade do sistema imperial/US.
    in: {
      // Fator de conversão: 1 in vale 0,0254 m.
      factor: 0.0254
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "polegada", other: "polegadas" } // português: singular/plural
        en: { one: "inch", other: "inches" } // inglês: singular/plural
      }
    }
    // Pé: doze polegadas, usado em alturas e imóveis.
    ft: {
      // Fator de conversão: 1 ft vale 0,3048 m.
      factor: 0.3048
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "pé", other: "pés" } // português: singular/plural
        en: { one: "foot", other: "feet" } // inglês: singular/plural
      }
    }
    // Jarda: três pés, usada em tecidos e esportes.
    yd: {
      // Fator de conversão: 1 yd vale 0,9144 m.
      factor: 0.9144
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "jarda", other: "jardas" } // português: singular/plural
        en: { one: "yard", other: "yards" } // inglês: singular/plural
      }
    }
    // Milha terrestre: usada em rodovias dos EUA e Reino Unido.
    mi: {
      // Fator de conversão: 1 mi vale 1609,344 m.
      factor: 1609.344
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "milha", other: "milhas" } // português: singular/plural
        en: { one: "mile", other: "miles" } // inglês: singular/plural
      }
    }
    // Milha náutica: usada em navegação marítima e aérea.
    nmi: {
      // Fator de conversão: 1 nmi vale exatamente 1852 m.
      factor: 1852
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "milha náutica", other: "milhas náuticas" } // português: singular/plural
        en: { one: "nautical mile", other: "nautical miles" } // inglês: singular/plural
      }
    }
    // Unidade astronômica: distância média Terra–Sol.
    AU: {
      // Fator em metros: 1 AU vale 149 597 870 700 m.
      factor: 149597870700
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "unidade astronômica", other: "unidades astronômicas" } // português: singular/plural
        en: { one: "astronomical unit", other: "astronomical units" } // inglês: singular/plural
      }
    }
    // Ano-luz: distância percorrida pela luz em um ano juliano.
    ly: {
      // Fator em metros conforme a definição IAU.
      factor: 9460730472580800
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "ano-luz", other: "anos-luz" } // português: singular/plural
        en: { one: "light-year", other: "light-years" } // inglês: singular/plural
      }
    }
    // Parsec: distância em que 1 UA subtende 1 segundo de arco.
    pc: {
      // Fator em metros (notação científica para não perder precisão).
      factor: 3.085677581e+16
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "parsec", other: "parsecs" } // português: singular/plural
        en: { one: "parsec", other: "parsecs" } // inglês: singular/plural
      }
    }
    // Angstrom: usado em cristalografia e espectroscopia.
    angstrom: {
      // Fator em metros: 1 Å vale 1e-10 m.
      factor: 1e-10
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "angstrom", other: "angstroms" } // português: singular/plural
        en: { one: "angstrom", other: "angstroms" } // inglês: singular/plural
      }
    }
  }
  // Leitura de texto aceita quantidade com unidade (ex.: "10 cm").
  parse: quantity
  // Soma valores convertendo antes para a mesma unidade.
  aggregate: sum
  // Índice normalizado permite comparar/ordenar valores de unidades diferentes.
  index: normalized

  // Extrai o número bruto para cálculos externos ao shape.
  toNumber(value) {
    // Devolve o valor sem a unidade anexada.
    return value.raw;
  }

  // Serializa o valor para armazenamento, preservando a unidade escolhida.
  write(value, out) {
    // Assume metro quando o valor não traz unidade explícita.
    const unit = value.unit ?? m;
    // Grava o símbolo da unidade no fluxo.
    out.writeString(unit);
    // Grava o número bruto no fluxo.
    out.writeDouble(value.raw);
  }

  // Reconstrói o valor a partir do fluxo serializado.
  read(in) {
    // Lê o símbolo da unidade gravado antes do número.
    const unit = in.readString();
    // Lê o número bruto na mesma ordem da escrita.
    const raw = in.readDouble();
    // Remonta o comprimento com unidade e valor lidos.
    return new Length{raw, unit};
  }

  // Converte texto livre em um Length, aceitando a unidade digitada.
  parse(text, flags) {
    // Interpreta a quantidade textual e separa número e unidade.
    const {value, unit} = parseQuantity(text, flags);
    // Cria o Length já com a unidade detectada.
    return new Length{raw: value, unit};
  }

  // Formata o valor para exibição, escolhendo a melhor unidade por padrão.
  format(value, flags) {
    // Unidade de origem; metro quando não informada.
    const from = value.unit ?? m;
    // Respeita a unidade pedida ou escolhe a mais legível para o número.
    const unit = flags.unit ?? bestUnit(value.raw, from, units);
    // Delega a formatação numérica ao formatador real compartilhado.
    return formatReal(value.raw, from, unit, flags.style, flags.unitStyle);
  }

  // Soma dois comprimentos convertendo o direito para a unidade do esquerdo.
  operator +(left: Length, right: Length): Length {
    // Converte o operando direito para a unidade do operando esquerdo.
    const rightInLeft = convert(right.raw, right.unit, left.unit);
    // Soma os valores já na mesma unidade.
    return new Length{raw: left.raw + rightInLeft, unit: left.unit};
  }

  // Subtrai comprimentos convertendo o direito para a unidade do esquerdo.
  operator -(left: Length, right: Length): Length {
    // Converte o operando direito para a unidade do operando esquerdo.
    const rightInLeft = convert(right.raw, right.unit, left.unit);
    // Subtrai os valores já na mesma unidade.
    return new Length{raw: left.raw - rightInLeft, unit: left.unit};
  }

  // Multiplica dois comprimentos e produz área.
  operator *(left: Length, right: Length): Area {
    // Converte o lado esquerdo para metros antes do produto.
    const l = convert(left.raw, left.unit, m);
    // Converte o lado direito para metros antes do produto.
    const r = convert(right.raw, right.unit, m);
    // Resultado em metros quadrados.
    return new Area{raw: l * r, unit: m2};
  }

  // Divide comprimento por duração e produz velocidade.
  operator /(left: Length, right: Duration): Speed {
    // Converte a distância para metros.
    const l = convert(left.raw, left.unit, m);
    // Converte o tempo para segundos.
    const r = convert(right.raw, right.unit, s);
    // Resultado em metros por segundo.
    return new Speed{raw: l / r, unit: m_s};
  }
}

// Shape de massa: cobre SI, imperial, pedras, quilates e massas astronômicas.
shape Mass {
  // Rótulo do shape exibido no builder e nos formulários.
  title: { pt-BR: "Massa", en: "Mass" }
  // Tipo do valor bruto guardado internamente pelo shape.
  base: decimal
  // Dimensão física usada para compatibilidade e operadores.
  dimension: mass
  // Catálogo de unidades de massa aceitas.
  units {
    // Grama: unidade-base da dimensão massa neste shape.
    g: {
      // Fator de conversão para a unidade-base (1 = identidade).
      factor: 1
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "grama", other: "gramas" } // português: singular/plural
        en: { one: "gram", other: "grams" } // inglês: singular/plural
      }
    }
    // Quilograma: unidade-base do SI para massa.
    kg: {
      // Fator de conversão: 1 kg vale 1000 g.
      factor: 1000
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "quilograma", other: "quilogramas" } // português: singular/plural
        en: { one: "kilogram", other: "kilograms" } // inglês: singular/plural
      }
    }
    // Miligrama: milésimo do grama, usado em dosagens.
    mg: {
      // Fator de conversão: 1 mg vale 0,001 g.
      factor: 0.001
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "miligrama", other: "miligramas" } // português: singular/plural
        en: { one: "milligram", other: "milligrams" } // inglês: singular/plural
      }
    }
    // Micrograma em grafia ASCII: alternativa ao símbolo µg.
    ug: {
      // Fator de conversão: 1 µg vale 0,000001 g.
      factor: 0.000001
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "micrograma", other: "microgramas" } // português: singular/plural
        en: { one: "microgram", other: "micrograms" } // inglês: singular/plural
      }
    }
    // Micrograma com o símbolo grego µ: mesma escala da unidade anterior.
    µg: {
      // Fator de conversão: 1 µg vale 0,000001 g.
      factor: 0.000001
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "micrograma", other: "microgramas" } // português: singular/plural
        en: { one: "microgram", other: "micrograms" } // inglês: singular/plural
      }
    }
    // Tonelada métrica: mil quilogramas.
    t: {
      // Fator de conversão: 1 t vale 1 000 000 g.
      factor: 1000000
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "tonelada métrica", other: "toneladas métricas" } // português: singular/plural
        en: { one: "metric ton", other: "metric tons" } // inglês: singular/plural
      }
    }
    // Libra avoirdupois: unidade de massa do sistema imperial/US.
    lb: {
      // Fator de conversão: 1 lb vale 453,59237 g.
      factor: 453.59237
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "libra", other: "libras" } // português: singular/plural
        en: { one: "pound", other: "pounds" } // inglês: singular/plural
      }
    }
    // Onça avoirdupois: um dezesseis avos da libra.
    oz: {
      // Fator de conversão: 1 oz vale 28,349523125 g.
      factor: 28.349523125
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "onça", other: "onças" } // português: singular/plural
        en: { one: "ounce", other: "ounces" } // inglês: singular/plural
      }
    }
    // Stone: quatorze libras, usado para peso corporal no Reino Unido.
    st: {
      // Fator de conversão: 1 st vale 6350,29318 g.
      factor: 6350.29318
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "stone", other: "stones" } // português: singular/plural
        en: { one: "stone", other: "stones" } // inglês: singular/plural
      }
    }
    // Tonelada curta (US): duas mil libras.
    ton: {
      // Fator de conversão: 1 ton vale 907 184,74 g.
      factor: 907184.74
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "tonelada curta", other: "toneladas curtas" } // português: singular/plural
        en: { one: "short ton", other: "short tons" } // inglês: singular/plural
      }
    }
    // Quilate métrico: usado em gemas, vale 0,2 g.
    ct: {
      // Fator de conversão: 1 ct vale 0,2 g.
      factor: 0.2
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "quilate", other: "quilates" } // português: singular/plural
        en: { one: "carat", other: "carats" } // inglês: singular/plural
      }
    }
    // Dalton: massa atômica unificada, usada em química e física.
    Da: {
      // Fator em gramas: massa de um nuclíon em gramas.
      factor: 1.66053904e-24
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "dalton", other: "daltons" } // português: singular/plural
        en: { one: "dalton", other: "daltons" } // inglês: singular/plural
      }
    }
    // Massa solar: padrão para massas de estrelas e galáxias.
    Msun: {
      // Fator em gramas: aproximadamente 1,988475e33 g.
      factor: 1.988475e33
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "massa solar", other: "massas solares" } // português: singular/plural
        en: { one: "solar mass", other: "solar masses" } // inglês: singular/plural
      }
    }
  }
  // Leitura de texto aceita quantidade com unidade (ex.: "2,5 kg").
  parse: quantity
  // Soma valores convertendo antes para a mesma unidade.
  aggregate: sum
  // Índice normalizado permite comparar e ordenar massas.
  index: normalized

  // Extrai o número bruto para cálculos externos ao shape.
  toNumber(value) {
    // Devolve o valor sem a unidade anexada.
    return value.raw;
  }

  // Serializa o valor para armazenamento, preservando a unidade escolhida.
  write(value, out) {
    // Assume grama quando o valor não traz unidade explícita.
    const unit = value.unit ?? g;
    // Grava o símbolo da unidade no fluxo.
    out.writeString(unit);
    // Grava o número bruto no fluxo.
    out.writeDouble(value.raw);
  }

  // Reconstrói o valor a partir do fluxo serializado.
  read(in) {
    // Lê o símbolo da unidade gravado antes do número.
    const unit = in.readString();
    // Lê o número bruto na mesma ordem da escrita.
    const raw = in.readDouble();
    // Remonta a massa com unidade e valor lidos.
    return new Mass{raw, unit};
  }

  // Converte texto livre em um Mass, aceitando a unidade digitada.
  parse(text, flags) {
    // Interpreta a quantidade textual em número e unidade.
    const parsed = parseQuantity(text, flags);
    // Cria o Mass com valor e unidade reconhecidos.
    return new Mass{raw: parsed.value, unit: parsed.unit};
  }

  // Formata a massa para exibição com a unidade mais legível.
  format(value, flags) {
    // Unidade de origem; grama quando não informada.
    const from = value.unit ?? g;
    // Respeita a unidade pedida ou escolhe a melhor para o número.
    const unit = flags.unit ?? bestUnit(value.raw, from, units);
    // Delega a formatação numérica ao formatador compartilhado.
    return formatReal(value.raw, from, unit, flags.style, flags.unitStyle);
  }

  // Divide massa por volume e produz densidade.
  operator /(left: Mass, right: Volume): Density {
    // Converte a massa para gramas.
    const m = convert(left.raw, left.unit, g);
    // Converte o volume para metros cúbicos.
    const v = convert(right.raw, right.unit, m3);
    // Converte gramas para quilos e resulta em kg/m³.
    return new Density{raw: m / 1000 / v, unit: kg_m3};
  }

  // Multiplica massa por aceleração e produz força.
  operator *(left: Mass, right: Acceleration): Force {
    // Converte a massa para quilogramas, unidade coerente com newton.
    const m = convert(left.raw, left.unit, g) / 1000;
    // Converte a aceleração para metros por segundo ao quadrado.
    const a = convert(right.raw, right.unit, m_s2);
    // Resultado em newtons.
    return new Force{raw: m * a, unit: N};
  }
}

// Shape de volume: SI, medidas culinárias e unidades imperiais de líquidos.
shape Volume {
  // Rótulo do shape exibido no builder e nos formulários.
  title: { pt-BR: "Volume", en: "Volume" }
  // Tipo do valor bruto guardado internamente pelo shape.
  base: decimal
  // Dimensão física usada para compatibilidade e operadores.
  dimension: volume
  // Catálogo de unidades de volume aceitas.
  units {
    // Metro cúbico: unidade-base do SI para volume.
    m3: {
      // Fator de conversão para a unidade-base (1 = identidade).
      factor: 1
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "metro cúbico", other: "metros cúbicos" } // português: singular/plural
        en: { one: "cubic meter", other: "cubic meters" } // inglês: singular/plural
      }
    }
    // Litro: um milésimo do metro cúbico.
    L: {
      // Fator de conversão: 1 L vale 0,001 m³.
      factor: 0.001
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "litro", other: "litros" } // português: singular/plural
        en: { one: "liter", other: "liters" } // inglês: singular/plural
      }
    }
    // Mililitro: milésimo do litro.
    mL: {
      // Fator de conversão: 1 mL vale 0,000001 m³.
      factor: 0.000001
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "mililitro", other: "mililitros" } // português: singular/plural
        en: { one: "milliliter", other: "milliliters" } // inglês: singular/plural
      }
    }
    // Centímetro cúbico: equivalente ao mililitro.
    cm3: {
      // Fator de conversão: 1 cm³ vale 0,000001 m³.
      factor: 0.000001
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "centímetro cúbico", other: "centímetros cúbicos" } // português: singular/plural
        en: { one: "cubic centimeter", other: "cubic centimeters" } // inglês: singular/plural
      }
    }
    // Milímetro cúbico: milésimo do centímetro cúbico.
    mm3: {
      // Fator de conversão: 1 mm³ vale 1e-9 m³.
      factor: 1e-09
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "milímetro cúbico", other: "milímetros cúbicos" } // português: singular/plural
        en: { one: "cubic millimeter", other: "cubic millimeters" } // inglês: singular/plural
      }
    }
    // Galão americano: 231 polegadas cúbicas.
    gal: {
      // Fator de conversão: 1 gal vale 0,003785411784 m³.
      factor: 0.003785411784
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "galão", other: "galões" } // português: singular/plural
        en: { one: "gallon", other: "gallons" } // inglês: singular/plural
      }
    }
    // Quarto americano: um quarto do galão.
    qt: {
      // Fator de conversão: 1 qt vale 0,000946352946 m³.
      factor: 0.000946352946
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "quarto", other: "quartos" } // português: singular/plural
        en: { one: "quart", other: "quarts" } // inglês: singular/plural
      }
    }
    // Pint americano: metade do quarto.
    pt: {
      // Fator de conversão: 1 pt vale 0,000473176473 m³.
      factor: 0.000473176473
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "pint", other: "pints" } // português: singular/plural
        en: { one: "pint", other: "pints" } // inglês: singular/plural
      }
    }
    // Onça líquida americana: um oitavo do pint.
    fl_oz: {
      // Fator de conversão: 1 fl oz vale 0,0000295735295625 m³.
      factor: 0.0000295735295625
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "onça líquida", other: "onças líquidas" } // português: singular/plural
        en: { one: "fluid ounce", other: "fluid ounces" } // inglês: singular/plural
      }
    }
    // Colher de sopa: medida culinária de volume.
    tbsp: {
      // Fator de conversão: 1 tbsp vale 0,0000147867647813 m³.
      factor: 0.0000147867647813
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "colher de sopa", other: "colheres de sopa" } // português: singular/plural
        en: { one: "tablespoon", other: "tablespoons" } // inglês: singular/plural
      }
    }
    // Colher de chá: um terço da colher de sopa.
    tsp: {
      // Fator de conversão: 1 tsp vale 0,00000492892159375 m³.
      factor: 0.00000492892159375
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "colher de chá", other: "colheres de chá" } // português: singular/plural
        en: { one: "teaspoon", other: "teaspoons" } // inglês: singular/plural
      }
    }
    // Barril de petróleo: 42 galões americanos.
    bbl: {
      // Fator de conversão: 1 bbl vale 0,158987294928 m³.
      factor: 0.158987294928
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "barril", other: "barris" } // português: singular/plural
        en: { one: "barrel", other: "barrels" } // inglês: singular/plural
      }
    }
    // Alqueire (bushel): medida agrícola de grãos.
    bu: {
      // Fator de conversão: 1 bu vale 0,03523907016688 m³.
      factor: 0.03523907016688
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "alqueire", other: "alqueires" } // português: singular/plural
        en: { one: "bushel", other: "bushels" } // inglês: singular/plural
      }
    }
  }
  // Leitura de texto aceita quantidade com unidade (ex.: "2 L").
  parse: quantity
  // Soma valores convertendo antes para a mesma unidade.
  aggregate: sum
  // Índice normalizado permite comparar e ordenar volumes.
  index: normalized

  // Extrai o número bruto para cálculos externos ao shape.
  toNumber(value) {
    // Devolve o valor sem a unidade anexada.
    return value.raw;
  }

  // Serializa o valor para armazenamento, preservando a unidade escolhida.
  write(value, out) {
    // Assume metro cúbico quando o valor não traz unidade explícita.
    const unit = value.unit ?? m3;
    // Grava o símbolo da unidade no fluxo.
    out.writeString(unit);
    // Grava o número bruto no fluxo.
    out.writeDouble(value.raw);
  }

  // Reconstrói o valor a partir do fluxo serializado.
  read(in) {
    // Lê o símbolo da unidade gravado antes do número.
    const unit = in.readString();
    // Lê o número bruto na mesma ordem da escrita.
    const raw = in.readDouble();
    // Remonta o volume com unidade e valor lidos.
    return new Volume{raw, unit};
  }

  // Converte texto livre em um Volume, aceitando a unidade digitada.
  parse(text, flags) {
    // Interpreta a quantidade textual em número e unidade.
    const parsed = parseQuantity(text, flags);
    // Cria o Volume com valor e unidade reconhecidos.
    return new Volume{raw: parsed.value, unit: parsed.unit};
  }

  // Formata o volume para exibição com a unidade mais legível.
  format(value, flags) {
    // Unidade de origem; metro cúbico quando não informada.
    const from = value.unit ?? m3;
    // Respeita a unidade pedida ou escolhe a melhor para o número.
    const unit = flags.unit ?? bestUnit(value.raw, from, units);
    // Delega a formatação numérica ao formatador compartilhado.
    return formatReal(value.raw, from, unit, flags.style, flags.unitStyle);
  }
}

// Shape de percentual: razão exibida em pontos percentuais.
shape Percentage {
  // Rótulo do shape exibido no builder e nos formulários.
  title: { pt-BR: "Percentual", en: "Percentage" }
  // Tipo do valor bruto guardado internamente pelo shape.
  base: decimal
  // Percentual é uma razão, o que permite combiná-lo com outros ratios.
  dimension: ratio
  // Unidade única do shape: o símbolo de porcentagem.
  unit: %
  // Texto com "%" é lido como percentual.
  parse: percent
  // Exibição sempre no formato percentual.
  format: percent
  // Média ponderada é a forma correta de agregar percentuais.
  aggregate: weighted-average

  // Extrai o número bruto para cálculos externos ao shape.
  toNumber(value) {
    // Devolve o valor sem a unidade anexada.
    return value.raw;
  }

  // Serializa o valor para armazenamento, preservando a unidade.
  write(value, out) {
    // Assume porcentagem quando o valor não traz unidade explícita.
    const unit = value.unit ?? %;
    // Grava o símbolo da unidade no fluxo.
    out.writeString(unit);
    // Grava o número bruto no fluxo.
    out.writeDouble(value.raw);
  }

  // Reconstrói o valor a partir do fluxo serializado.
  read(in) {
    // Lê o símbolo da unidade gravado antes do número.
    const unit = in.readString();
    // Lê o número bruto na mesma ordem da escrita.
    const raw = in.readDouble();
    // Remonta o percentual com unidade e valor lidos.
    return new Percentage{raw, unit};
  }

  // Converte texto livre em um Percentage.
  parse(text, flags) {
    // Interpreta a quantidade textual em número e unidade.
    const parsed = parseQuantity(text, flags);
    // Cria o Percentage com valor e unidade reconhecidos.
    return new Percentage{raw: parsed.value, unit: parsed.unit};
  }

  // Formata o percentual para exibição.
  format(value, flags) {
    // Percentual não tem outra unidade; usa % quando não informada.
    const from = value.unit ?? %;
    // Mantém o destino sempre em %, pois o shape só admite essa unidade.
    const unit = flags.unit ?? %;
    // Delega a formatação numérica ao formatador compartilhado.
    return formatReal(value.raw, from, unit, flags.style, flags.unitStyle);
  }
}

// Shape de área: SI, medidas agrárias e unidades imperiais quadradas.
