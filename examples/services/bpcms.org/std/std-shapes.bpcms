// Shape de entropia: energia por temperatura.
shape Entropy {
  // Rótulo do shape exibido no builder e nos formulários.
  title: { pt-BR: "Entropia", en: "Entropy" }
  // Tipo do valor bruto guardado internamente pelo shape.
  base: decimal
  // Dimensão física usada em termodinâmica.
  dimension: entropy
  // Catálogo de unidades de entropia aceitas.
  units {
    // Joule por kelvin: unidade-base coerente para entropia.
    J_K: {
      // Fator de conversão para a unidade-base (1 = identidade).
      factor: 1
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "joule por kelvin", other: "joules por kelvin" } // português: singular/plural
        en: { one: "joule per kelvin", other: "joules per kelvin" } // inglês: singular/plural
      }
    }
    // Quilojoule por kelvin: mil joules por kelvin.
    kJ_K: {
      // Fator de conversão: 1 kJ/K vale 1000 J/K.
      factor: 1000
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "quilojoule por kelvin", other: "quilojoules por kelvin" } // português: singular/plural
        en: { one: "kilojoule per kelvin", other: "kilojoules per kelvin" } // inglês: singular/plural
      }
    }
  }
  // Leitura de texto aceita quantidade com unidade.
  parse: quantity
}

// Shape de condutividade térmica: fluxo de calor por gradiente.
shape ThermalConductivity {
  // Rótulo do shape exibido no builder e nos formulários.
  title: { pt-BR: "Condutividade térmica", en: "Thermal conductivity" }
  // Tipo do valor bruto guardado internamente pelo shape.
