      // Fator de conversão: 1 mm² vale 1e-6 m².
      factor: 1e-06
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "milímetro quadrado", other: "milímetros quadrados" } // português: singular/plural
        en: { one: "square millimeter", other: "square millimeters" } // inglês: singular/plural
      }
    }
    // Quilômetro quadrado: usado em áreas territoriais.
