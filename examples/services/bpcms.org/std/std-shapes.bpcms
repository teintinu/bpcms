        en: { one: "kibibyte per second", other: "kibibytes per second" } // inglês: singular/plural
      }
    }
  }
  // Leitura de texto aceita quantidade com unidade (ex.: "10 Mbps").
  parse: quantity
  // Índice normalizado permite comparar e ordenar taxas.
