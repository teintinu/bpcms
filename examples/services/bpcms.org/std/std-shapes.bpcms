  dimension: ratio
}

// Shape de dinheiro: valor monetário com moeda obrigatória.
shape Money {
  // Rótulo do shape exibido no builder e nos formulários.
  title: { pt-BR: "Dinheiro", en: "Money" }
  // Tipo decimal evita erros de arredondamento binário em valores monetários.
  base: decimal

  // Soma valores apenas quando as moedas coincidem.
  operator +(left: Money, right: Money): Money {
    // Rejeita a soma entre moedas diferentes.
    if (left.currency != right.currency) {
      throw Error("E_CURRENCY_MISMATCH"); // moedas incompatíveis: falha explícita
    }
    // Soma os valores mantendo a moeda original.
    return new Money{raw: left.raw + right.raw, currency: left.currency};
  }

  // Subtrai valores apenas quando as moedas coincidem.
  operator -(left: Money, right: Money): Money {
    // Rejeita a subtração entre moedas diferentes.
    if (left.currency != right.currency) {
      throw Error("E_CURRENCY_MISMATCH"); // moedas incompatíveis: falha explícita
    }
    // Subtrai os valores mantendo a moeda original.
    return new Money{raw: left.raw - right.raw, currency: left.currency};
  }

  // Multiplica dinheiro por um número, preservando a moeda.
  operator *(left: Money, right: number): Money {
    // Escala o valor bruto e mantém a moeda do operando monetário.
    return new Money{raw: left.raw * right, currency: left.currency};
  }

  // Multiplica um número por dinheiro (ordem inversa da operação anterior).
  operator *(left: number, right: Money): Money {
    // Escala o valor bruto e mantém a moeda do operando monetário.
    return new Money{raw: left * right.raw, currency: right.currency};
  }

  // Divide dinheiro por um número, preservando a moeda.
  operator /(left: Money, right: number): Money {
    // Divide o valor bruto e mantém a moeda original.
    return new Money{raw: left.raw / right, currency: left.currency};
  }

  // Divide dinheiro por dinheiro e devolve um número adimensional.
  operator /(left: Money, right: Money): number {
    // Só faz sentido dividir valores na mesma moeda.
    if (left.currency != right.currency) {
      throw Error("E_CURRENCY_MISMATCH"); // moedas incompatíveis: falha explícita
    }
    // Proporção entre os dois valores.
    return left.raw / right.raw;
  }

  // Compara igualdade de valores na mesma moeda.
  operator ==(left: Money, right: Money): boolean {
    // Comparar moedas diferentes seria enganoso; falha explicitamente.
    if (left.currency != right.currency) {
      throw Error("E_CURRENCY_MISMATCH"); // moedas incompatíveis: falha explícita
    }
    // Igualdade apenas dos valores brutos.
    return left.raw == right.raw;
  }

  // Compara se o valor esquerdo é menor que o direito.
  operator <(left: Money, right: Money): boolean {
    // Ordenar moedas diferentes não é permitido.
    if (left.currency != right.currency) {
      throw Error("E_CURRENCY_MISMATCH"); // moedas incompatíveis: falha explícita
    }
    // Comparação numérica dos valores brutos.
    return left.raw < right.raw;
  }

  // Compara se o valor esquerdo é maior que o direito.
  operator >(left: Money, right: Money): boolean {
    // Ordenar moedas diferentes não é permitido.
    if (left.currency != right.currency) {
      throw Error("E_CURRENCY_MISMATCH"); // moedas incompatíveis: falha explícita
    }
    // Comparação numérica dos valores brutos.
    return left.raw > right.raw;
  }
}

// Shape de moeda: catálogo ISO 4217 com código numérico e casas decimais.
shape Currency {
  // Rótulo do shape exibido no builder e nos formulários.
  title: { pt-BR: "Moeda", en: "Currency" }
  // Referência da classificação que originou os códigos abaixo.
  classification: "https://www.iso.org/iso-4217-currency-codes.html"
  // Dirham dos Emirados Árabes Unidos: código 784, 2 casas decimais.
  value AED { numeric: "784", scale: 2 }
  // Afegani afegão: código 971, 2 casas decimais.
  value AFN { numeric: "971", scale: 2 }
  // Lek albanês: código 008, 2 casas decimais.
  value ALL { numeric: "008", scale: 2 }
  // Dram armênio: código 051, 2 casas decimais.
  value AMD { numeric: "051", scale: 2 }
  // Kwanza angolano: código 973, 2 casas decimais.
  value AOA { numeric: "973", scale: 2 }
  // Peso argentino: código 032, 2 casas decimais.
  value ARS { numeric: "032", scale: 2 }
  // Dólar australiano: código 036, 2 casas decimais.
  value AUD { numeric: "036", scale: 2 }
  // Florim arubano: código 533, 2 casas decimais.
  value AWG { numeric: "533", scale: 2 }
  // Manat azerbaijano: código 944, 2 casas decimais.
  value AZN { numeric: "944", scale: 2 }
  // Marco conversível da Bósnia e Herzegovina: código 977, 2 casas decimais.
  value BAM { numeric: "977", scale: 2 }
  // Dólar de Barbados: código 052, 2 casas decimais.
  value BBD { numeric: "052", scale: 2 }
  // Taka de Bangladesh: código 050, 2 casas decimais.
  value BDT { numeric: "050", scale: 2 }
  // Dinar bareinita: código 048, 3 casas decimais (fração de 1/1000).
  value BHD { numeric: "048", scale: 3 }
  // Franco burundinês: código 108, sem casas decimais.
  value BIF { numeric: "108", scale: 0 }
  // Dólar bermudense: código 060, 2 casas decimais.
  value BMD { numeric: "060", scale: 2 }
