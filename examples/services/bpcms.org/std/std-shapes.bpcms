        pt-BR: { one: "byte por segundo", other: "bytes por segundo" } // português: singular/plural
        en: { one: "byte per second", other: "bytes per second" } // inglês: singular/plural
      }
    }
    // Kibibyte por segundo: 8192 bits por segundo (base 2).
