  // Encerra o bloco de valores ISO declarados acima.
  }

  // Serializa a moeda como o código de três letras.
  write(value, out) {
    // Grava o código ISO no fluxo.
    out.writeString(value);
  }

  // Lê a moeda de volta do fluxo serializado.
  read(in) {
    // A moeda foi gravada como texto; devolve o código lido.
    return in.readString();
  }

  // Aceita o código digitado sem normalizar.
  parse(text, flags) {
    // Devolve o texto recebido, que já é o código da moeda.
    return text;
  }

  // Exibe a moeda como o próprio código ISO.
  format(value, flags) {
    // Não há formatação adicional para o código da moeda.
    return value;
}
// Shape de duração: intervalos de tempo de nanossegundos a semanas.
shape Duration {
  // Rótulo do shape exibido no builder e nos formulários.
  title: { pt-BR: "Duração", en: "Duration" }
  // Tipo do valor bruto guardado internamente pelo shape.
  base: decimal
  // Dimensão física usada em SLAs, prazos e operadores de tempo.
  dimension: duration
  // Catálogo de unidades de tempo aceitas.
  units {
    // Segundo: unidade-base do SI para tempo.
    s: {
      // Fator de conversão para a unidade-base (1 = identidade).
      factor: 1
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "segundo", other: "segundos" } // português: singular/plural
        en: { one: "second", other: "seconds" } // inglês: singular/plural
      }
    }
    // Milissegundo: milésimo do segundo.
    ms: {
      // Fator de conversão: 1 ms vale 0,001 s.
      factor: 0.001
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "milissegundo", other: "milissegundos" } // português: singular/plural
        en: { one: "millisecond", other: "milliseconds" } // inglês: singular/plural
      }
    }
    // Microssegundo: milionésimo do segundo.
    us: {
      // Fator de conversão: 1 µs vale 0,000001 s.
      factor: 0.000001
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "microssegundo", other: "microssegundos" } // português: singular/plural
        en: { one: "microsecond", other: "microseconds" } // inglês: singular/plural
      }
    }
    // Nanossegundo: bilionésimo do segundo, comum em latência.
    ns: {
      // Fator de conversão: 1 ns vale 0,000000001 s.
      factor: 0.000000001
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "nanossegundo", other: "nanossegundos" } // português: singular/plural
        en: { one: "nanosecond", other: "nanoseconds" } // inglês: singular/plural
      }
    }
    // Minuto: sessenta segundos.
    min: {
      // Fator de conversão: 1 min vale 60 s.
      factor: 60
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "minuto", other: "minutos" } // português: singular/plural
        en: { one: "minute", other: "minutes" } // inglês: singular/plural
      }
    }
    // Hora: sessenta minutos.
    h: {
      // Fator de conversão: 1 h vale 3600 s.
      factor: 3600
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "hora", other: "horas" } // português: singular/plural
        en: { one: "hour", other: "hours" } // inglês: singular/plural
      }
    }
    // Dia: vinte e quatro horas, base de prazos e SLAs.
    d: {
      // Fator de conversão: 1 d vale 86 400 s.
      factor: 86400
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "dia", other: "dias" } // português: singular/plural
        en: { one: "day", other: "days" } // inglês: singular/plural
      }
    }
    // Semana: sete dias, usada em ciclos e prazos longos.
    week: {
      // Fator de conversão: 1 semana vale 604 800 s.
      factor: 604800
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "semana", other: "semanas" } // português: singular/plural
        en: { one: "week", other: "weeks" } // inglês: singular/plural
      }
    }
  }
  // Leitura de texto aceita quantidade com unidade (ex.: "2 h").
  parse: quantity
  // Soma durações convertendo antes para a mesma unidade.
  aggregate: sum
  // Índice normalizado permite comparar e ordenar durações.
  index: normalized

  // Extrai o número bruto para cálculos externos ao shape.
  toNumber(value) {
    // Devolve o valor sem a unidade anexada.
    return value.raw;
  }

  // Serializa a duração para armazenamento, preservando a unidade.
  write(value, out) {
    // Assume segundos quando o valor não traz unidade explícita.
    const unit = value.unit ?? s;
    // Grava o símbolo da unidade no fluxo.
    out.writeString(unit);
    // Grava o número bruto no fluxo.
    out.writeDouble(value.raw);
  }

  // Reconstrói a duração a partir do fluxo serializado.
  read(in) {
    // Lê o símbolo da unidade gravado antes do número.
    const unit = in.readString();
    // Lê o número bruto na mesma ordem da escrita.
    const raw = in.readDouble();
    // Remonta a duração com unidade e valor lidos.
    return new Duration{raw, unit};
  }

  // Converte texto livre em um Duration, aceitando a unidade digitada.
  parse(text, flags) {
    // Interpreta a quantidade textual em número e unidade.
    const parsed = parseQuantity(text, flags);
    // Cria o Duration com valor e unidade reconhecidos.
    return new Duration{raw: parsed.value, unit: parsed.unit};
  }

  // Formata a duração para exibição com a unidade mais legível.
  format(value, flags) {
    // Unidade de origem; segundos quando não informada.
    const from = value.unit ?? s;
    // Respeita a unidade pedida ou escolhe a melhor para o número.
    const unit = flags.unit ?? bestUnit(value.raw, from, units);
    // Delega a formatação numérica ao formatador compartilhado.
    return formatReal(value.raw, from, unit, flags.style, flags.unitStyle);
  }
}

// Shape de tamanho de dados: bytes decimais e binários.
shape DataSize {
  // Rótulo do shape exibido no builder e nos formulários.
  title: { pt-BR: "Tamanho de dados", en: "Data size" }
  // Tipo do valor bruto guardado internamente pelo shape.
  base: decimal
  // Dimensão de dados, usada em limites de armazenamento e anexos.
  dimension: data
  // Catálogo de unidades de tamanho de dados aceitas.
  units {
    // Byte: unidade-base para tamanho de dados.
    B: {
      // Fator de conversão para a unidade-base (1 = identidade).
      factor: 1
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "byte", other: "bytes" } // português: singular/plural
        en: { one: "byte", other: "bytes" } // inglês: singular/plural
      }
    }
    // Bit: um oitavo do byte.
    bit: {
      // Fator de conversão: 1 bit vale 0,125 B.
      factor: 0.125
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "bit", other: "bits" } // português: singular/plural
        en: { one: "bit", other: "bits" } // inglês: singular/plural
      }
    }
    // Kilobyte decimal: mil bytes, padrão de fabricantes de disco.
    KB: {
      // Fator de conversão: 1 KB vale 1000 B.
      factor: 1000
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "kilobyte", other: "kilobytes" } // português: singular/plural
        en: { one: "kilobyte", other: "kilobytes" } // inglês: singular/plural
      }
    }
    // Megabyte decimal: um milhão de bytes.
    MB: {
      // Fator de conversão: 1 MB vale 1 000 000 B.
      factor: 1000000.0
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "megabyte", other: "megabytes" } // português: singular/plural
        en: { one: "megabyte", other: "megabytes" } // inglês: singular/plural
      }
    }
    // Gigabyte decimal: um bilhão de bytes.
    GB: {
      // Fator de conversão: 1 GB vale 1 000 000 000 B.
      factor: 1000000000.0
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "gigabyte", other: "gigabytes" } // português: singular/plural
        en: { one: "gigabyte", other: "gigabytes" } // inglês: singular/plural
      }
    }
    // Terabyte decimal: um trilhão de bytes.
    TB: {
      // Fator de conversão: 1 TB vale 1 000 000 000 000 B.
      factor: 1000000000000.0
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "terabyte", other: "terabytes" } // português: singular/plural
        en: { one: "terabyte", other: "terabytes" } // inglês: singular/plural
      }
    }
    // Kibibyte binário: 1024 bytes (base 2).
    KiB: {
      // Fator de conversão: 1 KiB vale 1024 B.
      factor: 1024
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "kibibyte", other: "kibibytes" } // português: singular/plural
        en: { one: "kibibyte", other: "kibibytes" } // inglês: singular/plural
      }
    }
    // Mebibyte binário: 1024 kibibytes.
    MiB: {
      // Fator de conversão: 1 MiB vale 1 048 576 B.
      factor: 1048576
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "mebibyte", other: "mebibytes" } // português: singular/plural
        en: { one: "mebibyte", other: "mebibytes" } // inglês: singular/plural
      }
    }
    // Gibibyte binário: 1024 mebibytes.
    GiB: {
      // Fator de conversão: 1 GiB vale 1 073 741 824 B.
      factor: 1073741824
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "gibibyte", other: "gibibytes" } // português: singular/plural
        en: { one: "gibibyte", other: "gibibytes" } // inglês: singular/plural
      }
    }
    // Tebibyte binário: 1024 gibibytes.
    TiB: {
      // Fator de conversão: 1 TiB vale 1 099 511 627 776 B.
      factor: 1099511627776
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "tebibyte", other: "tebibytes" } // português: singular/plural
        en: { one: "tebibyte", other: "tebibytes" } // inglês: singular/plural
      }
    }
  }
  // Leitura de texto aceita quantidade com unidade (ex.: "512 MiB").
  parse: quantity
  // Soma tamanhos convertendo antes para a mesma unidade.
  aggregate: sum
  // Índice normalizado permite comparar e ordenar tamanhos.
  index: normalized
}

