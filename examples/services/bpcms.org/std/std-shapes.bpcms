        pt-BR: { one: "pé por segundo ao quadrado", other: "pés por segundo ao quadrado" } // português: singular/plural
        en: { one: "foot per second squared", other: "feet per second squared" } // inglês: singular/plural
      }
    }
    // Aceleração padrão da gravidade: referência para forças g.
    g: {
      // Fator de conversão: 1 g vale 9,80665 m/s².
      factor: 9.80665
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "grama-força", other: "gramas-força" } // português: singular/plural
        en: { one: "gram-force", other: "gram-force" } // inglês: singular/plural
      }
    }
  }
  // Leitura de texto aceita quantidade com unidade (ex.: "9,8 m/s²").
  parse: quantity
}

// Shape de força: newtons e unidades correlatas.
shape Force {
  // Rótulo do shape exibido no builder e nos formulários.
  title: { pt-BR: "Força", en: "Force" }
  // Tipo do valor bruto guardado internamente pelo shape.
  base: decimal
  // Dimensão física usada em engenharia mecânica.
  dimension: force
  // Catálogo de unidades de força aceitas.
  units {
    // Newton: unidade-base do SI para força.
    N: {
      // Fator de conversão para a unidade-base (1 = identidade).
      factor: 1
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "newton", other: "newtons" } // português: singular/plural
        en: { one: "newton", other: "newtons" } // inglês: singular/plural
      }
    }
    // Quilonewton: mil newtons, comum em estruturas.
    kN: {
      // Fator de conversão: 1 kN vale 1000 N.
      factor: 1000
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "quilonewton", other: "quilonewtons" } // português: singular/plural
        en: { one: "kilonewton", other: "kilonewtons" } // inglês: singular/plural
      }
    }
    // Dina: unidade do sistema CGS.
    dyn: {
      // Fator de conversão: 1 dyn vale 1e-5 N.
      factor: 1e-05
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "dina", other: "dinas" } // português: singular/plural
        en: { one: "dyne", other: "dynes" } // inglês: singular/plural
      }
    }
    // Libra-força: unidade de força do sistema imperial/US.
    lbf: {
      // Fator de conversão: 1 lbf vale 4,4482216152605 N.
      factor: 4.4482216152605
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "libra-força", other: "libras-força" } // português: singular/plural
        en: { one: "pound-force", other: "pounds-force" } // inglês: singular/plural
      }
    }
    // Quilograma-força: peso de um quilograma sob gravidade padrão.
    kgf: {
      // Fator de conversão: 1 kgf vale 9,80665 N.
      factor: 9.80665
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "quilograma-força", other: "quilogramas-força" } // português: singular/plural
        en: { one: "kilogram-force", other: "kilograms-force" } // inglês: singular/plural
      }
    }
  }
  // Leitura de texto aceita quantidade com unidade (ex.: "10 kN").
  parse: quantity

  // Multiplica força por deslocamento e produz energia (trabalho).
  operator *(left: Force, right: Length): Energy {
    // Converte a força para newtons.
    const f = convert(left.raw, left.unit, N);
    // Converte o deslocamento para metros.
    const d = convert(right.raw, right.unit, m);
    // Resultado em joules.
    return new Energy{raw: f * d, unit: J};
  }
}

