  title: { pt-BR: "Taxa", en: "Rate" }
  // Tipo do valor bruto guardado internamente pelo shape.
  base: decimal
  // Dimensão de taxa, distinta de razão por ter base temporal.
  dimension: rate
  // Catálogo de intervalos de tempo usados como denominador.
  units {
    // Por segundo: unidade-base da dimensão taxa.
    1_s: {
      // Fator de conversão para a unidade-base (1 = identidade).
      factor: 1
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "por segundo", other: "por segundo" } // português: singular/plural
        en: { one: "per second", other: "per second" } // inglês: singular/plural
      }
    }
    // Por minuto: um sessenta avos de ocorrência por segundo.
    1_min: {
      // Fator de conversão: 1/min equivale a 0,01666... por segundo.
      factor: 0.016666666666666666
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "por minuto", other: "por minuto" } // português: singular/plural
        en: { one: "per minute", other: "per minute" } // inglês: singular/plural
      }
    }
    // Por hora: ocorrências ao longo de sessenta minutos.
    1_h: {
      // Fator de conversão: 1/h equivale a 0,00027777... por segundo.
      factor: 0.0002777777777777778
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "por hora", other: "por hora" } // português: singular/plural
        en: { one: "per hour", other: "per hour" } // inglês: singular/plural
      }
    }
    // Por dia: ocorrências ao longo de vinte e quatro horas.
    1_d: {
      // Fator de conversão: 1/d equivale a 1,1574e-5 por segundo.
      factor: 1.1574074074074073e-05
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "por dia", other: "por dia" } // português: singular/plural
        en: { one: "per day", other: "per day" } // inglês: singular/plural
      }
    }
  }
  // Leitura de texto aceita quantidade com unidade (ex.: "5/min").
  parse: quantity
}

