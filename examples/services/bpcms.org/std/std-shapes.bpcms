        en: { one: "acre", other: "acres" } // inglês: singular/plural
      }
    }
    // Pé quadrado: padrão de área de imóveis nos EUA.
    ft2: {
      // Fator de conversão: 1 ft² vale 0,09290304 m².
      factor: 0.09290304
      // Nomes exibidos para a unidade em cada idioma.
