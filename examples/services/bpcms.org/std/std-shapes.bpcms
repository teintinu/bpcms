        en: { one: "part per million", other: "parts per million" } // inglês: singular/plural
      }
    }
    // Parte por bilhão: razão para concentrações muito baixas.
    ppb: {
      // Aproximação: 1 ppb vale 1e-9 mol/L em soluções diluídas.
      factor: 1e-09
      // Nomes exibidos para a unidade em cada idioma.
