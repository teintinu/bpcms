    // Hectare: dez mil metros quadrados, padrão para imóveis rurais.
    ha: {
      // Fator de conversão: 1 ha vale 10 000 m².
      factor: 10000.0
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "hectare", other: "hectares" } // português: singular/plural
        en: { one: "hectare", other: "hectares" } // inglês: singular/plural
