      }
    }
    // Gigabit por segundo: um bilhão de bits por segundo.
    Gbps: {
      // Fator de conversão: 1 Gbps vale 1 000 000 000 bps.
      factor: 1000000000.0
      // Nomes exibidos para a unidade em cada idioma.
