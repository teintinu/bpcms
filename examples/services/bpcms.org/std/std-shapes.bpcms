  // Dimensão física usada em isolantes e materiais.
  dimension: thermal-conductivity
  // Catálogo de unidades de condutividade térmica aceitas.
  units {
    // Watt por metro kelvin: unidade-base coerente.
    W_mK: {
      // Fator de conversão para a unidade-base (1 = identidade).
      factor: 1
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        pt-BR: { one: "watt por metro kelvin", other: "watts por metro kelvin" } // português: singular/plural
        en: { one: "watt per meter kelvin", other: "watts per meter kelvin" } // inglês: singular/plural
      }
    }
    // BTU por hora pé grau Fahrenheit: unidade imperial/US.
    BTU_h_ft_F: {
      // Fator de conversão: 1 BTU/(h·ft·°F) vale 1,730734666 W/(m·K).
      factor: 1.730734666
      // Nomes exibidos para a unidade em cada idioma.
      title: {
        // português: singular/plural
        pt-BR: { one: "BTU por hora pé grau Fahrenheit", other: "BTU por hora pé grau Fahrenheit" }
        // inglês: singular/plural
        en: { one: "BTU per hour foot degree Fahrenheit", other: "BTU per hour foot degree Fahrenheit" }
      }
    }
  }
  // Leitura de texto aceita quantidade com unidade.
  parse: quantity
}

