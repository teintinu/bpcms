// service: example.com/services/claims

document Coverage {
  title: { pt-BR: "Cobertura", en: "Coverage" }
  version: 1
  owner: "Claims"

  fields {
    policyNumber: string {
      title: { pt-BR: "Apólice", en: "Policy number" }
      lookup
      unique
      maxLength: 24
    }
    product: string { title: { pt-BR: "Produto", en: "Product" }, lookup, maxLength: 60 }
    validFrom: DateTime { title: { pt-BR: "Vigente de", en: "Valid from" } }
    validTo: DateTime { title: { pt-BR: "Vigente até", en: "Valid to" } }
    limitAmount: std.Money {
      title: { pt-BR: "Limite de indenização", en: "Coverage limit" }
      currency: BRL
      required
    }
    deductible: std.Money { title: { pt-BR: "Franquia", en: "Deductible" }, currency: BRL }
    status: CoverageStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    expiredAt: DateTime { title: { pt-BR: "Expirada em", en: "Expired at" }, readonly }
  }

  indexes {
    byPolicy: [policyNumber] unique
    byStatus: [status, validTo] range
  }


  actions {
    expire() {
      title: { pt-BR: "Expirar cobertura", en: "Expire coverage" }
      roles: [Clerk]
      to: status.Expired
      { expiredAt = now() }
    }

    renew(newValidTo: DateTime) {
      title: { pt-BR: "Renovar cobertura", en: "Renew coverage" }
      roles: [Clerk]
      to: status.Active
      emits { validTo: newValidTo }
      { validTo = newValidTo }
    }
  }
}

document Settlement {
  title: { pt-BR: "Liquidação", en: "Settlement" }
  version: 1
  owner: "Claims"
  sync: live

  fields {
    number: string {
      title: { pt-BR: "Número", en: "Number" }
      lookup
      unique
      maxLength: 24
    }
    claim: Claim { title: { pt-BR: "Sinistro", en: "Claim" }, lookup }
    amount: std.Money {
      title: { pt-BR: "Valor", en: "Amount" }
      currency: BRL
      lookup
      required
    }
    method: PaymentMethod { title: { pt-BR: "Forma de pagamento", en: "Payment method" }, lookup }
    status: SettlementStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    approvedAt: DateTime { title: { pt-BR: "Aprovada em", en: "Approved at" }, readonly }
    paidAt: DateTime { title: { pt-BR: "Paga em", en: "Paid at" }, readonly }
    reversedAt: DateTime { title: { pt-BR: "Estornada em", en: "Reversed at" }, readonly }
    note: string { title: { pt-BR: "Observação", en: "Note" }, maxLength: 500 }
  }

  indexes {
    byNumber: [number] unique
    byStatus: [status, approvedAt] range
  }


  actions {
    approve() {
      title: { pt-BR: "Aprovar liquidação", en: "Approve settlement" }
      roles: [FinanceAnalyst, Manager]
      to: status.Approved
      { approvedAt = now() }
    }

    pay() {
      title: { pt-BR: "Pagar liquidação", en: "Pay settlement" }
      roles: [FinanceAnalyst]
      to: status.Paid
      { paidAt = now() }
    }

    reverse(reason: string) {
      title: { pt-BR: "Estornar liquidação", en: "Reverse settlement" }
      roles: [Manager]
      to: status.Pending
      { reversedAt = now(); note = reason }
    }
  }
}

document Claim {
  title: { pt-BR: "Sinistro", en: "Claim" }
  version: 1
  owner: "Claims"
  sync: live
  retention: 10y

  fields {
    number: string {
      title: { pt-BR: "Número", en: "Number" }
      lookup
      unique
      maxLength: 24
    }
    claimant: Identity.User { title: { pt-BR: "Segurado", en: "Claimant" }, lookup }
    coverage: Coverage { title: { pt-BR: "Cobertura", en: "Coverage" }, lookup }
    type: ClaimType {
      title: { pt-BR: "Tipo de sinistro", en: "Claim type" }
      lookup
      default: Collision
    }
    occurredAt: DateTime { title: { pt-BR: "Ocorrido em", en: "Occurred at" }, required }
    description: string {
      title: { pt-BR: "Descrição", en: "Description" }
      sensitive
      maxLength: 2000
    }
    amount: std.Money {
      title: { pt-BR: "Valor reclamado", en: "Claimed amount" }
      currency: BRL
      lookup
      required
    }
    approvedAmount: std.Money { title: { pt-BR: "Valor aprovado", en: "Approved amount" }, currency: BRL }
    status: ClaimStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    covered: boolean { title: { pt-BR: "Cobertura confirmada", en: "Coverage confirmed" }, default: false }
    fraudBand: FraudBand { title: { pt-BR: "Faixa de risco", en: "Fraud band" }, lookup }
    fraudConfirmed: boolean {
      title: { pt-BR: "Fraude confirmada", en: "Fraud confirmed" }
      default: false
      private
    }
    fraudNote: string { title: { pt-BR: "Nota da análise", en: "Fraud note" }, maxLength: 1000 }
    lastEvidenceKind: EvidenceKind { title: { pt-BR: "Última evidência", en: "Last evidence" } }
    evidenceSummary: string {
      title: { pt-BR: "Resumo das evidências", en: "Evidence summary" }
      maxLength: 1000
    }
    rejectReason: string {
      title: { pt-BR: "Motivo da recusa", en: "Rejection reason" }
      sensitive
      maxLength: 500
    }
    statementAt: DateTime { title: { pt-BR: "Declaração em", en: "Statement at" }, readonly }
    adjuster: Identity.User { title: { pt-BR: "Ajustador", en: "Adjuster" } }
    openedAt: DateTime { title: { pt-BR: "Aberto em", en: "Opened at" }, readonly }
    decidedAt: DateTime { title: { pt-BR: "Decidido em", en: "Decided at" }, readonly }
    paidAt: DateTime { title: { pt-BR: "Pago em", en: "Paid at" }, readonly }
    paymentReference: string {
      title: { pt-BR: "Referência do pagamento", en: "Payment reference" }
      maxLength: 40
    }
  }

  indexes {
    byNumber: [number] unique
    byStatus: [status, openedAt] range
    byCoverage: [coverage.id] hash
    byClaimant: [claimant.id] hash
  }

  events {
    Opened {
      title: { pt-BR: "Aviso de sinistro aberto", en: "Claim notice opened" }
      payload {
        occurredAt: DateTime { title: { pt-BR: "Ocorrido em", en: "Occurred at" } }
        amount: std.Money { title: { pt-BR: "Valor reclamado", en: "Claimed amount" } }
      }
    }
  }

  actions {
    register(occurredOn: DateTime, claimedAmount: std.Money) {
      title: { pt-BR: "Registrar aviso", en: "Register notice" }
      roles: [Clerk, Policyholder]
      {
        emit Opened { occurredAt: occurredOn; amount: claimedAmount }
        openedAt = now()
        occurredAt = occurredOn
        amount = claimedAmount
      }
    }

    triage(coveredNow: boolean, claimType: ClaimType, assignedAdjuster: Identity.User) {
      title: { pt-BR: "Triar sinistro", en: "Triage claim" }
      roles: [Clerk]
      to: status.Triaged
      emits { covered: coveredNow; type: claimType }
      {
        covered = coveredNow
        type = claimType
        adjuster = assignedAdjuster
      }
    }

    describe(text: string) {
      title: { pt-BR: "Declarar o ocorrido", en: "Describe the incident" }
      roles: [Policyholder]
      { description = text; statementAt = now() }
    }

    startReview() {
      title: { pt-BR: "Iniciar análise", en: "Start review" }
      roles: [Clerk, Adjuster]
      to: status.UnderReview
      emits { at: now() }
    }

    recordRisk(band: FraudBand) {
      title: { pt-BR: "Registrar faixa de risco", en: "Record fraud band" }
      roles: [FraudAnalyst]
      { fraudBand = band }
    }

    recordEvidence(kind: EvidenceKind, summary: string) {
      title: { pt-BR: "Registrar evidência", en: "Record evidence" }
      roles: [FraudAnalyst, Adjuster]
      { lastEvidenceKind = kind; evidenceSummary = summary }
    }

    confirmFraud(note: string) {
      title: { pt-BR: "Confirmar fraude", en: "Confirm fraud" }
      roles: [FraudAnalyst, Manager]
      { fraudConfirmed = true; fraudNote = note }
    }

    clearFraud(note: string) {
      title: { pt-BR: "Descartar fraude", en: "Clear fraud" }
      roles: [FraudAnalyst, Manager]
      { fraudConfirmed = false; fraudNote = note }
    }

    approve(approvedTotal: std.Money) {
      title: { pt-BR: "Aprovar sinistro", en: "Approve claim" }
      roles: [Adjuster]
      to: status.Approved
      emits { approvedAmount: approvedTotal; at: now() }
      { approvedAmount = approvedTotal; decidedAt = now() }
    }

    reject(reason: string) {
      title: { pt-BR: "Recusar sinistro", en: "Reject claim" }
      roles: [Clerk, Adjuster]
      to: status.Rejected
      emits { at: now() }
      { rejectReason = reason; decidedAt = now() }
    }

    openSettlement() {
      title: { pt-BR: "Abrir liquidação", en: "Open settlement" }
      roles: [FinanceAnalyst]
      returns: Settlement
    }

    confirmPayment(reference: string) {
      title: { pt-BR: "Confirmar pagamento", en: "Confirm payment" }
      roles: [FinanceAnalyst]
      to: status.Paid
      emits { amount: approvedAmount }
      { paidAt = now(); paymentReference = reference }
    }

    reopen() {
      title: { pt-BR: "Reabrir análise", en: "Reopen review" }
      roles: [Manager]
      to: status.UnderReview
      emits { at: now() }
    }
  }
}
