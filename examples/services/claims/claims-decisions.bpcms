// service: example.com/services/claims

decision FraudRisk {
  title: { pt-BR: "Risco de fraude do sinistro", en: "Claim fraud risk" }
  returns: FraudBand

  inputs {
    amount: std.Money
    type: ClaimType
  }

  cases {
    amount > 50000 BRL -> High
    type == Theft and amount > 20000 BRL -> High
    amount > 15000 BRL -> Medium
    else -> Low
  }

  source: "Política Antifraude v4"
  owner: "Fraud"
}
