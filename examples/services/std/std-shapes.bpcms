shape CurrencyCode {
  title: { pt-BR: "Código de moeda", en: "Currency code" }
  base: string
  dimension: currency
  validate: iso-4217


  write(value, out) {
    out.writeString(value.raw);
  }

  read(in) {
    return new CurrencyCode{raw: in.readString()};
  }

  parse(text, flags) {
    return new CurrencyCode{raw: text};
  }

  format(value, flags) {
    return value.raw;
  }
}

