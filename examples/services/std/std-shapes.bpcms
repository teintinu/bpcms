    fl_oz: { factor: 0.0000295735295625 }
    tbsp: { factor: 0.0000147867647813 }
    tsp: { factor: 0.00000492892159375 }
    bbl: { factor: 0.158987294928 }
    bu: { factor: 0.03523907016688 }
  }
  parse: quantity
  aggregate: sum
  index: normalized

  method toNumber(value): number {
    return value.raw;
  }

  method write(out: stream): void {
    const unit = value.unit ?? m3;
    out.writeString(unit);
    out.writeDouble(value.raw);
  }

  method read(in: stream): Volume {
    const unit = in.readString();
    const raw = in.readDouble();
    return Volume.fromRaw(raw, unit);
