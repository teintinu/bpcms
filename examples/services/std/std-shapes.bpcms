shape CurrencyCode {
  title: { pt-BR: "Código de moeda", en: "Currency code" }
  base: text
  dimension: currency
  validate: iso-4217

  method toNumber(value): number {
    throw Error("CurrencyCode has no numeric value");
  }

  method write(out: stream): void {
    out.writeString(value.raw);
  }

  method read(in: stream): CurrencyCode {
    return CurrencyCode.fromRaw(in.readString());
  }

  method parse(text: string, flags: FormatFlags): CurrencyCode {
    return CurrencyCode.fromRaw(text);
  }

  method format(flags: FormatFlags): string {
    return value.raw;
  }
}

