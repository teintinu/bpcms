      factor: 1e-06
      title: {
        pt-BR: { one: "microampère", other: "microampères" }
        en: { one: "microampere", other: "microamperes" }
      }
    }
    kA: {
      factor: 1000
      title: {
        pt-BR: { one: "quiloampère", other: "quiloampères" }
        en: { one: "kiloampere", other: "kiloamperes" }
      }
    }
  }
  parse: quantity

  operator *(left: ElectricCurrent, right: Duration): ElectricCharge {
    const i = convert(left.raw, left.unit, A);
    const t = convert(right.raw, right.unit, s);
    return new ElectricCharge{raw: i * t, unit: C};
  }
}

shape ElectricCharge {
  title: { pt-BR: "Carga elétrica", en: "Electric charge" }
  base: decimal
  dimension: electric-charge
  units {
    C: {
      factor: 1
      title: {
        pt-BR: { one: "coulomb", other: "coulombs" }
        en: { one: "coulomb", other: "coulombs" }
      }
    }
    mC: {
      factor: 0.001
      title: {
        pt-BR: { one: "milicoulomb", other: "milicoulombs" }
        en: { one: "millicoulomb", other: "millicoulombs" }
      }
    }
    uC: {
      factor: 1e-06
      title: {
        pt-BR: { one: "microcoulomb", other: "microcoulombs" }
        en: { one: "microcoulomb", other: "microcoulombs" }
      }
    }
    Ah: {
      factor: 3600
      title: {
        pt-BR: { one: "ampère-hora", other: "ampère-horas" }
        en: { one: "ampere-hour", other: "ampere-hours" }
      }
    }
    mAh: {
      factor: 3.6
      title: {
        pt-BR: { one: "miliampère-hora", other: "miliampère-horas" }
        en: { one: "milliampere-hour", other: "milliampere-hours" }
      }
    }
  }
  parse: quantity

  operator /(left: ElectricCharge, right: Duration): ElectricCurrent {
    const q = convert(left.raw, left.unit, C);
    const t = convert(right.raw, right.unit, s);
    return new ElectricCurrent{raw: q / t, unit: A};
  }
}

shape Voltage {
  title: { pt-BR: "Tensão elétrica", en: "Voltage" }
  base: decimal
  dimension: voltage
  units {
    V: {
      factor: 1
      title: {
        pt-BR: { one: "volt", other: "volts" }
        en: { one: "volt", other: "volts" }
      }
    }
    mV: {
      factor: 0.001
      title: {
        pt-BR: { one: "milivolt", other: "milivolts" }
        en: { one: "millivolt", other: "millivolts" }
      }
    }
    kV: {
      factor: 1000
      title: {
        pt-BR: { one: "quilovolt", other: "quilovolts" }
        en: { one: "kilovolt", other: "kilovolts" }
      }
    }
    uV: {
      factor: 1e-06
      title: {
        pt-BR: { one: "microvolt", other: "microvolts" }
        en: { one: "microvolt", other: "microvolts" }
      }
    }
  }
  parse: quantity

  operator *(left: Voltage, right: ElectricCurrent): Power {
    const v = convert(left.raw, left.unit, V);
    const i = convert(right.raw, right.unit, A);
    return new Power{raw: v * i, unit: W};
  }
}

