shape Temperature {
  title: { pt-BR: "Temperatura", en: "Temperature" }
  base: decimal
  dimension: temperature
  units {
    K: {
      factor: 1
      title: {
        pt-BR: { one: "kelvin", other: "kelvins" }
        en: { one: "kelvin", other: "kelvins" }
      }
    }
    C: {
      formula: K - 273.15
      title: {
        pt-BR: { one: "grau Celsius", other: "graus Celsius" }
        en: { one: "degree Celsius", other: "degrees Celsius" }
      }
    }
    F: {
      formula: {
        to(K) { return (K - 273.15) * 1.8 + 32; }
        from(F) { return (F - 32) / 1.8 + 273.15; }
      }
      title: {
        pt-BR: { one: "grau Fahrenheit", other: "graus Fahrenheit" }
        en: { one: "degree Fahrenheit", other: "degrees Fahrenheit" }
      }
    }
    R: {
      formula: {
        to(K) { return K * 1.8; }
        from(R) { return R / 1.8; }
      }
      title: {
        pt-BR: { one: "grau Rankine", other: "graus Rankine" }
        en: { one: "degree Rankine", other: "degrees Rankine" }
      }
    }
  }
  parse: quantity
}

shape Count {
  title: { pt-BR: "Contagem", en: "Count" }
