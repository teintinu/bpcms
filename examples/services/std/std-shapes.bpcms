    ct: { factor: 0.2 }
    Da: { factor: 1.66053904e-24 }
    Msun: { factor: 1.988475e33 }
  }
  parse: quantity
  aggregate: sum
  index: normalized

  method toNumber(value): number {
    return value.raw;
  }

  method write(out: stream): void {
    const unit = value.unit ?? g;
    out.writeString(unit);
    out.writeDouble(value.raw);
  }

  method read(in: stream): Mass {
    const unit = in.readString();
