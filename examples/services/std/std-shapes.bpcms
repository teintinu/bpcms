// Pseudo-service bpcms.org/std: definido pelo builder, não publicado.
// Modos: SI, imperial/US, CGS, astronômico, atômico/nuclear, química, dados e estatística.

shape Length {
  title: { pt-BR: "Comprimento", en: "Length" }
  base: decimal
  dimension: length
  units {
    m: { factor: 1 }
    cm: { factor: 0.01 }
    mm: { factor: 0.001 }
    um: { factor: 1e-06 }
    nm: { factor: 1e-09 }
    km: { factor: 1000 }
    in: { factor: 0.0254 }
    ft: { factor: 0.3048 }
    yd: { factor: 0.9144 }
    mi: { factor: 1609.344 }
    nmi: { factor: 1852 }
    AU: { factor: 149597870700 }
    ly: { factor: 9460730472580800 }
    pc: { factor: 3.085677581e+16 }
    angstrom: { factor: 1e-10 }
  }
  parse: quantity
  aggregate: sum
  index: normalized

  method toNumber(value): number {
    return value.raw;
  }

  method write(out: stream): void {
    const unit = value.unit ?? m;
    out.writeString(unit);
    out.writeDouble(value.raw);
  }

  method read(in: stream): Length {
    const unit = in.readString();
    const raw = in.readDouble();
    return Length.fromRaw(raw, unit);
  }

  method parse(text: string, flags: FormatFlags): Length {
    const unit = flags.unit ?? m;
    return Length.fromRaw(ParseReal(text, unit), unit);
  }

  method format(flags: FormatFlags): string {
    const from = value.unit ?? m;
    const unit = flags.unit ?? BestUnit(value.raw, from, units);
    return FormatReal(value.raw, from, unit, flags.style);
  }
}

shape Mass {
