  method format(flags: FormatFlags): string {
    const from = value.unit ?? m3;
    const unit = flags.unit ?? BestUnit(value.raw, from, units);
    return FormatReal(value.raw, from, unit, flags.style);
  }
}

shape Percentage {
  title: { pt-BR: "Percentual", en: "Percentage" }
  base: decimal
  dimension: ratio
  units {
    %: { factor: 1 }
  }
  scale: 2
  max: 100
  parse: percent
  format: percent
  aggregate: weighted-average

  method toNumber(value): number {
    return value.raw;
  }

  method write(out: stream): void {
    const unit = value.unit ?? %;
    out.writeString(unit);
    out.writeDouble(value.raw);
  }

  method read(in: stream): Percentage {
    const unit = in.readString();
    const raw = in.readDouble();
    return Percentage.fromRaw(raw, unit);
  }

  method parse(text: string, flags: FormatFlags): Percentage {
    const unit = flags.unit ?? %;
    return Percentage.fromRaw(ParseReal(text, unit), unit);
  }

  method format(flags: FormatFlags): string {
    const from = value.unit ?? %;
    const unit = flags.unit ?? BestUnit(value.raw, from, units);
    return FormatReal(value.raw, from, unit, flags.style);
  }
}

