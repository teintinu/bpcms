// Pseudo-service bpcms.org/std: definido pelo builder, não publicado.
// Modos: SI, imperial/US, CGS, astronômico, atômico/nuclear, química, dados e estatística.

shape Length {
  title: { pt-BR: "Comprimento", en: "Length" }
  base: decimal
  dimension: length
  units {
    m: {
      factor: 1
      title: {
        pt-BR: { one: "metro", other: "metros" }
        en: { one: "meter", other: "meters" }
      }
    }
    cm: {
      factor: 0.01
      title: {
        pt-BR: { one: "centímetro", other: "centímetros" }
        en: { one: "centimeter", other: "centimeters" }
      }
    }
    mm: {
      factor: 0.001
      title: {
        pt-BR: { one: "milímetro", other: "milímetros" }
        en: { one: "millimeter", other: "millimeters" }
      }
    }
    um: {
      factor: 1e-06
      title: {
        pt-BR: { one: "micrômetro", other: "micrômetros" }
        en: { one: "micrometer", other: "micrometers" }
      }
    }
    nm: {
      factor: 1e-09
      title: {
        pt-BR: { one: "nanômetro", other: "nanômetros" }
        en: { one: "nanometer", other: "nanometers" }
      }
    }
    km: {
      factor: 1000
      title: {
        pt-BR: { one: "quilômetro", other: "quilômetros" }
        en: { one: "kilometer", other: "kilometers" }
      }
    }
    in: {
      factor: 0.0254
      title: {
        pt-BR: { one: "polegada", other: "polegadas" }
        en: { one: "inch", other: "inches" }
      }
    }
    ft: {
      factor: 0.3048
      title: {
        pt-BR: { one: "pé", other: "pés" }
        en: { one: "foot", other: "feet" }
      }
    }
    yd: {
      factor: 0.9144
      title: {
        pt-BR: { one: "jarda", other: "jardas" }
        en: { one: "yard", other: "yards" }
      }
    }
    mi: {
      factor: 1609.344
      title: {
        pt-BR: { one: "milha", other: "milhas" }
        en: { one: "mile", other: "miles" }
      }
    }
    nmi: {
      factor: 1852
      title: {
        pt-BR: { one: "milha náutica", other: "milhas náuticas" }
        en: { one: "nautical mile", other: "nautical miles" }
      }
    }
    AU: {
      factor: 149597870700
      title: {
        pt-BR: { one: "unidade astronômica", other: "unidades astronômicas" }
        en: { one: "astronomical unit", other: "astronomical units" }
      }
    }
    ly: {
      factor: 9460730472580800
      title: {
        pt-BR: { one: "ano-luz", other: "anos-luz" }
        en: { one: "light-year", other: "light-years" }
      }
    }
    pc: {
      factor: 3.085677581e+16
      title: {
        pt-BR: { one: "parsec", other: "parsecs" }
        en: { one: "parsec", other: "parsecs" }
      }
    }
    angstrom: {
      factor: 1e-10
      title: {
        pt-BR: { one: "angstrom", other: "angstroms" }
        en: { one: "angstrom", other: "angstroms" }
      }
    }
  }
  parse: quantity
  aggregate: sum
  index: normalized

  toNumber(value) {
    return value.raw;
  }

  write(value, out) {
    const unit = value.unit ?? m;
    out.writeString(unit);
    out.writeDouble(value.raw);
  }

  read(in) {
    const unit = in.readString();
    const raw = in.readDouble();
    return new Length{raw, unit};
  }

  parse(text, flags) {
    const {value, unit} = parseQuantity(text, flags);
    return new Length{raw: value, unit};
  }

  format(value, flags) {
    const from = value.unit ?? m;
    const unit = flags.unit ?? bestUnit(value.raw, from, units);
    return formatReal(value.raw, from, unit, flags.style, flags.unitStyle);
  }

  operator +(left: Length, right: Length): Length {
    const rightInLeft = convert(right.raw, right.unit, left.unit);
    return new Length{raw: left.raw + rightInLeft, unit: left.unit};
  }

  operator -(left: Length, right: Length): Length {
    const rightInLeft = convert(right.raw, right.unit, left.unit);
    return new Length{raw: left.raw - rightInLeft, unit: left.unit};
  }

  operator *(left: Length, right: Length): Area {
    const l = convert(left.raw, left.unit, m);
    const r = convert(right.raw, right.unit, m);
    return new Area{raw: l * r, unit: m2};
  }

  operator /(left: Length, right: Duration): Speed {
    const l = convert(left.raw, left.unit, m);
    const r = convert(right.raw, right.unit, s);
    return new Speed{raw: l / r, unit: m_s};
  }
}

shape Mass {
  title: { pt-BR: "Massa", en: "Mass" }
  base: decimal
  dimension: mass
  units {
    g: {
      factor: 1
      title: {
        pt-BR: { one: "grama", other: "gramas" }
        en: { one: "gram", other: "grams" }
      }
    }
    kg: {
      factor: 1000
      title: {
        pt-BR: { one: "quilograma", other: "quilogramas" }
        en: { one: "kilogram", other: "kilograms" }
      }
    }
    mg: {
      factor: 0.001
      title: {
        pt-BR: { one: "miligrama", other: "miligramas" }
        en: { one: "milligram", other: "milligrams" }
      }
    }
    ug: {
      factor: 0.000001
      title: {
        pt-BR: { one: "micrograma", other: "microgramas" }
        en: { one: "microgram", other: "micrograms" }
      }
    }
    µg: {
      factor: 0.000001
      title: {
        pt-BR: { one: "micrograma", other: "microgramas" }
        en: { one: "microgram", other: "micrograms" }
      }
    }
    t: {
      factor: 1000000
      title: {
        pt-BR: { one: "tonelada métrica", other: "toneladas métricas" }
        en: { one: "metric ton", other: "metric tons" }
      }
    }
    lb: {
      factor: 453.59237
      title: {
        pt-BR: { one: "libra", other: "libras" }
        en: { one: "pound", other: "pounds" }
      }
    }
    oz: {
      factor: 28.349523125
      title: {
        pt-BR: { one: "onça", other: "onças" }
        en: { one: "ounce", other: "ounces" }
      }
    }
    st: {
      factor: 6350.29318
      title: {
        pt-BR: { one: "stone", other: "stones" }
        en: { one: "stone", other: "stones" }
      }
    }
    ton: {
      factor: 907184.74
      title: {
        pt-BR: { one: "tonelada curta", other: "toneladas curtas" }
        en: { one: "short ton", other: "short tons" }
      }
    }
    ct: {
      factor: 0.2
      title: {
        pt-BR: { one: "quilate", other: "quilates" }
        en: { one: "carat", other: "carats" }
      }
    }
    Da: {
      factor: 1.66053904e-24
      title: {
        pt-BR: { one: "dalton", other: "daltons" }
        en: { one: "dalton", other: "daltons" }
      }
    }
    Msun: {
      factor: 1.988475e33
      title: {
        pt-BR: { one: "massa solar", other: "massas solares" }
        en: { one: "solar mass", other: "solar masses" }
      }
    }
  }
  parse: quantity
  aggregate: sum
  index: normalized

  toNumber(value) {
    return value.raw;
  }

  write(value, out) {
    const unit = value.unit ?? g;
    out.writeString(unit);
    out.writeDouble(value.raw);
  }

  read(in) {
    const unit = in.readString();
    const raw = in.readDouble();
    return new Mass{raw, unit};
  }

  parse(text, flags) {
    const parsed = parseQuantity(text, flags);
    return new Mass{raw: parsed.value, unit: parsed.unit};
  }

  format(value, flags) {
    const from = value.unit ?? g;
    const unit = flags.unit ?? bestUnit(value.raw, from, units);
    return formatReal(value.raw, from, unit, flags.style, flags.unitStyle);
  }

  operator /(left: Mass, right: Volume): Density {
    const m = convert(left.raw, left.unit, g);
    const v = convert(right.raw, right.unit, m3);
    return new Density{raw: m / 1000 / v, unit: kg_m3};
  }

  operator *(left: Mass, right: Acceleration): Force {
    const m = convert(left.raw, left.unit, g) / 1000;
    const a = convert(right.raw, right.unit, m_s2);
    return new Force{raw: m * a, unit: N};
  }
}

