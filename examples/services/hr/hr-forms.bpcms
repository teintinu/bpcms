// service: example.com/services/hr

form OnboardingDocuments {
  title: { pt-BR: "Documentos de integração", en: "Onboarding documents" }
  document: Employee

  fields {
    identityDocument
  }

  actions {
    submit { calls: Employee.submitDocuments(identityDocument) }
  }
}

form EquipmentRequest {
  title: { pt-BR: "Pedido de equipamento", en: "Equipment request" }
  document: Employee

  fields {
    kind: EquipmentKind {
      title: { pt-BR: "Equipamento", en: "Equipment" }
      required
    }
  }

  actions {
    order { calls: Employee.orderEquipment(kind) }
  }
}

form ManagerCheckin {
  title: { pt-BR: "Check-in do gestor", en: "Manager check-in" }
  document: Employee

  fields {
    note: string {
      title: { pt-BR: "Observação", en: "Note" }
      maxLength: 500
    }
  }

  actions {
    confirm { calls: Employee.activate }
    recordNote { calls: Employee.recordCheckinNote(note); stay }
  }
}

form AccessConfirmation {
  title: { pt-BR: "Confirmação de acesso", en: "Access confirmation" }
  document: Employee

  fields {
    note: string {
      title: { pt-BR: "Observação", en: "Note" }
      maxLength: 500
    }
  }

  actions {
    confirm { calls: Employee.confirmAccess }
    report { calls: Employee.reportAccessIssue(note) }
  }
}

form AccessRevocation {
  title: { pt-BR: "Revogação de acessos", en: "Access revocation" }
  document: Employee

  fields {
    note: string {
      title: { pt-BR: "Observação", en: "Note" }
      maxLength: 500
    }
  }

  actions {
    revoke { calls: Employee.revokeAllAccess(note) }
  }
}

form EquipmentReturn {
  title: { pt-BR: "Devolução de equipamento", en: "Equipment return" }
  document: Employee

  fields {
    kind: EquipmentKind {
      title: { pt-BR: "Equipamento", en: "Equipment" }
      required
    }
  }

  actions {
    returnItem { calls: Employee.returnEquipment(kind) }
  }
}

form ExitInterview {
  title: { pt-BR: "Entrevista de saída", en: "Exit interview" }
  document: Employee

  fields {
    notes: string {
      title: { pt-BR: "Anotações", en: "Notes" }
      maxLength: 2000
    }
  }

  actions {
    record { calls: Employee.recordExitInterview(notes) }
  }
}
