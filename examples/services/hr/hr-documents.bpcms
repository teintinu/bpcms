// service: example.com/services/hr

document Candidate {
  title: { pt-BR: "Candidato", en: "Candidate" }
  version: 1
  owner: "People"
  sync: live
  retention: 2y

  fields {
    name: string { title: { pt-BR: "Nome", en: "Name" }, lookup, maxLength: 120 }
    email: string { title: { pt-BR: "E-mail", en: "Email" }, sensitive, maxLength: 160 }
    position: string { title: { pt-BR: "Vaga", en: "Position" }, lookup, maxLength: 120 }
    department: Department { title: { pt-BR: "Área", en: "Department" }, lookup }
    status: CandidateStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    source: string { title: { pt-BR: "Origem", en: "Source" }, maxLength: 60 }
    appliedAt: DateTime { title: { pt-BR: "Inscrito em", en: "Applied at" }, readonly }
    rejectReason: string { title: { pt-BR: "Motivo da recusa", en: "Rejection reason" }, maxLength: 500 }
  }

  indexes {
    byStatus: [status, appliedAt] range
    byPosition: [position] hash
  }


  actions {
    screen() {
      title: { pt-BR: "Triar candidato", en: "Screen candidate" }
      roles: [Recruiter]
      to: status.Screening
      emits { at: now() }
    }

    scheduleInterview() {
      title: { pt-BR: "Agendar entrevista", en: "Schedule interview" }
      roles: [Recruiter]
      to: status.Interview
      emits { at: now() }
    }

    extendOffer() {
      title: { pt-BR: "Enviar proposta", en: "Extend offer" }
      roles: [HiringManager, Recruiter]
      to: status.Offer
      emits { at: now() }
    }

    hire() {
      title: { pt-BR: "Contratar", en: "Hire" }
      roles: [HiringManager]
      to: status.Hired
      emits { at: now() }
    }

    reject(reason: string) {
      title: { pt-BR: "Recusar candidato", en: "Reject candidate" }
      roles: [Recruiter, HiringManager]
      to: status.Rejected
      { rejectReason = reason }
    }
  }
}

document Employee {
  title: { pt-BR: "Colaborador", en: "Employee" }
  version: 1
  owner: "People"
  sync: live
  retention: 10y

  fields {
    number: string {
      title: { pt-BR: "Matrícula", en: "Employee number" }
      lookup
      unique
      maxLength: 20
    }
    person: Identity.User { title: { pt-BR: "Pessoa", en: "Person" }, lookup }
    candidate: Candidate { title: { pt-BR: "Candidato", en: "Candidate" }, lookup }
    position: string { title: { pt-BR: "Cargo", en: "Position" }, lookup, maxLength: 120 }
    department: Department { title: { pt-BR: "Área", en: "Department" }, lookup }
    employmentType: EmploymentType { title: { pt-BR: "Vínculo", en: "Employment type" }, lookup }
    manager: Identity.User { title: { pt-BR: "Gestor", en: "Manager" } }
    status: EmployeeStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    hiredAt: DateTime { title: { pt-BR: "Contratado em", en: "Hired at" }, readonly }
    startedAt: DateTime { title: { pt-BR: "Início", en: "Start date" } }
    lastWorkingDay: DateTime { title: { pt-BR: "Último dia", en: "Last working day" } }
    identityDocument: string {
      title: { pt-BR: "Documento de identidade", en: "Identity document" }
      sensitive
      maxLength: 40
    }
    documentsComplete: boolean {
      title: { pt-BR: "Documentos completos", en: "Documents complete" }
      default: false
    }
    mailboxProvisioned: boolean {
      title: { pt-BR: "Caixa de e-mail provisionada", en: "Mailbox provisioned" }
      default: false
    }
    systemsProvisioned: boolean {
      title: { pt-BR: "Sistemas provisionados", en: "Systems provisioned" }
      default: false
    }
    accessConfirmed: boolean { title: { pt-BR: "Acesso confirmado", en: "Access confirmed" }, default: false }
    accessIssue: string { title: { pt-BR: "Problema de acesso", en: "Access issue" }, maxLength: 500 }
    accessRevokedAt: DateTime { title: { pt-BR: "Acessos revogados em", en: "Access revoked at" }, readonly }
    equipmentReturnedAt: DateTime {
      title: { pt-BR: "Equipamento devolvido em", en: "Equipment returned at" }
      readonly
    }
    lastEquipmentKind: EquipmentKind { title: { pt-BR: "Último equipamento", en: "Last equipment" } }
    exitInterviewNotes: string {
      title: { pt-BR: "Entrevista de saída", en: "Exit interview" }
      maxLength: 2000
    }
    offboardingReason: string { title: { pt-BR: "Motivo do desligamento", en: "Offboarding reason" }, maxLength: 500 }
    checkinNote: string { title: { pt-BR: "Nota do check-in", en: "Check-in note" }, maxLength: 500 }
  }

  indexes {
    byNumber: [number] unique
    byStatus: [status, startedAt] range
    byDepartment: [department] hash
    byPerson: [person.id] hash
  }


  actions {
    hire(firstDay: DateTime) {
      title: { pt-BR: "Registrar contratação", en: "Register hire" }
      roles: [PeopleOps]
      {
        emit Hired { startedAt: firstDay }
        hiredAt = now()
        startedAt = firstDay
      }
    }

    submitDocuments(documentNumber: string) {
      title: { pt-BR: "Enviar documentos", en: "Submit documents" }
      roles: [NewHire, PeopleOps]
      { identityDocument = documentNumber; documentsComplete = true }
    }

    provisionMailbox() {
      title: { pt-BR: "Provisionar e-mail", en: "Provision mailbox" }
      roles: [ITAdmin]
      { mailboxProvisioned = true }
    }

    provisionSystems() {
      title: { pt-BR: "Provisionar sistemas", en: "Provision systems" }
      roles: [ITAdmin]
      { systemsProvisioned = true }
    }

    confirmAccess() {
      title: { pt-BR: "Confirmar acesso", en: "Confirm access" }
      roles: [NewHire]
      { accessConfirmed = true }
    }

    reportAccessIssue(note: string) {
      title: { pt-BR: "Relatar problema de acesso", en: "Report access issue" }
      roles: [NewHire]
      { accessIssue = note; accessConfirmed = false }
    }

    orderEquipment(kind: EquipmentKind) {
      title: { pt-BR: "Pedir equipamento", en: "Order equipment" }
      roles: [ITAdmin, PeopleOps]
      returns: EquipmentOrder
      { lastEquipmentKind = kind }
    }

    recordCheckinNote(note: string) {
      title: { pt-BR: "Registrar check-in do gestor", en: "Record manager check-in" }
      roles: [HiringManager]
      { checkinNote = note }
    }

    activate() {
      title: { pt-BR: "Concluir integração", en: "Complete onboarding" }
      roles: [HiringManager, PeopleOps]
      to: status.Active
      emits { at: now() }
    }

    cancelOnboarding(reason: string) {
      title: { pt-BR: "Cancelar integração", en: "Cancel onboarding" }
      roles: [PeopleOps]
      to: status.Terminated
      { offboardingReason = reason }
    }

    startOffboarding(reason: string, lastDay: DateTime) {
      title: { pt-BR: "Iniciar desligamento", en: "Start offboarding" }
      roles: [PeopleOps, HiringManager]
      to: status.Offboarding
      { offboardingReason = reason; lastWorkingDay = lastDay }
    }

    cancelOffboarding(reason: string) {
      title: { pt-BR: "Cancelar desligamento", en: "Cancel offboarding" }
      roles: [PeopleOps]
      to: status.Active
    }

    revokeAllAccess(note: string) {
      title: { pt-BR: "Revogar acessos", en: "Revoke all access" }
      roles: [ITAdmin]
      { accessRevokedAt = now(); accessIssue = note }
    }

    returnEquipment(kind: EquipmentKind) {
      title: { pt-BR: "Registrar devolução", en: "Register equipment return" }
      roles: [ITAdmin]
      { equipmentReturnedAt = now(); lastEquipmentKind = kind }
    }

    recordExitInterview(notes: string) {
      title: { pt-BR: "Registrar entrevista de saída", en: "Record exit interview" }
      roles: [PeopleOps]
      { exitInterviewNotes = notes }
    }

    terminate() {
      title: { pt-BR: "Desligar colaborador", en: "Terminate employee" }
      roles: [PeopleOps]
      to: status.Terminated
      emits { at: now() }
    }
  }
}

document AccessGrant {
  title: { pt-BR: "Concessão de acesso", en: "Access grant" }
  version: 1
  owner: "People"
  sync: live

  fields {
    employee: Employee { title: { pt-BR: "Colaborador", en: "Employee" }, lookup }
    system: AccessSystem { title: { pt-BR: "Sistema", en: "System" }, lookup }
    profile: string { title: { pt-BR: "Perfil", en: "Profile" }, maxLength: 60 }
    status: AccessGrantStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    requestedAt: DateTime { title: { pt-BR: "Solicitado em", en: "Requested at" }, readonly }
    requestedBy: Identity.User { title: { pt-BR: "Solicitado por", en: "Requested by" } }
    provisionedAt: DateTime { title: { pt-BR: "Provisionado em", en: "Provisioned at" }, readonly }
    revokedAt: DateTime { title: { pt-BR: "Revogado em", en: "Revoked at" }, readonly }
    revokeReason: string { title: { pt-BR: "Motivo da revogação", en: "Revocation reason" }, maxLength: 500 }
  }

  indexes {
    byEmployee: [employee.id] hash
    byStatus: [status, requestedAt] range
  }


  actions {
    provision() {
      title: { pt-BR: "Provisionar acesso", en: "Provision access" }
      roles: [ITAdmin]
      to: status.Provisioned
      emits { at: now() }
      { provisionedAt = now() }
    }

    revoke(reason: string) {
      title: { pt-BR: "Revogar acesso", en: "Revoke access" }
      roles: [ITAdmin, PeopleOps]
      to: status.Revoked
      { revokedAt = now(); revokeReason = reason }
    }
  }
}

document EquipmentOrder {
  title: { pt-BR: "Pedido de equipamento", en: "Equipment order" }
  version: 1
  owner: "People"
  sync: live

  fields {
    employee: Employee { title: { pt-BR: "Colaborador", en: "Employee" }, lookup }
    kind: EquipmentKind { title: { pt-BR: "Equipamento", en: "Equipment" }, lookup }
    vendor: string { title: { pt-BR: "Fornecedor", en: "Vendor" }, maxLength: 120 }
    serial: string { title: { pt-BR: "Número de série", en: "Serial number" }, lookup, maxLength: 60 }
    status: EquipmentOrderStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    orderedAt: DateTime { title: { pt-BR: "Pedido em", en: "Ordered at" }, readonly }
    deliveredAt: DateTime { title: { pt-BR: "Entregue em", en: "Delivered at" }, readonly }
    returnedAt: DateTime { title: { pt-BR: "Devolvido em", en: "Returned at" }, readonly }
  }

  indexes {
    byEmployee: [employee.id] hash
    byStatus: [status, orderedAt] range
  }


  actions {
    deliver(serialNumber: string) {
      title: { pt-BR: "Registrar entrega", en: "Register delivery" }
      roles: [ITAdmin]
      to: status.Delivered
      emits { serial: serialNumber }
      { serial = serialNumber; deliveredAt = now() }
    }

    returnItem() {
      title: { pt-BR: "Registrar devolução", en: "Register return" }
      roles: [ITAdmin]
      to: status.Returned
      emits { at: now() }
      { returnedAt = now() }
    }
  }
}
