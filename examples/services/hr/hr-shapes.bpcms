// service: example.com/services/hr

shape CandidateStatus {
  title: { pt-BR: "Situação do candidato", en: "Candidate status" }
  base: state
  initial: Applied

  value Applied {
    title: { pt-BR: "Inscrito", en: "Applied" }
    icon: status.applied
    ordinal: 10

    transition Screening {
      event: Screened
      title: { pt-BR: "Candidato triado", en: "Candidate screened" }
      payload {
        at: DateTime { title: { pt-BR: "Em", en: "At" } }
      }
    }

    transition Rejected {
      title: { pt-BR: "Candidato recusado", en: "Candidate rejected" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Screening {
    title: { pt-BR: "Em triagem", en: "Screening" }
    icon: status.screening
    ordinal: 20

    transition Interview {
      event: InterviewScheduled
      title: { pt-BR: "Entrevista agendada", en: "Interview scheduled" }
      payload {
        at: DateTime { title: { pt-BR: "Em", en: "At" } }
      }
    }

    transition Rejected {
      title: { pt-BR: "Candidato recusado", en: "Candidate rejected" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Interview {
    title: { pt-BR: "Em entrevista", en: "Interview" }
    icon: status.interview
    ordinal: 30

    transition Offer {
      event: OfferExtended
      title: { pt-BR: "Proposta enviada", en: "Offer extended" }
      payload {
        at: DateTime { title: { pt-BR: "Em", en: "At" } }
      }
    }

    transition Rejected {
      title: { pt-BR: "Candidato recusado", en: "Candidate rejected" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Offer {
    title: { pt-BR: "Com proposta", en: "Offer" }
    icon: status.offer
    ordinal: 40

    transition Hired {
      title: { pt-BR: "Candidato contratado", en: "Candidate hired" }
      payload {
        at: DateTime { title: { pt-BR: "Em", en: "At" } }
      }
    }

    transition Rejected {
      title: { pt-BR: "Candidato recusado", en: "Candidate rejected" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Hired {
    title: { pt-BR: "Contratado", en: "Hired" }
    icon: status.hired
    ordinal: 50
  }
  value Rejected {
    title: { pt-BR: "Recusado", en: "Rejected" }
    icon: status.rejected
    ordinal: 60
  }
}

shape EmployeeStatus {
  title: { pt-BR: "Situação do colaborador", en: "Employee status" }
  base: state
  initial: Onboarding with transition Hired {
    title: { pt-BR: "Colaborador contratado", en: "Employee hired" }
    payload {
      startedAt: DateTime { title: { pt-BR: "Início", en: "Start date" } }
    }
  }

  value Onboarding {
    title: { pt-BR: "Em integração", en: "Onboarding" }
    icon: status.onboarding
    ordinal: 10

    transition Active {
      event: Activated
      title: { pt-BR: "Integração concluída", en: "Onboarding completed" }
      payload {
        at: DateTime { title: { pt-BR: "Em", en: "At" } }
      }
    }

    transition Terminated {
      event: OnboardingCancelled
      title: { pt-BR: "Integração cancelada", en: "Onboarding cancelled" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Active {
    title: { pt-BR: "Ativo", en: "Active" }
    icon: status.active
    ordinal: 20

    transition Offboarding {
      event: OffboardingStarted
      title: { pt-BR: "Desligamento iniciado", en: "Offboarding started" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Offboarding {
    title: { pt-BR: "Em desligamento", en: "Offboarding" }
    icon: status.offboarding
    ordinal: 30

    transition Active {
      event: OffboardingCancelled
      title: { pt-BR: "Desligamento cancelado", en: "Offboarding cancelled" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }

    transition Terminated {
      title: { pt-BR: "Colaborador desligado", en: "Employee terminated" }
      payload {
        at: DateTime { title: { pt-BR: "Em", en: "At" } }
      }
    }
  }
  value Terminated {
    title: { pt-BR: "Desligado", en: "Terminated" }
    icon: status.terminated
    ordinal: 40
  }
}

shape AccessGrantStatus {
  title: { pt-BR: "Situação do acesso", en: "Access grant status" }
  base: state
  initial: Requested

  value Requested {
    title: { pt-BR: "Solicitado", en: "Requested" }
    icon: status.requested
    ordinal: 10

    transition Provisioned {
      title: { pt-BR: "Acesso provisionado", en: "Access provisioned" }
      payload {
        at: DateTime { title: { pt-BR: "Em", en: "At" } }
      }
    }

    transition Revoked {
      title: { pt-BR: "Acesso revogado", en: "Access revoked" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Provisioned {
    title: { pt-BR: "Provisionado", en: "Provisioned" }
    icon: status.provisioned
    ordinal: 20

    transition Revoked {
      title: { pt-BR: "Acesso revogado", en: "Access revoked" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Revoked {
    title: { pt-BR: "Revogado", en: "Revoked" }
    icon: status.revoked
    ordinal: 30
  }
}

shape EquipmentOrderStatus {
  title: { pt-BR: "Situação do equipamento", en: "Equipment order status" }
  base: state
  initial: Ordered

  value Ordered {
    title: { pt-BR: "Pedido", en: "Ordered" }
    icon: status.ordered
    ordinal: 10

    transition Delivered {
      title: { pt-BR: "Equipamento entregue", en: "Equipment delivered" }
      payload {
        serial: string { title: { pt-BR: "Número de série", en: "Serial number" } }
      }
    }
  }
  value Delivered {
    title: { pt-BR: "Entregue", en: "Delivered" }
    icon: status.delivered
    ordinal: 20

    transition Returned {
      title: { pt-BR: "Equipamento devolvido", en: "Equipment returned" }
      payload {
        at: DateTime { title: { pt-BR: "Em", en: "At" } }
      }
    }
  }
  value Returned {
    title: { pt-BR: "Devolvido", en: "Returned" }
    icon: status.returned
    ordinal: 30
  }
}

