// service: example.com/services/orders
document OrderPipeline {
  title: { pt-BR: "Funil de pedidos", en: "Order pipeline" }
  type: report
  computed from Order
  freshness: 10m

  report {
    filters { period; status }
    metrics {
    placed: count(Order) where status == placed
    cancelled: count(Order) where status == cancelled
    revenue: sum(Order.total) where status == placed
    avgTicket: avg(Order.total)
    }
    units { revenue: BRL; avgTicket: BRL }
  }
}