// service: example.com/services/orders
document OrderItem {
  title: { pt-BR: "Item de pedido", en: "Order item" }
  version: 1
  owner: "Orders"
  sync: live

  fields {
    order: Order {
      title: { pt-BR: "Pedido", en: "Order" }
    }
    product: Product {
      title: { pt-BR: "Produto", en: "Product" }
      lookup
    }
    quantity: std.Count { title: { pt-BR: "Quantidade", en: "Quantity" }, lookup, min: 1, max: 1000 }
    unitPrice: std.Money { title: { pt-BR: "Preço unitário", en: "Unit price" }, currency: BRL }
    total: std.Money { title: { pt-BR: "Total", en: "Total" }, currency: BRL }
  }

  indexes {
    byOrder: [order.id] hash
    byProduct: [product.id] hash
  }

  rules {
    quantity > 0: {
      fields: []
      pt-BR: "Regra do documento não atendida"
      en: "Document rule not met"
    }
    total == quantity * unitPrice: {
      fields: []
      pt-BR: "Regra do documento não atendida"
      en: "Document rule not met"
    }
  }
}

document Order {
  title: { pt-BR: "Pedido", en: "Order" }
  version: 1
  owner: "Orders"
  sync: live
  audit: true

  fields {
    customer: User {
      title: { pt-BR: "Cliente", en: "Customer" }
      lookup
    }
    items: OrderItem[] { title: { pt-BR: "Itens", en: "Items" } }
    subtotal: std.Money { title: { pt-BR: "Subtotal", en: "Subtotal" }, currency: BRL }
    discount: std.Money { title: { pt-BR: "Desconto", en: "Discount" }, currency: BRL }
    total: std.Money { title: { pt-BR: "Total", en: "Total" }, lookup, currency: BRL }
    status: OrderStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    placedAt: DateTime { title: { pt-BR: "Realizado em", en: "Placed at" } }
    createdAt: DateTime { title: { pt-BR: "Criado em", en: "Created at" }, lookup }
  }

  indexes {
    byCustomer: [customer.id, createdAt] range
    byStatus: [status, createdAt] range
  }


  actions {
    create(customer: User, discount: std.Percentage){
      title: { pt-BR: "Criar", en: "Create" }
      roles: [Clerk]
      {
      audit("order.created", discount)
      }
    }

    addItem(product: Product, quantity: std.Count){
      title: { pt-BR: "Adicionar item", en: "Add item" }
      roles: [Clerk]
      rules {
        quantity > 0: {
          fields: [quantity]
          pt-BR: "Requisito não atendido"
          en: "Requirement not met"
        }
      }
    }

    place(){
      title: { pt-BR: "Realizar pedido", en: "Place order" }
      roles: [Clerk]
      transition: Placed
      rules {
        items.length > 0: {
          fields: []
          pt-BR: "Requisito não atendido"
          en: "Requirement not met"
        }
      }
      {
      placedAt = now()
      audit("order.placed")
      }
    }

    cancel(reason: string){
      title: { pt-BR: "Cancelar", en: "Cancel" }
      roles: [Manager]
      transition: Cancelled
      rules {
        reason.length >= 10: {
          fields: [reason]
          pt-BR: "Requisito não atendido"
          en: "Requirement not met"
        }
      }
      {
      audit("order.cancelled", reason)
      }
    }

    expireDraft(){
      title: { pt-BR: "Expirar rascunho", en: "Expire draft" }
      roles: [Manager]
      transition: Cancelled
    }
  }

  rules {
    total == subtotal - discount: {
      fields: []
      pt-BR: "Regra do documento não atendida"
      en: "Document rule not met"
    }
    status == placed implies placedAt != null: {
      fields: []
      pt-BR: "Regra do documento não atendida"
      en: "Document rule not met"
    }
    items.count <= 50: {
      fields: []
      pt-BR: "Regra do documento não atendida"
      en: "Document rule not met"
    }
  }
}
