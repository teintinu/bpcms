// service: example.com/services/orders
document OrderItem {
  title: { pt-BR: "Item de pedido", en: "Order item" }
  version: 1
  owner: "Orders"
  sync: live

  fields {
    orderId: OrderId { title: { pt-BR: "Pedido", en: "Order" } }
    productId: ProductId { title: { pt-BR: "Produto", en: "Product" }, lookup }
    quantity: Count { title: { pt-BR: "Quantidade", en: "Quantity" }, lookup }
    unitPrice: MoneyBRL { title: { pt-BR: "Preço unitário", en: "Unit price" } }
    total: MoneyBRL { title: { pt-BR: "Total", en: "Total" } }
  }

  indexes {
    byOrder: [orderId] hash
    byProduct: [productId] hash
  }

  rules {
    quantity > 0
    total == quantity * unitPrice
  }
}

document Order {
  title: { pt-BR: "Pedido", en: "Order" }
  version: 1
  owner: "Orders"
  sync: live
  audit: true

  fields {
    customerId: UserId { title: { pt-BR: "Cliente", en: "Customer" }, lookup }
    items: OrderItem[] { title: { pt-BR: "Itens", en: "Items" } }
    subtotal: MoneyBRL { title: { pt-BR: "Subtotal", en: "Subtotal" } }
    discount: MoneyBRL { title: { pt-BR: "Desconto", en: "Discount" } }
    total: MoneyBRL { title: { pt-BR: "Total", en: "Total" }, lookup }
    status: OrderStatus { title: { pt-BR: "Status", en: "Status" }, lookup }
    placedAt: DateTime? { title: { pt-BR: "Realizado em", en: "Placed at" } }
    createdAt: DateTime { title: { pt-BR: "Criado em", en: "Created at" } }
  }

  indexes {
    byCustomer: [customerId, createdAt] range
    byStatus: [status, createdAt] range
  }

  actions {
    create(customerId: UserId, discount: Percentage): Order
    addItem(productId: ProductId, quantity: Count): Order
    place(): Order
    cancel(reason: Text): Order
    expireDraft(): Order
  }

  rules {
    total == subtotal - discount
    status == placed implies placedAt != null
    items.count <= 50
  }
}
