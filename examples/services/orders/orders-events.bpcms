// service: example.com/services/orders
event Placed {
  title: { pt-BR: "Pedido realizado", en: "Order placed" }
  version: 1
  payload {
    orderId: OrderId { title: { pt-BR: "Pedido", en: "Order" } }
    customerId: UserId { title: { pt-BR: "Cliente", en: "Customer" } }
    total: MoneyBRL { title: { pt-BR: "Total", en: "Total" } }
    placedAt: DateTime { title: { pt-BR: "Realizado em", en: "Placed at" } }
  }
  producer: Order
  consumers: [Payments, Shipping, Billing, Notifications]
  key: orderId
}

event Cancelled {
  title: { pt-BR: "Pedido cancelado", en: "Order cancelled" }
  version: 1
  payload {
    orderId: OrderId { title: { pt-BR: "Pedido", en: "Order" } }
    reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
    cancelledAt: DateTime { title: { pt-BR: "Cancelado em", en: "Cancelled at" } }
  }
  producer: Order
  consumers: [Payments, Shipping, Notifications]
  key: orderId
}
