// service: example.com/services/orders
view OrderForm {
  title: { pt-BR: "Formulário de pedido", en: "Order form" }
  type: form
  document: Order
  roles: [Clerk]

  fields {
    customerId: UserId { title: { pt-BR: "Cliente", en: "Customer" }, required }
    discount: std.Money { title: { pt-BR: "Desconto", en: "Discount" }, currency: BRL }
    status: OrderStatus { title: { pt-BR: "Situação", en: "Status" }, readonly }
  }

  actions {
    save -> Order.create
    place -> Order.place
    cancel -> none
  }
}

view OrderDetail {
  title: { pt-BR: "Detalhe do pedido", en: "Order detail" }
  type: detail
  document: Order
  roles: [Clerk, Manager]

  sections { summary; items; timeline; documents }
  actions { place; cancel; print }
}
