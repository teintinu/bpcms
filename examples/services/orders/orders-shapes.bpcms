// service: example.com/services/orders


shape OrderStatus {
  title: { pt-BR: "Situação do pedido", en: "Order status" }
  base: workflow
  initial: draft
  value draft {
    title: { pt-BR: "Rascunho", en: "Draft" }
    icon: Draft
    ordinal: 10
    next: [placed, cancelled]
  }
  value placed {
    title: { pt-BR: "Realizado", en: "Placed" }
    icon: Placed
    ordinal: 20
    next: [cancelled, fulfilled]
  }
  value cancelled {
    title: { pt-BR: "Cancelada", en: "Cancelled" }
    icon: Cancelled
    ordinal: 30
    next: []
  }
  value fulfilled {
    title: { pt-BR: "Atendido", en: "Fulfilled" }
    icon: Fulfilled
    ordinal: 40
    next: []
  }
  format: plain

}
