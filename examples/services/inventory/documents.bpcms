// service: example.com/services/inventory
document StockItem {
  version: 1
  owner: "Inventory"
  sync: live
  audit: true

  fields {
    id: StockItemId
    productId: ProductId
    warehouse: Text { maxLength: 40 }
    available: Count
    reserved: Count
    reorderPoint: Count
    lastMovement: DateTime
  }

  indexes {
    uniqueProduct: [productId, warehouse] unique
    byAvailable: [available] range
    byMovement: [lastMovement] range
  }

  actions {
    adjust(quantity: Count, reason: Text): StockItem
    reserve(quantity: Count): Reservation
    release(quantity: Count): StockItem
  }

  rules {
    available >= 0
    reserved >= 0
  }
}

document Reservation {
  version: 1
  owner: "Inventory"
  sync: live

  fields {
    id: ReservationId
    productId: ProductId
    quantity: Count
    externalRef: Text
    status: ReservationStatus
    expiresAt: DateTime
  }

  indexes {
    byExternal: [externalRef] hash
    byExpiry: [status, expiresAt] range
  }

  actions {
    request(productId: ProductId, quantity: Count, externalRef: Text): Reservation
    release(): Reservation
    expire(): Reservation
  }

  rules {
    quantity > 0
  }
}
