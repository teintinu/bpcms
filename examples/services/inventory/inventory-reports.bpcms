// service: example.com/services/inventory
view StockAging {
  title: { pt-BR: "Envelhecimento de estoque", en: "Inventory aging" }
  type: report
  sources: [StockItem, Product]
  roles: [StockManager]

  filters { warehouse; category }

  metrics {
    quantity: sum(StockItem.available)
    value: sum(StockItem.available * Product.price)
    aging: bucket(StockItem.lastMovement, [30d, 60d, 90d, 180d])
  }

  freshness: 15m
  export: [csv, xlsx]
}

view StockControl {
  title: { pt-BR: "Controle de estoque", en: "Stock control" }
  type: dashboard
  sources: [StockItem]
  roles: [StockManager]
  mode: live

  filters { warehouse }

  metrics {
    lowStock: count(StockItem) where available <= reorderPoint
    reserved: sum(StockItem.reserved)
  }

  freshness: 15m
}
