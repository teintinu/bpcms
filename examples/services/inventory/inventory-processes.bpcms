// service: example.com/services/inventory
process StockReplenishment for StockItem {
  title: { pt-BR: "Reposição de estoque", en: "Stock replenishment" }
  version: 1
  goal: "Identificar itens abaixo do ponto de pedido e criar a requisição de compra"
  owner: "Supply Chain"
  timezone: America/Fortaleza

  variables {
    decision: ReorderDecision
  }

  start Daily {
    schedule: "0 5 * * *"
    select: stockItem.available <= stockItem.reorderPoint
  }

  task Decide {
    lane: System
    decision: ReorderPoint
    with {
      available: stockItem.available
      reorderPoint: stockItem.reorderPoint
    }
    gives: decision
    sla: 5m
  }

  gateway Reorder {
    if decision == Reorder -> CreateRequest
    else -> NotNeeded
  }

  task CreateRequest {
    lane: System
    action: ReplenishmentRequest.create
    with { stockItem }
    sla: 5m
  }

  end Requested {
    title: { pt-BR: "Reposição solicitada", en: "Replenishment requested" }
    outcome: success
  }

  end NotNeeded {
    title: { pt-BR: "Sem reposição", en: "No replenishment needed" }
    outcome: success
  }

  Daily -> Decide
  Decide -> Reorder
  CreateRequest -> Requested
}

process CycleCount for CountSheet {
  title: { pt-BR: "Contagem cíclica", en: "Cycle count" }
  version: 1
  goal: "Contar o estoque com leitura de dispositivo, tratar divergência e aprovar"
  owner: "Supply Chain"
  timezone: America/Fortaleza

  pool Company {
    internal
    lane Warehouse { role: WarehouseOperator }
    lane Management { role: StockManager }
  }

  start Created {
    event: CountSheet.Created
  }

  task Capture {
    lane: Warehouse
    form: CountCapture
    sla: 1d
    assign: pull
  }

  task Approve {
    lane: Management
    form: CountApproval
    sla: 1d
    assign: pull
  }

  // discricionária: disponível quando há divergência; concluir leva à aprovação (caminho alternativo, 4.7)
  task Recount {
    lane: Warehouse
    form: RecountCapture
    discretionary
    when: countSheet.divergence != 0 and countSheet.status == Counted
    assign: pull
  }

  end Approved {
    title: { pt-BR: "Contagem aprovada", en: "Count approved" }
    outcome: success
  }

  end Rejected {
    title: { pt-BR: "Contagem rejeitada", en: "Count rejected" }
    outcome: cancelled
  }

  Created -> Capture
  Capture.submit -> Approve
  Recount.recount -> Approve
  Approve.approve -> Approved
  Approve.reject -> Rejected
}
