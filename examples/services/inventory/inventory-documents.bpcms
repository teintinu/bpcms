// service: example.com/services/inventory
document StockItem {
  title: { pt-BR: "Item de estoque", en: "Stock item" }
  version: 1
  owner: "Inventory"
  sync: live
  fields {
    product: Product {
      title: { pt-BR: "Produto", en: "Product" }
      lookup
    }
    warehouse: string { title: { pt-BR: "Armazém", en: "Warehouse" }, maxLength: 40, lookup }
    available: std.Count { title: { pt-BR: "Disponível", en: "Available" }, min: 0, max: 100000 }
    reserved: std.Count { title: { pt-BR: "Reservado", en: "Reserved" } }
    reorderPoint: std.Count { title: { pt-BR: "Ponto de reposição", en: "Reorder point" } }
    status: StockStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    blockedReason: string { title: { pt-BR: "Motivo do bloqueio", en: "Block reason" } }
    lastMovement: DateTime { title: { pt-BR: "Última movimentação", en: "Last movement" } }
  }

  indexes {
    uniqueProduct: [product.id, warehouse] unique
    byAvailable: [available] range
    byMovement: [lastMovement] range
    byStatus: [status, lastMovement] range
  }


  actions {
    adjust(quantity: std.Count, reason: string){
      title: { pt-BR: "Ajustar estoque", en: "Adjust stock" }
      roles: [WarehouseOperator]
      rule reason.length >= 10 {
        pt-BR: "Informe um motivo com pelo menos 10 caracteres"
        en: "Enter a reason with at least 10 characters"
      }
      {
        available = available + quantity
      }
    }

    reserve(quantity: std.Count){
      title: { pt-BR: "Reservar", en: "Reserve" }
      roles: [WarehouseOperator]

      to: status.Reserved

      {
        reserved = reserved + quantity
      }
    }

    release(quantity: std.Count){
      title: { pt-BR: "Liberar", en: "Release" }
      roles: [WarehouseOperator]

      to: status.Available

      {
        reserved = reserved - quantity
      }
    }

    block(reason: string){
      title: { pt-BR: "Bloquear", en: "Block" }
      roles: [StockManager]

      to: status.Blocked

      {
        blockedReason = reason
      }
    }

    unblock(){
      title: { pt-BR: "Desbloquear", en: "Unblock" }
      roles: [StockManager]

      to: status.Available
      emits { at: now() }
    }
  }

  rule available >= 0 {
    pt-BR: "Verifique os dados informados"
    en: "Check the informed data"
  }
  rule reserved >= 0 {
    pt-BR: "Verifique os dados informados"
    en: "Check the informed data"
  }
}

document Reservation {
  title: { pt-BR: "Reserva", en: "Reservation" }
  version: 1
  owner: "Inventory"
  sync: live

  fields {
    product: Product {
      title: { pt-BR: "Produto", en: "Product" }
      lookup
    }
    quantity: std.Count { title: { pt-BR: "Quantidade", en: "Quantity" }, lookup }
    externalRef: string { title: { pt-BR: "Referência externa", en: "External reference" } }
    status: ReservationStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    expiresAt: DateTime { title: { pt-BR: "Expira em", en: "Expires at" } }
  }

  indexes {
    byExternal: [externalRef] hash
    byExpiry: [status, expiresAt] range
  }


  actions {
    request(product: Product, quantity: std.Count, externalRef: string){
      title: { pt-BR: "Reservar", en: "Reserve" }
      roles: [WarehouseOperator]
    }

    release(){
      title: { pt-BR: "Liberar", en: "Release" }
      roles: [WarehouseOperator]

      to: status.Released
      emits { releasedAt: now() }
    }

    expire(){
      title: { pt-BR: "Expirar", en: "Expire" }
      roles: [StockManager]

      to: status.Expired
      emits { expiredAt: now() }
    }
  }

  rule quantity > 0 {
    pt-BR: "A quantidade deve ser maior que zero"
    en: "Quantity must be greater than zero"
  }
}

document ReplenishmentRequest {
  title: { pt-BR: "Requisição de reposição", en: "Replenishment request" }
  version: 1
  owner: "Inventory"
  sync: live

  fields {
    stockItem: StockItem {
      title: { pt-BR: "Item de estoque", en: "Stock item" }
      lookup
    }
    quantity: std.Count { title: { pt-BR: "Quantidade", en: "Quantity" }, lookup }
    status: RequisitionStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    requestedAt: DateTime { title: { pt-BR: "Solicitada em", en: "Requested at" } }
    cancelledReason: string { title: { pt-BR: "Motivo do cancelamento", en: "Cancellation reason" } }
  }

  indexes {
    byStatus: [status, requestedAt] range
    byItem: [stockItem.id, requestedAt] range
  }

  events {
    Requested {
      title: { pt-BR: "Reposição solicitada", en: "Replenishment requested" }
      payload {
        quantity: std.Count { title: { pt-BR: "Quantidade", en: "Quantity" } }
      }
    }
  }

  actions {
    create(stockItem: StockItem){
      title: { pt-BR: "Criar requisição", en: "Create request" }
      roles: [StockManager]
      returns: ReplenishmentRequest
      {
        quantity = stockItem.reorderPoint
        requestedAt = now()
        emit Requested { quantity }
      }
    }

    cancel(reason: string){
      title: { pt-BR: "Cancelar requisição", en: "Cancel request" }
      roles: [StockManager]

      to: status.Cancelled

      {
        cancelledReason = reason
      }
    }
  }
}

document CountSheet {
  title: { pt-BR: "Folha de contagem", en: "Count sheet" }
  version: 1
  owner: "Inventory"
  sync: live

  fields {
    stockItem: StockItem {
      title: { pt-BR: "Item de estoque", en: "Stock item" }
      lookup
    }
    expected: std.Count { title: { pt-BR: "Esperado", en: "Expected" }, lookup }
    counted: std.Count { title: { pt-BR: "Contado", en: "Counted" }, lookup }
    divergence: std.Count {
      title: { pt-BR: "Divergência", en: "Divergence" }
      lookup
      computed: counted - expected
    }
    status: CountStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    countedAt: DateTime { title: { pt-BR: "Contada em", en: "Counted at" } }
    recountedAt: DateTime { title: { pt-BR: "Recontada em", en: "Recounted at" } }
    approvedAt: DateTime { title: { pt-BR: "Aprovada em", en: "Approved at" } }
    rejectionReason: string { title: { pt-BR: "Motivo da rejeição", en: "Rejection reason" } }
  }

  capabilities { capture, units }
  source: device "collector-01" for counted

  indexes {
    byItem: [stockItem.id, countedAt] range
    byStatus: [status, countedAt] range
  }

  events {
    Created {
      title: { pt-BR: "Contagem criada", en: "Count created" }
      payload {
        stockItem: StockItem { title: { pt-BR: "Item de estoque", en: "Stock item" } }
      }
    }
  }

  actions {
    create(stockItem: StockItem){
      title: { pt-BR: "Abrir contagem", en: "Open count" }
      roles: [StockManager]
      returns: CountSheet
      {
        expected = stockItem.available
        emit Created { stockItem: stockItem }
      }
    }

    submit(){
      title: { pt-BR: "Registrar contagem", en: "Record count" }
      roles: [WarehouseOperator]

      to: status.Counted

      {
        countedAt = now()
      }
    }

    recount(){
      title: { pt-BR: "Recontar", en: "Recount" }
      roles: [WarehouseOperator]

      {
        recountedAt = now()
      }
    }

    approve(){
      title: { pt-BR: "Aprovar contagem", en: "Approve count" }
      roles: [StockManager]

      to: status.Approved
      emits { approvedAt: now() }

      {
        approvedAt = now()
      }
    }

    reject(reason: string){
      title: { pt-BR: "Rejeitar contagem", en: "Reject count" }
      roles: [StockManager]

      to: status.Rejected

      rule reason.length >= 5 {
        pt-BR: "Informe o motivo da rejeição"
        en: "Enter the rejection reason"
      }

      {
        rejectionReason = reason
      }
    }
  }

  rule counted >= 0 {
    pt-BR: "A contagem não pode ser negativa"
    en: "Count cannot be negative"
  }
}
