// service: example.com/services/inventory
decision ReorderPoint {
  title: { pt-BR: "Ponto de pedido", en: "Reorder point" }
  owner: "Supply Chain"
  returns: ReorderDecision

  inputs {
    available: std.Count
    reorderPoint: std.Count
  }

  cases {
    available <= reorderPoint -> Reorder
    else -> Ok
  }
}
