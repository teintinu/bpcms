// service: example.com/services/inventory


shape StockStatus {
  title: { pt-BR: "Situação do estoque", en: "Stock status" }
  base: workflow
  initial: Available
  value Available {
    title: { pt-BR: "Disponível", en: "Available" }
    icon: Available
    ordinal: 10
    transition Reserved {
      title: { pt-BR: "Reservado", en: "Reserved" }
    }
    transition Blocked {
      title: { pt-BR: "Bloqueado", en: "Blocked" }
    }
  }
  value Reserved {
    title: { pt-BR: "Reservado", en: "Reserved" }
    icon: Reserved
    ordinal: 20
    transition Available {
      title: { pt-BR: "Disponível", en: "Available" }
    }
    transition Blocked {
      title: { pt-BR: "Bloqueado", en: "Blocked" }
    }
  }
  value Blocked {
    title: { pt-BR: "Bloqueado", en: "Blocked" }
    icon: Blocked
    ordinal: 30
    transition Available {
      title: { pt-BR: "Disponível", en: "Available" }
    }
  }
  format: plain

}

shape ReservationStatus {
  title: { pt-BR: "Situação da reserva", en: "Reservation status" }
  base: workflow
  initial: Active
  value Active {
    title: { pt-BR: "Ativo", en: "Active" }
    icon: Active
    ordinal: 10
    transition Released {
      title: { pt-BR: "Liberada", en: "Released" }
    }
    transition Expired {
      title: { pt-BR: "Expirada", en: "Expired" }
    }
  }
  value Released {
    title: { pt-BR: "Liberada", en: "Released" }
    icon: Released
    ordinal: 20
  }
  value Expired {
    title: { pt-BR: "Expirada", en: "Expired" }
    icon: Expired
    ordinal: 30
  }
  format: plain

}
