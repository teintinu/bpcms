// service: example.com/services/inventory


shape StockStatus {
  title: { pt-BR: "Status do estoque", en: "Stock status" }
  base: text
  values {
    available {
      title: { pt-BR: "Disponível", en: "Available" }
      icon: Available
    }
    reserved {
      title: { pt-BR: "Reservado", en: "Reserved" }
      icon: Reserved
    }
    blocked {
      title: { pt-BR: "Bloqueado", en: "Blocked" }
      icon: Blocked
    }
  }
  format: plain
}

shape ReservationStatus {
  title: { pt-BR: "Status da reserva", en: "Reservation status" }
  base: text
  values {
    active {
      title: { pt-BR: "Ativo", en: "Active" }
      icon: Active
    }
    released {
      title: { pt-BR: "Liberada", en: "Released" }
      icon: Released
    }
    expired {
      title: { pt-BR: "Expirada", en: "Expired" }
      icon: Expired
    }
  }
  format: plain
}
