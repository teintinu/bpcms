// service: example.com/services/inventory

shape StockStatus {
  title: { pt-BR: "Situação do estoque", en: "Stock status" }
  base: state
  initial: Available
  value Available {
    title: { pt-BR: "Disponível", en: "Available" }
    icon: Available
    ordinal: 10

    transition Reserved {
      title: { pt-BR: "Estoque reservado", en: "Stock reserved" }
      payload {
        quantity: std.Count { title: { pt-BR: "Quantidade", en: "Quantity" } }
      }
    }

    transition Blocked {
      title: { pt-BR: "Estoque bloqueado", en: "Stock blocked" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Reserved {
    title: { pt-BR: "Reservado", en: "Reserved" }
    icon: Reserved
    ordinal: 20

    transition Available {
      event: Released
      title: { pt-BR: "Estoque liberado", en: "Stock released" }
      payload {
        quantity: std.Count { title: { pt-BR: "Quantidade", en: "Quantity" } }
      }
    }

    transition Blocked {
      title: { pt-BR: "Estoque bloqueado", en: "Stock blocked" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Blocked {
    title: { pt-BR: "Bloqueado", en: "Blocked" }
    icon: Blocked
    ordinal: 30

    transition Available {
      event: Unblocked
      title: { pt-BR: "Estoque desbloqueado", en: "Stock unblocked" }
      payload {
        at: DateTime { title: { pt-BR: "Em", en: "At" } }
      }
    }
  }
  format: plain
}

shape ReservationStatus {
  title: { pt-BR: "Situação da reserva", en: "Reservation status" }
  base: state
  initial: Active
  value Active {
    title: { pt-BR: "Ativo", en: "Active" }
    icon: Active
    ordinal: 10

    transition Released {
      title: { pt-BR: "Reserva liberada", en: "Reservation released" }
      payload {
        releasedAt: DateTime { title: { pt-BR: "Liberada em", en: "Released at" } }
      }
    }

    transition Expired {
      title: { pt-BR: "Reserva expirada", en: "Reservation expired" }
      payload {
        expiredAt: DateTime { title: { pt-BR: "Expirada em", en: "Expired at" } }
      }
    }
  }
  value Released {
    title: { pt-BR: "Liberada", en: "Released" }
    icon: Released
    ordinal: 20
  }
  value Expired {
    title: { pt-BR: "Expirada", en: "Expired" }
    icon: Expired
    ordinal: 30
  }
  format: plain
}

shape CountStatus {
  title: { pt-BR: "Situação da contagem", en: "Count status" }
  base: state
  initial: Open
  value Open {
    title: { pt-BR: "Aberta", en: "Open" }
    icon: Open
    ordinal: 10

    transition Counted {
      title: { pt-BR: "Contagem registrada", en: "Count recorded" }
      payload {
        counted: std.Count { title: { pt-BR: "Contado", en: "Counted" } }
        divergence: std.Count { title: { pt-BR: "Divergência", en: "Divergence" } }
      }
    }
  }
  value Counted {
    title: { pt-BR: "Contada", en: "Counted" }
    icon: Counted
    ordinal: 20

    transition Approved {
      title: { pt-BR: "Contagem aprovada", en: "Count approved" }
      payload {
        approvedAt: DateTime { title: { pt-BR: "Aprovada em", en: "Approved at" } }
      }
    }

    transition Rejected {
      title: { pt-BR: "Contagem rejeitada", en: "Count rejected" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Approved {
    title: { pt-BR: "Aprovada", en: "Approved" }
    icon: Approved
    ordinal: 30
  }
  value Rejected {
    title: { pt-BR: "Rejeitada", en: "Rejected" }
    icon: Rejected
    ordinal: 40
  }
  format: plain
}

shape RequisitionStatus {
  title: { pt-BR: "Situação da requisição", en: "Requisition status" }
  base: state
  initial: Requested
  value Requested {
    title: { pt-BR: "Solicitada", en: "Requested" }
    icon: Requested
    ordinal: 10

    transition Cancelled {
      title: { pt-BR: "Requisição cancelada", en: "Request cancelled" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Cancelled {
    title: { pt-BR: "Cancelada", en: "Cancelled" }
    icon: Cancelled
    ordinal: 20
  }
  format: plain
}

shape ReorderDecision {
  title: { pt-BR: "Decisão de reposição", en: "Reorder decision" }
  base: classification
  value Reorder {
    title: { pt-BR: "Repor", en: "Reorder" }
    icon: Reorder
    ordinal: 10
  }
  value Ok {
    title: { pt-BR: "Suficiente", en: "Sufficient" }
    icon: Ok
    ordinal: 20
  }
  format: plain
}
