// service: example.com/services/inventory
view StockTable {
  title: { pt-BR: "Itens de estoque", en: "Stock items" }
  type: table
  source: StockItem
  roles: [WarehouseOperator, StockManager]

  columns { product; warehouse; available; reserved; reorderPoint; status }
  filters { warehouse; status; available }
  pagination: 50

  actions {
    open -> StockDetail
    adjust -> StockItem.adjust(quantity, reason)
    block -> StockItem.block(reason)
  }
}

view StockDetail {
  title: { pt-BR: "Detalhe do item", en: "Stock item detail" }
  type: detail
  document: StockItem
  roles: [WarehouseOperator, StockManager]

  sections { summary; movements }

  actions {
    adjust -> StockItem.adjust(quantity, reason)
    block -> StockItem.block(reason)
    unblock -> StockItem.unblock
  }
}

view StockKanban {
  title: { pt-BR: "Estoque por situação", en: "Stock by status" }
  type: kanban
  source: StockItem
  roles: [WarehouseOperator, StockManager]

  groupBy: status
  columns { product; warehouse; available; reorderPoint }
  card { product; warehouse; available; status }

  actions {
    open -> StockDetail
  }
}

view StockProgress {
  title: { pt-BR: "Andamento da reposição", en: "Replenishment progress" }
  type: process
  process: StockReplenishment
  roles: [WarehouseOperator, StockManager]

  sections { current; participants; history; deadlines; documents; milestones; next }
}

view CycleCountProgress {
  title: { pt-BR: "Andamento da contagem", en: "Count progress" }
  type: process
  process: CycleCount
  roles: [WarehouseOperator, StockManager]

  sections { current; participants; history; deadlines; documents; milestones; next }
}

view CountInbox {
  title: { pt-BR: "Fila de contagens", en: "Count queue" }
  type: inbox
  roles: [WarehouseOperator, StockManager]

  scope: lanes
  filter { lane in currentUser.lanes }
  groupBy: process
  columns { title; subject; lane; dueAt; priority }
}
