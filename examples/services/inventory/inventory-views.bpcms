// service: example.com/services/inventory
view StockTable {
  title: { pt-BR: "Tabela de estoque", en: "Stock table" }
  type: table
  source: StockItem

  columns { product; warehouse; available; reserved; reorderPoint }
  filters { warehouse; available }
  pagination: 50

  actions {
    adjust -> StockAdjustmentForm
    export -> Csv
  }
}

view StockAdjustmentForm {
  title: { pt-BR: "Ajuste de estoque", en: "Stock adjustment" }
  type: form
  document: StockItem

  fields {
    product: Product { title: { pt-BR: "Produto", en: "Product" }, required }
    quantity: std.Count { title: { pt-BR: "Quantidade", en: "Quantity" }, required }
    reason: string { title: { pt-BR: "Motivo", en: "Reason" }, required }
  }

  actions {
    save -> StockItem.adjust
    cancel -> none
  }
}

view ReservationForm {
  title: { pt-BR: "Formulário de reserva", en: "Reservation form" }
  type: form
  document: Reservation

  fields {
    product: Product { title: { pt-BR: "Produto", en: "Product" }, required }
    quantity: std.Count { title: { pt-BR: "Quantidade", en: "Quantity" }, required }
    externalRef: string { title: { pt-BR: "Referência externa", en: "External reference" } }
  }

  actions {
    save -> Reservation.request
    cancel -> none
  }
}
