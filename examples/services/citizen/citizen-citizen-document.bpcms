// service: example.com/services/citizen

document Citizen {
  title: { pt-BR: "Cidadão", en: "Citizen" }
  version: 1
  owner: "Citizen"
  sync: read
  fields {
    kind: CitizenKind { title: { pt-BR: "Tipo", en: "Kind" }, lookup }
    displayName: string {
      title: { pt-BR: "Nome de exibição", en: "Display name" }
      maxLength: 160
      lookup
      required
    }
    avatar: Image { title: { pt-BR: "Imagem de perfil", en: "Avatar" } }
    country: string {
      title: { pt-BR: "País", en: "Country" }
      maxLength: 2
      required
    }
    status: CitizenStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    mergedInto: Citizen { title: { pt-BR: "Mesclado em", en: "Merged into" }, lookup }
    mergedAt: DateTime { title: { pt-BR: "Mesclado em", en: "Merged at" } }
    private legalName: string { title: { pt-BR: "Nome legal", en: "Legal name" }, maxLength: 200 }
    private birthDate: Date { title: { pt-BR: "Data de nascimento", en: "Birth date" } }
    private documentHash: string { title: { pt-BR: "Resumo do documento", en: "Document hash" }, maxLength: 128 }
    createdAt: DateTime { title: { pt-BR: "Criado em", en: "Created at" } }
  }

  indexes {
    byDisplayName: [displayName] search
    byKind: [kind, status] hash
    byCountry: [country] hash
    byMergedInto: [mergedInto.id] hash
  }


  actions {
    register(kind: CitizenKind, displayName: string, country: string, legalName: string?, birthDate: Date?){
      title: { pt-BR: "Cadastrar cidadão", en: "Register citizen" }
      roles: [Clerk]
      {
        createdAt = now()
        emit Registered { displayName }
      }
    }

    registerPerson(displayName: string, country: string, legalName: string, birthDate: Date?){
      title: { pt-BR: "Cadastrar pessoa", en: "Register person" }
      roles: [Manager]
      {
        kind = Person
        createdAt = now()
        emit Registered { displayName }
      }
    }

    registerOrganization(displayName: string, country: string, legalName: string){
      title: { pt-BR: "Cadastrar organização", en: "Register organization" }
      roles: [Manager]
      {
        kind = Organization
        createdAt = now()
        emit Registered { displayName }
      }
    }

    merge(target: Citizen){
      title: { pt-BR: "Mesclar", en: "Merge" }
      roles: [Manager]
      to: status.Merged
      rule target != null and target.id != id {
        pt-BR: "Selecione um cidadão de destino diferente do mesclado"
        en: "Select a target citizen different from the merged one"
      }
      {
        mergedInto = target
        mergedAt = now()
      }
    }

    block(justification: string){
      title: { pt-BR: "Bloquear", en: "Block" }
      roles: [Manager]
      to: status.Blocked
      emits { reason: justification }
      rule justification.length >= 10 {
        pt-BR: "Informe um motivo com pelo menos 10 caracteres"
        en: "Enter a reason with at least 10 characters"
      }
    }
  }

  rule displayName != null {
    pt-BR: "Informe o nome de exibição"
    en: "Enter the display name"

  }
  rule country.length == 2 {
    pt-BR: "Verifique o tamanho do texto informado"
    en: "Check the informed text length"

  }
}

shape CitizenKind {
  title: { pt-BR: "Tipo de cidadão", en: "Citizen kind" }
  base: classification
  value Person {
    title: { pt-BR: "Pessoa", en: "Person" }
    icon: Person
    ordinal: 10
  }
  value Organization {
    title: { pt-BR: "Organização", en: "Organization" }
    icon: Organization
    ordinal: 20
  }
  format: plain
}

shape CitizenStatus {
  title: { pt-BR: "Situação do cidadão", en: "Citizen status" }
  base: state
  initial: Active with transition Registered {
    title: { pt-BR: "Cidadão cadastrado", en: "Citizen registered" }
    payload {
      displayName: string { title: { pt-BR: "Nome de exibição", en: "Display name" } }
    }
  }
  value Active {
    title: { pt-BR: "Ativo", en: "Active" }
    icon: Active
    ordinal: 10

    transition Merged {
      title: { pt-BR: "Cidadão mesclado", en: "Citizen merged" }
      payload {
        target: Citizen { title: { pt-BR: "Cidadão de destino", en: "Target citizen" } }
      }
    }

    transition Blocked {
      title: { pt-BR: "Cidadão bloqueado", en: "Citizen blocked" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Merged {
    title: { pt-BR: "Mesclado", en: "Merged" }
    icon: Merged
    ordinal: 20
  }
  value Blocked {
    title: { pt-BR: "Bloqueado", en: "Blocked" }
    icon: Blocked
    ordinal: 30
  }
  format: plain
}

shape Image {
  title: { pt-BR: "Imagem", en: "Image" }
  base: image
  capabilities { gui }
}

form Registration {
  title: { pt-BR: "Cadastro de cidadão", en: "Citizen registration" }
  document: Citizen

  fields {
    kind
    displayName
    avatar
    country
    legalName
    birthDate
  }

  actions {
    register { calls: Citizen.register(kind, displayName, country, legalName, birthDate) }
  }
}

view Registry {
  title: { pt-BR: "Busca de cidadãos", en: "Citizen search" }
  type: table
  source: Citizen
  roles: [Clerk, Manager, Auditor]

  columns { avatar; displayName; kind; country; status }
  filters { kind; country; status }
  pagination: 50
}
