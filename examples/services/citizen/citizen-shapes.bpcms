// service: example.com/services/citizen
shape CitizenKind {
  title: { pt-BR: "Tipo de cidadão", en: "Citizen kind" }
  base: classification
  values {
    person {
      title: { pt-BR: "Pessoa", en: "Person" }
      icon: Person
      ordinal: 10
    }
    organization {
      title: { pt-BR: "Organização", en: "Organization" }
      icon: Organization
      ordinal: 20
    }
  }
  format: plain

}

shape CitizenStatus {
  title: { pt-BR: "Status do cidadão", en: "Citizen status" }
  base: workflow
  initial: active
  values {
    active {
      title: { pt-BR: "Ativo", en: "Active" }
      icon: Active
      ordinal: 10
      next: [merged, blocked]
    }
    merged {
      title: { pt-BR: "Mesclado", en: "Merged" }
      icon: Merged
      ordinal: 20
      next: []
    }
    blocked {
      title: { pt-BR: "Bloqueado", en: "Blocked" }
      icon: Blocked
      ordinal: 30
      next: []
    }
  }
  format: plain

}

shape Email {
  title: { pt-BR: "E-mail", en: "Email" }
  base: string
  normalize: lower-trim
  validate: email
  maxLength: 254
  format: plain
  index: exact
}


shape Phone {
  title: { pt-BR: "Telefone", en: "Phone" }
  base: string
  normalize: digits
  validate: phone
  maxLength: 20
  format: masked("+## (##) #####-####")
}


shape Image {
  title: { pt-BR: "Imagem", en: "Image" }
  base: string
  validate: url
  format: image
  maxLength: 2048
}
