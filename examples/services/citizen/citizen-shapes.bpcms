// service: example.com/services/citizen
shape CitizenKind {
  title: { pt-BR: "Tipo de cidadão", en: "Citizen kind" }
  base: text
  values {
    person {
      title: { pt-BR: "Pessoa", en: "Person" }
      icon: Person
    }
    organization {
      title: { pt-BR: "Organização", en: "Organization" }
      icon: Organization
    }
  }
  format: plain
}

shape CitizenStatus {
  title: { pt-BR: "Status do cidadão", en: "Citizen status" }
  base: text
  values {
    active {
      title: { pt-BR: "Ativo", en: "Active" }
      icon: Success
    }
    merged {
      title: { pt-BR: "Mesclado", en: "Merged" }
      icon: Archived
    }
    blocked {
      title: { pt-BR: "Bloqueado", en: "Blocked" }
      icon: Error
    }
  }
  format: plain
}
