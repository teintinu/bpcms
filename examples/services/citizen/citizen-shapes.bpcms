// service: example.com/services/citizen
shape CitizenKind {
  title: { pt-BR: "Tipo de cidadão", en: "Citizen kind" }
  base: text
  values {
    person {
      title: { pt-BR: "Pessoa", en: "Person" }
      icon: Person
    }
    organization {
      title: { pt-BR: "Organização", en: "Organization" }
      icon: Organization
    }
  }
  format: plain
}

shape CitizenStatus {
  title: { pt-BR: "Status do cidadão", en: "Citizen status" }
  base: text
  values {
    active {
      title: { pt-BR: "Ativo", en: "Active" }
      icon: Active
    }
    merged {
      title: { pt-BR: "Mesclado", en: "Merged" }
      icon: Merged
    }
    blocked {
      title: { pt-BR: "Bloqueado", en: "Blocked" }
      icon: Blocked
    }
  }
  format: plain
}

shape Email {
  title: { pt-BR: "E-mail", en: "Email" }
  base: text
  normalize: lower-trim
  validate: email
  maxLength: 254
  format: plain
  index: exact
}


shape Phone {
  title: { pt-BR: "Telefone", en: "Phone" }
  base: text
  normalize: digits
  validate: phone
  maxLength: 20
  format: masked("+## (##) #####-####")
}


shape Image {
  title: { pt-BR: "Imagem", en: "Image" }
  base: text
  validate: url
  format: image
  maxLength: 2048
}
