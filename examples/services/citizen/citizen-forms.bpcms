// service: example.com/services/citizen

form Registration {
  title: { pt-BR: "Cadastro de cidadão", en: "Citizen registration" }
  document: Citizen

  fields {
    kind
    displayName
    avatar
    country
    legalName
    birthDate
  }

  actions {
    register { calls: Citizen.register(kind, displayName, country, legalName, birthDate) }
  }
}

form MergeApproval {
  title: { pt-BR: "Aprovação da mesclagem", en: "Merge approval" }
  document: Citizen

  fields {
    displayName
    kind
    country
    target: Citizen {
      title: { pt-BR: "Cadastro de destino", en: "Target record" }
      required
    }
  }

  actions {
    approve { calls: Citizen.merge(target) }
  }
}
