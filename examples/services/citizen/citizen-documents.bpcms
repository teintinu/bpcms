// service: example.com/services/citizen
document Citizen {
  title: { pt-BR: "Cidadão", en: "Citizen" }
  version: 1
  owner: "Citizen"
  sync: read
  audit: true

  fields {
    kind: CitizenKind { title: { pt-BR: "Tipo", en: "Kind" }, lookup }
    displayName: Text { title: { pt-BR: "Nome de exibição", en: "Display name" }, maxLength: 160, required, lookup }
    country: Text { title: { pt-BR: "País", en: "Country" }, maxLength: 2, required }
    status: CitizenStatus { title: { pt-BR: "Status", en: "Status" } }
    private legalName: Text { title: { pt-BR: "Nome legal", en: "Legal name" }, maxLength: 200 }
    private birthDate: Date? { title: { pt-BR: "Data de nascimento", en: "Birth date" } }
    private documentHash: Text? { title: { pt-BR: "Hash do documento", en: "Document hash" }, maxLength: 128 }
    createdAt: DateTime { title: { pt-BR: "Criado em", en: "Created at" } }
  }

  indexes {
    byDisplayName: [displayName] search
    byKind: [kind, status] hash
    byCountry: [country] hash
  }

  actions {
    register(kind: CitizenKind, displayName: Text, country: Text, legalName: Text?, birthDate: Date?): Citizen
    registerPerson(displayName: Text, country: Text, legalName: Text, birthDate: Date?): Citizen
    registerOrganization(displayName: Text, country: Text, legalName: Text): Citizen
    merge(target: CitizenId): Citizen
    block(reason: Text): Citizen
  }

  rules {
    displayName != null
    country.length == 2
  }
}
