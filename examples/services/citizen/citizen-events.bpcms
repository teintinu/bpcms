// service: example.com/services/citizen
event CitizenRegistered {
  title: { pt-BR: "Cidadão registrado", en: "Citizen registered" }
  version: 1
  payload {
    citizenId: CitizenId { title: { pt-BR: "Cidadão", en: "Citizen" } }
    kind: CitizenKind { title: { pt-BR: "Tipo", en: "Kind" } }
    at: DateTime { title: { pt-BR: "Data/hora", en: "At" } }
  }
  producer: Citizen
  consumers: [Identity]
  key: citizenId
}

event Merged {
  title: { pt-BR: "Cidadão mesclado", en: "Citizen merged" }
  version: 1
  payload {
    sourceId: CitizenId { title: { pt-BR: "Cidadão de origem", en: "Source citizen" } }
    targetId: CitizenId { title: { pt-BR: "Cidadão de destino", en: "Target citizen" } }
    at: DateTime { title: { pt-BR: "Data/hora", en: "At" } }
  }
  producer: Citizen
  consumers: [Identity]
  key: targetId
}
