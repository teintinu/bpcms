// service: example.com/services/catalog
view ProductForm {
  type: form
  document: Product

  fields {
    sku: SKU { required: true }
    name: Text { required: true }
    price: MoneyBRL { required: true }
    weight: Mass
    length: Length
    status: ProductStatus { readonly: true }
  }

  actions {
    save -> Product.create
    cancel -> none
  }
}

view ProductTable {
  type: table
  source: Product

  columns { sku; name; price; weight; status; createdAt }
  filters { status; categoryId; period }
  pagination: 50

  actions {
    open -> ProductForm
    publish -> Product.publish
    export -> Csv
  }
}
