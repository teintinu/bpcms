// service: example.com/services/catalog
event ProductUpdated {
  title: { pt-BR: "Produto atualizado", en: "Product updated" }
  version: 1
  payload {
    productId: ProductId { title: { pt-BR: "Produto", en: "Product" } }
    changedAt: DateTime { title: { pt-BR: "Alterado em", en: "Changed at" } }
  }
  producer: Product
  consumers: [Orders, Notifications]
  key: productId
}
