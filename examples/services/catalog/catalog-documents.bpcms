// service: example.com/services/catalog
document Category {
  title: { pt-BR: "Categoria", en: "Category" }
  version: 1
  owner: "Catalog"
  sync: read

  fields {
    name: string { title: { pt-BR: "Nome", en: "Name" }, maxLength: 120, required, lookup }
    parentId: CategoryId? { title: { pt-BR: "Categoria pai", en: "Parent category" } }
  }

  indexes {
    name: [name] unique
    parent: [parentId] hash
  }

  actions {
    create(name: string, parentId: CategoryId?): Category
    rename(name: string): Category
  }
}

document Product {
  title: { pt-BR: "Produto", en: "Product" }
  version: 1
  owner: "Catalog"
  sync: live
  audit: true

  fields {
    sku: SKU { title: { pt-BR: "SKU", en: "SKU" }, unique, lookup }
    name: string { title: { pt-BR: "Nome", en: "Name" }, maxLength: 160, required, lookup }
    categoryId: CategoryId { title: { pt-BR: "Categoria", en: "Category" } }
    price: MoneyBRL { title: { pt-BR: "Preço", en: "Price" } }
    weight: std.Mass { title: { pt-BR: "Peso", en: "Weight" } }
    length: std.Length { title: { pt-BR: "Comprimento", en: "Length" } }
    status: ProductStatus { title: { pt-BR: "Status", en: "Status" } }
    createdAt: DateTime { title: { pt-BR: "Criado em", en: "Created at" } }
  }

  indexes {
    sku: [sku] unique
    name: [name] search
    byStatus: [status, createdAt] range
    byWeight: [weight.normalized] range
  }

  actions {
    create(sku: SKU, name: string, price: MoneyBRL): Product
    update(name: string, price: MoneyBRL): Product
    publish(): Product
    archive(): Product
  }

  rules {
    price > 0
    status == published implies price > 0
  }
}
