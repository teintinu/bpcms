// service: example.com/services/catalog
document Category {
  title: { pt-BR: "Categoria", en: "Category" }
  version: 1
  owner: "Catalog"
  sync: read

  fields {
    name: string { title: { pt-BR: "Nome", en: "Name" }, maxLength: 120, required, lookup }
    parent: Category {
      title: { pt-BR: "Categoria pai", en: "Parent category" }
    }
  }

  indexes {
    name: [name] unique
    parent: [parent.id] hash
  }

  actions {
    create(name: string, parent: Category?){
      title: { pt-BR: "Criar categoria", en: "Create category" }
      roles: [Manager]
    }
    rename(name: string){
      title: { pt-BR: "Renomear", en: "Rename" }
      roles: [Manager]
    }
  }
}

document Product {
  title: { pt-BR: "Produto", en: "Product" }
  version: 1
  owner: "Catalog"
  sync: live
  audit: true

  fields {
    sku: SKU { title: { pt-BR: "Código", en: "SKU" }, unique, lookup }
    name: string { title: { pt-BR: "Nome", en: "Name" }, maxLength: 160, required, lookup }
    category: Category {
      title: { pt-BR: "Categoria", en: "Category" }
    }
    price: std.Money { title: { pt-BR: "Preço", en: "Price" }, scale: 2, currency: BRL }
    weight: std.Mass { title: { pt-BR: "Peso", en: "Weight" } }
    length: std.Length { title: { pt-BR: "Comprimento", en: "Length" } }
    status: ProductStatus { title: { pt-BR: "Situação", en: "Status" } }
    image: ProductImage { title: { pt-BR: "Imagem", en: "Image" } }
    video: ProductVideo { title: { pt-BR: "Vídeo", en: "Video" } }
    audio: ProductAudio { title: { pt-BR: "Áudio", en: "Audio" } }
    manual: ProductManual { title: { pt-BR: "Manual", en: "Manual" } }
    richDescription: ProductRichDescription { title: { pt-BR: "Descrição rica", en: "Rich description" } }
    createdAt: DateTime { title: { pt-BR: "Criado em", en: "Created at" } }
  }

  indexes {
    sku: [sku] unique
    name: [name] search
    byStatus: [status, createdAt] range
    byWeight: [weight.normalized] range
  }

  actions {
    create(sku: SKU, name: string, price: std.Money){
      title: { pt-BR: "Criar produto", en: "Create product" }
      roles: [Manager]
      {
      }
    }
    update(name: string, price: std.Money){
      title: { pt-BR: "Atualizar", en: "Update" }
      roles: [Manager]
      {
      }
    }
    publish(){
      title: { pt-BR: "Publicar", en: "Publish" }
      roles: [Manager]
      {
      }
    }
    archive(){
      title: { pt-BR: "Arquivar", en: "Archive" }
      roles: [Manager]
      {
      }
    }
  }

  rules {
    price > 0: {
      fields: []
      pt-BR: "Regra do documento não atendida"
      en: "Document rule not met"
    }
    status == published implies price > 0: {
      fields: []
      pt-BR: "Regra do documento não atendida"
      en: "Document rule not met"
    }
  }
}
