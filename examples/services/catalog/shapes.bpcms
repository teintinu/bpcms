// service: example.com/services/catalog
shape ProductId {
  base: text
  validate: uuid
  format: plain
  index: exact
}

shape CategoryId {
  base: text
  validate: uuid
  format: plain
  index: exact
}

shape SKU {
  base: text
  normalize: upper-trim
  maxLength: 40
  format: plain
}

shape ProductStatus {
  base: text
  values: [draft, published, archived]
  format: plain
}
