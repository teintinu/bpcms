// service: example.com/services/catalog
view ProductTable {
  title: { pt-BR: "Produtos", en: "Products" }
  type: table
  source: Product
  roles: [Curator, Publisher]

  columns { image; sku; name; price; weight; status; createdAt }
  filters { status; category; period }
  pagination: 50

  actions {
    open -> ProductDetail
    submit -> Product.submitForReview
    publish -> Product.publish
    archive -> Product.archive
  }
}

view ProductDetail {
  title: { pt-BR: "Detalhe do produto", en: "Product detail" }
  type: detail
  document: Product
  roles: [Curator, Publisher]

  sections { summary; pricing; media }

  actions {
    submit -> Product.submitForReview
    publish -> Product.publish
    archive -> Product.archive
  }
}

view ProductKanban {
  title: { pt-BR: "Produtos por situação", en: "Products by status" }
  type: kanban
  source: Product
  roles: [Curator, Publisher]

  groupBy: status
  columns { sku; name; price }
  card { sku; name; price; status }

  actions {
    open -> ProductDetail
  }
}

view ProductProgress {
  title: { pt-BR: "Andamento da publicação", en: "Publish progress" }
  type: process
  process: ProductPublish
  roles: [Curator, Publisher]

  sections { current; participants; history; deadlines; documents; milestones; next }
}

view PublishInbox {
  title: { pt-BR: "Fila de publicação", en: "Publish queue" }
  type: inbox
  roles: [Publisher]

  scope: lanes
  filter { lane in currentUser.lanes }
  groupBy: process
  columns { title; subject; lane; dueAt; priority }
}
