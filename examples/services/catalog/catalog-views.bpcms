// service: example.com/services/catalog
view ProductForm {
  title: { pt-BR: "Formulário de produto", en: "Product form" }
  type: form
  document: Product

  fields {
    sku: SKU { title: { pt-BR: "SKU", en: "SKU" }, required }
    name: string { title: { pt-BR: "Nome", en: "Name" }, required }
    price: std.Money { title: { pt-BR: "Preço", en: "Price" }, required, currency: BRL }
    weight: std.Mass { title: { pt-BR: "Peso", en: "Weight" } }
    length: std.Length { title: { pt-BR: "Comprimento", en: "Length" } }
    status: ProductStatus { title: { pt-BR: "Status", en: "Status" }, readonly }
    image: ProductImage { title: { pt-BR: "Imagem", en: "Image" } }
    video: ProductVideo { title: { pt-BR: "Vídeo", en: "Video" } }
    audio: ProductAudio { title: { pt-BR: "Áudio", en: "Audio" } }
    manual: ProductManual { title: { pt-BR: "Manual", en: "Manual" } }
    richDescription: ProductRichDescription { title: { pt-BR: "Descrição rica", en: "Rich description" } }
  }

  actions {
    save -> Product.create
    cancel -> none
  }
}

view ProductTable {
  title: { pt-BR: "Tabela de produtos", en: "Product table" }
  type: table
  source: Product

  columns {
    image
    sku
    name
    price
    weight
    status
    createdAt
  }
  filters { status; categoryId; period }
  pagination: 50

  actions {
    open -> ProductForm
    publish -> Product.publish
    export -> Csv
  }
}
