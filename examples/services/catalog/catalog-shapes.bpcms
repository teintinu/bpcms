// service: example.com/services/catalog


shape SKU {
  title: { pt-BR: "SKU", en: "SKU" }
  base: text
  normalize: upper-trim
  maxLength: 40
  format: plain
}

shape ProductStatus {
  title: { pt-BR: "Status do produto", en: "Product status" }
  base: text
  values {
    draft {
      title: { pt-BR: "Rascunho", en: "Draft" }
      icon: Draft
      ordinal: 10
    }
    published {
      title: { pt-BR: "Publicado", en: "Published" }
      icon: Published
      ordinal: 20
    }
    archived {
      title: { pt-BR: "Arquivado", en: "Archived" }
      icon: Archived
      ordinal: 30
    }
  }
  format: plain
}

shape MoneyBRL {
  title: { pt-BR: "Dinheiro (BRL)", en: "Money (BRL)" }
  base: decimal
  currency: BRL
  scale: 2
  parse: locale-number
  format: currency
  compare: exact
  aggregate: sum

  method toNumber(value): number {
    return value.raw;
  }
}
