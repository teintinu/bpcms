// service: example.com/services/catalog


shape SKU {
  title: { pt-BR: "SKU", en: "SKU" }
  base: string
  normalize: upper-trim
  maxLength: 40
  format: plain
}

shape ProductStatus {
  title: { pt-BR: "Status do produto", en: "Product status" }
  base: workflow
  initial: draft
  values {
    draft {
      title: { pt-BR: "Rascunho", en: "Draft" }
      icon: Draft
      ordinal: 10
      next: [published, archived]
    }
    published {
      title: { pt-BR: "Publicado", en: "Published" }
      icon: Published
      ordinal: 20
      next: [archived]
    }
    archived {
      title: { pt-BR: "Arquivado", en: "Archived" }
      icon: Archived
      ordinal: 30
      next: []
    }
  }
  format: plain

}

shape MoneyBRL {
  title: { pt-BR: "Dinheiro (BRL)", en: "Money (BRL)" }
  base: decimal
  currency: BRL
  parse: locale-number
  format: currency
  compare: exact
  aggregate: sum

  toNumber(value) {
    return value.raw;
  }
}
