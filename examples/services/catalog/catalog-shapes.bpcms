// service: example.com/services/catalog


shape SKU {
  title: { pt-BR: "SKU", en: "SKU" }
  base: string
  normalize: upper-trim
  maxLength: 40
  format: plain
}

shape ProductImage {
  title: { pt-BR: "Imagem do produto", en: "Product image" }
  base: image
  capabilities { gui }
}

shape ProductVideo {
  title: { pt-BR: "Vídeo do produto", en: "Product video" }
  base: video
  capabilities { gui }
}

shape ProductAudio {
  title: { pt-BR: "Áudio do produto", en: "Product audio" }
  base: audio
  capabilities { gui }
}

shape ProductManual {
  title: { pt-BR: "Manual do produto", en: "Product manual" }
  base: attachment
  mime: [application/pdf]
  capabilities { attachments }
}

shape ProductRichDescription {
  title: { pt-BR: "Descrição rica", en: "Rich description" }
  base: richtext
}

shape ProductStatus {
  title: { pt-BR: "Status do produto", en: "Product status" }
  base: workflow
  initial: draft
  values {
    draft {
      title: { pt-BR: "Rascunho", en: "Draft" }
      icon: Draft
      ordinal: 10
      next: [published, archived]
    }
    published {
      title: { pt-BR: "Publicado", en: "Published" }
      icon: Published
      ordinal: 20
      next: [archived]
    }
    archived {
      title: { pt-BR: "Arquivado", en: "Archived" }
      icon: Archived
      ordinal: 30
      next: []
    }
  }
  format: plain

}
