// service: example.com/services/catalog
view ProductHealth {
  title: { pt-BR: "Saúde do catálogo", en: "Catalog health" }
  type: report
  sources: [Product, Category]
  roles: [Publisher]

  filters { category; status }

  metrics {
    published: count(Product) where status == Published
    drafts: count(Product) where status == Draft
    avgPrice: avg(Product.price)
    totalWeight: sum(Product.weight)
  }

  units { avgPrice: BRL; totalWeight: kg }
  freshness: 15m
  export: [csv]
}

view PublishingControl {
  title: { pt-BR: "Controle do catálogo", en: "Catalog control" }
  type: dashboard
  sources: [Product]
  roles: [Publisher]
  mode: live

  filters { category }

  metrics {
    inReview: count(Product) where status == InReview
    rejected: count(Product) where status == Rejected
  }

  freshness: 15m
}
