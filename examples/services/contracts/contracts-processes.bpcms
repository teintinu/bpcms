// service: example.com/services/contracts

process ContractSignature for Contract {
  title: { pt-BR: "Assinatura de contrato", en: "Contract signature" }
  version: 1
  goal: "Coletar a assinatura do fornecedor no prazo e ativar o contrato"
  owner: "Contracts"
  timezone: America/Fortaleza
  sla: 10d

  on breach -> Expire

  pool Company {
    internal
    lane Legal { role: LegalCounsel }
  }

  pool Supplier {
    external
  }

  start Submitted { event: Contract.Submitted }

  task LegalReview {
    lane: Legal
    form: LegalReview
    sla: 2d
    assign: pull
    on timer 3d -> Expire
  }

  task SendForSignature {
    lane: System
    sends: SignatureRequest
    partner: Supplier
    with {
      contractNumber: contract.number
      expiresAt: contract.endsAt
    }
  }

  task AwaitSignature {
    lane: System
    receives: SignatureConfirmed
    partner: Supplier
    apply: Contract.sign
    with { contract }
    sla: 5d
    on timer 5d -> Expire
  }

  task Expire {
    lane: Legal
    form: CancelContract
    sla: 2d
    assign: pull
  }

  end Signed {
    title: { pt-BR: "Contrato assinado", en: "Contract signed" }
    outcome: success
  }

  end Declined {
    title: { pt-BR: "Assinatura não concluída", en: "Signature not completed" }
    outcome: cancelled
  }

  Submitted -> LegalReview
  LegalReview.approve -> SendForSignature
  LegalReview.reject -> Declined
  SendForSignature -> AwaitSignature
  AwaitSignature -> Signed
  Expire.cancel -> Declined
}

process ContractRenewal for Contract {
  title: { pt-BR: "Renovação de contrato", en: "Contract renewal" }
  version: 1
  goal: "Renovar antes do vencimento, com proposta ao fornecedor e encerramento quando não houver acordo"
  owner: "Contracts"
  timezone: America/Fortaleza
  sla: 60d

  pool Company {
    internal
    lane Renewals { role: ContractAnalyst }
    lane Management { role: ContractManager }
  }

  pool Supplier {
    external
  }

  start RenewalWindow {
    schedule: "0 8 * * *"
    select: contract.status == Active and contract.endsAt <= today() + 60d
  }

  task ReviewRenewal {
    lane: Management
    form: RenewalReview
    sla: 3d
    assign: pull
    on timer 5d -> Escalate
  }

  task PrepareTerms {
    lane: Renewals
    form: RenewalTerms
    sla: 3d
    assign: pull
  }

  task SendProposal {
    lane: System
    sends: RenewalRequest
    partner: Supplier
    with {
      contractNumber: contract.number
      proposedEndsAt: contract.proposedEndsAt
      expiresAt: contract.endsAt
    }
  }

  task AwaitAcceptance {
    lane: System
    receives: RenewalConfirmed
    partner: Supplier
    apply: Contract.confirmRenewal
    with { contract }
    sla: 10d
    on timer 10d -> Expire
  }

  task Expire {
    lane: Management
    form: TerminateContract
    sla: 2d
    assign: pull
  }

  task Escalate {
    lane: Management
    form: RenewalReview
    sla: 2d
  }

  end Renewed {
    title: { pt-BR: "Contrato renovado", en: "Contract renewed" }
    outcome: success
  }

  end Cancelled {
    title: { pt-BR: "Renovação cancelada", en: "Renewal cancelled" }
    outcome: cancelled
  }

  RenewalWindow -> ReviewRenewal
  ReviewRenewal.renew -> PrepareTerms
  ReviewRenewal.decline -> Cancelled
  PrepareTerms.propose -> SendProposal
  SendProposal -> AwaitAcceptance
  AwaitAcceptance -> Renewed
  Expire.terminate -> Cancelled
  Escalate.renew -> PrepareTerms
  Escalate.decline -> Cancelled
}
