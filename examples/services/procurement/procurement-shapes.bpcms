// service: example.com/services/procurement

shape PurchaseRequestStatus {
  title: { pt-BR: "Situação da solicitação de compra", en: "Purchase request status" }
  base: state
  initial: Draft
  value Draft {
    title: { pt-BR: "Rascunho", en: "Draft" }
    icon: Draft
    ordinal: 10

    transition Submitted {
      title: { pt-BR: "Solicitação enviada", en: "Purchase request submitted" }
      payload {
        submittedAt: DateTime { title: { pt-BR: "Enviada em", en: "Submitted at" } }
        amount: std.Money { title: { pt-BR: "Valor", en: "Amount" } }
      }
    }
  }
  value Submitted {
    title: { pt-BR: "Enviada", en: "Submitted" }
    icon: Submitted
    ordinal: 20

    transition Approved {
      title: { pt-BR: "Solicitação aprovada", en: "Purchase request approved" }
      payload {
        approvedAt: DateTime { title: { pt-BR: "Aprovada em", en: "Approved at" } }
        amount: std.Money { title: { pt-BR: "Valor", en: "Amount" } }
      }
    }

    transition Rejected {
      title: { pt-BR: "Solicitação rejeitada", en: "Purchase request rejected" }
      payload {
        rejectedAt: DateTime { title: { pt-BR: "Rejeitada em", en: "Rejected at" } }
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Approved {
    title: { pt-BR: "Aprovada", en: "Approved" }
    icon: Approved
    ordinal: 30

    transition Ordered {
      title: { pt-BR: "Pedido de compra emitido", en: "Purchase order issued" }
      payload {
        orderedAt: DateTime { title: { pt-BR: "Emitido em", en: "Issued at" } }
      }
    }
  }
  value Rejected {
    title: { pt-BR: "Rejeitada", en: "Rejected" }
    icon: Rejected
    ordinal: 40
  }
  value Ordered {
    title: { pt-BR: "Pedido emitido", en: "Ordered" }
    icon: Ordered
    ordinal: 50
  }
}

shape PurchaseOrderStatus {
  title: { pt-BR: "Situação do pedido de compra", en: "Purchase order status" }
  base: state
  initial: Draft
  value Draft {
    title: { pt-BR: "Rascunho", en: "Draft" }
    icon: Draft
    ordinal: 10

    transition Sent {
      title: { pt-BR: "Pedido enviado", en: "Purchase order sent" }
      payload {
        sentAt: DateTime { title: { pt-BR: "Enviado em", en: "Sent at" } }
      }
    }

    transition Cancelled {
      title: { pt-BR: "Pedido cancelado", en: "Purchase order cancelled" }
      payload {
        cancelledAt: DateTime { title: { pt-BR: "Cancelado em", en: "Cancelled at" } }
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Sent {
    title: { pt-BR: "Enviado", en: "Sent" }
    icon: Sent
    ordinal: 20

    transition Confirmed {
      title: { pt-BR: "Pedido confirmado", en: "Purchase order confirmed" }
      payload {
        confirmedAt: DateTime { title: { pt-BR: "Confirmado em", en: "Confirmed at" } }
      }
    }

    transition Cancelled {
      title: { pt-BR: "Pedido cancelado", en: "Purchase order cancelled" }
      payload {
        cancelledAt: DateTime { title: { pt-BR: "Cancelado em", en: "Cancelled at" } }
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Confirmed {
    title: { pt-BR: "Confirmado", en: "Confirmed" }
    icon: Confirmed
    ordinal: 30

    transition Received {
      title: { pt-BR: "Pedido recebido", en: "Purchase order received" }
      payload {
        receivedAt: DateTime { title: { pt-BR: "Recebido em", en: "Received at" } }
      }
    }
  }
  value Received {
    title: { pt-BR: "Recebido", en: "Received" }
    icon: Received
    ordinal: 40
  }
  value Cancelled {
    title: { pt-BR: "Cancelado", en: "Cancelled" }
    icon: Cancelled
    ordinal: 50
  }
}

shape SupplierStatus {
  title: { pt-BR: "Situação do fornecedor", en: "Supplier status" }
  base: state
  initial: Prospect
  value Prospect {
    title: { pt-BR: "Prospecto", en: "Prospect" }
    icon: Prospect
    ordinal: 10

    transition Approved {
      title: { pt-BR: "Fornecedor aprovado", en: "Supplier approved" }
      payload {
        approvedAt: DateTime { title: { pt-BR: "Aprovado em", en: "Approved at" } }
      }
    }

    transition Blocked {
      title: { pt-BR: "Fornecedor bloqueado", en: "Supplier blocked" }
      payload {
        blockedAt: DateTime { title: { pt-BR: "Bloqueado em", en: "Blocked at" } }
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Approved {
    title: { pt-BR: "Aprovado", en: "Approved" }
    icon: Approved
    ordinal: 20

    transition Blocked {
      title: { pt-BR: "Fornecedor bloqueado", en: "Supplier blocked" }
      payload {
        blockedAt: DateTime { title: { pt-BR: "Bloqueado em", en: "Blocked at" } }
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Blocked {
    title: { pt-BR: "Bloqueado", en: "Blocked" }
    icon: Blocked
    ordinal: 30
  }
}

shape RFQStatus {
  title: { pt-BR: "Situação da cotação", en: "RFQ status" }
  base: state
  initial: Open
  value Open {
    title: { pt-BR: "Aberta", en: "Open" }
    icon: Open
    ordinal: 10

    transition Quoted {
      title: { pt-BR: "Cotação recebida", en: "Quote received" }
      payload {
        quotedAt: DateTime { title: { pt-BR: "Cotado em", en: "Quoted at" } }
        amount: std.Money { title: { pt-BR: "Valor", en: "Amount" } }
      }
    }
  }
  value Quoted {
    title: { pt-BR: "Cotada", en: "Quoted" }
    icon: Quoted
    ordinal: 20

    transition Awarded {
      title: { pt-BR: "Cotação adjudicada", en: "Quote awarded" }
      payload {
        awardedAt: DateTime { title: { pt-BR: "Adjudicado em", en: "Awarded at" } }
        supplier: Supplier { title: { pt-BR: "Fornecedor", en: "Supplier" } }
      }
    }
  }
  value Awarded {
    title: { pt-BR: "Adjudicada", en: "Awarded" }
    icon: Awarded
    ordinal: 30
  }
}

shape GoodsReceiptStatus {
  title: { pt-BR: "Situação do recebimento", en: "Goods receipt status" }
  base: state
  initial: Pending
  value Pending {
    title: { pt-BR: "Pendente", en: "Pending" }
    icon: Pending
    ordinal: 10

    transition Received {
      title: { pt-BR: "Mercadoria recebida", en: "Goods received" }
      payload {
        receivedAt: DateTime { title: { pt-BR: "Recebido em", en: "Received at" } }
        receivedWeight: std.Mass { title: { pt-BR: "Peso recebido", en: "Received weight" } }
      }
    }
  }
  value Received {
    title: { pt-BR: "Recebido", en: "Received" }
    icon: Received
    ordinal: 20

    transition Divergent {
      title: { pt-BR: "Recebimento divergente", en: "Goods receipt divergent" }
      payload {
        divergedAt: DateTime { title: { pt-BR: "Registrado em", en: "Recorded at" } }
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Divergent {
    title: { pt-BR: "Divergente", en: "Divergent" }
    icon: Divergent
    ordinal: 30
  }
}

shape SupplierCategory {
  title: { pt-BR: "Categoria do fornecedor", en: "Supplier category" }
  base: classification
  value Goods {
    title: { pt-BR: "Mercadorias", en: "Goods" }
    icon: Goods
    ordinal: 10
  }
  value Services {
    title: { pt-BR: "Serviços", en: "Services" }
    icon: Services
    ordinal: 20
  }
  value Logistics {
    title: { pt-BR: "Logística", en: "Logistics" }
    icon: Logistics
    ordinal: 30
  }
  value Technology {
    title: { pt-BR: "Tecnologia", en: "Technology" }
    icon: Technology
    ordinal: 40
  }
}

shape RiskLevel {
  title: { pt-BR: "Nível de risco do fornecedor", en: "Supplier risk level" }
  base: classification
  value Low {
    title: { pt-BR: "Baixo", en: "Low" }
    icon: Low
    ordinal: 10
  }
  value Medium {
    title: { pt-BR: "Médio", en: "Medium" }
    icon: Medium
    ordinal: 20
  }
  value High {
    title: { pt-BR: "Alto", en: "High" }
    icon: High
    ordinal: 30
  }
}

shape ApproverTier {
  title: { pt-BR: "Alçada de aprovação", en: "Approval tier" }
  base: classification
  value Auto {
    title: { pt-BR: "Automática", en: "Automatic" }
    icon: Auto
    ordinal: 10
  }
  value Manager {
    title: { pt-BR: "Gerência", en: "Manager" }
    icon: Manager
    ordinal: 20
  }
  value Director {
    title: { pt-BR: "Diretoria", en: "Director" }
    icon: Director
    ordinal: 30
  }
}

shape PurchaseItem {
  title: { pt-BR: "Item de compra", en: "Purchase item" }
  fields {
    description: string { title: { pt-BR: "Descrição", en: "Description" } }
    quantity: std.Count { title: { pt-BR: "Quantidade", en: "Quantity" } }
    unitPrice: std.Money {
      title: { pt-BR: "Preço unitário", en: "Unit price" }
      currency: BRL
    }
  }
}
