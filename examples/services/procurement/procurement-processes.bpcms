// service: example.com/services/procurement

process PurchaseApproval for PurchaseRequest {
  title: { pt-BR: "Aprovação de compra", en: "Purchase approval" }
  version: 1
  goal: "Aprovar a compra na alçada certa, com rastro e sem travar o pedido simples"
  owner: "Procurement"
  timezone: America/Fortaleza
  sla: 5d

  on breach -> Escalate

  pool Company {
    internal
    lane Approval { role: Approver }
    lane Management { role: ProcurementManager }
  }

  variables {
    tier: ApproverTier
  }

  start Submitted { event: PurchaseRequest.Submitted }

  task Decide {
    lane: System
    decision: ApprovalLimit
    with {
      amount: purchaseRequest.amount
      supplier: purchaseRequest.supplier
    }
    gives: tier
  }

  gateway Tier {
    if tier == Auto -> AutoApprove
    if tier == Manager -> ManagerReview
    else -> DirectorReview
  }

  task AutoApprove {
    lane: System
    action: PurchaseRequest.approve
    sla: 1m
  }

  task ManagerReview {
    lane: Approval
    form: ApprovalDecision
    sla: 2d
    assign: pull
    priority: 50
    on timer 2d -> Escalate
  }

  task DirectorReview {
    lane: Management
    form: ApprovalDecision
    sla: 2d
    assign: pull
    priority: 30
    on timer 3d -> Escalate
  }

  task Escalate {
    lane: Management
    form: ApprovalDecision
    sla: 2d
  }

  end Approved {
    title: { pt-BR: "Compra aprovada", en: "Purchase approved" }
    outcome: success
  }

  end Rejected {
    title: { pt-BR: "Compra rejeitada", en: "Purchase rejected" }
    outcome: failure
  }

  Submitted -> Decide
  Decide -> Tier
  AutoApprove -> Approved
  ManagerReview.approved -> Approved
  ManagerReview.rejected -> Rejected
  DirectorReview.approved -> Approved
  DirectorReview.rejected -> Rejected
  Escalate.approved -> Approved
  Escalate.rejected -> Rejected
}

process SupplierOnboarding for Supplier {
  title: { pt-BR: "Habilitação de fornecedor", en: "Supplier onboarding" }
  version: 1
  goal: "Habilitar fornecedor com cadastro no portal, documentos verificados e contas a pagar prontas"
  owner: "Procurement"
  timezone: America/Fortaleza
  sla: 10d

  pool Company {
    internal
    lane Compliance { role: ComplianceAnalyst }
    lane Approval { role: Approver }
    lane Management { role: ProcurementManager }
    lane Finance { role: PayablesClerk }
  }

  pool Supplier {
    external
    lane Portal { role: SupplierUser }
  }

  start Intake { by: [Buyer] }

  task Invite {
    lane: System
    sends: SupplierInvite
    partner: Supplier
    with {
      invitedAt: now()
      expiresAt: now() + 7d
    }
  }

  task Register {
    lane: Portal
    form: SupplierRegistration
    sla: 5d
    on timer 7d -> Abandon
  }

  task Verify {
    lane: Compliance
    form: DocumentVerification
    sla: 2d
    assign: pull
  }

  task Approve {
    lane: Approval
    form: ComplianceApproval
    sla: 2d
    assign: pull
    on timer 3d -> Escalate
  }

  task Escalate {
    lane: Management
    form: ComplianceApproval
    sla: 2d
  }

  task Payables {
    lane: Finance
    form: PayablesSetup
    sla: 1d
    assign: pull
  }

  task Abandon {
    lane: Compliance
    form: BlockSupplier
    sla: 1d
  }

  end Onboarded {
    title: { pt-BR: "Fornecedor habilitado", en: "Supplier onboarded" }
    outcome: success
  }

  end Blocked {
    title: { pt-BR: "Habilitação bloqueada", en: "Onboarding blocked" }
    outcome: failure
  }

  Intake -> Invite
  Invite -> Register
  Register.submit -> Verify
  Verify.verified -> Approve
  Verify.rejected -> Blocked
  Approve.approved -> Payables
  Approve.rejected -> Blocked
  Escalate.approved -> Payables
  Escalate.rejected -> Blocked
  Payables.enable -> Onboarded
  Abandon.block -> Blocked
}

process GoodsReceipt for GoodsReceipt {
  title: { pt-BR: "Recebimento de mercadoria", en: "Goods receipt" }
  version: 1
  goal: "Receber a mercadoria conferida e tratar divergência sem sujar o estoque"
  owner: "Procurement"
  timezone: America/Fortaleza
  sla: 2d

  pool Company {
    internal
    lane Receiving { role: ReceivingClerk }
    lane Quality { role: QualityInspector }
  }

  pool Supplier {
    external
  }

  start Intake { by: [ReceivingClerk] }

  task Receive {
    lane: Receiving
    form: ReceiveGoods
    sla: 2h
    assign: pull
  }

  task Reserve {
    lane: System
    action: GoodsReceipt.reserveStock
  }

  task Inspect {
    lane: Quality
    form: InspectGoods
    sla: 4h
    assign: pull
    priority: 60
  }

  task Notify {
    lane: System
    sends: DivergenceNotice
    partner: Supplier
    with {
      reason: goodsReceipt.divergenceReason
      expectedWeight: goodsReceipt.expectedWeight
      receivedWeight: goodsReceipt.receivedWeight
    }
  }

  task Release {
    lane: System
    action: GoodsReceipt.releaseStock
    compensates: Reserve
  }

  rollback Undo

  end Accepted {
    title: { pt-BR: "Recebido", en: "Accepted" }
    outcome: success
  }

  end Divergent {
    title: { pt-BR: "Divergente", en: "Divergent" }
    outcome: failure
  }

  Intake -> Receive
  Receive.receive -> Reserve
  Reserve -> Inspect
  Inspect.accept -> Accepted
  Inspect.diverge -> Notify
  Notify -> Undo
  Undo -> Divergent
}
