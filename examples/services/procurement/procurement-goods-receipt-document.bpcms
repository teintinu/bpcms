// service: example.com/services/procurement

document GoodsReceipt {
  title: { pt-BR: "Recebimento de mercadoria", en: "Goods receipt" }
  version: 1
  owner: "Procurement"
  sync: read

  fields {
    number: string {
      title: { pt-BR: "Número", en: "Number" }
      maxLength: 40
      unique
      lookup
    }
    order: PurchaseOrder {
      title: { pt-BR: "Pedido de compra", en: "Purchase order" }
      lookup
    }
    expectedWeight: std.Mass {
      title: { pt-BR: "Peso esperado", en: "Expected weight" }
      unit: kg
    }
    receivedWeight: std.Mass {
      title: { pt-BR: "Peso recebido", en: "Received weight" }
      unit: kg
      readonly
    }
    receivedAt: DateTime {
      title: { pt-BR: "Recebido em", en: "Received at" }
    }
    inspectedAt: DateTime {
      title: { pt-BR: "Inspecionado em", en: "Inspected at" }
    }
    reservedAt: DateTime {
      title: { pt-BR: "Reservado em", en: "Reserved at" }
    }
    releasedAt: DateTime {
      title: { pt-BR: "Liberado em", en: "Released at" }
    }
    status: GoodsReceiptStatus {
      title: { pt-BR: "Situação", en: "Status" }
      lookup
    }
    divergenceReason: string {
      title: { pt-BR: "Motivo da divergência", en: "Divergence reason" }
      maxLength: 280
    }
    divergedAt: DateTime {
      title: { pt-BR: "Divergência registrada em", en: "Divergence recorded at" }
    }
    warehouse: string {
      title: { pt-BR: "Depósito", en: "Warehouse" }
      maxLength: 60
    }
  }

  source: device "scale-01" for receivedWeight


  actions {
    receive() {
      title: { pt-BR: "Registrar recebimento", en: "Register receipt" }
      roles: [ReceivingClerk]
      to: status.Received
      {
        receivedAt = now()
      }
    }

    reserveStock() {
      title: { pt-BR: "Reservar estoque", en: "Reserve stock" }
      roles: [ReceivingClerk]
      {
        reservedAt = now()
      }
    }

    releaseStock() {
      title: { pt-BR: "Liberar reserva de estoque", en: "Release stock reservation" }
      roles: [ReceivingClerk]
      {
        releasedAt = now()
      }
    }

    accept() {
      title: { pt-BR: "Aceitar recebimento", en: "Accept receipt" }
      roles: [QualityInspector, ReceivingClerk]
      {
        inspectedAt = now()
      }
    }

    markDivergent(divergenceReason: string) {
      title: { pt-BR: "Registrar divergência", en: "Record divergence" }
      roles: [QualityInspector, ReceivingClerk]
      to: status.Divergent
      emits { reason: divergenceReason }
      {
        divergedAt = now()
      }
    }
  }

  indexes {
    byNumber: [number] unique
    byStatus: [status, receivedAt] range
    byOrder: [order.id] hash
  }
}

shape GoodsReceiptStatus {
  title: { pt-BR: "Situação do recebimento", en: "Goods receipt status" }
  base: state
  initial: Pending
  value Pending {
    title: { pt-BR: "Pendente", en: "Pending" }
    icon: Pending
    ordinal: 10

    transition Received {
      title: { pt-BR: "Mercadoria recebida", en: "Goods received" }
      payload {
        receivedAt: DateTime { title: { pt-BR: "Recebido em", en: "Received at" } }
        receivedWeight: std.Mass { title: { pt-BR: "Peso recebido", en: "Received weight" } }
      }
    }
  }
  value Received {
    title: { pt-BR: "Recebido", en: "Received" }
    icon: Received
    ordinal: 20

    transition Divergent {
      title: { pt-BR: "Recebimento divergente", en: "Goods receipt divergent" }
      payload {
        divergedAt: DateTime { title: { pt-BR: "Registrado em", en: "Recorded at" } }
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Divergent {
    title: { pt-BR: "Divergente", en: "Divergent" }
    icon: Divergent
    ordinal: 30
  }
}

view GoodsReceipts {
  title: { pt-BR: "Recebimentos", en: "Goods receipts" }
  type: table
  source: GoodsReceipt
  roles: [ReceivingClerk, QualityInspector, Buyer, ProcurementManager]

  columns { number; order; expectedWeight; receivedWeight; status; receivedAt }
  filters { status; order }
  pagination: 50

  actions {
    open -> GoodsReceiptDetail
  }
}

view GoodsReceiptDetail {
  title: { pt-BR: "Detalhe do recebimento", en: "Goods receipt detail" }
  type: detail
  document: GoodsReceipt
  roles: [ReceivingClerk, QualityInspector, Buyer, ProcurementManager]

  sections { summary; timeline }
}

view GoodsReceiptProgress {
  title: { pt-BR: "Andamento do recebimento", en: "Goods receipt progress" }
  type: process
  process: GoodsReceipt
  roles: [ReceivingClerk, QualityInspector, Buyer, ProcurementManager]

  sections { current; participants; history; deadlines; documents; milestones; next }
}

message DivergenceNotice {
  title: { pt-BR: "Aviso de divergência no recebimento", en: "Goods receipt divergence notice" }
  about: GoodsReceipt
  payload {
    reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
    expectedWeight: std.Mass { title: { pt-BR: "Peso esperado", en: "Expected weight" } }
    receivedWeight: std.Mass { title: { pt-BR: "Peso recebido", en: "Received weight" } }
  }
}
