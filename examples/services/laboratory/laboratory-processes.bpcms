// service: example.com/services/laboratory

process LabExam for ExamOrder {
  title: { pt-BR: "Exame laboratorial", en: "Laboratory exam" }
  version: 1
  goal: "Coletar, analisar, validar, assinar e liberar o resultado no prazo"
  owner: "Laboratory"
  timezone: America/Fortaleza
  sla: 8h

  pool Laboratory {
    internal

    lane Collection {
      role: Collector
    }

    lane Analysis {
      role: Analyst
    }

    lane Pathology {
      role: Pathologist
    }

    lane Management {
      role: LabManager
    }
  }

  pool Requester {
    external
  }

  variables {
    reading: ExamReading
    result: ExamResult
  }

  start Requested {
    event: ExamOrder.Requested
  }

  task Collect {
    lane: Collection
    form: SampleCollection
    sla: 2h
    priority: 50
    assign: pull
    on timer 4h -> Escalate
  }

  task StartAnalysis {
    lane: System
    action: ExamOrder.process
  }

  task ReadAnalyzer {
    lane: System
    call: Analyzer.readResult
    with { order: examOrder }
    gives: reading
    sla: 30m
  }

  gateway Critical {
    if reading.critical -> AlertCritical
    else -> RecordResult
  }

  task AlertCritical {
    lane: System
    sends: CriticalResultAlert
    partner: Requester
    with {
      exam: examOrder.exam
      value: reading.value
    }
  }

  task RecordResult {
    lane: System
    action: ExamResult.record
    with {
      order: examOrder
      sampleRef: examOrder.sample
      measured: reading.value
      measUnit: reading.unit
      isCritical: reading.critical
    }
    gives: result
  }

  task Validate {
    lane: Analysis
    form: ResultValidation
    with { result }
    sla: 4h
    assign: pull
  }

  task Sign {
    lane: Pathology
    form: ResultSignature
    with { result }
    sla: 8h
    assign: pull
  }

  task Release {
    lane: System
    action: ExamResult.release
    with { result }
  }

  task MarkResulted {
    lane: System
    action: ExamOrder.result
  }

  task TellRequester {
    lane: System
    sends: ResultReleased
    partner: Requester
    with {
      exam: examOrder.exam
      sample: examOrder.sample
    }
  }

  task Escalate {
    lane: Management
    manual: "Repactuar o prazo da coleta com o responsável"
    sla: 2h
  }

  rollback Stop

  end Released {
    title: { pt-BR: "Resultado liberado", en: "Result released" }
    outcome: success
  }

  end Cancelled {
    title: { pt-BR: "Exame cancelado", en: "Exam cancelled" }
    outcome: cancelled
  }

  Requested -> Collect
  Collect.collect -> StartAnalysis
  StartAnalysis -> ReadAnalyzer
  ReadAnalyzer -> Critical
  Critical -> AlertCritical
  Critical -> RecordResult
  AlertCritical -> RecordResult
  RecordResult -> Validate
  Validate.validate -> Sign
  Sign.sign -> Release
  Release -> MarkResulted
  MarkResulted -> TellRequester
  TellRequester -> Released
  Escalate -> Collect
  Stop -> Cancelled

  cancel on ExamOrder.Cancelled -> Stop
}

process SampleRecollection for Sample {
  title: { pt-BR: "Recoleta de amostra", en: "Sample recollection" }
  version: 1
  goal: "Recoletar a amostra rejeitada e liberá-la para análise"
  owner: "Laboratory"
  timezone: America/Fortaleza
  sla: 3d

  pool Laboratory {
    internal

    lane Collection {
      role: Collector
    }

    lane Analysis {
      role: Analyst
    }
  }

  pool Patient {
    external
  }

  start Rejected {
    event: Sample.Rejected
  }

  task AskRecollection {
    lane: System
    sends: RecollectionRequest
    partner: Patient
    with {
      code: sample.code
      requestedAt: now()
    }
  }

  task Recollect {
    lane: Collection
    form: Recollection
    sla: 1d
    assign: pull
    on timer 2d -> Escalate
  }

  task Escalate {
    lane: Collection
    manual: "Contatar o paciente e reagendar a coleta"
    sla: 1d
  }

  task Receive {
    lane: System
    action: Sample.receive
  }

  task StartAnalysis {
    lane: System
    action: Sample.process
  }

  task OfferHomeCollection {
    lane: Collection
    manual: "Agendar coleta domiciliar com o laboratório parceiro"
    discretionary
    when: sample.kind == Patient
  }

  end Recollected {
    title: { pt-BR: "Amostra recoletada", en: "Sample recollected" }
    outcome: success
  }

  Rejected -> AskRecollection
  AskRecollection -> Recollect
  Recollect.recollect -> Receive
  Receive -> StartAnalysis
  StartAnalysis -> Recollected
  Escalate -> Recollect
}
