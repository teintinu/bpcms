// service: example.com/services/laboratory

scopable document Laboratory {
  title: { pt-BR: "Laboratório", en: "Laboratory" }
  fields {
    code: string { title: { pt-BR: "Código", en: "Code" }, unique, lookup }
    name: string { title: { pt-BR: "Nome", en: "Name" }, lookup }
  }
}

document SupportLab {
  title: { pt-BR: "Laboratório de apoio", en: "Support laboratory" }
  version: 1
  owner: "Laboratory"
  sync: live
  audit: true

  fields {
    name: string { title: { pt-BR: "Nome", en: "Name" }, required, lookup }
    accreditation: string { title: { pt-BR: "Acreditação", en: "Accreditation" } }
    active: boolean { title: { pt-BR: "Ativo", en: "Active" } }
  }

  actions {
    activate(){
      title: { pt-BR: "Ativar", en: "Activate" }
      permission: Manager
    }
    deactivate(){
      title: { pt-BR: "Desativar", en: "Deactivate" }
      permission: Manager
    }
  }
}

document Sample {
  title: { pt-BR: "Amostra", en: "Sample" }
  version: 1
  owner: "Laboratory"
  sync: live
  audit: true

  fields {
    code: SampleCode { title: { pt-BR: "Código", en: "Code" }, unique, lookup }
    laboratory: link Laboratory {
      title: { pt-BR: "Laboratório", en: "Laboratory" }
    }
    kind: SampleKind { title: { pt-BR: "Origem", en: "Origin" }, lookup }
    patient: link Citizen {
      title: { pt-BR: "Paciente", en: "Patient" }
      lookup
    }
    supportLab: link SupportLab {
      title: { pt-BR: "Laboratório de apoio", en: "Support laboratory" }
    }
    controlLot: string { title: { pt-BR: "Lote de controle", en: "Control lot" } }
    status: SampleStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    collectedAt: DateTime { title: { pt-BR: "Coletada em", en: "Collected at" } }
    collectedBy: link User {
      title: { pt-BR: "Coletada por", en: "Collected by" }
    }
  }

  rules {
    kind == patient implies patient != null
    kind == support implies supportLab != null
    kind == control implies controlLot != null
  }

  actions {
    collect(by: UserId){
      title: { pt-BR: "Coletar", en: "Collect" }
      permission: Analyst
    }
    receive(){
      title: { pt-BR: "Receber", en: "Receive" }
      permission: Manager
    }
    refer(lab: SupportLabId){
      title: { pt-BR: "Encaminhar", en: "Refer" }
      permission: Manager
    }
  }
}

document ExamOrder {
  title: { pt-BR: "Pedido de exame", en: "Exam order" }
  version: 1
  owner: "Laboratory"
  sync: live
  audit: true

  fields {
    laboratory: link Laboratory {
      title: { pt-BR: "Laboratório", en: "Laboratory" }
    }
    sample: link Sample {
      title: { pt-BR: "Amostra", en: "Sample" }
      lookup
    }
    exam: ExamCode { title: { pt-BR: "Exame", en: "Exam" }, lookup }
    status: ExamOrderStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    assignedTo: link User {
      title: { pt-BR: "Responsável", en: "Assignee" }
    }
    referredTo: link SupportLab {
      title: { pt-BR: "Encaminhado para", en: "Referred to" }
    }
    requestedAt: DateTime { title: { pt-BR: "Solicitado em", en: "Requested at" } }
    resultedAt: DateTime { title: { pt-BR: "Resultado em", en: "Resulted at" } }
  }

  rules {
    status == resulted implies resultedAt != null
    status == referred implies referredTo != null
  }

  actions {
    assign(user: UserId){
      title: { pt-BR: "Atribuir", en: "Assign" }
      permission: Pathologist
    }
    start(){
      title: { pt-BR: "Iniciar", en: "Start" }
      permission: Manager
    }
    refer(lab: SupportLabId){
      title: { pt-BR: "Encaminhar", en: "Refer" }
      permission: Manager
    }
    result(){
      title: { pt-BR: "Resultar", en: "Result" }
      permission: Manager
    }
  }
}

document ExamResult {
  title: { pt-BR: "Resultado de exame", en: "Exam result" }
  version: 1
  owner: "Laboratory"
  sync: live
  audit: true

  fields {
    laboratory: link Laboratory {
      title: { pt-BR: "Laboratório", en: "Laboratory" }
    }
    examOrder: link ExamOrder {
      title: { pt-BR: "Pedido", en: "Exam order" }
      lookup
    }
    sample: link Sample {
      title: { pt-BR: "Amostra", en: "Sample" }
      lookup
    }
    value: string { title: { pt-BR: "Valor", en: "Value" } }
    unit: string { title: { pt-BR: "Unidade", en: "Unit" } }
    releasedAt: DateTime { title: { pt-BR: "Liberado em", en: "Released at" } }
    releasedBy: link User {
      title: { pt-BR: "Liberado por", en: "Released by" }
    }
  }

  actions {
    release(by: UserId){
      title: { pt-BR: "Liberar", en: "Release" }
      permission: Pathologist
    }
  }
}
