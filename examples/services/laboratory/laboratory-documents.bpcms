// service: example.com/services/laboratory

scopable document Laboratory {
  title: { pt-BR: "Laboratório", en: "Laboratory" }
  fields {
    code: string { title: { pt-BR: "Código", en: "Code" }, unique, lookup }
    name: string { title: { pt-BR: "Nome", en: "Name" }, lookup }
  }
}

document SupportLab {
  title: { pt-BR: "Laboratório de apoio", en: "Support laboratory" }
  version: 1
  owner: "Laboratory"
  sync: live
  fields {
    name: string {
      title: { pt-BR: "Nome", en: "Name" }
      lookup
      required
    }
    accreditation: string { title: { pt-BR: "Acreditação", en: "Accreditation" } }
    active: boolean { title: { pt-BR: "Ativo", en: "Active" }, default: true }
  }

  actions {
    activate(){
      title: { pt-BR: "Ativar", en: "Activate" }
      roles: [LabManager]
      {
        active = true
      }
    }

    deactivate(){
      title: { pt-BR: "Desativar", en: "Deactivate" }
      roles: [LabManager]
      {
        active = false
      }
    }
  }
}

document Sample {
  title: { pt-BR: "Amostra", en: "Sample" }
  version: 1
  owner: "Laboratory"
  sync: live
  fields {
    code: SampleCode { title: { pt-BR: "Código", en: "Code" }, unique, lookup }
    laboratory: Laboratory {
      title: { pt-BR: "Laboratório", en: "Laboratory" }
    }
    kind: SampleKind { title: { pt-BR: "Origem", en: "Origin" }, lookup }
    patient: Citizen {
      title: { pt-BR: "Paciente", en: "Patient" }
      lookup
    }
    supportLab: SupportLab {
      title: { pt-BR: "Laboratório de apoio", en: "Support laboratory" }
    }
    controlLot: string { title: { pt-BR: "Lote de controle", en: "Control lot" } }
    status: SampleStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    collectedAt: DateTime { title: { pt-BR: "Coletada em", en: "Collected at" } }
  }

  indexes {
    byStatus: [status, collectedAt] range
    byPatient: [patient.id] hash
  }

  events {
    Collected {
      title: { pt-BR: "Amostra coletada", en: "Sample collected" }
    }
  }

  actions {
    collect(){
      title: { pt-BR: "Coletar", en: "Collect" }
      roles: [Collector]
      {
        collectedAt = now()
        emit Collected
      }
    }

    recollect(){
      title: { pt-BR: "Recoletar", en: "Recollect" }
      roles: [Collector]
      to: status.Collected
      {
        collectedAt = now()
      }
    }

    receive(){
      title: { pt-BR: "Receber", en: "Receive" }
      roles: [Collector]
      to: status.Received
    }

    reject(justification: string){
      title: { pt-BR: "Rejeitar", en: "Reject" }
      roles: [Analyst]
      to: status.Rejected
      emits { reason: justification }
      rule justification.length >= 10 {
        pt-BR: "Informe o motivo da rejeição"
        en: "Enter the rejection reason"
      }
    }

    process(){
      title: { pt-BR: "Processar", en: "Process" }
      roles: [Analyst]
      to: status.Processing
    }

    refer(lab: SupportLab){
      title: { pt-BR: "Encaminhar", en: "Refer" }
      roles: [SupportLiaison]
      to: status.Referred
      emits { supportLab: lab }
    }

    result(){
      title: { pt-BR: "Resultar", en: "Result" }
      roles: [Analyst]
      to: status.Resulted
    }
  }

  rule kind == Patient implies patient != null {
    pt-BR: "Selecione o paciente"
    en: "Select the patient"

  }
  rule kind == Support implies supportLab != null {
    pt-BR: "Selecione o laboratório de apoio"
    en: "Select the support lab"

  }
  rule kind == Control implies controlLot != null {
    pt-BR: "Informe o lote de controle"
    en: "Enter the control lot"

  }
}

document ExamOrder {
  title: { pt-BR: "Pedido de exame", en: "Exam order" }
  version: 1
  owner: "Laboratory"
  sync: live
  fields {
    laboratory: Laboratory {
      title: { pt-BR: "Laboratório", en: "Laboratory" }
    }
    sample: Sample {
      title: { pt-BR: "Amostra", en: "Sample" }
      lookup
    }
    exam: ExamCode { title: { pt-BR: "Exame", en: "Exam" }, lookup }
    status: ExamOrderStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    assignedTo: User {
      title: { pt-BR: "Responsável", en: "Assignee" }
    }
    referredTo: SupportLab {
      title: { pt-BR: "Encaminhado para", en: "Referred to" }
    }
    requestedAt: DateTime { title: { pt-BR: "Solicitado em", en: "Requested at" } }
    resultedAt: DateTime { title: { pt-BR: "Resultado em", en: "Resulted at" } }
  }

  indexes {
    byStatus: [status, requestedAt] range
    bySample: [sample.id] hash
  }

  events {
    Requested {
      title: { pt-BR: "Exame solicitado", en: "Exam requested" }
      payload {
        exam: ExamCode { title: { pt-BR: "Exame", en: "Exam" } }
      }
    }
  }

  actions {
    request(exam: ExamCode, sample: Sample){
      title: { pt-BR: "Solicitar exame", en: "Request exam" }
      roles: [Collector]
      {
        requestedAt = now()
        emit Requested { exam }
      }
    }

    collect(){
      title: { pt-BR: "Coletar", en: "Collect" }
      roles: [Collector]
      to: status.Collected
    }

    process(){
      title: { pt-BR: "Iniciar análise", en: "Start analysis" }
      roles: [Analyst]
      to: status.Processing
    }

    refer(lab: SupportLab){
      title: { pt-BR: "Encaminhar ao apoio", en: "Refer to support" }
      roles: [SupportLiaison]
      to: status.Referred
      emits { supportLab: lab }
    }

    result(){
      title: { pt-BR: "Resultar", en: "Result" }
      roles: [Analyst]
      to: status.Resulted
      {
        resultedAt = now()
      }
    }

    cancel(justification: string){
      title: { pt-BR: "Cancelar", en: "Cancel" }
      roles: [LabManager]
      to: status.Cancelled
      emits { reason: justification }
    }

    assign(user: User){
      title: { pt-BR: "Atribuir", en: "Assign" }
      roles: [Pathologist]
      {
        assignedTo = user
      }
    }
  }

  rule status == Resulted implies resultedAt != null {
    pt-BR: "Informe a data do resultado"
    en: "Enter the result date"

  }
  rule status == Referred implies referredTo != null {
    pt-BR: "Selecione o laboratório de destino"
    en: "Select the destination lab"

  }
}

document ExamResult {
  title: { pt-BR: "Resultado de exame", en: "Exam result" }
  version: 1
  owner: "Laboratory"
  sync: live
  fields {
    laboratory: Laboratory {
      title: { pt-BR: "Laboratório", en: "Laboratory" }
    }
    examOrder: ExamOrder {
      title: { pt-BR: "Pedido", en: "Exam order" }
      lookup
    }
    sample: Sample {
      title: { pt-BR: "Amostra", en: "Sample" }
      lookup
    }
    value: string { title: { pt-BR: "Valor", en: "Value" } }
    unit: string { title: { pt-BR: "Unidade", en: "Unit" } }
    critical: boolean { title: { pt-BR: "Resultado crítico", en: "Critical result" } }
    status: ExamResultStatus { title: { pt-BR: "Situação", en: "Status" }, lookup }
    validatedAt: DateTime { title: { pt-BR: "Validado em", en: "Validated at" } }
    signedAt: DateTime { title: { pt-BR: "Assinado em", en: "Signed at" } }
    releasedAt: DateTime { title: { pt-BR: "Liberado em", en: "Released at" } }
  }

  indexes {
    byOrder: [examOrder.id] hash
    byStatus: [status, releasedAt] range
  }


  actions {
    record(order: ExamOrder, sampleRef: Sample, measured: string, measUnit: string, isCritical: boolean){
      title: { pt-BR: "Registrar leitura", en: "Record reading" }
      roles: [Analyst]
      returns: ExamResult
      {
        examOrder = order
        sample = sampleRef
        value = measured
        unit = measUnit
        critical = isCritical
      }
    }

    validate(){
      title: { pt-BR: "Validar", en: "Validate" }
      roles: [Analyst]
      to: status.Validated
      {
        validatedAt = now()
      }
    }

    sign(){
      title: { pt-BR: "Assinar", en: "Sign" }
      roles: [Pathologist]
      to: status.Signed
      {
        signedAt = now()
      }
    }

    release(){
      title: { pt-BR: "Liberar", en: "Release" }
      roles: [Pathologist]
      to: status.Released
      {
        releasedAt = now()
      }
    }
  }

  rule status == Released implies releasedAt != null {
    pt-BR: "Informe a data de liberação"
    en: "Enter the release date"

  }

  signature {
    release: Pathologist
  }
}
