// service: example.com/services/laboratory

shape SampleCode {
  title: { pt-BR: "Código da amostra", en: "Sample code" }
  base: string
  normalize: upper-trim
  maxLength: 40
  format: plain
}

shape SampleKind {
  title: { pt-BR: "Origem da amostra", en: "Sample origin" }
  base: classification
  value Patient {
    title: { pt-BR: "Paciente", en: "Patient" }
    icon: Patient
    ordinal: 10
  }
  value Support {
    title: { pt-BR: "Laboratório de apoio", en: "Support laboratory" }
    icon: Support
    ordinal: 20
  }
  value Control {
    title: { pt-BR: "Controle", en: "Control" }
    icon: Control
    ordinal: 30
  }
  format: plain
}

shape SampleStatus {
  title: { pt-BR: "Situação da amostra", en: "Sample status" }
  base: state
  initial: Collected
  value Collected {
    title: { pt-BR: "Coletada", en: "Collected" }
    icon: Collected
    ordinal: 10

    transition Received {
      title: { pt-BR: "Amostra recebida", en: "Sample received" }
    }

    transition Rejected {
      title: { pt-BR: "Amostra rejeitada", en: "Sample rejected" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Received {
    title: { pt-BR: "Recebida", en: "Received" }
    icon: Received
    ordinal: 20

    transition Rejected {
      title: { pt-BR: "Amostra rejeitada", en: "Sample rejected" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }

    transition Processing {
      title: { pt-BR: "Amostra em processamento", en: "Sample processing" }
    }

    transition Referred {
      title: { pt-BR: "Amostra encaminhada", en: "Sample referred" }
      payload {
        supportLab: SupportLab { title: { pt-BR: "Laboratório de apoio", en: "Support laboratory" } }
      }
    }
  }
  value Processing {
    title: { pt-BR: "Em processamento", en: "Processing" }
    icon: Processing
    ordinal: 30

    transition Resulted {
      title: { pt-BR: "Amostra resultada", en: "Sample resulted" }
    }
  }
  value Resulted {
    title: { pt-BR: "Resultada", en: "Resulted" }
    icon: Resulted
    ordinal: 40
  }
  value Referred {
    title: { pt-BR: "Encaminhada", en: "Referred" }
    icon: Referred
    ordinal: 50

    transition Resulted {
      title: { pt-BR: "Amostra resultada", en: "Sample resulted" }
    }
  }
  value Rejected {
    title: { pt-BR: "Rejeitada", en: "Rejected" }
    icon: Rejected
    ordinal: 60

    transition Collected {
      event: Recollected
      title: { pt-BR: "Amostra recoletada", en: "Sample recollected" }
    }
  }
  format: plain
}

shape ExamCode {
  title: { pt-BR: "Exame", en: "Exam" }
  base: classification
  value Hemogram {
    title: { pt-BR: "Hemograma", en: "Complete blood count" }
    icon: Hemogram
    ordinal: 10
  }
  value Glucose {
    title: { pt-BR: "Glicemia", en: "Glucose" }
    icon: Glucose
    ordinal: 20
  }
  value Culture {
    title: { pt-BR: "Cultura", en: "Culture" }
    icon: Culture
    ordinal: 30
  }
  value Hba1c {
    title: { pt-BR: "Hemoglobina glicada", en: "HbA1c" }
    icon: Hba1c
    ordinal: 40
  }
  format: plain
}

shape ExamOrderStatus {
  title: { pt-BR: "Situação do exame", en: "Exam order status" }
  base: state
  initial: Requested
  value Requested {
    title: { pt-BR: "Solicitado", en: "Requested" }
    icon: Requested
    ordinal: 10

    transition Collected {
      title: { pt-BR: "Exame coletado", en: "Exam collected" }
    }

    transition Cancelled {
      title: { pt-BR: "Exame cancelado", en: "Exam cancelled" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Collected {
    title: { pt-BR: "Coletado", en: "Collected" }
    icon: Collected
    ordinal: 20

    transition Processing {
      title: { pt-BR: "Exame em processamento", en: "Exam processing" }
    }

    transition Referred {
      title: { pt-BR: "Exame encaminhado", en: "Exam referred" }
      payload {
        supportLab: SupportLab { title: { pt-BR: "Laboratório de apoio", en: "Support laboratory" } }
      }
    }

    transition Cancelled {
      title: { pt-BR: "Exame cancelado", en: "Exam cancelled" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Processing {
    title: { pt-BR: "Em processamento", en: "Processing" }
    icon: Processing
    ordinal: 30

    transition Referred {
      title: { pt-BR: "Exame encaminhado", en: "Exam referred" }
      payload {
        supportLab: SupportLab { title: { pt-BR: "Laboratório de apoio", en: "Support laboratory" } }
      }
    }

    transition Resulted {
      title: { pt-BR: "Resultado emitido", en: "Result issued" }
    }

    transition Cancelled {
      title: { pt-BR: "Exame cancelado", en: "Exam cancelled" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Resulted {
    title: { pt-BR: "Resultado emitido", en: "Resulted" }
    icon: Resulted
    ordinal: 40
  }
  value Referred {
    title: { pt-BR: "Encaminhado ao apoio", en: "Referred to support" }
    icon: Referred
    ordinal: 50

    transition Resulted {
      title: { pt-BR: "Resultado emitido", en: "Result issued" }
    }

    transition Cancelled {
      title: { pt-BR: "Exame cancelado", en: "Exam cancelled" }
      payload {
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Cancelled {
    title: { pt-BR: "Cancelado", en: "Cancelled" }
    icon: Cancelled
    ordinal: 60
  }
  format: plain
}

shape ExamResultStatus {
  title: { pt-BR: "Situação do resultado", en: "Exam result status" }
  base: state
  initial: Draft
  value Draft {
    title: { pt-BR: "Registrado", en: "Recorded" }
    icon: Draft
    ordinal: 10

    transition Validated {
      title: { pt-BR: "Resultado validado", en: "Result validated" }
    }
  }
  value Validated {
    title: { pt-BR: "Validado", en: "Validated" }
    icon: Validated
    ordinal: 20

    transition Signed {
      title: { pt-BR: "Resultado assinado", en: "Result signed" }
    }
  }
  value Signed {
    title: { pt-BR: "Assinado", en: "Signed" }
    icon: Signed
    ordinal: 30

    transition Released {
      title: { pt-BR: "Resultado liberado", en: "Result released" }
      payload {
        value: string { title: { pt-BR: "Valor", en: "Value" } }
        unit: string { title: { pt-BR: "Unidade", en: "Unit" } }
      }
    }
  }
  value Released {
    title: { pt-BR: "Liberado", en: "Released" }
    icon: Released
    ordinal: 40
  }
  format: plain
}

shape ExamReading {
  title: { pt-BR: "Leitura do analisador", en: "Analyzer reading" }
  fields {
    value: string
    unit: string
    critical: boolean
    readAt: DateTime
  }
}
