// service: example.com/services/laboratory

shape SampleCode {
  title: { pt-BR: "Código da amostra", en: "Sample code" }
  base: string
  normalize: upper-trim
  maxLength: 40
  format: plain
}

shape SampleKind {
  title: { pt-BR: "Origem da amostra", en: "Sample origin" }
  base: classification
  value Patient {
    title: { pt-BR: "Paciente", en: "Patient" }
    icon: Patient
    ordinal: 10
  }
  value Support {
    title: { pt-BR: "Laboratório de apoio", en: "Support laboratory" }
    icon: Support
    ordinal: 20
  }
  value Control {
    title: { pt-BR: "Controle", en: "Control" }
    icon: Control
    ordinal: 30
  }
  format: plain
}

shape SampleStatus {
  title: { pt-BR: "Situação da amostra", en: "Sample status" }
  base: workflow
  initial: Collected
  value Collected {
    title: { pt-BR: "Coletada", en: "Collected" }
    icon: Collected
    ordinal: 10
    transition Received {
      title: { pt-BR: "Recebida", en: "Received" }
    }
    transition Rejected {
      title: { pt-BR: "Rejeitada", en: "Rejected" }
    }
  }
  value Received {
    title: { pt-BR: "Recebida", en: "Received" }
    icon: Received
    ordinal: 20
    transition Processing {
      title: { pt-BR: "Em processamento", en: "Processing" }
    }
    transition Referred {
      title: { pt-BR: "Encaminhada", en: "Referred" }
    }
    transition Rejected {
      title: { pt-BR: "Rejeitada", en: "Rejected" }
    }
  }
  value Processing {
    title: { pt-BR: "Em processamento", en: "Processing" }
    icon: Processing
    ordinal: 30
    transition Resulted {
      title: { pt-BR: "Resultada", en: "Resulted" }
    }
  }
  value Resulted {
    title: { pt-BR: "Resultada", en: "Resulted" }
    icon: Resulted
    ordinal: 40
  }
  value Referred {
    title: { pt-BR: "Encaminhada", en: "Referred" }
    icon: Referred
    ordinal: 50
    transition Resulted {
      title: { pt-BR: "Resultada", en: "Resulted" }
    }
  }
  value Rejected {
    title: { pt-BR: "Rejeitada", en: "Rejected" }
    icon: Rejected
    ordinal: 60
  }
  format: plain
}

shape ExamCode {
  title: { pt-BR: "Exame", en: "Exam" }
  base: classification
  value Hemogram {
    title: { pt-BR: "Hemograma", en: "Complete blood count" }
    icon: Hemogram
    ordinal: 10
  }
  value Glucose {
    title: { pt-BR: "Glicemia", en: "Glucose" }
    icon: Glucose
    ordinal: 20
  }
  value Culture {
    title: { pt-BR: "Cultura", en: "Culture" }
    icon: Culture
    ordinal: 30
  }
  value Hba1c {
    title: { pt-BR: "Hemoglobina glicada", en: "HbA1c" }
    icon: Hba1c
    ordinal: 40
  }
  format: plain
}

shape ExamOrderStatus {
  title: { pt-BR: "Situação do exame", en: "Exam order status" }
  base: workflow
  initial: Requested
  value Requested {
    title: { pt-BR: "Solicitado", en: "Requested" }
    icon: Requested
    ordinal: 10
    transition Collected {
      title: { pt-BR: "Coletado", en: "Collected" }
    }
    transition Cancelled {
      title: { pt-BR: "Cancelado", en: "Cancelled" }
    }
  }
  value Collected {
    title: { pt-BR: "Coletado", en: "Collected" }
    icon: Collected
    ordinal: 20
    transition Processing {
      title: { pt-BR: "Em processamento", en: "Processing" }
    }
    transition Referred {
      title: { pt-BR: "Encaminhado ao apoio", en: "Referred to support" }
    }
    transition Cancelled {
      title: { pt-BR: "Cancelado", en: "Cancelled" }
    }
  }
  value Processing {
    title: { pt-BR: "Em processamento", en: "Processing" }
    icon: Processing
    ordinal: 30
    transition Resulted {
      title: { pt-BR: "Resultado emitido", en: "Resulted" }
    }
    transition Referred {
      title: { pt-BR: "Encaminhado ao apoio", en: "Referred to support" }
    }
    transition Cancelled {
      title: { pt-BR: "Cancelado", en: "Cancelled" }
    }
  }
  value Resulted {
    title: { pt-BR: "Resultado emitido", en: "Resulted" }
    icon: Resulted
    ordinal: 40
  }
  value Referred {
    title: { pt-BR: "Encaminhado ao apoio", en: "Referred to support" }
    icon: Referred
    ordinal: 50
    transition Resulted {
      title: { pt-BR: "Resultado emitido", en: "Resulted" }
    }
    transition Cancelled {
      title: { pt-BR: "Cancelado", en: "Cancelled" }
    }
  }
  value Cancelled {
    title: { pt-BR: "Cancelado", en: "Cancelled" }
    icon: Cancelled
    ordinal: 60
  }
  format: plain
}
