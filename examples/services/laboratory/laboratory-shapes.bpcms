// service: example.com/services/laboratory

shape SampleCode {
  title: { pt-BR: "Código da amostra", en: "Sample code" }
  base: string
  normalize: upper-trim
  maxLength: 40
  format: plain
}

shape SampleKind {
  title: { pt-BR: "Origem da amostra", en: "Sample origin" }
  base: classification
  value patient {
    title: { pt-BR: "Paciente", en: "Patient" }
    icon: Patient
    ordinal: 10
  }
  value support {
    title: { pt-BR: "Laboratório de apoio", en: "Support laboratory" }
    icon: Support
    ordinal: 20
  }
  value control {
    title: { pt-BR: "Controle", en: "Control" }
    icon: Control
    ordinal: 30
  }
  format: plain
}

shape SampleStatus {
  title: { pt-BR: "Situação da amostra", en: "Sample status" }
  base: workflow
  initial: collected
  value collected {
    title: { pt-BR: "Coletada", en: "Collected" }
    icon: Collected
    ordinal: 10
    next: [received, rejected]
  }
  value received {
    title: { pt-BR: "Recebida", en: "Received" }
    icon: Received
    ordinal: 20
    next: [processing, referred, rejected]
  }
  value processing {
    title: { pt-BR: "Em processamento", en: "Processing" }
    icon: Processing
    ordinal: 30
    next: [resulted]
  }
  value resulted {
    title: { pt-BR: "Resultada", en: "Resulted" }
    icon: Resulted
    ordinal: 40
    next: []
  }
  value referred {
    title: { pt-BR: "Encaminhada", en: "Referred" }
    icon: Referred
    ordinal: 50
    next: [resulted]
  }
  value rejected {
    title: { pt-BR: "Rejeitada", en: "Rejected" }
    icon: Rejected
    ordinal: 60
    next: []
  }
  format: plain
}

shape ExamCode {
  title: { pt-BR: "Exame", en: "Exam" }
  base: classification
  value hemogram {
    title: { pt-BR: "Hemograma", en: "Complete blood count" }
    icon: Hemogram
    ordinal: 10
  }
  value glucose {
    title: { pt-BR: "Glicemia", en: "Glucose" }
    icon: Glucose
    ordinal: 20
  }
  value culture {
    title: { pt-BR: "Cultura", en: "Culture" }
    icon: Culture
    ordinal: 30
  }
  value hba1c {
    title: { pt-BR: "Hemoglobina glicada", en: "HbA1c" }
    icon: Hba1c
    ordinal: 40
  }
  format: plain
}

shape ExamOrderStatus {
  title: { pt-BR: "Situação do exame", en: "Exam order status" }
  base: workflow
  initial: requested
  value requested {
    title: { pt-BR: "Solicitado", en: "Requested" }
    icon: Requested
    ordinal: 10
    next: [collected, cancelled]
  }
  value collected {
    title: { pt-BR: "Coletado", en: "Collected" }
    icon: Collected
    ordinal: 20
    next: [processing, referred, cancelled]
  }
  value processing {
    title: { pt-BR: "Em processamento", en: "Processing" }
    icon: Processing
    ordinal: 30
    next: [resulted, referred, cancelled]
  }
  value resulted {
    title: { pt-BR: "Resultado emitido", en: "Resulted" }
    icon: Resulted
    ordinal: 40
    next: []
  }
  value referred {
    title: { pt-BR: "Encaminhado ao apoio", en: "Referred to support" }
    icon: Referred
    ordinal: 50
    next: [resulted, cancelled]
  }
  value cancelled {
    title: { pt-BR: "Cancelado", en: "Cancelled" }
    icon: Cancelled
    ordinal: 60
    next: []
  }
  format: plain
}
