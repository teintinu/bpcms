// service: example.com/services/laboratory

form SampleCollection {
  title: { pt-BR: "Coleta da amostra", en: "Sample collection" }
  document: ExamOrder

  fields {
    sample
    exam
    laboratory
  }

  actions {
    collect { calls: ExamOrder.collect }
  }
}

form ResultValidation {
  title: { pt-BR: "Validação do resultado", en: "Result validation" }
  document: ExamResult

  fields {
    value
    unit
    critical
    examOrder
  }

  actions {
    validate { calls: ExamResult.validate }
  }
}

form ResultSignature {
  title: { pt-BR: "Assinatura do resultado", en: "Result signature" }
  document: ExamResult

  fields {
    value
    unit
    critical
    examOrder
  }

  actions {
    sign { calls: ExamResult.sign }
  }
}

form Recollection {
  title: { pt-BR: "Recoleta da amostra", en: "Sample recollection" }
  document: Sample

  fields {
    code
    kind
    patient
  }

  actions {
    recollect { calls: Sample.recollect }
  }
}
