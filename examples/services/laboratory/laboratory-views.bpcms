// service: example.com/services/laboratory

view LabQuality {
  title: { pt-BR: "Qualidade laboratorial", en: "Laboratory quality" }
  type: report
  sources: [Sample, ExamResult]
  roles: [Pathologist, LabManager]

  filters { period; exam; laboratory }
  metrics {
    rejected: count(Sample) where status == Rejected
    criticalResults: count(ExamResult) where critical == true
    releasedResults: count(ExamResult) where status == Released
    signedResults: count(ExamResult) where status == Signed
  }
  freshness: 15m
  export: [pdf, csv]
}

view CollectionQueue {
  title: { pt-BR: "Fila de coleta", en: "Collection queue" }
  type: inbox
  roles: [Collector, Analyst, Pathologist, LabManager]
  scope: lanes
  groupBy: lane
  filter { lane in currentUser.lanes }
  columns { title; subject; lane; dueAt; priority }
}
