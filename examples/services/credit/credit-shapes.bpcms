// service: example.com/services/credit

shape CreditApplicationStatus {
  title: { pt-BR: "Situação da proposta de crédito", en: "Credit application status" }
  base: state
  initial: Draft
  value Draft {
    title: { pt-BR: "Rascunho", en: "Draft" }
    icon: Draft
    ordinal: 10

    transition Submitted {
      title: { pt-BR: "Proposta enviada", en: "Credit application submitted" }
      payload {
        submittedAt: DateTime { title: { pt-BR: "Enviada em", en: "Submitted at" } }
        requestedAmount: std.Money { title: { pt-BR: "Valor solicitado", en: "Requested amount" } }
      }
    }
  }
  value Submitted {
    title: { pt-BR: "Enviada", en: "Submitted" }
    icon: Submitted
    ordinal: 20

    transition UnderReview {
      event: ReviewStarted
      title: { pt-BR: "Análise iniciada", en: "Credit review started" }
      payload {
        reviewStartedAt: DateTime { title: { pt-BR: "Iniciada em", en: "Started at" } }
      }
    }
  }
  value UnderReview {
    title: { pt-BR: "Em análise", en: "Under review" }
    icon: UnderReview
    ordinal: 30

    transition Approved {
      title: { pt-BR: "Crédito aprovado", en: "Credit approved" }
      payload {
        approvedAt: DateTime { title: { pt-BR: "Aprovada em", en: "Approved at" } }
        approvedLimit: std.Money { title: { pt-BR: "Limite aprovado", en: "Approved limit" } }
      }
    }

    transition Rejected {
      title: { pt-BR: "Crédito rejeitado", en: "Credit rejected" }
      payload {
        rejectedAt: DateTime { title: { pt-BR: "Rejeitada em", en: "Rejected at" } }
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Approved {
    title: { pt-BR: "Aprovada", en: "Approved" }
    icon: Approved
    ordinal: 40
  }
  value Rejected {
    title: { pt-BR: "Rejeitada", en: "Rejected" }
    icon: Rejected
    ordinal: 50
  }
}

shape CreditLimitStatus {
  title: { pt-BR: "Situação do limite de crédito", en: "Credit limit status" }
  base: state
  initial: Active
  value Active {
    title: { pt-BR: "Ativo", en: "Active" }
    icon: Active
    ordinal: 10

    transition Suspended {
      title: { pt-BR: "Limite suspenso", en: "Credit limit suspended" }
      payload {
        suspendedAt: DateTime { title: { pt-BR: "Suspenso em", en: "Suspended at" } }
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }

    transition Revoked {
      title: { pt-BR: "Limite revogado", en: "Credit limit revoked" }
      payload {
        revokedAt: DateTime { title: { pt-BR: "Revogado em", en: "Revoked at" } }
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Suspended {
    title: { pt-BR: "Suspenso", en: "Suspended" }
    icon: Suspended
    ordinal: 20

    transition Active {
      event: Reinstated
      title: { pt-BR: "Limite reativado", en: "Credit limit reinstated" }
      payload {
        reinstatedAt: DateTime { title: { pt-BR: "Reativado em", en: "Reinstated at" } }
      }
    }

    transition Revoked {
      title: { pt-BR: "Limite revogado", en: "Credit limit revoked" }
      payload {
        revokedAt: DateTime { title: { pt-BR: "Revogado em", en: "Revoked at" } }
        reason: string { title: { pt-BR: "Motivo", en: "Reason" } }
      }
    }
  }
  value Revoked {
    title: { pt-BR: "Revogado", en: "Revoked" }
    icon: Revoked
    ordinal: 30
  }
}

shape RiskBand {
  title: { pt-BR: "Faixa de risco", en: "Risk band" }
  base: classification
  value Low {
    title: { pt-BR: "Baixo", en: "Low" }
    icon: Low
    ordinal: 10
  }
  value Medium {
    title: { pt-BR: "Médio", en: "Medium" }
    icon: Medium
    ordinal: 20
  }
  value High {
    title: { pt-BR: "Alto", en: "High" }
    icon: High
    ordinal: 30
  }
}
