// application: Loja do João (catálogo, pedidos, pagamentos e entrega)
// Declara a aplicação da URI example.com/app/loja-do-joao e abre sua composição.
application "example.com/app/loja-do-joao" {
  source: registry // Origem: registry BPCMS, com docs em /<uri>/index.html e download por SO.
  version: 1.4.0 // Versão semver publicada da app; o lock fixa as versões dos serviços.
  // Nome localizado da aplicação, exibido no construtor e no runtime.
  title: {
    pt-BR: "Loja do João" // Título em português (idioma default).
    en-US: "João's Store" // Título em inglês americano.
  }

  // Entry points da aplicação; cada alias local é usado nas referências cruzadas.
  services {
    "example.com/services/identity" as Identity // Identidade e autenticação dos usuários.
    "example.com/services/catalog" as Catalog // Catálogo de produtos e preços.
    "example.com/services/orders" as Orders // Carrinho e pedidos de venda.
    "example.com/services/payments" as Payments // Cobrança e autorização de pagamentos.
    "example.com/services/shipping" as Shipping // Cotação e rastreio de entregas.
    "example.com/services/notifications" as Notifications // Avisos e notificações aos clientes.
  }
  // Papéis da aplicação e a hierarquia entre eles (`>` = superior a).
  roles {
    Customer // Cliente: compra na loja.
    Clerk // Balconista: apoia o atendimento e os pedidos.
    Manager // Gerente: responde pela operação da loja.
    Dispatcher // Despachante: organiza as entregas.
    Driver // Motorista: executa as entregas.
    // Manager é superior a Clerk.
    Manager > Clerk
    // Manager é superior a Dispatcher, que é superior a Driver.
    Manager > Dispatcher > Driver
  }
  theme: Nuvula // Tema visual fornecido pelo construtor (não é artefato de serviço).
  locales: [pt-BR, en-US] // Idiomas da app; o primeiro (pt-BR) é o default.
  environments: [dev, qa, prod] // Ambientes em que a aplicação é promovida.

  // Bloco de inicialização da app; só configura, não contém regra de negócio.
  main {
    // Inicializa Catalog.DefaultCurrency com o real brasileiro (moeda padrão da loja).
    set Catalog.DefaultCurrency = "BRL"
    // Faz o boot antecipado do serviço de identidade (não declara dependência).
    start ["example.com/services/identity"]
  }
}
