application "example.com/app/loja-do-joao" {
  title: {
    pt-BR: "Loja do João"
    en-US: "João's Store"
  }

  services {
    "example.com/services/identity" as Identity
    "example.com/services/catalog" as Catalog
    "example.com/services/orders" as Orders 
    "example.com/services/payments" as Payments 
    "example.com/services/shipping" as Shipping 
    "example.com/services/notifications" as Notifications
  }
  theme: Nuvula
  locales: [pt-BR, en-US] 
  environments: [dev, qa, prod]

  main {
    set Catalog.DefaultCurrency = "BRL"
    // REVIEW [2026-12-15] Faz o boot antecipado do serviço de identidade (não declara dependência).
    start ["example.com/services/identity"]
  }
}
