// REVIEW [2026-12-15] application: Mesa de Sinistros (claims + field-service + payments)
// REVIEW [2026-12-15] Declara a aplicação da URI example.com/app/claims-desk e abre sua composição.
application "example.com/app/claims-desk" {
  // REVIEW [2026-12-15] Nome localizado da aplicação, exibido no construtor e no runtime.
  title: {
    pt-BR: "Mesa de Sinistros" // REVIEW [2026-12-15] Título em português (idioma default).
    en-US: "Claims Desk" // REVIEW [2026-12-15] Título em inglês americano.
  }

  // REVIEW [2026-12-15] Entry points da aplicação; cada alias local é usado nas referências cruzadas.
  services {
    "example.com/services/identity" as Identity // REVIEW [2026-12-15] Identidade e autenticação dos usuários.
    "example.com/services/claims" as Claims // REVIEW [2026-12-15] Abertura e análise de sinistros.
    "example.com/services/field-service" as FieldService // REVIEW [2026-12-15] Vistorias e atendimento em campo.
    "example.com/services/payments" as Payments // REVIEW [2026-12-15] Pagamentos de indenizações.
  }

  // REVIEW [2026-12-15] Papéis da aplicação e a hierarquia entre eles (`>` = superior a).
  roles {
    Clerk // REVIEW [2026-12-15] Atendente: registra e triagem os sinistros.
    Adjuster // REVIEW [2026-12-15] Regulador: analisa e decide a indenização.
    FraudAnalyst // REVIEW [2026-12-15] Analista antifraude: investiga indícios de fraude.
    FinanceAnalyst // REVIEW [2026-12-15] Analista financeiro: acompanha os pagamentos.
    Manager // REVIEW [2026-12-15] Gerente: responde pela operação da mesa.
    Policyholder // REVIEW [2026-12-15] Segurado: acompanha o próprio sinistro.
    Dispatcher // REVIEW [2026-12-15] Despachante: distribui as vistorias em campo.
    FieldTechnician // REVIEW [2026-12-15] Técnico de campo: executa a vistoria.
    Supervisor // REVIEW [2026-12-15] Supervisor: coordena campo e despacho.
    Customer // REVIEW [2026-12-15] Cliente: acompanha o atendimento.
    // REVIEW [2026-12-15] Manager é superior a Adjuster, que é superior a Clerk.
    Manager > Adjuster > Clerk
    // REVIEW [2026-12-15] Manager é superior a FraudAnalyst.
    Manager > FraudAnalyst
    // REVIEW [2026-12-15] Supervisor é superior a FieldTechnician.
    Supervisor > FieldTechnician
    // REVIEW [2026-12-15] Supervisor é superior a Dispatcher.
    Supervisor > Dispatcher
  }

  theme: Claims // REVIEW [2026-12-15] Tema visual fornecido pelo construtor (não é artefato de serviço).
  locales: [pt-BR, en-US] // REVIEW [2026-12-15] Idiomas da app; o primeiro (pt-BR) é o default.
  environments: [dev, qa, prod] // REVIEW [2026-12-15] Ambientes declarados para esta aplicação.

  // REVIEW [2026-12-15] Bloco de inicialização da app; só configura, não contém regra de negócio.
  main {
    // REVIEW [2026-12-15] Faz o boot antecipado do serviço de identidade (não declara dependência).
    start ["example.com/services/identity"]
  }
}
