// REVIEW [2026-12-15] application: Central de Compras (procurement + contracts + credit)
// REVIEW [2026-12-15] Declara a aplicação da URI example.com/app/central-de-compras e abre sua composição.
application "example.com/app/central-de-compras" {
  // REVIEW [2026-12-15] Nome localizado da aplicação, exibido no construtor e no runtime.
  title: {
    pt-BR: "Central de Compras" // REVIEW [2026-12-15] Título em português (idioma default).
    en-US: "Procurement Hub" // REVIEW [2026-12-15] Título em inglês americano.
  }

  // REVIEW [2026-12-15] Entry points da aplicação; cada alias local é usado nas referências cruzadas.
  services {
    "example.com/services/identity" as Identity // REVIEW [2026-12-15] Identidade e autenticação dos usuários.
    "example.com/services/procurement" as Procurement // REVIEW [2026-12-15] Compras: requisições, cotações e pedidos.
    "example.com/services/contracts" as Contracts // REVIEW [2026-12-15] Contratos com fornecedores e suas vigências.
    "example.com/services/credit" as Credit // REVIEW [2026-12-15] Análise de crédito e limite de fornecedores.
  }


  theme: Compras // REVIEW [2026-12-15] Tema visual fornecido pelo construtor (não é artefato de serviço).
  locales: [pt-BR, en-US] // REVIEW [2026-12-15] Idiomas da app; o primeiro (pt-BR) é o default.
  environments: [dev, qa, prod] // REVIEW [2026-12-15] Ambientes declarados para esta aplicação.

  // REVIEW [2026-12-15] Bloco de inicialização da app; só configura, não contém regra de negócio.
  main {
    // REVIEW [2026-12-15] Faz o boot antecipado do serviço de identidade (não declara dependência).
    start ["example.com/services/identity"]
  }
}
