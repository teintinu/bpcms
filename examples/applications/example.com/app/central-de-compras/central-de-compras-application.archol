// application: Central de Compras (procurement + contracts + credit)
// Declara a aplicação da URI example.com/app/central-de-compras e abre sua composição.
application "example.com/app/central-de-compras" {
  source: registry // Origem: registry BPCMS, com docs em /<uri>/index.html e download por SO.
  version: 1.0.0 // Versão semver inicial publicada da app.
  // Nome localizado da aplicação, exibido no construtor e no runtime.
  title: {
    pt-BR: "Central de Compras" // Título em português (idioma default).
    en-US: "Procurement Hub" // Título em inglês americano.
  }

  // Entry points da aplicação; cada alias local é usado nas referências cruzadas.
  services {
    "example.com/services/identity" as Identity // Identidade e autenticação dos usuários.
    "example.com/services/procurement" as Procurement // Compras: requisições, cotações e pedidos.
    "example.com/services/contracts" as Contracts // Contratos com fornecedores e suas vigências.
    "example.com/services/credit" as Credit // Análise de crédito e limite de fornecedores.
  }

  // Papéis da aplicação e a hierarquia entre eles (`>` = superior a).
  roles {
    Requester // Solicitante: abre a requisição de compra.
    Buyer // Comprador: conduz cotação e pedido.
    Approver // Aprovador: decide alçadas de aprovação.
    ProcurementManager // Gestor de compras: responde pela área de compras.
    ComplianceAnalyst // Analista de compliance: verifica conformidade.
    PayablesClerk // Contas a pagar: liquida as faturas dos fornecedores.
    ReceivingClerk // Recebedor: registra o recebimento de materiais.
    QualityInspector // Inspetor de qualidade: aceita ou rejeita itens recebidos.
    SupplierUser // Usuário do fornecedor: interage pelo portal do fornecedor.
    ContractManager // Gestor de contratos: responde pelos contratos.
    ContractAnalyst // Analista de contratos: mantém minutas e aditivos.
    LegalCounsel // Jurídico: valida cláusulas sensíveis.
    CreditAnalyst // Analista de crédito: analisa o risco do fornecedor.
    CreditManager // Gestor de crédito: decide limites de crédito.
    // ProcurementManager é superior a Buyer, que é superior a Requester.
    ProcurementManager > Buyer > Requester
    // Approver é superior a Buyer.
    Approver > Buyer
    // ContractManager é superior a ContractAnalyst.
    ContractManager > ContractAnalyst
    // CreditManager é superior a CreditAnalyst.
    CreditManager > CreditAnalyst
  }

  theme: Compras // Tema visual fornecido pelo construtor (não é artefato de serviço).
  locales: [pt-BR, en-US] // Idiomas da app; o primeiro (pt-BR) é o default.
  environments: [dev, qa, prod] // Ambientes declarados para esta aplicação.

  // Bloco de inicialização da app; só configura, não contém regra de negócio.
  main {
    // Faz o boot antecipado do serviço de identidade (não declara dependência).
    start ["example.com/services/identity"]
  }
}
