{
  "name": "archol-vscode",
  "displayName": "Archol",
  "description": "Archol language support for VS Code: syntax, snippets, LSP and AST explorer.",
  "version": "0.1.0",
  "publisher": "archol",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "archol",
    "dsl",
    "lsp",
    "ast"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "archol",
        "aliases": [
          "Archol",
          "archol"
        ],
        "extensions": [
          ".archol"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "archol",
        "scopeName": "source.archol",
        "path": "./syntaxes/archol.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "archol",
        "path": "./snippets/archol.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "archol.selectApplication",
        "title": "Select Application",
        "category": "Archol"
      },
      {
        "command": "archol.showAst",
        "title": "Open AST Explorer",
        "category": "Archol"
      },
      {
        "command": "archol.showLinks",
        "title": "Show Server Links",
        "category": "Archol"
      },
      {
        "command": "archol.restartServer",
        "title": "Restart LSP Server",
        "category": "Archol"
      },
      {
        "command": "archol.showOutput",
        "title": "Show Server Output",
        "category": "Archol"
      },
      {
        "command": "archol.updateLock",
        "title": "Update Identifier Lock",
        "category": "Archol"
      },
      {
        "command": "archol.useApplicationFile",
        "title": "Use as Current Application",
        "category": "Archol"
      }
    ],
    "keybindings": [
      {
        "command": "archol.showAst",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "editorLangId == archol"
      },
      {
        "command": "archol.showLinks",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorLangId == archol"
      }
    ],
    "configuration": {
      "title": "Archol",
      "properties": {
        "archol.application": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "URI of the current Archol application (`.archol` file) used by the compiler and LSP. An application is required for compile and LSP features; run **Archol: Select Application** to pick one from the workspace."
        },
        "archol.server.path": {
          "type": "string",
          "default": "archol",
          "markdownDescription": "Path to the Archol LSP server executable. The default `archol` looks on `PATH`. If not found, the extension tries `archol/target/release/archol` and `archol/target/debug/archol` relative to the workspace root."
        },
        "archol.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "lsp"
          ],
          "markdownDescription": "Arguments passed to the LSP server executable. The default `[\"lsp\"]` runs `archol lsp`; use `[]` if the path points to a dedicated server that does not accept a subcommand."
        },
        "archol.lockDebounceMs": {
          "type": "number",
          "default": 10000,
          "minimum": 0,
          "description": "Debounce (ms) before refreshing <app>.lock after .archol changes. Default 10000 (10s)."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "archol.useApplicationFile",
          "when": "editorLangId == archol && archol.isApplication",
          "group": "navigation@10"
        }
      ],
      "explorer/context": [
        {
          "command": "archol.useApplicationFile",
          "when": "resourceExtname == .archol",
          "group": "navigation@10"
        }
      ]
    },
    "configurationDefaults": {
      "[archol]": {
        "editor.formatOnSave": true
      }
    }
  },
  "scripts": {
    "test": "node --test test",
    "check": "node -e \"const fs=require('fs');const cp=require('child_process');for(const f of fs.readdirSync('src')){if(f.endsWith('.js'))cp.execFileSync(process.execPath,['--check','src/'+f],{stdio:'inherit'});}\""
  }
}
