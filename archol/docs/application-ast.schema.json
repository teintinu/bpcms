{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpcms.org/archol/application-ast.schema.json",
  "title": "ArcholApplication",
  "description": "Resolved application AST consumed by builders. schemaVersion 1.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "uri",
    "path",
    "workspaceRoot",
    "artifact",
    "application",
    "main",
    "files",
    "pendings",
    "index"
  ],
  "properties": {
    "kind": {
      "const": "ArcholApplication"
    },
    "schemaVersion": {
      "const": 1
    },
    "uri": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "workspaceRoot": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "$ref": "#/$defs/shapeValue"
    },
    "theme": {
      "$ref": "#/$defs/themeRef"
    },
    "locales": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/localeRef"
      }
    },
    "environments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/environmentEntry"
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/artifactDef"
      }
    },
    "application": {
      "$ref": "#/$defs/applicationConfig"
    },
    "main": {
      "$ref": "#/$defs/mainEntry"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileEntry"
      }
    },
    "index": {
      "$ref": "#/$defs/index"
    },
    "pendings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pendingEntry"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "loc": {
      "type": "object",
      "required": [
        "file",
        "start",
        "end"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^f:[a-z][a-z0-9]*$"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "expr": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "body": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "shapeValue": {
      "type": "object",
      "required": [
        "kind",
        "typeRef",
        "value",
        "loc"
      ],
      "properties": {
        "kind": {
          "const": "ShapeValue"
        },
        "typeRef": {
          "const": "std.bpcms.i18n"
        },
        "value": {
          "type": "object",
          "additionalProperties": true
        },
        "loc": {
          "$ref": "#/$defs/loc"
        }
      },
      "additionalProperties": false
    },
    "themeRef": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "const": "ThemeRef"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "localeRef": {
      "type": "object",
      "required": [
        "kind",
        "tag",
        "default"
      ],
      "properties": {
        "kind": {
          "const": "LocaleRef"
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "default": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "environmentEntry": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "const": "EnvironmentEntry"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "config": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "artifactDef": {
      "oneOf": [
        {
          "$ref": "#/$defs/serviceDef"
        },
        {
          "$ref": "#/$defs/roleDef"
        },
        {
          "$ref": "#/$defs/permissionDef"
        },
        {
          "$ref": "#/$defs/organogramDef"
        },
        {
          "$ref": "#/$defs/documentDef"
        },
        {
          "$ref": "#/$defs/shapeDef"
        },
        {
          "$ref": "#/$defs/viewDef"
        },
        {
          "$ref": "#/$defs/formDef"
        },
        {
          "$ref": "#/$defs/processDef"
        },
        {
          "$ref": "#/$defs/messageDef"
        },
        {
          "$ref": "#/$defs/policyDef"
        },
        {
          "$ref": "#/$defs/decisionDef"
        },
        {
          "$ref": "#/$defs/integrationDef"
        },
        {
          "$ref": "#/$defs/parameterDef"
        },
        {
          "$ref": "#/$defs/secretDef"
        },
        {
          "$ref": "#/$defs/iconDef"
        },
        {
          "$ref": "#/$defs/manualDef"
        },
        {
          "$ref": "#/$defs/errorDef"
        }
      ]
    },
    "defBase": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "serviceId",
        "name",
        "loc"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "serviceId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "loc": {
          "$ref": "#/$defs/loc"
        },
        "body": {
          "$ref": "#/$defs/body"
        }
      }
    },
    "refBase": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "loc"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "loc": {
          "$ref": "#/$defs/loc"
        }
      }
    },
    "serviceDef": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "name",
        "url",
        "path",
        "loc",
        "locales",
        "entryPoint",
        "aliases",
        "imports"
      ],
      "properties": {
        "kind": {
          "const": "ServiceDef"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "loc": {
          "$ref": "#/$defs/loc"
        },
        "title": {
          "$ref": "#/$defs/shapeValue"
        },
        "locales": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "entryPoint": {
          "type": "boolean"
        },
        "aliases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/serviceAlias"
          }
        },
        "imports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/serviceRef"
          }
        },
        "body": {
          "$ref": "#/$defs/body"
        }
      },
      "additionalProperties": false
    },
    "serviceAlias": {
      "type": "object",
      "required": [
        "kind",
        "name",
        "use",
        "by",
        "path",
        "loc"
      ],
      "properties": {
        "kind": {
          "const": "ServiceAlias"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "use": {
          "enum": [
            "entryPoint",
            "import"
          ]
        },
        "by": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "loc": {
          "$ref": "#/$defs/loc"
        }
      },
      "additionalProperties": false
    },
    "roleDef": {
      "allOf": [
        {
          "$ref": "#/$defs/defBase"
        }
      ],
      "properties": {
        "kind": {
          "const": "RoleDef"
        },
        "title": {
          "$ref": "#/$defs/shapeValue"
        },
        "organogram": {
          "oneOf": [
            {
              "$ref": "#/$defs/organogramRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "inherits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/roleRef"
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/permissionRef"
          }
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "inherits",
        "permissions"
      ],
      "unevaluatedProperties": false
    },
    "permissionDef": {
      "allOf": [
        {
          "$ref": "#/$defs/defBase"
        }
      ],
      "properties": {
        "kind": {
          "const": "PermissionDef"
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/roleRef"
          }
        },
        "usedBy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/organogramRef"
          }
        }
      },
      "required": [
        "kind",
        "namespace",
        "action",
        "roles"
      ],
      "unevaluatedProperties": false
    },
    "organogramDef": {
      "allOf": [
        {
          "$ref": "#/$defs/defBase"
        }
      ],
      "properties": {
        "kind": {
          "const": "OrganogramDef"
        },
        "title": {
          "$ref": "#/$defs/shapeValue"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hierarchy": {
          "$ref": "#/$defs/hierarchy"
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/organogramRoleDef"
          }
        },
        "fourEyes": {
          "$ref": "#/$defs/body"
        },
        "segregation": {
          "$ref": "#/$defs/body"
        },
        "delegations": {
          "$ref": "#/$defs/body"
        }
      },
      "required": [
        "kind",
        "hierarchy",
        "roles"
      ],
      "unevaluatedProperties": false
    },
    "organogramRoleDef": {
      "type": "object",
      "required": [
        "kind",
        "role",
        "manages",
        "inherits",
        "permissions"
      ],
      "properties": {
        "kind": {
          "const": "OrganogramRoleDef"
        },
        "role": {
          "$ref": "#/$defs/roleRef"
        },
        "manages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/roleRef"
          }
        },
        "inherits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/roleRef"
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/permissionRef"
          }
        }
      },
      "additionalProperties": false
    },
    "hierarchy": {
      "type": "object",
      "required": [
        "kind",
        "chains"
      ],
      "properties": {
        "kind": {
          "const": "Hierarchy"
        },
        "chains": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/roleRef"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "documentDef": {
      "allOf": [
        {
          "$ref": "#/$defs/defBase"
        }
      ],
      "properties": {
        "kind": {
          "const": "DocumentDef"
        },
        "title": {
          "$ref": "#/$defs/shapeValue"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldDef"
          }
        },
        "lifecycle": {
          "oneOf": [
            {
              "$ref": "#/$defs/lifecycleDef"
            },
            {
              "type": "null"
            }
          ]
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actionDef"
          }
        },
        "indexes": {
          "$ref": "#/$defs/body"
        },
        "relations": {
          "$ref": "#/$defs/body"
        },
        "events": {
          "$ref": "#/$defs/body"
        }
      },
      "required": [
        "kind",
        "fields",
        "actions"
      ],
      "unevaluatedProperties": false
    },
    "fieldDef": {
      "type": "object",
      "required": [
        "kind",
        "name",
        "type",
        "loc"
      ],
      "properties": {
        "kind": {
          "const": "FieldDef"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/typeRef"
        },
        "required": {
          "type": "boolean"
        },
        "private": {
          "type": "boolean"
        },
        "default": {
          "$ref": "#/$defs/expr"
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1
        },
        "compute": {
          "$ref": "#/$defs/expr"
        },
        "loc": {
          "$ref": "#/$defs/loc"
        }
      },
      "additionalProperties": false
    },
    "typeRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/shapeRef"
        },
        {
          "$ref": "#/$defs/stdRef"
        },
        {
          "$ref": "#/$defs/primitiveRef"
        },
        {
          "$ref": "#/$defs/documentRef"
        }
      ]
    },
    "lifecycleDef": {
      "type": "object",
      "required": [
        "kind",
        "shape",
        "initial",
        "states"
      ],
      "properties": {
        "kind": {
          "const": "LifecycleDef"
        },
        "shape": {
          "$ref": "#/$defs/shapeRef"
        },
        "initial": {
          "oneOf": [
            {
              "$ref": "#/$defs/shapeValueRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "creationEvent": {
          "type": [
            "string",
            "null"
          ]
        },
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shapeValueRef"
          }
        }
      },
      "additionalProperties": false
    },
    "actionDef": {
      "type": "object",
      "required": [
        "kind",
        "name",
        "roles",
        "to",
        "form",
        "loc"
      ],
      "properties": {
        "kind": {
          "const": "ActionDef"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/roleRef"
          }
        },
        "to": {
          "oneOf": [
            {
              "$ref": "#/$defs/shapeValueRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "form": {
          "oneOf": [
            {
              "$ref": "#/$defs/formRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "limits": {
          "$ref": "#/$defs/body"
        },
        "loc": {
          "$ref": "#/$defs/loc"
        },
        "body": {
          "$ref": "#/$defs/body"
        }
      },
      "additionalProperties": false
    },
    "shapeDef": {
      "allOf": [
        {
          "$ref": "#/$defs/defBase"
        }
      ],
      "properties": {
        "kind": {
          "const": "ShapeDef"
        },
        "shapeKind": {
          "type": "string"
        },
        "base": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shapeValueDef"
          }
        },
        "formula": {
          "type": [
            "string",
            "null"
          ]
        },
        "conversions": {
          "$ref": "#/$defs/body"
        },
        "methods": {
          "$ref": "#/$defs/body"
        }
      },
      "required": [
        "kind",
        "shapeKind",
        "values"
      ],
      "unevaluatedProperties": false
    },
    "shapeValueDef": {
      "type": "object",
      "required": [
        "kind",
        "name",
        "loc"
      ],
      "properties": {
        "kind": {
          "const": "ShapeValueDef"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "ordinal": {
          "type": "integer"
        },
        "title": {
          "$ref": "#/$defs/shapeValue"
        },
        "icon": {
          "oneOf": [
            {
              "$ref": "#/$defs/iconRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transitionDef"
          }
        },
        "loc": {
          "$ref": "#/$defs/loc"
        }
      },
      "additionalProperties": false
    },
    "transitionDef": {
      "type": "object",
      "required": [
        "kind",
        "name",
        "to"
      ],
      "properties": {
        "kind": {
          "const": "TransitionDef"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "$ref": "#/$defs/shapeValueRef"
        },
        "event": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "$ref": "#/$defs/shapeValue"
        },
        "payload": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldDef"
          }
        },
        "loc": {
          "$ref": "#/$defs/loc"
        }
      },
      "additionalProperties": false
    },
    "viewDef": {
      "allOf": [
        {
          "$ref": "#/$defs/defBase"
        }
      ],
      "properties": {
        "kind": {
          "const": "ViewDef"
        },
        "viewKind": {
          "type": "string"
        },
        "binds": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/documentRef"
              },
              {
                "$ref": "#/$defs/processRef"
              }
            ]
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actionRef"
          }
        },
        "filters": {
          "$ref": "#/$defs/body"
        }
      },
      "required": [
        "kind",
        "viewKind",
        "binds"
      ],
      "unevaluatedProperties": false
    },
    "formDef": {
      "allOf": [
        {
          "$ref": "#/$defs/defBase"
        }
      ],
      "properties": {
        "kind": {
          "const": "FormDef"
        },
        "document": {
          "oneOf": [
            {
              "$ref": "#/$defs/documentRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/roleRef"
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldDef"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/formActionDef"
          }
        }
      },
      "required": [
        "kind",
        "fields",
        "actions"
      ],
      "unevaluatedProperties": false
    },
    "formActionDef": {
      "type": "object",
      "required": [
        "kind",
        "name",
        "calls",
        "stay"
      ],
      "properties": {
        "kind": {
          "const": "FormActionDef"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "calls": {
          "$ref": "#/$defs/actionRef"
        },
        "stay": {
          "type": "boolean"
        },
        "loc": {
          "$ref": "#/$defs/loc"
        }
      },
      "additionalProperties": false
    },
    "messageDef": {
      "allOf": [
        {
          "$ref": "#/$defs/defBase"
        }
      ],
      "properties": {
        "kind": {
          "const": "MessageDef"
        },
        "title": {
          "$ref": "#/$defs/shapeValue"
        },
        "about": {
          "$ref": "#/$defs/documentRef"
        },
        "payload": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldDef"
          }
        }
      },
      "required": [
        "kind",
        "about",
        "payload"
      ],
      "unevaluatedProperties": false
    },
    "processDef": {
      "allOf": [
        {
          "$ref": "#/$defs/defBase"
        }
      ],
      "properties": {
        "kind": {
          "const": "ProcessDef"
        },
        "title": {
          "$ref": "#/$defs/shapeValue"
        },
        "start": {
          "$ref": "#/$defs/startSpec"
        },
